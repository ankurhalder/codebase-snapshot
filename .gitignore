node_modules
dist
.DS_Store
*.log
/snapshot/
/snapshot.tmp/
coverage/

# Rendered documentation site. Built from README.md and docs/*.md by
# scripts/build-site.mjs, so it is output, not source — the workflow rebuilds it
# on every deploy. `seo-log.jsonl` is deliberately NOT ignored: it is the record
# of measured search positions, and its whole value is being comparable over time.
site/

# Scratch probes at the repository root. `git add -A` swept four of these into a
# release because the author forgot they were there; they are throwaway harnesses,
# not tests (the tests they produced live in tests/).
.fuzz-*.mjs
.probe-*.mjs
.docs-audit.*
/.*.json
/.*.txt

# M8ven Tool Trust API key. Read by scripts/m8ven-report.mjs; never commit it.
.m8ven-key

# Comparison-harness output. `repomix-output.xml` is 3.5 MB of the same repository in another
# tool's format, written by `scripts/compare.mjs` / `benchmark-suite.mjs` into the working
# directory. One was swept into 0.14.2 by `git add -A` and sat in the tree until 0.17.33.
repomix-output.xml

