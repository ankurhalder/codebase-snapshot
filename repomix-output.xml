<file path="scripts/seo-rank.mjs">
/**
 * Measures discoverability: where this package ranks in npm search, and where
 * this repository ranks in GitHub repository search, for a fixed query set.
 *
 * The point is comparison over time. npm's search API scores almost purely on
 * text match — the quality/popularity/maintenance knobs are inert and a package
 * with 2.5k weekly downloads outranks one with 124M — so a keyword or
 * description change moves these numbers within about 45 minutes of publishing.
 * GitHub's index is Elasticsearch, rebuilt on push, scoring repository name,
 * description and topics; a README is only searched behind `in:readme`.
 *
 * Run it before and after a metadata change, and the difference is evidence
 * rather than opinion.
 *
 * Usage:
 *   node scripts/seo-rank.mjs             human-readable table
 *   node scripts/seo-rank.mjs --json      machine-readable to stdout
 *   node scripts/seo-rank.mjs --record    append the run to seo-log.jsonl
 *   node scripts/seo-rank.mjs --check     exit 1 when a flagship query regresses
 *
 * `--check` is for CI: it fails when a query we are supposed to win has slipped
 * past its target, which is the only automated way to notice a metadata
 * regression. It needs the network; offline runs should not use it.
 */
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const pkg = JSON.parse(fs.readFileSync(path.join(ROOT, "package.json"), "utf8"));

const REPOSITORY = (pkg.repository?.url ?? "")
  .replace(/^git\+/, "")
  .replace(/\.git$/, "")
  .replace(/^https:\/\/github\.com\//, "");

/** Names that mean "this package", across the scoped-to-unscoped migration. */
const OUR_NAMES = ["codebase-snapshot", "@ankurhalder/codebase-snapshot"];
/** The scaffolder shares the name, and must not outrank the package itself. */
const SCAFFOLDER = "create-codebase-snapshot";

/**
 * `target` is the rank we claim we can hold. Only queries we already win get
 * one: an aspirational target that fails on day one trains everyone to ignore
 * the check.
 */
const NPM_QUERIES = [
  { text: "codebase snapshot", target: 3 },
  { text: "llm codebase", target: 3 },
  { text: "codebase prompt", target: null },
  { text: "repository to llm", target: null },
  { text: "llm context files", target: null },
  { text: "codebase to markdown", target: null },
  { text: "pack repo for ai", target: null },
  { text: "ai snapshot", target: null },
  { text: "context engineering tool", target: null },
  { text: "token efficient codebase", target: null },
];

const GITHUB_QUERIES = [
  { text: "codebase snapshot", target: null },
  { text: "codebase-snapshot", target: null },
  { text: "repo to llm", target: null },
  { text: "llm context codebase", target: null },
];

const WINDOW = 25;

function rankOf(names, candidates) {
  for (let index = 0; index < names.length; index += 1) {
    if (candidates.includes(names[index])) return { rank: index + 1, name: names[index] };
  }
  return { rank: null, name: null };
}

async function npmRank(text) {
  const url = `https://registry.npmjs.org/-/v1/search?text=${encodeURIComponent(text)}&size=${WINDOW}`;
  const response = await fetch(url, { headers: { "user-agent": "codebase-snapshot-seo-rank" } });
  if (!response.ok) throw new Error(`npm search returned ${response.status}`);
  const body = await response.json();
  const names = (body.objects ?? []).map((entry) => entry.package.name);
  const ours = rankOf(names, OUR_NAMES);
  const scaffold = rankOf(names, [SCAFFOLDER]);
  const entry = body.objects?.[ours.rank - 1];
  return {
    surface: "npm",
    query: text,
    rank: ours.rank,
    name: ours.name,
    score: entry?.score?.final ?? null,
    scaffoldRank: scaffold.rank,
    scanned: names.length,
  };
}

/**
 * Prefers the authenticated `gh` CLI, which is already logged in on this
 * machine; falls back to an anonymous request, which the search API rate-limits
 * to ten calls a minute — enough for this query set.
 */
function githubNamesWithGh(text) {
  try {
    const raw = execFileSync(
      "gh",
      ["api", `search/repositories?q=${encodeURIComponent(text)}&per_page=100`, "--jq", ".items[].full_name"],
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }
    );
    return raw.split("\n").map((line) => line.trim()).filter(Boolean);
  } catch {
    return null;
  }
}

async function githubNamesWithFetch(text) {
  const headers = {
    accept: "application/vnd.github+json",
    "user-agent": "codebase-snapshot-seo-rank",
  };
  if (process.env.GITHUB_TOKEN) headers.authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
  const url = `https://api.github.com/search/repositories?q=${encodeURIComponent(text)}&per_page=100`;
  const response = await fetch(url, { headers });
  if (!response.ok) throw new Error(`GitHub search returned ${response.status}`);
  const body = await response.json();
  return (body.items ?? []).map((item) => item.full_name);
}

async function githubRank(text) {
  const names = githubNamesWithGh(text) ?? (await githubNamesWithFetch(text));
  const found = names.indexOf(REPOSITORY);
  return {
    surface: "github",
    query: text,
    rank: found === -1 ? null : found + 1,
    name: found === -1 ? null : REPOSITORY,
    score: null,
    scaffoldRank: null,
    scanned: names.length,
  };
}

function cell(value, width) {
  const text = value === null || value === undefined ? "—" : String(value);
  return text.length > width ? `${text.slice(0, width - 1)} ` : text.padEnd(width);
}

function printTable(rows) {
  const out = [];
  out.push(`${cell("surface", 7)}${cell("query", 26)}${cell("rank", 6)}${cell("score", 9)}${cell("scaffolder", 11)}scanned`);
  out.push("-".repeat(72));
  for (const row of rows) {
    const rank = row.rank === null ? "absent" : `#${row.rank}`;
    const score = row.score === null ? "—" : row.score.toFixed(1);
    const scaffold = row.scaffoldRank === null ? "—" : `#${row.scaffoldRank}`;
    out.push(
      `${cell(row.surface, 7)}${cell(row.query, 26)}${cell(rank, 6)}${cell(score, 9)}${cell(scaffold, 11)}${row.scanned}`
    );
  }
  process.stdout.write(`${out.join("\n")}\n`);
}

function failures(rows) {
  const broken = [];
  for (const query of NPM_QUERIES) {
    if (query.target === null) continue;
    const row = rows.find((candidate) => candidate.surface === "npm" && candidate.query === query.text);
    if (!row) continue;
    if (row.rank === null || row.rank > query.target) {
      broken.push(`npm "${query.text}": ${row.rank === null ? "absent" : `#${row.rank}`}, target #${query.target}`);
    }
  }
  for (const query of GITHUB_QUERIES) {
    if (query.target === null) continue;
    const row = rows.find((candidate) => candidate.surface === "github" && candidate.query === query.text);
    if (!row) continue;
    if (row.rank === null || row.rank > query.target) {
      broken.push(`github "${query.text}": ${row.rank === null ? "absent" : `#${row.rank}`}, target #${query.target}`);
    }
  }
  for (const query of NPM_QUERIES) {
    const row = rows.find((candidate) => candidate.surface === "npm" && candidate.query === query.text);
    if (row && row.rank !== null && row.scaffoldRank !== null && row.scaffoldRank < row.rank) {
      broken.push(`npm "${query.text}": ${SCAFFOLDER} outranks the package (#${row.scaffoldRank} vs #${row.rank})`);
    }
  }
  return broken;
}

const argv = new Set(process.argv.slice(2));
if (argv.has("--help") || argv.has("-h")) {
  process.stdout.write("usage: node scripts/seo-rank.mjs [--json] [--record] [--check]\n");
  process.exit(0);
}

const rows = [];
for (const query of NPM_QUERIES) rows.push(await npmRank(query.text));
for (const query of GITHUB_QUERIES) rows.push(await githubRank(query.text));

if (argv.has("--record")) {
  const line = JSON.stringify({ measuredAt: new Date().toISOString(), version: pkg.version, rows });
  fs.appendFileSync(path.join(ROOT, "seo-log.jsonl"), `${line}\n`);
}

if (argv.has("--json")) {
  process.stdout.write(`${JSON.stringify({ repository: REPOSITORY, version: pkg.version, rows }, null, 2)}\n`);
} else {
  printTable(rows);
}

const broken = failures(rows);
if (broken.length > 0) {
  process.stdout.write(`\nregressions:\n${broken.map((line) => `  - ${line}`).join("\n")}\n`);
  if (argv.has("--check")) process.exit(1);
}
</file>

<file path="src/agent/install-skill.ts">
import * as fs from "node:fs";
import * as path from "node:path";

import { appendGitignoreEntries, gitignorePath } from "../gitignore.js";
import { SKILL_NAME, renderSkill } from "./skill.js";

export type SkillTarget = "claude" | "cursor" | "all";
export const SKILL_TARGETS: SkillTarget[] = ["claude", "cursor", "all"];

export interface SkillWrite {
  target: Exclude<SkillTarget, "all">;
  path: string;
  action: "created" | "updated" | "unchanged";
}

export interface SkillInstallResult {
  cwd: string;
  written: SkillWrite[];
  /** Paths added to `.gitignore`, so an install does not leave untracked files behind. */
  gitignored: string[];
  /** Anything the user has to know but that did not stop the install. */
  notes: string[];
}

const REFUSED = "Refusing to install the agent skill";

/**
 * The marker 4.1.0 and earlier wrapped its `AGENTS.md` section in.
 *
 * Nothing writes it any more (see `installSkill`); it is matched only to tell a
 * repository that still carries one that the block is still there and no longer
 * maintained.
 */
const LEGACY_AGENTS_MARKER = "<!-- codebase-snapshot:skill:start -->";

/** Where each target puts the skill, relative to the repository root. */
function targetPath(cwd: string, target: Exclude<SkillTarget, "all">): string {
  switch (target) {
    case "claude":
      return path.join(cwd, ".claude", "skills", SKILL_NAME, "SKILL.md");
    case "cursor":
      return path.join(cwd, ".cursor", "rules", `${SKILL_NAME}.mdc`);
  }
}

/**
 * Refuses a target path that resolves outside the repository.
 *
 * `skill --install` is the one command that writes into a repository it did not
 * create, so the write has to be proved to land inside it. Two escape routes
 * exist and both are checked here, before any directory or file is created:
 *
 * - **Links in the path.** A symlink — and an NTFS junction, which `lstat` and
 *   `realpath` treat the same way — is followed by the filesystem, so a linked
 *   `.claude/` used to seed `.claude/skills/…/SKILL.md` outside the repository.
 *   The nearest *existing* ancestor is resolved with `realpath`: resolving before
 *   creating anything means the check cannot be defeated by a directory that only
 *   exists outside.
 * - **A hard link at the target itself.** A hard link has no second path to
 *   resolve — it is the same inode under another name — so `realpath` cannot see
 *   it. `lstat` reports `nlink > 1`, which is the only signal available; the
 *   trade-off is that a deliberate in-repository hard link is refused too. The
 *   message says so, and the fix is to replace it with an ordinary file.
 */
function assertWritableInsideRepository(cwd: string, filePath: string): void {
  const root = fs.realpathSync(cwd);
  const shown = path.relative(root, filePath) || filePath;

  let stat: fs.Stats | null = null;
  try {
    stat = fs.lstatSync(filePath);
  } catch {
    stat = null;
  }

  if (stat !== null && stat.isSymbolicLink()) {
    throw new Error(
      `${REFUSED}: ${shown} is a symbolic link or junction. Remove the link, or write the ` +
        `skill into the directory it points at yourself, and run again.`
    );
  }
  if (stat !== null && stat.isFile() && stat.nlink > 1) {
    throw new Error(
      `${REFUSED}: ${shown} has ${stat.nlink} hard links, so writing it would also rewrite ` +
        `a file outside the repository. Replace it with an ordinary file and run again.`
    );
  }

  let existing = filePath;
  const missing: string[] = [];
  while (!fs.existsSync(existing)) {
    missing.unshift(path.basename(existing));
    const parent = path.dirname(existing);
    if (parent === existing) break;
    existing = parent;
  }
  const realAncestor = fs.realpathSync(existing);
  const resolved =
    missing.length === 0 ? realAncestor : path.join(realAncestor, ...missing);
  if (resolved !== root && !resolved.startsWith(`${root}${path.sep}`)) {
    throw new Error(
      `${REFUSED}: ${shown} resolves outside the repository (${resolved}). Move it back ` +
        `inside ${root}, or remove the link, and run again.`
    );
  }
}

function writeIfChanged(
  target: Exclude<SkillTarget, "all">,
  filePath: string,
  content: string
): SkillWrite {
  const existing = fs.existsSync(filePath) ? fs.readFileSync(filePath, "utf8") : null;
  if (existing === content) return { target, path: filePath, action: "unchanged" };
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, content, "utf8");
  return { target, path: filePath, action: existing === null ? "created" : "updated" };
}

/** Reports a section an older release merged into the project's own `AGENTS.md`. */
function legacyAgentsNote(cwd: string): string | null {
  const filePath = path.join(cwd, "AGENTS.md");
  try {
    if (!fs.existsSync(filePath)) return null;
    if (!fs.readFileSync(filePath, "utf8").includes(LEGACY_AGENTS_MARKER)) return null;
  } catch {
    return null;
  }
  return (
    "AGENTS.md still contains the section an earlier version installed (between the " +
    `"${LEGACY_AGENTS_MARKER}" markers). This command no longer edits that file: it is ` +
    "your project's own agent instructions. Delete the block if you do not want it."
  );
}

/**
 * Installs the bundled skill into the registries this repository's agent tool reads.
 *
 * Two locations, and both are *registries keyed by skill name*: Claude Code
 * auto-discovers `.claude/skills/<name>/SKILL.md`, and Cursor reads
 * `.cursor/rules/<name>.mdc`. Because the path carries the skill's name, the file
 * cannot be mistaken for the project's own documentation and two skills cannot
 * collide.
 *
 * It deliberately does **not** write `AGENTS.md`. That file is the project's own
 * agent contract — conventions, build commands, house rules — and this tool has no
 * business writing into it on the user's behalf: creating one that holds only our
 * text misrepresents the repository to every agent that reads it, and merging a
 * section into an existing one edits a tracked file the user then has to review.
 * An agent that wants the skill in `AGENTS.md` can run `codebase-snapshot skill`
 * and paste it; the decision, and the commit, are the repository owner's.
 *
 * Whatever this command *creates* — and only what it creates — is added to
 * `.gitignore` in the same run. These files are a tool's documentation written into
 * someone else's repository; leaving them untracked turns a one-line command into a
 * decision about what to commit.
 */
export function installSkill(cwd: string, target: SkillTarget = "all"): SkillInstallResult {
  const skill = renderSkill();
  const written: SkillWrite[] = [];
  const notes: string[] = [];
  const wanted: Array<Exclude<SkillTarget, "all">> =
    target === "all" ? ["claude", "cursor"] : [target];

  for (const item of wanted) assertWritableInsideRepository(cwd, targetPath(cwd, item));

  // The ignore file is written in this run too, so it needs the same proof. Doing it
  // in the same pre-flight loop keeps the "all or nothing" property: a linked
  // `.gitignore` that points outside the repository refuses before anything is created.
  const createsSomething = wanted.some((item) => !fs.existsSync(targetPath(cwd, item)));
  if (createsSomething) {
    assertWritableInsideRepository(cwd, path.join(cwd, ".gitignore"));
  }

  for (const item of wanted) {
    written.push(writeIfChanged(item, targetPath(cwd, item), skill));
  }

  const created = written
    .filter((item) => item.action === "created")
    .map((item) => gitignorePath(cwd, item.path));
  const ignore = appendGitignoreEntries(cwd, created);
  if (ignore.note !== null) notes.push(ignore.note);

  const legacy = legacyAgentsNote(cwd);
  if (legacy !== null) notes.push(legacy);

  return { cwd, written, gitignored: ignore.added, notes };
}

/** True when the target name is one this command understands. */
export function isSkillTarget(value: string): value is SkillTarget {
  return (SKILL_TARGETS as string[]).includes(value);
}
</file>

<file path="src/ast/profiles/dart.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isPublicName, isTopLevel } from "./shared.js";

/**
 * Dart and Flutter: types, mixins, extensions, top-level functions and imports.
 *
 * Dart privacy is the leading underscore, the same rule as Python and Ruby, so
 * `isPublicName` is the export test — a `_private` class belongs to its library, not to the
 * package.
 *
 * `part of` / `part` are recorded as directives: they are how a Flutter codebase splits one
 * library across files, and an outline that omits them makes the split invisible.
 */
const IMPORT = /^import\s+['"]([^'"]+)['"]/;
const PART = /^part(?:\s+of)?\s+['"]?([\w./]+)['"]?/;
const TYPE = /^(?:abstract\s+|base\s+|final\s+|sealed\s+|interface\s+)*(class|mixin|enum|extension|typedef)\s+([A-Za-z_]\w*)/;
const FUNC =
  /^(?:Future<[^>]*>|Stream<[^>]*>|void|bool|int|double|num|String|dynamic|var|[A-Z][\w<>, ?]*)\s+([A-Za-z_]\w*)\s*[(<]/;
/**
 * A top-level declaration, with an optional explicit type.
 *
 * `const int maxEntries = 10` is the ordinary Dart spelling, and a pattern that captured the
 * first word after the keyword recorded the *type* as the variable's name — `int` became a
 * symbol in the manifest. The `=` is what distinguishes a declaration from a call or a
 * control statement, so it is required.
 */
const VARIABLE =
  /^(?:late\s+)?(?:final|const|var)\s+(?:[\w<>?,. ]+?\s+)?([A-Za-z_]\w*)\s*=/;

export const dartProfile: LanguageProfile = {
  id: "dart",
  extensions: [".dart"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("//")) return;

      const imported = IMPORT.exec(trimmed);
      if (imported) {
        summary.imports.push(imported[1]);
        return;
      }
      if (/^part\b/.test(trimmed)) {
        const part = PART.exec(trimmed);
        summary.directives.push(part ? `part ${part[1]}` : "part");
        return;
      }

      if (!isTopLevel(line)) return;

      const type = TYPE.exec(trimmed);
      if (type) {
        const [, keyword, name] = type as RegExpExecArray & [string, string, string];
        if (keyword === "mixin" || keyword === "extension") summary.types.push(name);
        else if (keyword === "enum") summary.enums.push(name);
        else if (keyword === "typedef") summary.types.push(name);
        else summary.classes.push(name);
        if (isPublicName(name)) summary.exports.push(name);
        return;
      }

      const func = FUNC.exec(trimmed);
      if (func) {
        const name = (func as RegExpExecArray & [string, string])[1];
        summary.functions.push(name);
        if (isPublicName(name)) summary.exports.push(name);
        return;
      }

      const variable = VARIABLE.exec(trimmed);
      if (variable) {
        const name = (variable as RegExpExecArray & [string, string])[1];
        summary.variables.push(name);
        if (isPublicName(name)) summary.exports.push(name);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/dotnet.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary } from "./shared.js";

const USING = /^using\s+([\w.]+)\s*;/;
const TYPE_DECL =
  /^\s*(?:public\s+|internal\s+|private\s+|protected\s+|sealed\s+|abstract\s+|static\s+|partial\s+|readonly\s+)*(class|interface|struct|record|enum)\s+([A-Za-z_]\w*)/;
const METHOD =
  /^\s*(?:public|private|protected|internal)\s+(?:static\s+)?(?:async\s+)?(?:virtual\s+|override\s+|sealed\s+)?[\w<>[\],?]+\s+([A-Za-z_]\w*)\s*[<(]/;

/** C#: `using` directives, type declarations and members with an access modifier. */
export const dotnetProfile: LanguageProfile = {
  id: "dotnet",
  extensions: [".cs"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("//") || trimmed.startsWith("/*") || trimmed.startsWith("*")) {
        return;
      }

      const used = USING.exec(trimmed);
      if (used) {
        summary.imports.push(used[1]);
        return;
      }

      const declaration = TYPE_DECL.exec(line);
      if (declaration) {
        const kind = declaration[1];
        const name = declaration[2];
        if (kind === "interface") summary.interfaces.push(name);
        else if (kind === "enum") summary.enums.push(name);
        else summary.classes.push(name);
        if (/^\s*public\b/.test(line)) summary.exports.push(name);
        return;
      }

      const method = METHOD.exec(line);
      if (method) {
        summary.functions.push(method[1]);
        if (/^\s*public\b/.test(line)) summary.exports.push(method[1]);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
