import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";

const BIN = path.resolve("dist/bin.js");
const results = [];

function dir(files) {
  const base = fs.mkdtempSync(path.join(os.tmpdir(), "edge-"));
  fs.mkdirSync(path.join(base, "src"), { recursive: true });
  fs.writeFileSync(path.join(base, "package.json"), JSON.stringify({ name: "edge", version: "1.0.0" }));
  for (const [rel, content] of Object.entries(files ?? { "src/a.ts": "export const a = 1;\n" })) {
    fs.mkdirSync(path.dirname(path.join(base, rel)), { recursive: true });
    fs.writeFileSync(path.join(base, rel), content);
  }
  return base;
}

function run(args, cwd) {
  const r = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: r.status, out: (r.stdout ?? "") + (r.stderr ?? "") };
}

function check(name, fn) {
  try { fn(); results.push([true, name, ""]); }
  catch (error) { results.push([false, name, error.message]); }
}

function assert(condition, message) { if (!condition) throw new Error(message); }
const manifest = (d) => JSON.parse(fs.readFileSync(path.join(d, "snapshot", "manifest.json"), "utf8"));
const promptOf = (d) => fs.readFileSync(path.join(d, "snapshot", "PROMPT.md"), "utf8");

// B: one part, one slot
check("one part, one slot: grammar and advice", () => {
  const d = dir();
  const r = run(["generate", "--attachment-slots", "1"], d);
  assert(r.code === 0, r.out);
  const p = promptOf(d);
  assert(!/The 1 parts/.test(p), "plural slip: " + (p.match(/The 1 parts[^\n]*/) ?? ["none"])[0]);
  assert(/The only part fills a 1-file destination/.test(p), "one part is described as one part");
  assert(!/--max-parts 1/.test(p), "and does not advise merging a single part");
});

// C: two slots
check("two slots: parts plus manifest", () => {
  const d = dir();
  assert(run(["generate", "--attachment-slots", "2"], d).code === 0);
  assert(/2 of 2/.test(promptOf(d)), "the plan counts the slots");
});

// E: generous slots
check("a generous destination carries the whole set", () => {
  const d = dir();
  assert(run(["generate", "--attachment-slots", "100"], d).code === 0);
  assert(/carries the whole set/.test(promptOf(d)), "whole set branch");
});

// F: invalid slots
for (const bad of ["abc", "-1", "2.5", ""]) {
  check("slots rejected: " + JSON.stringify(bad), () => {
    const d = dir();
    const r = run(["generate", "--attachment-slots", bad], d);
    assert(r.code === 2, "expected usage error, got " + r.code + ": " + r.out.slice(0, 120));
  });
}

// G: invalid config value
check("config attachmentSlots: -1 is refused", () => {
  const d = dir();
  fs.writeFileSync(path.join(d, "snapshot.config.mjs"), "export default { attachmentSlots: -1 };\n");
  const r = run(["generate"], d);
  assert(r.code !== 0, "must fail");
  assert(/attachmentSlots/.test(r.out), "names the setting");
});

// H: maxParts 1
check("maxParts 1 produces exactly one part", () => {
  const files = {};
  for (let i = 0; i < 40; i += 1) files["src/f" + i + ".ts"] = "export const v" + i + " = \"x\";\n";
  const d = dir(files);
  const r = run(["generate", "--max-part-bytes", "4096", "--max-parts", "1"], d);
  assert(r.code === 0, r.out);
  assert(manifest(d).parts.length === 1, "one part, got " + manifest(d).parts.length);
});

// I: maxParts larger than needed is a no-op
check("maxParts above the natural count changes nothing", () => {
  const d = dir();
  const before = run(["generate"], d), base = manifest(d).parts.length;
  assert(before.code === 0);
  const r = run(["generate", "--max-parts", "50"], d);
  assert(r.code === 0, r.out);
  assert(manifest(d).parts.length === base, "count unchanged");
  assert(!/maxParts 50: the part budget grew/.test(r.out), "no growth warning");
});

// J: byLayer budgets scale
check("maxParts honours per-layer budgets while merging", () => {
  const files = {};
  for (let i = 0; i < 30; i += 1) files["src/s" + i + ".ts"] = "export const s" + i + " = 1;\n";
  for (let i = 0; i < 30; i += 1) files["docs/d" + i + ".md"] = "# doc " + i + "\n\n" + "text ".repeat(60) + "\n";
  const d = dir(files);
  fs.writeFileSync(path.join(d, "snapshot.config.mjs"), "export default { budgets: { default: \"200k\", byLayer: { docs: \"8k\" } }, maxParts: 3 };\n");
  const r = run(["generate"], d);
  assert(r.code === 0, r.out);
  assert(manifest(d).parts.length <= 3, "at most three parts, got " + manifest(d).parts.length);
});

// K: dry run
check("maxParts with --dry-run writes nothing", () => {
  const d = dir();
  const r = run(["generate", "--dry-run", "--max-parts", "1"], d);
  assert(r.code === 0, r.out);
  assert(!fs.existsSync(path.join(d, "snapshot")), "no output directory");
});

// L: monolith together
check("maxParts plus the monolith still validates", () => {
  const d = dir();
  const r = run(["generate", "--max-parts", "1", "--include-monolith"], d);
  assert(r.code === 0, r.out);
  assert(fs.existsSync(path.join(d, "snapshot", "full-codebase.md")), "monolith written");
  const v = run(["validate", "--max-parts", "1", "--include-monolith"], d);
  assert(v.code === 0, "validate: " + v.out.slice(0, 200));
});

// M: invalid maxParts
for (const bad of ["0", "-2", "abc"]) {
  check("maxParts rejected: " + JSON.stringify(bad), () => {
    const d = dir();
    const r = run(["generate", "--max-parts", bad], d);
    assert(r.code === 2, "expected usage error, got " + r.code + ": " + r.out.slice(0, 120));
  });
}

// O: only the brief
check("--only-artifacts prompt yields a honest empty brief", () => {
  const d = dir();
  const r = run(["generate", "--only-artifacts", "prompt"], d);
  assert(r.code === 0, r.out);
  const p = promptOf(d);
  assert(/Nothing but this brief/.test(p), "says what is missing");
  assert(/do not answer from memory/.test(p), "and what to do");
  assert(!fs.existsSync(path.join(d, "snapshot", "parts")), "no parts");
});

// P: a secret-shaped commit subject is masked
check("a secret-shaped commit subject is masked in the brief", () => {
  const d = dir();
  const git = (args) => spawnSync("git", args, { cwd: d, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) return;
  git(["add", "-A"]);
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q", "-m", "fix: leaked AWS_KEY=AKIAIOSFODNN7EXAMPLE"]);
  const r = run(["generate"], d);
  assert(r.code === 0, r.out);
  const p = promptOf(d);
  assert(!p.includes("AKIAIOSFODNN7EXAMPLE"), "the raw value must not reach the artifact");
  assert(/## What came before/.test(p), "the history section is still there");
});

// Q: bidi characters in a path are escaped
check("a bidi character in a path is escaped in the brief", () => {
  const d = dir();
  fs.writeFileSync(path.join(d, "src", "bi\u202Edi.ts"), "export const b = 1;\n");
  const r = run(["generate"], d);
  assert(r.code === 0, r.out);
  assert(!promptOf(d).includes("\u202E"), "no raw bidi override");
});

// S: validate without a manifest is a clean failure
check("validate without a manifest exits 1, not a stack trace", () => {
  const d = dir();
  run(["generate", "--only-artifacts", "prompt"], d);
  const v = run(["validate"], d);
  assert(v.code === 1, "exit 1, got " + v.code);
  assert(!/\bat .*\.js:\d+/.test(v.out), "no stack trace");
});


// T: no parts at all
check("a snapshot with no parts omits the delivery plan", () => {
  const d = dir();
  const r = run(["generate", "--skip-artifacts", "parts"], d);
  assert(r.code === 0, r.out);
  const p = promptOf(d);
  assert(!/## Attaching this/.test(p), "no delivery plan");
  assert(!/parts\/part-NNN\.md/.test(p), "and nothing tells the reader to open parts");
});

// U: one slot, two parts
check("one slot and two parts states the overflow", () => {
  const files = {};
  for (let i = 0; i < 30; i += 1) files["src/f" + i + ".ts"] = "export const v" + i + " = \"x\";\n";
  const d = dir(files);
  const r = run(["generate", "--max-part-bytes", "4096", "--attachment-slots", "1"], d);
  assert(r.code === 0, r.out);
  const p = promptOf(d);
  assert(/do not fit a 1-file destination: at most 1 can be attached/.test(p), "states the ceiling");
});

// V: history cap
check("the history section is capped at ten subjects", () => {
  const d = dir();
  const git = (args) => spawnSync("git", args, { cwd: d, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) return;
  git(["add", "-A"]);
  for (let i = 0; i < 12; i += 1) {
    fs.writeFileSync(path.join(d, "src", "n" + i + ".ts"), "export const n" + i + " = " + i + ";");
    git(["add", "-A"]);
    git(["-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q", "-m", "chore: round " + i]);
  }
  const r = run(["generate"], d);
  assert(r.code === 0, r.out);
  const subjects = promptOf(d).match(/^- chore: round /gm) ?? [];
  assert(subjects.length === 10, "ten subjects, got " + subjects.length);
});

// W: unlimited slots with parts
check("attachmentSlots 0 says every file can travel", () => {
  const d = dir();
  assert(run(["generate", "--attachment-slots", "0"], d).code === 0);
  assert(/No attachment limit is configured/.test(promptOf(d)), "unlimited branch");
});

// X: no prompt when the artifact is off, and the manifest agrees
check("prompt off leaves no dangling digest", () => {
  const d = dir();
  assert(run(["generate", "--skip-artifacts", "prompt"], d).code === 0);
  assert(manifest(d).artifacts.prompt === undefined, "no digest");
  assert(!fs.existsSync(path.join(d, "snapshot", "PROMPT.md")), "no file");
});

const failed = results.filter(([ok]) => !ok);
for (const [ok, name, message] of results) if (!ok) console.log("FAIL  " + name + "\n      " + message);
console.log("\n" + (results.length - failed.length) + "/" + results.length + " edge cases pass");
</file>

<file path="audit/work/fix-log.md">
# 0.10.1 audit — fix log

Every finding in `audit/reports/0.10.1-code-analysis.md` has a fix, a regression test and a
verification. Nothing is deferred; the batch ships as 0.10.2.

The final gate is `npm run verify` (lint + typecheck + 1 138 tests + workflow pins + sync-docs +
site + link check + site audit + readme lint + tarball check); every row below was also checked
end to end on its own, with the test named in the last column.

## High

| ID | What was wrong | Fix | Test |
| :-- | :-- | :-- | :-- |
| H1 | A quoted credential whose closing quote is not on the line matched no rule: emitted in clear, zero findings. A mask that would unbalance a balanced line was skipped **and recorded nothing**. | New built-in rule `credential-assignment-unterminated` (32 rules now). The balance guard now masks around quotes instead of refusing the rewrite, so parity cannot change and the value does not survive. | `tests/redaction-unterminated-quote.test.js` (4), `scan-truth` rule count |

## Medium

| ID | What was wrong | Fix | Test |
| :-- | :-- | :-- | :-- |
| H2 | `validate` never read `incomplete[]`: ten tampered variants reported "valid and up to date", including `relativePath: "../escape.ts"`. | Shape guard checks the whole record (`incompleteCount`, reason set, ranges sorted/bounded/in range, `omittedLines` = sum of ranges, `includedLines <= lines`, confined `relativePath`); `validate` cross-checks `incomplete[]` against `files[]` both ways. | `tests/incomplete-contract.test.js` (15) |
| H3 | The monolith entry said `inclusionMode: "full"` beside `truncationReason`/`omittedRanges`. | Those fields are dropped from the monolith projection. | `generation-truth` "C4: a monolith entry that says full carries no truncation fields" |
| H4 | `discovery` missing from `SnapshotConfig`, so a TS config was TS2353. | Added to the interface; a compile-time proof keeps `CONFIG_KEY_NAMES` a subset of `keyof SnapshotConfig`. | compile-time (tsc), `discovery-mode` contract assertions |
| H5 | `snapshot_plan` generated on the RPC thread. | `generateInWorker(..., { dryRun: true })`; the worker applies `dryRun` and returns the plan's counts, layers and ranked skip reasons. | `tests/mcp-plan-offthread.test.js` (3) |
| H6 | A previewed importer was absent from `indexes.imports.byFile`, so `snapshot_dependents` said "0 importer(s)". | `buildIndexes` takes `skippedSummaryImports`; such an entry carries `exportsOmitted: true`. | `mcp-dependents` "a previewed importer is still an importer" |
| H7 | `compareManifests` had no rules parameter; `diff` printed project tokens in clear. Also `payload.layers` was unmasked. | Rules parameter threaded through all four masking sites; layer maps masked with the same rules. | `diff-payload` "compareManifests applies the caller's secret rules…" |
| H8 | `init --out-dir .context` ignored `/snapshot/`. | Entries derived from the effective outDir/tmpDir, anchored, out-of-tree skipped. | `init-gitignore-directory` (3 new) |
| H9 | Two live assets 404'd; the link gate read only `href`. | `docs/assets/` rewrites to `assets/`; `check-site-links` checks `src` too. | `site-anchors` (2 new) |
| H10 | `reports/.DS_Store` made the tool refuse its own outDir. | `isIgnorableEntry` compares the basename, used at all three sites. | `ownership-evidence` (2 new) |
| H11 | `generatorOrigin` used bare `JSON.parse`, so a BOM'd package.json read as "global or direct install". | `stripJsonComments`, as 115 lines above. | `records-and-bom` (2 new) |
| H12 | SARIF result order used `localeCompare`. | Code-unit comparison. | `sarif-integration` (2 new) |

## Nits

| ID | Fix | Test |
| :-- | :-- | :-- |
| N1 | `summaryOmitted`/`summaryOmittedReason` asserted, and their invariant checked on every entry. | `summary-preview` (2 new) |
| N2 | Unreachable skip deleted; `validate`/`report`/`diff` print the same sentence with the same `❌`. | `manifest-shape-guard` (no skips) |
| N3 | One cause, one name: audit.md says "part budget (maxPartBytes)" / "large-file budget (largeFileBytes)". | `generator-partitioner-fixes` |
| N4 | "N included of M paths found" — the count is paths, and a skipped directory is one. | `no-silent-loss` |
| N5 | `docs/cli.md` gitignore entries anchored; stale-context output corrected; `explain` shape is `{ rules, line }`. | doc read + `site-anchors` |
| N6 | The placeholder exemption is documented exhaustively with its source of truth, and pinned by a test. | `tests/placeholder-exemption.test.js` (3) |
| N7 | `exportsKind: "esm"` is produced; absence means no exports again. | `ast-edges` |
| N8 | One JSONC reader; the private copy in `config.ts` is gone. | `config-precedence-and-digest` (2 new) |
| N9 | The line cap warns like the depth cap; both go through `treeTruncationWarnings`. | `generator-partitioner-fixes` (2 new) |
| N10 | `payload.codes`; `how-to-context-budget.md` cites `totals.emittedLines`/`counts.partsCount`. | `diff-payload` |
| N11 | The measured example is re-measured: 88 files / 28 969 lines / 1 190 636 B / ≈340 000 tokens. | doc numbers re-derived from `git ls-files src` |
| N12 | Eight test messages interpolate. | the tests themselves |
| N13 | `secretRules` is in `describe.config.settings`; the carve-out is a map with a reason per alias, plus a test that each is a real key. | `contract-completeness` (1 new) |
| N14 | `CONTRIBUTING.md` maps `4.x` headers to the retired line. | doc |
| N15 | Every stacked/orphaned JSDoc block removed or moved (a detector over `src` reports none); three welded statements split. | `npm run lint` (219 files clean) |

## The withdrawn findings' surviving nits

| Finding | Fix |
| :-- | :-- |
| W1 nit | `docs/output.md` and `IncompleteFile` now say plainly that `includedLines` counts the notice for a preview. |
| W2 nit | `partitionFiles` throws below the 2 610 B it can honour instead of clamping; test added. |

## Verification record

- `npm run check`: lint + tsc + 1 138 tests, 1 130 pass, 0 fail, 8 skipped.
- `npm run verify`: the above, plus workflow pins, `sync-docs --check`, site build,
  `check-site-links` (385 internal links, now including `src`), `audit-site`, `readme-lint`
  and `pack-check` — all clean.
- `node audit/work/verify-fixes.mjs`: 28 of 28 checks pass against the built binary.
- Probes kept under `audit/work/`: `h1-probe.mjs` (unterminated quotes), `plan-probe.mjs`
  (`snapshot_plan` off-thread).
</file>

