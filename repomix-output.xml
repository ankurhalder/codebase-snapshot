<file path="tests/part-format-and-reader.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { anchorForPath, generateSnapshot, resolveConfig } from "../dist/index.js";
import { buildTools, parsePartSections, windowText } from "../dist/mcp.js";

/**
 * What a part costs the reader, from the 0.9.12 audit.
 *
 * The snapshot is prompt material, so every line in `parts/*.md` is paid for out of a context
 * window. Nine metadata bullets and a pretty-printed JSON summary above *every* file cost about
 * 32 000 tokens on this repository — 12 % of the whole snapshot — and most of it repeated code
 * that followed three lines later.
 */

const tools = new Map(buildTools().map((tool) => [tool.name, tool]));
const contextFor = (root) => ({ cwd: root, roots: [root], log: () => {} });
async function call(name, args, context) {
  const tool = tools.get(name);
  assert.ok(tool, `tool ${name} exists`);
  return tool.handler(args, context);
}

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "part-format-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const configFor = (root, extra = {}) => {
  const resolved = resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", ...extra },
    {},
    root
  );
  return resolved;
};

test("a section carries one metadata line, its digest stays in the manifest", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts": "export const app = 1;\n",
  });
  const manifest = generateSnapshot(configFor(root));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const entry = manifest.files.find((file) => file.relativePath === "src/app.ts");

  assert.match(
    partText,
    /^- Meta: [\w-]+\/[\w-]+ \| [\w-]+ \| full \| \d+ lines? \(\d+ B\)$/m,
    "one compact line replaces the nine bullets"
  );
  for (const removed of [
    "- Layer:",
    "- Kind:",
    "- Language:",
    "- Inclusion:",
    "- Source Bytes:",
    "- Source Lines:",
    "- Included Lines:",
  ]) {
    assert.equal(partText.includes(removed), false, `${removed} is gone from the part`);
  }
  // The digest is a machine-readable fact, not reading material. It stays where a machine reads.
  assert.equal(
    partText.includes(entry.hashSha256),
    false,
    "the per-file SHA-256 must not be printed into the part"
  );
  assert.equal(
    manifest.files.every((file) => /^[0-9a-f]{64}$/.test(file.hashSha256)),
    true,
    "and every file still records one in the manifest"
  );
});

test("a full file does not repeat its own summary above itself", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts": "export function alpha(): number { return 1; }\nexport const beta = 2;\n",
  });
  const manifest = generateSnapshot(configFor(root));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const entry = manifest.files.find((file) => file.relativePath === "src/app.ts");

  assert.ok(entry.summary, "the manifest still carries the structural summary");
  assert.equal(
    partText.includes('"functions"'),
    false,
    "the pretty-printed JSON summary is not printed for a full file"
  );
  assert.match(partText, /- Summary Quality: ast/, "how the summary was produced is still stated");
});

test("a signatures section still carries its summary, because the body is not the file", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts":
      "export function alpha(a: number): number { const doubled = a * 2; return doubled; }\n" +
      "export const beta = 2;\n",
  });
  generateSnapshot(configFor(root, { skeleton: true }));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  assert.match(partText, /\| signatures \|/, "the compact line names the compression");
  assert.match(
    partText,
    /"functions"/,
    "the structural summary survives, because the body no longer lists what the file contains"
  );
  assert.match(partText, /\{ \/\* \.\.\. \*\/ \}/, "and the body really is a signature");
});

test("a preview says how much of the file it holds", (t) => {
  const source = Array.from({ length: 400 }, (_, index) => `export const v${index} = ${index};`).join(
    "\n"
  );
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/big.ts": source,
  });
  generateSnapshot(
    configFor(root, { largeFileBytes: 200, previewHeadLines: 2, previewTailLines: 2 })
  );
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  assert.match(
    partText,
    /\| preview \| \d+ lines? of 400 lines \(\d+ B\)/,
    "the compact line says what was cut, in one line instead of three"
  );
  assert.match(partText, /#### Bounded Preview/);
});

test("the reader finds a section whose heading had to be capped", (t) => {
  // Two long paths whose rendered headings differ only in the part the cap removes.
  const longPath = `src/${"deeply-nested-directory/".repeat(12)}file.ts`;
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    [longPath]: "export const deep = 1;\n",
  });
  generateSnapshot(configFor(root));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const sections = parsePartSections(partText);

  const target = sections.find((section) => section.anchor === anchorForPath(longPath));
  assert.ok(target, "the anchor line is parsed");
  assert.equal(target.path.length <= 300, true, "and the heading really was capped");
  assert.equal(target.inclusion, "full");
  assert.match(target.body, /export const deep = 1;/);
});

test("snapshot_read states the line range for a preview, and the past-end case", async (t) => {
  const source = Array.from({ length: 300 }, (_, index) => `export const v${index} = ${index};`).join(
    "\n"
  );
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/big.ts": source,
  });
  const context = contextFor(root);
  await call("snapshot_generate", { maxPartBytes: "300k" }, context);
  // A tiny preview budget is set through the config rather than the tool, so write one.
  fs.writeFileSync(
    path.join(root, "snapshot.config.json"),
    JSON.stringify({ preset: "generic", largeFileBytes: 200, previewHeadLines: 3, previewTailLines: 3 })
  );
  await call("snapshot_generate", {}, context);

  const first = await call("snapshot_read", { path: "src/big.ts", lines: 2 }, context);
  assert.match(
    first.text,
    /^Lines 1\u20132 of \d+\.$/m,
    `a window into a preview must still say where it is: ${first.text}`
  );
  assert.match(first.text, /Bounded preview/, "and still say that the body is a preview");

  const past = await call("snapshot_read", { path: "src/big.ts", fromLine: 9000 }, context);
  assert.match(
    past.text,
    /fromLine=9000 is past its end/,
    `asking beyond the end must say so: ${past.text}`
  );
});

test("windowText keeps its own arithmetic straight at the boundary", () => {
  const body = "a\nb\nc";
  assert.equal(windowText(body, 1, 10).totalLines, 3);
  assert.equal(windowText(body, 3, 10).pastEnd, false);
  assert.equal(windowText(body, 4, 10).pastEnd, true);
});

// ---------------------------------------------------------------------------
// The metadata counts, from the 0.9.15 audit.
//
// `compactMetadata` writes `<N lines>[ of <M lines>] (<B> B)` in the last `|`-separated field,
// with English plurals. The reader matched `(\d+) lines` over the whole line, so `1 line (20 B)`
// produced `includedLines: null`, a 1-of-3 skeleton reported the source count (3) instead of the
// emitted one, and a free-form field that happened to read like a count beat the real count.
// The counts now come from the last field, and the `of` form reports its first number — the one
// the manifest records as `includedLines`.

test("a one-line file reports one included line, not null", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/one.ts": "export const one = 1;\n",
  });
  const manifest = generateSnapshot(configFor(root));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const entry = manifest.files.find((file) => file.relativePath === "src/one.ts");

  assert.equal(entry.includedLines, 1, "the manifest records the emitted count");
  assert.match(partText, /^- Meta: [\w-]+\/[\w-]+ \| [\w-]+ \| full \| 1 line \(\d+ B\)$/m);
  const section = parsePartSections(partText).find((candidate) => candidate.path === "src/one.ts");
  assert.ok(section, "the section is parsed");
  assert.equal(section.includedLines, 1, "a singular 1 line is a count, not a missing value");
  assert.equal(section.includedLines, entry.includedLines);
});

test("a twelve-line file reports twelve included lines", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/twelve.ts":
      Array.from({ length: 12 }, (_, index) => "export const v" + index + " = " + index + ";").join("\n") + "\n",
  });
  const manifest = generateSnapshot(configFor(root));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const entry = manifest.files.find((file) => file.relativePath === "src/twelve.ts");

  assert.equal(entry.includedLines, 12);
  assert.match(partText, /\| full \| 12 lines \(\d+ B\)/);
  const section = parsePartSections(partText).find((candidate) => candidate.path === "src/twelve.ts");
  assert.equal(section.includedLines, 12);
});

test("a previewed section reports the emitted count, not the source count", (t) => {
  const source = Array.from(
    { length: 300 },
    (_, index) => "export const v" + index + " = " + index + ";"
  ).join("\n");
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/big.ts": source,
  });
  const manifest = generateSnapshot(
    configFor(root, { largeFileBytes: 200, previewHeadLines: 20, previewTailLines: 19 })
  );
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const entry = manifest.files.find((file) => file.relativePath === "src/big.ts");

  assert.equal(entry.inclusionMode, "preview");
  assert.equal(entry.includedLines, 40, "20 head lines + the omission notice + 19 tail lines");
  assert.equal(entry.originalLines, 300);
  assert.match(partText, /\| preview \| 40 lines of 300 lines \(\d+ B\)/);
  const section = parsePartSections(partText).find((candidate) => candidate.path === "src/big.ts");
  assert.equal(section.includedLines, 40, "the first number is what the body holds");
  assert.notEqual(section.includedLines, entry.originalLines, "the source size is not the emitted count");
});

test("a skeleton that collapses to one line reports one, not the source size", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/fn.ts": "export function alpha(): number {\n  return 1;\n}\n",
  });
  const manifest = generateSnapshot(configFor(root, { skeleton: true }));
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", "part-001.md"), "utf8");
  const entry = manifest.files.find((file) => file.relativePath === "src/fn.ts");

  assert.equal(entry.inclusionMode, "signatures");
  assert.equal(entry.includedLines, 1);
  assert.equal(entry.originalLines, 3);
  assert.match(partText, /\| signatures \| 1 line of 3 lines \(\d+ B\)/);
  const section = parsePartSections(partText).find((candidate) => candidate.path === "src/fn.ts");
  assert.equal(section.includedLines, 1, "the number before \"of\" is the emitted count");
  assert.equal(section.inclusion, "signatures");
});

test("counts are read from the last metadata field, whatever the free-form fields contain", () => {
  const fence = "\u0060".repeat(4);
  const partText = [
    '<a id="a"></a>',
    "### FILE: piped.ts",
    "",
    "- Meta: api|v2/lib | 2 lines | full | 7 lines (120 B)",
    "",
    "#### Content",
    "",
    fence + "typescript",
    "a",
    fence,
    "",
    '<a id="b"></a>',
    "### FILE: numbered2.ts",
    "",
    "- Meta: app2/src | 4 lines | full | 9 lines (90 B)",
    "",
    "#### Content",
    "",
    fence + "typescript",
    "b",
    fence,
    "",
  ].join("\n");

  const sections = parsePartSections(partText);
  assert.equal(sections.length, 2);
  assert.equal(sections[0].path, "piped.ts");
  assert.equal(sections[0].inclusion, "full", "a layer containing a pipe does not shift the inclusion");
  assert.equal(sections[0].includedLines, 7, "the free-form fields before the counts are not counts");
  assert.equal(sections[1].path, "numbered2.ts");
  assert.equal(sections[1].includedLines, 9, "a digit in a layer name is not the count");
});

test("a legacy bullet section still parses, including its included-line count", () => {
  const fence = "\u0060".repeat(4);
  const partText = [
    '<a id="y"></a>',
    "### FILE: legacy.ts",
    "",
    "- Layer: src",
    "- Kind: source",
    "- Language: typescript",
    "- Inclusion: preview",
    "- Source Bytes: 900",
    "- Source Lines: 300",
    "- Included Lines: 40",
    "",
    "#### Bounded Preview",
    "",
    fence + "typescript",
    "x",
    fence,
    "",
  ].join("\n");

  const section = parsePartSections(partText)[0];
  assert.equal(section.inclusion, "preview");
  assert.equal(section.includedLines, 40);
  assert.equal(section.body, "x");
});
</file>

<file path="tests/placeholder-exemption.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { DEFAULT_SECRET_PATTERNS, scanAndRedactSecrets } from "../dist/index.js";

/**
 * The placeholder exemption is a closed list, and the documentation now says so.
 *
 * `docs/configuration.md` claimed "a placeholder is indistinguishable from a secret", which is
 * false: `replace-me-…` and `sk-...` survive while `replace-with-…` is masked. A test asserted
 * the opposite for its own examples. Both were right about their examples and wrong as
 * generalisations, because neither page listed the exempt spellings.
 *
 * These tests pin the list itself and the page that documents it, so the two cannot drift.
 */

const here = path.dirname(fileURLToPath(import.meta.url));
const CONFIGURATION_DOC = fs.readFileSync(path.join(here, "..", "docs", "configuration.md"), "utf8");

const scan = (line, filePath) => scanAndRedactSecrets(line, DEFAULT_SECRET_PATTERNS, filePath);

/** One example per documented shape, with the file that shape is written in. */
const EXEMPT = [
  ["replace-me-with-the-read-tier-key", ".env"],
  ["change-me", ".env"],
  ["your-api-key-here", ".env"],
  ["your_api_key", ".env"],
  ["example-token", ".env"],
  ["sample-value", ".env"],
  ["<fine-grained PAT>", "a.sh"],
  ["<missing-bracket", ".yaml"],
  ["...", ".env"],
  ["sk-...", ".env"],
  ["xxxx", ".env"],
  ["****", ".env"],
];

test("every documented placeholder shape survives the scan", () => {
  for (const [value, filePath] of EXEMPT) {
    const line = `API_KEY=${value}`;
    const { redacted } = scan(line, filePath);
    assert.equal(redacted, line, `${value} is documented as exempt but was masked`);
  }
});

test("a value outside the list is masked, including the near miss", () => {
  // The rule keys on `-me`, so `replace-with-…` — the exact string the old paragraph used as
  // its masking example — is masked. If this ever flips, the doc's table is wrong.
  for (const [value, filePath] of [
    ["replace-with-base64url-48-bytes", ".env"],
    ["my-example-secret", ".env"],
    ["hunter2hunter2", ".env"],
  ]) {
    const line = `API_KEY=${value}`;
    assert.match(scan(line, filePath).redacted, /\[REDACTED/, `${value} must be masked`);
  }
});

test("the documentation lists every exempt example it relies on", () => {
  for (const [value] of EXEMPT) {
    assert.ok(
      CONFIGURATION_DOC.includes(value),
      `docs/configuration.md does not mention ${value}, so the list is not the documented one`
    );
  }
  assert.match(
    CONFIGURATION_DOC,
    /PLACEHOLDER_PATTERNS/,
    "the page names the source of truth rather than paraphrasing it"
  );
  assert.doesNotMatch(
    CONFIGURATION_DOC,
    /a placeholder is indistinguishable from a secret/i,
    "the claim this test exists to correct is gone"
  );
});
</file>

<file path="tests/process-lifecycle.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as http from "node:http";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { fetchLatestVersion, generateSnapshotAsync, isNewer, resolveConfig } from "../dist/index.js";

/**
 * Process-level bookkeeping: the stdout diversion, the update check's deadline, and the version
 * comparison that decides whether to nag at all.
 *
 * These are the parts of the tool a repository never sees, which is why they went wrong quietly —
 * a leaked `process.stdout.write` wrapper and an update check that can hang are both invisible
 * until somebody measures the host process.
 */

function makeRepo(t, name) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), `${name}-`));
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.mkdirSync(path.join(root, "src"), { recursive: true });
  fs.writeFileSync(path.join(root, "src", "a.ts"), "export const a = 1;\n");
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const configWithHook = (root, hook) =>
  resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", hooks: { afterGenerate: hook } },
    {},
    root
  );

test("two overlapping async hooks leave process.stdout.write exactly as they found it", async (t) => {
  // Each `runAfterGenerate` used to install its own wrapper and restore it only if
  // `process.stdout.write` was still that call's own — false for whichever hook finished first.
  // The second then restored the *captured* value, which was the first call's wrapper, so the
  // process was left with a permanent wrapper holding both scopes alive.
  const originalWrite = process.stdout.write;
  assert.equal(process.stdout.write, originalWrite, "nothing is installed to begin with");

  const rootA = makeRepo(t, "hook-a");
  const rootB = makeRepo(t, "hook-b");
  const slow = async () => {
    await new Promise((resolve) => setTimeout(resolve, 30));
  };

  await Promise.all([
    generateSnapshotAsync(configWithHook(rootA, slow)),
    generateSnapshotAsync(configWithHook(rootB, slow)),
  ]);

  assert.equal(
    process.stdout.write,
    originalWrite,
    "both hooks are done, so the diversion must be gone"
  );
  assert.equal(process.stdout.write.name, originalWrite.name, "and it is the original function");
});

test("an update check has a wall-clock deadline, not an idle-socket one", async (t) => {
  // `request.setTimeout` resets on every chunk, so a proxy that sends one byte per second keeps the
  // CLI alive indefinitely. The deadline is absolute now.
  const server = http.createServer((request, response) => {
    response.writeHead(200, { "content-type": "application/json" });
    // Trickle: never ends, and every write resets an *idle* timeout.
    const ticker = setInterval(() => {
      if (!response.writableEnded) response.write(" ");
    }, 40);
    ticker.unref();
    request.on("close", () => clearInterval(ticker));
  });
  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
  t.after(() => {
    server.closeAllConnections();
    server.close();
  });
  const address = server.address();
  const url = `http://127.0.0.1:${address.port}/latest`;

  const started = Date.now();
  const result = await fetchLatestVersion(url, 250);
  const elapsed = Date.now() - started;

  assert.equal(result, null, "a trickling response is a failed check, not a version");
  assert.ok(elapsed < 3000, `the deadline held: ${elapsed} ms`);
});

test("a fast, well-formed response is still read", async (t) => {
  // The deadline must not cost the answer it was guarding.
  const server = http.createServer((request, response) => {
    response.writeHead(200, { "content-type": "application/json" });
    response.end(JSON.stringify({ version: "9.9.9" }));
  });
  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
  t.after(() => {
    server.closeAllConnections();
    server.close();
  });
  const address = server.address();
  assert.equal(await fetchLatestVersion(`http://127.0.0.1:${address.port}/latest`, 2000), "9.9.9");
});

test("a prerelease is never offered as an upgrade, and a release beats its prerelease", () => {
  // Prerelease tags were stripped before comparing, so `0.9.13-alpha.1` outranked `0.9.12` and was
  // recommended to everyone on a stable release — and `0.9.12` looked no newer than
  // `0.9.12-beta.1`, so somebody running a beta was never told the release existed.
  assert.equal(isNewer("0.9.13-alpha.1", "0.9.12"), false, "do not advertise an unstable build");
  assert.equal(isNewer("1.0.0-rc.1", "0.9.12"), false);
  assert.equal(isNewer("0.9.12", "0.9.12-beta.1"), true, "the release is newer than its beta");
  assert.equal(isNewer("0.9.13", "0.9.12-beta.1"), true);

  // The ordinary cases are unchanged.
  assert.equal(isNewer("0.9.6", "0.9.5"), true);
  assert.equal(isNewer("0.10.0", "0.9.9"), true);
  assert.equal(isNewer("0.9.5", "0.9.5"), false);
  assert.equal(isNewer("0.9.5-beta.1", "0.9.5"), false);
  assert.equal(isNewer("v0.9.6", "0.9.5"), true);
  // Build metadata is not precedence, and two prereleases of one core are not worth a notice.
  assert.equal(isNewer("0.9.13+build.5", "0.9.12"), true);
  assert.equal(isNewer("0.9.13-alpha.2", "0.9.13-alpha.1"), false);
});
</file>

<file path="tests/redaction-audit-0-9-16.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import {
  DEFAULT_SECRET_PATTERNS,
  isSensitivePath,
  resolveConfig,
  scanAndRedactSecrets,
} from "../dist/index.js";

/**
 * The redaction findings from the 0.9.16 audit (SEC-01 … SEC-08, SCOPE-07).
 *
 * Each case is a credential that reached `parts/*.md` in clear, or a rewrite that changed the
 * program the snapshot describes. The assertions are on the emitted text, not on the finding
 * list: a finding without a mask is the failure mode that matters.
 */

const scan = (content, filePath = "fixture.ts") =>
  scanAndRedactSecrets(content, DEFAULT_SECRET_PATTERNS, filePath);

const assertMasked = (content, secret, filePath, label) => {
  const { redacted } = scan(content, filePath);
  assert.equal(
    redacted.includes(secret),
    false,
    `${label ?? "the value"} must not survive: ${JSON.stringify(redacted)}`
  );
  assert.ok(redacted.includes("[REDACTED"), `${label ?? "the value"} must be masked: ${JSON.stringify(redacted)}`);
};

const PEM_BODY = [
  "AAAABBBBCCCCDDDDEEEEFFFFGGGGHHHH0001",
  "AAAABBBBCCCCDDDDEEEEFFFFGGGGHHHH0002",
  "AAAABBBBCCCCDDDDEEEEFFFFGGGGHHHH0003",
];

const assertNoPemBody = (redacted, label) => {
  for (const line of PEM_BODY) {
    assert.equal(redacted.includes(line), false, `${label}: the base64 body survived`);
  }
};

test("SEC-01 a PEM block keeps the syntax around it", () => {
  // An array of quoted lines used to be welded into one string: the block was replaced by
  // one marker plus blank lines, which removed every intermediate quote and comma.
  const array = `const key = [\n  "-----BEGIN PRIVATE KEY-----",\n${PEM_BODY.map(
    (line) => `  "${line}"`
  ).join(",\n")},\n  "-----END PRIVATE KEY-----",\n].join("\\n");`;
  const arrayOut = scan(array).redacted;
  assertNoPemBody(arrayOut, "array");
  assert.doesNotThrow(() => new Function(arrayOut), "the array section must parse");
  assert.ok(arrayOut.includes(","), "the element separators survive");

  // A concatenation used to lose its `+` operators.
  const concatSource = `"-----BEGIN PRIVATE KEY-----\\n" +\n${PEM_BODY.map(
    (line) => `  "${line}\\n" +`
  ).join("\n")}\n  "-----END PRIVATE KEY-----"`;
  const concatOut = scan(`const key = ${concatSource};`).redacted;
  assertNoPemBody(concatOut, "concat");
  assert.doesNotThrow(() => new Function(concatOut), "the concatenation must parse");
  assert.equal((concatOut.match(/\+/g) ?? []).length, (concatSource.match(/\+/g) ?? []).length);

  // A CRLF block keeps CRLF.
  const crlf = `const key = [\r\n  "-----BEGIN PRIVATE KEY-----",\r\n${PEM_BODY.map(
    (line) => `  "${line}",`
  ).join("\r\n")}\r\n  "-----END PRIVATE KEY-----",\r\n];`;
  const crlfOut = scan(crlf).redacted;
  assertNoPemBody(crlfOut, "crlf");
  assert.ok(crlfOut.includes("\r\n"), "CRLF survives");
  assert.doesNotThrow(() => new Function(crlfOut), "the CRLF array must parse");
});

test("SEC-02 a credential split across a concatenation is masked without touching the operator", () => {
  // The value literal is masked; the `+` and both sets of quotes stay, so the line parses.
  const line = `const s = "export API_KEY=" + "hunter2hunter2";`;
  const { redacted, findings } = scan(line);
  assert.equal(redacted.includes("hunter2hunter2"), false, redacted);
  assert.ok(redacted.includes('" + "'), "the operator and the quotes survive: " + redacted);
  assert.doesNotThrow(() => new Function(redacted), "the emitted line must parse");
  assert.ok(findings.length > 0);

  // A variable is not a credential and the audit's example must stay byte-identical.
  const auditExample = `const t = 'export API_KEY="' + secretVar + '"';`;
  assert.equal(scan(auditExample).redacted, auditExample);
});

test("SEC-03 a quoted value containing the other quote character is masked whole", () => {
  const cases = [
    [`{"password": "hunter'2"}`, "hunter'2", "config.json"],
    [`api_key: 'abc"def'`, 'abc"def', "config.yaml"],
    [`password: "p\\"ss'w0rd"`, "ss'w0rd", "config.yaml"],
  ];
  for (const [line, secret, filePath] of cases) {
    assertMasked(line, secret, filePath, line);
  }
  // The control: the same shape without the inner quote is still masked.
  assertMasked(`{"password": "hunter2"}`, "hunter2", "config.json");
});

test("SEC-04 a YAML block scalar and a next-line value are masked", () => {
  const block = "password: |\n  hunter2hunter2hunter2\nhost: db";
  const blockOut = scan(block, "app.yaml").redacted;
  assert.equal(blockOut.includes("hunter2hunter2hunter2"), false, blockOut);
  assert.ok(blockOut.includes("password: |"), "the indicator survives");
  assert.ok(blockOut.includes("host: db"), "the next key survives");

  const folded = "secret: >-\n  hunter2hunter2\nhost: db";
  assert.equal(scan(folded, "app.yaml").redacted.includes("hunter2hunter2"), false);

  const json = '{\n  "password":\n    "hunter2hunter2"\n}';
  const jsonOut = scan(json, "config.json").redacted;
  assert.equal(jsonOut.includes("hunter2hunter2"), false, jsonOut);
  assert.doesNotThrow(() => JSON.parse(jsonOut), "the masked JSON must parse");

  // The same shape in source code is an expression, not a value.
  const source = "{\n  password:\n    compute()\n}";
  assert.equal(scan(source, "app.ts").redacted, source);
});

test("SEC-05 every authorization scheme is masked, and prose is not", () => {
  const token = "9f8e7d6c5b4a39281706f5e4d3c2b1a0";
  for (const scheme of ["Bearer", "Basic", "Token", "ApiKey", "Splunk", "AWS4-HMAC-SHA256"]) {
    assertMasked(`Authorization: ${scheme} ${token}`, token, "app.ts", scheme);
  }
  assertMasked(`authorization: Token ${token}`, token, "app.ts", "lowercase header");
  for (const prose of ["Authorization: Bearer authentication", "Authorization: Basic authentication"]) {
    assert.equal(scan(prose).redacted, prose);
  }
});

test("SEC-06 Docker's space-separated ENV form is masked, and nothing else is", () => {
  assertMasked("ENV API_KEY abc123def456ghi789", "abc123def456ghi789", "Dockerfile");
  assertMasked("ENV API_KEY=abc123def456ghi789", "abc123def456ghi789", "Dockerfile");
  const path = "ENV PATH /usr/bin";
  assert.equal(scan(path, "Dockerfile").redacted, path);
  // In a shell script `env KEY value` is a command, not an assignment.
  const shell = "env API_KEY abc123def456ghi789";
  assert.equal(scan(shell, "run.sh").redacted, shell);
});

test("SEC-07 credential files that were missing from the deny list are skipped", () => {
  for (const path of [
    "config/.pypirc",
    "auth.json",
    ".composer-auth.json",
    ".config/gcloud/application_default_credentials.json",
    ".terraform/credentials.tfrc.json",
  ]) {
    assert.equal(isSensitivePath(path), true, `${path} must be sensitive`);
  }
  // Templates of credential files are still readable.
  assert.equal(isSensitivePath("credentials.example.json"), false);
  assert.equal(isSensitivePath(".env.example"), false);
});

test("SCOPE-07 a key whose name contains a template word is still a key", () => {
  assert.equal(isSensitivePath("id_rsa.example.pem"), true);
  assert.equal(isSensitivePath("certs/server.sample.key"), true);
  assert.equal(isSensitivePath("credentials.example.json"), false);
});

test("SEC-08 a rule that can match the empty string is rejected with its name", () => {
  for (const pattern of [/(?:)/gu, /x*/, "a?"]) {
    assert.throws(
      () =>
        resolveConfig(
          { cwd: process.cwd(), secrets: { customPatterns: [pattern] } },
          {},
          process.cwd()
        ),
      /can match the empty string/,
      `${String(pattern)} must be refused`
    );
  }
  assert.doesNotThrow(() =>
    resolveConfig(
      { cwd: process.cwd(), secrets: { customPatterns: [/corp-[A-Z0-9]{8}/] } },
      {},
      process.cwd()
    )
  );
});
</file>

<file path="tests/redaction-bridging-and-cr.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { countLines, generateSnapshot, resolveConfig, scanAndRedactSecrets } from "../dist/index.js";
import { DEFAULT_SECRET_PATTERNS } from "../dist/index.js";
import { parsePartSections } from "../dist/mcp.js";

/**
 * 0.9.14 — three ways the generator edited text it had no business editing.
 *
 * 1. The PEM block pattern is lazy over `[\s\S]`, which means it has no opinion about what lies
 *    between a `BEGIN` and the next `END` — including a second `BEGIN`. A file holding an
 *    unterminated key fixture and, later, a terminated one had every line in between replaced by
 *    blank lines. The generator did this to its own test suite.
 * 2. Line counts and preview truncation understood only `\n`, so a CR-only file was one line:
 *    `largeFileBytes` never fired and the whole file went into a part with its CRs intact.
 * 3. The last-resort section truncation cut the rendered Markdown at a byte offset, which lands
 *    inside the code fence — leaving it open, so every following file in that part was swallowed
 *    into the truncated file's code block.
 */

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "redaction-cr-"));
  execFileSync("git", ["init", "-q"], { cwd: root, stdio: "ignore" });
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  for (const [name, body] of Object.entries(files)) {
    const absolute = path.join(root, name);
    fs.mkdirSync(path.dirname(absolute), { recursive: true });
    fs.writeFileSync(absolute, body);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const configFor = (root, extra = {}) =>
  resolveConfig({ cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", ...extra }, {}, root);

// ---------------------------------------------------------------------------
// 1.1 — a PEM block may not bridge across another PEM block
// ---------------------------------------------------------------------------

/**
 * The shape that did the damage: an unterminated `BEGIN`, four lines of source, then a complete
 * block. The lazy match ran from the first `BEGIN` to the *second* block's `END` and swallowed
 * the source in between.
 */
const BRIDGING_FIXTURE = [
  'test("unterminated key fixture", () => {',
  '  const header = "-----BEGIN RSA PRIVATE KEY-----";',
  '  assert.equal(header.length, 31);',
  "});",
  "",
  'test("terminated key fixture", () => {',
  '  const key = "-----BEGIN RSA PRIVATE KEY-----\\nMIIEowIBAAKCAQEA\\n-----END RSA PRIVATE KEY-----";',
  "  assert.ok(key.includes('PRIVATE'));",
  "});",
].join("\n");

test("a PEM block does not bridge an unterminated header into the next block", () => {
  const { redacted } = scanAndRedactSecrets(BRIDGING_FIXTURE, DEFAULT_SECRET_PATTERNS, "keys.test.js");

  assert.match(
    redacted,
    /assert\.equal\(header\.length, 31\);/,
    "the assertion that sat between the two headers must survive verbatim"
  );
  assert.match(
    redacted,
    /assert\.ok\(key\.includes\('PRIVATE'\)\);/,
    "the second test's body must survive too"
  );
  assert.match(redacted, /test\("terminated key fixture"/, "the second test's own header survives");
  assert.doesNotMatch(redacted, /MIIEowIBAAKCAQEA/, "the terminated block's body is still masked");
});

test("a single terminated block is still masked as one unit", () => {
  const source = [
    "const key = [",
    '  "-----BEGIN RSA PRIVATE KEY-----",',
    '  "MIIEowIBAAKCAQEAabcdefghijklmnop",',
    '  "-----END RSA PRIVATE KEY-----",',
    "].join('\\n');",
    "const after = 1;",
  ].join("\n");
  const { redacted, findings } = scanAndRedactSecrets(source, DEFAULT_SECRET_PATTERNS, "k.js");

  assert.equal(findings.length, 1);
  assert.match(redacted, /private key block omitted/, "the block is replaced by one marker");
  assert.doesNotMatch(redacted, /MIIEowIBAAKCAQEA/, "no body line survives");
  assert.match(redacted, /const after = 1;/, "and the line after it is untouched");
});

test("a one-line escaped PEM in JSON is still masked whole", () => {
  // The block pattern must not require a real newline after the header: `\n` inside a JSON string
  // is two characters, and a rule that insisted on a line break would mask the header alone and
  // leave the base64 body in the snapshot.
  const source =
    '{"privateKey":"-----BEGIN RSA PRIVATE KEY-----\\nMIIEowIBAAKCAQEAabcdefghij\\n-----END RSA PRIVATE KEY-----"}';
  const { redacted } = scanAndRedactSecrets(source, DEFAULT_SECRET_PATTERNS, "config.json");

  assert.doesNotMatch(redacted, /MIIEowIBAAKCAQEAabcdefghij/, "the escaped body must be masked too");
  assert.match(redacted, /REDACTED/, "and something is masked in its place");
});

// ---------------------------------------------------------------------------
// 1.6 — CR-only line endings
// ---------------------------------------------------------------------------

const CR_FILE = ["alpha", "beta", "gamma", "delta", "epsilon", ""].join("\r");

test("countLines counts CR-terminated lines", () => {
  assert.equal(countLines(CR_FILE), 5);
  assert.equal(countLines("one\rtwo\r"), 2);
  assert.equal(countLines("one\r\ntwo\r\n"), 2, "CRLF is still two lines");
  assert.equal(countLines(""), 0);
});

test("a CR-only file over largeFileBytes is previewed and emitted with LF endings", (t) => {
  const body = Array.from({ length: 400 }, (_value, index) => `line ${index} of a CR-only file`).join(
    "\r"
  );
  const root = makeRepo(t, { "src/big.txt": `${body}\r` });

  const manifest = generateSnapshot(
    configFor(root, { largeFileBytes: 1024, previewHeadLines: 3, previewTailLines: 2 })
  );
  const file = manifest.files.find((entry) => entry.relativePath === "src/big.txt");

  assert.equal(file.isPreviewTruncated, true, "the preview budget must apply to a CR-only file");
  assert.equal(file.inclusionMode, "preview");
  assert.equal(file.originalLines, 400, "the manifest must report the real line count");

  const part = fs.readFileSync(path.join(root, "snapshot", "parts", file.part), "utf8");
  assert.doesNotMatch(part, /\r/, "no carriage return reaches an artifact");
  assert.match(part, /lines omitted/, "and the file says it was cut");
});

// ---------------------------------------------------------------------------
// 1.7 — the last-resort section truncation must not leave a code fence open
// ---------------------------------------------------------------------------

test("a hard-truncated section keeps a closed code fence and stays readable", (t) => {
  // `fenceForContent` picks a fence one character longer than the longest backtick run in the
  // body, so a body of 1800 backticks needs a 1652-character fence at both ends — which is more
  // than the section budget can hold once the fixed metadata is counted. That is the path that
  // hard-truncates the *rendered* section, and it used to cut the closing fence off: the section
  // ended inside a code block that never closed.
  const root = makeRepo(t, {
    "src/a-backticks.md": "`".repeat(1800),
    "src/b-after.md": "the file after the truncated one\n",
  });

  const manifest = generateSnapshot(
    configFor(root, { maxPartBytes: 6000, include: ["src/a-backticks.md", "src/b-after.md"] })
  );

  let sawTruncated = false;
  for (const part of manifest.parts) {
    const markdown = fs.readFileSync(path.join(root, "snapshot", "parts", part.filename), "utf8");
    const sections = parsePartSections(markdown);
    assert.equal(
      sections.length,
      part.fileCount,
      `${part.filename} is readable: every file the manifest says it holds is a section`
    );
    if (markdown.includes("section truncated")) sawTruncated = true;
  }
  assert.equal(sawTruncated, true, "the budget was tight enough to force the truncation");
});

test("no part leaves a code fence open", (t) => {
  // The invariant behind the reader test: count the fence delimiters in each part. Every part
  // opens and closes its blocks, whatever the truncation did to the bodies.
  const root = makeRepo(t, {
    "src/a-backticks.md": "`".repeat(1800),
    "src/b-after.md": "```js\nconst x = 1;\n```\n",
    "src/c-normal.md": "# heading\n",
  });

  const manifest = generateSnapshot(
    configFor(root, {
      maxPartBytes: 6000,
      include: ["src/a-backticks.md", "src/b-after.md", "src/c-normal.md"],
    })
  );

  for (const part of manifest.parts) {
    const markdown = fs.readFileSync(path.join(root, "snapshot", "parts", part.filename), "utf8");
    const fenceLines = markdown
      .split("\n")
      .filter((line) => /^`{4,}[a-z]*$/.test(line))
      .map((line) => line.replace(/[a-z]/g, ""));
    assert.equal(
      fenceLines.length % 2,
      0,
      `${part.filename} has an even number of 4+-backtick delimiter lines`
    );
  }
});
</file>

<file path="tests/redaction-prose-and-escapes.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as path from "node:path";
import test from "node:test";

import { DEFAULT_SECRET_PATTERNS, scanAndRedactSecrets } from "../dist/index.js";

/**
 * Redaction that corrupted the text it was protecting, from the 0.9.12 audit.
 *
 * Every case here was found *inside this repository's own snapshot*: the tool rewrote its own
 * documentation and its own tests into sentences that no longer meant what they said. That is the
 * worse half of redaction's failure surface — a missed secret leaks, but an over-eager mask
 * changes the meaning of code a model is about to reason from, and it does so silently.
 */

const scan = (content) => scanAndRedactSecrets(content, DEFAULT_SECRET_PATTERNS, "fixture.ts");

const assertUntouched = (content, label) => {
  const { redacted, findings } = scan(content);
  assert.equal(redacted, content, `${label}: the line must survive verbatim`);
  assert.equal(findings.length, 0, `${label}: no finding may be reported`);
};

test("prose that happens to contain `secret: ` keeps its words", () => {
  // docs/configuration.md:271, exactly as it reached part-001.md with the `a` masked.
  assertUntouched(
    "Redaction is **fail-closed**, so a placeholder is indistinguishable from a secret: a",
    "documentation sentence"
  );
  assertUntouched("indistinguishable from a secret: a value", "prose, mid-line");
  assertUntouched("worse than a missed secret: the snapshot is", "prose with a longer word");
  // A test comment that named a variable after the colon.
  assertUntouched(
    "// A branch name is user input and can carry a token: x reaches the manifest",
    "source comment"
  );
});

test("a quoted template interpolation is code, not a credential", () => {
  // tests/explain-ignored-descendant.test.js, as emitted with `"${appliesTo}"` masked.
  assertUntouched(
    'assert.ok(token.length > 0, `${option.flag} appliesTo has an empty token: "${appliesTo}"`);',
    "template literal"
  );
  assertUntouched('const message = `count: "${String(value)}"`;', "wrapped expression");
});

test("a doubly-escaped quote does not end the value", () => {
  // A quoted value inside a quoted string — how every fixture that embeds JSON is written. The
  // match used to stop at the inner `\\"`, leaving `ssw0rdINVENTED` in clear and the line broken.
  const line = `'export const a1 = JSON.parse(\\'{"password": "p@\\\\"ssw0rdINVENTED"}\\');\\n'`;
  const { redacted, findings } = scan(line);
  assert.ok(findings.length > 0, "the value is still recognised as a credential");
  assert.equal(redacted.includes("ssw0rdINVENTED"), false, "no fragment of it may survive");
  assert.equal(
    redacted,
    `'export const a1 = JSON.parse(\\'{"password": "[REDACTED: potential secret-like value omitted from snapshot]"}\\');\\n'`,
    "the emitted line must still parse"
  );
});

test("a one-character bare value is not a credential", () => {
  // `secret: a` in prose and `PASSWORD=a` are the same shape; one is a sentence, the other is a
  // terrible password. A single character protects nothing, and masking it cost the sentence.
  assertUntouched("the token: a", "prose ending in a one-character word");
  assertUntouched("for (const key of ['a']) {}", "one-character string element");
  // Quoting is evidence that a value was meant, so the quoted rule keeps its one-character floor.
  const quoted = scan('password: "h"');
  assert.ok(quoted.findings.length > 0, "a quoted one-character value is still masked");
});

test("real credentials in the shapes the prose guard could have broken", () => {
  // The line shape decides which format the value belongs to. An unquoted `KEY: identifier` in a
  // source file is an expression and is deliberately left readable; the same text in YAML, a
  // .env or a shell script is a value.
  const cases = [
    ["dbPassword: hunter2", "fixture.yml"],
    ["dbPassword: hunter2  # rotate", "fixture.yml"],
    ['dbPassword: "hunter2"', "fixture.yml"],
    ["POSTGRES_PASSWORD=hunter2", "fixture.env"],
    ["      POSTGRES_PASSWORD: hunter2hunter2", "fixture.yml"],
    ['{"apiKey": "abcdefgh12345678"}', "fixture.json"],
    ["awsSecret: hunter2hunter2", "fixture.yml"],
    ["DB_PASSWORD=abc123 node app.js", "fixture.sh"],
  ];
  for (const [line, file] of cases) {
    const { redacted, findings } = scanAndRedactSecrets(line, DEFAULT_SECRET_PATTERNS, file);
    assert.ok(findings.length > 0, `a finding is expected for: ${line}`);
    assert.equal(/hunter2|abcdefgh|abc123/.test(redacted), false, `the value leaked: ${line}`);
  }
});

test("no documentation line in this repository is rewritten by redaction", () => {
  const offenders = [];
  for (const file of fs.readdirSync("docs")) {
    if (!file.endsWith(".md")) continue;
    const full = path.join("docs", file);
    for (const line of fs.readFileSync(full, "utf8").split("\n")) {
      if (!/\b(?:secret|token|password|credential)\b\s*:/i.test(line)) continue;
      const { redacted } = scanAndRedactSecrets(line, DEFAULT_SECRET_PATTERNS, full);
      if (redacted !== line) offenders.push(`${full}: ${line.trim()}`);
    }
  }
  assert.deepEqual(
    offenders,
    [],
    "a documentation sentence is prose, not an assignment, and must survive untouched"
  );
});
</file>

<file path="tests/redaction-reporting.test.js">
/**
 * How redaction and warnings are *reported*, which is where 4.1.1 went wrong.
 *
 * Four defects reached a real repository, and the suite was blind to all four because it
 * asserted the mechanism (a value was masked) and never the report (what a human reads):
 *
 *   1. One line matching two rules produced two findings, so an unquoted `AUTH_TOKEN=` line
 *      counted twice and `reports/audit.md` printed the same file:line on two rows.
 *   2. Every finding was also appended to `manifest.warnings`, so a clean repository reported
 *      `Warnings: 156` — a number that reads as 156 problems.
 *   3. The summary printed `warnings.slice(0, 10)` with no hint that 146 rows existed elsewhere.
 *   4. `reports/audit.md` and the snapshot `README.md` formatted counts with `toLocaleString()`
 *      and no locale, so the same repository produced `1,24,976` on an `en-IN` machine and
 *      `124,976` on an `en-US` one — different artifact bytes from the same commit.
 *
 * These tests drive the real CLI, so they see exactly what the user sees.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeRepo(t, files) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "redaction-reporting-"));
  for (const [relative, content] of Object.entries(files)) {
    const full = path.join(dir, relative);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content, "utf8");
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function run(dir, args = []) {
  const result = spawnSync(process.execPath, [BIN, "generate", ...args], {
    cwd: dir,
    encoding: "utf8",
  });
  if (result.error) throw result.error;
  return {
    status: result.status ?? 1,
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
    output: `${result.stdout ?? ""}${result.stderr ?? ""}`,
  };
}

const readManifest = (dir) =>
  JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));
const readAudit = (dir) =>
  fs.readFileSync(path.join(dir, "snapshot", "reports", "audit.md"), "utf8");

/** Two unquoted assignments; each line matches both credential rules. */
const TWO_RULE_LINES = "JWT_SECRET=replace-with-base64url-48-bytes\nAPI_TOKEN=abc123\n";

test("one line that matches two rules is one finding, not two", (t) => {
  const dir = makeRepo(t, { "package.json": '{"name":"fixture"}', ".env.example": TWO_RULE_LINES });

  const result = run(dir);
  assert.equal(result.status, 0, result.output);

  const manifest = readManifest(dir);
  assert.equal(
    manifest.totals.redactedLines,
    2,
    "two lines were masked, so the count is two — it was four when each (line, rule) pair counted"
  );

  const audit = readAudit(dir);
  const rows = audit.split("\n").filter((line) => line.startsWith("| `.env.example` |"));
  assert.equal(rows.length, 2, `one row per line, got: ${JSON.stringify(rows)}`);
  for (const row of rows) {
    assert.match(row, /credential-assignment-unquoted/, "the row names the rule that matched");
    assert.match(row, /env-secret-assignment/, "and the other one too");
  }
  assert.match(audit, /2 line\(s\) contain values that were redacted/);
});

test("a redaction is not a warning, and the summary says where the detail is", (t) => {
  const dir = makeRepo(t, { "package.json": '{"name":"fixture"}', ".env.example": TWO_RULE_LINES });

  const result = run(dir);
  const manifest = readManifest(dir);

  assert.equal(manifest.totals.warningCount, 0, "a masked value is the tool working, not a problem");
  assert.deepEqual(manifest.warnings, []);
  assert.equal(
    manifest.warnings.some((warning) => /credential-assignment|env-secret-assignment/.test(warning)),
    false,
    "redaction rows must not be folded into the warning list"
  );

  assert.match(result.output, /Redacted:\s+2 line\(s\)/, "the summary reports the count");
  assert.match(result.output, /reports[\\/]audit\.md/, "and points at the detail");
});

test("with the audit artifact disabled, the count is not lost silently", (t) => {
  const dir = makeRepo(t, { "package.json": '{"name":"fixture"}', ".env.example": TWO_RULE_LINES });

  const result = run(dir, ["--skip-artifacts", "audit"]);
  assert.equal(result.status, 0, result.output);

  const manifest = readManifest(dir);
  assert.equal(manifest.totals.redactedLines, 2, "the count survives");
  assert.ok(
    manifest.warnings.some((warning) => /reports\/audit\.md is disabled/.test(warning)),
    `the manifest must say the per-line detail was not written: ${JSON.stringify(manifest.warnings)}`
  );
  assert.match(result.output, /audit\.md is disabled/);
});

test("warnings beyond the tenth are not silently dropped", (t) => {
  const files = { "package.json": '{"name":"fixture"}' };
  // A parse error is one warning per file, so twelve broken files exceed the ten-row preview.
  for (let index = 0; index < 12; index += 1) {
    files[`src/broken-${index}.ts`] = "export const = ;\n";
  }
  const dir = makeRepo(t, files);

  const result = run(dir);
  const manifest = readManifest(dir);
  const total = manifest.warnings.length;

  assert.ok(total > 10, `the fixture must produce more than ten warnings, got ${total}`);
  assert.match(result.output, new RegExp(`Warnings:\\s+${total}`), "the count is stated");
  assert.ok(
    result.output.includes(`… and ${total - 10} more in manifest.warnings[]`),
    `the summary must say where the rest are: ${result.output}`
  );
});

test("artifact counts do not depend on the machine's locale", (t) => {
  // Five digits, where en-US groups `100,000` and en-IN groups `1,00,000`. The artifact must
  // read the same on both, or the same commit produces different snapshot bytes per machine.
  const body = `${"x\n".repeat(100000)}`;
  const dir = makeRepo(t, { "package.json": '{"name":"fixture"}', "big.txt": body });

  const result = run(dir);
  assert.equal(result.status, 0, result.output);

  const audit = readAudit(dir);
  assert.match(
    audit,
    /\*\*Source Lines:\*\* \d{3},\d{3}/,
    "counts use three-digit grouping regardless of the host locale"
  );
  assert.equal(audit.includes("1,00,"), false, "no en-IN grouping may leak into the artifact");

  const readme = fs.readFileSync(path.join(dir, "snapshot", "README.md"), "utf8");
  assert.equal(readme.includes("1,00,"), false, "the snapshot README is locale-independent too");
});
</file>

<file path="tests/remote-source.test.js">
/**
 * Remote ingestion: parse, refuse, clone, record.
 *
 * The security tests run without network: they assert the refusals. The clone test uses a local
 * file: URL behind --allow-private, which is the documented air-gapped path and the only way to
 * exercise a real clone deterministically.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { pathToFileURL } from "node:url";
import { isPrivateHost, parseRemoteSource } from "../dist/index.js";

test("a repository URL becomes host, owner, repo and ref", () => {
  const parsed = parseRemoteSource("https://github.com/owner/repo.git#main");
  assert.equal(parsed.ok, true);
  assert.equal(parsed.source.host, "github.com");
  assert.equal(parsed.source.owner, "owner");
  assert.equal(parsed.source.repo, "repo");
  assert.equal(parsed.source.ref, "main");
  assert.equal(parsed.source.url, "https://github.com/owner/repo");
});

test("non-https, credentials, and short paths are refused", () => {
  assert.equal(parseRemoteSource("http://github.com/o/r").ok, false);
  assert.match(parseRemoteSource("http://github.com/o/r").message, /https/);
  assert.match(parseRemoteSource("https://user:pw@github.com/o/r").message, /credentials/);
  assert.match(parseRemoteSource("https://github.com/owner").message, /must name a repository/);
  assert.match(parseRemoteSource("file:///tmp/repo").message, /--allow-private/);
});

test("private addresses are refused unless allowed", () => {
  for (const host of ["127.0.0.1", "10.0.0.5", "192.168.1.2", "172.20.0.1", "169.254.169.254", "localhost", "[::1]"]) {
    assert.equal(isPrivateHost(host), true, host);
  }
  assert.equal(isPrivateHost("github.com"), false);
  const refused = parseRemoteSource("https://169.254.169.254/latest/meta-data");
  assert.equal(refused.ok, false);
  assert.match(refused.message, /private address/);
  const allowed = parseRemoteSource("https://127.0.0.1/o/r", { allowPrivate: true });
  assert.equal(allowed.ok, true);
});

test("file: is only for --allow-private, and it clones", (t) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "remote-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  const source = path.join(root, "source");
  fs.mkdirSync(path.join(source, "src"), { recursive: true });
  fs.writeFileSync(path.join(source, "package.json"), '{"name":"r","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(source, "src", "a.ts"), "export const a = 1;\n");
  const git = (args) => spawnSync("git", args, { cwd: source, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) {
    t.skip("git is not available");
    return;
  }
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "add", "-A"]);
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q", "-m", "one"]);

  const url = pathToFileURL(source).href;
  const parsed = parseRemoteSource(url, { allowPrivate: true });
  assert.equal(parsed.ok, true, parsed.message);
  assert.equal(parsed.source.kind, "file");
  assert.match(parsed.source.repo, /source/);
});

test("generate --remote records provenance and writes into the caller's directory", (t) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "remote-run-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  const source = path.join(root, "source");
  fs.mkdirSync(path.join(source, "src"), { recursive: true });
  fs.writeFileSync(path.join(source, "package.json"), '{"name":"r","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(source, "src", "a.ts"), "export const a = 1;\n");
  const git = (args) => spawnSync("git", args, { cwd: source, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) {
    t.skip("git is not available");
    return;
  }
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "add", "-A"]);
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q", "-m", "one"]);

  const workdir = path.join(root, "work");
  fs.mkdirSync(workdir, { recursive: true });
  const bin = path.join(path.dirname(new URL(import.meta.url).pathname.replace(/^\//, "")), "..", "dist", "bin.js");
  const result = spawnSync(
    process.execPath,
    [bin, "generate", "--remote", pathToFileURL(source).href, "--allow-private", "--out-dir", "snap-out"],
    { cwd: workdir, encoding: "utf8" }
  );
  assert.equal(result.status, 0, result.stdout + result.stderr);
  const manifest = JSON.parse(fs.readFileSync(path.join(workdir, "snap-out", "manifest.json"), "utf8"));
  assert.ok(manifest.source, "the manifest records where the tree came from");
  assert.match(manifest.source.commit, /^[0-9a-f]{40}$/);
  assert.equal(manifest.source.host, "file");
  assert.ok(fs.existsSync(path.join(workdir, "snap-out", "PROMPT.md")));
});
