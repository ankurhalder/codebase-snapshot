<file path="tests/incomplete-contract.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, validateSnapshot } from "../dist/index.js";

/**
 * The completeness contract is an input once `manifest.json` is on disk.
 *
 * `verifyInMemory` enforces it while generating. `validate` is the only command that reads a
 * manifest as an input, and it never looked at `incomplete[]` at all: ten tampered variants of a
 * real record — including a `relativePath` of `../escape.ts`, the only one of the three
 * path-bearing arrays that was unguarded — each reported "valid and up to date".
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "incomplete-contract-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content, "utf8");
  return target;
}

/** A snapshot with exactly one previewed file, so `incomplete[]` has one real record. */
function previewSnapshot(t) {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  write(dir, "src/big.ts", Array.from({ length: 900 }, (_, i) => `export const v${i} = ${i};`).join("\n") + "\n");
  generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 1024 });

  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  assert.equal(manifest.incomplete.length, 1, "the fixture must have one incomplete record");
  assert.equal(manifest.counts.incompleteCount, 1);
  assert.equal(manifest.incomplete[0].relativePath, "src/big.ts");
  assert.equal(manifest.incomplete[0].reason, "large-file-budget");

  return { dir, manifest, manifestPath };
}

function validateTampered(dir, mutate) {
  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  mutate(manifest);
  fs.writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, "utf8");
  return validateSnapshot({ cwd: dir });
}

const TAMPERINGS = [
  ["incomplete[] emptied, count kept", "shape", (m) => { m.incomplete = []; }, /does not match the length/],
  ["incompleteCount = 42", "shape", (m) => { m.counts.incompleteCount = 42; }, /does not match the length/],
  ["incompleteCount is not a number", "shape", (m) => { m.counts.incompleteCount = "1"; }, /counts\.incompleteCount/],
  ["an unknown reason", "shape", (m) => { m.incomplete[0].reason = "bogus"; }, /unknown "reason"/],
  ["includedLines beyond the file", "shape", (m) => { m.incomplete[0].includedLines = 99999; }, /includedLines/],
  ["omittedLines that does not match the ranges", "shape", (m) => { m.incomplete[0].omittedLines = 0; }, /omittedLines/],
  ["omittedRanges is not an array", "shape", (m) => { m.incomplete[0].omittedRanges = "not-an-array"; }, /omittedRanges/],
  [
    "a range outside the file",
    "shape",
    (m) => { m.incomplete[0].omittedRanges = [[1, 1]]; },
    /omittedLines.* does not match the ranges/,
  ],
  [
    "a range before line 1",
    "shape",
    (m) => { m.incomplete[0].omittedRanges = [[0, 5]]; },
    /outside 1-900/,
  ],
  [
    "relativePath escapes the repository",
    "shape",
    (m) => { m.incomplete[0].relativePath = "../escape.ts"; },
    /must stay inside the repository/,
  ],
  [
    "incomplete[] and count emptied, files[] still truncated",
    "drift",
    (m) => {
      m.incomplete = [];
      m.counts.incompleteCount = 0;
    },
    /missing from incomplete\[\]/,
  ],
  [
    "files[].truncationReason disagrees with incomplete[].reason",
    "drift",
    (m) => {
      const file = m.files.find((entry) => entry.relativePath === "src/big.ts");
      file.truncationReason = "part-budget";
    },
    /records truncationReason part-budget/,
  ],
  [
    "incomplete[] names a path that is not in files[]",
    "drift",
    (m) => { m.incomplete[0].relativePath = "src/ghost.ts"; },
    /is in incomplete\[\] but not in files\[\]/,
  ],
];

test("a real incomplete record agrees with files[] and validates clean", (t) => {
  const { dir } = previewSnapshot(t);
  // The same settings the generation used: a different largeFileBytes is configuration drift, and
  // this test is about the completeness contract.
  const result = validateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 1024 });
  assert.equal(result.valid, true, result.errors.join("; "));
  assert.deepEqual(result.drift.partIssues, []);
});

for (const [label, kind, mutate, expected] of TAMPERINGS) {
  test(`validate refuses a manifest with ${label}`, (t) => {
    const { dir } = previewSnapshot(t);
    const result = validateTampered(dir, mutate);
    assert.equal(result.valid, false, `validate accepted a manifest with ${label}`);

    const message =
      kind === "shape"
        ? result.errors.join("\n")
        : result.drift.partIssues.map((issue) => issue.issue).join("\n");
    if (kind === "shape") {
      assert.match(message, /is not a snapshot manifest/, "a malformed record is refused, not diffed");
      assert.match(message, expected, `the shape guard must name the problem: ${message}`);
      assert.doesNotMatch(message, /undefined/);
    } else {
      assert.match(message, expected, `the reason must name the problem: ${message}`);
      assert.match(
        result.errors.join("\n"),
        /snapshot artefact problem/,
        "a disagreement between the two lists is an artefact problem"
      );
    }
  });
}

test("an older manifest with no incomplete[] is not refused for it", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generateSnapshot({ cwd: dir, outDir: "snapshot" });
  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  // Exactly what a pre-0.10 manifest looks like: no contract keys anywhere.
  delete manifest.incomplete;
  delete manifest.counts.incompleteCount;
  manifest.schemaVersion = "2.9.9";
  fs.writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, "utf8");

  const result = validateSnapshot({ cwd: dir });
  assert.equal(result.valid, true, result.errors.join("; "));
});
</file>

<file path="tests/init-gitignore-directory.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

/**
 * 4.1.0 regression cover for `init` when `.gitignore` is not a file.
 *
 * `addGitignore` read the path before writing it, so a `.gitignore` *directory* threw a raw
 * `EISDIR` from the read — after `init` had already written the config. The run both failed and
 * left state behind, which is the worst combination. The `.gitignore` update is a convenience, so
 * it is now a note and `init` finishes what it promised.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-init-ignore-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const runInit = (dir) =>
  spawnSync(process.execPath, [BIN, "init", "--yes"], { cwd: dir, encoding: "utf8" });

test("init succeeds and explains itself when .gitignore is a directory", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");
  fs.mkdirSync(path.join(dir, ".gitignore"));

  const result = runInit(dir);
  const output = `${result.stdout ?? ""}${result.stderr ?? ""}`;

  assert.equal(result.status, 0, `init must not fail over a convenience step: ${output}`);
  const configName = fs
    .readdirSync(dir)
    .find((name) => /^snapshot\.config\.(ts|mjs|cjs|js|json)$/.test(name));
  assert.ok(configName, "the config was written, which is what init promises");
  assert.match(output, /is a directory/, "the reason is stated");
  assert.match(output, /\.gitignore/, "the path is named");
  assert.doesNotMatch(output, /EISDIR: illegal operation/, "no raw errno reaches the user");
});

test("init still updates a normal .gitignore", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");
  fs.writeFileSync(path.join(dir, ".gitignore"), "node_modules\n", "utf8");

  const result = runInit(dir);

  assert.equal(result.status, 0);
  const ignore = fs.readFileSync(path.join(dir, ".gitignore"), "utf8");
  assert.match(ignore, /node_modules/, "the existing entry survives");
  assert.match(ignore, /snapshot\//, "the snapshot directory is added");
  assert.match(ignore, /snapshot\.tmp\//);
});

test("a custom --out-dir is the directory that gets ignored", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");

  const result = spawnSync(process.execPath, [BIN, "init", "--yes", "--out-dir", ".context"], {
    cwd: dir,
    encoding: "utf8",
  });
  assert.equal(result.status, 0, `${result.stdout}${result.stderr}`);

  // The entries were a constant ("/snapshot/", "/snapshot.tmp/") appended regardless of the
  // directory the config names, so `init --out-dir .context` generated into `.context` and
  // ignored `snapshot`: `git status` showed the whole snapshot as untracked, which is the one
  // thing the entries exist to prevent.
  const ignore = fs.readFileSync(path.join(dir, ".gitignore"), "utf8");
  assert.match(ignore, /^\/\.context\/$/m, "the configured outDir is ignored, anchored at the root");
  assert.doesNotMatch(ignore, /^\/snapshot\/$/m, "a directory this run does not write is not claimed");
});

test("a nested custom outDir is anchored at the repository root", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");

  const result = spawnSync(process.execPath, [BIN, "init", "--yes", "--out-dir", "docs/context"], {
    cwd: dir,
    encoding: "utf8",
  });
  assert.equal(result.status, 0, `${result.stdout}${result.stderr}`);

  const ignore = fs.readFileSync(path.join(dir, ".gitignore"), "utf8");
  assert.match(ignore, /^\/docs\/context\/$/m);
});

test("an outDir outside the repository is not written into .gitignore", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");
  const outside = path.join(dir, "..", `outside-${path.basename(dir)}`);
  try {
    const result = spawnSync(process.execPath, [BIN, "init", "--yes", "--out-dir", outside], {
      cwd: dir,
      encoding: "utf8",
    });
    assert.equal(result.status, 0, `${result.stdout}${result.stderr}`);
    const ignore = fs.existsSync(path.join(dir, ".gitignore"))
      ? fs.readFileSync(path.join(dir, ".gitignore"), "utf8")
      : "";
    assert.doesNotMatch(ignore, /^\/snapshot\/$/m, "nothing inside the repository was claimed");
    assert.doesNotMatch(ignore, /\.\.$|\.\.[/\\]/m, "no path above the root is written");
  } finally {
    fs.rmSync(outside, { recursive: true, force: true });
  }
});
</file>

<file path="tests/json-error-document.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

/**
 * 4.1.0 regression cover for `--format json` failure modes.
 *
 * Progress goes to stderr and payloads to stdout, which used to mean a failed JSON-mode invocation
 * wrote *nothing* to stdout: an agent had to notice an empty string, then parse stderr prose and
 * guess. Every failure now writes one parseable document instead — `{ error: { message, exitCode } }`
 * — while the human line stays on stderr and the exit code is unchanged.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-jsonfail-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function makeRepo(t) {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");
  fs.writeFileSync(path.join(dir, "src", "index.ts"), "export const a = 1;\n", "utf8");
  return dir;
}

const run = (args, cwd) => {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, out: result.stdout ?? "", err: result.stderr ?? "" };
};

const parseError = (out) => {
  const payload = JSON.parse(out);
  assert.ok(payload && payload.error, `expected an error document, got: ${out}`);
  assert.equal(typeof payload.error.message, "string");
  assert.equal(typeof payload.error.exitCode, "number");
  return payload.error;
};

test("report on a missing manifest returns a parseable error document", (t) => {
  const dir = makeRepo(t);
  const { code, out, err } = run(["report", "--format", "json"], dir);

  assert.equal(code, 1);
  const error = parseError(out);
  assert.equal(error.exitCode, 1);
  assert.match(error.message, /Manifest not found/);
  assert.match(err, /❌/, "the human line is still on stderr");
});

test("diff against a missing file returns a parseable error document", (t) => {
  const dir = makeRepo(t);
  const { code, out } = run(
    ["diff", "--format", "json", path.join(dir, "nope-a"), path.join(dir, "nope-b")],
    dir
  );

  assert.equal(code, 1);
  parseError(out);
});

test("a refused output directory returns a parseable error document", (t) => {
  const dir = makeRepo(t);
  const { code, out } = run(["generate", "--format", "json", "--out-dir", "src"], dir);

  assert.equal(code, 1);
  const error = parseError(out);
  assert.match(error.message, /Refusing to replace|Refusing to write/);
});

test("init over an existing config returns a parseable error document", (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(path.join(dir, "snapshot.config.mjs"), "export default {};\n", "utf8");

  const { code, out } = run(["init", "--yes", "--format", "json"], dir);

  assert.equal(code, 1);
  const error = parseError(out);
  assert.match(error.message, /already exists/);
});

test("a successful JSON invocation is still a payload, not an error", (t) => {
  const dir = makeRepo(t);
  assert.equal(run(["generate", "--format", "json"], dir).code, 0);

  const { code, out } = run(["validate", "--format", "json"], dir);
  assert.equal(code, 0);
  const payload = JSON.parse(out);
  assert.equal(payload.valid, true);
  assert.equal(payload.error, undefined, "success carries no error key");
});

/**
 * B5: the config loader's failures are failures too, and a `--format json` invocation owes its
 * caller one parseable document.
 *
 * Every case above goes through `fail()`. These go through `loadConfigFileDetailed` and
 * `resolveConfig`, which used to answer with exit 1 and an empty stdout — the exact gap that let
 * 0.9.14 promise "every failing run writes one JSON document" and not keep it. The gap was
 * invisible because no test below the `fail()` layer existed.
 */

/** A usable repository whose config files are the thing under test. */
function makeRepoWithConfig(t, files) {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");
  fs.writeFileSync(path.join(dir, "src", "index.ts"), "export const a = 1;\n", "utf8");
  for (const [relative, content] of Object.entries(files)) {
    fs.writeFileSync(path.join(dir, relative), content, "utf8");
  }
  return dir;
}

const BROKEN_CONFIGS = [
  ["a config that does not parse", { "snapshot.config.json": '{ "outDir": "snap",' }, /could not be read|Could not parse/i],
  ["an unknown config key", { "snapshot.config.json": '{"maxPartByte": 4096}' }, /unknown setting/i],
  ["a config value resolveConfig rejects", { "snapshot.config.json": '{"maxPartBytes": 0}' }, /positive byte count/i],
  ["a config preset that does not exist", { "snapshot.config.json": '{"preset": "not-a-preset"}' }, /Unknown preset/i],
  ["a config module that throws on import", { "snapshot.config.mjs": 'throw new Error("config boom");\n' }, /config boom/i],
  ["a config module with a null default export", { "snapshot.config.mjs": "export default null;\n" }, /does not export a configuration object/i],
  ["a broken package.json", { "package.json": '{"name": "fixture", "version": }' }, /Could not parse/i],
];

for (const [label, files, message] of BROKEN_CONFIGS) {
  test(`--format json answers a config failure with one document: ${label}`, (t) => {
    const dir = makeRepoWithConfig(t, files);
    const { code, out, err } = run(["generate", "--format", "json"], dir);

    assert.equal(code, 1, `${label}: exit`);
    assert.ok(out.length > 0, `${label}: stdout must carry the error document, not be empty`);
    const document = JSON.parse(out);
    assert.ok(document.error, `${label}: { error } document`);
    assert.equal(document.error.exitCode, 1, `${label}: exitCode`);
    assert.match(document.error.message, message, `${label}: message explains the failure`);
    assert.match(err, /❌/, `${label}: the human line stays on stderr`);
  });
}

test("a config failure keeps stdout empty in text mode", (t) => {
  const dir = makeRepoWithConfig(t, { "snapshot.config.json": "{ bad" });

  const { code, out } = run(["generate"], dir);

  assert.equal(code, 1);
  assert.equal(out, "", "text mode never writes a payload to stdout");
});

test("the config-failure document is produced by validate and explain too", (t) => {
  for (const args of [
    ["validate", "--format", "json"],
    ["explain", "src/index.ts", "--format", "json"],
  ]) {
    const dir = makeRepoWithConfig(t, { "snapshot.config.json": "{ bad" });
    const { code, out } = run(args, dir);

    assert.equal(code, 1, `${args.join(" ")}: exit`);
    const document = JSON.parse(out);
    assert.equal(document.error.exitCode, 1, `${args.join(" ")}: exitCode`);
    assert.match(document.error.message, /could not be read/i);
  }
});
</file>

<file path="tests/languages.test.js">
/**
 * The language profiles: one fixture per language, asserting what the summary promises.
 *
 * These are the claims the docs make: imports, top-level definitions and route decorators are
 * extracted for Python, Go, Rust, Java, C#, Ruby and PHP, so snapshot_locate can find a symbol and
 * the import graph can connect files in those languages.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

const BIN = path.join(path.dirname(new URL(import.meta.url).pathname.replace(/^\//, "")), "..", "dist", "bin.js");

const FIXTURES = {
  "app.py": "import os\nfrom flask import Flask\n\nclass Service:\n    pass\n\ndef run():\n    return 1\n\n@app.get('/health')\ndef health():\n    return 'ok'\n",
  "main.go": "package main\n\nimport \"fmt\"\n\ntype Server struct{}\n\nfunc main() { fmt.Println(\"hi\") }\n",
  "lib.rs": "use std::collections::HashMap;\n\npub struct Store {}\n\npub fn open() -> Store { Store {} }\n",
  "App.java": "import java.util.List;\n\npublic class App {\n  public void run() {}\n}\n",
  "Program.cs": "using System;\n\nnamespace Demo {\n  public class Program {\n    public static void Main() {}\n  }\n}\n",
  "task.rb": "require 'json'\n\nclass Task\n  def run\n  end\nend\n",
  "index.php": "<?php\nnamespace App;\n\nclass Controller {\n  public function index() {}\n}\n"
};

test("every advertised language yields imports and definitions", (t) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "langs-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  for (const [name, content] of Object.entries(FIXTURES)) fs.writeFileSync(path.join(root, name), content);
  fs.writeFileSync(path.join(root, "package.json"), "{\"name\":\"langs\",\"version\":\"1.0.0\"}\n");

  const result = spawnSync(process.execPath, [BIN, "generate"], { cwd: root, encoding: "utf8" });
  assert.equal(result.status, 0, (result.stdout ?? "") + (result.stderr ?? ""));

  const manifest = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  const summaryOf = (name) => manifest.files.find((file) => file.relativePath === name).summary;

  const python = summaryOf("app.py");
  assert.ok(python.imports.includes("flask"), "python imports");
  assert.ok(python.classes.includes("Service"), "python class");
  assert.ok(python.functions.includes("run"), "python function");
  assert.ok(python.routeHandlers.length > 0, "python route decorator");

  assert.ok(summaryOf("main.go").imports.includes("fmt"), "go import");
  assert.ok(summaryOf("main.go").classes.includes("Server"), "go type");
  assert.ok(summaryOf("lib.rs").imports.some((item) => item.startsWith("std::")), "rust use");
  assert.ok(summaryOf("lib.rs").functions.includes("open"), "rust fn");
  assert.ok(summaryOf("App.java").classes.includes("App"), "java class");
  assert.ok(summaryOf("App.java").imports.includes("java.util.List"), "java import");
  assert.ok(summaryOf("Program.cs").classes.includes("Program"), "csharp class");
  assert.ok(summaryOf("Program.cs").imports.includes("System"), "csharp using");
  assert.ok(summaryOf("task.rb").classes.includes("Task"), "ruby class");
  assert.ok(summaryOf("task.rb").imports.includes("json"), "ruby require");
  assert.ok(summaryOf("index.php").classes.includes("Controller"), "php class");
});
</file>

<file path="tests/lock-recovery.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, lockPathFor, resolveConfig } from "../dist/index.js";

/**
 * The run lock, from the 0.9.9 audit.
 *
 * The lock is the one piece of state that outlives a crashed run and blocks every run
 * after it. `acquireRunLock` creates the file with `wx` and then writes the pid into it,
 * so a process killed between those two calls leaves a *zero-byte* lock: the file exists,
 * and it names no owner. `lockOwnerIsGone` parsed it, failed, and answered "not gone" —
 * forever, because nothing in the file would ever change. Only deleting the file by hand
 * recovered the repository.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lock-recovery-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function project(dir) {
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n");
  return resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" });
}

/** The lock file for this project's staging directory. */
function lockFor(dir) {
  const tmpDir = path.join(dir, "snapshot.tmp");
  fs.mkdirSync(tmpDir, { recursive: true });
  return { tmpDir, lockPath: lockPathFor(fs.realpathSync(tmpDir)) };
}

test("a zero-byte lock left by a crash does not wedge the next run", (t) => {
  const dir = tempDir(t);
  const config = project(dir);
  const { lockPath } = lockFor(dir);

  fs.writeFileSync(lockPath, "");
  const twoHoursAgo = new Date(Date.now() - 2 * 60 * 60 * 1000);
  fs.utimesSync(lockPath, twoHoursAgo, twoHoursAgo);

  const manifest = generateSnapshot(config);

  assert.ok(manifest.parts.length > 0, "the run completed");
  assert.equal(fs.existsSync(lockPath), false, "and released the lock it took");
});

test("a lock that names a dead process is reclaimed", (t) => {
  const dir = tempDir(t);
  const config = project(dir);
  const { lockPath } = lockFor(dir);

  // A pid that cannot exist: process ids are positive and far below this on every
  // platform Node supports.
  fs.writeFileSync(lockPath, `${JSON.stringify({ pid: 2 ** 30 - 1 })}\n`);

  const manifest = generateSnapshot(config);
  assert.ok(manifest.parts.length > 0);
  assert.equal(fs.existsSync(lockPath), false);
});

test("a fresh lock is respected, whatever its contents", (t) => {
  const dir = tempDir(t);
  const config = project(dir);
  const { lockPath } = lockFor(dir);

  // Written moments ago, so it may belong to a run that is still inside the window
  // between creating the file and writing its pid. Refusing is the correct answer: a
  // wrongly refused run costs a retry, a wrongly stolen lock costs a snapshot.
  fs.writeFileSync(lockPath, "");
  try {
    assert.throws(() => generateSnapshot(config), /Another generate run is already using/);
  } finally {
    fs.rmSync(lockPath, { force: true });
  }
});

test("a run refused by the second lock leaves neither lock behind", (t) => {
  const dir = tempDir(t);
  const config = project(dir);
  const { lockPath: stagingLock } = lockFor(dir);

  // The staging lock refuses the run. The output-directory lock is acquired before that
  // refusal is discovered, and it used to stay behind — naming a *live* pid, so every
  // later run refused it too instead of reclaiming it as stale.
  fs.writeFileSync(stagingLock, "");
  const outDirLock = lockPathFor(path.join(dir, "snapshot"));
  t.after(() => {
    fs.rmSync(stagingLock, { force: true });
    fs.rmSync(outDirLock, { force: true });
  });

  assert.throws(() => generateSnapshot(config), /Another generate run is already using/);
  assert.equal(
    fs.existsSync(outDirLock),
    false,
    "the lock taken before the refusal is released"
  );
});
