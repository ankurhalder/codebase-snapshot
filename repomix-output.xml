<file path="packages/create/README.md">
# create-codebase-snapshot

Sets up [`codebase-snapshot`](https://www.npmjs.com/package/codebase-snapshot)
in the current repository.

```bash
npm create codebase-snapshot
```

It detects the project type, asks a handful of questions with sensible defaults,
and writes the config file this project can actually load — `snapshot.config.ts`
for an ES-module project on Node ≥ 22.6, `snapshot.config.mjs` everywhere else —
listing **every setting at its default**, so the config doubles as the
documentation.

```bash
npm create codebase-snapshot -- --preset react-vite --yes
```

| Option | Effect |
| :--- | :--- |
| `--preset <name>` | Force a project preset instead of detecting one |
| `--yes` | Accept every default without prompting |
| `--force` | Overwrite an existing config |

## What it writes

| Path | Notes |
| :--- | :--- |
| `snapshot.config.ts` / `snapshot.config.mjs` | Every setting at its default. `.ts` needs an ES-module `package.json` and Node ≥ 22.6; `.mjs` is used otherwise, because a `.ts` config is loaded with the enclosing package's module type. |
| `package.json` → `scripts.snapshot`, `scripts.snapshot:validate` | Skipped when there is no `package.json` to hold them. |
| `package.json` → `devDependencies` | `codebase-snapshot` at the version this scaffolder shipped with. A range you already declared is never overwritten. |
| `.gitignore` | `snapshot/`, `snapshot.tmp/`. |

The generated scripts run `npx codebase-snapshot …`, and `npx` uses the
local `devDependencies` copy when there is one — so the version is pinned by your
lockfile instead of drifting to `@latest`. Until you run `npm install`, `npx` would
fall back to downloading the newest release, which is why the printed next step is
`npm install && npm run snapshot`. Nothing is installed, and no network is used,
while scaffolding.

Without a `package.json` the scripts cannot be added, and the printed next step is
`npx codebase-snapshot generate` instead.

This package is a shim: the wizard itself lives in the main package, so
`npx codebase-snapshot init` does exactly the same thing.
</file>

<file path="scripts/compare.mjs">
#!/usr/bin/env node
/**
 * A head-to-head benchmark: this tool against repomix (and gitingest, if installed).
 *
 * The point is not to win a token contest — the two tools count tokens differently and pack
 * different file sets — but to make the difference visible and repeatable. Every number is
 * measured on the repository you point it at, in the same run, and the caveats are printed with
 * the table.
 *
 * Usage: node scripts/compare.mjs [repo] [--repomix] [--gitingest] [--json]
 *
 * repomix is run through `npx`, so it is fetched at run time and is never a dependency of this
 * package. If it cannot be fetched the script says so and reports only this tool's numbers.
 */
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";

const BIN = path.join(import.meta.dirname, "..", "dist", "bin.js");
const args = process.argv.slice(2);
const flags = new Set(args.filter((arg) => arg.startsWith("--")));
const repo = path.resolve(args.find((arg) => !arg.startsWith("--")) ?? path.join(import.meta.dirname, ".."));
const scratch = fs.mkdtempSync(path.join(os.tmpdir(), "compare-"));
const question = "how does the snapshot generator partition files";

function finish(code) {
  fs.rmSync(scratch, { recursive: true, force: true });
  process.exit(code);
}

function ours(label, extra) {
  const outDir = path.join(scratch, label);
  const started = process.hrtime.bigint();
  const result = spawnSync(
    process.execPath,
    [BIN, "generate", "--out-dir", outDir, ...extra],
    { cwd: repo, encoding: "utf8" }
  );
  const ms = Number(process.hrtime.bigint() - started) / 1e6;
  if (result.status !== 0) {
    console.error(label + " failed: " + ((result.stderr ?? "") + (result.stdout ?? "")).trim().slice(0, 400));
    finish(1);
  }
  const manifest = JSON.parse(fs.readFileSync(path.join(outDir, "manifest.json"), "utf8"));
  return {
    label,
    files: manifest.files.length,
    bytes: manifest.totals.totalContentBytes ?? manifest.totals.totalSizeBytes,
    tokens: manifest.totals.estimatedTokens ?? 0,
    ms,
  };
}

/** Runs repomix and returns its own accounting, or a reason it is not available. */
function repomix() {
  const output = path.join(scratch, "repomix.md");
  const packed = spawnSync(
    process.platform === "win32" ? "npx.cmd" : "npx",
    ["--yes", "repomix@1.19.0", "--quiet", "--style", "markdown", "--output", output],
    { cwd: repo, encoding: "utf8", timeout: 600000, shell: process.platform === "win32" }
  );
  if (packed.status !== 0) {
    return { available: false, reason: ((packed.stderr ?? "") + (packed.stdout ?? "")).trim().split("\n").pop() };
  }
  const counted = spawnSync(
    process.platform === "win32" ? "npx.cmd" : "npx",
    ["--yes", "repomix@1.19.0", "--token-count-tree"],
    { cwd: repo, encoding: "utf8", timeout: 600000, shell: process.platform === "win32" }
  );
  const text = (counted.stdout ?? "") + (counted.stderr ?? "");
  const tokens = /Total Tokens:\s*([\d,]+)/.exec(text);
  const files = /Total Files:\s*([\d,]+)/.exec(text);
  if (tokens === null) return { available: false, reason: "repomix ran but printed no token total" };
  return {
    available: true,
    files: files === null ? null : Number(files[1].replace(/,/g, "")),
    tokens: Number(tokens[1].replace(/,/g, "")),
    bytes: fs.statSync(output).size,
  };
}

/** gitingest writes a digest to stdout; it reports size, not tokens. */
function gitingest() {
  const result = spawnSync("python", ["-m", "gitingest", "--output", "-", repo], {
    encoding: "utf8",
    timeout: 300000,
    maxBuffer: 64 * 1024 * 1024,
  });
  if (result.status !== 0) return { available: false, reason: ((result.stderr ?? "") + (result.stdout ?? "")).trim().split("\n").pop() };
  return { available: true, bytes: Buffer.byteLength(result.stdout ?? "", "utf8") };
}

const rows = [
  ours("full", []),
  ours("slice", ["--slice", question, "--slice-tokens", "30000"]),
  ours("budget", ["--budget-tokens", "30000"]),
];
const baseline = rows[0].tokens;

const summary = { repo, question, ours: rows };
if (flags.has("--repomix")) {
  const result = repomix();
  summary.repomix = result;
  if (!result.available) console.error("repomix: not available (" + result.reason + "); comparison skipped");
}
if (flags.has("--gitingest")) {
  const result = gitingest();
  summary.gitingest = result;
  if (!result.available) console.error("gitingest: not available (" + result.reason + "); comparison skipped");
}

if (flags.has("--json")) {
  console.log(JSON.stringify(summary, null, 2));
  finish(0);
}

console.log("| Tool / mode | Files | Content bytes | Tokens | vs full | Time |");
console.log("| :-- | --: | --: | --: | --: | --: |");
for (const row of rows) {
  const share = row.tokens === baseline ? "100%" : ((row.tokens / baseline) * 100).toFixed(1) + "%";
  console.log(
    "| codebase-snapshot (" + row.label + ") | " + row.files + " | " + row.bytes.toLocaleString("en-US") +
      " | " + row.tokens.toLocaleString("en-US") + " | " + share + " | " + (row.ms / 1000).toFixed(2) + " s |"
  );
}
if (summary.repomix?.available) {
  const result = summary.repomix;
  console.log(
    "| repomix 1.19.0 | " + (result.files ?? "?") + " | " + result.bytes.toLocaleString("en-US") + " | " +
      result.tokens.toLocaleString("en-US") + " | " + ((result.tokens / baseline) * 100).toFixed(1) + "% | n/a |"
  );
}
if (summary.gitingest?.available) {
  console.log(
    "| gitingest | ? | " + summary.gitingest.bytes.toLocaleString("en-US") + " | n/a | n/a | n/a |"
  );
}
console.log("");
console.log("repo: " + repo);
console.log("question: " + question);
console.log("");
console.log("Caveats, stated because they change the answer:");
console.log("- Token counts are each tool's own. codebase-snapshot estimates ceil(bytes / 4); repomix uses its own tokenizer, so the counts are not interchangeable.");
console.log("- File sets differ: this tool applies its own ignore rules and skips binaries; repomix applies its defaults.");
console.log("- A slice or budget is the same snapshot narrowed after scanning, so its time is the full scan plus the plan, not a cheaper scan.");
finish(0);
</file>

<file path="scripts/lint.mjs">
#!/usr/bin/env node
/**
 * Dependency-free lint/format gate.
 *
 * The project deliberately ships no linter dependency (a compiler is already a
 * runtime dependency and `tsc` does the type checking), so this script enforces
 * the conventions that `tsc` cannot see. It runs in CI and locally with no
 * network access.
 *
 * Rules
 *   src-console      only the CLI and the bin may write to the console
 *   empty-catch      a bare `catch { }` must not swallow an error silently
 *   explicit-any     `any` is not allowed in src (use `unknown` and narrow)
 *   stray-todo       TODO/FIXME markers must not ship
 *   tabs             indentation is spaces only
 *   trailing-ws      no trailing whitespace
 *   eol              files end with exactly one newline, LF only
 *   final-newline    every source file ends with a newline
 *   test-only        no `test.only` / `describe.only` committed
 *   no-debugger      no `debugger` statements
 *   no-focus-comment comments must not contain "// eslint-disable" style escapes
 */
import * as fs from "node:fs";
import * as path from "node:path";

const ROOT = process.cwd();
const TARGETS = ["src", "tests", "scripts"];

/** Files allowed to write to the console. */
const CONSOLE_ALLOWED = new Set(["src/cli.ts", "src/bin.ts", "scripts/lint.mjs"]);

const failures = [];
const fail = (file, line, rule, message) => {
  failures.push({ file, line, rule, message });
};

function walk(dir) {
  const out = [];
  if (!fs.existsSync(dir)) return out;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      if (["node_modules", "dist", "coverage", ".git"].includes(entry.name)) continue;
      out.push(...walk(full));
    } else if (/\.(?:ts|js|mjs|cjs|json|md|yml|yaml)$/.test(entry.name)) {
      out.push(full);
    }
  }
  return out;
}

const files = TARGETS.flatMap((target) => walk(path.join(ROOT, target)));

/**
 * Blanks out comments, keeping every line and string literal intact.
 *
 * The content rules below look for code (`console.`, `: any`), and prose explaining
 * *why* those are banned contains the same words — a doc comment saying "a `console.log`
 * in a hook corrupted the payload" is not a violation. Line numbers must not move, so
 * comments are replaced by spaces rather than removed.
 */
function stripComments(text) {
  let out = "";
  let i = 0;
  let inBlock = false;
  let inLine = false;
  let quote = null;

  while (i < text.length) {
    const char = text[i];
    const next = text[i + 1];

    if (inBlock) {
      if (char === "*" && next === "/") {
        inBlock = false;
        out += "  ";
        i += 2;
        continue;
      }
      out += char === "\n" ? "\n" : " ";
      i += 1;
      continue;
    }
    if (inLine) {
      if (char === "\n") {
        inLine = false;
        out += "\n";
      } else {
        out += " ";
      }
      i += 1;
      continue;
    }
    if (quote) {
      out += char;
      if (char === "\\") {
        out += next ?? "";
        i += 2;
        continue;
      }
      if (char === quote) quote = null;
      i += 1;
      continue;
    }
    if (char === "/" && next === "*") {
      inBlock = true;
      out += "  ";
      i += 2;
      continue;
    }
    if (char === "/" && next === "/") {
      inLine = true;
      out += "  ";
      i += 2;
      continue;
    }
    if (char === '"' || char === "'" || char === "`") {
      quote = char;
      out += char;
      i += 1;
      continue;
    }
    out += char;
    i += 1;
  }

  return out;
}

for (const absolute of files) {
  const relative = path.relative(ROOT, absolute).replace(/\\/g, "/");
  const raw = fs.readFileSync(absolute, "utf8");
  const isSource = relative.startsWith("src/");
  const codeLines = stripComments(raw).split("\n");

  if (raw.includes("\r")) {
    fail(relative, 0, "eol", "file contains CRLF line endings");
  }
  if (!raw.endsWith("\n")) {
    fail(relative, raw.split("\n").length, "final-newline", "file must end with a newline");
  }
  if (raw.endsWith("\n\n")) {
    fail(relative, raw.split("\n").length, "eol", "file must end with exactly one newline");
  }

  const lines = raw.split("\n");
  lines.forEach((line, index) => {
    const lineNumber = index + 1;
    const code = codeLines[index] ?? "";

    if (line.includes("\t")) {
      fail(relative, lineNumber, "tabs", "tab character (use spaces)");
    }
    if (/[ \t]+$/.test(line)) {
      fail(relative, lineNumber, "trailing-ws", "trailing whitespace");
    }
    if (/^\s*debugger\s*;?\s*$/.test(line)) {
      fail(relative, lineNumber, "no-debugger", "debugger statement");
    }
    if (/^\s*\/\/\s*(?:eslint-disable|@ts-ignore)/.test(line)) {
      fail(relative, lineNumber, "no-focus-comment", "suppression comment without a reason");
    }
    if (/\b(?:TODO|FIXME)\b/.test(line) && !relative.endsWith("lint.mjs")) {
      fail(relative, lineNumber, "stray-todo", "TODO/FIXME/XXX marker");
    }
    if (/^\s*\}?\s*catch\s*\{\s*\}\s*$/.test(line) || /\}\s*catch\s*\{\s*\}/.test(line)) {
      fail(relative, lineNumber, "empty-catch", "empty catch block swallows the error");
    }

    if (isSource) {
      if (/\bconsole\./.test(code) && !CONSOLE_ALLOWED.has(relative)) {
        fail(relative, lineNumber, "src-console", "console usage outside the CLI layer");
      }
      if (/\bany\b/.test(code) && /(?::\s*any\b|<any>|\bas\s+any\b)/.test(code)) {
        fail(relative, lineNumber, "explicit-any", "explicit any (use unknown and narrow)");
      }
    }

    if (relative.startsWith("tests/")) {
      if (/\b(?:test|describe|it)\.only\s*\(/.test(line)) {
        fail(relative, lineNumber, "test-only", "focused test committed");
      }
    }
  });
}

if (failures.length === 0) {
  console.log(`lint: ${files.length} file(s) clean`);
  process.exit(0);
}

for (const failure of failures) {
  console.error(`${failure.file}:${failure.line}  [${failure.rule}] ${failure.message}`);
}
console.error(`\nlint: ${failures.length} problem(s) in ${files.length} file(s)`);
process.exit(1);
</file>

