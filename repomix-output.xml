<file path="src/ast/profiles/graphql.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isTopLevel } from "./shared.js";

/**
 * GraphQL schema and operation files.
 *
 * Schema definitions are types; `query`/`mutation`/`subscription` in an operation file are
 * endpoints, so they are recorded as `routeHandlers` — the same bucket a REST route lands in,
 * which is what makes "where is this endpoint handled?" answerable across both.
 *
 * A definition is matched at any indentation because a schema is commonly written inside
 * `extend type` blocks and a `type` may appear nested in an SDL string; an operation name is
 * top-level by grammar.
 */
const DEFINITION = /^(?:extend\s+)?(type|interface|input|enum|union|scalar|schema)\s+([A-Za-z_]\w*)/;
const OPERATION = /^(?:query|mutation|subscription)\s+([A-Za-z_]\w*)/;
const DIRECTIVE = /^directive\s+@([A-Za-z_]\w*)/;
const IMPORT = /^#import\s+"([^"]+)"/;

export const graphqlProfile: LanguageProfile = {
  id: "graphql",
  extensions: [".graphql", ".gql"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("#") && !IMPORT.test(trimmed)) return;

      const imported = IMPORT.exec(trimmed);
      if (imported) {
        summary.imports.push(imported[1]);
        return;
      }

      const directive = DIRECTIVE.exec(trimmed);
      if (directive) {
        summary.functions.push(`@${directive[1]}`);
        return;
      }

      const definition = DEFINITION.exec(trimmed);
      if (definition) {
        const [, keyword, name] = definition as RegExpExecArray & [string, string, string];
        if (keyword === "interface") summary.interfaces.push(name);
        else if (keyword === "enum") summary.enums.push(name);
        else if (keyword === "input" || keyword === "scalar" || keyword === "union") {
          summary.types.push(name);
        } else summary.classes.push(name);
        summary.exports.push(name);
        return;
      }

      if (!isTopLevel(line)) return;
      const operation = OPERATION.exec(trimmed);
      if (operation) {
        const name = (operation as RegExpExecArray & [string, string])[1];
        summary.functions.push(name);
        summary.routeHandlers.push(name);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/index.ts">
import { cfamilyProfile } from "./cfamily.js";
import { dartProfile } from "./dart.js";
import { dotnetProfile } from "./dotnet.js";
import { goProfile } from "./go.js";
import { graphqlProfile } from "./graphql.js";
import { jvmProfile } from "./jvm.js";
import { phpProfile } from "./php.js";
import { protobufProfile } from "./protobuf.js";
import { pythonProfile } from "./python.js";
import { rubyProfile } from "./ruby.js";
import { rustProfile } from "./rust.js";
import { sfcProfile } from "./sfc.js";
import { sqlProfile } from "./sql.js";
import { swiftProfile } from "./swift.js";
import { terraformProfile } from "./terraform.js";
import type { HeuristicResult, LanguageProfile } from "./shared.js";

/**
 * Every heuristic profile, in no particular order — lookup is by extension.
 *
 * Adding a language is one file exporting a `LanguageProfile` plus one line
 * here; nothing else in the pipeline changes.
 */
export const LANGUAGE_PROFILES: readonly LanguageProfile[] = [
  pythonProfile,
  goProfile,
  rustProfile,
  jvmProfile,
  dotnetProfile,
  phpProfile,
  rubyProfile,
  cfamilyProfile,
  sfcProfile,
  swiftProfile,
  dartProfile,
  sqlProfile,
  graphqlProfile,
  protobufProfile,
  terraformProfile,
];

const BY_EXTENSION = new Map<string, LanguageProfile>();
for (const profile of LANGUAGE_PROFILES) {
  for (const extension of profile.extensions) {
    BY_EXTENSION.set(extension.toLowerCase(), profile);
  }
}

/** The profile that owns `path`, or `null` when no profile claims it. */
export function profileForPath(path: string): LanguageProfile | null {
  const lower = path.toLowerCase();
  const dot = lower.lastIndexOf(".");
  if (dot === -1) return null;
  return BY_EXTENSION.get(lower.slice(dot)) ?? null;
}

/**
 * Summarizes `path` with whichever profile claims it.
 *
 * Returns `null` for files no profile handles — those still enter the snapshot,
 * they just carry no structural summary.
 */
export function summarizeWithProfile(path: string, content: string): HeuristicResult | null {
  const profile = profileForPath(path);
  return profile ? profile.summarize(path, content) : null;
}

export {
  pythonProfile,
  goProfile,
  rustProfile,
  jvmProfile,
  dotnetProfile,
  phpProfile,
  rubyProfile,
  cfamilyProfile,
  sfcProfile,
  swiftProfile,
  dartProfile,
  sqlProfile,
  graphqlProfile,
  protobufProfile,
  terraformProfile,
};
export type { HeuristicResult, LanguageProfile } from "./shared.js";
