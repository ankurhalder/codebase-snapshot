import * as fs from "node:fs";
import { createHash } from "node:crypto";
import { createRequire } from "node:module";
import * as path from "node:path";
import { pathToFileURL } from "node:url";
import { stripJsonComments } from "./ast/structured.js";
import { parseOwnerBrief } from "./generator/brief.js";
import { detectPreset, getPreset, listPresetNames, unknownPresetMessage } from "./presets/index.js";
import {
  isDiscoveryMode,
  matchesExclude,
  type DiscoveryMode,
} from "./scanner/files.js";
import { DEFAULT_SECRET_PATTERNS } from "./security/patterns.js";
import { compileSecretRules } from "./security/redact.js";
import { bytesForTokens } from "./tokenize.js";
import type {
  ByteSize,
  CliOptions,
  HooksConfig,
  KindRule,
  LayerRule,
  ResolvedArtifacts,
  ResolvedBudgets,
  OwnerBrief,
  PromptTask,
  ResolvedSnapshotConfig,
  SecretRuleInput,
  SnapshotConfig,
} from "./types.js";

/** Carries the directory a config was loaded from, so `resolveConfig` can use it. */
export const CONFIG_DIR_SYMBOL: unique symbol = Symbol.for("codebase-snapshot.configDir");

const CONFIG_FILENAMES = [
  "snapshot.config.ts",
  "snapshot.config.js",
  "snapshot.config.mjs",
  "snapshot.config.cjs",
  "snapshot.config.json",
  ".snapshotrc.json",
  ".snapshotrc",
];

/**
 * Where a configuration would be read from, without loading it.
 *
 * The first-run decision only needs to know whether this repository has been configured
 * already. Loading the file there would run repository code before the command the
 * developer actually asked for — and a config that exists but cannot be read has to
 * reach the normal path, so it can be reported as broken instead of quietly treated as
 * absent.
 */
export function findConfigFile(cwd: string): string | null {
  for (const filename of CONFIG_FILENAMES) {
    const fullPath = path.join(cwd, filename);
    let stats: fs.Stats | null = null;
    try {
      stats = fs.statSync(fullPath);
    } catch {
      // An unreadable path that exists is still a broken configuration, not an absent one:
      // the loader reports it rather than falling through to a different file.
      if (fs.existsSync(fullPath)) return fullPath;
      continue;
    }
    // A *directory* named `snapshot.config.json` is not a configuration. Returning it made the
    // loader report EISDIR instead of trying the next candidate.
    if (stats.isFile()) return fullPath;
  }
  const pkgJsonPath = path.join(cwd, "package.json");
  if (!fs.existsSync(pkgJsonPath)) return null;
  try {
    // The same JSONC-tolerant reader `loadConfigFileDetailed` uses. Bare `JSON.parse` here meant a
    // `package.json` with a BOM — or a trailing comma, which plenty of editors write — answered
    // "no configuration" while the loader below would have read it happily, so the two disagreed
    // about whether this project is configured at all.
    const parsed = JSON.parse(stripJsonComments(fs.readFileSync(pkgJsonPath, "utf8"))) as {
      snapshot?: unknown;
    };
    // `snapshot` is this tool's key only when it is an object. `typeof [] === "object"`, so
    // `"snapshot": []` and `"snapshot": "other-tool"` used to count as a configuration: the first
    // run then skipped the setup question and generated with defaults nobody chose, while
    // `loadConfigFileDetailed` warned and ignored the same value.
    const snapshot = parsed?.snapshot;
    return typeof snapshot === "object" && snapshot !== null && !Array.isArray(snapshot)
      ? pkgJsonPath
      : null;
  } catch {
    // An unparseable package.json is not a configuration. Say "no config" here and let
    // the setup path explain the real problem when it tries to edit the file.
    return null;
  }
}


const RESOLVED_CONFIG_BRAND = Symbol.for(
  "codebase-snapshot/resolved-config"
);

/**
 * Brands a resolved config so consumers can distinguish it from a user
 * `SnapshotConfig` structurally, instead of guessing from the presence of a
 * single field (`"secretRules" in input`), which misfired for hand-built configs
 * and for user configs that happened to carry an extra key.
 */
export function markResolvedConfig<T extends ResolvedSnapshotConfig>(config: T): T {
  Object.defineProperty(config, RESOLVED_CONFIG_BRAND, {
    value: true,
    enumerable: false,
    configurable: false,
    writable: false,
  });
  return config;
}

/**
 * Detects a resolved config.
 *
 * The brand is a non-enumerable symbol, so it survives `structuredClone` but NOT
 * `{ ...resolvedConfig, override }`. Relying on the brand alone caused a real
 * regression: a spread config was re-resolved as a user config, which silently
 * dropped custom `secretRules` and let matching secrets through in clear text.
 * The structural fallback therefore accepts any object carrying the complete
 * resolved-only shape.
 */
export function isResolvedConfig(value: unknown): value is ResolvedSnapshotConfig {
  if (typeof value !== "object" || value === null) return false;
  const candidate = value as Record<string, unknown>;

  if (
    (candidate as Record<symbol, unknown>)[RESOLVED_CONFIG_BRAND as unknown as symbol] ===
    true
  ) {
    return true;
  }

  const hasResolvedNumbers =
    typeof candidate.maxPartBytes === "number" &&
    typeof candidate.largeFileBytes === "number" &&
    typeof candidate.previewHeadLines === "number" &&
    typeof candidate.previewTailLines === "number";
  const hasResolvedStrings =
    typeof candidate.cwd === "string" &&
    typeof candidate.outDir === "string" &&
    typeof candidate.tmpDir === "string";
  const hasResolvedFlags =
    typeof candidate.includeMonolith === "boolean" &&
    typeof candidate.includeSensitiveFiles === "boolean";
  const hasResolvedRules =
    Array.isArray(candidate.layers) &&
    Array.isArray(candidate.kinds) &&
    Array.isArray(candidate.excludePatterns);

  // `secretRules` is the discriminator: a `SnapshotConfig` expresses custom
  // rules as `secrets.customPatterns`, never as a resolved `secretRules` array.
  const secretRules = candidate.secretRules;
  const hasCompiledRules =
    Array.isArray(secretRules) &&
    secretRules.every(
      (rule) =>
        typeof rule === "object" &&
        rule !== null &&
        typeof (rule as { rule?: unknown }).rule === "string" &&
        (typeof (rule as { pattern?: unknown }).pattern === "string" ||
          (rule as { pattern?: unknown }).pattern instanceof RegExp)
    );

  return (
    hasResolvedNumbers &&
    hasResolvedStrings &&
    hasResolvedFlags &&
    hasResolvedRules &&
    hasCompiledRules
  );
}

/**
 * Normalises a resolved `budgets` object against the single-part budget.
 *
 * `maxPartBytes` and `budgets.default` are two names for the same number, and `resolveConfig`
 * keeps them equal. A caller that spreads a resolved config cannot: `{ ...resolved, maxPartBytes:
 * 64 * 1024 }` carries the **old** `budgets` object along, and because `isResolvedConfig`
 * accepts the spread, the new byte budget was dropped on the floor. The partitioner reads
 * `budgets.default`, so the run kept producing 300 KB parts while the config said 64 KB — and
 * the manifest recorded the number that had been ignored.
 *
 * `byLayer` is capped rather than replaced: `resolveBudgets` already caps it for an explicit
 * `maxPartBytes`, and a per-layer budget above the single-part budget contradicts it.
 */
function normalizeBudgets(
  budgets: ResolvedBudgets | undefined,
  maxPartBytes: unknown
): ResolvedBudgets {
  const clearer =
    typeof maxPartBytes === "number" && Number.isFinite(maxPartBytes) && maxPartBytes > 0
      ? maxPartBytes
      : undefined;

  if (budgets === undefined || typeof budgets !== "object" || budgets === null) {
    return { default: clearer ?? 0, byLayer: {} };
  }

  const fallbackDefault = clearer ?? budgets.default;
  const byLayer: Record<string, number> = {};
  const layers = budgets.byLayer;
  if (layers !== undefined && typeof layers === "object" && layers !== null) {
    for (const [layer, value] of Object.entries(layers)) {
      byLayer[layer] = Math.min(value, fallbackDefault);
    }
  }
  return { default: fallbackDefault, byLayer };
}

/**
 * Re-validates a resolved config taken from an untrusted path (e.g. a spread
 * copy), recompiling secret rules so string patterns and stray `g`/`y` flags are
 * normalised even when the object did not come from `resolveConfig`.
 */
export function normalizeResolvedConfig(
  config: ResolvedSnapshotConfig
): ResolvedSnapshotConfig {
  // Older resolved configs (or a spread copy of one built before the field
  // existed) may carry no `discovery`: fall back to `auto`, which is what
  // discovery did when the mode did not exist.
  const discovery: DiscoveryMode = isDiscoveryMode(config.discovery)
    ? config.discovery
    : "auto";

  // `includeMonolith` and `artifacts.monolith` are one setting with two spellings, and a spread
  // override can move either one of them. Resolving `artifacts` with `includeMonolith` as the
  // *default* left the two disagreeing — `{ ...resolved, includeMonolith: true }` produced a config
  // claiming `includeMonolith: true` beside `artifacts.monolith: false`, and `generate` reads the
  // artifact map, so the monolith silently was not written. Either spelling asking for it is a
  // request; the reconciled answer goes back into both fields.
  const monolithWanted = config.includeMonolith === true || config.artifacts?.monolith === true;
  const artifacts = resolveArtifacts(
    config.artifacts,
    undefined,
    monolithWanted,
    monolithWanted
  );

  return markResolvedConfig({
    ...config,
    discovery,
    // A spread copy built before the field existed carries no value; the default applies, and it
    // is re-validated because the number reaches a rendered artifact.
    attachmentSlots: resolveAttachmentSlots(config.attachmentSlots),
    maxParts: resolveMaxParts(config.maxParts),
    promptTask: resolvePromptTask(config.promptTask),
    ...(config.brief === undefined ? {} : { brief: config.brief }),
    includeMonolith: artifacts.monolith,
    secretRules: compileSecretRules(config.secretRules),
    artifacts,
    include: resolveInclude(config.include),
    preset: typeof config.preset === "string" ? config.preset : "generic",
    presetExclude: [
      ...new Set([
        ...(Array.isArray(config.presetExclude) ? config.presetExclude : []),
        ...outputExcludePatterns(config.cwd, config.outDir, config.tmpDir),
      ]),
    ],
    layersMode: config.layersMode === "replace" ? "replace" : "merge",
    budgets: normalizeBudgets(config.budgets, config.maxPartBytes),
    hooks: resolveHooks(config.hooks),
    excludePatterns: Array.isArray(config.excludePatterns) ? config.excludePatterns : [],
    layers: Array.isArray(config.layers) ? config.layers : [],
    kinds: Array.isArray(config.kinds) ? config.kinds : [],
  });
}

/**
 * Guards against a silently lossy config round-trip.
 *
 * A `RegExp` cannot survive `JSON.stringify`/`JSON.parse`: the pattern comes
 * back as `{}`. Such an object no longer satisfies `isResolvedConfig`, so it
 * would be re-resolved as a user config and its custom `secretRules` would be
 * dropped without a word — a silent security regression. Fail loudly instead.
 */
export function assertUsableConfigInput(value: unknown): void {
  if (typeof value !== "object" || value === null) return;
  const candidate = value as Record<string, unknown>;
  if (!Array.isArray(candidate.secretRules) || candidate.secretRules.length === 0) {
    return;
  }

  const unusable = candidate.secretRules.filter((rule) => {
    if (typeof rule !== "object" || rule === null) return true;
    const pattern = (rule as { pattern?: unknown }).pattern;
    if (pattern instanceof RegExp || typeof pattern === "string") return false;
    // `{}` is what a RegExp becomes after a JSON round-trip.
    return typeof pattern === "object" && pattern !== null;
  });

  if (unusable.length > 0) {
    throw new Error(
      `This configuration carries ${unusable.length} unusable secret rule pattern(s). ` +
        "A RegExp cannot survive JSON serialization, and silently dropping these rules " +
        "would let those secrets through redaction. Pass the resolved config object " +
        "itself (or express rules via `secrets.customPatterns`) instead of a JSON clone."
    );
  }
}

export interface ConfigLoadResult {
  config: SnapshotConfig | null;
  /** Absolute path of the file the config came from, if any. */
  file: string | null;
  /** Why a candidate config file was ignored. Never silently discarded. */
  warnings: string[];
  /**
   * Config files that exist but could not be read.
   *
   * These are fatal: a config that fails to parse used to be skipped in favour of
   * the defaults, which meant a typo silently produced a snapshot with none of the
   * developer's settings applied. A config that is merely unsupported on this Node
   * version (a `.ts` file below Node 22.6) stays a warning — nothing is wrong with
   * the file, and the message already says what to do.
   */
  errors: string[];
}

/** True when this Node can `import()` a `.ts` file natively (type stripping). */
export function supportsTypeScriptImports(): boolean {
  const features = (process as unknown as { features?: { typescript?: unknown } }).features;
  if (features && "typescript" in features) {
    return features.typescript !== false && features.typescript !== undefined;
  }
  const [major, minor] = process.versions.node.split(".").map((value) => Number(value));
  if (!Number.isFinite(major)) return false;
  return major > 22 || (major === 22 && minor >= 6);
}

/**
 * Parses a config file as JSONC.
 *
 * `stripJsonComments` comes from `ast/structured.ts`. This file carried a second, hand-copied
 * reader, and a fix to one copy did not reach the other: the shared one keeps `\r`-only line
 * endings and trailing commas while the copy here silently kept the old behaviour for
 * `package.json`. One implementation, one set of fixed edge cases.
 */
function parseJsonish(raw: string, file: string): SnapshotConfig {
  try {
    return JSON.parse(stripJsonComments(raw)) as SnapshotConfig;
  } catch (err) {
    throw new Error(`Could not parse ${file}: ${(err as Error).message}`);
  }
}

/** Describes a value for an error message without ever echoing its contents. */
function describeValue(value: unknown): string {
  if (value === null) return "null";
  if (Array.isArray(value)) return "an array";
  if (value instanceof RegExp) return value.toString();
  if (typeof value === "function") return "a function";
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "object") {
    const keys = Object.keys(value as Record<string, unknown>);
    return keys.length > 0 ? `an object with keys ${keys.join(", ")}` : "an empty object";
  }
  return `${typeof value} (${String(value)})`;
}

const isThenable = (value: object): boolean =>
  typeof (value as { then?: unknown }).then === "function";

/**
 * Every key a configuration file may carry.
 *
 * This is `SnapshotConfig` plus the two spellings that are read through casts: `exclude` (the
 * flag spelling of `excludePatterns`) and `secretRules` (the library spelling of a rule list,
 * accepted by `resolveConfig` and therefore needed here too — omitting it made a config file
 * that used it fail with "unknown setting(s): secretRules" while the same key worked when
 * passed in code). `discovery` was on this list too until it was added to `SnapshotConfig`,
 * where it belonged: a TypeScript config containing it was TS2353.
 *
 * The array is `as const` so the tuple below can prove the two cannot drift. Every test in
 * this repository is `.js`, so no test can see a type; the compiler is the test.
 */
const CONFIG_KEY_NAMES = [
  "artifacts",
  "attachmentSlots",
  "branch",
  "brief",
  "budgets",
  "changedSince",
  "cwd",
  "discovery",
  "exclude",
  "excludePatterns",
  "hooks",
  "include",
  "includeMonolith",
  "includeSensitiveFiles",
  "kinds",
  "largeFileBytes",
  "layers",
  "layersMode",
  "maxMonolithBytes",
  "maxPartBytes",
  "maxParts",
  "maxPartTokens",
  "outDir",
  "preset",
  "previewHeadLines",
  "promptTask",
  "staged",
  "previewTailLines",
  "secretRules",
  "secrets",
  "sarif",
  "skeleton",
  "tmpDir",
  "withDependents",
] as const;

export const CONFIG_KEYS: ReadonlySet<string> = new Set(CONFIG_KEY_NAMES);

/**
 * Compile-time proof that every key the loader accepts is a key of `SnapshotConfig`.
 *
 * The condition is `never` when a name in `CONFIG_KEY_NAMES` is missing from the interface,
 * and `true` is not assignable to `never` — so the missing name stops the build instead of
 * becoming a setting a user can write but a TypeScript config cannot spell.
 */
void (true as [Exclude<(typeof CONFIG_KEY_NAMES)[number], keyof SnapshotConfig>] extends [never]
  ? true
  : never);

/**
 * Rejects a setting the tool does not have, naming it.
 *
 * An unknown key used to be dropped without a word: `{ maxPartByte: 4096 }` generated with the
 * default budget at exit 0, so the user believed an override had been applied. That is the silent
 * fallback this project forbids, and it also protects the generated file's promise that it lists
 * every setting — a key absent from this list is not one.
 */
function assertKnownConfigKeys(value: Record<string, unknown>, file: string): void {
  const unknownKeys = Object.keys(value).filter((key) => !CONFIG_KEYS.has(key));
  if (unknownKeys.length === 0) return;
  const listed = unknownKeys.map((key) => `\`${key}\``).join(", ");
  throw new Error(
    `${file} has unknown setting(s): ${listed}. Check the spelling against docs/configuration.md, ` +
      "or run `codebase-snapshot init --force` to write a config that lists every setting."
  );
}

/**
 * Reads what a config module exported.
 *
 * A `Promise` used to pass the `typeof === "object"` check, so
 * `export default Promise.resolve({…})` produced an empty configuration with
 * every setting silently ignored and exit 0. Anything that is not a plain
 * object is now a hard error that says what was received.
 */
function readConfigExport(exported: unknown, file: string): SnapshotConfig {
  if (exported === undefined || exported === null) {
    throw new Error(
      `${file} does not export a configuration object (received ${describeValue(exported)}).`
    );
  }
  if (Array.isArray(exported)) {
    throw new Error(
      `${file} exports an array; expected a single configuration object such as \`export default { outDir: "snapshot" }\`.`
    );
  }
  if (typeof exported === "function") {
    throw new Error(
      `${file} exports a function; expected a configuration object. Call the function yourself and export its result.`
    );
  }
  if (typeof exported !== "object") {
    throw new Error(
      `${file} does not export a configuration object (received ${describeValue(exported)}).`
    );
  }
  if (isThenable(exported)) {
    throw new Error(
      `${file} exports a Promise/thenable, not a configuration object. ` +
        "An async config is read synchronously, so its settings would be ignored: " +
        "export a plain object (`const config = {…}; export default config;`)."
    );
  }
  assertKnownConfigKeys(exported as Record<string, unknown>, file);
  return exported as SnapshotConfig;
}

/**
 * The last module config this process evaluated, keyed by path and content.
 *
 * ESM caches a module per specifier, so a second `import()` of the same URL returns the module
 * evaluated on the first load. `generate --watch` therefore kept applying the config it started
 * with. The old fix was a unique query string on every load, which made each reload a brand-new
 * module record that the engine cannot collect: a long-lived watch or MCP server grew without
 * bound, one module graph per reload.
 *
 * The key is the config file's content, so an unchanged file reuses the cached module (one URL
 * for the process) and an edit produces a new one — exactly the guarantee a reload needs. The
 * query covers `.mjs`, `.ts` and `.js` in an ES-module package. A CommonJS file (`.cjs`, or
 * `.js` in a CommonJS package) is additionally evicted from the require cache, which is keyed
 * by filename and ignores the query.
 *
 * A helper module the config imports is cached under its own stable URL, so editing it alone is
 * not picked up until the config file changes. That is stated in `docs/configuration.md`.
 */
let lastModuleConfig: {
  path: string;
  key: string;
  exports: Record<string, unknown> & { default?: unknown };
} | null = null;

/** A content key for a config file, or a stat-based approximation if it cannot be read. */
function moduleConfigKey(fullPath: string): string {
  try {
    return createHash("sha256").update(fs.readFileSync(fullPath)).digest("hex").slice(0, 24);
  } catch {
    try {
      const stats = fs.statSync(fullPath);
      return `stat-${stats.mtimeMs}-${stats.size}`;
    } catch {
      return "unreadable";
    }
  }
}

/**
 * Imports a module config, re-evaluating it only when its bytes changed.
 *
 * Failures are left to the caller: `import()` below reports them the same way a first load does.
 */
async function importConfigModule(
  fullPath: string
): Promise<Record<string, unknown> & { default?: unknown }> {
  const key = moduleConfigKey(fullPath);
  if (
    lastModuleConfig !== null &&
    lastModuleConfig.path === fullPath &&
    lastModuleConfig.key === key
  ) {
    return lastModuleConfig.exports;
  }

  try {
    const requireFromConfig = createRequire(fullPath);
    delete requireFromConfig.cache[requireFromConfig.resolve(fullPath)];
  } catch {
    // Best effort: an extension `require.resolve` cannot handle is still import()ed
    // below, and a genuine problem there is reported by that import.
  }

  const url = pathToFileURL(fullPath);
  url.searchParams.set("codebaseSnapshotLoad", key);
  const loaded = (await import(url.href)) as Record<string, unknown> & { default?: unknown };
  lastModuleConfig = { path: fullPath, key, exports: loaded };
  return loaded;
}

/**
 * Remembers the directory a config was loaded from, so `resolveConfig` can use it.
 *
 * Attached here rather than in `loadConfigFile`, because `loadConfigFileDetailed` is the loader
 * the MCP server and the first-run probes use, and it is on the public API. A caller doing
 * `resolveConfig((await loadConfigFileDetailed(dir)).config)` used to get a config with no
 * directory affinity, and `resolveConfig` fell back to `process.cwd()` — scanning the process's
 * working directory instead of the one the configuration came from.
 */
function attachConfigDir(config: SnapshotConfig, filePath: string): SnapshotConfig {
  if (typeof config === "object" && config !== null) {
    Object.defineProperty(config, CONFIG_DIR_SYMBOL, {
      value: path.dirname(filePath),
      enumerable: false,
      configurable: true,
    });
  }
  return config;
}

/**
 * Loads the first usable config file from `cwd`.
 *
 * Every failure is reported through `warnings` instead of being swallowed by an
 * empty `catch`: a syntax error in a user's config used to be indistinguishable
 * from having no config at all.
 */
export async function loadConfigFileDetailed(
  cwd: string,
  options: { allowExecutableConfig?: boolean } = {}
): Promise<ConfigLoadResult> {
  const warnings: string[] = [];
  const errors: string[] = [];
  const configDirectories: string[] = [];

  for (const filename of CONFIG_FILENAMES) {
    const fullPath = path.join(cwd, filename);
    let candidateStats: fs.Stats | null = null;
    try {
      candidateStats = fs.statSync(fullPath);
    } catch {
      // An existing path the process cannot stat is a broken config, not an absent one: fall
      // through to the loader so it can report the reason.
      if (!fs.existsSync(fullPath)) continue;
    }
    // A directory with a config's name is not a config file; reading it produced EISDIR and a
    // hard "could not be read" even when a later candidate was a perfectly good file.
    if (candidateStats !== null && !candidateStats.isFile()) {
      configDirectories.push(fullPath);
      continue;
    }

    if (filename.endsWith(".json") || filename === ".snapshotrc") {
      try {
        // The same guard a module config gets: this file is the configuration, so a typo in it
        // would otherwise be accepted and silently ignored.
        const config = parseJsonish(fs.readFileSync(fullPath, "utf8"), fullPath);
        if (config === null || typeof config !== "object" || Array.isArray(config)) {
          throw new Error(
            `${fullPath} does not hold a configuration object (received ${describeValue(config)}).`
          );
        }
        assertKnownConfigKeys(config as Record<string, unknown>, fullPath);
        return { config: attachConfigDir(config, fullPath), file: fullPath, warnings, errors };
      } catch (err) {
        // A read failure (an `EISDIR` from a config that is a directory, a permission error) comes
        // from `readFileSync` and carries no filename, so a repository with several config files
        // could not tell which one failed. Parse errors already name the file, hence the check.
        const raw = (err as Error).message;
        const message = raw.includes(fullPath) ? raw : `${fullPath}: ${raw}`;
        warnings.push(message);
        errors.push(message);
        continue;
      }
    }

    // A `.mjs`, `.cjs` or `.ts` config is code, and importing it runs that code with the
    // server's privileges. `snapshot serve-mcp` answers prompts from a repository's own files, so
    // a repository that ships one of these would get arbitrary execution from a cloned archive.
    // The MCP server refuses them and says why; the CLI keeps loading them, because the user
    // invoked the repository's own command there.
    if (options.allowExecutableConfig === false) {
      const message =
        `${fullPath} was not loaded: it is an executable config, and this server does not run ` +
        `repository code. Export the same settings from snapshot.config.json instead.`;
      warnings.push(message);
      errors.push(message);
      continue;
    }

    if (filename.endsWith(".ts") && !supportsTypeScriptImports()) {
      warnings.push(
        `${fullPath} was ignored: loading a .ts config needs Node >= 22.6 ` +
          `(running ${process.versions.node}). Use snapshot.config.mjs, .cjs or .json instead.`
      );
      continue;
    }

    try {
      // `pathToFileURL` handles drive letters, spaces, `#` and `%` correctly;
      // naive `file://${fullPath}` concatenation does not. The import goes
      // through a cache-busting helper so a reload sees the file on disk now.
      const imported = await importConfigModule(fullPath);
      // `default ?? imported` erased a deliberate `export default null`: the nullish fallback
      // substituted the module namespace, which is an object, so `readConfigExport` never saw the
      // null and the run generated with built-in defaults at exit 0. Distinguish "no default
      // export" from "the default export is null".
      const hasDefault = Object.prototype.hasOwnProperty.call(imported, "default");
      const config = readConfigExport(hasDefault ? imported.default : imported, fullPath);
      return { config: attachConfigDir(config, fullPath), file: fullPath, warnings, errors };
    } catch (err) {
      const message = `Could not load ${fullPath}: ${(err as Error).message}`;
      warnings.push(message);
      errors.push(message);
      continue;
    }
  }

  const pkgJsonPath = path.join(cwd, "package.json");
  if (fs.existsSync(pkgJsonPath)) {
    try {
      const parsed = parseJsonish(fs.readFileSync(pkgJsonPath, "utf8"), pkgJsonPath);
      const snapshotKey = (parsed as unknown as { snapshot?: unknown }).snapshot;
      // `typeof [] === "object"`, so an array used to be handed to the resolver as though it were a
      // configuration object and then silently ignored — with no warning, against this file's own
      // rule that a wrong type is a warning, and against the hard error an array throws in a module
      // config. The array is a wrong type like any other.
      if (snapshotKey && typeof snapshotKey === "object" && !Array.isArray(snapshotKey)) {
        // The same guard every other config file gets. It was skipped here, so
        // `"snapshot": { "maxPartByte": 4096 }` in package.json fell back to the default
        // budget at exit 0 — the silent fallback rule 1 forbids, in the one config
        // location a Node project is most likely to use.
        assertKnownConfigKeys(
          snapshotKey as Record<string, unknown>,
          `${pkgJsonPath} (the "snapshot" key)`
        );
        return {
          config: attachConfigDir(snapshotKey as SnapshotConfig, pkgJsonPath),
          file: pkgJsonPath,
          warnings,
          errors,
        };
      }
      // A wrong-typed key is a mistake but not proof of intent — plenty of other
      // tools use a "snapshot" key — so warn rather than fail the run. Silently
      // ignoring it was the worst of the three options.
      if (snapshotKey !== undefined) {
        const kind = Array.isArray(snapshotKey) ? "array" : typeof snapshotKey;
        warnings.push(
          `${pkgJsonPath}: the "snapshot" key must be an object; it was ${kind} and was ignored.`
        );
      }
    } catch (err) {
      const message = (err as Error).message;
      warnings.push(message);
      errors.push(message);
    }
  }

  // A directory with a configuration's name is worth saying out loud when nothing else
  // configured the repository: it is almost always a mistake, and it used to surface as an
  // EISDIR hard failure.
  if (configDirectories.length > 0) {
    warnings.push(
      `${configDirectories.join(", ")} ${configDirectories.length === 1 ? "is a directory" : "are directories"}, ` +
        `not a configuration file; no configuration was read from ${configDirectories.length === 1 ? "it" : "them"}.`
    );
  }

  return { config: null, file: null, warnings, errors };
}

export async function loadConfigFile(cwd: string): Promise<SnapshotConfig | null> {
  const loaded = await loadConfigFileDetailed(cwd);
  // The directory affinity is attached by `loadConfigFileDetailed`, which every loader uses:
  // `resolveConfig(await loadConfigFile(dir))` is the documented flow, and without it the run
  // generated into `process.cwd()` instead of that directory.
  // A config that exists but cannot be read is an error, not "no config": returning
  // null here made `resolveConfig(await loadConfigFile(cwd))` silently generate on
  // defaults while every setting the caller wrote was ignored.
  if (loaded.errors.length > 0) {
    throw new Error(`The config file could not be read: ${loaded.errors.join("; ")}`);
  }
  return loaded.config;
}

/**
 * Resolves the large-file threshold against the budget it has to agree with.
 *
 * The two settings answer one question — *can this file be emitted whole?* A part cannot hold
 * more than its budget, so a threshold **above** the budget describes files the tool cannot emit
 * whole while still refusing to call them large. The partitioner then cuts them to fit and the
 * manifest records `inclusionMode: "preview"` beside `isLarge: false`, which reads as "previewed
 * by policy" and is in fact "57 % of this file is gone".
 *
 * Defaulting the threshold to the budget makes the two numbers agree without configuration. An
 * explicit threshold above the budget is a contradiction, so it is an error rather than a warning
 * printed after the damage is written.
 */
function largeFileBytesFor(
  maxPartBytes: number,
  cliOptions: Partial<CliOptions> | undefined,
  userConfig: SnapshotConfig | null | undefined
): number {
  const requested = cliOptions?.largeFileBytes ?? userConfig?.largeFileBytes;
  const value = boundedBytes(requested, maxPartBytes, 1, "largeFileBytes");
  if (value > maxPartBytes) {
    throw new Error(
      `largeFileBytes (${describeBytes(value)}) is larger than maxPartBytes ` +
        `(${describeBytes(maxPartBytes)}). A file between the two cannot fit a part, so it would be ` +
        "cut to fit while the manifest called it complete. Raise maxPartBytes to at least " +
        "largeFileBytes, or lower largeFileBytes."
    );
  }
  return value;
}

/** Smallest usable part budget: a part header plus one section must fit. */
export const MIN_MAX_PART_BYTES = 4096;

/**
 * The same floor expressed in the unit `--max-part-tokens` is written in.
 *
 * `bytesForTokens` multiplies by four, so 1024 tokens and 4096 bytes are the same budget. A
 * smaller token budget used to be raised to the floor without a word: `--max-part-tokens 200`
 * was accepted, reported as 1024 tokens, and the setting the user wrote never applied. Rule 1
 * says an impossible budget is an error, so this is the number the CLI and the config both
 * refuse to go below.
 */
export const MIN_MAX_PART_TOKENS = MIN_MAX_PART_BYTES / 4;

/** Every artifact this package can write, in the order it is written. */
export const ARTIFACT_NAMES = [
  "readme",
  "prompt",
  "manifest",
  "parts",
  "navigation",
  "projectTree",
  "audit",
  "diff",
  "log",
  "tokenTree",
  "monolith",
] as const;

export type ArtifactName = (typeof ARTIFACT_NAMES)[number];

/** Everything on, except the monolith, which duplicates the whole payload. */
const DEFAULT_ARTIFACTS: ResolvedArtifacts = {
  readme: true,
  prompt: true,
  manifest: true,
  parts: true,
  navigation: true,
  projectTree: true,
  audit: true,
  // Opt-in: a diff and a log describe a moment, and most readers of a snapshot want the tree.
  diff: false,
  log: false,
  tokenTree: false,
  monolith: false,
};

function isArtifactName(value: string): value is ArtifactName {
  return (ARTIFACT_NAMES as ReadonlyArray<string>).includes(value);
}

/**
 * Validates a user-supplied artifact selection.
 *
 * Unknown keys are rejected rather than ignored: a typo here silently produces
 * an artifact the developer believed they had switched off, or leaves one they
 * believed they had removed.
 *
 * `only` is `--only-artifacts`. It is applied *after* the config and the flags and it wins
 * outright: "write only these" is a statement about the whole selection, not an addition to it.
 * That is the one thing the CLI could not express before — it forwarded the complement as
 * `skipped`, and a config that had turned one of the requested artifacts off therefore left the
 * run with every artifact disabled and nothing written.
 */
function resolveLogCount(value: unknown): number {
  if (value === undefined || value === null) return 20;
  if (typeof value !== "number" || !Number.isInteger(value) || value < 1 || value > 500) {
    throw new Error(`\`logCount\` must be an integer from 1 to 500 (received ${describeValue(value)}).`);
  }
  return value;
}

function resolveArtifacts(
  requested: SnapshotConfig["artifacts"] | undefined,
  skipped: string[] | undefined,
  includeMonolith: boolean,
  monolithOverride?: boolean,
  only?: readonly string[]
): ResolvedArtifacts {
  const artifacts: ResolvedArtifacts = {
    ...DEFAULT_ARTIFACTS,
    // `includeMonolith` predates this selection and stays the switch for it.
    monolith: includeMonolith,
  };

  if (requested !== undefined) {
    if (typeof requested !== "object" || requested === null || Array.isArray(requested)) {
      throw new Error("`artifacts` must be an object of boolean flags.");
    }
    for (const [name, value] of Object.entries(requested)) {
      if (!isArtifactName(name)) {
        throw new Error(
          `Unknown artifact "${name}". Expected one of: ${ARTIFACT_NAMES.join(", ")}.`
        );
      }
      if (typeof value !== "boolean") {
        throw new Error(`\`artifacts.${name}\` must be a boolean.`);
      }
      artifacts[name] = value;
    }
  }

  // An explicit `--include-monolith` outranks `artifacts.monolith: false` in the
  // config: the CLI is the more specific, more recent instruction. Suppressions
  // from `--skip-artifacts` are applied afterwards and still win, because asking
  // for both is a contradiction the user can see in the summary.
  if (monolithOverride !== undefined) {
    artifacts.monolith = monolithOverride;
  }

  if (only !== undefined && only.length > 0) {
    const keep = new Set<string>();
    for (const name of only) {
      if (!isArtifactName(name)) {
        throw new Error(
          `Unknown artifact "${name}". Expected one of: ${ARTIFACT_NAMES.join(", ")}.`
        );
      }
      keep.add(name);
    }
    for (const name of ARTIFACT_NAMES) {
      artifacts[name] = keep.has(name);
    }
    return artifacts;
  }

  for (const name of skipped ?? []) {
    if (!isArtifactName(name)) {
      throw new Error(
        `Unknown artifact "${name}". Expected one of: ${ARTIFACT_NAMES.join(", ")}.`
      );
    }
    artifacts[name] = false;
  }

  return artifacts;
}

/**
 * A wrong-typed or unusable setting is a hard error, never a fallback.
 *
 * `previewHeadLines: 0` used to be silently replaced by 80 and the run exited 0,
 * while `include: "x"` errored — the same class of mistake behaving two ways.
 */
/**
 * Files a destination accepts in one message, when nothing says otherwise.
 *
 * Ten is the cap the hosted assistants apply to an attachment list, and it is a default rather
 * than a rule: `attachmentSlots: 0` means "no limit", and any other whole number is honoured as
 * given. It never changes the payload — only the delivery plan `PROMPT.md` writes.
 */
export const DEFAULT_ATTACHMENT_SLOTS = 10;

function resolveAttachmentSlots(value: unknown): number {
  if (value === undefined || value === null) return DEFAULT_ATTACHMENT_SLOTS;
  if (typeof value !== "number" || !Number.isInteger(value) || value < 0) {
    throw new Error(
      "attachmentSlots must be a whole number, with 0 meaning no limit (received " +
        describeValue(value) +
        ")."
    );
  }
  return value;
}

/**
 * The experimental part-count ceiling: `null` (off) or a positive whole number.
 *
 * Not folded into `strictPositiveInteger`: `0` here is not "one" and is not "off" spelled
 * differently — it is a number of parts that cannot exist, so it is refused rather than clamped.
 */
function resolveMaxParts(value: unknown): number | null {
  if (value === undefined || value === null) return null;
  if (typeof value !== "number" || !Number.isInteger(value) || value < 1) {
    throw new Error(
      "maxParts must be a whole number of parts, or null to disable it (received " +
        describeValue(value) +
        ")."
    );
  }
  return value;
}

/**
 * Which job the brief is written for: `audit` (the default), `review` or `explain`.
 *
 * An unknown value is an error rather than a silent fall back to the default: the whole point of
 * the setting is that the reader is told what to produce, and quietly producing the audit job for
 * a request to explain a file would be the tool deciding something it was asked to decide.
 */
function resolvePromptTask(value: unknown): PromptTask {
  if (value === undefined || value === null) return "audit";
  if (value === "audit" || value === "review" || value === "explain") return value;
  throw new Error(
    'promptTask must be one of "audit", "review" or "explain" (received ' +
      describeValue(value) +
      ")."
  );
}

/**
 * Reads the owner brief and refuses one that cannot be merged.
 *
 * A path that does not exist is an error because the alternative is a snapshot whose brief
 * silently lost the half the owner wrote. A reserved heading is an error because the merge would
 * otherwise let prose overwrite a measured section.
 */
/** 64 KiB: about ten thousand words of judgement, and far below a part. */
export const MAX_BRIEF_BYTES = 64 * 1024;

function readConfiguredBrief(cwd: string, value: unknown): OwnerBrief | undefined {
  if (value === undefined || value === null) return undefined;
  if (typeof value !== "string" || value.trim().length === 0) {
    throw new Error(
      "brief must be a path to a markdown file (received " + describeValue(value) + ")."
    );
  }
  const filePath = path.resolve(cwd, value);
  let text: string;
  try {
    if (!fs.statSync(filePath).isFile()) throw new Error("not a file");
    text = fs.readFileSync(filePath, "utf8");
  } catch {
    throw new Error(
      'brief "' + value + '" could not be read as a file; a snapshot must not ship without the ' +
        "half of the brief the owner wrote."
    );
  }
  // A brief is judgement, not another codebase: past this size it stops being instructions
  // and becomes a payload that crowds the parts it is meant to explain.
  const bytes = Buffer.byteLength(text, "utf8");
  if (bytes > MAX_BRIEF_BYTES) {
    throw new Error(
      'brief "' + value + '" is ' + bytes + " bytes; the limit is " + MAX_BRIEF_BYTES +
        ". Keep it to what a reader can act on, or move the detail into a document the snapshot carries."
    );
  }
  const parsed = parseOwnerBrief(value, text);
  if (parsed.problems.length > 0) {
    throw new Error(
      'brief "' + value + '" cannot be used:\n  - ' + parsed.problems.join("\n  - ")
    );
  }
  return parsed.brief;
}

function strictPositiveInteger(value: unknown, fallback: number, label: string): number {
  if (value === undefined) return fallback;
  if (typeof value !== "number" || !Number.isInteger(value) || value <= 0) {
    throw new Error(`${label} must be a positive integer (received ${describeValue(value)}).`);
  }
  return value;
}

function strictBoolean(value: unknown, fallback: boolean, label: string): boolean {
  if (value === undefined) return fallback;
  if (typeof value !== "boolean") {
    throw new Error(`${label} must be true or false (received ${describeValue(value)}).`);
  }
  return value;
}

function strictString(value: unknown, fallback: string, label: string): string {
  if (value === undefined) return fallback;
  if (typeof value !== "string" || value.trim() === "") {
    throw new Error(`${label} must be a non-empty string (received ${describeValue(value)}).`);
  }
  return value;
}

/** `excludePatterns: "src/**"` used to be stored as-is and silently matched nothing. */
function resolveExcludePatterns(value: unknown): string[] {
  if (value === undefined) return [];
  if (!Array.isArray(value) || value.some((pattern) => typeof pattern !== "string")) {
    throw new Error(
      `\`excludePatterns\` must be an array of glob strings such as ["**/*.test.ts"] (received ${describeValue(value)}).`
    );
  }
  return value.map((pattern) => pattern.trim()).filter(Boolean);
}

/**
 * `preset: "detected"` is the documented default and what `describe` reports, so
 * it must be accepted; `"auto"` is its obvious spelling and is accepted too.
 */
const AUTO_PRESET_ALIASES = new Set(["auto", "detected"]);

function resolvePresetName(value: unknown): string | undefined {
  if (value === undefined) return undefined;
  if (typeof value !== "string" || value.trim() === "") {
    throw new Error(
      `\`preset\` must be a preset name (received ${describeValue(value)}). ` +
        `Use "detected" (or "auto") to detect one, or one of: ${listPresetNames().join(", ")}.`
    );
  }
  const name = value.trim();
  return AUTO_PRESET_ALIASES.has(name.toLowerCase()) ? undefined : name;
}

interface NormalisedRule {
  name: string;
  match: string | RegExp | ((filePath: string) => boolean);
}

/**
 * Validates custom `layers` / `kinds` rules.
 *
 * The documented example used `{ layer: "api", … }` while the type requires
 * `name`, and nothing checked it: `classifyLayer` returned `undefined` and
 * `capMetadata(undefined).length` crashed `generate` with a `TypeError` after the
 * scan had already run. Both spellings are now accepted, and anything else is a
 * validation error that names the index and the expected shape.
 */
function resolveRuleList(value: unknown, kind: "layer" | "kind"): NormalisedRule[] {
  const collection = kind === "layer" ? "layers" : "kinds";
  const example =
    kind === "layer"
      ? `{ name: "api", match: "src/api/**" }`
      : `{ kind: "route", match: "src/routes/**" }`;

  if (value === undefined) return [];
  if (!Array.isArray(value)) {
    throw new Error(
      `\`${collection}\` must be an array of ${kind} rules (received ${describeValue(value)}). A ${kind} rule is ${example}.`
    );
  }

  return value.map((entry, index) => {
    const where = `${collection}[${index}]`;
    if (typeof entry !== "object" || entry === null || Array.isArray(entry)) {
      throw new Error(`${where} must be an object (received ${describeValue(entry)}). A ${kind} rule is ${example}.`);
    }

    const record = entry as Record<string, unknown>;
    const keys = Object.keys(record);
    const canonical = kind === "layer" ? "name" : "kind";
    const alias = kind === "layer" ? "layer" : "name";
    const rawName =
      typeof record[canonical] === "string"
        ? record[canonical]
        : typeof record[alias] === "string"
          ? record[alias]
          : undefined;

    if (rawName === undefined || rawName.trim() === "") {
      throw new Error(
        `${where} is missing \`${canonical}\` (received keys: ${keys.join(", ") || "none"}). ` +
          `A ${kind} rule is ${example}; \`${alias}\` is accepted as an alias of \`${canonical}\`.`
      );
    }

    const match = record.match;
    if (match === undefined) {
      throw new Error(
        `${where}.match is required (received keys: ${keys.join(", ") || "none"}). ` +
          `Use a glob string ("src/api/**"), a RegExp (/\\\\.tsx$/) or a function.`
      );
    }
    if (!(typeof match === "string" || match instanceof RegExp || typeof match === "function")) {
      throw new Error(`${where}.match must be a string, a RegExp or a function (received ${describeValue(match)}).`);
    }
    if (typeof match === "string" && match.trim() === "") {
      throw new Error(`${where}.match must not be an empty string.`);
    }

    return {
      name: rawName.trim(),
      match: match as string | RegExp | ((filePath: string) => boolean),
    };
  });
}

function resolveLayerRules(value: unknown): LayerRule[] {
  return resolveRuleList(value, "layer").map((rule) => ({ name: rule.name, match: rule.match }));
}

function resolveKindRules(value: unknown): KindRule[] {
  return resolveRuleList(value, "kind").map((rule) => ({ kind: rule.name, match: rule.match }));
}

/**
 * The output directories, expressed as cwd-relative exclude patterns.
 *
 * They are the tool's own artifacts, not source: scanning them changed the
 * fingerprint on every run and made `validate` report `modified:` for files
 * `generate` had just written. Only directories inside `cwd` can be scanned, so
 * only those need excluding.
 */
function outputExcludePatterns(cwd: string, outDir: string, tmpDir: string): string[] {
  const patterns: string[] = [];
  for (const dir of [outDir, tmpDir]) {
    const absolute = path.resolve(cwd, dir);
    const relative = path.relative(cwd, absolute);
    if (
      !relative ||
      relative === ".." ||
      relative.startsWith(`..${path.sep}`) ||
      path.isAbsolute(relative)
    ) {
      continue;
    }
    patterns.push(`${relative.replace(/\\/g, "/")}/**`);
  }
  return patterns;
}

const BYTE_UNITS: Record<string, number> = {
  b: 1,
  k: 1024,
  kb: 1024,
  kib: 1024,
  m: 1024 * 1024,
  mb: 1024 * 1024,
  mib: 1024 * 1024,
  g: 1024 * 1024 * 1024,
  gb: 1024 * 1024 * 1024,
  gib: 1024 * 1024 * 1024,
};

/**
 * Parses a byte budget.
 *
 * Accepts a plain number (`122880`), a numeric string (`"122880"`), or a
 * human-readable size (`"120k"`, `"1.5mb"`, `"2 GB"`). Returns `undefined` for
 * anything it cannot read, so callers can decide whether that is an error or a
 * fallback — a typo'd budget must not silently become the default.
 */
export function parseByteSize(value: ByteSize | null | undefined): number | undefined {
  if (value === null || value === undefined) return undefined;
  if (typeof value === "number") {
    return Number.isFinite(value) ? Math.floor(value) : undefined;
  }
  const match = /^\s*(\d+(?:\.\d+)?)\s*(b|k|kb|kib|m|mb|mib|g|gb|gib)?\s*$/i.exec(value);
  if (!match) return undefined;
  const amount = Number(match[1]);
  if (!Number.isFinite(amount)) return undefined;
  const multiplier = BYTE_UNITS[(match[2] ?? "b").toLowerCase()] ?? 1;
  return Math.floor(amount * multiplier);
}

function describeBytes(value: ByteSize): string {
  return typeof value === "number" ? String(value) : `"${value}"`;
}

/**
 * Byte budgets must be usable, not merely positive: a budget below the part
 * header cannot be honoured, and silently clamping it used to produce parts
 * that blew through the requested limit.
 */
function boundedBytes(
  value: ByteSize | undefined,
  fallback: number,
  minimum: number,
  label: string
): number {
  if (value === undefined) return fallback;
  const parsed = parseByteSize(value);
  if (parsed === undefined) {
    throw new Error(
      `${label} must be a byte count such as 120000, "120k" or "1.5mb" (received ${describeBytes(value)}).`
    );
  }
  // A non-positive value is a mistake, not a request for the default: treating
  // `maxPartBytes: 0` as "use 300 KB" silently ignored the setting while
  // `maxPartBytes: 1000` threw.
  if (parsed <= 0) {
    throw new Error(`${label} must be a positive byte count (received ${describeBytes(value)}).`);
  }
  if (parsed < minimum) {
    throw new Error(`${label} must be at least ${minimum} bytes (received ${describeBytes(value)}).`);
  }
  return parsed;
}

/**
 * Validates a budget written in **tokens**, refusing anything below the shared floor.
 *
 * The message says "token count" rather than "byte count": `--max-part-tokens 200` used to be
 * rejected with advice about bytes, which is the other unit.
 */
function boundedTokens(value: ByteSize, label: string): number {
  const parsed = parseByteSize(value);
  if (parsed === undefined || !Number.isInteger(parsed)) {
    throw new Error(
      `${label} must be a whole token count such as 30000 or "30k" (received ${describeBytes(value)}).`
    );
  }
  if (parsed < MIN_MAX_PART_TOKENS) {
    throw new Error(
      `${label} must be at least ${MIN_MAX_PART_TOKENS} tokens (${MIN_MAX_PART_BYTES} bytes is the smallest part budget); received ${describeBytes(value)}.`
    );
  }
  return parsed;
}

function optionalBytes(
  value: ByteSize | null | undefined,
  label: string
): number | null {
  if (value === undefined || value === null) return null;
  const parsed = parseByteSize(value);
  if (parsed === undefined || parsed <= 0) {
    throw new Error(
      `${label} must be a positive byte count such as 1000000 or "1mb" (received ${describeBytes(value)}).`
    );
  }
  return parsed;
}

/** Normalises the `include` allow-list, rejecting anything that is not a glob. */
function resolveInclude(include: SnapshotConfig["include"]): string[] {
  if (include === undefined) return [];
  if (!Array.isArray(include) || include.some((pattern) => typeof pattern !== "string")) {
    throw new Error("`include` must be an array of glob strings.");
  }
  return include.map((pattern) => pattern.trim()).filter(Boolean);
}

function resolveLayersMode(mode: SnapshotConfig["layersMode"]): "merge" | "replace" {
  if (mode === undefined) return "merge";
  if (mode !== "merge" && mode !== "replace") {
    throw new Error(`\`layersMode\` must be "merge" or "replace" (received ${JSON.stringify(mode)}).`);
  }
  return mode;
}

/**
 * Resolves per-layer budgets.
 *
 * `overrideDefault` is set when `maxPartBytes` was written explicitly (CLI flag
 * or config key). That value is the single-part budget the CLI prints and the
 * manifest records, so it becomes `budgets.default` and caps every per-layer
 * budget: `--max-part-bytes 4096` next to `budgets: { default: "300k" }` used to
 * print "Part budget: 4 KB" while emitting 151 KB parts.
 */
function resolveBudgets(
  budgets: SnapshotConfig["budgets"],
  fallback: number,
  overrideDefault: boolean
): ResolvedBudgets {
  const byLayer: Record<string, number> = {};
  if (budgets === undefined) return { default: fallback, byLayer };

  if (typeof budgets !== "object" || budgets === null || Array.isArray(budgets)) {
    throw new Error(
      `\`budgets\` must be an object such as { default: "120k", byLayer: { api: "60k" } } (received ${describeValue(budgets)}).`
    );
  }
  if (budgets.byLayer !== undefined) {
    if (typeof budgets.byLayer !== "object" || budgets.byLayer === null) {
      throw new Error("`budgets.byLayer` must be an object of layer name to byte size.");
    }
    for (const [layer, value] of Object.entries(budgets.byLayer)) {
      byLayer[layer] = boundedBytes(
        value,
        fallback,
        MIN_MAX_PART_BYTES,
        `budgets.byLayer["${layer}"]`
      );
    }
  }

  // Validated even when overridden, so `budgets.default: 0` is still an error
  // rather than a silently ignored setting.
  const resolvedDefault = boundedBytes(budgets.default, fallback, MIN_MAX_PART_BYTES, "budgets.default");
  if (!overrideDefault) return { default: resolvedDefault, byLayer };

  for (const [layer, value] of Object.entries(byLayer)) {
    byLayer[layer] = Math.min(value, fallback);
  }
  return { default: fallback, byLayer };
}

function resolveHooks(hooks: SnapshotConfig["hooks"]): HooksConfig {
  if (hooks === undefined) return {};
  if (typeof hooks !== "object" || hooks === null || Array.isArray(hooks)) {
    throw new Error("`hooks` must be an object.");
  }
  if (hooks.afterGenerate !== undefined && typeof hooks.afterGenerate !== "function") {
    throw new Error("`hooks.afterGenerate` must be a function.");
  }
  return { ...hooks };
}

function resolveCandidateCwd(
  userConfig: SnapshotConfig | null,
  cliOptions: Partial<CliOptions> | undefined,
  baseDir: string | undefined
): string {
  if (
    userConfig?.cwd !== undefined &&
    (typeof userConfig.cwd !== "string" || userConfig.cwd.trim() === "")
  ) {
    throw new Error(
      `\`cwd\` must be a non-empty path string (received ${describeValue(userConfig.cwd)}).`
    );
  }
  const candidate = cliOptions?.cwd || userConfig?.cwd || baseDir || process.cwd();
  const resolved = path.resolve(candidate);
  if (!fs.existsSync(resolved)) {
    throw new Error(`Working directory does not exist: ${resolved}`);
  }
  if (!fs.statSync(resolved).isDirectory()) {
    throw new Error(`Working directory is not a directory: ${resolved}`);
  }
  return resolved;
}

/**
 * Merges user config, preset defaults and CLI overrides.
 *
 * `baseDir` is the directory the config was loaded from. Without it the natural
 * library flow (`loadConfigFile(dir)` then `resolveConfig(config)`) silently
 * fell back to `process.cwd()` and generated into the caller's directory.
 */
export function resolveConfig(
  userConfig: SnapshotConfig | null,
  cliOptions?: Partial<CliOptions>,
  baseDir?: string
): ResolvedSnapshotConfig {
  // The directory the config was loaded from wins over process.cwd(): a config that
  // travels to another directory must not silently scan the caller's project.
  const configDir = (userConfig as Record<string | symbol, unknown> | null)?.[CONFIG_DIR_SYMBOL] as
    | string
    | undefined;
  const cwd = resolveCandidateCwd(userConfig ?? null, cliOptions, baseDir ?? configDir);

  // How candidates are found. The CLI flag outranks the config key, an unusable
  // value is a hard error (never a silent "auto"), and the effective mode is
  // registered for every scan in this run.
  const requestedDiscovery =
    (cliOptions as { discovery?: unknown } | undefined)?.discovery ??
    (userConfig as { discovery?: unknown } | null | undefined)?.discovery;
  if (requestedDiscovery !== undefined && !isDiscoveryMode(requestedDiscovery)) {
    throw new Error(
      `\`discovery\` must be one of: auto, git, walk (received ${describeValue(requestedDiscovery)}).`
    );
  }
  const discovery: DiscoveryMode = requestedDiscovery ?? "auto";

  // A forced preset must exist: silently falling back would leave the developer
  // believing their layers are in effect when they are not.
  const forcedPreset = resolvePresetName(userConfig?.preset);
  if (forcedPreset !== undefined && !getPreset(forcedPreset)) {
    throw new Error(unknownPresetMessage(forcedPreset));
  }
  const preset = detectPreset(cwd, forcedPreset);
  const layersMode = resolveLayersMode(userConfig?.layersMode);

  // Validated before use: an unvalidated rule used to reach `classifyLayer` and
  // crash `generate` with `Cannot read properties of undefined (reading 'length')`.
  const userLayers = resolveLayerRules(userConfig?.layers);
  const userKinds = resolveKindRules(userConfig?.kinds);

  // `merge` (the default) keeps the preset's rules and lets user rules win by
  // being evaluated first; `replace` is the old, all-or-nothing behaviour.
  const layers: LayerRule[] =
    userLayers.length > 0
      ? layersMode === "replace"
        ? userLayers
        : [...userLayers, ...preset.layers]
      : preset.layers;

  const kinds: KindRule[] =
    userKinds.length > 0
      ? layersMode === "replace"
        ? userKinds
        : [...userKinds, ...preset.kinds]
      : preset.kinds;

  const secrets = userConfig?.secrets;
  if (secrets !== undefined && (typeof secrets !== "object" || Array.isArray(secrets))) {
    throw new Error(
      `\`secrets\` must be an object of { customPatterns, disableDefaultPatterns } (received ${describeValue(secrets)}).`
    );
  }
  const customRules = secrets?.customPatterns ?? [];
  if (!Array.isArray(customRules)) {
    throw new Error(
      `\`secrets.customPatterns\` must be an array of secret rules (received ${describeValue(customRules)}). ` +
        "Each entry is a RegExp, a string, or { rule, pattern }."
    );
  }
  const disableDefaultPatterns = strictBoolean(
    secrets?.disableDefaultPatterns,
    false,
    "`secrets.disableDefaultPatterns`"
  );
  // Compiled separately so a rejected rule is reported at its index in the user's
  // `customPatterns` array, and so a bare RegExp is named `custom-1`, `custom-2`, …
  // rather than by its position after the built-ins.
  // A raw `{ secretRules: [...] }` handed to the library used to be dropped:
  // only `secrets.customPatterns` was read, so the caller got clear-text output
  // and no warning. Applying them is the only non-silent option; a non-array is
  // refused outright.
  const aliasedRules = (userConfig as { secretRules?: unknown } | null | undefined)?.secretRules;
  if (aliasedRules !== undefined && !Array.isArray(aliasedRules)) {
    throw new Error(
      `\`secretRules\` must be an array of { rule, pattern } entries (received ${describeValue(aliasedRules)}).`
    );
  }

  const compiledCustomRules = compileSecretRules([
    ...customRules,
    ...((aliasedRules ?? []) as SecretRuleInput[]),
  ]);
  const secretRules = disableDefaultPatterns
    ? compiledCustomRules
    : [...compileSecretRules(DEFAULT_SECRET_PATTERNS), ...compiledCustomRules];

  // Registered so `collectFiles` scans *paths* with the same rules that redact
  // content, including `customPatterns`. An explicit `options.secretRules` still
  // wins, and every command resolves its configuration immediately before it
  // scans.

  const cliMonolith = cliOptions?.includeMonolith;
  const rawPack = (cliOptions as { pack?: unknown } | undefined)?.pack ?? userConfig?.pack;
  const pack =
    rawPack === undefined || rawPack === null
      ? null
      : rawPack === "single" || rawPack === "xml" || rawPack === "json"
        ? rawPack
        : (() => {
            throw new Error(
              "`pack` must be one of: single, xml, json (received " + describeValue(rawPack) + ")."
            );
          })();
  // A named pack is a request for a single-file artifact, so it implies the monolith switch.
  const includeMonolith =
    pack !== null
      ? true
      : (cliMonolith ?? strictBoolean(userConfig?.includeMonolith, false, "`includeMonolith`"));
  // The three opt-in reports are CLI switches as well as config keys, so they are merged into
  // the request before resolution: `--skip-artifacts` still wins, which is the documented
  // precedence (an explicit skip outranks a request).
  const requestedArtifacts = {
    ...(userConfig?.artifacts ?? {}),
    ...(cliOptions?.includeDiffs === true ? { diff: true } : {}),
    ...(cliOptions?.includeLogs !== undefined ? { log: true } : {}),
    ...(cliOptions?.tokenTree === true ? { tokenTree: true } : {}),
  };
  const artifacts = resolveArtifacts(
    Object.keys(requestedArtifacts).length === 0 ? undefined : requestedArtifacts,
    cliOptions?.skipArtifacts,
    includeMonolith,
    cliMonolith,
    cliOptions?.onlyArtifacts
  );

  // Precedence: CLI `--max-part-bytes` > config `maxPartBytes` > `budgets.default`
  // > 300 KB. `resolveBudgets` turns an explicit value into `budgets.default` and
  // caps every per-layer budget, so the printed budget and the emitted part size
  // can never disagree.
  const explicitMaxPartBytes = cliOptions?.maxPartBytes ?? userConfig?.maxPartBytes;
  const maxPartBytes = boundedBytes(
    explicitMaxPartBytes,
    300 * 1024,
    MIN_MAX_PART_BYTES,
    "maxPartBytes"
  );
  // A token budget is a *ceiling on the same thing*, so it narrows the byte budget instead of
  // living beside it: the partitioner enforces bytes, every validator and report reads bytes,
  // and a second, parallel limit that the partitioner did not know about would be a promise
  // nothing kept. The conversion uses the same ratio the estimate is built on, and the token
  // number the user chose is recorded so the manifest states their unit, not only ours.
  const rawMaxPartTokens =
    (cliOptions as { maxPartTokens?: ByteSize | null } | undefined)?.maxPartTokens ??
    (userConfig as { maxPartTokens?: ByteSize | null } | null | undefined)?.maxPartTokens;
  // `null` means "not set", the way `maxMonolithBytes: null` does in a generated config;
  // passing it on to the byte parser would fail a config that simply spells the default.
  const requestedMaxPartTokens = rawMaxPartTokens === null ? undefined : rawMaxPartTokens;
  const maxPartTokens =
    requestedMaxPartTokens === undefined
      ? undefined
      : boundedTokens(requestedMaxPartTokens, "maxPartTokens");
  const effectiveMaxPartBytes =
    maxPartTokens === undefined
      ? maxPartBytes
      : Math.min(maxPartBytes, bytesForTokens(maxPartTokens));
  const budgets = resolveBudgets(
    userConfig?.budgets,
    effectiveMaxPartBytes,
    explicitMaxPartBytes !== undefined || maxPartTokens !== undefined
  );
  // When the budget came from `budgets.default` rather than from `maxPartBytes`, the two still
  // have to agree. The partitioner reads `budgets` and the manifest records `maxPartBytes`, so a
  // config with only `budgets: { default: "100k" }` described itself as 300 KB while emitting
  // 100 KB parts — and `normalizeResolvedConfig` cannot repair the disagreement afterwards
  // without overruling the user's own budget.
  const resolvedMaxPartBytes =
    explicitMaxPartBytes !== undefined || maxPartTokens !== undefined
      ? effectiveMaxPartBytes
      : budgets.default;

  const configuredOutDir = strictString(userConfig?.outDir, "snapshot", "`outDir`");
  const outDir = cliOptions?.outDir || configuredOutDir;

  // A changed-files scope is a filter with two settings that must agree. `--with-dependents`
  // on its own asks to widen a set that was never narrowed, so it is a mistake rather than a
  // no-op: accepting it silently would let a user believe a filter was applied.
  const rawChangedSinceSetting =
    (cliOptions as { changedSince?: unknown } | undefined)?.changedSince ??
    (userConfig as { changedSince?: unknown } | null | undefined)?.changedSince;
  // `null` is how the generated config spells "not set" — `maxMonolithBytes: null` and
  // `maxPartTokens: null` are read the same way — so a config that simply wrote the default must
  // not fail the type check below.
  const rawChangedSince =
    rawChangedSinceSetting === null ? undefined : rawChangedSinceSetting;
  if (
    rawChangedSince !== undefined &&
    (typeof rawChangedSince !== "string" || rawChangedSince.trim().length === 0)
  ) {
    throw new Error(
      `\`changedSince\` must be a git ref such as "main" or "HEAD~3" (received ${describeValue(rawChangedSince)}).`
    );
  }
  const changedSince = rawChangedSince === undefined ? undefined : String(rawChangedSince).trim();

  const rawStaged =
    (cliOptions as { staged?: unknown } | undefined)?.staged ??
    (userConfig as { staged?: unknown } | null | undefined)?.staged;
  if (rawStaged !== undefined && typeof rawStaged !== "boolean") {
    throw new Error(`\`staged\` must be a boolean (received ${describeValue(rawStaged)}).`);
  }
  const staged = rawStaged === true;

  const rawWithDependents =
    (cliOptions as { withDependents?: unknown } | undefined)?.withDependents ??
    (userConfig as { withDependents?: unknown } | null | undefined)?.withDependents;
  if (rawWithDependents !== undefined && typeof rawWithDependents !== "boolean") {
    throw new Error(
      `\`withDependents\` must be a boolean (received ${describeValue(rawWithDependents)}).`
    );
  }
  const withDependents = rawWithDependents === true;

  const rawSkeleton =
    (cliOptions as { skeleton?: unknown } | undefined)?.skeleton ??
    (userConfig as { skeleton?: unknown } | null | undefined)?.skeleton;
  if (rawSkeleton !== undefined && typeof rawSkeleton !== "boolean") {
    throw new Error(`\`skeleton\` must be a boolean (received ${describeValue(rawSkeleton)}).`);
  }
  const skeleton = rawSkeleton === true;

  const rawSarif =
    (cliOptions as { sarif?: unknown } | undefined)?.sarif ??
    (userConfig as { sarif?: unknown } | null | undefined)?.sarif;
  if (rawSarif !== undefined && typeof rawSarif !== "boolean") {
    throw new Error(`\`sarif\` must be a boolean (received ${describeValue(rawSarif)}).`);
  }
  const sarif = rawSarif === true;
  if (withDependents && changedSince === undefined && !staged) {
    throw new Error(
      "`withDependents` widens a changed-files scope, so it needs `changedSince` or `staged` " +
        "(with neither, every file is already included)."
    );
  }
  const tmpDir = strictString(userConfig?.tmpDir, "snapshot.tmp", "`tmpDir`");
  const branch = strictString(userConfig?.branch, "main", "`branch`");
  const configuredSensitiveFiles = strictBoolean(
    userConfig?.includeSensitiveFiles,
    false,
    "`includeSensitiveFiles`"
  );
  const includeSensitiveFiles = strictBoolean(
    cliOptions?.includeSensitiveFiles,
    configuredSensitiveFiles,
    "`includeSensitiveFiles`"
  );

  // The owner-written half of the brief, read here so a missing or malformed file fails the
  // run before a snapshot is written, and digested so a later edit is drift rather than silence.
  const configuredBrief = readConfiguredBrief(
    cwd,
    cliOptions?.brief ?? userConfig?.brief
  );

  // The resolved output directories are this tool's own artifacts, never source.
  // Leaving them in the scan made the fingerprint change on every run and made
  // `validate` report `modified:` for files `generate` had just written.
  const presetExclude = [
    ...new Set([...preset.exclude, ...outputExcludePatterns(cwd, outDir, tmpDir)]),
  ];

  return markResolvedConfig({
    cwd,
    branch,
    outDir,
    tmpDir,
    maxPartBytes: resolvedMaxPartBytes,
    ...(maxPartTokens === undefined ? {} : { maxPartTokens }),
    largeFileBytes: largeFileBytesFor(resolvedMaxPartBytes, cliOptions, userConfig),
    previewHeadLines: strictPositiveInteger(userConfig?.previewHeadLines, 80, "`previewHeadLines`"),
    previewTailLines: strictPositiveInteger(userConfig?.previewTailLines, 40, "`previewTailLines`"),
    includeMonolith: artifacts.monolith,
    maxMonolithBytes: optionalBytes(
      cliOptions?.maxMonolithBytes !== undefined
        ? cliOptions.maxMonolithBytes
        : userConfig?.maxMonolithBytes,
      "maxMonolithBytes"
    ),
    includeSensitiveFiles,
    attachmentSlots: resolveAttachmentSlots(
      cliOptions?.attachmentSlots ?? userConfig?.attachmentSlots
    ),
    maxParts: resolveMaxParts(cliOptions?.maxParts ?? userConfig?.maxParts),
    promptTask: resolvePromptTask(cliOptions?.promptTask ?? userConfig?.promptTask),
    ...(configuredBrief === undefined ? {} : { brief: configuredBrief }),
    ...(changedSince === undefined ? {} : { changedSince }),
    ...(staged ? { staged } : {}),
    ...(withDependents ? { withDependents } : {}),
    ...(skeleton ? { skeleton } : {}),
    ...(sarif ? { sarif } : {}),
    pack,
    stripComments: strictBoolean(
      (cliOptions as { stripComments?: unknown } | undefined)?.stripComments ?? userConfig?.stripComments,
      false,
      "`stripComments`"
    ),
    logCount: resolveLogCount(
      (cliOptions as { logCount?: unknown } | undefined)?.logCount ?? userConfig?.logCount
    ),
    include: resolveInclude(userConfig?.include),
    preset: preset.presetName,
    presetExclude,
    artifacts,
    layersMode,
    budgets,
    hooks: resolveHooks(userConfig?.hooks),
    layers,
    kinds,
    // `exclude` is the flag spelling of the same setting; writing it in a config used to
    // be ignored without a word.
    excludePatterns: resolveExcludePatterns(
      userConfig?.excludePatterns ?? (userConfig as { exclude?: unknown } | null)?.exclude
    ),
    secretRules,
    // Extra property rather than a `ResolvedSnapshotConfig` field: the resolved
    // shape is owned elsewhere, and every scan reads it through the registry in
    // `scanner/files.ts`.
    discovery,
  } as ResolvedSnapshotConfig & { discovery: DiscoveryMode });
}

/**
 * Matches a path against a layer/kind rule.
 *
 * `"src/app/**"` now means "exactly `src/app` or below": the previous
 * implementation stripped `**` **and** the trailing slash, so the pattern also
 * matched `src/apple/` and `src/application/`.
 *
 * Everything else is answered by {@link matchesExclude}, which is the one implementation of
 * "does this pattern select this path": glob metacharacters (including `{a,b}` and `[abc]`,
 * which used to be tested for `*`/`?` only and then silently compared as literal text) go
 * through the glob translator, and a plain pattern means a whole **path segment** sequence
 * rather than a substring. `match: "test"` used to select `src/contest/a.ts`, and a layer rule
 * that matched nothing classified every file under it as `other`.
 */
export function matchRule(
  filePath: string,
  matcher: string | RegExp | ((filePath: string) => boolean)
): boolean {
  if (typeof matcher === "function") return matcher(filePath);
  if (matcher instanceof RegExp) {
    matcher.lastIndex = 0;
    return matcher.test(filePath);
  }
  if (typeof matcher === "string") {
    const pattern = matcher.replace(/\\/g, "/").trim();
    if (!pattern) return false;

    if (pattern.endsWith("/**")) {
      const prefix = pattern.slice(0, -3).replace(/\/+$/, "");
      // A literal prefix gets exact path-boundary semantics. A prefix that
      // itself contains glob characters (e.g. `**/features/**`) must fall
      // through to the glob matcher instead.
      if (!prefix) return true;
      if (!/[*?{[]/.test(prefix)) {
        return filePath === prefix || filePath.startsWith(`${prefix}/`);
      }
    }
    return matchesExclude(filePath, pattern);
  }
  return false;
}

export function classifyLayer(filePath: string, layers: LayerRule[]): string {
  for (const layer of layers) {
    if (matchRule(filePath, layer.match)) return layer.name;
  }
  return "other";
}

export function classifyKind(filePath: string, kinds: KindRule[]): string {
  for (const kind of kinds) {
    if (matchRule(filePath, kind.match)) return kind.kind;
  }
  return "other";
}

/**
 * Digest of every setting that changes what a snapshot contains.
 *
 * Masked config values cannot be compared directly: two different secrets both
 * mask to the same placeholder, and `validate` would then report "current" for a
 * snapshot generated with different rules. A digest of the raw effective settings
 * answers "is this snapshot still configured the same way" without ever printing
 * a value.
 */
export function configDigest(config: ResolvedSnapshotConfig): string {
  const material = {
    maxPartBytes: config.maxPartBytes,
    // The user's own unit. `maxPartBytes` above already reflects the converted ceiling, but
    // recording the token number means changing 32k to 64k moves the digest even in the
    // corner where both round to the same byte budget.
    maxPartTokens: config.maxPartTokens ?? null,
    // A changed-files scope decides which files are in the snapshot at all, so a snapshot
    // taken over a different scope is a different snapshot.
    changedSince: config.changedSince ?? null,
    staged: config.staged === true,
    withDependents: config.withDependents === true,
    // Signature compression changes the emitted bytes of every TypeScript file it touches.
    skeleton: config.skeleton === true,
    // `sarif` is not one of `artifacts`: it writes `reports/audit.sarif` beside the audit, and
    // leaving it out of the digest meant a snapshot taken without it and one taken with it
    // compared equal even though their directories differ.
    sarif: config.sarif === true,
    largeFileBytes: config.largeFileBytes,
    previewHeadLines: config.previewHeadLines,
    previewTailLines: config.previewTailLines,
    includeMonolith: config.includeMonolith,
    maxMonolithBytes: config.maxMonolithBytes ?? null,
    includeSensitiveFiles: config.includeSensitiveFiles,
    // Only when the experimental mode is on: `null` is the off switch, and writing it into the
    // material would change the digest of every snapshot taken before the setting existed.
    ...(config.maxParts === null ? {} : { maxParts: config.maxParts }),
    // The default value is omitted for the same reason: a snapshot taken before the setting
    // existed kept the audit job, so it must keep the digest it was written with.
    ...(config.promptTask === "audit" ? {} : { promptTask: config.promptTask }),
    // The owner brief is instruction, not payload, but it changes what the snapshot tells a
    // reader to do, so a changed brief is drift exactly like a changed budget.
    ...(config.brief === undefined ? {} : { brief: config.brief.digest }),
    artifacts: config.artifacts,
    include: config.include,
    excludePatterns: config.excludePatterns,
    preset: config.preset,
    layersMode: config.layersMode,
    // `budgets.byLayer` is a plain object, and `JSON.stringify` preserves insertion order — so
    // `{ docs, api }` and `{ api, docs }` hashed differently despite being the same settings, and
    // `validate` reported configuration drift for a snapshot nobody had changed. The keys are
    // canonicalised here; nothing else about the object is order-dependent.
    budgets: {
      default: config.budgets.default,
      byLayer: Object.fromEntries(
        Object.entries(config.budgets.byLayer).sort(([left], [right]) =>
          left < right ? -1 : left > right ? 1 : 0
        )
      ),
    },
    // The matcher is what makes a layer a layer. Hashing only the names meant that
    // moving `{ name: "api", match: "src/api/**" }` to `"src/v2/**"` produced the same
    // digest, so `validate` reported "valid and up to date" for a snapshot whose files
    // had all been reclassified — and per-layer budgets applied to different files.
    // A function matcher's `String()` is its source, not its closure: two functions with the same
    // body but different captured values digest identically. That cannot be fixed by hashing, so
    // the digest records that executable matchers are present and `validate` says the digest does
    // not cover their closure, instead of claiming a equality it cannot prove.
    executableMatchers: [...config.layers, ...config.kinds].some(
      (rule) => typeof rule.match === "function"
    ),
    layers: config.layers.map((layer) => ({ name: layer.name, match: String(layer.match) })),
    kinds: config.kinds.map((kind) => ({ kind: kind.kind, match: String(kind.match) })),
    // How files are enumerated decides what is in the snapshot at all.
    discovery: config.discovery ?? "auto",
    // `flags` and `valueGroup` change *what is masked*, and a rule's source alone does
    // not imply either: the same source with and without `i` redacts different lines.
    secretRules: config.secretRules
      .map(
        (rule) =>
          `${rule.rule}:${rule.pattern.source}/${rule.pattern.flags}:${rule.valueGroup ?? ""}`
      )
      .sort(),
  };
  return createHash("sha256").update(JSON.stringify(material)).digest("hex");
}
</file>

<file path="tests/brief.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

/**
 * The owner-written half of the brief. Facts are generated; judgement is supplied. These tests
 * pin the merge: recognised sections replace the generic prose, unknown headings are kept, and a
 * heading that redefines a *measured* section is refused rather than allowed to overwrite it.
 */

const OWNER_BRIEF = [
  "# Project brief",
  "",
  "## Stakes",
  "",
  "Runs live production for one person. A wrong cleanup deletes their data.",
  "",
  "## The system",
  "",
  "A Fastify agent and a root broker, split by an unix socket.",
  "",
  "## What came before",
  "",
  "Four rounds, twenty-three defects, all fixed and tested.",
  "",
  "## The bar",
  "",
  "A finding quotes the lines and the state that reaches them.",
  "",
  "## Calibration",
  "",
  "- a grant signed for one recipe executing another",
  "- a recipe that never worked because its fixture lied",
  "",
  "## Deployment notes",
  "",
  "systemd unit names matter; they are not in the snapshot.",
  ""
].join("\n");

function tempDir(t, prefix = "snap-brief-") {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function makeRepo(t, files = {}) {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(
    path.join(dir, "package.json"),
    JSON.stringify({ name: "fixture", version: "1.0.0", description: "A fixture for the brief." }),
    "utf8"
  );
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n", "utf8");
  for (const [rel, content] of Object.entries(files)) {
    const target = path.join(dir, rel);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  }
  return dir;
}

const cli = (args, cwd) => {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, out: `${result.stdout ?? ""}${result.stderr ?? ""}` };
};

const promptOf = (dir) => fs.readFileSync(path.join(dir, "snapshot", "PROMPT.md"), "utf8");

test("a brief replaces the judgement sections and is marked as the owner", (t) => {
  const dir = makeRepo(t, { "brief.md": OWNER_BRIEF });
  const result = cli(["generate", "--brief", "brief.md"], dir);
  assert.equal(result.code, 0, result.out);
  const prompt = promptOf(dir);

  assert.match(prompt, /Runs live production for one person/, "stakes are present");
  assert.match(prompt, /A Fastify agent and a root broker/, "the owner system text is present");
  assert.match(prompt, /Four rounds, twenty-three defects/, "the owner history is present");
  assert.match(prompt, /A finding quotes the lines and the state that reaches them/, "the owner bar");
  assert.match(prompt, /a grant signed for one recipe executing another/, "the owner calibration");
  assert.match(prompt, /Written by the project owner in `brief\.md`, not generated/, "provenance");
  assert.match(prompt, /What the index records:/, "the generated map survives the owner text");
  assert.match(prompt, /Deployment notes/, "an unknown heading is kept");
  assert.match(prompt, /systemd unit names matter/, "with its body");
});

test("a heading that would redefine a measured section is refused", (t) => {
  const dir = makeRepo(t, { "brief.md": "## Coverage\n\nEverything was fine.\n" });
  const result = cli(["generate", "--brief", "brief.md"], dir);
  assert.notEqual(result.code, 0, "must fail");
  assert.match(result.out, /may not define "Coverage"/, "names the heading");
  assert.equal(fs.existsSync(path.join(dir, "snapshot")), false, "and writes nothing");
});

test("a missing brief is an error, not a snapshot without it", (t) => {
  const dir = makeRepo(t);
  const result = cli(["generate", "--brief", "nope.md"], dir);
  assert.notEqual(result.code, 0);
  assert.match(result.out, /nope\.md/);
  assert.match(result.out, /could not be read/);
});

test("editing the brief makes the snapshot drift", (t) => {
  const dir = makeRepo(t, { "brief.md": OWNER_BRIEF });
  assert.equal(cli(["generate", "--brief", "brief.md"], dir).code, 0);
  assert.equal(cli(["validate", "--brief", "brief.md"], dir).code, 0, "current as generated");

  fs.appendFileSync(path.join(dir, "brief.md"), "\nOne more line.\n");
  const validated = cli(["validate", "--brief", "brief.md"], dir);
  assert.equal(validated.code, 1, "a changed brief is configuration drift");
  assert.match(
    validated.out,
    /brief: brief\.md changed since this snapshot was generated/,
    "and the drift names the file rather than a digest"
  );
});

test("promptTask selects the job, and an unknown one is a usage error", (t) => {
  const review = makeRepo(t);
  assert.equal(cli(["generate", "--prompt-task", "review"], review).code, 0);
  assert.match(promptOf(review), /Review the change or the area named in the task/);

  const explain = makeRepo(t);
  assert.equal(cli(["generate", "--prompt-task", "explain"], explain).code, 0);
  assert.match(promptOf(explain), /Explain how the part of the system named in the task works/);

  const bad = makeRepo(t);
  const result = cli(["generate", "--prompt-task", "polish"], bad);
  assert.equal(result.code, 2, "usage error");
  assert.match(result.out, /--prompt-task expects audit, review or explain/);
});

test("the project states what it is, from package.json", (t) => {
  const dir = makeRepo(t);
  assert.equal(cli(["generate"], dir).code, 0);
  const prompt = promptOf(dir);
  assert.match(prompt, /## What this is/);
  assert.match(prompt, /A fixture for the brief\./);
});

test("a commit body reaches the history section", (t) => {
  const dir = makeRepo(t);
  const git = (args) => spawnSync("git", args, { cwd: dir, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) {
    t.skip("git is not available");
    return;
  }
  git(["add", "-A"]);
  const committed = spawnSync(
    "git",
    [
      "-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q",
      "-m", "fix: close the timer path",
      "-m", "The guard existed on the route and the timer never called it.",
    ],
    { cwd: dir, encoding: "utf8" }
  );
  assert.equal(committed.status, 0, committed.stderr);

  assert.equal(cli(["generate"], dir).code, 0);
  const prompt = promptOf(dir);
  assert.match(prompt, /fix: close the timer path/);
  assert.match(prompt, /The guard existed on the route and the timer never called it\./, "the body is kept");
});

test("a brief is parsed case-insensitively and refuses duplicates", (t) => {
  const lower = makeRepo(t, { "brief.md": "## stakes\n\nLower-case heading, still the stakes.\n" });
  assert.equal(cli(["generate", "--brief", "brief.md"], lower).code, 0);
  assert.match(promptOf(lower), /Lower-case heading, still the stakes\./);

  const smuggled = makeRepo(t, { "brief.md": "## coverage\n\nEverything was fine.\n" });
  const refused = cli(["generate", "--brief", "brief.md"], smuggled);
  assert.notEqual(refused.code, 0, "a lower-case reserved heading is still reserved");
  assert.match(refused.out, /may not define/);

  const twice = makeRepo(t, { "brief.md": "## Stakes\n\nOne.\n\n## Stakes\n\nTwo.\n" });
  const duplicate = cli(["generate", "--brief", "brief.md"], twice);
  assert.notEqual(duplicate.code, 0, "a section that says two things is ambiguous");
  assert.match(duplicate.out, /defines "Stakes" twice/);
});

test("a byte-order mark does not swallow the first brief section", (t) => {
  const dir = makeRepo(t, { "brief.md": "\uFEFF## Stakes\n\nStakes behind a BOM.\n" });
  assert.equal(cli(["generate", "--brief", "brief.md"], dir).code, 0);
  assert.match(promptOf(dir), /Stakes behind a BOM\./);
});

test("a CRLF brief reads the same as an LF one", (t) => {
  const dir = makeRepo(t, { "brief.md": "## Stakes\r\n\r\nWindows line endings.\r\n" });
  assert.equal(cli(["generate", "--brief", "brief.md"], dir).code, 0);
  assert.match(promptOf(dir), /Windows line endings\./);
});

test("the brief can come from the config file rather than the flag", (t) => {
  const dir = makeRepo(t, {
    "brief.md": "## Stakes\n\nFrom the config.\n",
    "snapshot.config.mjs": 'export default { brief: "brief.md", promptTask: "explain" };\n',
  });
  const result = cli(["generate"], dir);
  assert.equal(result.code, 0, result.out);
  const prompt = promptOf(dir);
  assert.match(prompt, /From the config\./);
  assert.match(prompt, /Explain how the part of the system/);
});

test("an empty brief is allowed and changes nothing but the digest", (t) => {
  const dir = makeRepo(t, { "brief.md": "# Nothing recognised here\n" });
  assert.equal(cli(["generate", "--brief", "brief.md"], dir).code, 0);
  const manifest = JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));
  assert.equal(manifest.config.brief.path, "brief.md", "the path is recorded");
  assert.equal(manifest.config.brief.digest.length, 64, "and its digest");
  assert.match(promptOf(dir), /## The job/, "the brief still renders");
});

test("the project summary carries no HTML from the README", (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(
    path.join(dir, "README.md"),
    "<div>\n  <h1>Demo</h1>\n\n  <p><b>Bold.</b><br> A <code>command</code> that fails when the code moves.</p>\n</div>\n",
    "utf8"
  );
  assert.equal(cli(["generate"], dir).code, 0);
  const prompt = promptOf(dir);
  assert.match(prompt, /A command that fails when the code moves/, "the prose survives");
  assert.doesNotMatch(prompt, /<code>|<br>/, "no inline markup reaches the brief");
  assert.equal(prompt.includes("</p>"), false, "and no closing tag either");
});

test("only version headings count as releases", (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(
    path.join(dir, "CHANGELOG.md"),
    "# Changelog\n\n## A note on version numbers\n\nText.\n\n## 1.2.0\n\nFixed.\n\n## 0.9.0\n\nOlder.\n",
    "utf8"
  );
  assert.equal(cli(["generate"], dir).code, 0);
  const prompt = promptOf(dir);
  assert.match(prompt, /Most recent releases: 1\.2\.0; 0\.9\.0\./, "the versions are quoted");
  assert.doesNotMatch(prompt, /A note on version numbers/, "a prose heading is not a release");
});

test("a commit body is cut at a sentence, not mid-word", (t) => {
  const dir = makeRepo(t);
  const git = (args) => spawnSync("git", args, { cwd: dir, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) {
    t.skip("git is not available");
    return;
  }
  const long = "The guard existed on the route. ".repeat(40);
  git(["add", "-A"]);
  const committed = spawnSync(
    "git",
    ["-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q", "-m", "fix: a long body", "-m", long],
    { cwd: dir, encoding: "utf8" }
  );
  assert.equal(committed.status, 0, committed.stderr);
  assert.equal(cli(["generate"], dir).code, 0);
  const body = promptOf(dir).split("\n").find((line) => line.startsWith("  The guard existed"));
  assert.ok(body, "the body is present");
  assert.match(body, /The guard existed on the route\.$/, "cut on a sentence boundary");
  assert.doesNotMatch(body, /bui…|\w…$/, "and never mid-word");
});

test("a fenced sample heading is not parsed as a section", (t) => {
  const dir = makeRepo(t, {
    "brief.md": [
      "## Stakes",
      "",
      "The block below shows the format; it is not a section.",
      "",
      "```markdown",
      "## Coverage",
      "This line is a sample.",
      "```",
      "",
      "That is all.",
      "",
    ].join("\n"),
  });
  const result = cli(["generate", "--brief", "brief.md"], dir);
  assert.equal(result.code, 0, "a fenced heading is content, not a reservation violation");
  const prompt = promptOf(dir);
  assert.match(prompt, /This line is a sample\./, "the fence travels with the section");
});

test("control characters in owner prose are escaped", (t) => {
  const dir = makeRepo(t, { "brief.md": "## Stakes\n\nBefore\u0000after the NUL.\n" });
  const result = cli(["generate", "--brief", "brief.md"], dir);
  assert.equal(result.code, 0, result.out);
  const prompt = promptOf(dir);
  assert.equal(prompt.includes("\u0000"), false, "no raw NUL reaches the artifact");
  assert.match(prompt, /Before\\u0000after the NUL\./, "it is re-spelled instead");
});

test("a heading typo with a trailing colon still lands in its section", (t) => {
  const dir = makeRepo(t, { "brief.md": "## Stakes:\n\nWith a trailing colon.\n" });
  assert.equal(cli(["generate", "--brief", "brief.md"], dir).code, 0);
  const prompt = promptOf(dir);
  assert.match(prompt, /## Stakes\n/, "rendered as the stakes section");
  assert.match(prompt, /With a trailing colon\./);
  assert.doesNotMatch(prompt, /### Stakes:/, "not dumped into owner notes");
});

test("an oversized brief is refused with its size", (t) => {
  const dir = makeRepo(t, { "brief.md": "## Stakes\n\n" + "word ".repeat(20000) + "\n" });
  const result = cli(["generate", "--brief", "brief.md"], dir);
  assert.notEqual(result.code, 0, "must fail");
  assert.match(result.out, /the limit is 65536/, "names the limit");
  assert.equal(fs.existsSync(path.join(dir, "snapshot")), false, "and writes nothing");
});

test("a manifest whose new config fields have the wrong shape is refused", (t) => {
  const dir = makeRepo(t);
  assert.equal(cli(["generate"], dir).code, 0);
  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const original = JSON.parse(fs.readFileSync(manifestPath, "utf8"));

  const cases = [
    [{ ...original, config: { ...original.config, promptTask: 5 } }, /promptTask/],
    [{ ...original, config: { ...original.config, brief: "docs/brief.md" } }, /config\.brief/],
    [{ ...original, config: { ...original.config, brief: { path: "", digest: "x" } } }, /brief\.path/],
    [{ ...original, config: { ...original.config, attachmentSlots: -1 } }, /attachmentSlots/],
    [{ ...original, config: { ...original.config, maxParts: 0 } }, /maxParts/],
  ];
  for (const [tampered, expected] of cases) {
    fs.writeFileSync(manifestPath, JSON.stringify(tampered));
    const result = cli(["validate"], dir);
    assert.equal(result.code, 1, "a malformed config field is refused");
    assert.match(result.out, expected, "and the message names the field");
  }
});

test("a credential-shaped brief path is masked like every other name", (t) => {
  const dir = makeRepo(t);
  fs.mkdirSync(path.join(dir, "docs", "AKIAIOSFODNN7EXAMPLE"), { recursive: true });
  fs.writeFileSync(
    path.join(dir, "docs", "AKIAIOSFODNN7EXAMPLE", "brief.md"),
    "## Stakes\n\nPath carries a credential shape.\n",
    "utf8"
  );
  const briefPath = path.join("docs", "AKIAIOSFODNN7EXAMPLE", "brief.md");
  const result = cli(["generate", "--brief", briefPath], dir);
  assert.equal(result.code, 0, result.out);

  const prompt = promptOf(dir);
  assert.equal(prompt.includes("AKIAIOSFODNN7EXAMPLE"), false, "PROMPT.md masks the path");
  const manifest = fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8");
  assert.equal(manifest.includes("AKIAIOSFODNN7EXAMPLE"), false, "the manifest masks it too");
});

test("init writes a brief scaffold and points the config at it", (t) => {
  const dir = makeRepo(t);
  const result = cli(["init", "--yes"], dir);
  assert.equal(result.code, 0, result.out);
  assert.match(result.out, /Wrote BRIEF\.md/);

  const scaffold = fs.readFileSync(path.join(dir, "BRIEF.md"), "utf8");
  assert.match(scaffold, /## Stakes/, "the headings are there");
  assert.match(scaffold, /<!--/, "and the guidance is comments");

  const config = fs.readdirSync(dir).find((name) => name.startsWith("snapshot.config."));
  assert.ok(config, "a config was written");
  // Commented, not enabled: a config pointing at a scaffold the user may delete would turn
  // "delete the template" into "generate now fails".
  assert.match(fs.readFileSync(path.join(dir, config), "utf8"), /\/\/ brief: "docs\/brief\.md"/);

  // An untouched scaffold renders no owner section: comments are guidance, not assertions.
  const generated = cli(["generate"], dir);
  assert.equal(generated.code, 0, generated.out);
  const prompt = promptOf(dir);
  assert.doesNotMatch(prompt, /## Stakes/);
  assert.doesNotMatch(prompt, /Written by the project owner/);
});

test("init never overwrites a brief the repository already has", (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(path.join(dir, "BRIEF.md"), "## Stakes\n\nOur own words.\n", "utf8");
  const result = cli(["init", "--yes"], dir);
  assert.equal(result.code, 0, result.out);
  assert.match(result.out, /Kept BRIEF\.md/);
  assert.match(fs.readFileSync(path.join(dir, "BRIEF.md"), "utf8"), /Our own words\./);
});

test("init --dry-run writes no brief", (t) => {
  const dir = makeRepo(t);
  const result = cli(["init", "--yes", "--dry-run"], dir);
  assert.equal(result.code, 0, result.out);
  assert.equal(fs.existsSync(path.join(dir, "BRIEF.md")), false);
});

test("a filled scaffold section is merged at its slot", (t) => {
  const dir = makeRepo(t);
  assert.equal(cli(["init", "--yes"], dir).code, 0);
  // Enabling it is one edit to the config the scaffold was written beside.
  const configName = fs.readdirSync(dir).find((name) => name.startsWith("snapshot.config."));
  const configPath = path.join(dir, configName);
  fs.writeFileSync(
    configPath,
    fs.readFileSync(configPath, "utf8").replace(/\/\/ brief: "docs\/brief\.md"/, 'brief: "BRIEF.md"')
  );
  fs.writeFileSync(
    path.join(dir, "BRIEF.md"),
    "<!-- guidance -->\n\n## Stakes\n\nA wrong cleanup deletes data.\n",
    "utf8"
  );
  assert.equal(cli(["generate"], dir).code, 0);
  assert.match(promptOf(dir), /## Stakes\n\n> Written by the project owner[\s\S]*A wrong cleanup deletes data\./);
});

test("setup writes the scaffold and says so", (t) => {
  const dir = makeRepo(t);
  const result = cli(["setup", "--yes"], dir);
  assert.equal(result.code, 0, result.out);
  assert.match(result.out, /Wrote BRIEF\.md/, "the one file the run asks the user to fill in");
  assert.equal(fs.existsSync(path.join(dir, "BRIEF.md")), true);
});

test("a brief written without parts does not claim part files", (t) => {
  const dir = makeRepo(t);
  const result = cli(["generate", "--skip-artifacts", "parts"], dir);
  assert.equal(result.code, 0, result.out);
  const prompt = promptOf(dir);

  assert.match(prompt, /No part files were written/, "it says what is missing");
  assert.match(prompt, /The code itself is not in this snapshot/, "and what that means for the reader");
  assert.doesNotMatch(prompt, /^- Parts: /m, "it does not list parts as files to open");
  assert.doesNotMatch(prompt, /- `parts\/part-NNN\.md`/, "nor describe their format");
  assert.doesNotMatch(prompt, /Paste this file first, then the parts it names/, "nor tell the reader to attach them");

  // README.md is written from the same manifest, and a count above "No parts were written"
  // contradicted the section right below it.
  const readme = fs.readFileSync(path.join(dir, "snapshot", "README.md"), "utf8");
  assert.match(readme, /\*\*Part Count:\*\* `0`/);
  assert.match(readme, /No parts were written/);
});

test("a brief written without a manifest does not point at one", (t) => {
  const dir = makeRepo(t);
  const result = cli(["generate", "--skip-artifacts", "manifest"], dir);
  assert.equal(result.code, 0, result.out);
  const prompt = promptOf(dir);
  assert.match(prompt, /no manifest was written/i, "the brief says what is missing");
  assert.doesNotMatch(prompt, /`manifest\.skipped\[\]` names each one/, "it does not send the reader to skipped[]");
  assert.doesNotMatch(prompt, /call graph in `manifest\.json`/, "nor to the call graph");
  assert.doesNotMatch(prompt, /Validation: `manifest\.validation/, "nor to a field it did not write");

  const readme = fs.readFileSync(path.join(dir, "snapshot", "README.md"), "utf8");
  assert.match(readme, /No manifest was written, so this snapshot cannot be re-checked/);
});
</file>

