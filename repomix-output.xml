/**
 * Workspace generation: one snapshot per member, plus the index that makes them one deliverable.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

const BIN = path.join(path.dirname(new URL(import.meta.url).pathname.replace(/^\//, "")), "..", "dist", "bin.js");

function makeRepo(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "workspace-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  for (const member of ["api", "web"]) {
    const dir = path.join(root, member);
    fs.mkdirSync(path.join(dir, "src"), { recursive: true });
    fs.writeFileSync(path.join(dir, "package.json"), JSON.stringify({ name: member, version: "1.0.0" }) + "\n");
    fs.writeFileSync(path.join(dir, "src", "index.ts"), "export const name = '" + member + "';\n");
  }
  return root;
}

const run = (args, cwd) => {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, out: (result.stdout ?? "") + (result.stderr ?? "") };
};

test("each member gets a snapshot and the workspace index lists them", (t) => {
  const root = makeRepo(t);
  const result = run(["generate", "--workspace", "api,web"], root);
  assert.equal(result.code, 0, result.out);

  const workspace = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "WORKSPACE.json"), "utf8"));
  assert.equal(workspace.members.length, 2);
  for (const member of workspace.members) {
    assert.match(member.fingerprint, /^[0-9a-f]{64}$/);
    assert.ok(member.files >= 2, member.name + " has files");
    assert.ok(fs.existsSync(path.join(root, "snapshot", member.name, "manifest.json")));
  }
});

test("a missing member is reported and makes the run exit 1, after the others are written", (t) => {
  const root = makeRepo(t);
  const result = run(["generate", "--workspace", "api,missing"], root);
  assert.equal(result.code, 1, result.out);
  assert.match(result.out, /Workspace member missing: missing/);
  assert.ok(fs.existsSync(path.join(root, "snapshot", "api", "manifest.json")), "the good member was written");
  const workspace = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "WORKSPACE.json"), "utf8"));
  assert.equal(workspace.members.length, 1);
});

test("--workspace refuses to combine with --delta", (t) => {
  const root = makeRepo(t);
  const result = run(["generate", "--workspace", "api", "--delta", "web"], root);
  assert.notEqual(result.code, 0);
  assert.match(result.out, /do not combine/);
});

test("a workspace records which member imports which", (t) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "workspace-links-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  for (const member of ["app", "shared"]) {
    fs.mkdirSync(path.join(root, member, "src"), { recursive: true });
    fs.writeFileSync(path.join(root, member, "package.json"), JSON.stringify({ name: member, version: "1.0.0" }) + "\n");
  }
  fs.writeFileSync(path.join(root, "shared", "src", "util.ts"), "export const util = 1;\n");
  fs.writeFileSync(
    path.join(root, "app", "src", "index.ts"),
    'import { util } from "../../shared/src/util.js";\nexport const app = util;\n'
  );

  const result = run(["generate", "--workspace", "app,shared"], root);
  assert.equal(result.code, 0, result.out);
  const workspace = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "WORKSPACE.json"), "utf8"));
  const link = workspace.links.find((entry) => entry.from === "app" && entry.to === "shared");
  assert.ok(link, "the edge is recorded");
  assert.ok(link.specifiers >= 1);
  assert.ok(link.examples.includes("src/index.ts"));
  assert.match(result.out, /app imports shared/);
});
</file>

<file path="tests/wrapping-and-create-shim.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { displayWidth, wrapLines } from "../dist/index.js";

/**
 * Two surfaces that have to work out what they were asked: the wizard's line wrapper, which has to
 * count *cells*, and the `npm create` shim, which has to parse its arguments rather than look for
 * substrings.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const CREATE_ROOT = path.join(HERE, "..", "packages", "create");
const CREATE = path.join(CREATE_ROOT, "index.mjs");

/** A UTF-16 string containing a high surrogate that is not followed by a low one, or vice versa. */
const LONE_SURROGATE = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;

test("wrapping counts display cells, not UTF-16 code units", () => {
  // `room` was in cells and `rest.slice(0, room)` in code units. For CJK text — one code unit, two
  // cells — a row came out up to twice as wide as the frame believed, so the terminal wrapped it
  // behind the renderer's back and the menu gained a duplicate header on every keypress.
  const cjk = "日本語のテキストです。".repeat(4);
  const rows = wrapLines(cjk, 10);
  for (const row of rows) {
    assert.ok(displayWidth(row) <= 10, `"${row}" is ${displayWidth(row)} cells, limit 10`);
  }
  assert.equal(rows.join(""), cjk, "wrapping is lossless");

  // A surrogate pair is two code units and two cells. `wrapLines` never goes below eight columns,
  // so an odd limit is what makes the two counts disagree: nine cells hold four emoji and half of
  // the fifth, and the old slice took exactly that half.
  const emoji = "🙂".repeat(8);
  const emojiRows = wrapLines(emoji, 9);
  for (const row of emojiRows) {
    assert.ok(displayWidth(row) <= 9, `"${row}" is ${displayWidth(row)} cells, limit 9`);
    assert.doesNotMatch(row, LONE_SURROGATE, "no row holds half a character");
  }
  assert.equal(emojiRows.join(""), emoji, "and the emoji are still there");

  // Ordinary text still breaks at spaces rather than mid-word where it can.
  const words = wrapLines("the quick brown fox jumps over the lazy dog", 12);
  for (const row of words) assert.ok(displayWidth(row) <= 12);
  assert.equal(words.join(" ").replace(/\s+/g, " "), "the quick brown fox jumps over the lazy dog");
});

test("`npm create` reads --preset=name, and refuses what it cannot parse", (t) => {
  // The shim imports the package by name, which only resolves in a published install. The copy run
  // here is therefore the *shipped* layout — a bare `packages/create/index.mjs` reaches for
  // `node_modules/codebase-snapshot`, and on a machine where that exists (a `npm link`, an earlier
  // `npm install .`) the difference is invisible; on a clean `npm ci` it is ERR_MODULE_NOT_FOUND.
  if (!fs.existsSync(path.join(CREATE_ROOT, "dist", "index.js"))) {
    t.skip("dist/ is not built; the pretest step builds it");
    return;
  }
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "create-shim-"));
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.mkdirSync(path.join(root, "src"), { recursive: true });
  fs.writeFileSync(path.join(root, "src", "a.ts"), "export const a = 1;\n");
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));

  const nodeModules = path.join(root, "node_modules");
  fs.mkdirSync(nodeModules, { recursive: true });
  try {
    fs.symlinkSync(
      CREATE_ROOT,
      path.join(nodeModules, "codebase-snapshot"),
      process.platform === "win32" ? "junction" : "dir"
    );
  } catch {
    t.skip("this host cannot create directory links");
    return;
  }
  const shimPath = path.join(root, "create-shim.mjs");
  fs.copyFileSync(CREATE, shimPath);

  const shim = (args) => {
    const result = spawnSync(process.execPath, [shimPath, ...args], {
      cwd: root,
      encoding: "utf8",
    });
    if (result.error) throw result.error;
    return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
  };

  // `--preset=nextjs` is the form `npm create x -- --preset=nextjs` produces. The old parser used
  // `argv.indexOf("--preset")`, found nothing, and auto-detected a preset instead.
  const equalsForm = shim(["--preset=nextjs", "--yes"]);
  assert.equal(equalsForm.code, 0, equalsForm.stderr);
  assert.match(equalsForm.stderr, /preset: nextjs/, "the named preset is the one that was used");

  // A named preset and a space take the same path.
  const spaceForm = shim(["--preset", "nextjs", "--yes", "--force"]);
  assert.equal(spaceForm.code, 0, spaceForm.stderr);
  assert.match(spaceForm.stderr, /preset: nextjs/);

  // No value at all is a usage error: `takeValue` returned undefined and auto-detection ran.
  const missingValue = shim(["--preset", "--yes"]);
  assert.equal(missingValue.code, 2, `a missing value is a usage error: ${missingValue.stderr}`);
  assert.match(missingValue.stderr, /preset/);

  // An empty value is not "no preset" either.
  const emptyValue = shim(["--preset=", "--yes"]);
  assert.equal(emptyValue.code, 2);
  assert.match(emptyValue.stderr, /empty string/);

  // An unknown flag is the command-line form of a silent fallback: `--forse` looked like it forced
  // the overwrite and forced nothing.
  const unknown = shim(["--forse", "--yes"]);
  assert.equal(unknown.code, 2, `an unknown flag is a usage error: ${unknown.stderr}`);
  assert.match(unknown.stderr, /forse/);

  // `--help` still works, and still writes to stderr so a pipe stays clean.
  const help = shim(["--help"]);
  assert.equal(help.code, 0);
  assert.match(help.stderr, /--preset <name>/);
  assert.equal(help.stdout, "");
});
</file>

<file path=".gitguardian.yaml">
# ggshield configuration (the GitGuardian CLI/CI scanner).
#
# The v2 schema uses snake_case keys. The previous version of this file used
# kebab-case ("ignored-paths"), which is not part of the schema and therefore had no
# effect - the exclusions below are the ones that actually apply.
#
# The GitGuardian *dashboard* does not read this file: its exclusions live in workspace
# settings (Secrets detection -> Filepath exclusions) and are applied retroactively to
# existing incidents. SECURITY.md lists the shapes, the reasoning, the residual risk and
# the known synthetic example values; keep the two lists in step.
#
# This repository is a secret-redaction engine, so its fixtures, rule definitions and
# documentation hold synthetic credentials on purpose. They are the vectors the engine
# detects, not credentials.
#
# The exclusions are deliberately narrow. `docs/**`, `**/*.md` and `llms.txt` used to be
# ignored wholesale, which put every published page and the README outside the detector:
# a real token pasted into a doc would have gone unreported. Only files that are synthetic
# by construction are excluded now. Alerts on the documented example values
# (`hunter2`, `AKIAIOSFODNN7EXAMPLE`, `replace-me-…`) are reviewed and allowlisted in the
# dashboard; they are described in SECURITY.md.
version: 2
secret:
  ignored_paths:
    # Test suites: the engine's own vectors, inline in the tests that exercise them.
    - "**/tests/**"
    # The verification reports quote the probes they describe, including the synthetic values.
    - "**/audit/**"
    - "**/package-lock.json"
    # Rule definitions and their worked examples: patterns, not credentials.
    - "**/src/security/patterns.ts"
    - "**/src/security/redact.ts"
</file>

<file path="CONTRIBUTING.md">
# Contributing

Thanks for taking a look. This document covers the parts that are not obvious from the code.

## Getting set up

```bash
git clone https://github.com/ankurhalder/codebase-snapshot.git
cd codebase-snapshot
npm install
npm run check      # lint + typecheck + tests
npm run build
```

Node 18 or newer. There is no database, no service, and no build step beyond `tsup`.

## Before opening a pull request

```bash
npm run check      # lint, tsc --noEmit, node --test
```

```bash
npm run verify     # the above, plus a check of the tarball that would be published
```

Verification is local, deliberately, and `npm run verify` is the same command every workflow
runs. GitHub Actions does more than publish: `pr.yml` verifies pull requests, `publish.yml`
verifies and uploads on a tag, `pages.yml` builds the docs site, `seo-rank.yml` measures search
visibility weekly, and `deprecate.yml`/`unpublish.yml` are manual release operations. None of
them adds a check `verify` does not run, so there is no matrix to wait for, and nothing a pull
request can fail that you could not have caught on your own machine.

## Test headers and the version line

Some test files carry headers like "4.0.9 regression cover". Those numbers belong to the
**retired** `@ankurhalder/codebase-snapshot` line, which reached 4.4.1; the package was renamed
and restarted at 0.9.0, so `4.x` is *older* than `0.9.x` (see the note at the top of
`CHANGELOG.md`). A header names the audit that produced the fix, not the release it shipped in:
those fixes were carried into the 0.9.x line as a batch, so the only way to date one is to find
the behaviour in `audit/reports/`.

## What makes a good change here

**Narrow and tested.** A fix with a regression test beats a refactor without one. If you change
behaviour, the test that would have caught the old behaviour should now exist.

**No silent fallbacks.** This project treats "did what you asked, sort of" as a bug. An unknown
preset, an unparseable config, an invalid budget, an unrecognised flag — all of them are hard
errors with a message that says what to do. If you find a place where a setting is accepted and
then ignored, that is a defect worth reporting.

**Never destroy user data.** The output directory is replaced atomically, and only when a
previous run wrote it — proved by the `.codebase-snapshot` marker's JSON payload, never by a
filename and never by a manifest alone. Never weaken that guard to make a case work.

**Never leak secrets.** Credential-bearing files stay out unless the user explicitly asks, and
redaction masks only the matched span. No excerpt of a matched line may reach an artifact.

**Keep the zero-dependency property.** The only runtime dependency is `typescript`, because AST
quality is the point of the tool. Anything else should be a dev dependency.

## Good places to start

- A language profile that is missing or too shallow (`src/ast/profiles/`).
- A project shape that is detected as `generic` but could be recognised
  (`src/presets/`), including its ecosystem ignore patterns.
- A message in [docs/troubleshooting.md](docs/troubleshooting.md) that did not help you.
- A false positive or false negative in secret detection.

## Reporting a bug

Open an issue with the reproduction template filled in. The most useful thing you can include:

```bash
npx codebase-snapshot describe --format json > contract.json
npx codebase-snapshot generate --dry-run --format json > dry-run.json
```

`--dry-run` computes a full snapshot without writing anything, so it is safe on a private
repository. Redact what you need to before pasting.

## Documentation

Documentation lives in `docs/` and ships inside the npm package. If you change behaviour,
update the matching document in the same pull request — `docs/cli.md` for commands and options,
`docs/configuration.md` for settings, `docs/output.md` for the manifest schema.

The agent contract (`codebase-snapshot describe`) is generated from code and its defaults are
asserted against a real dry run, so changing a default without updating the contract fails the
build.

## Commit and PR style

- Commits: `type: summary` — `feat`, `fix`, `docs`, `ci`, `chore` — with a body that explains
  the *why* and what you verified. Breaking changes get a `!`.
- Keep the PR description focused on behaviour and verification; screenshots are appreciated for
  anything visual.

