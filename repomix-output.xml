<file path="tests/init-next-step.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

/**
 * `init` ends by telling the user what to run next. That line has to be executable exactly
 * as printed: it used to say `npm run snapshot` in a directory with no package.json, and
 * then, after a re-run, a bare `codebase-snapshot generate` — a package
 * specifier, not a command.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeDir(t, files) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "init-next-"));
  for (const [name, content] of Object.entries(files)) {
    fs.writeFileSync(path.join(dir, name), content);
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

/** `init` writes its progress to stderr, so that is where the hint lives. */
function runInit(dir, extraArgs = []) {
  const result = spawnSync(
    process.execPath,
    [BIN, "init", "--cwd", dir, "--yes", ...extraArgs],
    { encoding: "utf8" }
  );
  assert.equal(result.status, 0, result.stderr);
  return result.stderr;
}

test("no package.json: the hint is a command that exists", (t) => {
  const dir = makeDir(t, { "main.go": "package main\nfunc main() {}\n" });
  const stderr = runInit(dir);
  assert.match(stderr, /Next:\s+npx codebase-snapshot generate/);
  assert.doesNotMatch(stderr, /Next:\s+npm run snapshot/, "npm run needs a package.json");
});

test("scripts written but dependencies not installed: the hint installs first", (t) => {
  const dir = makeDir(t, { "package.json": '{"name":"fixture","version":"1.0.0","type":"module"}\n' });
  const stderr = runInit(dir);
  assert.match(stderr, /Added npm scripts: snapshot, snapshot:validate/);
  assert.match(stderr, /Next:\s+npm install && npm run snapshot/);
});

test("a re-run over a configured project does not print a bare package name", (t) => {
  const dir = makeDir(t, { "package.json": '{"name":"fixture","version":"1.0.0","type":"module"}\n' });
  runInit(dir);
  const stderr = runInit(dir, ["--force"]);

  assert.doesNotMatch(
    stderr,
    /Next:\s+codebase-snapshot generate/,
    "a bare package name is not a runnable command"
  );
  assert.match(
    stderr,
    /Next:\s+(npx codebase-snapshot generate|npm install && npm run snapshot)/
  );
});

test("an installed project is told the plain script", (t) => {
  const dir = makeDir(t, { "package.json": '{"name":"fixture","version":"1.0.0","type":"module"}\n' });
  runInit(dir);
  fs.mkdirSync(path.join(dir, "node_modules", ".bin"), { recursive: true });
  fs.writeFileSync(path.join(dir, "node_modules", ".bin", "codebase-snapshot"), "", "utf8");

  const stderr = runInit(dir, ["--force"]);
  assert.match(stderr, /Next:\s+npm run snapshot/);
});
</file>

<file path="tests/language-profiles.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import { LANGUAGE_PROFILES, profileForPath, summarizeWithProfile } from "../dist/index.js";

/**
 * Language coverage, from the 0.9.9 audit.
 *
 * `src/scanner/language.ts` already knew `.sql`, `.graphql`, `.proto` and `.tf` by name, but
 * no profile claimed them — so a repository in one of those languages got a manifest with no
 * structure at all: an agent saw a list of files and no idea what was in them. Swift and Dart
 * were not even recognised as languages. These tests pin that each new profile runs, that its
 * output is a real outline rather than a list of every line, and that the summary is
 * deterministic.
 */

const summarize = (path, content) => {
  const result = summarizeWithProfile(path, content);
  assert.ok(result, `${path} must be claimed by a profile`);
  return result.summary;
};

test("every profile is registered exactly once per extension", () => {
  const claimed = new Map();
  for (const profile of LANGUAGE_PROFILES) {
    for (const extension of profile.extensions) {
      assert.equal(
        claimed.get(extension),
        undefined,
        `${extension} is claimed by both ${claimed.get(extension)} and ${profile.id}`
      );
      claimed.set(extension, profile.id);
    }
  }
  for (const extension of [".swift", ".dart", ".sql", ".graphql", ".gql", ".proto", ".tf", ".tfvars"]) {
    assert.ok(claimed.has(extension), `${extension} has no profile`);
  }
});

test("Swift: modifiers, protocol versus class, and explicit visibility", () => {
  const summary = summarize(
    "App/Store.swift",
    [
      "import Foundation",
      "import Combine",
      "",
      "@objc public final class Cache: NSObject {",
      "  private var entries: [String] = []",
      "  public func load() {}",
      "}",
      "public struct Point { let x: Double }",
      "protocol Repository {",
      "  func fetch()",
      "}",
      "enum Direction { case north }",
      "internal func helper() {}",
      "public let shared = Cache()",
    ].join("\n")
  );

  assert.deepEqual(summary.imports, ["Combine", "Foundation"]);
  assert.ok(summary.classes.includes("Cache"), "an @objc public final class is a class");
  assert.ok(summary.classes.includes("Point"));
  assert.deepEqual(summary.interfaces, ["Repository"], "protocol is the interface");
  assert.deepEqual(summary.enums, ["Direction"]);
  // Only column-zero declarations are collected, the same convention every other profile
  // follows: a method indented inside a type belongs to that type, and listing every method
  // of every type is the full body, not an outline.
  assert.ok(summary.functions.includes("helper"));
  assert.ok(!summary.functions.includes("load"), "a member function is not top-level");
  // `internal` is not an export; `public`/`open` is.
  assert.ok(summary.exports.includes("Cache"));
  assert.ok(summary.exports.includes("Point"));
  assert.ok(summary.exports.includes("shared"));
  assert.ok(!summary.exports.includes("helper"), "internal declarations are not exports");
});

test("Dart: classes, mixins, the underscore privacy rule and part directives", () => {
  const summary = summarize(
    "lib/src/cache.dart",
    [
      "import 'package:flutter/material.dart';",
      "part 'cache.g.dart';",
      "",
      "abstract class Store {",
      "  Future<void> load();",
      "}",
      "class _Private {}",
      "mixin CacheMixin {}",
      "enum Mode { fast, slow }",
      "void main() {}",
      "Future<List<String>> fetchAll() async => [];",
      "const int maxEntries = 10;",
    ].join("\n")
  );

  assert.deepEqual(summary.imports, ["package:flutter/material.dart"]);
  assert.ok(summary.directives.includes("part cache.g.dart"));
  assert.ok(summary.classes.includes("Store"));
  assert.ok(summary.classes.includes("_Private"));
  assert.ok(!summary.exports.includes("_Private"), "a leading underscore is private to its library");
  assert.ok(summary.types.includes("CacheMixin"));
  assert.deepEqual(summary.enums, ["Mode"]);
  assert.ok(summary.functions.includes("main"));
  assert.ok(summary.functions.includes("fetchAll"));
  assert.ok(summary.variables.includes("maxEntries"));
});

test("SQL: created objects, case-insensitively, with schema prefixes stripped", () => {
  const summary = summarize(
    "migrations/0012_init.sql",
    [
      "-- create the accounts schema",
      "CREATE TABLE public.accounts (id uuid primary key);",
      "create table if not exists sessions (id uuid);",
      "CREATE OR REPLACE VIEW public.active_accounts AS SELECT 1;",
      "CREATE FUNCTION touch(ts timestamptz) RETURNS void AS $$ $$ LANGUAGE sql;",
      "ALTER TABLE public.accounts ADD COLUMN name text;",
    ].join("\n")
  );

  assert.deepEqual(summary.classes, ["accounts", "active_accounts", "sessions"]);
  assert.deepEqual(summary.functions, ["touch"]);
  assert.deepEqual(summary.exports, ["accounts", "active_accounts", "sessions", "touch"]);
});

test("GraphQL: types are types and operations are endpoints", () => {
  const summary = summarize(
    "schema.graphql",
    [
      "type Query {",
      "  user(id: ID!): User",
      "}",
      "interface Node { id: ID! }",
      "input UserFilter { name: String }",
      "enum Role { ADMIN USER }",
      "extend type User { role: Role }",
      "directive @auth on FIELD_DEFINITION",
    ].join("\n")
  );

  // `extend type User` names the same type the earlier `type User` would, so it lands in the
  // same bucket rather than inventing a second one.
  assert.deepEqual(summary.classes, ["Query", "User"]);
  assert.deepEqual(summary.interfaces, ["Node"]);
  assert.deepEqual(summary.types, ["UserFilter"]);
  assert.deepEqual(summary.enums, ["Role"]);
  assert.ok(summary.functions.includes("@auth"));

  const operations = summarize(
    "ops/user.graphql",
    ["query GetUser($id: ID!) {", "  user(id: $id) { id }", "}", "mutation Rename {", "  rename"]
      .join("\n")
  );
  assert.deepEqual(operations.routeHandlers, ["GetUser", "Rename"], "an operation is an endpoint");
});

test("Protobuf: messages, enums, services and rpcs", () => {
  const summary = summarize(
    "proto/user.proto",
    [
      'syntax = "proto3";',
      "package app.user.v1;",
      'import "google/protobuf/timestamp.proto";',
      "message User {",
      "  string id = 1;",
      "}",
      "enum Role { ROLE_UNSPECIFIED = 0; }",
      "service UserService {",
      "  rpc GetUser(GetUserRequest) returns (User);",
      "}",
    ].join("\n")
  );

  assert.deepEqual(summary.imports, ["google/protobuf/timestamp.proto"]);
  assert.ok(summary.directives.includes("package app.user.v1"));
  assert.deepEqual(summary.classes, ["User"]);
  assert.deepEqual(summary.enums, ["Role"]);
  assert.deepEqual(summary.interfaces, ["UserService"]);
  assert.deepEqual(summary.functions, ["GetUser"]);
});

test("Terraform: resources are named by type and name, and .tfvars is assignments", () => {
  const summary = summarize(
    "infra/main.tf",
    [
      "terraform {",
      '  required_version = ">= 1.5"',
      "}",
      'provider "aws" { region = "eu-west-1" }',
      'resource "aws_instance" "web" { ami = "ami-1" }',
      'resource "aws_instance" "worker" { ami = "ami-1" }',
      'module "network" { source = "./network" }',
      'variable "instance_count" { type = number }',
      'output "web_ip" { value = aws_instance.web.public_ip }',
    ].join("\n")
  );

  assert.deepEqual(summary.classes, ["aws_instance.web", "aws_instance.worker"]);
  assert.ok(summary.imports.includes("network"));
  assert.ok(summary.imports.includes("provider:aws"));
  assert.deepEqual(summary.variables, ["instance_count"]);
  assert.deepEqual(summary.exports, ["aws_instance.web", "aws_instance.worker", "web_ip"]);
  assert.ok(summary.directives.some((entry) => entry.startsWith("required_version")));

  const vars = summarize("infra/prod.tfvars", 'instance_count = 3\nregion = "eu-west-1"\n');
  assert.deepEqual(vars.variables, ["instance_count", "region"]);
});

test("a profile is chosen by extension, and unknown files still have none", () => {
  assert.equal(profileForPath("a/b.swift")?.id, "swift");
  assert.equal(profileForPath("a/b.dart")?.id, "dart");
  assert.equal(profileForPath("a/b.sql")?.id, "sql");
  assert.equal(profileForPath("a/b.proto")?.id, "protobuf");
  assert.equal(profileForPath("a/b.tfvars")?.id, "terraform");
  assert.equal(profileForPath("a/b.weird"), null);
});
</file>

<file path="tests/masking-and-config-honesty.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { DEFAULT_SECRET_PATTERNS, loadConfigFileDetailed, scanAndRedactSecrets } from "../dist/index.js";

/**
 * 4.1.0 regression cover for three small honesty defects found by a read-only security wave.
 *
 * A17 — masking walked left through a URL path, so `https://example.com/v1/<key>` came out as
 *       `https://example.[REDACTED]`, contradicting "only the matched span is masked".
 * B6b — `package.json#snapshot` as an array was passed to the resolver as though it were a config
 *       and then silently ignored, with no warning.
 * B9 — an unreadable `snapshot.config.json` reported a bare `EISDIR` with no filename.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-honesty-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const scan = (content) => scanAndRedactSecrets(content, DEFAULT_SECRET_PATTERNS, "fixture.ts");

test("A17: a key inside a URL is masked without swallowing the path", () => {
  // Assembled at runtime so the repository never contains a literal live-key shape.
  const key = ["AKIA", "IOSFODNN7", "EXAMPLE"].join("");
  const { redacted } = scan(`const url = "https://example.com/v1/${key}/data";\n`);

  assert.match(redacted, /https:\/\/example\.com\/v1\//, "the path survives");
  assert.doesNotMatch(redacted, /AKIA/, "the key does not");
  assert.doesNotMatch(redacted, /example\.\[REDACTED/, "the host is not part of the mask");
});

test("A17: a scheme-only host does not swallow the path either", () => {
  const key = ["AKIA", "IOSFODNN7", "EXAMPLE"].join("");
  const { redacted } = scan(`const url = "http://localhost:8080/v1/${key}";\n`);

  assert.match(redacted, /http:\/\/localhost:8080\/v1\//);
  assert.doesNotMatch(redacted, /AKIA/);
});

test("A17: base64 credentials containing a slash are still masked whole", () => {
  // A 40-character AWS secret value with a slash and a plus, assigned as a value.
  const secret = ["wJalrXUtnFEMI", "/K7MDENG", "+bPxRfiCY", "EXAMPLEKEY"].join("");
  const { redacted } = scan(`awsSecret: "${secret}"\n`);

  assert.doesNotMatch(redacted, /wJalrXUtnFEMI/, "the left half is masked too");
  assert.doesNotMatch(redacted, /EXAMPLEKEY/);
});

test("B6b: package.json#snapshot as an array is warned about, not silently ignored", async (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(
    path.join(dir, "package.json"),
    `${JSON.stringify({ name: "fixture", version: "1.0.0", snapshot: [{ maxPartBytes: 4096 }] }, null, 2)}\n`,
    "utf8"
  );

  const loaded = await loadConfigFileDetailed(dir);

  const warning = loaded.warnings.find((entry) => /"snapshot" key must be an object/.test(entry));
  assert.ok(warning, `an array must be reported: ${JSON.stringify(loaded.warnings)}`);
  assert.match(warning, /array/, "the warning names the type it saw");
  assert.equal(loaded.config, null, "and the array is not used as a config");
});

test("B9: an unreadable config file names itself in the error", async (t) => {
  const dir = tempDir(t);
  // A directory where the config file should be: readable as a path, unreadable as a file.
  fs.mkdirSync(path.join(dir, "snapshot.config.json"), { recursive: true });

  const loaded = await loadConfigFileDetailed(dir);
  const message = [...loaded.warnings, ...loaded.errors].join("\n");

  assert.match(message, /snapshot\.config\.json/, "the failing file is named");
  assert.match(message, /EISDIR|directory|read/i, "and the reason is kept");
});
</file>

<file path="tests/mcp-edges.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { PassThrough } from "node:stream";
import test from "node:test";

import { MAX_LINE_BYTES, buildTools, createLineReader } from "../dist/mcp.js";

/**
 * MCP edge cases from the 0.9.10 audit.
 *
 * The line cap and the read window both decide whether an agent gets an answer or a plausible
 * wrong one, and both were wrong at the edges: an oversized line that arrived complete with its
 * terminator skipped the overflow guard entirely, and a read past the end of a file returned a
 * different line than the one that was asked for.
 */

function reader() {
  const input = new PassThrough();
  const lines = [];
  const overflows = [];
  const stop = createLineReader(input, {
    onLine: (line) => lines.push(line),
    onOverflow: (bytes) => overflows.push(bytes),
  });
  return { input, lines, overflows, stop };
}

test("a normal message is delivered", () => {
  const { input, lines } = reader();
  input.write('{"jsonrpc":"2.0","id":1}\n');
  assert.deepEqual(lines, ['{"jsonrpc":"2.0","id":1}']);
});

test("an oversized line is refused even when it arrives with its newline", () => {
  const { input, lines, overflows } = reader();
  // 32 MB + 1, terminated in the same chunk. The guard used to require that the buffer held no
  // `\n` at all, so this — the exact case the cap exists for — went through to `JSON.parse`.
  input.write("x".repeat(MAX_LINE_BYTES + 1) + "\n");

  assert.deepEqual(lines, [], "the oversized line is not delivered");
  assert.equal(overflows.length, 1, "and the caller is told why");
  assert.ok(overflows[0] > MAX_LINE_BYTES);
});

test("an oversized line split across chunks is still refused", () => {
  const { input, lines, overflows } = reader();
  const half = Math.floor(MAX_LINE_BYTES / 2) + 1;
  input.write("y".repeat(half));
  input.write("y".repeat(half));
  input.write("\n");

  assert.deepEqual(lines, []);
  assert.equal(overflows.length, 1);
});

test("the reader recovers after discarding an oversized line", () => {
  const { input, lines } = reader();
  input.write("z".repeat(MAX_LINE_BYTES + 1) + "\n");
  input.write('{"jsonrpc":"2.0","id":2}\n');

  assert.deepEqual(lines, ['{"jsonrpc":"2.0","id":2}'], "the next message is not lost");
});

// ---------------------------------------------------------------------------

function makeFixture(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "mcp-edges-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const contextFor = (root) => ({ cwd: root, roots: [root], log: () => {} });
const tools = new Map(buildTools().map((tool) => [tool.name, tool]));

async function call(name, args, context) {
  const tool = tools.get(name);
  assert.ok(tool, `tool ${name} exists`);
  return tool.handler(args, context);
}

test("snapshot_locate finds a declaration that is not an export, class or function", async (t) => {
  const root = makeFixture(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    // Every one of these lives in `variables`, which the tool did not search.
    "src/config.ts": "const retryLimit = 3;\nconst timeoutMs = 5000;\n",
    "src/App.tsx": "export default function App() {\n  return <div />;\n}\n",
  });
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const result = await call("snapshot_locate", { query: "retryLimit" }, context);
  const found = JSON.stringify(result.structured ?? result.text);
  assert.match(found, /retryLimit/, "a module-level const is a symbol an agent looks for");
});

test("snapshot_locate finds a Markdown frontmatter key", async (t) => {
  const root = makeFixture(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "docs/guide.md": "---\ntitle: Guide\ntags: docs\n---\n\n# Heading\n",
  });
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const result = await call("snapshot_locate", { query: "tags" }, context);
  assert.match(
    JSON.stringify(result.structured ?? result.text),
    /guide\.md/,
    "frontmatter keys describe a document's structure as much as its headings do"
  );
});

test("snapshot_read of an empty file says it is empty", async (t) => {
  const root = makeFixture(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/empty.ts": "",
  });
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const result = await call("snapshot_read", { path: "src/empty.ts" }, context);
  const text = result.text ?? JSON.stringify(result.structured);

  assert.doesNotMatch(text, /Lines 1[–-]0 of 1/, "a zero-line window is not a line range");
  assert.match(text, /empty/i);
});

test("snapshot_read past the end of a file says so instead of returning the last line", async (t) => {
  const root = makeFixture(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/short.ts": "export const one = 1;\nexport const two = 2;\n",
  });
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const result = await call("snapshot_read", { path: "src/short.ts", fromLine: 9000 }, context);
  const text = result.text ?? JSON.stringify(result.structured);

  assert.doesNotMatch(text, /export const two = 2/, "line 2 is not line 9000");
  assert.match(text, /past its end/i);
});
</file>

<file path="tests/mcp-generate-worker.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateInWorker } from "../dist/mcp.js";

/**
 * `snapshot_generate` off the JSON-RPC thread, from the 0.9.9 audit.
 *
 * The 0.9.4 measurement is in the changelog: a synchronous generate blocks the stdio server for
 * about 7.5 seconds on a 3,000-file repository. In that window the process cannot answer `ping`
 * or acknowledge `notifications/cancelled`, and a client with a socket timeout reports a working
 * tool call as a dead server.
 *
 * A resolved config cannot cross a thread boundary — `layers[].match` may be a function and
 * `hooks.afterGenerate` always is — so the worker loads the config file and applies the same CLI
 * options the calling thread did. These tests pin both the behaviour and that division.
 */

function makeRepo(t, files = 6) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "mcp-worker-"));
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  for (let index = 0; index < files; index += 1) {
    fs.writeFileSync(
      path.join(dir, "src", `f${index}.ts`),
      `export function fn${index}(): number { return ${index}; }\n`
    );
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

test("the call does not block the event loop", async (t) => {
  const dir = makeRepo(t, 120);

  let settled = false;
  const run = generateInWorker(dir, { cwd: dir }).then((result) => {
    settled = true;
    return result;
  });

  // A timer scheduled after the call must be able to run before the generation finishes. With a
  // synchronous generate this assertion is the one that fails, which is the whole point.
  await new Promise((resolve) => setTimeout(resolve, 0));
  assert.equal(settled, false, "generate must run off the calling thread");

  const result = await run;
  assert.equal(result.ok, true, result.ok ? "" : result.message);
});

test("the summary matches the snapshot written to disk", async (t) => {
  const dir = makeRepo(t);

  const result = await generateInWorker(dir, { cwd: dir });
  assert.equal(result.ok, true, result.ok ? "" : result.message);

  const manifest = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8")
  );
  assert.equal(result.summary.fingerprint, manifest.fingerprint);
  assert.equal(result.summary.totalFiles, manifest.counts.totalFiles);
  assert.equal(result.summary.partsCount, manifest.counts.partsCount);
  assert.deepEqual(result.summary.parts, manifest.parts.map((part) => ({
    filename: part.filename,
    byteSize: part.byteSize,
  })));
});

test("the worker honours the same options the caller resolved with", async (t) => {
  const dir = makeRepo(t);

  const result = await generateInWorker(dir, { cwd: dir, outDir: "custom-out" });
  assert.equal(result.ok, true, result.ok ? "" : result.message);
  assert.ok(
    fs.existsSync(path.join(dir, "custom-out", "manifest.json")),
    "the override reached the worker's own resolveConfig"
  );
});

test("a broken config is reported, not silently regenerated with defaults", async (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(
    path.join(dir, "snapshot.config.json"),
    '{"maxPartByte": 4096}\n' // a typo: maxPartBytes
  );

  const result = await generateInWorker(dir, { cwd: dir });

  assert.equal(result.ok, false);
  assert.match(result.message, /unknown setting/);
  assert.equal(
    fs.existsSync(path.join(dir, "snapshot")),
    false,
    "nothing was written by a run that could not read its config"
  );
});

test("a failure inside generation comes back as a message, not a crash", async (t) => {
  const dir = makeRepo(t);
  // A lock file that this process does not own refuses the run; the worker must surface that
  // refusal as text rather than exiting silently.
  const tmpDir = path.join(dir, "snapshot.tmp");
  const { lockPathFor } = await import("../dist/index.js");
  fs.mkdirSync(tmpDir, { recursive: true });
  const lockPath = lockPathFor(fs.realpathSync(tmpDir));
  fs.writeFileSync(lockPath, `${JSON.stringify({ pid: process.pid })}\n`);
  t.after(() => fs.rmSync(lockPath, { force: true }));

  const result = await generateInWorker(dir, { cwd: dir });

  assert.equal(result.ok, false);
  assert.match(result.message, /already using the staging directory/);
});
</file>

<file path="tests/nested-gitignore.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { collectFiles } from "../dist/index.js";

/**
 * 4.0.9 regression cover for nested `.gitignore` files.
 *
 * Only the root `.gitignore` was ever read, so in a non-git checkout a `dist/` rule inside
 * `packages/foo/.gitignore` did nothing while git honoured it in the same repository — the same
 * tree produced two different snapshots depending on whether `.git` was readable. The walker now
 * carries every `.gitignore` it passes, and the deepest rule that matches wins, which is git's
 * precedence rule.
 */

function tempDir(t, prefix = "snap-gitignore-") {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content, "utf8");
  return target;
}

const scan = (dir) => collectFiles(dir, {});
const paths = (result) => result.files.slice().sort();

test("S4: a nested .gitignore is honoured in a non-git checkout", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "packages/foo/src/index.ts", "export const b = 2;\n");
  write(dir, "packages/foo/generated/bundle.js", "junk\n");
  write(dir, "packages/foo/.gitignore", "generated/\n");

  const result = scan(dir);

  assert.ok(paths(result).includes("packages/foo/src/index.ts"), "the source is scanned");
  assert.ok(!paths(result).includes("packages/foo/generated/bundle.js"), "the nested rule applies");
  const record = result.skipped.find((entry) => entry.path === "packages/foo/generated");
  assert.ok(record, "the omission is recorded, not silent");
  assert.equal(record.reason, "gitignore");
});

test("S4: a nested rule does not touch paths outside its directory", (t) => {
  const dir = tempDir(t);
  write(dir, "generated/keep.js", "kept\n");
  write(dir, "packages/foo/generated/drop.js", "dropped\n");
  write(dir, "packages/foo/.gitignore", "generated/\n");

  const result = scan(dir);

  assert.ok(paths(result).includes("generated/keep.js"), "the root generated/ is untouched by a nested rule");
  assert.ok(!paths(result).includes("packages/foo/generated/drop.js"));
});

test("S4: a nested negation re-includes a path the root ignored", (t) => {
  const dir = tempDir(t);
  write(dir, ".gitignore", "*.log\n");
  write(dir, "root.log", "ignored\n");
  write(dir, "packages/foo/keep.log", "kept\n");
  write(dir, "packages/foo/.gitignore", "!keep.log\n");

  const result = scan(dir);

  assert.ok(!paths(result).includes("root.log"), "the root rule still applies at the root");
  assert.ok(paths(result).includes("packages/foo/keep.log"), "the deep negation wins");
});

test("S4: a nested rule can re-ignore a path a root negation re-included", (t) => {
  const dir = tempDir(t);
  write(dir, ".gitignore", "*.log\n!important.log\n");
  write(dir, "important.log", "kept\n");
  write(dir, "packages/foo/important.log", "dropped\n");
  write(dir, "packages/foo/.gitignore", "important.log\n");

  const result = scan(dir);

  assert.ok(paths(result).includes("important.log"), "the root negation holds at the root");
  assert.ok(!paths(result).includes("packages/foo/important.log"), "the deeper ignore wins");
});

test("S4: the walking scan and the git scan now agree", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "packages/foo/src/index.ts", "export const b = 2;\n");
  write(dir, "packages/foo/generated/bundle.js", "junk\n");
  write(dir, ".gitignore", "node_modules\n");
  write(dir, "packages/foo/.gitignore", "generated/\n");

  const walking = paths(scan(dir));

  try {
    execFileSync("git", ["init", "-q"], { cwd: dir, stdio: "ignore" });
    execFileSync("git", ["add", "-A"], { cwd: dir, stdio: "ignore" });
  } catch {
    return; // git is unavailable on this host; the walker cases above already ran
  }
  const viaGit = paths(scan(dir));

  assert.deepEqual(viaGit, walking, "same repository, same candidates, either discovery mode");
});
</file>

<file path="tests/nested-repository.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot } from "../dist/index.js";

/**
 * 4.0.9 regression cover for a nested repository.
 *
 * A submodule is a single gitlink entry, so git lists a path where a file is expected and `stat`
 * answers "directory". That was recorded as the generic `not-file`, which tells the reader the
 * path is a socket or a FIFO. The contents exist and simply belong to a different repository, and
 * `skipped[]` says so now.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-nested-repo-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const git = (cwd, args) =>
  execFileSync(
    "git",
    ["-c", "user.email=test@example.com", "-c", "user.name=Test", ...args],
    { cwd, stdio: "ignore" }
  );

test("S7: a nested repository is recorded as nested-repository, not not-file", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "app.ts"), "export const a = 1;\n", "utf8");

  // A nested repository with one commit, then added to the parent: git records a gitlink.
  const nested = path.join(dir, "vendor", "lib");
  fs.mkdirSync(nested, { recursive: true });
  fs.writeFileSync(path.join(nested, "lib.ts"), "export const lib = 1;\n", "utf8");

  try {
    git(nested, ["init", "-q"]);
    git(nested, ["add", "-A"]);
    git(nested, ["commit", "-q", "-m", "nested"]);
    git(dir, ["init", "-q"]);
    git(dir, ["add", "-A"]);
  } catch {
    t.skip("git is unavailable on this host");
    return;
  }

  const manifest = generateSnapshot({ cwd: dir });

  const record = manifest.skipped.find((entry) => entry.path === "vendor/lib");
  assert.ok(record, `the gitlink is recorded, not dropped: ${JSON.stringify(manifest.skipped)}`);
  assert.equal(record.reason, "nested-repository");
  assert.match(record.detail, /another repository/);
  assert.ok(
    !manifest.files.some((file) => file.relativePath === "vendor/lib"),
    "a gitlink is not emitted as a file"
  );
});

test("S7: a plain directory is still not-file, and a nested repository is distinguished", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "app.ts"), "export const a = 1;\n", "utf8");
  // A directory that is not a repository, listed by git as a path: impossible in practice, so
  // this asserts the branch rather than a real fixture — git only lists directories as gitlinks.
  fs.mkdirSync(path.join(dir, "plain"), { recursive: true });

  try {
    git(dir, ["init", "-q"]);
    git(dir, ["add", "-A"]);
  } catch {
    t.skip("git is unavailable on this host");
    return;
  }

  const manifest = generateSnapshot({ cwd: dir });

  assert.ok(
    !manifest.skipped.some((entry) => entry.reason === "nested-repository"),
    "an empty directory is not a nested repository"
  );
});
</file>

<file path="tests/no-config-scope.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

/**
 * 4.0.9 regression cover: `--no-config` must mean "this repository's config is not executed",
 * and `diff` must never import one at all — it answers a question about two manifest files.
 *
 * The fixture config writes a file next to itself when it is imported, so "was the config
 * evaluated?" is a plain filesystem question rather than a matter of reading output text.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

const SIDE_EFFECT = "config-was-imported.txt";

/** A module config whose import is observable, and which would exclude `a.ts` if honoured. */
const OBSERVABLE_CONFIG = `
import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
fs.writeFileSync(path.join(here, ${JSON.stringify(SIDE_EFFECT)}), "yes", "utf8");

export default { excludePatterns: ["a.ts"] };
`;

function makeRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "no-config-scope-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0","type":"module"}\n');
  fs.writeFileSync(path.join(dir, "a.ts"), "export const a = 1;\n");
  fs.writeFileSync(path.join(dir, "b.ts"), "export const b = 2;\n");
  fs.writeFileSync(path.join(dir, "snapshot.config.mjs"), OBSERVABLE_CONFIG);
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function run(args) {
  return execFileSync(process.execPath, [BIN, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
}

function imported(dir) {
  return fs.existsSync(path.join(dir, SIDE_EFFECT));
}

function manifestOf(dir, outDir) {
  return JSON.parse(fs.readFileSync(path.join(dir, outDir, "manifest.json"), "utf8"));
}

test("generate imports the repository config (control)", (t) => {
  const dir = makeRepo(t);
  run(["generate", "--cwd", dir, "--out-dir", "out"]);

  assert.equal(imported(dir), true, "a normal run does evaluate the config");
  const files = manifestOf(dir, "out").files.map((file) => file.relativePath);
  assert.ok(!files.includes("a.ts"), "the config's excludePatterns is applied");
});

test("diff never imports the repository config", (t) => {
  const dir = makeRepo(t);
  run(["generate", "--cwd", dir, "--out-dir", "out"]);
  fs.rmSync(path.join(dir, SIDE_EFFECT), { force: true });

  const manifest = path.join(dir, "out", "manifest.json");
  run(["diff", manifest, manifest]);

  assert.equal(imported(dir), false, "diff read the manifests without executing repository code");
});

test("--no-config is accepted by diff instead of being a usage error", (t) => {
  const dir = makeRepo(t);
  run(["generate", "--cwd", dir, "--out-dir", "out"]);
  fs.rmSync(path.join(dir, SIDE_EFFECT), { force: true });
  const manifest = path.join(dir, "out", "manifest.json");

  // execFileSync throws on a non-zero exit, so not throwing is the assertion: before 4.0.9
  // this was a usage error (exit 2). The summary is written to stderr, so stdout is empty.
  run(["diff", manifest, manifest, "--no-config"]);
  assert.equal(imported(dir), false, "diff still did not import the config");
});

test("the contract advertises --no-config for diff", () => {
  const contract = JSON.parse(run(["describe", "--format", "json"]));
  const option = contract.options.find((entry) => entry.flag === "--no-config");
  assert.ok(option, "the contract lists --no-config");
  assert.ok(
    option.appliesTo.includes("diff"),
    `describe says --no-config applies to ${option.appliesTo}`
  );
});
</file>

<file path="tests/partitioner-budget.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, resolveConfig, validateSnapshot } from "../dist/index.js";

/**
 * Part budgets and the omission notice, from the 0.9.9 audit.
 *
 * Two defects in the same area: a body cut twice reported only the second cut's line
 * count, so a 1,000-line file that kept ten lines said "1 line omitted"; and with
 * per-layer budgets every part was verified against the *largest* budget in the run,
 * so a part twice over its own layer budget was reported as fine.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "part-budget-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

/** Every `part-NNN.md` under `dir`, with its bytes and recorded metadata. */
function readParts(dir, manifest) {
  return manifest.parts.map((part) => {
    const file = path.join(dir, "snapshot", "parts", part.filename);
    return { ...part, diskBytes: fs.statSync(file).size, markdown: fs.readFileSync(file, "utf8") };
  });
}

test("a body cut by the part budget reports the file's real omission count", async (t) => {
  const dir = tempDir(t);
  // 1,000 lines of 400 characters: far past `largeFileBytes`, so the body arrives as a
  // head/tail preview and is then cut again to fit the part budget.
  const line = "x".repeat(400);
  write(dir, "big.ts", `${Array.from({ length: 1000 }, (_, i) => `${line} // ${i}`).join("\n")}\n`);

  const config = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    largeFileBytes: "1k",
    previewHeadLines: 5,
    previewTailLines: 5,
    maxPartBytes: "4k",
  });
  const manifest = generateSnapshot(config);

  const marker = /\[(\d+) lines omitted: part budget (\d+) B\]/;
  const withMarker = manifest.parts
    .map((part) => fs.readFileSync(path.join(dir, "snapshot", "parts", part.filename), "utf8"))
    .map((text) => marker.exec(text))
    .filter(Boolean);

  assert.ok(withMarker.length > 0, "the body must be cut by the budget, or this proves nothing");
  const omitted = Number(withMarker[0][1]);
  assert.ok(
    omitted > 500,
    `the notice must describe the file, not the second cut: reported ${omitted} of 1,000 lines`
  );
});

test("per-layer budgets are recorded per part and honoured on disk", async (t) => {
  const dir = tempDir(t);
  for (const name of ["a", "b", "c", "d"]) {
    write(dir, `src/${name}.ts`, `${`export const ${name} = 1;\n`.repeat(400)}`);
  }
  write(dir, "README.md", "# fixture\n");

  const config = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    maxPartBytes: "16k",
    budgets: { default: "16k", byLayer: { src: "4k" } },
  });
  const manifest = generateSnapshot(config);
  const parts = readParts(dir, manifest);

  assert.ok(
    parts.some((part) => part.budgetBytes === 4096),
    `the src layer must use its own budget: ${parts.map((part) => part.budgetBytes).join(", ")}`
  );
  for (const part of parts) {
    assert.ok(
      part.budgetBytes <= 4096 || part.budgetBytes === 16384,
      `every part carries the budget it was built for, got ${part.budgetBytes}`
    );
    assert.ok(
      part.diskBytes <= part.budgetBytes,
      `${part.filename} is ${part.diskBytes} B against a ${part.budgetBytes} B budget`
    );
  }
  // The snapshot the generator just wrote must pass its own validator.
  const validation = validateSnapshot(config);
  assert.deepEqual(validation.drift.partIssues, [], "no part may be over its budget");
  assert.equal(validation.valid, true, JSON.stringify(validation.drift));
});
</file>

<file path="tests/report-and-manifest-guards.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const BIN = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "dist", "bin.js");
const VALID_FINGERPRINT = "a".repeat(64);

function run(args, cwd) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    cwd,
    encoding: "utf8",
    timeout: 20_000,
  });
  assert.equal(result.error, undefined);
  return { status: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cs-guards-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function writeManifest(dir, manifest) {
  const snapshot = path.join(dir, "snapshot");
  fs.mkdirSync(snapshot, { recursive: true });
  fs.writeFileSync(
    path.join(snapshot, "manifest.json"),
    typeof manifest === "string" ? manifest : `${JSON.stringify(manifest, null, 2)}\n`
  );
}

function reportManifest(overrides = {}) {
  return {
    schemaVersion: "3.0.0",
    generatedAt: "2026-01-01T00:00:00.000Z",
    fingerprint: VALID_FINGERPRINT,
    counts: { totalFiles: 0, totalLines: 0, totalSizeBytes: 0, partsCount: 0 },
    layers: {},
    files: [],
    skipped: [],
    parts: [],
    warnings: [],
    ...overrides,
  };
}

function makeRepo(t) {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"guards","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n");
  const generated = run(["generate", "--no-config", "--cwd", dir], dir);
  assert.equal(generated.status, 0, generated.stderr);
  return dir;
}

test("D-3: report rejects negative, fractional and infinite counts", (t) => {
  const dir = tempDir(t);
  const manifest = reportManifest({
    counts: { totalFiles: -5, totalLines: 1.5, totalSizeBytes: 0, partsCount: -1 },
  });
  const raw = JSON.stringify(manifest, null, 2).replace(
    '"totalSizeBytes": 0',
    '"totalSizeBytes": 1e999'
  );
  writeManifest(dir, raw);

  const result = run(["report", "--cwd", dir], dir);
  assert.equal(result.status, 1);
  assert.match(result.stderr, /is not a snapshot manifest/);
  assert.doesNotMatch(result.stderr, /Files included:/);
  assert.doesNotMatch(result.stderr, /Infinity MB/);
});

test("D-4: report rejects a wrong-shaped fingerprint", (t) => {
  const dir = tempDir(t);
  writeManifest(dir, reportManifest({ fingerprint: "12345" }));

  const result = run(["report", "--cwd", dir], dir);
  assert.equal(result.status, 1);
  assert.match(result.stderr, /is not a snapshot manifest/);
  assert.match(result.stderr, /fingerprint/);
  assert.doesNotMatch(result.stderr, /Fingerprint:\s+12345/);
});

test("D-4: validate rejects a wrong-shaped fingerprint", (t) => {
  const dir = makeRepo(t);
  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  manifest.fingerprint = "12345";
  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));

  const result = run(["validate", "--no-config", "--cwd", dir], dir);
  assert.equal(result.status, 1);
  assert.match(result.stderr, /fingerprint/);
  assert.doesNotMatch(result.stderr, /valid and up to date/);
});

test("D-5: validate does not use an outside manifest path as an existence oracle", (t) => {
  const dir = makeRepo(t);
  const outside = path.join(path.dirname(dir), `outside-${path.basename(dir)}.txt`);
  t.after(() => fs.rmSync(outside, { force: true }));
  fs.writeFileSync(outside, "outside secret\n");

  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  const file = manifest.files.find((entry) => entry.relativePath === "src/a.ts");
  assert.ok(file);
  file.relativePath = `../${path.basename(outside)}`;
  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));

  const existing = run(["validate", "--no-config", "--cwd", dir], dir);
  assert.equal(existing.status, 1);
  assert.match(existing.stderr, /resolves outside the repository and was not inspected/);
  assert.doesNotMatch(existing.stderr, /deleted:\s+\.\.\//);
  assert.doesNotMatch(existing.stderr, /new file:\s+\.\.\//);

  fs.rmSync(outside, { force: true });
  const missing = run(["validate", "--no-config", "--cwd", dir], dir);
  assert.equal(missing.status, 1);
  assert.match(missing.stderr, /resolves outside the repository and was not inspected/);
  assert.doesNotMatch(missing.stderr, /deleted:\s+\.\.\//);
  assert.doesNotMatch(missing.stderr, /new file:\s+\.\.\//);
});

test("validate still rejects hostile counts (no regression)", (t) => {
  const dir = makeRepo(t);
  const manifestPath = path.join(dir, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  manifest.counts.totalFiles = -5;
  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));

  const result = run(["validate", "--no-config", "--cwd", dir], dir);
  assert.equal(result.status, 1);
  assert.match(result.stderr, /counts|totalFiles/);
});

test("a normal generated snapshot still reports and validates", (t) => {
  const dir = makeRepo(t);

  const report = run(["report", "--cwd", dir], dir);
  assert.equal(report.status, 0, report.stderr);
  assert.match(report.stderr, /Codebase Snapshot Report/);
  assert.match(report.stderr, /Fingerprint:\s+[0-9a-f]{64}/);

  const validate = run(["validate", "--no-config", "--cwd", dir], dir);
  assert.equal(validate.status, 0, validate.stderr);
  assert.match(validate.stderr, /valid and up to date/);
});
