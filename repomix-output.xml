<file path="src/mcp/prompts.ts">
/**
 * Seven prompts: the two about order of operations (orient, keep-current) and five that turn the
 * tools into a job (audit, review, explain, onboard, security-review).
 *
 * Prompts are user-invoked, so they must be worth a keystroke: `orient` replaces the blank-page
 * turn where an agent starts guessing at file paths, and `keep-current` exists because "is this
 * still true" is the question this project exists to make answerable.
 */
import type { JsonObject } from "./protocol.js";
import type { McpPrompt } from "./types.js";

const AUDIT = `Audit this repository without changing it. Produce evidence, not impressions.

1. Call snapshot_health. Report the score, every failed check, and every warning with the artifact it names.
2. Call snapshot_validate. If it reports drift, say so and stop: an audit of a stale snapshot is an audit of nothing.
3. Call snapshot_query with layer "config" and read the files it returns with snapshot_read, one window at a time.
4. Call snapshot_explain for every path you expected to find and did not; the answer says whether it was ignored, sensitive or binary.
5. Report: what the snapshot covers, what it cannot see, and the three findings that would matter most to whoever receives this context. Cite paths and parts. Do not edit any file.`;

const REVIEW = `Review a change against the context you were given.

1. Call snapshot_validate first. If the snapshot is stale, call snapshot_generate once, then validate again.
2. Call snapshot_plan_for with the change description as the question. Read the plan in order with snapshot_read; do not read a part end to end.
3. For every file you intend to discuss, call snapshot_dependents and name what imports it. A change is a change to its dependents.
4. Report: what the change does, the files it touches, the call sites that must change with it, and the risks you can prove from the code. Mark anything you inferred rather than read.
5. Cite paths with their part. If the snapshot does not contain a file you need, say which one and why rather than guessing at its contents.`;

const EXPLAIN = `Explain one path from the snapshot.

1. Call snapshot_explain for the path. Report the inclusion mode and, when it is absent, the recorded reason.
2. If it is included, call snapshot_locate and snapshot_dependents, then snapshot_read the windows that matter.
3. Describe what the file does, who depends on it, and the two or three things a new reader would get wrong about it.
4. Quote only what the snapshot contains. If a region was omitted, say which lines and why.`;

const ONBOARD = `Produce a guided tour of this repository for a new contributor.

1. Call snapshot_status. If there is no snapshot, snapshot_generate first.
2. Call snapshot_plan_for with "entry points, request flow, and the files a new contributor must read" and a budget of 20000 tokens.
3. Walk the plan in order with snapshot_read. For each file, one sentence on why it is on the tour.
4. Call snapshot_query for layer "test" and name the tests that show how the project is exercised.
5. Finish with: the five files to read first (in order), the command to run the tests, and the one thing that will surprise them. Cite paths with their part.`;

const SECURITY = `Review this repository for security problems, using the snapshot as the evidence.

1. Call snapshot_health. A failed secrets check is the first finding, and it is critical. Do not repeat the secret value.
2. Call snapshot_query for config, auth and route files. Read the ones that decide who may do what.
3. Look for: authentication and authorization checks, secrets in code, unsafe deserialization, path traversal, shell invocation with interpolated input, and dependencies that are fetched at runtime.
4. Report each finding as: severity, the path and part, the code you read, why it is a problem, and the smallest fix. Separate what the snapshot proves from what it cannot see (secrets excluded from the snapshot, generated code, runtime configuration).
5. Do not modify files. If the snapshot excluded something relevant, call snapshot_explain and say what is missing.`;

const ORIENT = `You have a codebase-snapshot server for this repository. Build a map of it before reading any code.

1. Call snapshot_status. If no snapshot exists, call snapshot_plan to preview it, then snapshot_generate.
2. Call snapshot_locate for the areas that matter. Search by exported symbol, route or path fragment rather than guessing filenames.
3. Report back: the layers present, the entry points, and the files that matter here — cited as paths with their part.
4. Read one file at a time with snapshot_read, one window at a time. Do not read a part end to end.`;

const KEEP_CURRENT = `Keep the context you were given provably current while you work.

1. Before relying on a snapshot from an earlier session, call snapshot_validate.
2. If it reports drift, call snapshot_generate once, then snapshot_validate again.
3. After changes you make, call snapshot_validate and report what it said.
4. Never call a snapshot current unless snapshot_validate said so in this session.`;

function withFocus(base: string, focus: unknown): string {
  return typeof focus === "string" && focus.trim().length > 0
    ? `${base}\n\nFocus for this pass: ${focus.trim()}`
    : base;
}

const PROMPTS: McpPrompt[] = [
  {
    name: "orient",
    title: "Orient in this repository",
    description: "Map the repository from the snapshot before reading any of it.",
    arguments: [{ name: "focus", description: "Optional area to concentrate on.", required: false }],
    build(args: JsonObject) {
      return {
        description: "Map the repository before reading it.",
        messages: [{ role: "user", content: { type: "text", text: withFocus(ORIENT, args.focus) } }],
      };
    },
  },
  {
    name: "keep-current",
    title: "Keep the snapshot current",
    description: "Validate before trusting earlier context, and again after making changes.",
    arguments: [],
    build() {
      return {
        description: "Keep the context current.",
        messages: [{ role: "user", content: { type: "text", text: KEEP_CURRENT } }],
      };
    },
  },
  {
    name: "audit",
    title: "Audit the snapshot and the repository",
    description: "Evidence first: health, drift, the files that were excluded, and the findings that matter.",
    arguments: [{ name: "focus", description: "Optional area to concentrate on.", required: false }],
    build(args: JsonObject) {
      return {
        description: "Audit with evidence.",
        messages: [{ role: "user", content: { type: "text", text: withFocus(AUDIT, args.focus) } }],
      };
    },
  },
  {
    name: "review",
    title: "Review a change",
    description: "Plan the reading for a change, read it, and name the dependents and risks.",
    arguments: [{ name: "change", description: "What changed, or the branch to review.", required: true }],
    build(args: JsonObject) {
      const change = typeof args.change === "string" ? args.change.trim() : "";
      return {
        description: "Review a change.",
        messages: [
          { role: "user", content: { type: "text", text: REVIEW + (change === "" ? "" : "\n\nThe change: " + change) } },
        ],
      };
    },
  },
  {
    name: "explain",
    title: "Explain one path",
    description: "Why a file is in the snapshot, what it does, and who depends on it.",
    arguments: [{ name: "path", description: "Path relative to the repository root.", required: true }],
    build(args: JsonObject) {
      const target = typeof args.path === "string" ? args.path.trim() : "";
      return {
        description: "Explain a path.",
        messages: [
          { role: "user", content: { type: "text", text: EXPLAIN + (target === "" ? "" : "\n\nThe path: " + target) } },
        ],
      };
    },
  },
  {
    name: "onboard",
    title: "Guided tour for a new contributor",
    description: "A reading order for someone who has never seen this repository.",
    arguments: [],
    build() {
      return { description: "Onboard a new contributor.", messages: [{ role: "user", content: { type: "text", text: ONBOARD } }] };
    },
  },
  {
    name: "security-review",
    title: "Security review",
    description: "Authentication, authorization, secrets and injection, with what the snapshot cannot see.",
    arguments: [],
    build() {
      return { description: "Security review.", messages: [{ role: "user", content: { type: "text", text: SECURITY } }] };
    },
  },
];

export function buildPrompts(): McpPrompt[] {
  return PROMPTS;
}
</file>

<file path="src/mcp/stdio.ts">
/**
 * The stdio transport: one JSON-RPC message per line, UTF-8, nothing else on the stream.
 *
 * MCP's stdio binding is newline-delimited JSON, not LSP's `Content-Length` framing, and the
 * server MUST NOT write anything to stdout that is not a valid message. `JSON.stringify` escapes
 * newlines inside strings, so serialising a message can never produce a second line — the writer
 * deliberately does not pretty-print, because `JSON.stringify(value, null, 2)` would.
 *
 * Framing is separated from parsing on purpose: this module hands raw lines to its caller and the
 * server decides what a bad line means (a `-32700` response), which keeps the line splitting
 * testable without a running server.
 */
import type { Readable, Writable } from "node:stream";

/**
 * Largest single message this transport will buffer.
 *
 * A line with no newline grows the buffer until the process runs out of memory, so an oversized
 * message is discarded rather than accepted: the snapshot itself is never this large, and a
 * client that streams more than this is not sending a message.
 */
export const MAX_LINE_BYTES = 32 * 1024 * 1024;

export interface MessageWriter {
  /** Serialises one message onto the stream. Rejects if the stream reports a write error. */
  write(value: unknown): Promise<void>;
}

/**
 * Creates a writer that emits exactly one line per message.
 *
 * Writes are awaited through the stream's callback rather than fire-and-forget: a tool result can
 * be tens of kilobytes, and queueing several without backpressure interleaves them with the next
 * response on a slow pipe.
 */
export function createWriter(output: Writable): MessageWriter {
  return {
    write(value: unknown): Promise<void> {
      return new Promise<void>((resolve, reject) => {
        output.write(`${JSON.stringify(value)}\n`, (error?: Error | null) => {
          if (error) reject(error);
          else resolve();
        });
      });
    },
  };
}

export interface LineReaderOptions {
  /** Called for every complete, non-empty line, with the trailing CR already removed. */
  onLine: (line: string) => void;
  /** Called when one line exceeds {@link MAX_LINE_BYTES}; the line is discarded. */
  onOverflow?: (bytes: number) => void;
}

/**
 * Reads newline-delimited lines from `input` until it ends.
 *
 * Three details are what make this work against real clients rather than against our own tests:
 * a chunk boundary can fall anywhere inside a line (including inside a multi-byte character,
 * which `setEncoding` handles); a Windows client may terminate lines with CRLF; and the final
 * line may arrive without a newline before the stream ends.
 *
 * Returns a function that removes the listeners, so a caller can shut a transport down without
 * racing a late `end` event.
 */
export function createLineReader(input: Readable, options: LineReaderOptions): () => void {
  let buffer = "";
  let bufferBytes = 0;
  let discarding = false;
  let discardedBytes = 0;

  const deliver = (line: string): void => {
    if (discarding) {
      discarding = false;
      discardedBytes = 0;
      return;
    }
    const trimmed = line.endsWith("\r") ? line.slice(0, -1) : line;
    // Blank lines are not messages. Some clients pad with them after a shutdown notification.
    if (trimmed.trim().length === 0) return;
    options.onLine(trimmed);
  };

  /** Drops what is buffered as the tail of an oversized line, and reports it once. */
  const discardBuffered = (): void => {
    discarding = true;
    discardedBytes += bufferBytes;
    buffer = "";
    bufferBytes = 0;
    options.onOverflow?.(discardedBytes);
  };

  const drain = (): void => {
    let index = buffer.indexOf("\n");
    while (index >= 0) {
      const line = buffer.slice(0, index);
      buffer = buffer.slice(index + 1);
      if (discarding) {
        // Still draining the tail of a discarded line: this terminator ends it. `deliver` resets
        // the discard state and drops the fragment.
        deliver(line);
      } else {
        // The cap exists to bound the work one message costs to parse, so it is applied to a
        // **complete** line too, and in bytes: `.length` is UTF-16 code units, and a line of
        // astral characters is twice that many bytes.
        const lineBytes = Buffer.byteLength(line, "utf8");
        if (lineBytes > MAX_LINE_BYTES) options.onOverflow?.(lineBytes);
        else deliver(line);
      }
      index = buffer.indexOf("\n");
    }

    bufferBytes = Buffer.byteLength(buffer, "utf8");
    // Whatever is left has no terminator yet, and an over-cap remainder has to be dropped here:
    // the next chunk may never arrive, and `onEnd` delivers whatever is in the buffer. This is the
    // hole a chunk that carried both a discarded line's terminator *and* the start of the next
    // message fell through — the remainder sat here unmeasured until the stream ended, and
    // `onEnd` handed it to `JSON.parse` whole.
    if (!discarding && bufferBytes > MAX_LINE_BYTES) discardBuffered();
  };

  const onData = (chunk: string): void => {
    const chunkBytes = Buffer.byteLength(chunk, "utf8");

    if (discarding) {
      // Still inside the oversized line: look for its terminator and drop everything up to it.
      const index = chunk.indexOf("\n");
      if (index < 0) {
        discardedBytes += chunkBytes;
        return;
      }
      buffer = chunk.slice(index + 1);
      bufferBytes = Buffer.byteLength(buffer, "utf8");
      deliver("");
      drain();
      return;
    }

    // Measure before appending when the chunk holds no terminator. `buffer += chunk` on a stream of
    // 64 KB chunks built a 300 MB string one copy at a time before anything looked at its length,
    // and this cap exists to bound exactly that.
    if (chunk.indexOf("\n") < 0 && bufferBytes + chunkBytes > MAX_LINE_BYTES) {
      discarding = true;
      discardedBytes = bufferBytes + chunkBytes;
      buffer = "";
      bufferBytes = 0;
      options.onOverflow?.(discardedBytes);
      return;
    }

    buffer += chunk;
    drain();
  };

  const onEnd = (): void => {
    const rest = buffer;
    const restBytes = bufferBytes || Buffer.byteLength(rest, "utf8");
    buffer = "";
    bufferBytes = 0;
    if (rest.length === 0) return;
    if (discarding) {
      discarding = false;
      discardedBytes = 0;
      return;
    }
    // The final line may arrive without a newline, and it is still a line: the cap applies to it
    // for the same reason it applies to every other one.
    if (restBytes > MAX_LINE_BYTES) {
      options.onOverflow?.(restBytes);
      return;
    }
    deliver(rest);
  };

  input.setEncoding("utf8");
  input.on("data", onData);
  input.on("end", onEnd);

  return () => {
    input.off("data", onData);
    input.off("end", onEnd);
  };
}
</file>

<file path="src/presets/context.ts">
import * as fs from "node:fs";
import * as path from "node:path";

/**
 * Everything preset detection is allowed to look at.
 *
 * Built once per run: the previous implementation re-read `package.json` inside
 * every detector, which was both slow and incapable of seeing anything outside
 * the JavaScript ecosystem.
 *
 * Detection stays bounded: the root is read once, and a workspace root (and only
 * a workspace root) additionally looks one level into its packages so a Next.js
 * app in `apps/web` is still a Next.js repository — see {@link isWorkspace}.
 */
export interface PresetContext {
  cwd: string;
  /** Top-level file names, e.g. `next.config.ts`. */
  files: ReadonlySet<string>;
  /** Top-level directory names. */
  dirs: ReadonlySet<string>;
  /** `dependencies` + `devDependencies` + `peerDependencies` names, root and workspace. */
  dependencies: ReadonlySet<string>;
  /** Small snapshots of well-known manifests, for keyword detection. */
  manifests: Readonly<Record<string, string>>;
  /** True when the root declares a workspace (`pnpm-workspace.yaml`, `workspaces`, nx/turbo/lerna). */
  isWorkspace: boolean;
  /**
   * Top-level entry names of the workspace's packages, deduplicated.
   *
   * Flattened on purpose: a detector only needs "does some package carry a
   * `next.config.*`/`vite.config.*` marker", not which package it was.
   */
  workspaceFiles: ReadonlySet<string>;
  /**
   * `.md`/`.mdx` files at the root and up to two directories down.
   *
   * Only counted when the root has no `package.json` (the `docs` preset's other
   * condition), so ordinary repositories pay nothing for it.
   */
  markdownCount: number;
}

/** Manifests small enough to read whole, and useful for keyword checks. */
const MANIFEST_FILES = [
  "package.json",
  "pyproject.toml",
  "requirements.txt",
  "setup.py",
  "go.mod",
  "Cargo.toml",
  "pom.xml",
  "build.gradle",
  "build.gradle.kts",
  "composer.json",
  "Gemfile",
];

const MANIFEST_MAX_BYTES = 100_000;

/**
 * Bounds for the workspace and markdown probes.
 *
 * Detection may look slightly past the repository root, never scan it: a
 * 200 000-file monorepo must still be classified from a few dozen directory
 * listings.
 */
const MAX_WORKSPACE_PACKAGES = 64;
const MAX_MARKDOWN_DIRS = 256;
const MAX_MARKDOWN_FILES = 4_000;
/** Roots that are workspaces but declare no globs still get the usual layouts. */
const DEFAULT_WORKSPACE_PATTERNS = ["apps/*", "packages/*", "libs/*"];

/** Directories that never hold workspace packages or documentation sources. */
const SKIPPED_WALK_DIRS = new Set([
  "node_modules",
  ".git",
  "dist",
  "build",
  "out",
  "coverage",
  ".next",
  ".nuxt",
  ".turbo",
  ".cache",
  ".svelte-kit",
  ".astro",
  ".angular",
  "target",
  "vendor",
  "__pycache__",
  ".venv",
  "venv",
  ".mypy_cache",
  ".pytest_cache",
  ".tox",
  ".eggs",
  "snapshot",
  "snapshot.tmp",
]);

function readSmallFile(fullPath: string): string | null {
  try {
    const stats = fs.statSync(fullPath);
    if (!stats.isFile() || stats.size > MANIFEST_MAX_BYTES) return null;
    return fs.readFileSync(fullPath, "utf8");
  } catch {
    return null;
  }
}

function readManifest(cwd: string, name: string): string | null {
  return readSmallFile(path.join(cwd, name));
}

/** Dependency names declared by one `package.json` body. */
function dependenciesFromPackageJson(raw: string): Set<string> {
  const names = new Set<string>();
  try {
    const parsed = JSON.parse(raw) as Record<string, Record<string, string> | undefined>;
    for (const section of ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"]) {
      const block = parsed[section];
      if (block && typeof block === "object") {
        for (const name of Object.keys(block)) names.add(name);
      }
    }
  } catch {
    // A malformed package.json is not fatal: detection simply falls through to
    // presets that do not need it.
  }
  return names;
}

function collectDependencies(manifests: Record<string, string>): Set<string> {
  const raw = manifests["package.json"];
  return raw === undefined ? new Set<string>() : dependenciesFromPackageJson(raw);
}

/** `workspaces` from `package.json`, in either the array or `{ packages }` form. */
function packageJsonWorkspacePatterns(raw: string): string[] {
  try {
    const parsed = JSON.parse(raw) as { workspaces?: unknown };
    const workspaces = parsed.workspaces;
    if (Array.isArray(workspaces)) {
      return workspaces.filter((entry): entry is string => typeof entry === "string");
    }
    if (workspaces && typeof workspaces === "object") {
      const listed = (workspaces as { packages?: unknown }).packages;
      if (Array.isArray(listed)) {
        return listed.filter((entry): entry is string => typeof entry === "string");
      }
    }
  } catch {
    // Malformed JSON is reported by the config layer; detection falls through.
  }
  return [];
}

/**
 * Package globs from `pnpm-workspace.yaml`.
 *
 * Only the `packages:` block is read, and only its `- pattern` lines: a full
 * YAML parser is not worth a runtime dependency for this one list.
 */
function pnpmWorkspacePatterns(raw: string): string[] {
  const patterns: string[] = [];
  let inPackages = false;
  for (const line of raw.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (trimmed === "" || trimmed.startsWith("#")) continue;
    if (/^packages\s*:/.test(trimmed)) {
      inPackages = true;
      continue;
    }
    if (!inPackages) continue;
    if (!trimmed.startsWith("-")) {
      // Any other top-level key ends the block.
      inPackages = false;
      continue;
    }
    const value = trimmed
      .replace(/^-\s*/, "")
      .replace(/\s+#.*$/, "")
      .replace(/^["']|["']$/g, "")
      .trim();
    if (value !== "" && !value.startsWith("!")) patterns.push(value);
  }
  return patterns;
}

/** Directory names listed directly under `parent`, bounded and filtered. */
function childDirectories(cwd: string, parent: string): string[] {
  let entries: fs.Dirent[];
  try {
    entries = fs.readdirSync(path.join(cwd, parent), { withFileTypes: true });
  } catch {
    return [];
  }
  const children: string[] = [];
  for (const entry of entries) {
    if (!entry.isDirectory()) continue;
    if (entry.name.startsWith(".") || SKIPPED_WALK_DIRS.has(entry.name)) continue;
    children.push(`${parent}/${entry.name}`);
  }
  return children;
}

/**
 * Workspace package directories implied by the declared globs.
 *
 * `apps/*` and `packages/**` list one level under their parent; a literal entry
 * such as `packages/core` is a package itself. Anything deeper is ignored on
 * purpose: the point is to find framework markers, not to map the workspace.
 */
function workspacePackageDirs(cwd: string, patterns: readonly string[]): string[] {
  const dirs = new Set<string>();
  for (const pattern of patterns) {
    if (dirs.size >= MAX_WORKSPACE_PACKAGES) break;
    const cleaned = pattern.replace(/\\/g, "/").replace(/^\.\//, "").replace(/\/+$/, "");
    if (cleaned === "") continue;
    const star = cleaned.indexOf("*");
    if (star === -1) {
      dirs.add(cleaned);
      continue;
    }
    const parent = cleaned.slice(0, star).replace(/\/+$/, "");
    if (parent === "" || parent.includes("*")) continue;
    for (const child of childDirectories(cwd, parent)) {
      dirs.add(child);
      if (dirs.size >= MAX_WORKSPACE_PACKAGES) break;
    }
  }
  return Array.from(dirs).slice(0, MAX_WORKSPACE_PACKAGES);
}

interface WorkspaceView {
  files: Set<string>;
  dependencies: Set<string>;
}

/** Reads the bounded view of the workspace's packages. */
function scanWorkspacePackages(cwd: string, patterns: readonly string[]): WorkspaceView {
  const files = new Set<string>();
  const dependencies = new Set<string>();
  for (const relative of workspacePackageDirs(cwd, patterns)) {
    const full = path.join(cwd, relative);
    try {
      for (const entry of fs.readdirSync(full, { withFileTypes: true })) files.add(entry.name);
    } catch {
      // A package directory that disappeared between listing and reading is not
      // worth failing detection over.
    }
    const raw = readSmallFile(path.join(full, "package.json"));
    if (raw !== null) {
      for (const name of dependenciesFromPackageJson(raw)) dependencies.add(name);
    }
  }
  return { files, dependencies };
}

/**
 * The ownership marker this generator writes into every directory it owns.
 *
 * The same filename is read by the scanner (`makeToolOwnedDecider`) and written by
 * `generateSnapshot`; preset detection needs it too, because "this directory is the
 * tool's own output" cannot be decided from a name.
 */
const SNAPSHOT_MARKER = ".codebase-snapshot";

/**
 * True when `dir` carries this generator's ownership marker.
 *
 * The markdown walk used to skip only the literal names `snapshot`/`snapshot.tmp` (and a
 * handful of build-directory literals). With a custom `outDir`, the second run counted its
 * own previous output — `README.md` plus the parts and reports — towards the `docs`
 * preset's "three or more markdown files, no `package.json`" rule. A repository that
 * detected as `generic` on run 1 detected as `docs` on run 2: layers and kinds changed,
 * the `docs` preset's `site/` exclusion silently dropped source files, and parts stopped
 * being byte-identical across runs. Ownership does not depend on the directory's name, so
 * neither does this skip: a directory carrying the marker is this generator's output
 * whatever it is called, at any depth and for a relative or absolute `outDir`.
 */
function isToolOwnedDirectory(dir: string): boolean {
  try {
    return fs.statSync(dir).isDirectory() && fs.existsSync(path.join(dir, SNAPSHOT_MARKER));
  } catch {
    return false;
  }
}

/**
 * Markdown files at the root and up to two directories down.
 *
 * Bounded by directory and file counts. `node_modules`, VCS metadata, build output and
 * this generator's own snapshot directories are skipped: a generated `README.md` in
 * `dist/` or in `outDir` is not documentation.
 */
function countMarkdownFiles(cwd: string): number {
  let count = 0;
  let directoriesSeen = 0;
  const queue: Array<{ dir: string; depth: number }> = [{ dir: cwd, depth: 0 }];
  while (queue.length > 0 && directoriesSeen < MAX_MARKDOWN_DIRS && count < MAX_MARKDOWN_FILES) {
    const current = queue.shift();
    if (current === undefined) break;
    directoriesSeen += 1;
    let entries: fs.Dirent[];
    try {
      entries = fs.readdirSync(current.dir, { withFileTypes: true });
    } catch {
      continue;
    }
    for (const entry of entries) {
      if (entry.isFile()) {
        if (/\.mdx?$/i.test(entry.name)) count += 1;
        continue;
      }
      if (!entry.isDirectory() || current.depth >= 2) continue;
      if (entry.name.startsWith(".") || SKIPPED_WALK_DIRS.has(entry.name)) continue;
      const child = path.join(current.dir, entry.name);
      // The output directory is only known after configuration resolution; the marker is
      // this walk's evidence for "the tool wrote this", which is true for any outDir name.
      if (isToolOwnedDirectory(child)) continue;
      queue.push({ dir: child, depth: current.depth + 1 });
    }
  }
  return count;
}

/** Reads the repository once and hands every detector the same view. */
export function buildPresetContext(cwd: string): PresetContext {
  const files = new Set<string>();
  const dirs = new Set<string>();

  try {
    for (const entry of fs.readdirSync(cwd, { withFileTypes: true })) {
      if (entry.isDirectory()) dirs.add(entry.name);
      else if (entry.isFile()) files.add(entry.name);
    }
  } catch {
    // An unreadable directory yields an empty context and the `generic` preset.
  }

  const manifests: Record<string, string> = {};
  for (const name of MANIFEST_FILES) {
    const content = readManifest(cwd, name);
    if (content !== null) manifests[name] = content;
  }

  const rootDependencies = collectDependencies(manifests);
  const packageJson = manifests["package.json"];
  const declaredWorkspaces = packageJson === undefined ? [] : packageJsonWorkspacePatterns(packageJson);
  const isWorkspace =
    files.has("pnpm-workspace.yaml") ||
    files.has("nx.json") ||
    files.has("turbo.json") ||
    files.has("lerna.json") ||
    (packageJson !== undefined && packageJson.includes('"workspaces"')) ||
    declaredWorkspaces.length > 0;

  let workspace: WorkspaceView = { files: new Set<string>(), dependencies: new Set<string>() };
  if (isWorkspace) {
    const pnpmRaw = files.has("pnpm-workspace.yaml")
      ? readSmallFile(path.join(cwd, "pnpm-workspace.yaml"))
      : null;
    const declared = pnpmRaw === null ? [] : pnpmWorkspacePatterns(pnpmRaw);
    const patterns =
      declared.length > 0
        ? declared
        : declaredWorkspaces.length > 0
          ? declaredWorkspaces
          : DEFAULT_WORKSPACE_PATTERNS;
    workspace = scanWorkspacePackages(cwd, patterns);
  }

  return {
    cwd,
    files,
    dirs,
    dependencies: new Set([...rootDependencies, ...workspace.dependencies]),
    manifests,
    isWorkspace,
    workspaceFiles: workspace.files,
    // The `docs` preset requires "no package.json", so the walk is only useful
    // when the root has none; every other repository skips it entirely.
    markdownCount: files.has("package.json") ? 0 : countMarkdownFiles(cwd),
  };
}

// Detection predicates live in `evidence.ts`. They used to sit here as boolean helpers
// (`hasFile`, `hasDependency`, `manifestContains`, …), which forced every detector to throw
// away the thing that made it fire — the wizard could report which preset it picked but never
// why. One family of helpers, returning the reason, is the whole point.
</file>

<file path="src/presets/evidence.ts">
import type { PresetContext } from "./context.js";

/**
 * Detectors that answer with their evidence.
 *
 * A preset used to answer "does this look like me?" with a boolean, so the tool could
 * only ever report *what* it picked. The first-run wizard and `--autopilot` now report
 * *why* — `Because next.config.ts` — which means the match has to carry its reason.
 *
 * Each helper returns a short phrase, or null when the signal is absent. Detectors chain
 * them with `??`, so the first signal that fires is also the one that gets printed.
 */

/** The root file itself, e.g. `go.mod`. */
export function fileEvidence(context: PresetContext, name: string): string | null {
  return context.files.has(name) ? name : null;
}

/**
 * The first root or workspace file starting with `prefix`, e.g. `next.config.ts`.
 *
 * The real filename is returned rather than the prefix: it is the precise answer, and it
 * is the file a developer will open to check the tool's work.
 */
export function fileStartingWithEvidence(context: PresetContext, prefix: string): string | null {
  for (const file of context.files) {
    if (file.startsWith(prefix)) return file;
  }
  for (const file of context.workspaceFiles) {
    if (file.startsWith(prefix)) return file;
  }
  return null;
}

/** The first declared dependency that matched, phrased `depends on next`. */
export function dependencyEvidence(context: PresetContext, ...names: string[]): string | null {
  for (const name of names) {
    if (context.dependencies.has(name)) return `depends on ${name}`;
  }
  return null;
}

/** A needle found inside a manifest, e.g. `django in pyproject.toml`. */
export function manifestEvidence(
  context: PresetContext,
  manifest: string,
  needle: string
): string | null {
  const content = context.manifests[manifest];
  if (!content) return null;
  if (!content.toLowerCase().includes(needle.toLowerCase())) return null;
  return `${needle} in ${manifest}`;
}

/** The first root file ending with `suffix`, e.g. `main.tf`. */
export function suffixEvidence(context: PresetContext, suffix: string): string | null {
  for (const file of context.files) {
    if (file.endsWith(suffix)) return file;
  }
  return null;
}

/**
 * The documentation-shape signal, which is a count rather than a single file.
 *
 * Mirrors the `docs` preset's condition exactly: three or more Markdown files and no
 * `package.json` (a JavaScript repository that happens to keep a `docs/` folder is not a
 * documentation site).
 *
 * The count is built by `buildPresetContext`, which skips this generator's own snapshot
 * directories: their README, parts and reports are output, not documentation. Without that,
 * a custom `outDir` made the second run of a no-`package.json` repository look like a docs
 * site and changed what the snapshot contained.
 */
export function markdownEvidence(context: PresetContext): string | null {
  if (context.markdownCount < 3 || context.files.has("package.json")) return null;
  return `${context.markdownCount} markdown files, no package.json`;
}
</file>

