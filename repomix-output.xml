import * as http from "node:http";
import * as fs from "node:fs";
import * as path from "node:path";
import { randomBytes, timingSafeEqual } from "node:crypto";
import { generateSnapshot } from "../index.js";
import { createServer } from "../mcp/run.js";
import { auditSnapshot } from "../auditor/health.js";
import { assertPublicHost, cloneRepository, makeCloneDirectory, parseRemoteSource } from "../remote/source.js";
import type { Manifest } from "../types.js";
import { writeZip } from "./zip.js";
import { SERVE_PAGE } from "./ui.js";

/**
 * `snapshot serve`: the browser face of the tool.
 *
 * One process serves the page, the API it calls, and the MCP endpoint, so a browser client and an
 * agent talk to the same snapshot. Three rules shape it:
 *
 *  - Loopback by default, a bearer token always (generated on first run, printed once). The page
 *    asks for the token and keeps it in localStorage, so serving / can never leak the credential.
 *  - The API only ever writes where a person pointed it: a local path that exists, with the
 *    default settings. A remote URL is refused with a message that says what is missing, rather
 *    than pretending to fetch.
 *  - Every response is bounded. The preview is the first 64 KiB of PROMPT.md, the file list is
 *    capped, the zip is built in memory and streamed once.
 */

export interface ServeOptions {
  cwd: string;
  host?: string;
  port?: number;
  token?: string | null;
  /** Allow private addresses and file: URLs for remote sources (tests and air-gapped mirrors). */
  allowPrivate?: boolean;
  log?: (line: string) => void;
}

export interface ServeHandle {
  url: string;
  port: number;
  host: string;
  token: string | null;
  close(): Promise<void>;
}

const DEFAULT_PORT = 4788;
const MAX_BODY = 64 * 1024;
const MAX_PREVIEW = 64 * 1024;

function isLoopback(origin: string): boolean {
  try {
    const url = new URL(origin);
    return ["localhost", "127.0.0.1", "[::1]", "::1"].includes(url.hostname);
  } catch {
    return false;
  }
}

export async function startWebServer(options: ServeOptions): Promise<ServeHandle> {
  const host = options.host ?? "127.0.0.1";
  const port = options.port ?? DEFAULT_PORT;
  const log = options.log ?? ((line: string) => process.stderr.write(line + "\n"));
  const token = options.token === undefined ? randomBytes(18).toString("base64url") : options.token;
  if (token === null && !["127.0.0.1", "localhost", "::1"].includes(host)) {
    throw new Error("Refusing to serve " + host + " without a token.");
  }
  const mcp = createServer({ cwd: options.cwd, log });
  /** Clones made by this process; removed when it closes, because the page can still be reading them. */
  const temporaryClones = new Set<string>();

  const authorized = (request: http.IncomingMessage): boolean => {
    if (token === null) return true;
    const header = request.headers.authorization ?? "";
    const match = /^Bearer\s+(.+)$/i.exec(header);
    if (match === null) return false;
    const given = Buffer.from(match[1].trim(), "utf8");
    const expected = Buffer.from(token, "utf8");
    return given.length === expected.length && timingSafeEqual(given, expected);
  };

  const server = http.createServer((request, response) => {
    const origin = typeof request.headers.origin === "string" ? request.headers.origin : undefined;
    const cors: Record<string, string> = {};
    if (origin !== undefined) {
      if (!isLoopback(origin)) {
        response.writeHead(403, { "content-type": "text/plain" });
        response.end("origin not allowed");
        return;
      }
      cors["access-control-allow-origin"] = origin;
      cors["vary"] = "origin";
      cors["access-control-allow-headers"] = "authorization, content-type";
      cors["access-control-allow-methods"] = "GET, POST, OPTIONS";
    }
    const send = (status: number, body: unknown, extra: Record<string, string> = {}): void => {
      const text = typeof body === "string" ? body : JSON.stringify(body);
      response.writeHead(status, {
        ...cors,
        "content-type": typeof body === "string" ? "text/plain; charset=utf-8" : "application/json",
        "content-length": String(Buffer.byteLength(text, "utf8")),
        "x-content-type-options": "nosniff",
        ...extra,
      });
      response.end(text);
    };

    if (request.method === "OPTIONS") {
      response.writeHead(204, cors);
      response.end();
      return;
    }
    if (request.method === "GET" && request.url === "/healthz") {
      send(200, { ok: true, name: "codebase-snapshot", tools: 12 });
      return;
    }
    if (request.method === "GET" && (request.url === "/" || request.url === "/index.html")) {
      send(200, SERVE_PAGE, { "content-type": "text/html; charset=utf-8" });
      return;
    }

    if (!authorized(request)) {
      send(401, { error: "unauthorized" }, { "www-authenticate": 'Bearer realm="codebase-snapshot"' });
      return;
    }

    const url = new URL(request.url ?? "/", "http://localhost");
    if (request.method === "POST" && (request.url === "/mcp" || (request.url ?? "").startsWith("/mcp?"))) {
      let received = 0;
      const chunks: Buffer[] = [];
      request.on("data", (chunk: Buffer) => {
        received += chunk.length;
        if (received > 2 * 1024 * 1024) {
          request.destroy();
          send(413, { error: "request body too large" });
          return;
        }
        chunks.push(chunk);
      });
      request.on("end", () => {
        void (async () => {
          let message: unknown;
          try {
            message = JSON.parse(Buffer.concat(chunks).toString("utf8"));
          } catch (error) {
            send(400, { jsonrpc: "2.0", id: null, error: { code: -32700, message: String(error) } });
            return;
          }
          const batch = Array.isArray(message) ? message : [message];
          const answers = [];
          for (const item of batch) {
            const answer = await mcp.handle(item);
            if (answer !== null) answers.push(answer);
          }
          if (answers.length === 0) send(202, "");
          else send(200, Array.isArray(message) ? answers : answers[0]);
        })();
      });
      return;
    }

    if (request.method === "POST" && request.url === "/api/generate") {
      let received = 0;
      const chunks: Buffer[] = [];
      request.on("data", (chunk: Buffer) => {
        received += chunk.length;
        if (received > MAX_BODY) {
          request.destroy();
          send(413, { error: "request body too large" });
          return;
        }
        chunks.push(chunk);
      });
      request.on("end", () => {
        void (async () => {
          let source = "";
          let mode: "full" | "slice" | "budget" = "full";
          let question = "";
          let budgetTokens: number | undefined;
          try {
            const body = JSON.parse(Buffer.concat(chunks).toString("utf8")) as {
              source?: unknown;
              mode?: unknown;
              question?: unknown;
              budgetTokens?: unknown;
            };
            source = typeof body.source === "string" ? body.source.trim() : "";
            mode = body.mode === "slice" || body.mode === "budget" ? body.mode : "full";
            question = typeof body.question === "string" ? body.question.trim() : "";
            budgetTokens = typeof body.budgetTokens === "number" ? body.budgetTokens : undefined;
          } catch {
            send(400, { error: "body must be JSON with a source string" });
            return;
          }
          if (source === "") {
            send(400, { error: "source is empty" });
            return;
          }
          if (mode === "slice" && question.length < 3) {
            send(400, { error: "slice mode needs a question of at least 3 characters" });
            return;
          }
          if (mode === "budget" && (budgetTokens === undefined || budgetTokens < 500)) {
            send(400, { error: "budget mode needs budgetTokens of at least 500" });
            return;
          }
          const isRemote = /^(https?|file):\/\//i.test(source);
          let target: string;
          let provenance: Manifest["source"];
          if (isRemote) {
            const parsed = parseRemoteSource(source, { allowPrivate: options.allowPrivate === true });
            if (!parsed.ok) {
              send(400, { error: parsed.message });
              return;
            }
            try {
              if (parsed.source.kind === "https") {
                await assertPublicHost(parsed.source.host, options.allowPrivate === true);
              }
              const clone = await cloneRepository(parsed.source, {
                dest: makeCloneDirectory(),
                token: process.env.GITHUB_TOKEN ?? process.env.GH_TOKEN ?? null,
                allowPrivate: options.allowPrivate === true,
                log,
              });
              temporaryClones.add(clone.directory);
              target = clone.directory;
              provenance = clone.provenance;
            } catch (error) {
              send(400, { error: "Remote fetch failed: " + (error as Error).message });
              return;
            }
          } else {
            target = path.resolve(options.cwd, source);
          }
          let stat: fs.Stats;
          try {
            stat = fs.statSync(target);
          } catch {
            send(404, { error: "no such path: " + target });
            return;
          }
          if (!stat.isDirectory()) {
            send(400, { error: "not a directory: " + target });
            return;
          }
          const started = Date.now();
          try {
            const manifest = generateSnapshot({ cwd: target }, {
              ...(provenance === undefined ? {} : { source: provenance }),
              ...(mode === "slice" ? { slice: { question } } : {}),
              ...(mode === "budget" && budgetTokens !== undefined ? { budgetTokens } : {}),
            });
            const seconds = ((Date.now() - started) / 1000).toFixed(2);
            const snapshotDir = path.join(target, "snapshot");
            // The audit runs on what was just written, so the page shows whether the artifact is
            // safe to hand over rather than only how big it is.
            const health = auditSnapshot({ snapshotDir, repoDir: target });
            send(200, {
              path: snapshotDir,
              health: {
                score: health.score,
                failed: health.checks.filter((check) => check.status === "fail").map((check) => check.id),
                warnings: health.counts.warn,
              },
              files: manifest.counts.totalFiles,
              parts: manifest.counts.partsCount,
              tokens: manifest.totals.estimatedTokens ?? 0,
              fingerprint: manifest.fingerprint,
              mode,
              ...(manifest.slice === undefined ? {} : { dropped: manifest.slice.dropped }),
              ...(manifest.budget === undefined ? {} : { dropped: manifest.budget.dropped }),
              seconds,
              warning: manifest.warnings.length > 0 ? manifest.warnings[0] : null,
            });
          } catch (error) {
            send(500, { error: (error as Error).message });
          }
        })();
      });
      return;
    }

    if (request.method === "GET" && request.url?.startsWith("/api/health?") === true) {
      const target = path.resolve(options.cwd, url.searchParams.get("path") ?? options.cwd);
      if (!fs.existsSync(path.join(target, "manifest.json"))) {
        send(404, { error: "no manifest.json under " + target });
        return;
      }
      const report = auditSnapshot({ snapshotDir: target, repoDir: path.dirname(target) });
      send(200, { score: report.score, counts: report.counts, checks: report.checks });
      return;
    }

    if (request.method === "GET" && (request.url?.startsWith("/api/snapshot?") === true || request.url === "/api/snapshot")) {
      const target = path.resolve(options.cwd, url.searchParams.get("path") ?? options.cwd);
      const manifestFile = path.join(target, "manifest.json");
      let manifest: { fingerprint?: string; generatedAt?: string; counts?: { totalFiles?: number; skippedCount?: number }; totals?: { estimatedTokens?: number }; files?: Array<{ relativePath: string; part: string }> };
      try {
        manifest = JSON.parse(fs.readFileSync(manifestFile, "utf8"));
      } catch {
        send(404, { error: "no manifest.json under " + target });
        return;
      }
      let prompt = "";
      try {
        prompt = fs.readFileSync(path.join(target, "PROMPT.md"), "utf8").slice(0, MAX_PREVIEW);
      } catch {
        prompt = "(this snapshot has no PROMPT.md)";
      }
      send(200, {
        fingerprint: manifest.fingerprint ?? "",
        generatedAt: manifest.generatedAt ?? "",
        included: manifest.counts?.totalFiles ?? 0,
        skipped: manifest.counts?.skippedCount ?? 0,
        tokens: manifest.totals?.estimatedTokens ?? 0,
        files: (manifest.files ?? []).map((file) => ({ path: file.relativePath, part: file.part })),
        prompt,
      });
      return;
    }

    if (request.method === "GET" && request.url?.startsWith("/api/snapshot.zip") === true) {
      const target = path.resolve(options.cwd, url.searchParams.get("path") ?? options.cwd);
      if (!fs.existsSync(path.join(target, "manifest.json")) && !fs.existsSync(path.join(target, ".codebase-snapshot"))) {
        send(404, { error: "not a snapshot directory: " + target });
        return;
      }
      try {
        const zip = writeZip({ directory: target });
        response.writeHead(200, {
          ...cors,
          "content-type": "application/zip",
          "content-length": String(zip.length),
          "content-disposition": 'attachment; filename="snapshot.zip"',
        });
        response.end(zip);
      } catch (error) {
        send(500, { error: (error as Error).message });
      }
      return;
    }

    send(404, { error: "not found" });
  });

  await new Promise<void>((resolve, reject) => {
    server.once("error", reject);
    server.listen(port, host, () => {
      server.removeListener("error", reject);
      resolve();
    });
  });
  const address = server.address();
  const actualPort = typeof address === "object" && address !== null ? address.port : port;
  const display = host === "0.0.0.0" || host === "::" ? "127.0.0.1" : host;
  log("serve: http://" + display + ":" + actualPort + "/");

  return {
    url: "http://" + display + ":" + actualPort + "/",
    port: actualPort,
    host,
    token,
    close: () =>
      new Promise<void>((resolve) => {
        for (const directory of temporaryClones) {
          try {
            fs.rmSync(directory, { recursive: true, force: true });
          } catch {
            // A leftover temp tree is better than a crash on shutdown.
          }
        }
        server.close(() => resolve());
      }),
  };
}
</file>

<file path="src/web/ui.ts">
/**
 * The page `snapshot serve` serves.
 *
 * One file, no framework, no build step: the same rule that keeps the package dependency-free. It
 * is a form (a path or a repository URL), a status line, the brief, the file tree and a download.
 * The token is not baked into the page — the page asks for it and keeps it in localStorage — so an
 * exposed server cannot leak its own credential by serving /.
 */
export const SERVE_PAGE = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>codebase-snapshot</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #0d1117; color: #c9d1d9; font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  header { padding: 18px 22px; border-bottom: 1px solid #21262d; display: flex; gap: 14px; align-items: baseline; }
  header b { color: #f0f6fc; font-size: 16px; }
  header span { color: #8b949e; }
  main { max-width: 1100px; margin: 0 auto; padding: 22px; display: grid; gap: 18px; }
  form { display: flex; gap: 8px; flex-wrap: wrap; }
  input, button { font: inherit; background: #161b22; color: #c9d1d9; border: 1px solid #30363d; border-radius: 6px; padding: 8px 10px; }
  input { flex: 1 1 420px; }
  button { cursor: pointer; }
  button:hover { border-color: #58a6ff; color: #ffffff; }
  button:disabled { opacity: .5; cursor: default; }
  #status { color: #8b949e; min-height: 22px; white-space: pre-wrap; }
  .ok { color: #3fb950; } .bad { color: #f85149; } .warn { color: #d29922; }
  section { border: 1px solid #21262d; border-radius: 8px; overflow: hidden; }
  section h2 { margin: 0; padding: 10px 14px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #8b949e; background: #161b22; border-bottom: 1px solid #21262d; display: flex; justify-content: space-between; }
  pre { margin: 0; padding: 14px; overflow: auto; max-height: 320px; white-space: pre-wrap; word-break: break-word; }
  ul { margin: 0; padding: 10px 14px 10px 28px; columns: 2; }
  li { break-inside: avoid; color: #8b949e; }
  li b { color: #c9d1d9; font-weight: 500; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; } ul { columns: 1; } }
  code { color: #79c0ff; }
</style>
</head>
<body>
<header><b>codebase-snapshot</b><span>a snapshot an agent can trust</span></header>
<main>
  <form id="gen">
    <input id="source" placeholder="/absolute/path/to/repo   or   https://github.com/owner/repo" spellcheck="false" autofocus>
    <select id="mode" title="What to generate">
      <option value="full">whole repository</option>
      <option value="slice">a slice for a question</option>
      <option value="budget">fit a token budget</option>
    </select>
    <input id="question" placeholder="the question (slice mode)" spellcheck="false" hidden>
    <input id="budget" type="number" min="500" step="500" value="30000" title="token budget" hidden>
    <button id="run" type="submit">Generate</button>
    <button id="download" type="button" disabled>Download .zip</button>
  </form>
  <div id="status">Paste an absolute path, or a repository URL (https://github.com/owner/repo). Remote fetches are shallow and public-only.</div>
  <div id="auth" hidden>
    <form id="token-form"><input id="token" type="password" placeholder="paste the token printed by snapshot serve" style="flex:1"><button type="submit">Use token</button></form>
  </div>
  <div class="row">
    <section><h2>Brief <span id="fingerprint"></span> <span id="health"></span></h2><pre id="brief">No snapshot loaded.</pre></section>
    <section><h2>Files <span id="counts"></span></h2><ul id="files"></ul></section>
  </div>
</main>
<script>
  const $ = (id) => document.getElementById(id);
  let token = localStorage.getItem("snapshot-token") || "";
  let snapshotPath = "";
  const auth = (headers = {}) => token ? { ...headers, authorization: "Bearer " + token } : headers;
  const showAuth = (yes) => { $("auth").hidden = !yes; };
  const status = (text, kind) => { $("status").className = kind || ""; $("status").textContent = text; };
  async function api(path, options = {}) {
    const response = await fetch(path, { ...options, headers: auth(options.headers || {}) });
    if (response.status === 401) { showAuth(true); throw new Error("token required"); }
    if (!response.ok) throw new Error((await response.text()) || response.statusText);
    return response;
  }
  $("token-form").addEventListener("submit", (event) => {
    event.preventDefault();
    token = $("token").value.trim();
    localStorage.setItem("snapshot-token", token);
    showAuth(false);
    status("Token stored.");
  });
  $("mode").addEventListener("change", () => {
    const mode = $("mode").value;
    $("question").hidden = mode !== "slice";
    $("budget").hidden = mode !== "budget";
  });
  $("gen").addEventListener("submit", async (event) => {
    event.preventDefault();
    const source = $("source").value.trim();
    if (!source) return;
    $("run").disabled = true;
    status("Generating...");
    try {
      const response = await api("/api/generate", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          source,
          mode: $("mode").value,
          question: $("question").value.trim(),
          budgetTokens: Number($("budget").value),
        }),
      });
      const result = await response.json();
      snapshotPath = result.path;
      $("download").disabled = false;
      status(
        "Generated " + result.files + " files (" + (result.mode || "full") + ") in " + result.seconds + "s, " +
          result.parts + " part(s), " + result.tokens + " estimated tokens." +
          (result.dropped === undefined ? "" : " " + result.dropped + " path(s) not selected.") +
          (result.health ? " Health " + result.health.score + "/100" + (result.health.failed.length > 0 ? " (failed: " + result.health.failed.join(", ") + ")" : "") + "." : "") +
          (result.warning ? " " + result.warning : ""),
        result.warning ? "warn" : "ok"
      );
      await load();
    } catch (error) {
      status(String(error.message || error), "bad");
    } finally {
      $("run").disabled = false;
    }
  });
  async function load() {
    const info = await (await api("/api/snapshot?path=" + encodeURIComponent(snapshotPath))).json();
    $("fingerprint").textContent = info.fingerprint.slice(0, 12);
    try {
      const health = await (await api("/api/health?path=" + encodeURIComponent(snapshotPath))).json();
      $("health").textContent = "health " + health.score + "/100";
      $("health").className = health.counts.fail > 0 ? "bad" : health.counts.warn > 0 ? "warn" : "ok";
    } catch {
      $("health").textContent = "";
    }
    $("brief").textContent = info.prompt;
    $("counts").textContent = info.included + " included / " + info.skipped + " skipped";
    $("files").innerHTML = "";
    for (const file of info.files.slice(0, 400)) {
      const li = document.createElement("li");
      li.innerHTML = "<b>" + file.path.replace(/[<>&]/g, "") + "</b> " + file.part;
      $("files").appendChild(li);
    }
  }
  $("download").addEventListener("click", async () => {
    const response = await api("/api/snapshot.zip?path=" + encodeURIComponent(snapshotPath));
    const blob = await response.blob();
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "snapshot.zip";
    link.click();
    URL.revokeObjectURL(link.href);
  });
</script>
</body>
</html>`;
</file>

<file path="src/explain.ts">
import * as fs from "node:fs";
import * as path from "node:path";
import { importsOfFile } from "./ast/imports.js";
import { classifyKind, classifyLayer, matchRule } from "./config.js";
import { isSkeletonizable, skeletonizeTypeScript } from "./ast/skeleton.js";
import { isCommentStrippable, stripComments } from "./generator/comments.js";
import { countLines, truncatePreview } from "./partitioner/preview.js";
import { collectFiles, findSecretInPath } from "./scanner/files.js";
import { resolveChangedScope } from "./scanner/changed.js";
import { buildImportResolver, importsChangedFile } from "./scanner/dependents.js";
import {
  BINARY_SCAN_BYTES,
  decodeText,
  isBinaryExtension,
  isBinaryFile,
} from "./scanner/binary.js";
import { detectLanguage } from "./scanner/language.js";
import { scanAndRedactSecrets } from "./security/redact.js";
import { escapeControls } from "./terminal.js";
import type {
  Manifest,
  ResolvedSnapshotConfig,
  SkipRecord,
  TextEncoding,
} from "./types.js";

export interface ExplainResult {
  /** Path relative to the configured cwd, POSIX separators. */
  path: string;
  /** Whether the path exists on disk. */
  exists: boolean;
  /** Whether the scanner would include it in the next snapshot. */
  included: boolean;
  /** Why it is excluded, when it is. Mirrors `SkipRecord.reason`. */
  reason?: string;
  detail?: string;
  layer?: string;
  layerMatch?: string;
  kind?: string;
  kindMatch?: string;
  language?: string;
  /** Part filename from the last written manifest, when one is available. */
  part?: string | null;
  inclusionMode?: string;
  lines?: number;
  bytes?: number;
  /** Present when the file is not plain UTF-8, so an explanation cannot quietly lie about it. */
  encoding?: TextEncoding;
  secretCount?: number;
  secrets?: Array<{ rules: string[]; line: number }>;
}

function describeMatcher(matcher: unknown): string {
  if (typeof matcher === "string") return matcher;
  if (matcher instanceof RegExp) return String(matcher);
  if (typeof matcher === "function") {
    // Presets use predicate functions. Printing the function source leaked
    // implementation detail into a machine-readable payload and was unreadable;
    // say that a custom predicate decided it, which is all the caller can act on.
    return "function (custom predicate)";
  }
  return String(matcher);
}

/**
 * Normalises a caller-supplied path against the repository root.
 *
 * `explain` is reachable from an MCP tool that a prompt can call, so the target is not a trusted
 * argument. This used to answer "target unchanged" for anything whose relative form began with
 * `..`, and `explainPath` then joined it to `cwd` and called `fs.existsSync` — which made a
 * read-only tool an existence oracle for every path on the machine (`../../../etc/shadow`,
 * `../other-repo/.env`). Resolving first and refusing outside the root is the whole fix; the
 * caller gets `outside-root` and nothing is stat-ed.
 *
 * `relative.startsWith("..")` alone was also wrong in the other direction: a file legitimately
 * named `..foo.ts` is inside the root and was classified as a traversal.
 */
function normalizeTarget(
  cwd: string,
  target: string
): { relative: string; outsideRoot: boolean } {
  const resolvedCwd = path.resolve(cwd);
  const absolute = path.resolve(resolvedCwd, target);
  const relative = path.relative(resolvedCwd, absolute);
  if (
    relative === "" ||
    relative === ".." ||
    relative.startsWith(`..${path.sep}`) ||
    path.isAbsolute(relative)
  ) {
    return { relative: target.replace(/\\/g, "/"), outsideRoot: true };
  }
  return { relative: relative.split(path.sep).join("/"), outsideRoot: false };
}

function findRuleMatch<T extends { match: unknown }>(
  rules: T[],
  relativePath: string
): T | undefined {
  return rules.find((rule) =>
    matchRule(relativePath, rule.match as string | RegExp | ((value: string) => boolean))
  );
}

/**
 * The nearest recorded skip whose path is a proper directory ancestor of `target`.
 *
 * `collectFiles` records a skipped directory but never its contents, so the only
 * evidence for a file inside a skipped tree is the ancestor's record. This
 * applies to every reason, built-in ignores included: the walker records
 * `node_modules` as `default-ignore`, so a file inside it names that directory
 * instead of falling back to `not-discovered`. The longest matching prefix wins,
 * which is the closest explanation to the file.
 */
function findRecordedAncestor(
  skipped: readonly SkipRecord[],
  relative: string,
  maskedPath: string
): SkipRecord | undefined {
  let nearest: SkipRecord | undefined;
  for (const record of skipped) {
    const ancestorPath = record.path;
    if (ancestorPath.length === 0) continue;
    const isAncestor =
      relative.startsWith(`${ancestorPath}/`) || maskedPath.startsWith(`${ancestorPath}/`);
    if (!isAncestor) continue;
    if (!nearest || ancestorPath.length > nearest.path.length) nearest = record;
  }
  return nearest;
}

/** Reads the last written manifest, tolerating its absence. */
function readManifest(config: ResolvedSnapshotConfig): Manifest | null {
  // `path.resolve` so an absolute outDir is not appended to cwd.
  const manifestPath = path.resolve(config.cwd, config.outDir, "manifest.json");
  try {
    return JSON.parse(fs.readFileSync(manifestPath, "utf8")) as Manifest;
  } catch {
    return null;
  }
}

/**
 * Explains what the scanner would do with one path.
 *
 * The whole point is that every decision is visible: which layer and kind rule
 * matched, why a file was skipped, which part it landed in, and whether any
 * secret rule fires. Re-running the real scanner is what keeps it honest.
 */
export function explainPath(config: ResolvedSnapshotConfig, target: string): ExplainResult {
  const normalized = normalizeTarget(config.cwd, target);
  const relative = normalized.relative;

  // The echoed path is an artifact too: a token in a filename must not come back
  // out of explain.
  const maskedPath = findSecretInPath(relative, config.secretRules)?.masked ?? relative;

  if (normalized.outsideRoot) {
    // Answered without touching the filesystem: `exists` is not "false because it is missing", it
    // is "not asked", and saying so is the only honest option. The path is still masked, because
    // the traversal itself can carry a credential-shaped segment.
    return {
      path: maskedPath,
      exists: false,
      included: false,
      reason: "outside-root",
      detail:
        "path resolves outside the configured repository root and was not inspected",
    };
  }

  const absolute = path.join(config.cwd, relative);
  const result: ExplainResult = {
    path: maskedPath,
    exists: fs.existsSync(absolute),
    included: false,
  };

  const collection = collectFiles(config.cwd, {
    includePatterns: config.include,
    excludePatterns: [...config.excludePatterns, ...config.presetExclude],
    includeSensitiveFiles: config.includeSensitiveFiles,
    secretRules: config.secretRules,
    // `explain` must enumerate files exactly as `generate` would, or it explains a
    // decision the generator never made.
    discovery: config.discovery,
    // Same exclusion `generate` applies, so `explain` never says "not-discovered" about a file
    // that is only missing because the walker dropped the tool's own output directory.
    toolOwnedPaths: [config.outDir, config.tmpDir]
      .map((directory) =>
        path.relative(config.cwd, path.resolve(config.cwd, directory)).replace(/\\/g, "/")
      )
      .filter((relative) => relative.length > 0 && !relative.startsWith("..")),
  });

  if (!collection.files.includes(relative)) {
    // `collectFiles` masks secret spans in the paths it records, so match either form.
    const record = collection.skipped.find(
      (entry) => entry.path === relative || entry.path === maskedPath
    );
    if (record) {
      result.reason = record.reason;
      result.detail = record.detail;
    } else if (!result.exists) {
      result.reason = "missing";
      result.detail = "no such file or directory, relative to the configured cwd";
    } else {
      // A file inside an ignored directory has no record of its own -- the walk
      // never descended -- so answer with the nearest ancestor's record instead
      // of the vague `not-discovered`. The ancestor is named so the answer stays
      // traceable to the rule that actually removed it.
      const ancestor = findRecordedAncestor(collection.skipped, relative, maskedPath);
      if (ancestor) {
        result.reason = ancestor.reason;
        result.detail = ancestor.detail
          ? `${ancestor.detail} — inherited from the skipped directory \`${ancestor.path}\``
          : `inside the skipped directory \`${ancestor.path}\``;
      } else {
        result.reason = "not-discovered";
        result.detail = "exists but is not tracked or is otherwise not a candidate";
      }
    }
    return result;
  }

  result.included = true;
  // A changed-files scope narrows what `generate` emits: a file outside it stays out of the
  // snapshot however includable it is. `explain` ignored the scope entirely and answered
  // `included: true` for exactly the files the generator would have recorded as `unchanged` —
  // the one thing an explanation must not do.
  if (config.changedSince !== undefined || config.staged === true) {
    let inScope: boolean;
    let scopeDetail = "";
    try {
      const scope = resolveChangedScope(config.cwd, {
        ...(config.changedSince === undefined ? {} : { changedSince: config.changedSince }),
        ...(config.staged === true ? { staged: true } : {}),
      });
      inScope = scope.paths.has(relative);
      if (!inScope && config.withDependents === true) {
        // `--with-dependents` widens the scope by one hop of importers, and `generate` applies
        // that hop. Explaining only the path set answered `included: false, reason: "unchanged"`
        // for exactly the files the snapshot contains, so the two accounts of one run disagreed.
        // The hop is answered from this file alone: the question is whether *it* imports
        // something that changed, which needs its own imports and nothing else's.
        inScope = importsChangedFile(
          relative,
          importsOfFile(relative, absolute),
          scope.paths,
          buildImportResolver(collection.files.map((file) => ({ relativePath: file })))
        );
      }
      scopeDetail = scope.detail;
    } catch (err) {
      // The scope is a fact about the repository this tool cannot reconstruct without git. Saying
      // "included" here would be a guess presented as an answer.
      result.included = false;
      result.reason = "unknown";
      result.detail = `the changed-files scope could not be resolved: ${(err as Error).message}`;
      return result;
    }
    if (!inScope) {
      result.included = false;
      result.reason = "unchanged";
      result.detail =
        `not ${scopeDetail}; the snapshot was generated with a changed-files scope, ` +
        "which keeps only the files that moved (plus dependents, with --with-dependents)";
      return result;
    }
  }
  // The inclusion decision comes first, and it has to be `generate`'s decision in
  // `generate`'s order (`src/index.ts`): a binary extension is skipped without reading, a file
  // past the read cap is sniffed before it is read, and below the cap the decode is the complete
  // check. The explanation used to ask only "is the content text?", so it answered
  // "included: true" for a file the very next run would drop — an `assets/logo.png` holding a
  // Git-LFS pointer is text, but generate skips it by extension and records `binary`.
  if (isBinaryExtension(absolute)) {
    result.included = false;
    result.reason = "binary";
    result.detail =
      "binary extension; generate skips it without reading and records `binary` in manifest.skipped[]";
    return result;
  }

  let sizeOnDisk: number | null = null;
  try {
    sizeOnDisk = fs.statSync(absolute).size;
  } catch {
    sizeOnDisk = null;
  }
  // Only a file too large to load is sniffed *before* it is read. Below the cap the decode
  // below is the complete check — it looks at every byte, not a head — and it reports why the
  // file is binary instead of a bare size. Sniffing first also opened the file, read it in
  // chunks and then read it again in full.
  if (sizeOnDisk !== null && sizeOnDisk > BINARY_SCAN_BYTES && isBinaryFile(absolute)) {
    result.included = false;
    result.reason = "binary";
    result.detail = "binary content; generate skips it and records `binary` in manifest.skipped[]";
    return result;
  }

  if (fs.existsSync(absolute) && fs.statSync(absolute).isFile()) {
    let buffer: Buffer;
    try {
      buffer = fs.readFileSync(absolute);
    } catch (err) {
      // `explain` exists to say why a file is not in the snapshot; one unreadable file must
      // produce that answer, not a stack trace that aborts a batch.
      result.included = false;
      result.reason = "read-error";
      result.detail = `${(err as Error).message} (explain could not read the file; generate records this as a skipped entry)`;
      return result;
    }
    // Decode the way `generate` decodes: a UTF-16 file is transcoded rather than reported as a
    // pile of NULs, and a lossy decode is stated instead of being passed off as clean text.
    const decoded = decodeText(buffer);
    if (decoded.binary) {
      result.included = false;
      result.reason = "binary";
      result.detail = `binary content (${decoded.binaryReason ?? "not text"}); generate skips it and records \`binary\` in manifest.skipped[]`;
      return result;
    }
    const text = decoded.text;
    result.bytes = buffer.length;
    result.lines = countLines(text);
    if (decoded.encoding !== "utf-8") result.encoding = decoded.encoding;

    const { findings } = scanAndRedactSecrets(text, config.secretRules, relative);
    result.secretCount = findings.length;
    result.secrets = findings
      .slice(0, 20)
      .map((finding) => ({ rules: finding.rules, line: finding.line }));

    // The inclusion mode is what `generate` would choose at *these* settings, not what the last
    // run happened to record. Reading it from the manifest made `--large-file-bytes` a no-op and
    // reported a stale answer after the threshold changed.
    let inclusionMode: ExplainResult["inclusionMode"] = "full";
    if (config.skeleton === true && isSkeletonizable(relative)) {
      const skeleton = skeletonizeTypeScript(text, relative);
      if (skeleton.collapsed > 0) inclusionMode = "signatures";
    }
    if (
      inclusionMode === "full" &&
      config.stripComments === true &&
      isCommentStrippable(relative) &&
      stripComments(text, relative).removed > 0
    ) {
      inclusionMode = "comments-stripped";
    }
    if (inclusionMode !== "signatures" && buffer.length > config.largeFileBytes) {
      const preview = truncatePreview(text, config.previewHeadLines, config.previewTailLines);
      inclusionMode = preview.isTruncated
        ? "preview"
        : inclusionMode === "comments-stripped"
          ? "comments-stripped"
          : "full";
    }
    result.inclusionMode = inclusionMode;
  }

  // Classification is for a file the snapshot would actually contain. Assigning it before the
  // skip decisions made `included: false` answers carry layer/kind/language, which the
  // documented JSON contract says a skipped path does not have.
  result.layer = classifyLayer(relative, config.layers);
  result.kind = classifyKind(relative, config.kinds);
  result.language = detectLanguage(relative);

  const layerRule = findRuleMatch(config.layers, relative);
  if (layerRule) result.layerMatch = describeMatcher(layerRule.match);
  const kindRule = findRuleMatch(config.kinds, relative);
  if (kindRule) result.kindMatch = describeMatcher(kindRule.match);

  const manifest = readManifest(config);
  const entry = Array.isArray(manifest?.files)
    ? manifest.files.find((file) => file.relativePath === relative)
    : undefined;
  result.part = entry?.part ?? null;

  // A selection (`--slice`, `--budget-tokens`) drops files that pass every per-file rule, so the
  // rules above cannot see it. The manifest is the record of that decision and is the only honest
  // source: without it the answer was "not in the last snapshot", which is true and useless.
  if (entry === undefined) {
    const record = manifest?.skipped?.find((skip) => skip.path === relative);
    if (record !== undefined && (record.reason === "not-selected" || record.reason === "unchanged")) {
      result.included = false;
      result.reason = record.reason;
      result.detail =
        record.detail ??
        (record.reason === "not-selected"
          ? "the snapshot was generated for a selection (--slice or --budget-tokens) that did not include this path"
          : "the snapshot was generated with a changed-files scope that did not include this path");
    }
  }

  return result;
}

/** Renders an explanation for a terminal. */
export function renderExplainText(result: ExplainResult): string {
  // Every value here can be repository-derived: the path, the layer and kind names (which a
  // committed `snapshot.config.*` may set), a manifest part name, a matched rule. A raw bidi
  // override or C1 control in one of them reorders the line or drives the terminal, so each value
  // is re-spelled as `\uXXXX` before it is padded and printed — the labels are fixed text.
  const lines: string[] = [escapeControls(result.path), ""];
  const row = (label: string, value: string): string =>
    `  ${label.padEnd(11)}${escapeControls(value)}`;

  if (!result.included) {
    lines.push(row("included", "no"));
    lines.push(row("reason", result.reason ?? "unknown"));
    if (result.detail) lines.push(row("detail", result.detail));
    return lines.join("\n");
  }

  lines.push(row("included", "yes"));
  lines.push(row("layer", `${result.layer}${result.layerMatch ? `   (rule ${result.layerMatch})` : ""}`));
  lines.push(row("kind", `${result.kind}${result.kindMatch ? `   (rule ${result.kindMatch})` : ""}`));
  lines.push(row("language", result.language ?? "text"));
  if (typeof result.lines === "number") {
    lines.push(row("size", `${result.bytes} B, ${result.lines} line(s)`));
  }
  lines.push(
    row(
      "part",
      result.part ?? "(not in the last snapshot; run generate)"
    )
  );
  if (result.inclusionMode) lines.push(row("inclusion", result.inclusionMode));
  if (result.encoding) lines.push(row("encoding", result.encoding));
  lines.push(
    row(
      "secrets",
      result.secretCount
        ? `${result.secretCount} finding(s): ${Array.from(
            new Set((result.secrets ?? []).flatMap((secret) => secret.rules))
          ).join(", ")}`
        : "none"
    )
  );

  return lines.join("\n");
}
</file>

<file path="tests/derivation-cache.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, resolveConfig } from "../dist/index.js";

/**
 * 0.9.14 — incremental derivation across runs in one process.
 *
 * `--watch` calls `generateSnapshot` again for every change, and every call re-read, re-decoded,
 * re-masked and re-parsed the whole repository. On a 3 000-file project that is seconds of work per
 * keystroke, almost none of it changed. The derivation cache keeps what is a pure function of
 * (bytes, settings, path) and reuses it when the hash of the bytes is the same.
 *
 * What must stay true is that it is *invisible*: two runs over unchanged files produce the same
 * manifest, and a run over a changed file produces the same manifest it would have produced cold.
 */

function makeRepo(t, fileCount, body) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "derivation-cache-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  for (let index = 0; index < fileCount; index += 1) {
    fs.writeFileSync(path.join(dir, "src", `f${index}.ts`), body(index), "utf8");
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const configFor = (dir, extra = {}) =>
  resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", ...extra }, {}, dir);

/** The parts of a manifest two runs must agree on to be called identical. */
const comparable = (manifest) => ({
  fingerprint: manifest.fingerprint,
  counts: manifest.counts,
  totals: manifest.totals,
  files: manifest.files.map((file) => ({
    path: file.relativePath,
    hash: file.hashSha256,
    inclusionMode: file.inclusionMode,
    includedBytes: file.includedBytes,
    includedLines: file.includedLines,
    summary: file.summary,
  })),
  parts: manifest.parts.map((part) => ({
    filename: part.filename,
    byteSize: part.byteSize,
    sha256: part.sha256,
    estimatedTokens: part.estimatedTokens,
  })),
});

test("a second generate over unchanged files produces the same manifest", (t) => {
  const dir = makeRepo(
    t,
    40,
    (index) => `export function fn${index}(input: number): number {\n  return input * ${index};\n}\n`
  );

  const first = generateSnapshot(configFor(dir));
  const second = generateSnapshot(configFor(dir));

  assert.deepEqual(comparable(second), comparable(first));
});

test("a changed file is re-derived, not reused", (t) => {
  const dir = makeRepo(t, 6, (index) => `export const value${index} = ${index};\n`);

  const first = generateSnapshot(configFor(dir));
  fs.writeFileSync(path.join(dir, "src", "f3.ts"), "export const value3 = 'changed';\n", "utf8");
  const second = generateSnapshot(configFor(dir));

  const before = first.files.find((file) => file.relativePath === "src/f3.ts");
  const after = second.files.find((file) => file.relativePath === "src/f3.ts");
  assert.notEqual(after.hashSha256, before.hashSha256, "the hash follows the content");
  assert.notEqual(second.fingerprint, first.fingerprint, "and so does the fingerprint");

  const part = fs.readFileSync(path.join(dir, "snapshot", "parts", after.part), "utf8");
  assert.match(part, /export const value3 = 'changed';/, "the new body reaches the part");
});

test("a file rewritten with the same size and timestamp is still re-derived", (t) => {
  // The cache is validated by content hash rather than by `mtime`, because a formatter or a
  // `git checkout` can rewrite a file within the same timestamp tick and with the same length.
  const dir = makeRepo(t, 3, (index) => `export const a${index} = 111;\n`);
  const target = path.join(dir, "src", "f1.ts");

  const before = fs.statSync(target);
  const first = generateSnapshot(configFor(dir));

  fs.writeFileSync(target, "export const a1 = 222;\n", "utf8");
  fs.utimesSync(target, before.atime, before.mtime);
  assert.equal(fs.statSync(target).size, before.size, "the file is the same length as before");

  const second = generateSnapshot(configFor(dir));
  const was = first.files.find((entry) => entry.relativePath === "src/f1.ts");
  const now = second.files.find((entry) => entry.relativePath === "src/f1.ts");
  assert.notEqual(now.hashSha256, was.hashSha256, "the new content is in the snapshot");
  const part = fs.readFileSync(path.join(dir, "snapshot", "parts", now.part), "utf8");
  assert.match(part, /222/);
});

test("a changed setting invalidates the derivation", (t) => {
  const body = "export const long = 1;\n".repeat(120);
  const dir = makeRepo(t, 2, () => body);

  const full = generateSnapshot(configFor(dir, { largeFileBytes: 100_000 }));
  assert.equal(
    full.files.find((file) => file.relativePath === "src/f0.ts").inclusionMode,
    "full"
  );

  // Same bytes, different settings: the cache key includes the settings digest, so this cannot
  // reuse the full-body derivation.
  const previewed = generateSnapshot(
    configFor(dir, { largeFileBytes: 100, previewHeadLines: 2, previewTailLines: 1 })
  );
  const file = previewed.files.find((entry) => entry.relativePath === "src/f0.ts");
  assert.equal(file.inclusionMode, "preview");
  assert.ok(file.includedBytes < file.sizeBytes);
});

test("a warm run does a fraction of a cold run's work", (t) => {
  // The point of the cache, measured in **CPU time** rather than wall clock. Twenty files of 4 000
  // lines each: almost all of the cold cost is per line — the masking pass runs 32 rules over every
  // line, and the parser builds an AST for the whole file — while almost all of the warm cost is
  // per byte, which is reading, hashing and partitioning.
  //
  // Wall clock is the number a user sees, and it is also the number this suite cannot measure: the
  // warm run's remaining wall time is mostly I/O, so a suite running files in parallel moves it by
  // an order of magnitude while leaving the ratio of work done alone. CPU time counts only this
  // process's own execution, which is what the cache actually removes. Measured 1 046 ms against
  // 48 ms — 21x — with a 3x assertion, so the margin is not a tolerance.
  const dir = makeRepo(t, 20, (index) => {
    const body = Array.from(
      { length: 4000 },
      (_value, line) =>
        `  const value${line} = compute(${index} + ${line}) * ${line}; // padding for the parser`
    ).join("\n");
    return `import { compute } from "./helpers.js";\n\nexport function work${index}(): number {\n${body}\n  return value0;\n}\n`;
  });
  fs.writeFileSync(path.join(dir, "src", "helpers.ts"), "export const compute = (n: number) => n;\n");

  const cpuSince = (start) => {
    const used = process.cpuUsage(start);
    return (used.user + used.system) / 1000;
  };

  const coldStart = process.cpuUsage();
  generateSnapshot(configFor(dir));
  const coldMs = cpuSince(coldStart);

  const warmStart = process.cpuUsage();
  generateSnapshot(configFor(dir));
  const warmMs = cpuSince(warmStart);

  assert.ok(
    warmMs * 3 < coldMs,
    `a warm run should do less than a third of the work (cold ${coldMs.toFixed(0)} ms CPU, warm ${warmMs.toFixed(0)} ms CPU)`
  );
});
