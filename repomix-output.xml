<file path="tests/assert-exact-spec.test.js">
import assert from "node:assert/strict";
import * as childProcess from "node:child_process";
import * as path from "node:path";
import test from "node:test";

import { readFileSync } from "node:fs";

/**
 * The deprecate/unpublish guard from the 0.9.16 audit (CI-02).
 *
 * `npm deprecate` and `npm unpublish` accept ranges, so the guard must accept only a release
 * version. A glob test is not a parse: `pkg@>=1.2.3` and `pkg@1.x.x` both have an `@` and two
 * dots.
 */

const name = JSON.parse(
  readFileSync(path.join(process.cwd(), "package.json"), "utf8")
).name;
const script = path.join(process.cwd(), "scripts", "assert-exact-spec.mjs");

const run = (spec) =>
  childProcess.spawnSync(process.execPath, [script, spec], {
    cwd: process.cwd(),
    encoding: "utf8",
  });

test("exact versions, including a prerelease, are accepted", () => {
  for (const spec of [`${name}@1.2.3`, `${name}@1.2.3-rc.1`]) {
    const result = run(spec);
    assert.equal(result.status, 0, `${spec}: ${result.stderr}`);
  }
});

test("ranges, wildcards, tags and other packages are refused", () => {
  for (const spec of [
    `${name}@>=1.2.3`,
    `${name}@1.2.*`,
    `${name}@1.x.x`,
    `${name}@^1.2.3`,
    `${name}@~1.2.3`,
    `${name}@latest`,
    `${name}@1.2.3 || 2.0.0`,
    "other-package@1.2.3",
    `${name}`,
  ]) {
    const result = run(spec);
    assert.equal(result.status, 1, `${spec} must be refused`);
    assert.match(result.stderr, /::error::/, `${spec} must say why`);
  }
});
</file>

<file path="tests/ast-edges.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  enforceBudget,
  estimateTokens,
  formatTokens,
  isTsxFileName,
  skeletonizeTypeScript,
  summarizeMarkdown,
  summarizeTypeScriptSource,
} from "../dist/index.js";

/**
 * AST and structural-summary edge cases from the 0.9.10 audit.
 *
 * Each of these is a case where the summary described a document that is not the one on disk —
 * the failure mode the whole tool exists to avoid.
 */

test("a .TSX file is treated as TypeScript-with-JSX, exactly like a .tsx one", () => {
  // Collapsing a body is span-based, so the two script kinds happen to produce the same text for
  // a simple component — an output comparison cannot prove which parser ran. The decision is
  // therefore tested directly, and `skeletonizeTypeScript` uses the same helper.
  assert.equal(isTsxFileName("src/Card.tsx"), true);
  assert.equal(isTsxFileName("src/Card.TSX"), true, "the case that used to fall through");
  assert.equal(isTsxFileName("src/card.ts"), false);

  const source = "export function Card() {\n  return <div className=\"c\" />;\n}\n";
  const lower = skeletonizeTypeScript(source, "src/Card.tsx");
  const upper = skeletonizeTypeScript(source, "src/Card.TSX");

  assert.ok(lower.collapsed > 0, "the lowercase fixture collapses");
  assert.equal(upper.text, lower.text, "and the uppercase spelling behaves identically");
});

test("an unclosed `---` is a horizontal rule, not frontmatter", () => {
  const summary = summarizeMarkdown("---\n\n# First\n\n## Second\n");

  assert.deepEqual(
    summary.headings,
    ["# First", "## Second"],
    "a rule at line 0 used to swallow every heading in the file"
  );
});

test("a closed frontmatter block still parses", () => {
  const summary = summarizeMarkdown("---\ntitle: Guide\n---\n\n# First\n");

  assert.deepEqual(summary.frontmatterKeys, ["title"]);
  assert.deepEqual(summary.headings, ["# First"]);
});

test("a shorter fence inside a longer one is content, not a close", () => {
  // One inner fence line, so the toggling cannot cancel itself out: with the fence stored as a
  // bare character, the three-backtick line closed the four-backtick block and `# b` was read as
  // a real heading.
  const summary = summarizeMarkdown(["````", "# a", "```", "# b", "````", "# Real heading", ""].join("\n"));

  assert.deepEqual(
    summary.headings,
    ["# Real heading"],
    "everything between the four-backtick fences is a code example"
  );
});

test("a closing fence with an info string does not close the block", () => {
  const summary = summarizeMarkdown(["```", "text", "```bash", "# still inside", "```", "# Outside", ""].join("\n"));

  assert.deepEqual(summary.headings, ["# Outside"]);
});

test("a tilde fence and a backtick fence do not pair with each other", () => {
  const summary = summarizeMarkdown(["~~~", "```", "# inside", "~~~", "# Outside", ""].join("\n"));

  assert.deepEqual(summary.headings, ["# Outside"]);
});

test("destructured exports are reported as exports", () => {
  const summary = summarizeTypeScriptSource(
    "src/destructured.ts",
    [
      "const source = { a: 1, b: 2 };",
      "export const { a, b } = source;",
      "export const [first, ...rest] = [1, 2, 3];",
      "export const { a: renamed } = source;",
      "",
    ].join("\n")
  );

  for (const name of ["a", "b", "first", "rest", "renamed"]) {
    assert.ok(
      summary.exports.includes(name),
      `\`${name}\` is bound by a destructuring export, so it is part of the module's surface: ${JSON.stringify(summary.exports)}`
    );
  }
});

test("an omitted array element does not become a symbol", () => {
  const summary = summarizeTypeScriptSource(
    "src/sparse.ts",
    "export const [, second] = [1, 2];\n"
  );

  assert.deepEqual(summary.exports, ["second"]);
});

test("a clipped part reports the token count of the text it actually holds", () => {
  // `rehashPart` runs only when `enforceBudget` cuts a part, and it used to update byteSize,
  // sha256 and lines while leaving `estimatedTokens` at its pre-clip value — so the part's own
  // header, its metadata and any report summing metadata all described text that had been cut.
  // The partitioner splits oversized sections rather than clipping them, so no end-to-end
  // fixture reaches this branch; the guard is exercised directly.
  const body = Array.from({ length: 400 }, (_, index) => `- line ${index}: ${"x".repeat(40)}`).join(
    "\n"
  );
  const markdown = `# Part 001\n\n- Files: 1\n- Estimated Tokens: ~100000\n\n## src/big.ts\n\n${body}\n`;
  const part = {
    filename: "part-001.md",
    markdown,
    metadata: {
      index: 1,
      filename: "part-001.md",
      byteSize: Buffer.byteLength(markdown, "utf8"),
      estimatedTokens: 100_000,
      budgetBytes: 4096,
      sha256: "placeholder",
      lines: 500,
      fileCount: 1,
      layersCovered: [],
      includedFiles: [],
    },
  };

  const [clipped] = enforceBudget([part], 4096);

  assert.ok(clipped.markdown.includes("cannot fit budget"), "the part really was clipped");
  assert.ok(clipped.metadata.byteSize <= 4096, "and it fits the budget it was clipped to");
  assert.notEqual(clipped.metadata.estimatedTokens, 100_000, "the pre-clip number is gone");
  // Every other part estimates the text *before* its own token line is inserted — that is what
  // `renderGroups` and `renumberParts` do — so a clipped part uses the same definition. Counting
  // the line that is about to be rewritten made the recorded total include the width of a number
  // that no longer exists in the file.
  const withoutTokenLine = clipped.markdown.replace(/^- Estimated Tokens: .*$/m, "");
  assert.equal(
    clipped.metadata.estimatedTokens,
    estimateTokens(withoutTokenLine),
    "the recorded count matches the definition every other part uses"
  );
  assert.match(
    clipped.markdown,
    new RegExp(`^- Estimated Tokens: ~${formatTokens(clipped.metadata.estimatedTokens)}$`, "m"),
    "and the header states the same number the metadata records"
  );
});

test("a file with only ES exports records exportsKind \"esm\"", () => {
  // `exportsKind` was assigned only on the CommonJS branch, so the value `esm` in the type was
  // unreachable and absence meant "this file had no exports" — false for every ES module.
  const esm = summarizeTypeScriptSource(
    "src/a.ts",
    "export const a = 1;\nexport function b() { return a; }\n"
  );
  assert.equal(esm.exportsKind, "esm");
  assert.deepEqual(esm.exports, ["a", "b"]);

  const empty = summarizeTypeScriptSource("src/empty.ts", "const local = 1;\n");
  assert.equal(empty.exportsKind, undefined, "no exports at all is the only meaning of absence");

  const cjs = summarizeTypeScriptSource("src/c.cjs", "module.exports = { a: 1 };\n");
  assert.equal(cjs.exportsKind, "cjs");

  const mixed = summarizeTypeScriptSource(
    "src/m.ts",
    "export const a = 1;\nmodule.exports.b = 2;\n"
  );
  assert.equal(mixed.exportsKind, "mixed");
});
</file>

<file path="tests/audit-0-9-16-remaining.test.js">
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as path from "node:path";
import test from "node:test";

import * as indexApi from "../dist/index.js";
import {
  appendGitignoreEntries,
  buildImportResolver,
  generateSnapshot,
  globToRegExp,
  importsChangedFile,
  loadConfigFileDetailed,
  resolveSpecifier,
  shouldCheck,
  summarizeTypeScriptSource,
  truncateToBytes,
  tsconfigPathsFor,
  validateSnapshot,
} from "../dist/index.js";
import { makeTempDir } from "./helpers/temp.js";

/**
 * The remaining entries from the 0.9.16 verified-bug report, plus the second report from a
 * CommonJS gateway.
 *
 * Each test is written against the failure it prevents, not the implementation: a staged edit
 * that is not what git commit would write, a deleted module whose dependents go missing, a lock
 * a reused pid wedges forever, an artifact that can be deleted while validate stays green, and
 * the redaction shapes that changed what a file meant.
 */

function write(dir, relativePath, content) {
  const target = path.join(dir, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
}

function sha256(text) {
  return crypto.createHash("sha256").update(text).digest("hex");
}

function git(dir, args) {
  return execFileSync("git", args, {
    cwd: dir,
    stdio: ["ignore", "pipe", "pipe"],
    encoding: "utf8",
  });
}

function canUseGit() {
  try {
    execFileSync("git", ["--version"], { stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
}

function initRepo(dir) {
  git(dir, ["init", "-q"]);
  git(dir, ["config", "user.email", "tests@example.invalid"]);
  git(dir, ["config", "user.name", "codebase-snapshot tests"]);
  git(dir, ["config", "core.autocrlf", "false"]);
}

function project(dir) {
  write(dir, "package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write(dir, "src/a.ts", "export const a = 1;\n");
  return dir;
}

function runCli(args) {
  const result = spawnSync(process.execPath, ["dist/bin.js", ...args], {
    cwd: path.resolve("."),
    encoding: "utf8",
  });
  return { code: result.status, stdout: result.stdout, stderr: result.stderr };
}

// ------------------------------------------------------- SCOPE-02: staged bytes

test("--staged reads the index, not further unstaged edits", (t) => {
  if (!canUseGit()) return t.skip("git is not installed");
  const dir = makeTempDir(t, "cbs-staged-");
  initRepo(dir);
  write(dir, "package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write(dir, "src/a.ts", "export const a = 1;\n");
  git(dir, ["add", "-A"]);
  git(dir, ["commit", "-qm", "base"]);

  const staged = "export const a = 2;\n";
  const working = "export const a = 3;\n";
  write(dir, "src/a.ts", staged);
  git(dir, ["add", "src/a.ts"]);
  write(dir, "src/a.ts", working);

  const manifest = generateSnapshot({ cwd: dir, staged: true });
  const entry = manifest.files.find((file) => file.relativePath === "src/a.ts");
  assert.ok(entry, "the staged path is in the snapshot");
  assert.equal(entry.hashSha256, sha256(staged), "the recorded hash is the staged blob");
  const part = fs.readFileSync(path.join(dir, "snapshot", "parts", entry.part), "utf8");
  assert.ok(part.includes("a = 2"), "the emitted body is the staged revision");
  assert.equal(part.includes("a = 3"), false, "the unstaged edit is not in the snapshot");
});

test("--staged records a staged deletion instead of dropping it", (t) => {
  if (!canUseGit()) return t.skip("git is not installed");
  const dir = makeTempDir(t, "cbs-staged-del-");
  initRepo(dir);
  write(dir, "package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write(dir, "src/a.ts", "export const a = 1;\n");
  git(dir, ["add", "-A"]);
  git(dir, ["commit", "-qm", "base"]);
  git(dir, ["rm", "-q", "src/a.ts"]);

  const manifest = generateSnapshot({ cwd: dir, staged: true });
  const record = manifest.skipped.find((entry) => entry.path === "src/a.ts");
  assert.ok(record, "the deletion must be recorded");
  assert.equal(record.reason, "deleted");
  assert.match(record.detail, /deletion|not part of the next commit/);
});

test("a tracked file deleted from disk is 'missing' with a detail, not a bare read-error", (t) => {
  if (!canUseGit()) return t.skip("git is not installed");
  const dir = makeTempDir(t, "cbs-missing-");
  initRepo(dir);
  write(dir, "package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write(dir, "src/a.ts", "export const a = 1;\n");
  git(dir, ["add", "-A"]);
  git(dir, ["commit", "-qm", "base"]);
  fs.rmSync(path.join(dir, "src/a.ts"));

  const manifest = generateSnapshot({ cwd: dir });
  const record = manifest.skipped.find((entry) => entry.path === "src/a.ts");
  assert.ok(record);
  assert.equal(record.reason, "missing");
  assert.ok(record.detail && record.detail.length > 0, "the operator can tell missing from unreadable");

  const validation = validateSnapshot({ cwd: dir });
  assert.ok(
    validation.warnings.some((warning) => /could not be read/.test(warning)),
    "validate surfaces the unreadable skip"
  );
});

// --------------------------------------------- SCOPE-03/04/05: import graph

test("a deleted module is a tombstone, so its importer is a dependent", () => {
  const resolver = buildImportResolver([{ relativePath: "src/b.ts" }], {
    extraPaths: ["src/a.ts"],
  });
  assert.equal(resolveSpecifier("src/b.ts", "./a", resolver), "src/a.ts");
  assert.equal(
    importsChangedFile("src/b.ts", ["./a"], new Set(["src/a.ts"]), resolver),
    true,
    "the caller of a deleted module is exactly what the change breaks"
  );
});

test("tsconfig paths resolve to a file in the repository", (t) => {
  const dir = makeTempDir(t, "cbs-tsconfig-");
  write(
    dir,
    "tsconfig.json",
    JSON.stringify({ compilerOptions: { baseUrl: ".", paths: { "@/*": ["src/*"] } } })
  );
  write(dir, "src/lib/db.ts", "export const db = 1;\n");
  write(dir, "src/app/page.ts", 'import { db } from "@/lib/db";\n');

  const tsconfigPaths = tsconfigPathsFor(dir);
  assert.ok(tsconfigPaths, "the tsconfig is read");
  const resolver = buildImportResolver(
    [{ relativePath: "src/app/page.ts" }, { relativePath: "src/lib/db.ts" }],
    { tsconfig: tsconfigPaths }
  );
  assert.equal(
    resolveSpecifier("src/app/page.ts", "@/lib/db", resolver),
    "src/lib/db.ts",
    "an alias is a real edge, not a missing one"
  );
});

test("SCOPE-08: ** inside a segment does not cross a directory", () => {
  assert.equal(globToRegExp("src/a**b.ts").test("src/a/x/b.ts"), false);
  assert.equal(globToRegExp("src/a**b.ts").test("src/aXb.ts"), true);
  assert.equal(globToRegExp("src/**/b.ts").test("src/b.ts"), true);
  assert.equal(globToRegExp("src/**/b.ts").test("src/a/b.ts"), true);
  assert.equal(globToRegExp("src/**").test("src/a/b.ts"), true);
});

test("SCOPE-09: a UTF-16 .gitignore survives an update, and entries are deduped by meaning", (t) => {
  const dir = makeTempDir(t, "cbs-gitignore-");
  const bom = Buffer.from([0xff, 0xfe]);
  const text = "node_modules\r\n/snapshot/\r\n";
  fs.writeFileSync(path.join(dir, ".gitignore"), Buffer.concat([bom, Buffer.from(text, "utf16le")]));

  const update = appendGitignoreEntries(dir, ["/snapshot/", "/snapshot.tmp/"]);
  assert.deepEqual(update.added, ["/snapshot.tmp/"], "the equivalent entry is not appended again");

  const raw = fs.readFileSync(path.join(dir, ".gitignore"));
  assert.deepEqual([...raw.subarray(0, 2)], [0xff, 0xfe], "the byte-order mark survives");
  const decoded = raw.subarray(2).toString("utf16le");
  assert.ok(decoded.startsWith("node_modules\r\n/snapshot/\r\n"));
  assert.ok(decoded.includes("/snapshot.tmp/"));
});

// ------------------------------------------------------- FS-06: lock heartbeat

test("FS-06: a live pid with a stale heartbeat is reclaimed", (t) => {
  const dir = makeTempDir(t, "cbs-lock-hb-");
  project(dir);
  const tmpDir = path.join(dir, "snapshot.tmp");
  fs.mkdirSync(tmpDir, { recursive: true });
  const lockPath = indexApi.lockPathFor(fs.realpathSync(tmpDir));
  t.after(() => fs.rmSync(lockPath, { force: true }));

  // The pid is this (live) process; the heartbeat is ten minutes old. A reused pid and a hung
  // run must not wedge the directory forever.
  fs.writeFileSync(lockPath, JSON.stringify({ pid: process.pid }));
  const old = new Date(Date.now() - 10 * 60 * 1000);
  fs.utimesSync(lockPath, old, old);

  const manifest = generateSnapshot({ cwd: dir });
  assert.ok(manifest.parts.length > 0, "the run completed");
  assert.equal(fs.existsSync(lockPath), false, "the stale lock was reclaimed and released");
});

// ---------------------------------------------- FS-07: an async hook holds the lock

test("FS-07: an async hook keeps the output lock until it settles", async (t) => {
  const dir = makeTempDir(t, "cbs-hook-lock-");
  project(dir);
  let releaseHook;
  const hookDone = new Promise((resolve) => {
    releaseHook = resolve;
  });
  generateSnapshot({
    cwd: dir,
    hooks: {
      afterGenerate: () => hookDone,
    },
  });

  assert.throws(
    () => generateSnapshot({ cwd: dir }),
    /Another generate run is already using/,
    "a second run must not publish over the hook's writes"
  );

  releaseHook();
  await new Promise((resolve) => setTimeout(resolve, 150));
  const second = generateSnapshot({ cwd: dir });
  assert.ok(second.parts.length > 0, "the lock is released once the hook settles");
});

