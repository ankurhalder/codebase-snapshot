<file path="tests/manifest-shape-guard.test.js">
/**
 * One manifest-shape guard for `validate`, `report` and `diff`.
 *
 * The audit found three answers to one question: `validate` called a snapshot whose
 * `fingerprint` had been deleted "valid and up to date" (exit 0), `report` printed
 * `undefined` for the same file, and `diff` rejected it — each command had its own
 * idea of what a manifest is. The guard lives in `src/validator/validate.ts`
 * (`describeManifestShapeProblem`) and every command must call it.
 *
 * The tests drive the real CLI, because the point is what the commands do, and they
 * mutate a manifest generated in the same run so the only difference under test is
 * the shape.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const BIN = path.join(REPO, "dist", "bin.js");

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "manifest-shape-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function cli(cwd, args) {
  const run = spawnSync("node", [BIN, ...args], { cwd, encoding: "utf8" });
  if (run.error) throw run.error;
  return { code: run.status ?? 1, stdout: run.stdout ?? "", stderr: run.stderr ?? "" };
}

/** A repository with one source file and a real snapshot to mutate. */
function makeSnapshot(t) {
  const repo = tempDir(t);
  fs.mkdirSync(path.join(repo, "src"));
  fs.writeFileSync(path.join(repo, "package.json"), '{"name":"shape","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(repo, "src", "a.ts"), "export const a = 1;\n");
  const generated = cli(repo, ["generate", "--no-config", "--cwd", repo]);
  assert.equal(generated.code, 0, `generate failed: ${generated.stderr}`);
  const manifestPath = path.join(repo, "snapshot", "manifest.json");
  return { repo, manifestPath, manifest: JSON.parse(fs.readFileSync(manifestPath, "utf8")) };
}

/** A copy of the repository whose manifest has been changed by `change`. */
function mutatedRepo(t, base, change) {
  const repo = path.join(tempDir(t), "repo");
  fs.cpSync(base.repo, repo, { recursive: true });
  const manifestPath = path.join(repo, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  change(manifest);
  fs.writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`);
  return repo;
}

const SHAPE_CASES = [
  ["a deleted fingerprint", (m) => delete m.fingerprint, /fingerprint/],
  ["a deleted generatedAt", (m) => delete m.generatedAt, /generatedAt/],
  ["a deleted schemaVersion", (m) => delete m.schemaVersion, /schemaVersion/],
  ["a five-character fingerprint", (m) => (m.fingerprint = "12345"), /fingerprint/],
  ["an uppercase fingerprint", (m) => (m.fingerprint = "A".repeat(64)), /fingerprint/],
  ["a deleted totals object", (m) => delete m.totals, /totals/],
];

test("validate, report and diff reject the same malformed manifests", async (t) => {
  const base = makeSnapshot(t);

  for (const [label, change, field] of SHAPE_CASES) {
    const repo = mutatedRepo(t, base, change);

    await t.test(`validate rejects ${label}`, () => {
      const result = cli(repo, ["validate", "--cwd", repo]);
      assert.equal(result.code, 1, `validate accepted ${label}: ${result.stdout}${result.stderr}`);
      assert.match(result.stderr, /is not a snapshot manifest/);
      assert.match(result.stderr, field);
      assert.doesNotMatch(result.stdout, /valid and up to date/i);
      const messages = result.stderr.split("\n").filter((line) => /is not a snapshot manifest/.test(line));
      assert.equal(messages.length, 1, "exactly one shape message");
    });

    await t.test(`diff rejects ${label}`, () => {
      const result = cli(repo, ["diff", path.join(repo, "snapshot"), base.manifestPath]);
      assert.equal(result.code, 1, `diff accepted ${label}: ${result.stdout}${result.stderr}`);
      assert.match(result.stderr, /is not a snapshot manifest/);
      assert.match(result.stderr, field);
      assert.equal(result.stdout.trim(), "", "no partial diff output");
    });

    await t.test(`report rejects ${label}`, () => {
      const result = cli(repo, ["report", "--cwd", repo]);
      // This subtest used to skip: `report` had its own copy of the shape guard. It now imports
      // the shared one, and the skip made a real answer unreachable — the file reported "skipped
      // 0" while still containing a branch that could never run.
      assert.equal(result.code, 1, `report accepted ${label}: ${result.stdout}${result.stderr}`);
      assert.match(result.stderr, /is not a snapshot manifest/);
      assert.match(result.stderr, field);
      assert.doesNotMatch(result.stdout, /Snapshot Report/);
      // The sentence is the same one `validate` and `diff` print for the same file.
      assert.match(result.stderr, /❌ /);
    });
  }
});

test("diff reports a schemaVersion mismatch instead of ignoring it", (t) => {
  const base = makeSnapshot(t);
  const mutated = path.join(base.repo, "manifest-9.json");
  fs.writeFileSync(
    mutated,
    `${JSON.stringify({ ...base.manifest, schemaVersion: "9.9.9" }, null, 2)}\n`
  );

  const text = cli(base.repo, ["diff", base.manifestPath, mutated]);
  const shown = `${text.stdout}${text.stderr}`;
  assert.equal(text.code, 0, `diff crashed on a schemaVersion mismatch: ${shown}`);
  assert.match(shown, /schema version 3\.0\.0 → 9\.9\.9/);
  assert.match(shown, /payload\/configuration differs/);

  const json = cli(base.repo, ["diff", base.manifestPath, mutated, "--format", "json"]);
  assert.equal(json.code, 0, json.stderr);
  const payload = JSON.parse(json.stdout);
  assert.deepEqual(payload.payload.schemaVersion, { before: base.manifest.schemaVersion, after: "9.9.9" });
  assert.equal(payload.payload.differs, true, "a schema mismatch is a difference");
  assert.equal(payload.payload.configurationDiffers, true);
  assert.equal(payload.added.length + payload.removed.length + payload.changed.length, 0, "no file changed");
});

test("diff reports a changed parts manifest", (t) => {
  const base = makeSnapshot(t);
  assert.ok(base.manifest.parts.length > 0, "the fixture generated at least one part");
  const mutated = path.join(base.repo, "manifest-repacked.json");
  const manifest = JSON.parse(JSON.stringify(base.manifest));
  manifest.parts[0].byteSize += 7;
  manifest.parts[0].sha256 = "b".repeat(64);
  fs.writeFileSync(mutated, `${JSON.stringify(manifest, null, 2)}\n`);

  const text = cli(base.repo, ["diff", base.manifestPath, mutated]);
  const shown = `${text.stdout}${text.stderr}`;
  assert.equal(text.code, 0, shown);
  assert.match(shown, /parts manifest differs/);
  assert.match(shown, /byteSize/);

  const json = cli(base.repo, ["diff", base.manifestPath, mutated, "--format", "json"]);
  assert.equal(json.code, 0, json.stderr);
  const payload = JSON.parse(json.stdout);
  assert.equal(payload.payload.partsManifest.differs, true);
  assert.ok(payload.payload.partsManifest.changes.some((line) => /byteSize/.test(line)));
  assert.equal(payload.added.length + payload.removed.length + payload.changed.length, 0);
});

test("diff rejects a manifest whose parts array is missing", (t) => {
  const base = makeSnapshot(t);
  const broken = path.join(base.repo, "manifest-no-parts.json");
  const manifest = { ...base.manifest };
  delete manifest.parts;
  fs.writeFileSync(broken, `${JSON.stringify(manifest, null, 2)}\n`);

  const result = cli(base.repo, ["diff", base.manifestPath, broken]);
  assert.equal(result.code, 1, `diff accepted a manifest without parts: ${result.stdout}`);
  assert.match(result.stderr, /parts/);
  assert.equal(result.stdout.trim(), "", "no partial diff output");
});

test("a well-formed snapshot still validates after the guard", (t) => {
  const base = makeSnapshot(t);
  const result = cli(base.repo, ["validate", "--cwd", base.repo]);
  assert.equal(result.code, 0, `a valid snapshot was rejected: ${result.stdout}${result.stderr}`);
});
</file>

<file path="tests/mcp-contract.test.js">
/**
 * The contract must not lie about the server.
 *
 * One side of every comparison here comes from the CLI binary (`describe --format json`), the
 * other from a live server session built by the library. They are different code paths over the
 * same objects, so a tool the server serves but the contract never mentions — or a flag the parser
 * accepts on `mcp` that the contract claims applies elsewhere — fails here rather than in a
 * client.
 */
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";
import { createServer } from "../dist/mcp.js";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

function describeContract() {
  const stdout = execFileSync(process.execPath, ["dist/bin.js", "describe", "--format", "json"], {
    cwd: ROOT,
    encoding: "utf8",
  });
  return JSON.parse(stdout);
}

async function liveSession(root = ROOT) {
  const server = createServer({ cwd: root, log: () => {} });
  await server.handle({
    jsonrpc: "2.0",
    id: 1,
    method: "initialize",
    params: { protocolVersion: "2025-11-25", capabilities: {} },
  });
  await server.handle({ jsonrpc: "2.0", method: "notifications/initialized" });

  const call = async (id, method, params) => {
    const response = await server.handle({ jsonrpc: "2.0", id, method, params });
    assert.ok(response && response.result, `${method} returned a result`);
    return response.result;
  };

  return {
    server,
    tools: (await call(2, "tools/list")).tools,
    prompts: (await call(3, "prompts/list")).prompts,
    resources: (await call(4, "resources/list")).resources,
    templates: (await call(5, "resources/templates/list")).resourceTemplates,
  };
}

test("every tool the server serves is in the contract, with the same schema", async () => {
  const contract = describeContract();
  const live = await liveSession();

  assert.deepEqual(
    live.tools.map((tool) => tool.name),
    contract.mcp.tools.map((tool) => tool.name),
    "the contract lists the tools in the order the server serves them"
  );

  for (const tool of live.tools) {
    const described = contract.mcp.tools.find((candidate) => candidate.name === tool.name);
    assert.ok(described, `${tool.name} is described`);
    assert.deepEqual(
      Object.keys(tool.inputSchema.properties),
      described.parameters,
      `${tool.name}: contract parameters match the served schema`
    );
    assert.deepEqual(
      tool.inputSchema.required ?? [],
      described.required,
      `${tool.name}: required arguments match`
    );
    assert.equal(tool.annotations.readOnlyHint, described.readOnly, `${tool.name}: hints match`);
    assert.equal(tool.description, described.summary, `${tool.name}: description matches`);
  }
});

test("prompts, resources and templates are described exactly as served", async () => {
  const contract = describeContract();
  const live = await liveSession();

  assert.deepEqual(
    live.prompts.map((prompt) => prompt.name),
    contract.mcp.prompts.map((prompt) => prompt.name)
  );
  assert.deepEqual(
    live.templates.map((template) => template.uriTemplate),
    contract.mcp.resourceTemplates
  );

  const servedUris = new Set(live.resources.map((resource) => resource.uri));
  for (const uri of contract.mcp.resources) {
    assert.ok(servedUris.has(uri), `${uri} is described in the contract and served`);
  }
});

test("the advertised protocol versions match the contract", async () => {
  const contract = describeContract();
  const { server } = await liveSession(ROOT);
  const discovered = await server.handle({ jsonrpc: "2.0", id: 9, method: "server/discover" });
  const expected = [...contract.mcp.protocolVersions.modern, ...contract.mcp.protocolVersions.legacy];
  assert.deepEqual(discovered.result.supportedVersions, expected);
  assert.equal(discovered.result.resultType, "complete");
});

test("the mcp command is documented, and --cwd is scoped to it", () => {
  const contract = describeContract();

  const command = contract.commands.find((entry) => entry.name === "mcp");
  assert.ok(command, "mcp is a documented command");
  assert.deepEqual(command.exits, [0, 2]);

  const cwd = contract.options.find((option) => option.flag === "--cwd");
  assert.match(cwd.appliesTo, /(?:^|\/)mcp(?:\/|$)/, "--cwd applies to mcp");

  // --format has no meaning on a JSON-RPC stream, so the contract must not claim it does.
  const format = contract.options.find((option) => option.flag === "--format");
  assert.doesNotMatch(format.appliesTo, /(?:^|\/)mcp(?:\/|$)/);
});

test("mcp refuses a flag it does not apply", () => {
  let failed = false;
  try {
    execFileSync(process.execPath, ["dist/bin.js", "mcp", "--format", "json"], {
      cwd: ROOT,
      stdio: ["ignore", "pipe", "pipe"],
    });
  } catch (error) {
    failed = true;
    assert.equal(error.status, 2, "a flag outside the command's scope is a usage error");
    assert.match(String(error.stderr), /--format does not apply/);
  }
  assert.ok(failed, "mcp --format must fail rather than start a server");
});

test("every static resource the contract publishes is served, in the same order", async () => {
  const contract = describeContract();
  const live = await liveSession();
  // The parts are discovered from the manifest, so they are the one family the contract cannot
  // list by URI. Everything else is fixed, and `describe` promising a resource the server does
  // not serve (or missing one it does) is the contract lying about itself.
  const served = live.resources
    .map((resource) => resource.uri)
    .filter((uri) => !uri.startsWith("snapshot://parts/"));
  assert.deepEqual(served, contract.mcp.resources);
});
</file>

<file path="tests/mcp-dependents.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { buildTools } from "../dist/mcp.js";

/**
 * `snapshot_dependents`, from the 0.9.9 audit.
 *
 * `manifest.indexes.imports` already held the graph — `byFile` recorded every file's import
 * specifiers and `centralFiles` ranked the most-imported ones — but nothing an agent could
 * ask. "What breaks if I change this?" was answered by reading parts until the picture
 * appeared, which is the cost the snapshot exists to remove.
 */

const tools = new Map(buildTools().map((tool) => [tool.name, tool]));
const contextFor = (root) => ({ cwd: root, roots: [root], log: () => {} });

async function call(name, args, context) {
  const tool = tools.get(name);
  assert.ok(tool, `tool ${name} exists`);
  return tool.handler(args, context);
}

function makeProject(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "mcp-dependents-"));
  const write = (relative, content) => {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write("src/b.ts", "export const b = 1;\n");
  write("src/a.ts", 'import { b } from "./b.js";\nimport fs from "node:fs";\nexport const a = b + 1;\n');
  write("src/c.ts", 'import { a } from "./a.js";\nexport const c = a + 1;\n');
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

test("it answers in both directions", async (t) => {
  const root = makeProject(t);
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const middle = await call("snapshot_dependents", { path: "src/a.ts" }, context);
  assert.ok(!middle.isError, middle.text);

  assert.deepEqual(
    middle.structured.importedBy.map((entry) => entry.path),
    ["src/c.ts"],
    "src/c.ts is the only importer"
  );
  assert.deepEqual(
    middle.structured.imports.map((entry) => entry.path),
    ["src/b.ts"],
    "the relative specifier resolved to the file in the snapshot"
  );
  // A bare package specifier cannot resolve to a snapshot file, and saying so is more useful
  // than pretending the edge does not exist.
  assert.deepEqual(middle.structured.unresolved, ["node:fs"]);
  assert.match(middle.text, /1 importer\(s\), 1 import\(s\), 1 outside the snapshot/);

  const leaf = await call("snapshot_dependents", { path: "src/b.ts" }, context);
  assert.deepEqual(leaf.structured.imports, [], "the leaf imports nothing");
  assert.deepEqual(leaf.structured.importedBy.map((entry) => entry.path), ["src/a.ts"]);
});

test("direction narrows the answer", async (t) => {
  const root = makeProject(t);
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const forward = await call("snapshot_dependents", { path: "src/a.ts", direction: "imports" }, context);
  assert.equal(forward.structured.importedBy.length, 0, "not asked for importers");

  const backward = await call(
    "snapshot_dependents",
    { path: "src/a.ts", direction: "imported-by" },
    context
  );
  assert.equal(backward.structured.imports.length, 0, "not asked for imports");
  assert.equal(backward.structured.importedBy.length, 1);
});

test("a path outside the snapshot is refused with the next step", async (t) => {
  const root = makeProject(t);
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const missing = await call("snapshot_dependents", { path: "src/nope.ts" }, context);
  assert.ok(missing.isError, "an unknown path is a tool error, not an empty answer");
  assert.match(missing.text, /snapshot_locate/);
});

test("the resolver agrees with the generator's own graph", async (t) => {
  const root = makeProject(t);
  const context = contextFor(root);
  await call("snapshot_generate", {}, context);

  const manifest = JSON.parse(
    fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8")
  );
  // `centralFiles` is built by the generator from the same edges this tool walks.
  const central = manifest.indexes.imports.centralFiles.find((entry) => entry.path === "src/b.ts");
  assert.ok(central, "src/b.ts is in the generator's centrality ranking");
  assert.equal(central.importedByCount, 1);

  const answer = await call("snapshot_dependents", { path: "src/b.ts", direction: "imported-by" }, context);
  assert.equal(
    answer.structured.importedBy.length,
    central.importedByCount,
    "the tool and the manifest count the same edges"
  );
});

test("a previewed importer is still an importer", async (t) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "mcp-dependents-preview-"));
  const write = (relative, content) => {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  // A preview threshold low enough that the importer is emitted as a head/tail excerpt — and a
  // previewed file has no structural summary, which is exactly the case that used to vanish from
  // the import index.
  write("snapshot.config.json", '{ "outDir": "snapshot", "largeFileBytes": 1024 }\n');
  write("src/changed.ts", "export const changed = 1;\n");
  write(
    "src/big-consumer.ts",
    'import { changed } from "./changed.js";\n' +
      // Long enough that the head/tail window (80 + 40 lines) cannot hold it: a file that fits
      // those windows is emitted whole even above the threshold.
      Array.from({ length: 200 }, (_, index) => `export const value${index} = changed + ${index};`).join("\n") +
      "\n"
  );
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));

  const context = contextFor(root);
  const generated = await call("snapshot_generate", {}, context);
  assert.ok(!generated.isError, generated.text);

  const manifest = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  const consumer = manifest.files.find((file) => file.relativePath === "src/big-consumer.ts");
  assert.equal(consumer.inclusionMode, "preview", "the importer really is previewed");
  assert.equal(consumer.summary, undefined, "and has no structural summary");

  const entry = manifest.indexes.imports.byFile.find((file) => file.path === "src/big-consumer.ts");
  assert.ok(entry, "the previewed importer is in indexes.imports.byFile");
  assert.deepEqual(entry.imports, ["./changed.js"]);
  assert.equal(entry.exportsOmitted, true, "its export list says it was not read");

  const central = manifest.indexes.imports.centralFiles.find((file) => file.path === "src/changed.ts");
  assert.ok(central, "the imported file is ranked in centralFiles");
  assert.equal(central.importedByCount, 1);

  // The tool reads `byFile`; before the index included previewed files, this answered
  // "0 importer(s)" for a file that has one — while the file was in the snapshot *because* it
  // imports that file.
  const answer = await call(
    "snapshot_dependents",
    { path: "src/changed.ts", direction: "imported-by" },
    context
  );
  assert.ok(!answer.isError, answer.text);
  assert.deepEqual(
    answer.structured.importedBy.map((item) => item.path),
    ["src/big-consumer.ts"]
  );
});
</file>

<file path="tests/mcp-plan-offthread.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { buildTools } from "../dist/mcp.js";

/**
 * `snapshot_plan` reads and parses every file in the repository, so it blocks the server for as
 * long as a generate does — the failure the worker thread was added to fix. The worker was applied
 * to one of the two generate call sites.
 *
 * The threading itself has no observable output: a dry run writes nothing either way, and a
 * tool-call timeout is what the fix prevents, not what it produces. So the wiring is asserted from
 * the source text — the same technique this repository uses for the three properties that have no
 * behavioural signal — and the behaviour (same numbers, nothing written, config honoured) is
 * asserted against the tool.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const TOOLS_SOURCE = fs.readFileSync(path.join(HERE, "..", "src", "mcp", "tools.ts"), "utf8");
const WORKER_SOURCE = fs.readFileSync(
  path.join(HERE, "..", "src", "mcp", "generate-worker.ts"),
  "utf8"
);

const tools = new Map(buildTools().map((tool) => [tool.name, tool]));
const contextFor = (root) => ({ cwd: root, roots: [root], log: () => {} });

async function call(name, args, context) {
  const tool = tools.get(name);
  assert.ok(tool, `tool ${name} exists`);
  return tool.handler(args, context);
}

function makeProject(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "mcp-plan-"));
  const write = (relative, content) => {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write("src/a.ts", "export const a = 1;\n");
  write("src/b.ts", "export const b = 2;\n");
  write("notes/ignored.md", "# ignored\n");
  // A config the *worker* has to load: if the tool planned from the calling thread's resolved
  // config, the exclusion would still apply, so this is a shape check rather than a discriminator.
  write("snapshot.config.json", '{ "outDir": "ctx", "excludePatterns": ["notes/**"] }\n');
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

test("snapshot_plan does its generate on the worker thread", () => {
  const plan = TOOLS_SOURCE.slice(TOOLS_SOURCE.indexOf("const planTool"));
  const generate = TOOLS_SOURCE.slice(TOOLS_SOURCE.indexOf("const generateTool"));

  assert.match(
    plan,
    /await generateInWorker\(\s*workspace\.root,\s*workspace\.cliOptions,\s*\{ dryRun: true \}/,
    "the plan handler must await the worker with a dry run"
  );
  assert.doesNotMatch(plan, /generateSnapshot\(/, "and must not generate on the RPC thread");
  assert.match(generate, /await generateInWorker\(/, "the generate handler keeps its worker call");
  assert.match(
    WORKER_SOURCE,
    /workerData\.dryRun === true/,
    "the worker applies the dry-run flag it is given"
  );
  assert.match(WORKER_SOURCE, /dryRun: options\.dryRun === true/, "the caller passes it across");
});

test("a plan reports the run it would make and writes nothing", async (t) => {
  const root = makeProject(t);
  const context = contextFor(root);

  const plan = await call("snapshot_plan", {}, context);
  assert.ok(!plan.isError, plan.text);
  assert.match(plan.text, /Dry run — nothing was written/);
  assert.equal(plan.structured.preset, "node-lib", "the fixture is a Node library");
  // package.json, snapshot.config.json, src/a.ts, src/b.ts — and notes/ignored.md is skipped by
  // the config's excludePatterns, which is the part that proves the worker loaded the file.
  assert.equal(plan.structured.files, 4);
  assert.equal(plan.structured.skipped, 1);
  assert.deepEqual(plan.structured.skipReasons, [{ reason: "excluded", count: 1 }]);
  assert.ok(plan.structured.parts >= 1);
  assert.ok(!fs.existsSync(path.join(root, "ctx")), "a plan writes no output directory");
  assert.ok(
    !fs.existsSync(path.join(root, "snapshot")),
    "and not the default one either"
  );

  // The same numbers a real dry run would produce, from the manifest the tool asks for.
  const generated = await call("snapshot_generate", {}, context);
  assert.ok(!generated.isError, generated.text);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "ctx", "manifest.json"), "utf8"));
  assert.equal(plan.structured.files, manifest.counts.totalFiles);
  assert.equal(plan.structured.parts, manifest.counts.partsCount);
  assert.equal(plan.structured.skipped, manifest.counts.skippedCount);
  assert.equal(plan.structured.emittedBytes, manifest.totals.totalContentBytes);
});

test("a plan lists the skip reasons the worker ranked", async (t) => {
  const root = makeProject(t);
  const context = contextFor(root);
  const plan = await call("snapshot_plan", { root: "." }, context);
  assert.ok(!plan.isError, plan.text);
  assert.ok(Array.isArray(plan.structured.skipReasons));
  assert.ok(
    plan.structured.skipReasons.every((entry) => typeof entry.reason === "string" && entry.count > 0),
    JSON.stringify(plan.structured.skipReasons)
  );
  for (const entry of plan.structured.skipReasons) {
    assert.match(plan.text, new RegExp(`${entry.reason.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")} \\(${entry.count}\\)`));
  }
});
