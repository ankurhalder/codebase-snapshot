const CONFIG_CANDIDATES = [
  "snapshot.config.ts",
  "snapshot.config.js",
  "snapshot.config.mjs",
  "snapshot.config.cjs",
  "snapshot.config.json",
  ".snapshotrc.json",
  ".snapshotrc",
];

/**
 * Parses `package.json` the way the rest of this tool parses JSON files.
 *
 * `JSON.parse` rejects a UTF-8 BOM — `Unexpected token '\uFEFF'` — and `findConfigFile` has read
 * `package.json` through `stripJsonComments` since 0.9.13, so the two disagreed about whether a
 * project was configured. Every reader in this file caught the throw and reported the ordinary,
 * wrong answer: an existing `"snapshot"` block was invisible, `"type": "module"` was invisible (so
 * `init` chose `.mjs` for a project that could have had `.ts`), and the scripts and devDependency
 * were skipped with a note.
 *
 * A BOM is what a Windows editor writes when it saves a file as UTF-8; it is not a malformed
 * package.
 */
function parsePackageJson(raw: string): Record<string, unknown> {
  const parsed: unknown = JSON.parse(stripJsonComments(raw));
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
    throw new Error("package.json is not a JSON object");
  }
  return parsed as Record<string, unknown>;
}

/** Reads and parses `package.json`, or returns null when there is nothing usable to read. */
function readPackageJson(cwd: string): Record<string, unknown> | null {
  try {
    return parsePackageJson(fs.readFileSync(path.join(cwd, "package.json"), "utf8"));
  } catch {
    return null;
  }
}

/**
 * Picks the config filename this project can actually load.
 *
 * A `.ts` config is only usable when Node can strip types *and* the package is an
 * ES module: Node applies the enclosing `package.json` `type` field to a `.ts`
 * file, so an `export default` config in a CommonJS project fails to load. That
 * made `codebase-snapshot init` write a file the next `codebase-snapshot generate` refused to read. `.mjs`
 * works everywhere, so it is the safe default.
 */
export function chooseConfigFileName(cwd: string): string {
  if (!supportsTypeScriptImports()) return "snapshot.config.mjs";
  const parsed = readPackageJson(cwd);
  return parsed?.type === "module" ? "snapshot.config.ts" : "snapshot.config.mjs";
}

const SIZE_CHOICES: Array<{ value: string; label: string; hint: string }> = [
  { value: "60k", label: "Small", hint: "60 KB · ~15k tokens · tight context windows" },
  { value: "120k", label: "Medium", hint: "120 KB · ~30k tokens · recommended" },
  { value: "300k", label: "Large", hint: "300 KB · ~75k tokens · the default" },
  { value: "custom", label: "Custom…", hint: "type a size like 150k or 1.5mb" },
];

/**
 * True when `package.json` already carries a `"snapshot"` config block.
 *
 * `init` used to ignore it and write a file that then took precedence, silently
 * changing the effective settings of a repository that was already configured.
 */
function packageJsonHasConfig(cwd: string): boolean {
  const parsed = readPackageJson(cwd);
  if (parsed === null) return false;
  // `typeof [] === "object"`: an array is a wrong type like a string or a number, not a config.
  return (
    typeof parsed.snapshot === "object" &&
    parsed.snapshot !== null &&
    !Array.isArray(parsed.snapshot)
  );
}

function artifactAnswers(options: InitOptions): Required<ArtifactSelection> {
  const artifacts: Required<ArtifactSelection> = { ...DEFAULT_ANSWERS.artifacts };
  for (const name of options.skipArtifacts ?? []) {
    if ((ARTIFACT_NAMES as ReadonlyArray<string>).includes(name)) {
      artifacts[name as keyof ArtifactSelection] = false;
    }
  }
  if (options.onlyArtifacts && options.onlyArtifacts.length > 0) {
    const keep = new Set(options.onlyArtifacts);
    for (const name of ARTIFACT_NAMES) artifacts[name] = keep.has(name);
  }
  // `--include-monolith` is the generate spelling. Honouring it here keeps the config
  // that `setup` writes and the run it performs in agreement: otherwise a dry run would
  // print a config with `includeMonolith: false` and the real run would include it.
  if (options.includeMonolith === true) artifacts.monolith = true;
  return artifacts;
}

function topLevelDirs(cwd: string): string[] {
  try {
    return fs
      .readdirSync(cwd, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && !entry.name.startsWith(".") && entry.name !== "node_modules")
      .map((entry) => entry.name)
      .sort();
  } catch {
    return [];
  }
}

/** Type-only description of a JSON value, so a note never echoes user data. */
function describeJsonValue(value: unknown): string {
  if (value === null) return "null";
  if (Array.isArray(value)) return "an array";
  if (typeof value === "object") return "an object";
  return `a ${typeof value}`;
}

/**
 * Writes a file, turning an OS failure into the tool's own phrasing.
 *
 * A read-only target used to surface the raw `EPERM: operation not permitted,
 * open '…'` text, which reads like a crash rather than a refusal.
 */
function writeFileOrExplain(target: string, content: string): void {
  try {
    // `writeFileSync` follows a symlink, so a repository that ships `snapshot.config.json ->
    // ~/.bashrc` would get that file overwritten by a wizard the user ran to *read* a config.
    // The skill installer already refuses this; `init` now uses the same rule, and the write is
    // a same-directory rename so a crash cannot leave half a configuration behind.
    let stats: fs.Stats | null = null;
    try {
      stats = fs.lstatSync(target);
    } catch {
      stats = null;
    }
    if (stats !== null && stats.isSymbolicLink()) {
      throw new Error(
        `Cannot write ${target}: it is a symbolic link, and writing through it would modify whatever it points at.`
      );
    }
    if (stats !== null && !stats.isFile()) {
      throw new Error(
        `Cannot write ${target}: ${stats.isDirectory() ? "it is a directory" : "it is not a regular file"}.`
      );
    }
    const temporary = `${target}.tmp-${process.pid}-${Date.now()}`;
    fs.writeFileSync(temporary, content, { encoding: "utf8", flag: "wx" });
    try {
      fs.renameSync(temporary, target);
    } catch (err) {
      try {
        fs.unlinkSync(temporary);
      } catch {
        // The rename error explains the failure; a cleanup error must not mask it.
      }
      throw err;
    }
  } catch (err) {
    const message = (err as Error).message;
    // The guards above already phrase themselves; wrapping their message again would read
    // "Cannot write X: Cannot write X: …".
    if (message.startsWith(`Cannot write ${target}:`)) throw err;
    const code = (err as NodeJS.ErrnoException).code;
    const reason =
      code === "EACCES" || code === "EPERM" || code === "EROFS"
        ? `permission denied (${code})`
        : code === "EISDIR"
          ? "it is a directory"
          : message;
    throw new Error(`Cannot write ${target}: ${reason}`);
  }
}

/**
 * True when the generated ES-module config text can be written to `name`.
 *
 * The wizard's template is `export default { … }`, so it is only valid in a
 * `.mjs` file, a `.ts` file, or a `.js` file inside a `"type": "module"` package.
 */
function canWriteModuleConfig(name: string, cwd: string): boolean {
  if (name.endsWith(".mjs") || name.endsWith(".ts")) return true;
  if (!name.endsWith(".js")) return false;
  return readPackageJson(cwd)?.type === "module";
}

function configFormatLabel(name: string): string {
  if (name.endsWith(".js")) return 'CommonJS `.js` (package.json has no "type": "module")';
  if (name.endsWith(".cjs")) return "CommonJS `.cjs`";
  return "JSON";
}

const DEPENDENCY_FIELDS = [
  "dependencies",
  "devDependencies",
  "optionalDependencies",
  "peerDependencies",
] as const;

/** The range already declared for this package, in whichever dependency field it appears. */
function declaredRange(parsed: Record<string, unknown>): string | null {
  for (const field of DEPENDENCY_FIELDS) {
    const block = parsed[field];
    if (typeof block !== "object" || block === null || Array.isArray(block)) continue;
    const value = (block as Record<string, unknown>)[GENERATOR_NAME];
    if (typeof value === "string") return value;
  }
  return null;
}

interface PackageJsonUpdate {
  scripts: string[];
  dependency: InitDependency;
}

/**
 * Keeps the file's own indentation and line endings when rewriting `package.json`.
 *
 * A 4-space file rewritten as 2-space JSON is a whole-file diff whose only real change is two
 * scripts and one dependency: it buries the change in review and buries `git blame`. The
 * scaffolder used to do this itself, because `init` wrote no dependency; that write moved here,
 * so the rule has to live here too.
 */
function serializePackageJson(raw: string, value: unknown): string {
  const indent = /^[{[]\r?\n([ \t]+)/.exec(raw)?.[1];
  const spacing = raw.includes("\n") ? (indent ?? "  ") : undefined;
  const crlf = raw.includes("\r\n");
  const body = JSON.stringify(value, null, spacing);
  const text = crlf ? body.replace(/\n/g, "\r\n") : body;
  // Keep a byte-order mark the file already had: dropping it is a change nobody asked for, and the
  // editor that wrote it will put it back on the next save — two diffs for one edit.
  const bom = raw.startsWith("\uFEFF") ? "\uFEFF" : "";
  return `${bom}${text}${raw.endsWith("\n") ? (crlf ? "\r\n" : "\n") : ""}`;
}

/**
 * Adds the npm scripts and the devDependency in a single write of `package.json`.
 *
 * The scripts alone were not enough. `init` used to leave the package undeclared, so
 * `npm install` never put a copy in `node_modules`: every `npm run snapshot` resolved
 * `@latest` from the registry instead, the version could drift under the user, and the
 * "npm install && npm run snapshot" this printed as the next step could not have fixed it.
 * A range already declared in any dependency field is left exactly as it is — a pin to
 * `4.0.0` is a decision, not a mistake.
 */
function updatePackageJson(cwd: string, notes: string[]): PackageJsonUpdate {
  const packagePath = path.join(cwd, "package.json");
  const unchanged: PackageJsonUpdate = {
    scripts: [],
    dependency: { name: GENERATOR_NAME, range: null, added: false },
  };
  if (!fs.existsSync(packagePath)) {
    notes.push("No package.json found, so npm scripts and the devDependency were not added.");
    return unchanged;
  }

  let raw: string;
  let parsed: Record<string, unknown>;
  try {
    raw = fs.readFileSync(packagePath, "utf8");
    parsed = parsePackageJson(raw);
  } catch {
    notes.push("Could not parse package.json; npm scripts and the devDependency were not added.");
    return unchanged;
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
    notes.push("package.json is not a JSON object, so npm scripts and the devDependency were not added.");
    return unchanged;
  }

  // `scripts` must be an object. A string, array or number used to be replaced
  // with `{}` while the run still reported plain success — a silent data
  // replacement. Say what happened instead.
  const declaredScripts = parsed.scripts;
  let scripts: Record<string, unknown>;
  let scriptsWereBroken = false;
  if (declaredScripts === undefined) {
    scripts = {};
  } else if (typeof declaredScripts === "object" && declaredScripts !== null && !Array.isArray(declaredScripts)) {
    scripts = declaredScripts as Record<string, unknown>;
  } else {
    notes.push(
      `package.json "scripts" was ${describeJsonValue(declaredScripts)}, not an object; it was replaced with an ` +
        "object holding the snapshot scripts."
    );
    scripts = {};
    scriptsWereBroken = true;
  }

  const added: string[] = [];
  // A package must never depend on itself, and this repository is the one place `init`
  // runs where that is possible. Declaring the dependency made `npm install` fail with
  // ETARGET the moment package.json was bumped past the published version — the publish
  // workflow installs before it publishes — and it made `npx` resolve the *published*
  // binary instead of the working tree, so the snapshot of this repository was generated
  // by the previous release. In the tool's own repository the scripts run the build.
  const isSelfRepository = parsed.name === GENERATOR_NAME;
  const scriptPrefix = isSelfRepository ? "node ./dist/bin.js" : `npx ${GENERATOR_NAME}`;

  if (!scripts.snapshot) {
    scripts.snapshot = `${scriptPrefix} generate`;
    added.push("snapshot");
  }
  if (!scripts["snapshot:validate"]) {
    scripts["snapshot:validate"] = `${scriptPrefix} validate`;
    added.push("snapshot:validate");
  }

  const declared = declaredRange(parsed);
  let dependency: InitDependency;
  if (isSelfRepository) {
    if (declared !== null) {
      notes.push(
        `package.json declares ${GENERATOR_NAME} as a dependency of itself. It was left as it is, but a ` +
          "package cannot depend on itself: remove the entry and run the local build instead."
      );
    }
    dependency = { name: GENERATOR_NAME, range: declared, added: false };
  } else if (declared !== null) {
    dependency = { name: GENERATOR_NAME, range: declared, added: false };
  } else {
    const range = `^${GENERATOR_VERSION}`;
    const declaration = parsed.devDependencies;
    let devDependencies: Record<string, unknown>;
    if (declaration === undefined) {
      devDependencies = {};
    } else if (typeof declaration === "object" && declaration !== null && !Array.isArray(declaration)) {
      devDependencies = declaration as Record<string, unknown>;
    } else {
      notes.push(
        `package.json "devDependencies" was ${describeJsonValue(declaration)}, not an object; it was replaced ` +
          `with an object that declares ${GENERATOR_NAME}.`
      );
      devDependencies = {};
    }
    devDependencies[GENERATOR_NAME] = range;
    parsed.devDependencies = devDependencies;
    dependency = { name: GENERATOR_NAME, range, added: true };
  }

  if (added.length === 0 && !dependency.added && !scriptsWereBroken) {
    return { scripts: [], dependency };
  }

  parsed.scripts = scripts;
  writeFileOrExplain(packagePath, serializePackageJson(raw, parsed));
  return { scripts: added, dependency };
}

/**
 * The directories this configuration keeps out of git.
 *
 * The snapshot itself and the scratch copy it is swapped from. Both are build output, and leaving
 * them untracked is what makes `init` produce two file changes rather than a dirty tree.
 *
 * Derived from the **effective** `outDir` and `tmpDir` rather than hardcoded: the constant
 * form ignored `/snapshot/` while generating into `.context`, so `git status` showed the whole
 * snapshot as untracked — the one thing the entries exist to prevent. The pattern is anchored
 * (a leading `/`) because an unanchored `snapshot/` ignores a directory of that name at any
 * depth, so a fixture or package called `snapshot` disappeared from git.
 */
function gitignoreEntriesFor(
  cwd: string,
  outDir: string,
  tmpDir: string | null
): string[] {
  const entries: string[] = [];
  for (const directory of [outDir, tmpDir]) {
    // `null` means "not known": `setup` keeps a config it did not write, and this function will
    // not claim a directory is ignored when it could not read which one that config names.
    if (directory === null) continue;
    const relative = path.relative(cwd, path.resolve(cwd, directory)).replace(/\\/g, "/");
    // Outside the repository (an absolute `--out-dir`) or the repository itself ("./") is not
    // something `.gitignore` can or should describe.
    if (relative === "" || relative === "." || relative.startsWith("..") || path.isAbsolute(relative)) {
      continue;
    }
    entries.push(`/${relative}/`);
  }
  return [...new Set(entries)];
}

/**
 * One entry in the preset list.
 *
 * `detectedName` is null when nothing was detected — the fallback preset was reached, not
 * chosen — so no entry may claim to be `detected` in that case.
 */
function resolvePresetChoice(detectedName: string | null, presetName: string): Choice<string> {
  return {
    value: presetName,
    label: presetName,
    hint: presetName === detectedName ? "detected" : undefined,
  };
}

/**
 * Runs the interactive setup, or writes a config from flags.
 *
 * Interactive only when both ends are a TTY and `--yes` was not passed; every
 * other path uses the flag values and the detected preset, and prints what it
 * decided rather than prompting.
 *
 * Every question starts on its answer, so pressing enter through the whole wizard
 * produces the recommended configuration — and the first question is a single
 * "use the recommended setup" for a project that was recognised, which is what makes
 * `snapshot` alone a complete command.
 */
export async function runInit(options: InitOptions): Promise<InitResult> {
  const io = options.io ?? defaultIO();
  const detected = detectPreset(options.cwd, options.preset);
  // Reported back so the CLI can say *why* it chose a preset. A preset the developer picked,
  // or one forced with --preset, has nothing to report and is not a fallback.
  let reason = detected.reason;
  let fallback = detected.fallback;
  const notes: string[] = [];

  // The budget the written config will resolve to: maxPartBytes narrowed by maxPartTokens, which
  // is how `resolveConfig` reads the same two values.
  const budgetBytes =
    parseByteSize(options.maxPartBytes ?? detected.recommendedBudget ?? DEFAULT_ANSWERS.maxPartBytes) ??
    307200;
  const tokenBudgetBytes =
    options.maxPartTokens === undefined || options.maxPartTokens === null
      ? undefined
      : options.maxPartTokens * 4;
  const effectiveBudgetBytes =
    tokenBudgetBytes === undefined ? budgetBytes : Math.min(budgetBytes, tokenBudgetBytes);

  const answers: WizardAnswers = {
    preset: detected.presetName,
    // The repository's own branch, read the same way the generator reads it.
    // `getGitInfo` already falls back to "main" when git cannot report one, so a
    // directory that is not a repository, or a detached HEAD, still gets the
    // documented default. Writing "main" unconditionally made every later
    // `validate` warn about a mismatch the user never caused.
    branch: getGitInfo(options.cwd).branch,
    maxPartBytes:
      options.maxPartBytes ??
      detected.recommendedBudget ??
      DEFAULT_ANSWERS.maxPartBytes,
    // Every setting the caller named is written down, not just forwarded. A config that omits
    // what the run used is drift the next `validate` reports, and `setup` is the one command
    // that is supposed to leave a project in a consistent state.
    maxPartTokens: options.maxPartTokens ?? DEFAULT_ANSWERS.maxPartTokens,
    // Follows the budget unless the caller named one. A threshold above the part budget is a
    // config error (a file between the two cannot fit a part, so it is cut while the manifest
    // calls it a preview); a fixed 200 KB beside `--max-part-tokens 32k` made setup's own output
    // fail its own validate, and a fixed 200 KB under a 300 KB budget previewed files that fit.
    largeFileBytes: options.largeFileBytes ?? effectiveBudgetBytes,
    maxMonolithBytes: options.maxMonolithBytes ?? DEFAULT_ANSWERS.maxMonolithBytes,
    discovery: options.discovery ?? DEFAULT_ANSWERS.discovery,
    skeleton: options.skeleton ?? DEFAULT_ANSWERS.skeleton,
    sarif: options.sarif ?? DEFAULT_ANSWERS.sarif,
    include: options.include ?? [],
    excludePatterns: options.exclude ?? [],
    artifacts: artifactAnswers(options),
    includeSensitiveFiles: options.includeSensitiveFiles ?? DEFAULT_ANSWERS.includeSensitiveFiles,
    outDir: options.outDir ?? DEFAULT_ANSWERS.outDir,
    // The scaffold is written below but not wired in: a config that points at a file the user
    // may delete would turn "delete the template" into "generate now fails". They enable it
    // when they have something to say, and the scaffold says how.
  };

  const interactive = isInteractive(io) && options.yes !== true;

  if (interactive) {
    io.output.write("\n  codebase-snapshot\n");
    io.output.write("  Turn this repository into an LLM-ready, redacted, byte-bounded snapshot.\n\n");
    if (fallback) {
      // Naming what was looked for is the difference between "it failed" and "it needs an
      // answer": the developer can see immediately that this is not a project type the tool
      // knows, rather than suspecting a bug.
      io.output.write("  ⚠ Could not tell what kind of project this is.\n");
      io.output.write("    No package.json, go.mod, Cargo.toml, pyproject.toml, Gemfile,\n");
      io.output.write("    composer.json, pom.xml, *.csproj, next.config.*, vite.config.*, *.tf\n");
      io.output.write("    or workspace marker was found here.\n\n");
    } else {
      io.output.write(`  Detected   ${detected.presetName}\n`);
      io.output.write(`  Because    ${reason}\n\n`);
    }
    io.output.write(`  Directory  ${options.cwd}\n\n`);

    const paceChoices: Array<Choice<string>> = fallback
      ? [
          { value: "choose", label: "Pick the closest preset", hint: "then generate with the defaults" },
          { value: "recommended", label: "Use the defaults", hint: "generic · everything the scanner finds" },
          { value: "walk", label: "Go through each setting", hint: "every question starts on its default" },
        ]
      : [
          {
            value: "recommended",
            label: "Use the recommended setup",
            hint: `${detected.presetName} · config · npm scripts · install · generate`,
          },
          { value: "walk", label: "Go through each setting", hint: "every question starts on its default" },
          { value: "choose", label: "Pick a different preset", hint: "everything else stays at the defaults" },
        ];

    // The walk is reversible. A question that a later answer can invalidate may be revisited,
    // and `Review → No` steps back instead of aborting the way Ctrl+C does.
    const baseInclude = [...answers.include];
    const baseExclude = [...answers.excludePatterns];
    let lastScope = "all";

    const artifactChoices: Array<Choice<keyof ArtifactSelection>> = [
      { value: "readme", label: "README.md", hint: "orientation page" },
      { value: "prompt", label: "PROMPT.md", hint: "instruction sheet for the model" },
      { value: "manifest", label: "manifest.json", hint: "required by validate and report" },
      { value: "parts", label: "parts/", hint: "the code payload" },
      { value: "navigation", label: "reports/navigation.md", hint: "file → part index" },
      { value: "projectTree", label: "reports/project-tree.md", hint: "ASCII tree" },
      { value: "audit", label: "reports/audit.md", hint: "security and health findings" },
      { value: "monolith", label: "full-codebase.json + .md", hint: "roughly doubles output" },
    ];

    const scopeStep = async (): Promise<void> => {
      for (;;) {
        const scope = await select(
          io,
          "What should go into the snapshot?",
          [
            { value: "all", label: "Everything the scanner finds", hint: "recommended · respects .gitignore" },
            { value: "folders", label: "Only specific folders…" },
            { value: "no-tests", label: "Everything, but skip tests" },
            { value: "custom", label: "Let me write glob patterns" },
          ],
          { defaultValue: lastScope, allowBack: true }
        );
        lastScope = scope;
        // Re-entry starts from the flags the caller passed, so going back and choosing
        // differently never leaves the previous answer's globs behind in the config.
        answers.include = [...baseInclude];
        answers.excludePatterns = [...baseExclude];

        try {
          if (scope === "folders") {
            const dirs = topLevelDirs(options.cwd).slice(0, 40);
            if (dirs.length === 0) {
              notes.push("No top-level directories found; the snapshot will include everything.");
            } else {
              const chosen = await multiSelect(
                io,
                "Select folders",
                dirs.map((name) => ({ value: name, label: `${name}/` })),
                { defaults: dirs, allowBack: true }
              );
              answers.include = chosen.map((name) => `${name}/**`);
            }
          } else if (scope === "no-tests") {
            answers.excludePatterns = [...baseExclude, "**/*.test.*", "**/*.spec.*", "tests", "test"];
          } else if (scope === "custom") {
            const raw = await text(io, "Glob patterns to include (comma separated)", {
              defaultValue: baseInclude.join(", "),
              allowBack: true,
            });
            answers.include = raw
              .split(",")
              .map((value) => value.trim())
              .filter(Boolean);
          }
          return;
        } catch (error) {
          // Back inside a sub-question returns to the question that opened it.
          if (error instanceof PromptBack) continue;
          throw error;
        }
      }
    };

    const sizeStep = async (): Promise<void> => {
      for (;;) {
        // The recommended budget belongs to the preset, so the selector starts on it rather than
        // on a fixed "120k" that silently overrode a 300k Next.js recommendation.
        const currentBudget = String(answers.maxPartBytes);
        const sizeChoice = await select(io, "How large should each part be?", SIZE_CHOICES, {
          defaultValue: SIZE_CHOICES.some((choice) => choice.value === currentBudget)
            ? currentBudget
            : "custom",
          allowBack: true,
        });

        if (sizeChoice !== "custom") {
          answers.maxPartBytes = sizeChoice;
          return;
        }
        try {
          const raw = await text(io, "Part size (e.g. 150k, 1.5mb, 900000)", {
            defaultValue: currentBudget,
            validate: (value) => (parseByteSize(value) === undefined ? "Not a valid size." : null),
            allowBack: true,
          });
          answers.maxPartBytes = parseByteSize(raw) ?? answers.maxPartBytes;
          return;
        } catch (error) {
          if (error instanceof PromptBack) continue;
          throw error;
        }
      }
    };

    const artifactsStep = async (): Promise<void> => {
      const enabled = ARTIFACT_NAMES.filter((name) => answers.artifacts[name]);
      const selectedArtifacts = await multiSelect(
        io,
        "Which artifacts should be generated?",
        artifactChoices,
        { defaults: enabled, allowBack: true }
      );
      for (const name of ARTIFACT_NAMES) answers.artifacts[name] = selectedArtifacts.includes(name);
    };

    const credentialsStep = async (): Promise<void> => {
      answers.includeSensitiveFiles = await confirm(
        io,
        "Include credential files (.env, *.pem, *.npmrc, *.ssh/)?",
        { defaultValue: answers.includeSensitiveFiles, allowBack: true }
      );
    };

    const reviewStep = async (): Promise<void> => {
      const enabledCount = ARTIFACT_NAMES.filter((name) => answers.artifacts[name]).length;
      io.output.write("\n  Review\n\n");
      io.output.write(`  project          ${answers.preset}\n`);
      io.output.write(`  include          ${answers.include.length ? answers.include.join(", ") : "everything"}\n`);
      io.output.write(`  part size        ${String(answers.maxPartBytes)}\n`);
      io.output.write(`  artifacts        ${enabledCount} of ${ARTIFACT_NAMES.length}\n`);
      io.output.write(`  credentials      ${answers.includeSensitiveFiles ? "included" : "skipped"}\n\n`);
      io.output.write("  Will write snapshot.config with your answers, plus every other setting\n");
      io.output.write("  at its default — so nothing is hidden behind the docs.\n\n");

      const proceed = await confirm(io, "Write this and continue?", {
        defaultValue: true,
        allowBack: true,
      });
      // "No" means "not like this", which is a step back. Ctrl+C is how you say stop.
      if (!proceed) throw new PromptBack();
    };

    /** Runs the walk, returning false when the developer backs out of its first question. */
    const walk = async (): Promise<boolean> => {
      const steps = [scopeStep, sizeStep, artifactsStep, credentialsStep, reviewStep];
      let index = 0;
      while (index < steps.length) {
        try {
          await steps[index]();
          index += 1;
        } catch (error) {
          if (!(error instanceof PromptBack)) throw error;
          if (index === 0) return false;
          index -= 1;
          io.output.write("\n");
        }
      }
      return true;
    };

    // Re-entered when the first walk step asks to go back, so "go through each setting" is not
    // a one-way door.
    for (;;) {
      const pace = await select(io, "How should I set this up?", paceChoices, {
        defaultValue: fallback ? "choose" : "recommended",
      });

      if (pace === "choose") {
        try {
          answers.preset = await select(
            io,
            "What kind of project is this?",
            listPresetNames().map((name) =>
              resolvePresetChoice(fallback ? null : detected.presetName, name)
            ),
            { defaultValue: answers.preset, allowBack: true }
          );
        } catch (error) {
          if (error instanceof PromptBack) continue;
          throw error;
        }
        const chosen = detectPreset(options.cwd, answers.preset);
        answers.preset = chosen.presetName;
        // The developer made the decision, so there is no detection to report and this is not
        // a fallback any more.
        reason = null;
        fallback = false;
      }

      if (pace === "walk" && !(await walk())) continue;
      break;
    }

  }

  const configText = renderConfig(answers);
  const preferredName = chooseConfigFileName(options.cwd);
  const presentConfigs = CONFIG_CANDIDATES.filter((name) =>
    fs.existsSync(path.join(options.cwd, name))
  );
  const present = presentConfigs[0] ?? null;

  // More than one config file means the loader silently ignores all but the first
  // in its own order; say which one wins so the user can delete the rest.
  if (presentConfigs.length > 1) {
    notes.push(
      `Multiple configuration files found (${presentConfigs.join(", ")}); ${present} is the one this ` +
        "tool loads, and the others are ignored. Delete the extras to avoid confusion."
    );
  }

  // With `--force` the file that already exists is the one to rewrite. Choosing a
  // fresh name beside it wrote a second config file, and the loader's order
  // (`.mjs` before `.json`, for instance) made the new one silently shadow the
  // user's: `--force` promised to replace it and instead disabled it.
  const configName = present !== null && options.force ? present : preferredName;
  const configPath = path.join(options.cwd, configName);

  // `setup` keeps a config it finds: it is the repository's, and rewriting it would silently
  // discard whatever the user changed. The rest of the setup still runs.
  const reused = present !== null && options.force !== true && options.reuseConfig === true;
  if (reused) notes.push(`Kept the existing ${present} instead of writing a new one.`);

  if (options.dryRun) {
    return {
      configPath,
      configText,
      written: false,
      reused,
      preset: answers.preset,
      reason,
      fallback,
      scripts: [],
      gitignoreEntries: [],
      dependency: { name: GENERATOR_NAME, range: `^${GENERATOR_VERSION}`, added: false },
      notes,
      outDir: answers.outDir,
      briefPath: path.join(options.cwd, BRIEF_SCAFFOLD_FILE),
      briefWritten: false,
    };
  }

  if (present !== null && present !== preferredName && !options.force && !reused) {
    throw new Error(
      `A configuration already exists (${present}). Re-run with --force to replace it.`
    );
  }
  if (present !== null && options.force && !canWriteModuleConfig(present, options.cwd)) {
    throw new Error(
      `Refusing to replace ${present}: this wizard writes an ES-module config (.ts, .js, .mjs), and ` +
        `${present} is a ${configFormatLabel(present)} configuration. Writing a new file beside it would ` +
        `silently shadow it, so delete or rename ${present} yourself and re-run with --force.`
    );
  }
  if (packageJsonHasConfig(options.cwd) && !options.force && !reused) {
    throw new Error(
      'package.json already defines a "snapshot" config. Remove that key, or re-run with --force ' +
        "to write a config file that takes precedence over it."
    );
  }
  if (fs.existsSync(configPath) && !options.force && !reused) {
    throw new Error(`${configName} already exists. Re-run with --force to replace it.`);
  }

  if (!reused) writeFileOrExplain(configPath, configText);
  // The owner half: written once, never overwritten. A repository that already has one keeps
  // its words, and the config above still points at it.
  const briefPath = path.join(options.cwd, BRIEF_SCAFFOLD_FILE);
  let briefWritten = false;
  if (!fs.existsSync(briefPath)) {
    writeFileOrExplain(briefPath, BRIEF_SCAFFOLD);
    briefWritten = true;
  }
  const { scripts, dependency } = updatePackageJson(options.cwd, notes);
  // A config this run writes names no `tmpDir`, so the default is the effective one. A config
  // that is *kept* may name one this function cannot see, so only the outDir entry is claimed.
  const ignore = appendGitignoreEntries(
    options.cwd,
    gitignoreEntriesFor(options.cwd, answers.outDir, options.tmpDir ?? (reused ? null : "snapshot.tmp"))
  );
  if (ignore.note !== null) notes.push(ignore.note);

  return {
    configPath,
    configText,
    written: true,
    reused,
    preset: answers.preset,
    reason,
    fallback,
    scripts,
    gitignoreEntries: ignore.added,
    dependency,
    notes,
    briefPath,
    briefWritten,
    outDir: answers.outDir,
  };
}
</file>

<file path="tests/mcp-retrieval.test.js">
/**
 * The retrieval planner: a question and a budget in, a reading order out.
 *
 * The plan must be deterministic, must respect the budget, must explain every file, and must never
 * name a path the snapshot does not carry. Those four properties are the whole feature.
 */
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { buildTools } from "../dist/mcp.js";

const tools = new Map(buildTools().map((tool) => [tool.name, tool]));

function fixture(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  const write = (relative, content) => {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write("src/user.ts", [
    "export interface User { id: string; }",
    "export function getUser(id: string): User { return { id }; }",
    "export function deleteUser(id: string): void {}",
    "",
  ].join("\n"));
  write("src/auth.ts", [
    'import { getUser } from "./user.js";',
    "export function authenticate(token: string): boolean { return getUser(token) !== null; }",
    "",
  ].join("\n"));
  write("src/session.ts", "export const SESSION_TTL = 3600;\n");
  write("tests/user.test.js", 'test("user", () => {});\n');
  write("src/big.ts", Array.from({ length: 300 }, (_, index) => "export const v" + index + " = " + index + ";").join("\n") + "\n");
  write("README.md", "# Fixture\n");
  return root;
}

function contextFor(root) {
  return { cwd: root, roots: [root], log: () => {} };
}

async function generate(root) {
  const tool = tools.get("snapshot_generate");
  const result = await tool.handler({}, contextFor(root));
  assert.equal(result.isError, undefined, result.text);
}

async function plan(root, args) {
  const tool = tools.get("snapshot_plan_for");
  assert.ok(tool, "snapshot_plan_for is served");
  return tool.handler(args, contextFor(root));
}

test("a plan names the files that answer the question, in reading order", async (t) => {
  const root = fixture(t);
  await generate(root);
  const result = await plan(root, { question: "how is a user authenticated", maxTokens: 8000 });
  assert.equal(result.isError, undefined, result.text);
  const structured = result.structured;
  assert.ok(structured.files.length > 0, "the plan is not empty");
  const paths = structured.files.map((file) => file.path);
  assert.ok(paths.includes("src/auth.ts"), "the file whose name matches is first: " + paths.join(", "));
  assert.ok(structured.usedTokens <= 8000, "the budget is respected");
  for (const file of structured.files) {
    assert.ok(file.why.length > 0, file.path + " explains itself");
    assert.equal(typeof file.part, "string");
  }
});

test("the budget is a ceiling, not a suggestion", async (t) => {
  const root = fixture(t);
  await generate(root);
  const result = await plan(root, { question: "user auth session", maxTokens: 500 });
  assert.ok(result.structured.usedTokens <= 500);
  assert.ok(result.structured.notes.length > 0, "the plan says what it could not fit");
});

test("the same question produces the same plan", async (t) => {
  const root = fixture(t);
  await generate(root);
  const first = await plan(root, { question: "delete user", maxTokens: 4000 });
  const second = await plan(root, { question: "delete user", maxTokens: 4000 });
  assert.deepEqual(second.structured, first.structured);
});

test("tests are excluded unless asked for", async (t) => {
  const root = fixture(t);
  await generate(root);
  const without = await plan(root, { question: "user", maxTokens: 4000 });
  assert.equal(without.structured.files.some((file) => file.path.startsWith("tests/")), false);
  const withTests = await plan(root, { question: "user test", includeTests: true, maxTokens: 4000 });
  assert.ok(withTests.structured.files.some((file) => file.path.startsWith("tests/")), "asked for, included");
});

test("an empty question is refused, and no snapshot is explained", async (t) => {
  const root = fixture(t);
  const blank = await plan(root, { question: "  " });
  assert.equal(blank.isError, true);
  const missing = await plan(root, { question: "user" });
  assert.equal(missing.isError, true);
  assert.match(missing.text, /snapshot_generate/);
});

test("a query filters by layer, pattern and symbol", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_query");
  assert.ok(tool, "snapshot_query is served");
  const context = contextFor(root);

  const byLayer = await tool.handler({ layer: "src" }, context);
  assert.ok(byLayer.structured.files.length >= 3, "every source file is in src");
  assert.equal(byLayer.structured.files.every((file) => file.layer === "src"), true);

  const byPattern = await tool.handler({ pathPattern: "auth" }, context);
  assert.deepEqual(
    byPattern.structured.files.map((file) => file.path),
    ["src/auth.ts"],
    "the pattern is a regular expression over the path"
  );

  const bySymbol = await tool.handler({ symbol: "deleteuser" }, context);
  assert.deepEqual(bySymbol.structured.files.map((file) => file.path), ["src/user.ts"]);

  const capped = await tool.handler({ maxFiles: 1 }, context);
  assert.equal(capped.structured.files.length, 1);
  assert.ok(capped.structured.matched > 1, "the count still says how many matched");

  const badPattern = await tool.handler({ pathPattern: "(" }, context);
  assert.equal(badPattern.isError, true);
  assert.match(badPattern.text, /not a valid regular expression/);
});

test("a context block carries the requested files within its budget", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_context");
  assert.ok(tool, "snapshot_context is served");
  const context = contextFor(root);

  const byFile = await tool.handler({ files: ["src/user.ts"], maxTokens: 4000 }, context);
  assert.equal(byFile.isError, undefined, byFile.text);
  assert.match(byFile.text, /export function getUser/);
  assert.equal(byFile.structured.files.length, 1);
  assert.ok(byFile.structured.usedTokens <= 4000);

  const bySymbol = await tool.handler({ symbols: ["deleteUser"], maxTokens: 4000 }, context);
  assert.match(bySymbol.text, /deleteUser/, "a symbol resolves to the file that exports it");

  const missing = await tool.handler({ files: ["nope.ts"], maxTokens: 1000 }, context);
  assert.deepEqual(missing.structured.missing, ["nope.ts"]);
  assert.equal(missing.structured.files.length, 0);

  const none = await tool.handler({}, context);
  assert.equal(none.isError, true);

  const small = await tool.handler({ files: ["src/big.ts"], maxTokens: 500, linesPerFile: 300 }, context);
  assert.ok(small.structured.usedTokens <= 500, "the budget is honoured");
  assert.match(small.text, /first \d+ lines/, "a shortened file says so");
});

test("a symbol resolves to a definition window with a line number", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_symbol");
  assert.ok(tool, "snapshot_symbol is served");
  const context = contextFor(root);

  const found = await tool.handler({ name: "deleteUser" }, context);
  assert.equal(found.structured.found, 1);
  assert.equal(found.structured.matches[0].path, "src/user.ts");
  assert.ok(found.structured.matches[0].line >= 1);
  assert.match(found.text, /export function deleteUser/);

  const absent = await tool.handler({ name: "neverExported" }, context);
  assert.equal(absent.structured.found, 0);
  assert.match(absent.text, /No definition of neverExported/);

  const blank = await tool.handler({ name: "" }, context);
  assert.equal(blank.isError, true);
});

test("a changed-file set returns its bodies and its dependents", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_diff_context");
  assert.ok(tool, "snapshot_diff_context is served");
  const context = contextFor(root);

  const result = await tool.handler({ paths: ["src/user.ts"], maxTokens: 8000 }, context);
  assert.equal(result.isError, undefined, result.text);
  assert.equal(result.structured.changed.length, 1);
  assert.ok(result.structured.dependents.some((item) => item.path === "src/auth.ts"), "the importer is named");
  assert.match(result.text, /export function getUser/);
  assert.match(result.text, /dependent/);

  const missing = await tool.handler({ paths: ["nope.ts"], maxTokens: 1000 }, context);
  assert.deepEqual(missing.structured.missing, ["nope.ts"]);

  const empty = await tool.handler({ paths: [] }, context);
  assert.equal(empty.isError, true);
});

test("a review combines currency, health and the requested bodies", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_review");
  assert.ok(tool, "snapshot_review is served");
  const result = await tool.handler({ paths: ["src/user.ts"], linesPerFile: 40 }, contextFor(root));
  assert.equal(result.isError, undefined, result.text);
  assert.equal(result.structured.current, true);
  assert.ok(result.structured.score >= 0 && result.structured.score <= 100);
  assert.deepEqual(result.structured.failed, []);
  assert.match(result.text, /export function getUser/);

  fs.appendFileSync(path.join(root, "src", "user.ts"), "export const changed = true;\n");
  const stale = await tool.handler({ paths: ["src/user.ts"] }, contextFor(root));
  assert.equal(stale.structured.current, false, "an edited file makes the snapshot stale");
  assert.match(stale.text, /stale/);
});

test("search finds a line, and a redacted value is never found", async (t) => {
  const root = fixture(t);
  await generate(root);
  const search = tools.get("snapshot_search");
  assert.ok(search, "snapshot_search is served");
  const context = contextFor(root);

  const found = await search.handler({ query: "getUser" }, context);
  assert.equal(found.isError, undefined, found.text);
  assert.ok(found.structured.matches.length >= 1);
  assert.ok(found.structured.matches.some((match) => match.path === "src/user.ts"), "the definition is found");
  assert.ok(found.structured.matches.every((match) => typeof match.line === "number"));

  const missing = await search.handler({ query: "neverAppearsAnywhere" }, context);
  assert.equal(missing.structured.matches.length, 0);

  const short = await search.handler({ query: "ab" }, context);
  assert.equal(short.isError, true);

  const bad = await search.handler({ query: "(" , regex: true }, context);
  assert.equal(bad.isError, true);
});

test("stats agree with the manifest", async (t) => {
  const root = fixture(t);
  await generate(root);
  const stats = tools.get("snapshot_stats");
  assert.ok(stats, "snapshot_stats is served");
  const result = await stats.handler({}, contextFor(root));
  assert.equal(result.isError, undefined, result.text);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  assert.equal(result.structured.files, manifest.counts.totalFiles);
  assert.equal(result.structured.parts, manifest.counts.partsCount);
  assert.equal(result.structured.tokens, manifest.totals.estimatedTokens);
  assert.ok(result.structured.heaviest.length > 0);
});

test("routes come from the summaries", async (t) => {
  const root = fixture(t);
  fs.writeFileSync(
    path.join(root, "src", "api.ts"),
    "export function listUsers() { return []; }\n"
  );
  await generate(root);
  const tool = tools.get("snapshot_routes");
  assert.ok(tool, "snapshot_routes is served");
  const result = await tool.handler({}, contextFor(root));
  assert.equal(result.isError, undefined, result.text);
  assert.equal(typeof result.structured.total, "number");
});

test("cycles finds a two-file loop and none in a clean tree", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_cycles");
  assert.ok(tool, "snapshot_cycles is served");
  const context = contextFor(root);

  const clean = await tool.handler({}, context);
  assert.equal(clean.structured.components.length, 0, "the fixture has no cycle");

  const a = path.join(root, "src", "a.ts");
  const b = path.join(root, "src", "b.ts");
  fs.writeFileSync(a, 'import { b } from "./b.js";\nexport const a = b;\n');
  fs.writeFileSync(b, 'import { a } from "./a.js";\nexport const b = a;\n');
  await generate(root);

  const cyclic = await tool.handler({}, context);
  assert.ok(cyclic.structured.components.length >= 1, cyclic.text);
  assert.ok(cyclic.structured.filesInCycles >= 2);
  assert.match(cyclic.text, /src\/a\.ts/);
  assert.match(cyclic.text, /src\/b\.ts/);
});

test("neighbors answers both directions of the graph", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_neighbors");
  assert.ok(tool, "snapshot_neighbors is served");
  const context = contextFor(root);

  const user = await tool.handler({ path: "src/user.ts" }, context);
  assert.equal(user.isError, undefined, user.text);
  assert.ok(user.structured.importedBy.some((item) => item.path === "src/auth.ts"), "the importer is named");

  const auth = await tool.handler({ path: "src/auth.ts" }, context);
  assert.ok(auth.structured.imports.some((item) => item.path === "src/user.ts" && item.part !== null));

  const missing = await tool.handler({ path: "nope.ts" }, context);
  assert.equal(missing.isError, true);
});

test("entry points list manifests first", async (t) => {
  const root = fixture(t);
  await generate(root);
  const tool = tools.get("snapshot_entrypoints");
  assert.ok(tool, "snapshot_entrypoints is served");
  const result = await tool.handler({}, contextFor(root));
  assert.equal(result.isError, undefined, result.text);
  assert.ok(result.structured.entries.length > 0);
  assert.equal(result.structured.entries[0].manifest, true, "the manifest sorts first");
});

test("a plan includes the callers of its strongest match", async (t) => {
  const root = fixture(t);
  await generate(root);
  const result = await plan(root, { question: "getUser", maxTokens: 8000 });
  const paths = result.structured.files.map((file) => file.path);
  assert.ok(paths.includes("src/user.ts"), "the match is there: " + paths.join(","));
  const auth = result.structured.files.find((file) => file.path === "src/auth.ts");
  assert.ok(auth, "the caller is pulled in: " + paths.join(","));
  assert.match(auth.why, /imports src\/user\.ts/);
});
