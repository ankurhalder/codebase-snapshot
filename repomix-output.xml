import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as path from "node:path";
import {
  ARTIFACT_NAMES,
  assertUsableConfigInput,
  configDigest,
  isResolvedConfig,
  normalizeResolvedConfig,
  resolveConfig,
} from "../config.js";
import { collectFiles, findSecretInPath, getGitInfo } from "../scanner/files.js";
import { resolveChangedScope } from "../scanner/changed.js";
import { buildImportResolver, importsChangedFile } from "../scanner/dependents.js";
import type { ImportResolver } from "../scanner/dependents.js";
import { importsOfFile } from "../ast/imports.js";
import { SCHEMA_VERSION, isOurGeneratorName } from "../version.js";
import { BINARY_SCAN_BYTES, decodeText, isBinaryExtension, isBinaryFile } from "../scanner/binary.js";
import type {
  Manifest,
  ManifestArtifact,
  ResolvedSnapshotConfig,
  SnapshotConfig,
  SecretRule,
  ValidationDrift,
  ValidationResult,
} from "../types.js";

/**
 * Masks one path with the default rules plus the caller's custom rules.
 *
 * Drift lists are printed by `validate` and embedded in `--format json`, so a
 * `deleted: <path>` line must not reproduce a credential-bearing filename.
 * Masking happens only on the way out: matching a record against the filesystem
 * always uses the real path.
 */
function maskedPath(value: string, secretRules: readonly SecretRule[] | undefined): string {
  return findSecretInPath(value, secretRules)?.masked ?? value;
}

/**
 * Resolves a manifest-supplied filename inside `directory`, or refuses.
 *
 * A manifest is an input: it can be hand-edited, or written by an older or other tool. Joining an
 * unvalidated name onto a directory accepts `../../..` and absolute paths, so `validate` would
 * read a file anywhere on the machine and then report its size and digest back to the caller — a
 * read primitive with an oracle attached. Part names produced by this generator are bare names,
 * so anything that resolves outside the directory is a defect, not a path to follow.
 */
function confineToDirectory(directory: string, filename: string): string | null {
  if (filename.includes("\0")) return null;
  if (path.isAbsolute(filename)) return null;
  const base = path.resolve(directory);
  const resolved = path.resolve(base, filename);
  const caseInsensitive = process.platform === "win32" || process.platform === "darwin";
  const prefix = caseInsensitive ? `${base}${path.sep}`.toLowerCase() : `${base}${path.sep}`;
  const candidate = caseInsensitive ? resolved.toLowerCase() : resolved;
  return candidate.startsWith(prefix) ? resolved : null;
}

/** The newest `run-*` staging directory under `tmpDir`, or null when there is none. */
function findStagingDirectory(config: ResolvedSnapshotConfig): string | null {
  const tmpDir = path.resolve(config.cwd, config.tmpDir);
  let entries: string[];
  try {
    entries = fs.readdirSync(tmpDir);
  } catch {
    return null;
  }
  const runs = entries.filter((name) => name.startsWith("run-")).sort();
  const newest = runs[runs.length - 1];
  return newest ? path.join(tmpDir, newest) : null;
}

/**
 * Explains a missing manifest, and says so differently when a run died.
 *
 * `validate` and `report` used to answer "run generate first" whenever `manifest.json` was absent,
 * including for a directory this generator had already written a marker into. That answer could
 * never resolve: generation had already run, and it had failed after starting. The marker carries
 * the state, the run id and the start time, so the message can name them and say what to do.
 */
function describeMissingManifest(config: ResolvedSnapshotConfig, manifestPath: string): string {
  const outDir = path.resolve(config.cwd, config.outDir);
  const markerPath = path.join(outDir, ".codebase-snapshot");

  let marker: Record<string, unknown> | null = null;
  try {
    if (fs.existsSync(markerPath)) {
      const parsed: unknown = JSON.parse(fs.readFileSync(markerPath, "utf8"));
      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
        marker = parsed as Record<string, unknown>;
      }
    }
  } catch {
    marker = null;
  }

  if (marker) {
    const state = typeof marker.state === "string" ? marker.state : "unknown";
    const runId = typeof marker.id === "string" ? marker.id : "unknown";
    const createdAt = typeof marker.createdAt === "string" ? marker.createdAt : "unknown";
    const staging = findStagingDirectory(config);

    if (state === "staging") {
      return (
        `The previous generate run did not finish: ${outDir} holds a .codebase-snapshot marker in ` +
        `state "staging" (run ${runId}, started ${createdAt}) and no manifest.json. ` +
        (staging ? `Its staging directory is still at ${staging}. ` : "") +
        "Run generate again to rebuild the snapshot; if another run is active, wait for it to finish first."
      );
    }

    return (
      `${outDir} carries this generator's ownership marker but no manifest.json, so the snapshot is ` +
      `incomplete (run ${runId}, recorded ${createdAt}, state "${state}"). Run generate again to rebuild it.`
    );
  }

  return `Snapshot manifest not found at: ${manifestPath}. Run generate first.`;
}

function emptyDrift(): ValidationDrift {
  return {
    missingInSnapshot: [],
    missingOnDisk: [],
    unreadable: [],
    hashMismatches: [],
    partIssues: [],
    totalsMismatches: [],
    configMismatches: [],
  };
}

function sha256Hex(buffer: Buffer): string {
  return crypto.createHash("sha256").update(buffer).digest("hex");
}

/**
 * True when a path that was skipped at snapshot time would now be emitted.
 *
 * `collectFiles` has already applied the ignore/exclude/sensitive rules, so the only
 * decision left is the one `generate` performs per file. A skip is a record of that
 * decision, not a permanent exemption: `data.bin` that held NUL bytes then and is plain
 * text now must surface as drift, otherwise `generate` silently adds a file `validate`
 * said was absent.
 *
 * The answer is "would `generate` include this file", so this asks generate's questions in
 * generate's order (`src/index.ts`): a binary extension is skipped without reading, a file
 * past the read cap is sniffed before it is read, and below the cap `decodeText` on the
 * buffer is the complete check. Asking content alone disagreed for a text-content file with
 * a binary extension — an `assets/logo.png` holding a Git-LFS pointer, or a placeholder —
 * which `generate` records as `binary` and never includes. That disagreement made
 * `validate` report the file as "new" forever: regenerating could not clear the drift,
 * because generating never includes it.
 */
function wouldNowBeIncluded(cwd: string, relativePath: string): boolean {
  const absolutePath = path.join(cwd, relativePath);
  try {
    const stats = fs.statSync(absolutePath);
    if (!stats.isFile()) return false;

    // Same first question as `generate`: an extension that only ever holds binary data needs
    // no read at all, whatever the bytes happen to be (a Git-LFS pointer is text).
    if (isBinaryExtension(absolutePath)) return false;
    // Same second question: past the cap the chunked sniff decides before the whole file is
    // pulled into memory, because the point is not to load a gigabyte of noise to find one NUL.
    if (stats.size > BINARY_SCAN_BYTES && isBinaryFile(absolutePath)) return false;
    // Below the cap the decode is the complete answer `generate` used, on the same bytes.
    return !decodeText(fs.readFileSync(absolutePath)).binary;
  } catch {
    return false;
  }
}

/** Every truncation cause the generator can record. */
const TRUNCATION_REASONS: ReadonlySet<string> = new Set([
  "large-file-budget",
  "part-budget",
  "section-metadata",
]);

/**
 * True when a path recorded in a manifest stays inside the repository it describes.
 *
 * The same rule `confineToDirectory` applies at the read sites, in a form the shape guard can
 * use without touching the filesystem: a manifest is an input, and `path.join` accepts `../..`.
 */
function isConfinedRelative(value: string): boolean {
  if (value.length === 0 || value.includes("\0") || value.includes("\\")) return false;
  if (path.isAbsolute(value)) return false;
  return !value.split("/").includes("..");
}

/**
 * Describes why a parsed JSON value is not usable as a snapshot manifest.
 *
 * One guard for every command that reads a manifest from disk. `validate` used to
 * accept a manifest whose `fingerprint` had been deleted and call the snapshot
 * "valid and up to date", `report` printed `undefined` for the same file, and
 * `diff` rejected it with a private copy of these rules — three answers to one
 * question. A manifest is:
 *
 * - a JSON object (not an array, not a primitive),
 * - with non-negative integer counts (`totalFiles`, `totalLines`, `totalSizeBytes`, `partsCount`),
 * - with a `generatedAt` string and a `schemaVersion` string,
 * - with a `fingerprint` that is exactly 64 lowercase hex characters (a sha256),
 * - with `files`, `skipped` and `parts` arrays, each entry carrying the field the
 *   rest of the tool indexes by (`relativePath`, `filename`),
 * - with a `totals` object (`report` reads `totals.redactedLines`) and a `layers` object.
 *
 * Returns `null` when the value is usable, otherwise one sentence naming the
 * first problem. Callers prefix it with the path they read.
 */
export function describeManifestShapeProblem(value: unknown): string | null {
  if (!value || typeof value !== "object" || Array.isArray(value)) return "not a JSON object";
  const candidate = value as Record<string, unknown>;

  const counts = candidate.counts;
  if (!counts || typeof counts !== "object" || Array.isArray(counts)) {
    return 'no "counts" object';
  }
  for (const key of ["totalFiles", "totalLines", "totalSizeBytes", "partsCount"]) {
    const count = (counts as Record<string, unknown>)[key];
    if (typeof count !== "number") return `missing numeric \`counts.${key}\``;
    // `-5`, `1.5` and `1e999` are all numbers, and `report` printed each of them
    // verbatim: "-5 files included", "Total lines: 1.5". A count is a non-negative
    // integer, or the document is not a snapshot manifest.
    if (!Number.isSafeInteger(count) || count < 0) {
      return `\`counts.${key}\` must be a non-negative integer`;
    }
  }

  if (typeof candidate.generatedAt !== "string" || candidate.generatedAt.trim() === "") {
    return 'missing "generatedAt" timestamp';
  }
  if (typeof candidate.schemaVersion !== "string" || candidate.schemaVersion.trim() === "") {
    return 'missing "schemaVersion"';
  }
  if (
    typeof candidate.fingerprint !== "string" ||
    !/^[0-9a-f]{64}$/.test(candidate.fingerprint)
  ) {
    return '`fingerprint` must be a 64-character lowercase sha256 hex digest';
  }

  // `report` reads `totals.redactedLines`; a missing object used to crash the text
  // renderer after it had already printed half a report.
  if (!candidate.totals || typeof candidate.totals !== "object" || Array.isArray(candidate.totals)) {
    return 'missing "totals" object';
  }

  // The current schema's full shape. Older manifests legitimately lack fields added since, so
  // the stronger requirements apply only to a document that claims this build's schema. A
  // hand-written or truncated manifest that copies `schemaVersion: "3.0.0"` has to be one.
  const currentSchema = candidate.schemaVersion === SCHEMA_VERSION;
  if (currentSchema) {
    const generator = candidate.generator;
    if (!generator || typeof generator !== "object" || Array.isArray(generator)) {
      return 'missing "generator" object';
    }
    const generatorFields = generator as Record<string, unknown>;
    if (!isOurGeneratorName(generatorFields.name)) {
      return '`generator.name` is not this generator';
    }
    if (typeof generatorFields.version !== "string" || generatorFields.version.trim() === "") {
      return '`generator.version` must be a non-empty string';
    }

    const git = candidate.git;
    if (!git || typeof git !== "object" || Array.isArray(git)) return 'missing "git" object';
    const gitFields = git as Record<string, unknown>;
    if (typeof gitFields.branch !== "string") return '`git.branch` must be a string';
    if (typeof gitFields.commit !== "string") return '`git.commit` must be a string';
    if (typeof gitFields.isDirty !== "boolean") return '`git.isDirty` must be a boolean';

    const config = candidate.config;
    if (!config || typeof config !== "object" || Array.isArray(config)) {
      return 'missing "config" object';
    }
    // `config.digest` is deliberately not required: a manifest without one is *unverifiable*
    // rather than malformed, and `validate` reports exactly that ("no configuration digest")
    // instead of refusing the document. A manifest written before the digest existed therefore
    // still diffs and reports; it just cannot be called current.

    // Settings added after this guard was written are optional, but a manifest that carries one
    // in the wrong shape is malformed rather than old: `report` prints these fields and
    // `validate` compares the ones in the digest, so a `promptTask` of 5 reads as "unset" and a
    // string `brief` would be echoed as a path it is not.
    const recordedConfig = config as Record<string, unknown>;
    const promptTask = recordedConfig.promptTask;
    if (
      promptTask !== undefined &&
      promptTask !== "audit" &&
      promptTask !== "review" &&
      promptTask !== "explain"
    ) {
      return '`config.promptTask` must be "audit", "review" or "explain"';
    }
    const recordedBrief = recordedConfig.brief;
    if (recordedBrief !== undefined) {
      if (!recordedBrief || typeof recordedBrief !== "object" || Array.isArray(recordedBrief)) {
        return '`config.brief` must be an object';
      }
      const briefRecord = recordedBrief as Record<string, unknown>;
      if (typeof briefRecord.path !== "string" || briefRecord.path.length === 0) {
        return '`config.brief.path` must be a non-empty string';
      }
      if (typeof briefRecord.digest !== "string" || !/^[0-9a-f]{64}$/.test(briefRecord.digest)) {
        return '`config.brief.digest` must be a sha256 hex digest';
      }
    }
    const recordedSlots = recordedConfig.attachmentSlots;
    if (
      recordedSlots !== undefined &&
      (typeof recordedSlots !== "number" ||
        !Number.isSafeInteger(recordedSlots) ||
        recordedSlots < 0)
    ) {
      return '`config.attachmentSlots` must be a non-negative integer';
    }
    const recordedMaxParts = recordedConfig.maxParts;
    if (
      recordedMaxParts !== undefined &&
      recordedMaxParts !== null &&
      (typeof recordedMaxParts !== "number" ||
        !Number.isSafeInteger(recordedMaxParts) ||
        recordedMaxParts < 1)
    ) {
      return '`config.maxParts` must be a positive integer or null';
    }

    const budgets = candidate.budgets;
    if (!budgets || typeof budgets !== "object" || Array.isArray(budgets)) {
      return 'missing "budgets" object';
    }
    for (const key of ["maxPartBytes", "largeFileBytes"]) {
      const value = (budgets as Record<string, unknown>)[key];
      if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0) {
        return `\`budgets.${key}\` must be a non-negative integer`;
      }
    }

    if (!candidate.indexes || typeof candidate.indexes !== "object" || Array.isArray(candidate.indexes)) {
      return 'missing "indexes" object';
    }
    if (!candidate.kinds || typeof candidate.kinds !== "object" || Array.isArray(candidate.kinds)) {
      return 'missing "kinds" object';
    }

    // The completeness contract, added in 0.10.0. This guard predated it and checked only the
    // fields that existed when it was written, so `incomplete[]` — the one list whose purpose is
    // to say what is *missing* — was the one list nothing verified. Ten tampered variants of a
    // real record, including a `relativePath` of `../escape.ts`, all reported "valid and up to
    // date".
    const incompleteCount = (counts as Record<string, unknown>).incompleteCount;
    if (
      typeof incompleteCount !== "number" ||
      !Number.isSafeInteger(incompleteCount) ||
      incompleteCount < 0
    ) {
      return 'missing numeric `counts.incompleteCount`';
    }
    const incomplete = candidate.incomplete;
    if (!Array.isArray(incomplete)) return 'missing "incomplete" array';
    if (incompleteCount !== incomplete.length) {
      return '`counts.incompleteCount` does not match the length of `incomplete`';
    }
    for (const entry of incomplete) {
      if (!entry || typeof entry !== "object" || Array.isArray(entry)) {
        return 'an "incomplete" entry is not an object';
      }
      const fields = entry as Record<string, unknown>;
      const relativePath = fields.relativePath;
      if (typeof relativePath !== "string" || relativePath.length === 0) {
        return 'an "incomplete" entry has no "relativePath"';
      }
      // The third of the three path-bearing arrays, and the only one that was unguarded:
      // `files[].relativePath` and `parts[].filename` were already confined.
      if (!isConfinedRelative(relativePath)) {
        return 'an "incomplete" entry "relativePath" must stay inside the repository';
      }
      if (typeof fields.part !== "string" || fields.part.trim() === "") {
        return 'an "incomplete" entry has no "part"';
      }
      if (typeof fields.reason !== "string" || !TRUNCATION_REASONS.has(fields.reason)) {
        return 'an "incomplete" entry has an unknown "reason"';
      }
      for (const key of ["omittedLines", "includedLines", "lines"]) {
        const value = fields[key];
        if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0) {
          return `an "incomplete" entry "${key}" must be a non-negative integer`;
        }
      }
      const lines = fields.lines as number;
      if (fields.includedLines as number > lines) {
        return 'an "incomplete" entry "includedLines" exceeds its "lines"';
      }
      const ranges = fields.omittedRanges;
      if (!Array.isArray(ranges)) return 'an "incomplete" entry has no "omittedRanges" array';
      let previousEnd = 0;
      let omitted = 0;
      for (const range of ranges) {
        if (!Array.isArray(range) || range.length !== 2) {
          return 'an "incomplete" entry "omittedRanges" must hold [from, to] pairs';
        }
        const [from, to] = range as unknown[];
        if (
          typeof from !== "number" ||
          typeof to !== "number" ||
          !Number.isSafeInteger(from) ||
          !Number.isSafeInteger(to)
        ) {
          return 'an "incomplete" entry "omittedRanges" must hold integer pairs';
        }
        if (from < 1 || to < from || to > lines) {
          return `an "incomplete" entry records an omitted range ${from}-${to}, outside 1-${lines}`;
        }
        if (from <= previousEnd) {
          return 'an "incomplete" entry "omittedRanges" must be sorted and non-overlapping';
        }
        previousEnd = to;
        omitted += to - from + 1;
      }
      if (omitted !== fields.omittedLines) {
        return '`omittedLines` does not match the ranges it records';
      }
    }
  }

  if (!Array.isArray(candidate.files)) return 'missing "files" array';
  for (const entry of candidate.files) {
    if (!entry || typeof entry !== "object" || Array.isArray(entry)) {
      return 'a "files" entry is not an object';
    }
    const fields = entry as Record<string, unknown>;
    if (typeof fields.relativePath !== "string") {
      return 'a "files" entry has no "relativePath"';
    }
    if (!currentSchema) continue;
    if (typeof fields.part !== "string" || fields.part.length === 0) {
      return 'a "files" entry records no "part"';
    }
    if (typeof fields.hashSha256 !== "string" || !/^[0-9a-f]{64}$/.test(fields.hashSha256)) {
      return 'a "files" entry "hashSha256" must be a 64-character lowercase sha256 hex digest';
    }
    for (const key of ["sizeBytes", "lines"]) {
      const value = fields[key];
      if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0) {
        return `a "files" entry "${key}" must be a non-negative integer`;
      }
    }
    if (!["full", "preview", "signatures", "comments-stripped"].includes(String(fields.inclusionMode))) {
      return 'a "files" entry has an unknown "inclusionMode"';
    }
  }

  if (!Array.isArray(candidate.skipped)) return 'missing "skipped" array';
  if (!Array.isArray(candidate.parts)) return 'missing "parts" array';
  for (const entry of candidate.parts) {
    if (!entry || typeof entry !== "object" || Array.isArray(entry)) {
      return 'a "parts" entry is not an object';
    }
    const fields = entry as Record<string, unknown>;
    const filename = fields.filename;
    if (typeof filename !== "string" || filename.trim() === "") {
      return 'a "parts" entry has no "filename"';
    }
    // A part is a file directly inside `parts/`, so its name is bare by construction. The check is
    // here rather than only at the read sites because three separate readers — `validate`,
    // the MCP `snapshot_read` tool and the `snapshot://parts/{n}` resource — answer from this
    // manifest, and a manifest is an input that a repository author controls. A name that leaves
    // the directory is not a snapshot manifest at all, which is a shape problem and is reported
    // as one everywhere at once.
    if (
      filename.includes("/") ||
      filename.includes("\\") ||
      filename.includes("\0") ||
      filename === "." ||
      filename === ".." ||
      path.isAbsolute(filename)
    ) {
      return 'a "parts" entry "filename" must be a bare filename inside parts/';
    }
    if (currentSchema) {
      if (typeof fields.sha256 !== "string" || !/^[0-9a-f]{64}$/.test(fields.sha256)) {
        return 'a "parts" entry "sha256" must be a 64-character lowercase sha256 hex digest';
      }
      if (
        typeof fields.byteSize !== "number" ||
        !Number.isSafeInteger(fields.byteSize) ||
        fields.byteSize < 0
      ) {
        return 'a "parts" entry "byteSize" must be a non-negative integer';
      }
      if (typeof fields.index !== "number" || !Number.isSafeInteger(fields.index) || fields.index < 1) {
        return 'a "parts" entry "index" must be a positive integer';
      }
      if (!Array.isArray(fields.includedFiles)) {
        return 'a "parts" entry has no "includedFiles" array';
      }
    }
  }

  if (!candidate.layers || typeof candidate.layers !== "object" || Array.isArray(candidate.layers)) {
    return 'missing "layers" object';
  }
  return null;
}

/**
 * Validates a generated snapshot against the working tree and against the
 * recorded configuration.
 *
 * Beyond source-file hashes this now also:
 * - refuses a manifest that does not have the expected shape (previously threw
 *   an uncaught `TypeError`),
 * - verifies every emitted `parts/*.md` against its recorded `byteSize`/`sha256`
 *   (previously a deleted or corrupted part still reported `valid: true`),
 * - re-checks the effective configuration and the part/file bookkeeping,
 * - verifies monolith artefact digests when present.
 */
export function validateSnapshot(
  configInput: ResolvedSnapshotConfig | SnapshotConfig
): ValidationResult {
  assertUsableConfigInput(configInput);

  const config = isResolvedConfig(configInput)
    ? normalizeResolvedConfig(configInput)
    : resolveConfig(configInput);
  // `path.resolve` so an absolute outDir is not appended to cwd.
  const manifestPath = path.resolve(config.cwd, config.outDir, "manifest.json");

  if (!fs.existsSync(manifestPath)) {
    // "Not found" is the wrong diagnosis when a run died: the directory is there, it even carries
    // this tool's marker, and the marker says a snapshot was being written. Saying "run generate
    // first" forever sent the reader round a loop that could not terminate.
    return {
      valid: false,
      manifestPresent: false,
      drift: emptyDrift(),
      errors: [describeMissingManifest(config, manifestPath)],
      warnings: [],
    };
  }

  let manifest: Manifest;
  try {
    manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8")) as Manifest;
  } catch (err) {
    return {
      valid: false,
      manifestPresent: true,
      drift: emptyDrift(),
      errors: [`Failed to parse snapshot manifest: ${(err as Error).message}`],
      warnings: [],
    };
  }

  // The same guard `report` and `diff` use, so the three commands agree about what
  // a manifest is. The array-only check this replaced accepted a manifest whose
  // `fingerprint` had been deleted, and answered "valid and up to date".
  const shapeProblem = describeManifestShapeProblem(manifest);
  if (shapeProblem) {
    return {
      valid: false,
      manifestPresent: true,
      drift: emptyDrift(),
      errors: [`${manifestPath} is not a snapshot manifest: ${shapeProblem}`],
      warnings: [],
    };
  }

  const drift = emptyDrift();
  const warnings: string[] = [];
  const snapshotDir = path.resolve(config.cwd, config.outDir);

  // A file that could not be read when the snapshot was taken is recorded as a skip, and a skip
  // is invisible to every later check because there is no hash to compare. Say so, rather than
  // letting a validate run over a dirty tree report only "uncommitted changes".
  const unreadableSkips = manifest.skipped.filter(
    (entry) => entry.reason === "missing" || entry.reason === "read-error"
  );
  if (unreadableSkips.length > 0) {
    warnings.push(
      `${unreadableSkips.length} path(s) could not be read when this snapshot was generated ` +
        "(see manifest.skipped[] with reason \"missing\" or \"read-error\"); they are not in the snapshot."
    );
  }
  // A function matcher's closure is not part of the digest: two matchers with identical source
  // and different captured values digest identically. Saying so is the honest half of the fix; the
  // alternative was claiming a drift check the digest cannot perform.
  if ([...config.layers, ...config.kinds].some((rule) => typeof rule.match === "function")) {
    warnings.push(
      "The configuration uses executable (function) matchers; the recorded digest covers their " +
        "source text, not the values they capture, so it cannot prove their classification is unchanged."
    );
  }

  // ---- source files -------------------------------------------------------
  const manifestFileMap = new Map<string, string>();
  const manifestFilesByPath = new Map<string, (typeof manifest.files)[number]>();
  for (const file of manifest.files) {
    if (file && typeof file.relativePath === "string") {
      manifestFileMap.set(file.relativePath, file.hashSha256);
      manifestFilesByPath.set(file.relativePath, file);
    }
  }

  // ---- completeness contract ---------------------------------------------
  // `verifyInMemory` enforces this while generating. Once `manifest.json` is on disk it is an
  // *input*, and `validate` is the only command that reads it as one — so the two statements of
  // "what is missing" have to be checked against each other here, or the shape guard's field list
  // is the only thing standing between a tampered record and "valid and up to date".
  const incompleteRecords = manifest.incomplete ?? [];
  const incompleteness = new Map<string, (typeof incompleteRecords)[number]>();
  for (const record of incompleteRecords) {
    incompleteness.set(record.relativePath, record);
    const label = maskedPath(record.relativePath, config.secretRules);
    const file = manifestFilesByPath.get(record.relativePath);
    if (file === undefined) {
      drift.partIssues.push({
        part: "(manifest)",
        issue: `${label} is in incomplete[] but not in files[]`,
      });
      continue;
    }
    if (file.part !== record.part) {
      drift.partIssues.push({
        part: "(manifest)",
        issue:
          `${label} is recorded in part ${String(record.part)} in incomplete[] and part ` +
          `${String(file.part)} in files[]`,
      });
    }
    if (file.truncationReason !== record.reason) {
      drift.partIssues.push({
        part: "(manifest)",
        issue:
          `${label} records truncationReason ${String(file.truncationReason)} in files[] and ` +
          `reason ${String(record.reason)} in incomplete[]`,
      });
    }
    const recordedRanges = file.omittedRanges ?? [];
    const rangesAgree =
      recordedRanges.length === record.omittedRanges.length &&
      recordedRanges.every(
        ([from, to], index) =>
          record.omittedRanges[index][0] === from && record.omittedRanges[index][1] === to
      );
    if (!rangesAgree || file.includedLines !== record.includedLines || file.lines !== record.lines) {
      drift.partIssues.push({
        part: "(manifest)",
        issue: `${label} records different omission numbers in files[] and incomplete[]`,
      });
    }
  }
  for (const file of manifest.files) {
    if (file.truncationReason === undefined) continue;
    if (incompleteness.has(file.relativePath)) continue;
    drift.partIssues.push({
      part: "(manifest)",
      issue: `${maskedPath(file.relativePath, config.secretRules)} records a truncationReason but is missing from incomplete[]`,
    });
  }

  // Paths in the shipped manifest are already masked, so a disk path is matched
  // in both forms: raw (record predates masking) and masked (current records).
  const skippedReasons = new Map<string, string>();
  for (const entry of manifest.skipped) {
    if (entry && typeof entry.path === "string" && typeof entry.reason === "string") {
      skippedReasons.set(entry.path, entry.reason);
    }
  }
  /** The recorded reason this disk path was skipped for, or null when it was not. */
  const skippedReasonOnDisk = (diskFile: string): string | null => {
    const direct = skippedReasons.get(diskFile);
    if (direct !== undefined) return direct;
    return skippedReasons.get(maskedPath(diskFile, config.secretRules)) ?? null;
  };

  /**
   * The changed-files scope the snapshot was generated under, re-resolved now.
   *
   * `null` means the snapshot was not scoped. `scopeUnresolved` means it was scoped and the
   * scope cannot be reconstructed (no git, or git refused the ref) — in that case a recorded
   * `unchanged` skip is trusted, with a warning, because guessing "missing" for every file in
   * the repository is worse than saying the check could not be completed.
   */
  let unchangedScope: Set<string> | null = null;
  const recordedChangedSince = manifest.config?.changedSince;
  const recordedStaged = manifest.config?.staged === true;
  const recordedWithDependents = manifest.config?.withDependents === true;
  if (recordedChangedSince !== undefined || recordedStaged) {
    try {
      unchangedScope = new Set(
        resolveChangedScope(config.cwd, {
          ...(recordedChangedSince === undefined ? {} : { changedSince: recordedChangedSince }),
          ...(recordedStaged ? { staged: true } : {}),
        }).paths
      );
    } catch {
      warnings.push(
        "The snapshot was generated with a changed-files scope, but that scope could not be " +
          "re-resolved; files it recorded as `unchanged` were trusted rather than re-checked."
      );
    }
  }

  /**
   * True when a file recorded as `unchanged` now imports something that changed.
   *
   * With `--with-dependents` the effective scope is the changed set **plus one hop of importers**,
   * and only the generator applied that hop. A file that has since started importing a changed
   * module belongs in the snapshot and is not in it, which is drift — but `validate` compared
   * path sets only, so it called a snapshot stale-in-the-other-direction correct.
   *
   * Only the file under test is parsed, and only when the manifest says the run used
   * `--with-dependents`. The alternative — parsing every candidate up front — would make a
   * scoped `validate` read the whole repository to answer a question about one file.
   */
  let dependentResolver: ImportResolver | null = null;
  function becameDependent(diskFile: string): boolean {
    if (!recordedWithDependents || unchangedScope === null) return false;
    // Built on first use: `collection` is created just below, and the common case has no
    // dependents at all, so the resolver must not be built for every scoped validation.
    dependentResolver ??= buildImportResolver(
      collection.files.map((file) => ({ relativePath: file }))
    );
    return importsChangedFile(
      diskFile,
      importsOfFile(diskFile, path.join(config.cwd, diskFile)),
      unchangedScope,
      dependentResolver
    );
  }

  const collection = collectFiles(config.cwd, {
    includePatterns: config.include,
    excludePatterns: [...config.excludePatterns, ...config.presetExclude],
    includeSensitiveFiles: config.includeSensitiveFiles,
    secretRules: config.secretRules,
    // Passed explicitly, like `generate` does. Relying on a process-wide "current
    // discovery mode" meant `validate` could enumerate files one way while the snapshot
    // had been generated another way, and then blame the difference on drift.
    discovery: config.discovery,
    // The same exclusion `generate` applies: without it, `validate` recounted the tool's
    // own output directory as a set of files missing from the snapshot, so a correct
    // snapshot was reported as drifting.
    toolOwnedPaths: [config.outDir, config.tmpDir]
      .map((directory) =>
        path.relative(config.cwd, path.resolve(config.cwd, directory)).replace(/\\/g, "/")
      )
      .filter((relative) => relative.length > 0 && !relative.startsWith("..")),
  });

  for (const diskFile of collection.files) {
    const snapshotHash = manifestFileMap.get(diskFile);
    if (snapshotHash === undefined) {
      // A path in `skipped[]` is not permanently exempt: re-evaluate it and
      // report drift when it would now be included.
      const skipReason = skippedReasonOnDisk(diskFile);
      // A file skipped as `unchanged` was narrowed out on purpose, so it is not missing. Asking
      // `wouldNowBeIncluded` about it — which only answers "is this text?" — said yes for every
      // source file in the repository and reported all of them as `new file:`, failing
      // `validate` on every snapshot built with `--changed-since`. What can be checked is
      // whether the file is *still* outside the recorded scope: if it has changed since, the
      // snapshot predates it and the drift is real.
      if (skipReason === "unchanged") {
        if (unchangedScope !== null) {
          if (unchangedScope.has(diskFile) || becameDependent(diskFile)) {
            drift.missingInSnapshot.push(diskFile);
          }
        }
        continue;
      }
      // `not-selected` is a `--slice` or `--budget-tokens` decision. Re-running the planner here
      // would need the flags and the question, which the manifest does not carry, so validate does
      // not second-guess the selection: the file is accounted for, and the result says the
      // selection was not re-evaluated. Reporting every unselected source file as "new" failed a
      // correct snapshot on every slice.
      if (skipReason === "not-selected") continue;
      if (skipReason !== null && !wouldNowBeIncluded(config.cwd, diskFile)) continue;
      drift.missingInSnapshot.push(diskFile);
      continue;
    }

    // The other direction, which this loop never asked. A file that *is* in the snapshot has to
    // still be in the recorded scope: staging a file, generating, then committing or unstaging it
    // leaves the bytes on disk identical, so the hash comparison below is satisfied and `validate`
    // said "valid and up to date" for a snapshot taken over a scope that no longer exists. The
    // file is in the snapshot and would not be if it were generated now, which is drift in exactly
    // the sense that matters.
    if (
      unchangedScope !== null &&
      !unchangedScope.has(diskFile) &&
      !becameDependent(diskFile)
    ) {
      drift.configMismatches.push(
        `scope: ${maskedPath(diskFile, config.secretRules)} is in the snapshot but is no longer ` +
          "in the changed-files scope"
      );
    }

    let diskHash: string;
    try {
      diskHash = sha256Hex(fs.readFileSync(path.join(config.cwd, diskFile)));
    } catch (err) {
      // A file that exists but cannot be read is not a deleted file. Filing it under "no longer
      // exists on disk" sent the reader looking for a file that is right there, and it is a
      // different problem with a different fix (permissions, not a re-generate).
      if ((err as NodeJS.ErrnoException).code === "ENOENT") {
        drift.missingOnDisk.push(diskFile);
      } else {
        drift.unreadable.push(diskFile);
      }
      continue;
    }
    if (diskHash !== snapshotHash) {
      drift.hashMismatches.push({ path: diskFile, diskHash, snapshotHash });
    }
  }

  for (const snapshotFile of manifestFileMap.keys()) {
    // The manifest is an input, and `path.join` accepts `../..`, so this loop used to answer
    // "does this path exist?" for any file on the machine: a traversal entry was silently accepted
    // when the target existed and reported as `deleted: ../../secret` when it did not. A recorded
    // path that does not stay inside the repository is a foreign or tampered manifest, and is
    // reported as that instead of being resolved.
    const confined = confineToDirectory(config.cwd, snapshotFile);
    if (confined === null) {
      drift.partIssues.push({
        part: "(manifest)",
        issue: `${maskedPath(snapshotFile, config.secretRules)} resolves outside the repository and was not inspected`,
      });
      continue;
    }
    // `existsSync` answers false for a path this process is not allowed to *stat*, and that is a
    // runtime difference: on Node 18 a Windows Deny-Read ACE makes `statSync` throw EPERM, while
    // Node 20+ stats it fine. Trusting the boolean reported an unreadable file as "no longer
    // exists on disk" — the precise wrong answer this class exists to prevent. Ask *why* the path
    // is not statable instead.
    let statFailure: NodeJS.ErrnoException | null = null;
    try {
      fs.statSync(confined);
    } catch (err) {
      statFailure = err as NodeJS.ErrnoException;
    }
    if (statFailure !== null) {
      if (statFailure.code === "ENOENT" || statFailure.code === "ENOTDIR") {
        drift.missingOnDisk.push(snapshotFile);
      } else {
        drift.unreadable.push(snapshotFile);
      }
    }
  }

  // A tracked-but-deleted file is seen by both loops above — the read fails, then
  // it is absent from disk — so it was reported (and counted) twice. The same is true of an
  // unreadable one now that the second loop asks *why* a path cannot be stat'd instead of
  // trusting `existsSync` (which answers false for a denied read on Node 18).
  drift.missingOnDisk = [...new Set(drift.missingOnDisk)];
  drift.unreadable = [...new Set(drift.unreadable)];

  // With per-layer budgets the largest legitimate part ceiling is the biggest
  // of them, not `maxPartBytes` alone.
  const maxEffectiveBudget = Math.max(
    config.maxPartBytes,
    config.budgets.default,
    ...Object.values(config.budgets.byLayer)
  );

  // ---- emitted parts ------------------------------------------------------
  // `partNames` is needed for the cross-check below even when parts were
  // deliberately not written, so it is always collected.
  const partNames = new Set<string>();
  const partsDir = path.join(snapshotDir, "parts");
  for (const part of manifest.parts) {
    if (!part || typeof part.filename !== "string") continue;
    partNames.add(part.filename);

    if (!config.artifacts.parts) continue;

    const partPath = confineToDirectory(partsDir, part.filename);
    if (partPath === null) {
      // A manifest is an input, so its filenames are untrusted: `path.join` would happily turn
      // `../../../etc/passwd` into a read outside the snapshot and report that file's byte size
      // and digest back to the caller. A part filename is a bare name by construction.
      drift.partIssues.push({
        part: part.filename,
        issue: "filename resolves outside snapshot/parts; refusing to read it",
      });
      continue;
    }
    let buffer: Buffer;
    try {
      buffer = fs.readFileSync(partPath);
    } catch {
      drift.partIssues.push({ part: part.filename, issue: "missing from snapshot/parts" });
      continue;
    }
    if (buffer.length !== part.byteSize) {
      drift.partIssues.push({
        part: part.filename,
        issue: `byteSize is ${part.byteSize} in the manifest but ${buffer.length} on disk`,
      });
    }
    if (sha256Hex(buffer) !== part.sha256) {
      drift.partIssues.push({ part: part.filename, issue: "sha256 does not match the manifest" });
    }
    // A part records the budget it was built against. Comparing every part with the
    // *largest* budget in the run meant a part 2× over its own layer budget passed,
    // because some other layer had a bigger one. Manifests written before
    // `budgetBytes` existed fall back to the effective maximum.
    const partBudget =
      typeof part.budgetBytes === "number" ? part.budgetBytes : maxEffectiveBudget;
    if (buffer.length > partBudget) {
      drift.partIssues.push({
        part: part.filename,
        issue:
          typeof part.budgetBytes === "number"
            ? `${buffer.length} B exceeds its part budget ${partBudget} B`
            : `${buffer.length} B exceeds the effective part budget ${partBudget} B`,
      });
    }
  }

  // The manifest is the contract every reader trusts: `snapshot_read` uses `files[].part` to
  // find a section. Summing declared `fileCount` proved nothing (two parts claiming the same
  // file still added up), an empty `part` was skipped by `if (file?.part)`, and a part that
  // exists but does not list the file passed the name check. Check the relation both ways.
  // Paths in a manifest are masked when written, but a hand-edited one is not. Every message
  // below can carry a credential-shaped path to stdout, so it is masked like every other echo.
  const maskDriftPath = (value: string): string =>
    findSecretInPath(value, config.secretRules)?.masked ?? value;
  const includedByPart = new Map<string, Set<string>>();
  const partIndexes = new Set<number>();
  for (const part of manifest.parts) {
    if (includedByPart.has(part.filename)) {
      drift.partIssues.push({
        part: maskDriftPath(part.filename),
        issue: "appears more than once in parts[]",
      });
    }
    if (typeof part.index === "number") {
      if (partIndexes.has(part.index)) {
        drift.partIssues.push({
          part: maskDriftPath(part.filename),
          issue: `reuses part index ${part.index}`,
        });
      }
      partIndexes.add(part.index);
    }
    const listed = new Set<string>();
    for (const included of part.includedFiles ?? []) {
      if (typeof included?.relativePath !== "string") continue;
      if (listed.has(included.relativePath)) {
        drift.partIssues.push({
          part: maskDriftPath(part.filename),
          issue: `lists ${maskDriftPath(included.relativePath)} twice`,
        });
      }
      listed.add(included.relativePath);
    }
    includedByPart.set(part.filename, listed);
    if (typeof part.fileCount === "number" && part.fileCount !== listed.size) {
      drift.partIssues.push({
        part: maskDriftPath(part.filename),
        issue: `declares ${part.fileCount} file(s) but lists ${listed.size} in includedFiles`,
      });
    }
  }

  const filePaths = new Set<string>();
  for (const file of manifest.files) {
    if (filePaths.has(file.relativePath)) {
      drift.partIssues.push({
        part: "(files)",
        issue: `${maskDriftPath(file.relativePath)} appears more than once in files[]`,
      });
      continue;
    }
    filePaths.add(file.relativePath);
    if (typeof file.part !== "string" || file.part.length === 0) {
      drift.partIssues.push({
        part: "(files)",
        issue: `${maskDriftPath(file.relativePath)} records no part`,
      });
      continue;
    }
    if (!partNames.has(file.part)) {
      drift.partIssues.push({
        part: maskDriftPath(file.part),
        issue: `${maskDriftPath(file.relativePath)} points at a part that is not in the manifest`,
      });
      continue;
    }
    if (!includedByPart.get(file.part)?.has(file.relativePath)) {
      drift.partIssues.push({
        part: maskDriftPath(file.part),
        issue: `${maskDriftPath(file.relativePath)} is not listed in that part's includedFiles`,
      });
    }
  }
  for (const [partName, listed] of includedByPart) {
    for (const relativePath of listed) {
      if (!filePaths.has(relativePath)) {
        drift.partIssues.push({
          part: maskDriftPath(partName),
          issue: `lists ${maskDriftPath(relativePath)}, which the manifest does not`,
        });
      }
    }
  }

  // ---- recorded configuration --------------------------------------------
  // The manifest stores config values with secret spans masked, so the current
  // side is masked the same way before comparing — otherwise a snapshot with an
  // exclude pattern that looks like a token fails its own validate, and the
  // mismatch line prints the token.
  const maskValue = (value: string): string =>
    findSecretInPath(value, config.secretRules)?.masked ?? value;
  const currentExcludes = config.excludePatterns.map(maskValue);
  const currentInclude = config.include.map(maskValue);
  const recorded = manifest.config;
  // A digest of the raw settings catches every configuration change, including the
  // ones no per-field comparison covers (layers, kinds, custom secret rules) and the
  // ones a masked comparison cannot see (a credential-shaped value changed from A to B).
  if (recorded?.digest && recorded.digest !== configDigest(config)) {
    drift.configMismatches.push(
      "configuration: the settings differ from the ones this snapshot was generated with " +
        "(run generate)"
    );
  } else if (!recorded?.digest) {
    // No digest means no way to verify the settings: the per-field fallback below covers only the
    // fields it knows, so a snapshot written before 4.0.5 — or one with the digest removed — would
    // pass while `maxMonolithBytes`, `layers`, `kinds` and custom secret rules had changed. A
    // snapshot whose configuration cannot be checked is not up to date; it is unverifiable.
    drift.configMismatches.push(
      "configuration: the manifest records no configuration digest, so settings drift cannot be " +
        "verified (run generate to record one)"
    );
  }
  if (recorded && typeof recorded === "object") {
    if (recorded.maxPartBytes !== config.maxPartBytes) {
      drift.configMismatches.push(
        `maxPartBytes: manifest ${recorded.maxPartBytes} vs current ${config.maxPartBytes}`
      );
    }
    if (recorded.largeFileBytes !== config.largeFileBytes) {
      drift.configMismatches.push(
        `largeFileBytes: manifest ${recorded.largeFileBytes} vs current ${config.largeFileBytes}`
      );
    }
    if (recorded.previewHeadLines !== config.previewHeadLines) {
      drift.configMismatches.push(
        `previewHeadLines: manifest ${recorded.previewHeadLines} vs current ${config.previewHeadLines}`
      );
    }
    if (recorded.previewTailLines !== config.previewTailLines) {
      drift.configMismatches.push(
        `previewTailLines: manifest ${recorded.previewTailLines} vs current ${config.previewTailLines}`
      );
    }
    if (recorded.includeSensitiveFiles !== config.includeSensitiveFiles) {
      drift.configMismatches.push(
        `includeSensitiveFiles: manifest ${recorded.includeSensitiveFiles} vs current ${config.includeSensitiveFiles}`
      );
    }
    // The settings added in 0.9.10–0.9.13 were recorded in the manifest and folded into the digest,
    // but never joined this list. So a changed `--skeleton` or `--max-part-tokens` produced the
    // generic "the settings differ" line and nothing else: the digest could say *that* something
    // changed and only the per-field block could say *what*, and seven settings were invisible to
    // it. A user reading "run generate" has to know which setting to change back.
    if ((recorded.maxPartTokens ?? undefined) !== (config.maxPartTokens ?? undefined)) {
      drift.configMismatches.push(
        `maxPartTokens: manifest ${String(recorded.maxPartTokens ?? "unset")} vs current ${String(config.maxPartTokens ?? "unset")}`
      );
    }
    if ((recorded.maxMonolithBytes ?? null) !== (config.maxMonolithBytes ?? null)) {
      drift.configMismatches.push(
        `maxMonolithBytes: manifest ${String(recorded.maxMonolithBytes ?? null)} vs current ${String(config.maxMonolithBytes ?? null)}`
      );
    }
    if (Boolean(recorded.skeleton) !== Boolean(config.skeleton)) {
      drift.configMismatches.push(
        `skeleton: manifest ${Boolean(recorded.skeleton)} vs current ${Boolean(config.skeleton)}`
      );
    }
    if (Boolean(recorded.sarif) !== Boolean(config.sarif)) {
      drift.configMismatches.push(
        `sarif: manifest ${Boolean(recorded.sarif)} vs current ${Boolean(config.sarif)}`
      );
    }
    if ((recorded.changedSince ?? undefined) !== (config.changedSince ?? undefined)) {
      drift.configMismatches.push(
        `changedSince: manifest ${String(recorded.changedSince ?? "unset")} vs current ${String(config.changedSince ?? "unset")}`
      );
    }
    if (Boolean(recorded.staged) !== Boolean(config.staged)) {
      drift.configMismatches.push(
        `staged: manifest ${Boolean(recorded.staged)} vs current ${Boolean(config.staged)}`
      );
    }
    if (Boolean(recorded.withDependents) !== Boolean(config.withDependents)) {
      drift.configMismatches.push(
        `withDependents: manifest ${Boolean(recorded.withDependents)} vs current ${Boolean(config.withDependents)}`
      );
    }
    // Both are recorded, so the drift can be named instead of left inside the digest.
    // "the settings differ (run generate)" is true and useless when the owner edited their brief.
    const recordedTask = recorded.promptTask;
    if (recordedTask !== undefined && recordedTask !== config.promptTask) {
      drift.configMismatches.push(
        `promptTask: manifest ${String(recordedTask)} vs current ${config.promptTask}`
      );
    }
    const recordedBrief = recorded.brief as { path?: unknown; digest?: unknown } | undefined;
    const recordedBriefDigest =
      recordedBrief !== undefined && typeof recordedBrief.digest === "string"
        ? recordedBrief.digest
        : undefined;
    const currentBriefDigest = config.brief?.digest;
    if (recordedBriefDigest !== currentBriefDigest) {
      drift.configMismatches.push(
        recordedBriefDigest === undefined
          ? "brief: none recorded vs current " + String(config.brief?.path)
          : currentBriefDigest === undefined
            ? "brief: manifest " + String(recordedBrief?.path) + " vs current none"
            : "brief: " + String(recordedBrief?.path) + " changed since this snapshot was generated"
      );
    }
    const effectiveDiscovery = config.discovery ?? "auto";
    const recordedDiscovery = recorded.discovery;
    if (recordedDiscovery !== undefined && recordedDiscovery !== effectiveDiscovery) {
      // How files were discovered changes which files a snapshot contains, so it is drift in
      // exactly the same sense as a changed exclude pattern. Manifests written before this was
      // recorded carry no key at all, and "not recorded" is not the same as "different".
      drift.configMismatches.push(
        `discovery: manifest ${recordedDiscovery} vs current ${effectiveDiscovery}`
      );
    }
    const recordedExcludes = Array.isArray(recorded.excludePatterns)
      ? recorded.excludePatterns
      : [];
    if (recordedExcludes.join("\u0000") !== currentExcludes.join("\u0000")) {
      drift.configMismatches.push(
        `excludePatterns: manifest [${recordedExcludes.join(", ")}] vs current [${currentExcludes.join(", ")}]`
      );
    }
    const recordedInclude = Array.isArray(recorded.include) ? recorded.include : [];
    if (recordedInclude.join("\u0000") !== currentInclude.join("\u0000")) {
      drift.configMismatches.push(
        `include: manifest [${recordedInclude.join(", ")}] vs current [${currentInclude.join(", ")}]`
      );
    }
    // Snapshots written before the artifact selection existed do not record it;
    // absent is treated as "all generated by default" rather than as drift, so
    // older snapshots keep validating.
    if (recorded?.artifacts && typeof recorded.artifacts === "object") {
      for (const name of ARTIFACT_NAMES) {
        if (recorded.artifacts[name] !== config.artifacts[name]) {
          drift.configMismatches.push(
            `artifacts.${name}: manifest ${recorded.artifacts[name]} vs current ${config.artifacts[name]}`
          );
        }
      }
    }

    if (recorded?.preset !== undefined && recorded.preset !== config.preset) {
      drift.configMismatches.push(
        `preset: manifest ${recorded.preset} vs current ${config.preset}`
      );
    }

    if (recorded?.layersMode !== undefined && recorded.layersMode !== config.layersMode) {
      drift.configMismatches.push(
        `layersMode: manifest ${recorded.layersMode} vs current ${config.layersMode}`
      );
    }

    const recordedBudgets = recorded?.budgets;
    if (recordedBudgets && typeof recordedBudgets === "object") {
      if (recordedBudgets.default !== config.budgets.default) {
        drift.configMismatches.push(
          `budgets.default: manifest ${recordedBudgets.default} vs current ${config.budgets.default}`
        );
      }
      const recordedByLayer = recordedBudgets.byLayer ?? {};
      const layerNames = new Set([
        ...Object.keys(recordedByLayer),
        ...Object.keys(config.budgets.byLayer),
      ]);
      for (const layer of Array.from(layerNames).sort()) {
        if (recordedByLayer[layer] !== config.budgets.byLayer[layer]) {
          drift.configMismatches.push(
            `budgets.byLayer.${layer}: manifest ${recordedByLayer[layer]} vs current ${config.budgets.byLayer[layer]}`
          );
        }
      }
    }
  } else {
    drift.configMismatches.push("manifest does not record the effective configuration");
  }

  // ---- internal bookkeeping ----------------------------------------------
  // A manifest whose counts/totals/budgets disagree with its own file and part
  // lists is not trustworthy, even if every hash happens to match.
  const totalsMismatches = drift.totalsMismatches;
  const expectEqual = (label: string, recordedValue: unknown, actual: number): void => {
    if (recordedValue !== actual) {
      totalsMismatches.push(`${label}: manifest ${String(recordedValue)} vs actual ${actual}`);
    }
  };

  const counts = manifest.counts ?? ({} as Manifest["counts"]);
  const totals = manifest.totals ?? ({} as Manifest["totals"]);
  const sumSourceBytes = manifest.files.reduce(
    (total, file) => total + (typeof file?.sizeBytes === "number" ? file.sizeBytes : 0),
    0
  );
  const sumIncludedBytes = manifest.parts.reduce(
    (total, part) =>
      total +
      (Array.isArray(part?.includedFiles)
        ? part.includedFiles.reduce(
            (inner, entry) =>
              inner + (typeof entry?.includedBytes === "number" ? entry.includedBytes : 0),
            0
          )
        : 0),
    0
  );

  expectEqual("counts.totalFiles", counts.totalFiles, manifest.files.length);
  // A manifest whose file list was edited kept a valid-looking `totalLines` and fingerprint.
  // Both are recomputable from the manifest itself, so they are reconciled rather than trusted.
  if (manifest.files.every((file) => typeof file?.lines === "number")) {
    expectEqual(
      "counts.totalLines",
      counts.totalLines,
      manifest.files.reduce((total, file) => total + file.lines, 0)
    );
  }
  expectEqual("counts.partsCount", counts.partsCount, manifest.parts.length);
  expectEqual("counts.skippedCount", counts.skippedCount, manifest.skipped.length);
  expectEqual("counts.totalSizeBytes", counts.totalSizeBytes, sumSourceBytes);
  expectEqual("totals.includedFiles", totals.includedFiles, manifest.files.length);
  expectEqual("totals.partCount", totals.partCount, manifest.parts.length);
  expectEqual("totals.skippedFiles", totals.skippedFiles, manifest.skipped.length);
  expectEqual("totals.totalSourceBytes", totals.totalSourceBytes, sumSourceBytes);
  expectEqual("totals.totalContentBytes", totals.totalContentBytes, sumIncludedBytes);
  expectEqual(
    "totals.candidateFiles",
    totals.candidateFiles,
    manifest.files.length + manifest.skipped.length
  );
  expectEqual(
    "totals.warningCount",
    totals.warningCount,
    Array.isArray(manifest.warnings) ? manifest.warnings.length : 0
  );
  if (
    typeof totals.fullFiles === "number" &&
    typeof totals.previewFiles === "number" &&
    totals.fullFiles + totals.previewFiles !== manifest.files.length
  ) {
    totalsMismatches.push(
      `totals.fullFiles + previewFiles (${totals.fullFiles} + ${totals.previewFiles}) != ${manifest.files.length} files`
    );
  }
  // The fingerprint identifies the snapshot; a manifest whose file list was edited (a hash
  // changed, a file removed, an inclusion mode flipped) kept a valid-looking value because only
  // its shape was checked. Recompute it from the manifest's own files and recorded settings
  // digest. The pre-0.9.17 formula also folded in `inclusionMode`; that value is accepted so a
  // snapshot written by an older build keeps validating.
  const recordedSettingsDigest =
    manifest.config && typeof manifest.config.digest === "string"
      ? manifest.config.digest
      : null;
  if (recordedSettingsDigest !== null && manifest.files.every((file) => typeof file?.hashSha256 === "string")) {
    const settingsLine = `settings:${recordedSettingsDigest}`;
    const currentDefinition = sha256Hex(
      Buffer.from(
        [
          ...manifest.files.map(
            (file) => `${file.relativePath}:${file.hashSha256}:${file.sizeBytes}`
          ),
          settingsLine,
        ].join("\n"),
        "utf8"
      )
    );
    const legacyDefinition = sha256Hex(
      Buffer.from(
        [
          ...manifest.files.map(
            (file) =>
              `${file.relativePath}:${file.hashSha256}:${file.sizeBytes}:${file.inclusionMode}`
          ),
          settingsLine,
        ].join("\n"),
        "utf8"
      )
    );
    if (manifest.fingerprint !== currentDefinition && manifest.fingerprint !== legacyDefinition) {
      totalsMismatches.push(
        "fingerprint: does not match the files and settings recorded in this manifest"
      );
    }
  }

  // With the experimental `maxParts`, the effective ceiling is derived from the file sizes and
  // grows past the configured one, so the field legitimately disagrees with the config. The
  // configured number is still covered by the config digest, together with `maxParts` itself.
  const ceilingDerivedByMaxParts = (manifest.config?.maxParts ?? null) !== null;
  if (!ceilingDerivedByMaxParts && manifest.budgets && manifest.budgets.maxPartBytes !== config.maxPartBytes) {
    totalsMismatches.push(
      `budgets.maxPartBytes: manifest ${manifest.budgets.maxPartBytes} vs current ${config.maxPartBytes}`
    );
  }
  if (manifest.budgets && manifest.budgets.largeFileBytes !== config.largeFileBytes) {
    totalsMismatches.push(
      `budgets.largeFileBytes: manifest ${manifest.budgets.largeFileBytes} vs current ${config.largeFileBytes}`
    );
  }

  // ---- git ----------------------------------------------------------------
  if (manifest.git && typeof manifest.git.commit === "string") {
    const current = getGitInfo(config.cwd, config.branch);
    if (
      manifest.git.commit !== "unknown" &&
      current.commit !== "unknown" &&
      manifest.git.commit !== current.commit
    ) {
      warnings.push(
        `Snapshot was generated at commit ${manifest.git.commit.slice(0, 8)} but HEAD is ${current.commit.slice(0, 8)}.`
      );
    }
    if (current.isDirty) {
      warnings.push("Working tree has uncommitted changes.");
    }
  }

  // ---- declared integrity -------------------------------------------------
  if (manifest.validation && manifest.validation.status === "failed") {
    const declared = Array.isArray(manifest.validation.errors)
      ? manifest.validation.errors
      : [];
    for (const error of declared) {
      drift.configMismatches.push(`manifest declared itself invalid: ${error}`);
    }
  }

  // ---- declared artifacts -------------------------------------------------
  // Every artifact the manifest records a digest for is checked the same way. Before this, only
  // the monoliths and SARIF were: deleting README.md, reports/navigation.md,
  // reports/project-tree.md or reports/audit.md — the first files a reader opens — left
  // `validate` green.
  const declaredArtifacts: Array<[string, ManifestArtifact | null | undefined]> = [
    ["README.md", manifest.artifacts?.readme],
    ["PROMPT.md", manifest.artifacts?.prompt],
    ["reports/navigation.md", manifest.artifacts?.navigation],
    ["reports/project-tree.md", manifest.artifacts?.projectTree],
    ["reports/audit.md", manifest.artifacts?.audit],
    // The opt-in reports are declared exactly like the others, so deleting one must fail here
    // for the same reason: the manifest says it exists and the directory says otherwise.
    ["reports/diff.md", manifest.artifacts?.diff],
    ["reports/log.md", manifest.artifacts?.log],
    ["reports/tokens.md", manifest.artifacts?.tokenTree],
    ["full-codebase.json", manifest.artifacts?.fullJson],
    ["full-codebase.md", manifest.artifacts?.fullMarkdown],
    ["full-codebase.xml", manifest.artifacts?.fullXml],
  ];
  for (const [key, artifact] of declaredArtifacts) {
    if (!artifact) continue;
    const artifactPath = path.join(snapshotDir, ...key.split("/"));
    let buffer: Buffer;
    try {
      if (!fs.statSync(artifactPath).isFile()) throw new Error("not a regular file");
      buffer = fs.readFileSync(artifactPath);
    } catch {
      drift.partIssues.push({ part: key, issue: "declared artifact is missing" });
      continue;
    }
    if (sha256Hex(buffer) !== artifact.sha256 || buffer.length !== artifact.byteSize) {
      drift.partIssues.push({ part: key, issue: "artifact does not match its recorded digest" });
      continue;
    }
    // The navigation index is the map into the snapshot; a link it carries that points at
    // nothing is a dead end a reader only discovers after opening the file.
    if (key === "reports/navigation.md") {
      for (const match of buffer.toString("utf8").matchAll(/\]\(([^)\s]+)\)/g)) {
        const target = (match[1] as string).split("#")[0] as string;
        if (target.length === 0 || /^[a-z][a-z0-9+.-]*:/i.test(target)) continue;
        const resolved = path.resolve(snapshotDir, "reports", target);
        const relative = path.relative(snapshotDir, resolved);
        if (relative.startsWith("..") || path.isAbsolute(relative) || !fs.existsSync(resolved)) {
          drift.partIssues.push({
            part: key,
            issue: `links to ${maskedPath(target, config.secretRules)}, which does not exist in the snapshot`,
          });
        }
      }
    }
  }

  // ---- SARIF --------------------------------------------------------------
  // The SARIF log is the one artifact designed to leave the repository — it is uploaded to code
  // scanning — so a copy that no longer matches its recorded digest is worse than most stale
  // files: it is a security report that describes a snapshot that is not the one on disk. It
  // lives under `reports/`, so it needs its own path rather than the loop above.
  const sarifArtifact = manifest.artifacts?.sarif;
  if (sarifArtifact) {
    const sarifKey = "reports/audit.sarif";
    try {
      const buffer = fs.readFileSync(path.join(snapshotDir, "reports", "audit.sarif"));
      if (sha256Hex(buffer) !== sarifArtifact.sha256 || buffer.length !== sarifArtifact.byteSize) {
        drift.partIssues.push({ part: sarifKey, issue: "artifact does not match its recorded digest" });
      }
    } catch {
      drift.partIssues.push({ part: sarifKey, issue: "declared artifact is missing" });
    }
  }

  // ---- git ----------------------------------------------------------------
  if (manifest.git && manifest.git.branch && manifest.git.branch !== config.branch) {
    // A branch name is repository-controlled text and can be credential-shaped
    // (`feature/AKIA…`). Every other configuration echo on this path is masked; these two
    // were the exception, and the warning reaches stdout and the shipped manifest.
    const maskBranch = (value: string): string =>
      findSecretInPath(value, config.secretRules)?.masked ?? value;
    const generatedOn = maskBranch(manifest.git.branch);
    const configuredAs = maskBranch(config.branch);
    warnings.push(
      `Snapshot was generated on branch "${generatedOn}" but the configured branch is "${configuredAs}".`
    );
  }

  const errors: string[] = [];
  if (drift.missingInSnapshot.length > 0) {
    errors.push(`${drift.missingInSnapshot.length} file(s) on disk are missing from the snapshot.`);
  }
  if (drift.missingOnDisk.length > 0) {
    errors.push(`${drift.missingOnDisk.length} file(s) in snapshot no longer exist on disk.`);
  }
  if (drift.unreadable.length > 0) {
    errors.push(
      `${drift.unreadable.length} file(s) exist on disk but could not be read, so their content ` +
        `could not be verified.`
    );
  }
  if (drift.hashMismatches.length > 0) {
    errors.push(
      `${drift.hashMismatches.length} file(s) have been modified since the snapshot was generated.`
    );
  }
  if (drift.partIssues.length > 0) {
    errors.push(`${drift.partIssues.length} snapshot artefact problem(s) detected.`);
  }
  if (drift.totalsMismatches.length > 0) {
    errors.push(
      `${drift.totalsMismatches.length} manifest bookkeeping value(s) disagree with the snapshot contents.`
    );
  }
  if (drift.configMismatches.length > 0) {
    errors.push(
      `${drift.configMismatches.length} configuration mismatch(es) between the manifest and this run.`
    );
  }

  if (manifest.slice !== undefined || manifest.budget !== undefined) {
    warnings.push(
      "This snapshot is a selection (" +
        (manifest.slice !== undefined ? "--slice" : "--budget-tokens") +
        "); validate checks what is present and does not re-run the planner, so a file the " +
        "selection left out is not reported as missing.",
    );
  }

  // ---- masked view --------------------------------------------------------
  // The result is printed by `validate` and serialized by `--format json`; no
  // raw path may leave this function, because a path can carry a credential.
  const maskedDrift: ValidationDrift = {
    ...drift,
    missingInSnapshot: drift.missingInSnapshot.map((value) => maskedPath(value, config.secretRules)),
    missingOnDisk: drift.missingOnDisk.map((value) => maskedPath(value, config.secretRules)),
    unreadable: drift.unreadable.map((value) => maskedPath(value, config.secretRules)),
    hashMismatches: drift.hashMismatches.map((mismatch) => ({
      ...mismatch,
      path: maskedPath(mismatch.path, config.secretRules),
    })),
    // A part name comes from the manifest, which is an input: it can carry a credential shape as
    // easily as a real path can, and these records are printed.
    partIssues: drift.partIssues.map((issue) => ({
      ...issue,
      part: maskedPath(issue.part, config.secretRules),
    })),
  };

  return {
    valid: errors.length === 0,
    manifestPresent: true,
    drift: maskedDrift,
    errors,
    warnings,
  };
}
