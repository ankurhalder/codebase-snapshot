<file path="tests/budget.test.js">
/**
 * The budget planner: "fit this repository into N tokens" without tearing files in half.
 *
 * The test pins the three properties the docs claim: the total fits, the selection prefers what
 * matters, and every dropped path is recorded.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

const BIN = path.join(path.dirname(new URL(import.meta.url).pathname.replace(/^\//, "")), "..", "dist", "bin.js");

function makeRepo(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "budget-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  fs.mkdirSync(path.join(root, "src"), { recursive: true });
  fs.mkdirSync(path.join(root, "docs"), { recursive: true });
  fs.writeFileSync(path.join(root, "src", "main.ts"), "import { core } from './core.js';\nexport const main = core;\n");
  fs.writeFileSync(path.join(root, "src", "core.ts"), "export const core = 1;\n");
  fs.writeFileSync(path.join(root, "src", "noise.ts"), "export const noise = Array.from({ length: 40 }, (_, i) => i);\n");
  fs.writeFileSync(path.join(root, "docs", "big.md"), "# Big\n" + "word ".repeat(4000) + "\n");
  return root;
}

const run = (args, cwd) => {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, out: (result.stdout ?? "") + (result.stderr ?? "") };
};

test("a budget selects whole files and records what did not fit", (t) => {
  const root = makeRepo(t);
  const result = run(["generate", "--budget-tokens", "600"], root);
  assert.equal(result.code, 0, result.out);

  const manifest = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  assert.ok(manifest.budget, "the manifest records the budget");
  assert.equal(manifest.budget.maxTokens, 600);
  assert.ok(manifest.budget.usedTokens <= 600, "used " + manifest.budget.usedTokens);

  const kept = manifest.files.map((file) => file.relativePath);
  assert.ok(kept.includes("src/main.ts"), "the entry point is kept: " + kept.join(","));
  for (const file of manifest.files) {
    assert.equal(file.inclusionMode, "full", file.relativePath + " is not torn");
  }

  const dropped = manifest.skipped.filter((record) => record.reason === "not-selected").map((record) => record.path);
  assert.ok(dropped.length > 0, "the rest is recorded");
  assert.equal(manifest.budget.files.length + dropped.length, manifest.files.length + dropped.length);
});

test("a tiny budget does not crash and says so", (t) => {
  const root = makeRepo(t);
  const result = run(["generate", "--budget-tokens", "500"], root);
  assert.equal(result.code, 0, result.out);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  assert.ok(manifest.budget.usedTokens <= 500);
});

test("the budget report says what survived", (t) => {
  const root = makeRepo(t);
  assert.equal(run(["generate", "--budget-tokens", "800"], root).code, 0);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  const coverage = manifest.budget.coverage;
  assert.ok(coverage, "coverage is recorded");
  assert.ok(coverage.symbols.total > 0, "symbols are counted");
  assert.ok(coverage.symbols.kept <= coverage.symbols.total);
  const layers = Object.keys(coverage.byLayer);
  assert.ok(layers.length > 0);
  for (const layer of layers) {
    assert.ok(coverage.byLayer[layer].kept <= coverage.byLayer[layer].total);
  }
  assert.ok(coverage.entryPoints.total > 0, "the fixture has entry points");
});

test("a delta can be fitted to a budget", (t) => {
  const root = makeRepo(t);
  assert.equal(run(["generate"], root).code, 0);
  fs.appendFileSync(path.join(root, "src", "a.ts"), "export const changed = true;\n");
  const result = run(["generate", "--out-dir", "delta", "--delta", path.join(root, "snapshot"), "--budget-tokens", "2000"], root);
  assert.equal(result.code, 0, result.out);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "delta", "manifest.json"), "utf8"));
  assert.ok(manifest.delta, "the delta is recorded");
  assert.ok(manifest.budget, "the budget is recorded");
  assert.ok(manifest.budget.usedTokens <= 2000);
});
</file>

<file path="tests/diff-payload.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

import { compareManifests } from "../dist/index.js";

/**
 * `diff` compares `relativePath + hashSha256`, so it used to report "0 changed,
 * N unchanged" for a run that repacked the same sources differently
 * (`--large-file-bytes`, preview head/tail, redaction rules, artifact selection,
 * budgets). The manifests record the effective-settings digest, the content
 * fingerprint and the part count, so the payload difference is now stated
 * explicitly. These tests pin the statement, the silence when nothing differs,
 * and the untouched per-file behaviour.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function run(args) {
  return spawnSync(process.execPath, [BIN, ...args], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
}

function combined(result) {
  return `${result.stdout}${result.stderr}`;
}

function diffJson(before, after) {
  const result = run(["diff", before, after, "--format", "json"]);
  assert.equal(result.status, 0, `diff failed: ${result.stderr}`);
  return JSON.parse(result.stdout);
}

function diffText(before, after) {
  const result = run(["diff", before, after]);
  assert.equal(result.status, 0, `diff failed: ${result.stderr}`);
  return combined(result);
}

const BIG_FILE = ("export const big = '" + "x".repeat(20) + "';\n").repeat(15_000); // ~660 KB

/** One repository plus an out-of-tree directory for its snapshots. */
function fixture() {
  const repo = fs.mkdtempSync(path.join(os.tmpdir(), "diff-payload-"));
  fs.mkdirSync(path.join(repo, "src"), { recursive: true });
  fs.writeFileSync(
    path.join(repo, "package.json"),
    JSON.stringify({ name: "diff-payload-fixture", version: "1.0.0" })
  );
  fs.writeFileSync(path.join(repo, "src", "a.ts"), "export const a = 1;\n");
  fs.writeFileSync(path.join(repo, "src", "big.ts"), BIG_FILE);
  // A second large file so the whole-body run needs two parts while the preview run needs one:
  // the comparison is about the payload, and the part count is part of it.
  fs.writeFileSync(path.join(repo, "src", "second.ts"), BIG_FILE.slice(0, 400_000));
  const outRoot = fs.mkdtempSync(path.join(os.tmpdir(), "diff-payload-out-"));
  return { repo, outRoot };
}

function generate(repo, outDir, extra = []) {
  const result = run(["generate", "--cwd", repo, "--out-dir", outDir, ...extra]);
  assert.equal(result.status, 0, `generate failed: ${result.stderr}`);
  assert.ok(fs.existsSync(path.join(outDir, "manifest.json")), "generate wrote no manifest");
}

function cleanup({ repo, outRoot }) {
  fs.rmSync(repo, { recursive: true, force: true });
  fs.rmSync(outRoot, { recursive: true, force: true });
}

test("the same sources repacked as a full body instead of a preview are reported", () => {
  const fx = fixture();
  const full = path.join(fx.outRoot, "full");
  const preview = path.join(fx.outRoot, "preview");
  try {
    // A whole 660 KB body needs a budget that can hold it, and the threshold may not exceed it.
    generate(fx.repo, full, ["--max-part-bytes", "700k", "--large-file-bytes", "700k"]);
    generate(fx.repo, preview);

    const diff = diffJson(full, preview);
    // The per-file answer is still "nothing changed"...
    assert.equal(diff.added.length, 0);
    assert.equal(diff.removed.length, 0);
    assert.equal(diff.changed.length, 0);
    assert.equal(diff.unchanged, 4);
    // ...but the payload block says the snapshot itself differs.
    assert.equal(diff.payload.sourceFilesIdentical, true);
    assert.equal(diff.payload.differs, true);
    assert.equal(diff.payload.configurationDiffers, true);
    assert.notEqual(diff.payload.configDigest.before, diff.payload.configDigest.after);
    assert.notEqual(diff.payload.partsCount.before, diff.payload.partsCount.after);
    assert.ok(
      diff.payload.reasons.some((reason) => /configuration digest/.test(reason)),
      `expected a configuration-digest reason, got ${JSON.stringify(diff.payload.reasons)}`
    );

    const text = diffText(full, preview);
    assert.match(text, /payload\/configuration differs:/);
    assert.match(text, /configuration digest/);
    assert.match(text, /source files are identical \(4 unchanged\)/);
    assert.match(text, /0 changed/, "the per-file counts must stay in the output");
  } finally {
    cleanup(fx);
  }
});

test("a budget change with identical sources is reported", () => {
  const fx = fixture();
  const wide = path.join(fx.outRoot, "wide");
  const narrow = path.join(fx.outRoot, "narrow");
  try {
    // Same sources and the same preview threshold; only the part budget differs.
    generate(fx.repo, wide, ["--max-part-bytes", "700k", "--large-file-bytes", "700k"]);
    generate(fx.repo, narrow, ["--large-file-bytes", "60k", "--max-part-bytes", "60k"]);

    const diff = diffJson(wide, narrow);
    assert.equal(diff.changed.length, 0);
    assert.equal(diff.unchanged, 4);
    assert.equal(diff.payload.sourceFilesIdentical, true);
    assert.equal(diff.payload.differs, true);
    assert.equal(diff.payload.configurationDiffers, true);
    assert.notEqual(diff.payload.configDigest.before, diff.payload.configDigest.after);
    assert.ok(
      diff.payload.reasons.some((reason) => /configuration digest/.test(reason)),
      `expected a configuration-digest reason, got ${JSON.stringify(diff.payload.reasons)}`
    );

    const text = diffText(wide, narrow);
    assert.match(text, /payload\/configuration differs:/);
    assert.match(text, /source files are identical \(4 unchanged\)/);
    assert.match(text, /0 changed/, "the per-file counts must stay in the output");
  } finally {
    cleanup(fx);
  }
});

test("identical snapshots stay silent about the payload", () => {
  const fx = fixture();
  const first = path.join(fx.outRoot, "first");
  const second = path.join(fx.outRoot, "second");
  try {
    generate(fx.repo, first);
    generate(fx.repo, second);

    const diff = diffJson(first, second);
    assert.equal(diff.added.length + diff.removed.length + diff.changed.length, 0);
    assert.equal(diff.unchanged, 4);
    assert.equal(diff.payload.sourceFilesIdentical, true);
    assert.equal(diff.payload.differs, false);
    assert.equal(diff.payload.configurationDiffers, false);
    assert.equal(diff.payload.configDigest.before, diff.payload.configDigest.after);
    assert.deepEqual(diff.payload.reasons, []);

    const text = diffText(first, second);
    assert.doesNotMatch(text, /payload\/configuration differs/);
    assert.doesNotMatch(text, /configuration not compared/);
    assert.match(text, /0 changed/);
    assert.match(text, /4 unchanged/);
  } finally {
    cleanup(fx);
  }
});

test("a source edit is still reported as a changed file, with no payload section", () => {
  const fx = fixture();
  const before = path.join(fx.outRoot, "before");
  const after = path.join(fx.outRoot, "after");
  try {
    generate(fx.repo, before);
    fs.writeFileSync(path.join(fx.repo, "src", "a.ts"), "export const a = 2;\n");
    generate(fx.repo, after);

    const diff = diffJson(before, after);
    assert.deepEqual(diff.changed, ["src/a.ts"]);
    assert.equal(diff.payload.sourceFilesIdentical, false);
    assert.equal(diff.payload.differs, false, "a source edit alone must not turn on the payload block");

    const text = diffText(before, after);
    assert.match(text, /1 changed/);
    assert.match(text, /changed:/);
    assert.match(text, /src\/a\.ts/);
    assert.doesNotMatch(text, /payload\/configuration differs/);
  } finally {
    cleanup(fx);
  }
});

test("manifests without a config digest say the configuration was not compared", () => {
  const fx = fixture();
  const current = path.join(fx.outRoot, "current");
  const full = path.join(fx.outRoot, "full");
  try {
    generate(fx.repo, current);
    generate(fx.repo, full, ["--max-part-bytes", "700k", "--large-file-bytes", "700k"]);

    // Simulate a snapshot written before 4.0.5: same settings, no config.digest. A missing digest
    // is unverifiable, not malformed, so the shape guard accepts it and diff says so.
    const oldSame = path.join(fx.outRoot, "old-same.json");
    const same = JSON.parse(fs.readFileSync(path.join(current, "manifest.json"), "utf8"));
    delete same.config.digest;
    fs.writeFileSync(oldSame, JSON.stringify(same, null, 2));

    const quiet = diffJson(oldSame, current);
    assert.equal(quiet.payload.configDigest.before, null);
    assert.equal(quiet.payload.differs, false);
    assert.match(
      diffText(oldSame, current),
      /configuration not compared: a manifest has no config digest/
    );

    // An old manifest that also differs in payload: the reason names the side.
    const oldFull = path.join(fx.outRoot, "old-full.json");
    const fullManifest = JSON.parse(fs.readFileSync(path.join(full, "manifest.json"), "utf8"));
    delete fullManifest.config.digest;
    fs.writeFileSync(oldFull, JSON.stringify(fullManifest, null, 2));

    const loud = diffJson(oldFull, current);
    assert.equal(loud.payload.differs, true);
    assert.ok(
      loud.payload.reasons.some((reason) => /not recorded on the before side/.test(reason)),
      `expected the missing-digest caveat, got ${JSON.stringify(loud.payload.reasons)}`
    );
    assert.match(diffText(oldFull, current), /payload\/configuration differs:/);
  } finally {
    cleanup(fx);
  }
});

test("every payload reason carries a stable code alongside its prose", () => {
  const { repo, outRoot } = fixture();
  try {
    const first = path.join(outRoot, "one");
    const second = path.join(outRoot, "two");
    generate(repo, first);
    generate(repo, second, ["--max-part-bytes", "120k"]);

    const payload = diffJson(path.join(first, "manifest.json"), path.join(second, "manifest.json"))
      .payload;
    assert.ok(payload.reasons.length > 0, "this comparison really produces reasons");
    assert.equal(
      payload.codes.length,
      payload.reasons.length,
      "one code per statement, in the same order"
    );
    // A program reading `--format json` had to match on English prose to decide what changed.
    for (const code of payload.codes) {
      assert.match(code, /^[a-z][a-z-]*$/, `a code is a stable token, not a sentence: ${code}`);
    }
    assert.ok(
      payload.codes.includes("config-digest"),
      `a budget change is a configuration change: ${JSON.stringify(payload.codes)}`
    );
  } finally {
    cleanup({ repo, outRoot });
  }
});

test("compareManifests applies the caller's secret rules to paths and layers", () => {
  // `ACME-[A-Z0-9]{8}` is this project's own token shape, declared in `secretRules` — the
  // setting exists for exactly this. Without the rules parameter every masking call in `diff.ts`
  // used the built-ins, so the token was printed in clear by `diff` while `generate`,
  // `validate`, `explain` and the MCP server all masked it.
  const custom = { rule: "acme-key", pattern: /ACME-[A-Z0-9]{8}/ };
  const entry = (relativePath, hash) => ({
    relativePath,
    sizeBytes: 1,
    lines: 1,
    hashSha256: hash,
    part: "part-001.md",
    layer: "src",
    kind: "source",
    language: "typescript",
    inclusionMode: "full",
    isLarge: false,
    isPreviewTruncated: false,
    originalLines: 1,
    includedLines: 1,
    includedBytes: 1,
  });
  const manifest = (files, layer) => ({
    schemaVersion: "3.0.0",
    generatedAt: "2026-01-01T00:00:00.000Z",
    generator: { name: "codebase-snapshot", version: "0.10.1" },
    git: { branch: "main", commit: "0", isDirty: false },
    budgets: { maxPartBytes: 4096, largeFileBytes: 4096 },
    config: { maxPartBytes: 4096, largeFileBytes: 4096, previewHeadLines: 1, previewTailLines: 1, includeMonolith: false, includeSensitiveFiles: false, artifacts: {}, include: [], preset: "typescript", layersMode: "merge", budgets: { default: 4096, byLayer: {} }, excludePatterns: [], layers: [], kinds: [] },
    counts: { totalFiles: files.length, totalSizeBytes: 1, totalLines: 1, partsCount: 1, skippedCount: 0, largeFileCount: 0, truncatedPreviewCount: 0, incompleteCount: 0 },
    totals: { candidateFiles: files.length, includedFiles: files.length, fullFiles: files.length, previewFiles: 0, skippedFiles: 0, totalSourceBytes: 1, totalContentBytes: 1, redactedLines: 0, partCount: 1, warningCount: 0 },
    fingerprint: "a".repeat(64),
    validation: { status: "passed", errors: [] },
    artifacts: {},
    layers: { [layer]: files.length },
    kinds: { source: files.length },
    indexes: { routes: [], components: [], handlers: [], features: [], imports: { byFile: [], centralFiles: [] }, directives: [] },
    parts: [],
    files,
    skipped: [],
    incomplete: [],
    warnings: [],
  });

  const before = manifest([entry("src/a.ts", "b".repeat(64))], "src");
  const after = manifest([entry("src/ACME-7F3K9QZ2.ts", "c".repeat(64))], "ACME-7F3K9QZ2");

  const without = compareManifests(before, after);
  assert.match(without.added[0], /ACME-7F3K9QZ2/, "without rules the token is printed (the old bug)");

  const withRules = compareManifests(before, after, [custom]);
  assert.doesNotMatch(JSON.stringify(withRules), /ACME-7F3K9QZ2/, "the caller's rule masks every surface");
  assert.match(JSON.stringify(withRules), /REDACTED/);
});
