<file path="tests/reserved-directory-names.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { collectFiles, generateSnapshot } from "../dist/index.js";

/**
 * 4.0.9 regression cover for reserved directory names.
 *
 * Any directory called `snapshot`, `snapshot.tmp` or `snapshot.backup-*` used to be dropped from
 * the scan at any depth, with no `skipped[]` record — so a directory the user committed under that
 * name disappeared from the snapshot and nothing said so, contradicting the promise that every
 * discovered path is accounted for. The exclusion is for *this tool's own output*, which is
 * recognisable by its ownership marker, and for the exact `outDir`/`tmpDir` this run writes.
 */

function tempDir(t, prefix = "snap-reserved-") {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

/** Runs `git init` + `git add -A`; returns false when git is unavailable on this host. */
function initGit(dir) {
  try {
    execFileSync("git", ["init", "-q"], { cwd: dir, stdio: "ignore" });
    execFileSync("git", ["add", "-A"], { cwd: dir, stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
}

test("G4: a user directory named `snapshot` is scanned when outDir is elsewhere (no git)", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "snapshot/keep.md", "# kept\n");
  write(dir, "nested/snapshot.tmp/notes.md", "nested notes\n");

  const result = collectFiles(dir, { toolOwnedPaths: ["out"] });

  assert.ok(result.files.includes("snapshot/keep.md"), "the user's directory is not dropped");
  assert.ok(result.files.includes("nested/snapshot.tmp/notes.md"), "nor is a nested one");
});

test("G4: the same directory survives a full generate and appears in the manifest", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "snapshot/keep.md", "# kept\n");

  const manifest = generateSnapshot({ cwd: dir, outDir: "out" });

  assert.ok(
    manifest.files.some((file) => file.relativePath === "snapshot/keep.md"),
    "the file is in files[], not silently absent"
  );
});

test("G4: reserved names resolve identically with and without git", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "snapshot/keep.md", "# kept\n");

  const walking = collectFiles(dir, { toolOwnedPaths: ["out"] });
  if (!initGit(dir)) return; // git is not installed here; the walker case already ran above
  const viaGit = collectFiles(dir, { toolOwnedPaths: ["out"] });

  assert.deepEqual(
    viaGit.files.slice().sort(),
    walking.files.slice().sort(),
    "both discovery modes must offer the same candidates"
  );
});

test("the tool's own output directory is still excluded, and stays out of skipped[]", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");

  // Two runs: the second must not record the first run's output as a discovered path, or two
  // identical runs would produce different manifests.
  const first = generateSnapshot({ cwd: dir });
  const second = generateSnapshot({ cwd: dir });

  const firstPaths = first.files.map((file) => file.relativePath).sort();
  const secondPaths = second.files.map((file) => file.relativePath).sort();
  assert.deepEqual(secondPaths, firstPaths, "the snapshot does not record itself");
  assert.deepEqual(
    second.skipped.filter((record) => record.path.startsWith("snapshot")),
    [],
    "own output is not reported as a skipped user path"
  );
});

test("a first run refuses rather than eating a pre-existing snapshot/ directory", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  const keep = write(dir, "snapshot/keep.md", "# precious\n");

  // Default outDir is `snapshot`, and the user already has one. The tool cannot prove it wrote
  // this directory, so it must refuse — and leave the file alone.
  assert.throws(() => generateSnapshot({ cwd: dir }), /Refusing to replace outDir/);
  assert.equal(fs.readFileSync(keep, "utf8"), "# precious\n");
});
</file>

<file path="tests/sarif.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  DEFAULT_SECRET_PATTERNS,
  generateSarifReport,
  generateSnapshot,
  resolveConfig,
} from "../dist/index.js";

/**
 * SARIF export, from the 0.9.9 audit.
 *
 * `reports/audit.md` tells a human what was masked, and nothing could *gate* on it: a CI job
 * that wanted to fail a build over a leaked key had to scrape markdown. SARIF is what GitHub
 * Code Scanning reads, so the same findings go straight into an alert.
 *
 * The property that matters most is a negative one: this artefact is uploaded to a third
 * party, so it must never contain the value it is reporting on. A path and a line number are
 * enough to act on; a second copy of the secret in someone else's retention policy is not.
 */

const manifestStub = { fingerprint: "a".repeat(64) };

test("the document is SARIF 2.1.0 with one result per finding", () => {
  const findings = [
    { path: "src/a.ts", line: 3, rules: ["credential-assignment"] },
    { path: "src/b.ts", line: 1, rules: ["aws-access-key-id"] },
  ];
  const log = JSON.parse(
    generateSarifReport(manifestStub, findings, DEFAULT_SECRET_PATTERNS, "9.9.9")
  );

  assert.equal(log.version, "2.1.0");
  assert.equal(log.$schema, "https://json.schemastore.org/sarif-2.1.0.json");
  assert.equal(log.runs.length, 1);

  const run = log.runs[0];
  assert.equal(run.tool.driver.name, "codebase-snapshot");
  assert.equal(run.tool.driver.version, "9.9.9");
  assert.equal(run.results.length, 2);
  assert.equal(run.automationDetails.id, `codebase-snapshot/${manifestStub.fingerprint}`);

  const first = run.results[0];
  assert.equal(first.locations[0].physicalLocation.artifactLocation.uri, "src/a.ts");
  assert.equal(first.locations[0].physicalLocation.region.startLine, 3);
  assert.equal(first.level, "note", "a redaction is the tool doing its job, not a failure");
  // The rule id in the result must resolve in the rule catalogue.
  assert.equal(run.tool.driver.rules[first.ruleIndex].id, first.ruleId);
  assert.equal(run.tool.driver.rules[first.ruleIndex].name, "credential-assignment");
});

test("the reported value never appears in the artefact", () => {
  const secret = "hunter2hunter2";
  const log = generateSarifReport(
    manifestStub,
    [{ path: "src/a.ts", line: 1, rules: ["credential-assignment"] }],
    DEFAULT_SECRET_PATTERNS,
    "9.9.9"
  );

  assert.equal(log.includes(secret), false, "an upload must not carry the secret");
  assert.equal(log.includes("REDACTED"), false, "nor an excerpt of the masked line");
});

test("rule identifiers are stable for the same configuration", () => {
  const findings = [{ path: "a.ts", line: 1, rules: ["jwt-token"] }];
  const first = JSON.parse(generateSarifReport(manifestStub, findings, DEFAULT_SECRET_PATTERNS, "1"));
  const second = JSON.parse(generateSarifReport(manifestStub, findings, DEFAULT_SECRET_PATTERNS, "1"));

  assert.deepEqual(
    first.runs[0].tool.driver.rules.map((rule) => [rule.id, rule.name]),
    second.runs[0].tool.driver.rules.map((rule) => [rule.id, rule.name]),
    "an id that moved between runs would orphan every open alert"
  );
});

test("--sarif writes the artefact and records it in the manifest", (t) => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "sarif-"));
  const write = (relative, content) => {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write("src/a.ts", 'const apiKey = "abcdefgh12345678";\nexport const a = 1;\n');
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  const manifest = generateSnapshot(
    resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", sarif: true })
  );

  const sarifPath = path.join(dir, "snapshot", "reports", "audit.sarif");
  assert.ok(fs.existsSync(sarifPath), "the file is written beside audit.md");
  const log = JSON.parse(fs.readFileSync(sarifPath, "utf8"));
  assert.ok(log.runs[0].results.length >= 1, "the fixture's key is a finding");

  assert.ok(manifest.artifacts.sarif, "and the manifest names it");
  assert.equal(manifest.artifacts.sarif.byteSize, fs.statSync(sarifPath).size);
  assert.match(String(manifest.artifacts.sarif.sha256), /^[0-9a-f]{64}$/);
});

test("without the flag there is no artefact", (t) => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "sarif-off-"));
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "a.ts"), 'const apiKey = "abcdefgh12345678";\n');
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  const manifest = generateSnapshot(
    resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" })
  );

  assert.equal(fs.existsSync(path.join(dir, "snapshot", "reports", "audit.sarif")), false);
  assert.equal(manifest.artifacts.sarif, undefined);
});

test("it works when the markdown audit report is switched off", (t) => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "sarif-noaudit-"));
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "a.ts"), 'const apiKey = "abcdefgh12345678";\n');
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  generateSnapshot(
    resolveConfig({
      cwd: dir,
      outDir: "snapshot",
      tmpDir: "snapshot.tmp",
      sarif: true,
      artifacts: { audit: false },
    })
  );

  // The gate is for CI, where nobody reads the markdown; asking for SARIF alone must work.
  assert.equal(fs.existsSync(path.join(dir, "snapshot", "reports", "audit.md")), false);
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "reports", "audit.sarif")));
});
</file>

<file path="tests/scale-ceiling.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { collectFiles } from "../dist/index.js";

/**
 * 4.0.9 regression cover for the ~125 000-file ceiling.
 *
 * The directory walker merged each child listing with `results.files.push(...nested.files)`, which
 * passes every element as a function argument. V8 gives up somewhere around 125 000 arguments with
 * "Maximum call stack size exceeded", so a repository whose single directory held that many files
 * could not be scanned at all: `generate` and `explain` crashed in about a second, and `validate`
 * and `report` then answered "run generate first" because no manifest had ever been written.
 *
 * This test is opt-in because it has to create the files it is about. Run it with:
 *
 *   SNAPSHOT_SCALE_TEST=1 node --test tests/scale-ceiling.test.js
 *
 * It takes roughly a minute on an SSD and is the only test in the suite that is expected to be
 * skipped by default.
 */

const CREATE_COUNT = 130_000;
const enabled = process.env.SNAPSHOT_SCALE_TEST === "1";

test(
  "a directory holding more files than V8's argument limit is scanned, not crashed",
  { skip: enabled ? false : "set SNAPSHOT_SCALE_TEST=1 to run the 130 000-file scale test" },
  () => {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-scale-"));
    try {
      const nested = path.join(dir, "big");
      fs.mkdirSync(nested, { recursive: true });
      for (let index = 0; index < CREATE_COUNT; index += 1) {
        fs.writeFileSync(path.join(nested, `f${index}.txt`), "");
      }

      const collected = collectFiles(dir, {});

      assert.equal(
        collected.files.length,
        CREATE_COUNT,
        "every file is offered as a candidate, not lost to a stack overflow"
      );
    } finally {
      fs.rmSync(dir, { recursive: true, force: true });
    }
  }
);
</file>

<file path="tests/scanner-init-fixes.test.js">
/**
 * Scanner/init fixes from the real-repository audit (track 5).
 *
 * Item 13 — `.gitignore` escapes were ignored in `walk` mode. The parser took the
 * first character of the line as meaningful, so `\#hashfile.ts` and `\!bangfile.ts`
 * were treated as a comment and a negation, and the matcher normalised every
 * backslash to a path separator, so `spaced\ .ts` became `spaced/ .ts`. Git
 * ignored all three; a `walk` scan included all three.
 *
 * Item 14 — `init` wrote `branch: "main"` unconditionally. It now records the
 * repository's actual branch, with "main" kept only as the fallback the
 * generator already uses when git cannot report one.
 */
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, resolveConfig, runInit } from "../dist/index.js";

function makeRepo(t, files) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "scanner-init-"));
  const write = (rel, content) => {
    const full = path.join(dir, rel);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content);
  };
  write("package.json", '{"name":"scanner-init","private":true}\n');
  for (const [rel, content] of Object.entries(files)) write(rel, content);
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

/** No `.git` in the fixture, so `discovery: "auto"` resolves to the plain walk. */
function walkSnapshot(dir) {
  const config = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    discovery: "walk",
  });
  const manifest = generateSnapshot(config);
  const partText = fs
    .readdirSync(path.join(dir, "snapshot", "parts"))
    .map((name) => fs.readFileSync(path.join(dir, "snapshot", "parts", name), "utf8"))
    .join("\n");
  return { manifest, partText };
}

const included = (manifest) => manifest.files.map((file) => file.relativePath);
const skippedReason = (manifest, target) =>
  manifest.skipped.find((entry) => entry.path === target)?.reason;

// ---------------------------------------------------------------- item 13

test("SI-01: an escaped leading # is a literal, not a comment", (t) => {
  const dir = makeRepo(t, {
    ".gitignore": "\\#hashfile.ts\n",
    "#hashfile.ts": "export const hash = 1;\n",
  });
  const { manifest, partText } = walkSnapshot(dir);

  assert.equal(skippedReason(manifest, "#hashfile.ts"), "gitignore");
  assert.ok(!included(manifest).includes("#hashfile.ts"), "must not be tracked");
  assert.ok(
    !partText.includes("export const hash = 1;"),
    "an ignored file's content must not reach the parts"
  );
});

test("SI-02: an escaped leading ! is a literal, not a negation", (t) => {
  const dir = makeRepo(t, {
    ".gitignore": "\\!bangfile.ts\n",
    "!bangfile.ts": "export const bang = 1;\n",
  });
  const { manifest, partText } = walkSnapshot(dir);

  assert.equal(skippedReason(manifest, "!bangfile.ts"), "gitignore");
  assert.ok(!partText.includes("export const bang = 1;"));
});

test("SI-03: an escaped space is significant and is not a separator", (t) => {
  const dir = makeRepo(t, {
    ".gitignore": "spaced\\ .ts\n",
    "spaced .ts": "export const spaced = 1;\n",
  });
  const { manifest, partText } = walkSnapshot(dir);

  assert.equal(
    skippedReason(manifest, "spaced .ts"),
    "gitignore",
    "the backslash escapes the space, it does not become a path separator"
  );
  assert.ok(!partText.includes("export const spaced = 1;"));
});

test("SI-04: plain ! negation still re-includes a file", (t) => {
  const dir = makeRepo(t, {
    ".gitignore": "*.log\n!keep.log\n",
    "keep.log": "kept\n",
    "drop.log": "dropped\n",
  });
  const { manifest } = walkSnapshot(dir);

  assert.ok(included(manifest).includes("keep.log"), "!keep.log must re-include the file");
  assert.equal(skippedReason(manifest, "drop.log"), "gitignore");
});

test("SI-05: an unescaped trailing space is insignificant", (t) => {
  const dir = makeRepo(t, {
    ".gitignore": "plain.ts   \n",
    "plain.ts": "export const plain = 1;\n",
  });
  const { manifest } = walkSnapshot(dir);

  assert.ok(
    !included(manifest).includes("plain.ts"),
    "git strips trailing spaces, so the rule still matches"
  );
});

test("SI-06: a trailing escaped space must match the literal space", (t) => {
  const dir = makeRepo(t, {
    ".gitignore": "trailing\\ \n",
    "trailing ": "x\n",
  });
  const { manifest } = walkSnapshot(dir);

  assert.equal(
    skippedReason(manifest, "trailing "),
    "gitignore",
    "an escaped trailing space is part of the pattern"
  );
});

// ---------------------------------------------------------------- item 14
// `init` used to emit a hardcoded `branch: "main"`, so every later `validate`
// warned about a branch mismatch the user never caused. It must write the
// repository's actual branch and keep "main" only as the fallback.

function initRepo(t, { gitBranch } = {}) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "init-branch-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"init-branch","private":true}\n');
  fs.writeFileSync(path.join(dir, "index.js"), "module.exports = 1;\n");
  if (gitBranch) {
    const git = (...args) => execFileSync("git", args, { cwd: dir, stdio: "ignore" });
    git("init", "-q", "-b", gitBranch);
    git("add", "-A");
    execFileSync(
      "git",
      ["-c", "user.email=a@b", "-c", "user.name=a", "commit", "-qm", "init"],
      { cwd: dir, stdio: "ignore" }
    );
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

async function initAndReadConfig(dir) {
  const result = await runInit({ cwd: dir, yes: true });
  return result.configText ?? fs.readFileSync(result.configPath, "utf8");
}

test("SI-07: init on a repository checked out on master writes branch: \"master\"", async (t) => {
  const dir = initRepo(t, { gitBranch: "master" });
  const configText = await initAndReadConfig(dir);

  assert.match(
    configText,
    /^\s*branch: "master",$/m,
    "the generated config must record the repository's actual branch"
  );
  assert.doesNotMatch(
    configText,
    /^\s*branch: "main",$/m,
    "the hardcoded default must not survive on a master checkout"
  );
});

test("SI-08: init in a non-git directory falls back to branch: \"main\"", async (t) => {
  const dir = initRepo(t);
  const configText = await initAndReadConfig(dir);

  assert.match(
    configText,
    /^\s*branch: "main",$/m,
    "without git there is no branch to report, so the documented fallback applies"
  );
});
</file>

<file path="tests/scope-flags-and-dependents.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { buildAgentContract } from "../dist/cli.js";

/**
 * Flags that generate accepts and the commands that have to read them back, from the 0.9.12 audit.
 *
 * The defect was circular: `generate --skeleton` recorded a configuration digest that includes
 * `skeleton`, `validate` resolved `skeleton: false` and failed with "the settings differ from the
 * ones this snapshot was generated with", and `validate --skeleton` — the obvious repair — was
 * rejected as a flag that "does not apply to validate". Neither message named the other, and there
 * was no way to validate a skeleton snapshot at all.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

const run = (cwd, ...args) => {
  const result = spawnSync(process.execPath, [BIN, ...args, "--cwd", cwd, "--no-update-check"], {
    encoding: "utf8",
  });
  if (result.error) throw result.error;
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
};

const git = (cwd, ...args) =>
  spawnSync("git", args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });

function makeRepo(t, files = {}, { git: useGit = false } = {}) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "scope-flags-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  if (useGit) {
    git(dir, "init", "-q");
    git(dir, "config", "user.email", "test@example.com");
    git(dir, "config", "user.name", "test");
    git(dir, "add", "-A");
    git(dir, "commit", "-qm", "fixture");
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const GENERATION_FLAGS = [
  ["--skeleton", undefined],
  ["--sarif", undefined],
  ["--max-part-tokens", "32k"],
  ["--changed-since", "HEAD"],
  ["--staged", undefined],
];

test("every generation setting validate must compare is in validate's published scope", () => {
  const contract = buildAgentContract();
  const scopeFor = (option) => {
    const found = contract.options.find((entry) => entry.flag === option);
    assert.ok(found, `${option} is in the contract`);
    return found.appliesTo.split("/");
  };

  for (const [flag] of GENERATION_FLAGS) {
    assert.ok(
      scopeFor(flag).includes("validate"),
      `${flag} must be accepted by validate, or a snapshot generated with it cannot be validated`
    );
  }
  // `--with-dependents` alone is a no-op without a scope, so it is exercised with --changed-since.
  assert.ok(scopeFor("--with-dependents").includes("validate"));
  assert.ok(scopeFor("--with-dependents").includes("explain"));
});

test("validate accepts the flag its own digest comparison needs", (t) => {
  const dir = makeRepo(t, {
    "src/a.ts": "export function add(a: number, b: number): number { return a + b; }\n",
  });

  const generated = run(dir, "generate", "--skeleton");
  assert.equal(generated.code, 0, generated.stderr);
  const manifest = JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));
  assert.equal(manifest.config.skeleton, true, "the manifest records what the run used");
  assert.match(
    fs.readFileSync(path.join(dir, "snapshot", "parts", "part-001.md"), "utf8"),
    /\{ \/\* \.\.\. \*\/ \}/,
    "and the body really is a signature"
  );

  // Without the flag the digest cannot match — that part is correct and must stay correct.
  const plain = run(dir, "validate");
  assert.equal(plain.code, 1, "a snapshot generated with --skeleton is not current without it");
  assert.match(plain.stdout + plain.stderr, /settings differ|configuration/i);

  // With the flag it is the same configuration, so it is current.
  const same = run(dir, "validate", "--skeleton");
  assert.equal(same.code, 0, same.stdout + same.stderr);
});

test("validate accepts --sarif and --max-part-tokens for the same reason", (t) => {
  const dir = makeRepo(t, { "src/a.ts": "export const a = 1;\n" });
  assert.equal(run(dir, "generate", "--sarif", "--max-part-tokens", "32k").code, 0);
  const result = run(dir, "validate", "--sarif", "--max-part-tokens", "32k");
  assert.equal(result.code, 0, result.stdout + result.stderr);
});

test("explain accepts the scope flags it has to read", (t) => {
  const dir = makeRepo(t, { "src/a.ts": "export const a = 1;\n" }, { git: true });
  // Change it after the commit, so the file is what "changed since HEAD" means.
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 2;\n");
  assert.equal(run(dir, "generate", "--changed-since", "HEAD").code, 0);
  const result = run(dir, "explain", "src/a.ts", "--changed-since", "HEAD");
  assert.equal(result.code, 0, result.stdout + result.stderr);
  // The text rendering goes through `info`, which writes to stderr.
  assert.match(result.stdout + result.stderr, /included\s+yes/, "a modified file is in the scope");
});

test("a flag a command cannot honour is still refused, and names the commands that can", () => {
  // `report` reads the manifest and nothing else, so a generation setting would change nothing.
  // Accepting it there would be the silent fallback this whole table exists to prevent.
  const contract = buildAgentContract();
  const reportScope = contract.options
    .find((entry) => entry.flag === "--skeleton")
    .appliesTo.split("/");
  assert.equal(reportScope.includes("report"), false, "--skeleton does nothing for report");
});

test("setup writes a config that a plain validate agrees with", (t) => {
  // `setup` forwarded `--discovery` and `--large-file-bytes` into the generation but wrote the
  // defaults into the config beside it, so a brand-new project finished its one-command setup and
  // immediately failed `validate` with three configuration mismatches.
  const dir = makeRepo(t, { "src/a.ts": "export const a = 1;\n" });
  const setup = run(dir, "setup", "--yes", "--no-install", "--discovery", "walk", "--large-file-bytes", "100000");
  assert.equal(setup.code, 0, setup.stdout + setup.stderr);

  const result = run(dir, "validate");
  assert.equal(result.code, 0, `setup's own output must validate:\n${result.stdout}${result.stderr}`);

  const configText = fs.readFileSync(
    path.join(dir, fs.readdirSync(dir).find((name) => /^snapshot\.config\./.test(name))),
    "utf8"
  );
  assert.match(configText, /discovery: "walk"/);
  assert.match(configText, /largeFileBytes: 100000/);
});

test("setup persists the compression settings it was asked for", (t) => {
  const dir = makeRepo(t, { "src/a.ts": "export function a(): void { return; }\n" });
  const setup = run(dir, "setup", "--yes", "--no-install", "--skeleton", "--sarif", "--max-part-tokens", "32k");
  assert.equal(setup.code, 0, setup.stdout + setup.stderr);

  const result = run(dir, "validate");
  assert.equal(result.code, 0, `${result.stdout}${result.stderr}`);

  const configText = fs.readFileSync(
    path.join(dir, fs.readdirSync(dir).find((name) => /^snapshot\.config\./.test(name))),
    "utf8"
  );
  assert.match(configText, /skeleton: true/);
  assert.match(configText, /sarif: true/);
  assert.match(configText, /maxPartTokens: 32768/);
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "reports", "audit.sarif")));
});

// --------------------------------------------------------------------------- dependents

const DEPENDENT_FILES = {
  "src/used.ts": "export const used = 1;\n",
  "src/importer.ts": 'import { used } from "./used.js";\nexport const value = used + 1;\n',
  "src/bystander.ts": "export const bystander = 1;\n",
};

test("explain agrees with generate when --with-dependents widened the scope", (t) => {
  // The generator kept one hop of importers and both readers compared the raw path set, so a file
  // that is *in* the snapshot was explained as `included: false, reason: "unchanged"`.
  const dir = makeRepo(t, DEPENDENT_FILES, { git: true });
  fs.writeFileSync(path.join(dir, "src", "used.ts"), "export const used = 2;\n");

  const generated = run(dir, "generate", "--changed-since", "HEAD", "--with-dependents");
  assert.equal(generated.code, 0, generated.stdout + generated.stderr);
  const manifest = JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));
  const included = manifest.files.map((file) => file.relativePath).sort();
  assert.deepEqual(included, ["src/importer.ts", "src/used.ts"], "the importer is in the snapshot");

  const dependent = run(dir, "explain", "src/importer.ts", "--changed-since", "HEAD", "--with-dependents");
  assert.equal(dependent.code, 0, dependent.stdout + dependent.stderr);
  assert.match(
    dependent.stdout + dependent.stderr,
    /included\s+yes/,
    "explain must agree that a file the snapshot contains is included"
  );

  const bystander = run(dir, "explain", "src/bystander.ts", "--changed-since", "HEAD", "--with-dependents");
  assert.match(
    bystander.stdout + bystander.stderr,
    /reason\s+unchanged/,
    "and a file that imports nothing changed stays out"
  );
});

test("validate notices a file that became an importer of a changed file", (t) => {
  // `validate` compared the recorded `unchanged` skips against the raw changed set, so a file that
  // did not move but now imports something that did was called correctly excluded — the one drift
  // the snapshot was built to avoid.
  const dir = makeRepo(t, DEPENDENT_FILES, { git: true });

  const first = run(dir, "generate", "--changed-since", "HEAD", "--with-dependents");
  assert.equal(first.code, 0, first.stdout + first.stderr);
  assert.equal(
    run(dir, "validate", "--changed-since", "HEAD", "--with-dependents").code,
    0,
    "an empty-but-correct scoped snapshot validates with the selection it was generated with"
  );

  fs.writeFileSync(path.join(dir, "src", "used.ts"), "export const used = 3;\n");
  const result = run(dir, "validate", "--changed-since", "HEAD", "--with-dependents", "--format", "json");
  assert.equal(result.code, 1, "the snapshot is now stale");
  const drift = JSON.parse(result.stdout).drift;
  assert.ok(
    drift.missingInSnapshot.includes("src/importer.ts"),
    `the new dependent must be reported: ${JSON.stringify(drift.missingInSnapshot)}`
  );
  assert.ok(
    drift.missingInSnapshot.includes("src/used.ts"),
    "and so must the changed file itself"
  );
  assert.equal(
    drift.missingInSnapshot.includes("src/bystander.ts"),
    false,
    "a file that imports nothing changed is still correctly excluded"
  );
});
