<file path="src/scanner/dependents.ts">
/**
 * The import graph: which file a specifier points at, and which files that makes dependents.
 *
 * This lives on its own because three callers need the same answer and must not each own a copy
 * of it. `generate --with-dependents` widens a changed-files scope by one hop of importers;
 * `explain` has to say whether a file it is explaining would be in that widened scope; and
 * `validate` has to know whether a file the snapshot dropped as `unchanged` has since become an
 * importer of something that changed. Each of them used to answer with its own path-set
 * comparison, so all three agreed the moment the scope was applied and disagreed as soon as
 * `--with-dependents` was involved — the generator included a file the other two called
 * unchanged, and every one of them was telling the truth about a different rule.
 */
import * as fs from "node:fs";
import * as path from "node:path";
import ts from "typescript";

const RELATIVE_SPECIFIER = /^\.{1,2}\//;

/** Extensions a bare `./x` may resolve to, so `import "./user"` finds `user.ts`. */
const IMPORT_CANDIDATE_SUFFIXES = [
  ".ts",
  ".tsx",
  ".mts",
  ".cts",
  ".js",
  ".jsx",
  ".mjs",
  ".cjs",
  "/index.ts",
  "/index.tsx",
  "/index.js",
  "/index.mjs",
];

const SOURCE_EXTENSIONS = new Set([
  ".ts",
  ".tsx",
  ".mts",
  ".cts",
  ".js",
  ".jsx",
  ".mjs",
  ".cjs",
]);

/**
 * Extensions whose relative imports are *not* JavaScript's `./x` shape.
 *
 * `importsOfText` has recorded Python, Ruby, C/C++ and Dart imports since the language profiles
 * landed, and `resolveSpecifier` only ever understood `./` and `../`, so every non-JavaScript edge
 * in the graph pointed at nothing: `from .models import Order` was in the manifest, resolved to
 * `null`, and the module that imports it was dropped from a `--with-dependents` snapshot.
 *
 * Package-rooted languages (Go modules, Rust `crate::`, PHP PSR-4, JVM packages, Swift modules)
 * are deliberately absent: their specifiers are resolved through a manifest — `go.mod`,
 * `Cargo.toml`, `composer.json` — and guessing a path from them would fabricate edges that
 * `validate` then has to disagree about.
 */
const PYTHON_EXTENSIONS = new Set([".py", ".pyi"]);
const RUBY_EXTENSIONS = new Set([".rb", ".rake", ".gemspec"]);
const C_EXTENSIONS = new Set([".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hxx", ".m", ".mm"]);

/** Suffixes a Python module specifier may resolve to, in the order Python's own finder tries. */
const PYTHON_SUFFIXES = [".py", ".pyi", "/__init__.py", "/__init__.pyi"];

/**
 * Whether this platform's filesystems fold case by default.
 *
 * The folded maps used to be consulted unconditionally, so on Linux — where `Foo.ts` and
 * `foo.ts` are different files — `import "./foo"` resolved to `Foo.ts` even though node and
 * TypeScript would fail to resolve it. A false dependent edge is as wrong as a missing one, so
 * folding is now a platform property and never overrides an exact match.
 */
const CASE_INSENSITIVE_FILESYSTEM = process.platform === "win32" || process.platform === "darwin";

/** One `compilerOptions.paths` entry, with its targets already in repository-relative form. */
interface TsconfigPathRule {
  pattern: string;
  targets: readonly string[];
}

/** The `baseUrl`/`paths` shape of the nearest `tsconfig.json`. */
export interface TsconfigPaths {
  /** Repository-relative base directory for non-relative specifiers, or null when unset. */
  baseUrl: string | null;
  paths: readonly TsconfigPathRule[];
}

const TSCONFIG_CACHE = new Map<string, { key: string; value: TsconfigPaths | null }>();

/**
 * Reads `baseUrl` and `paths` from `<cwd>/tsconfig.json`, following `extends`.
 *
 * Type aliases — `@/lib/db`, `~/components/Button` — are the default in Next.js, Vite, Nuxt and
 * most large TypeScript repositories. `resolveSpecifier` only understood relative specifiers, so
 * every file importing through an alias was invisible to `--with-dependents`: the graph was
 * empty for exactly the files a change was most likely to break.
 *
 * `ts.parseJsonConfigFileContent` is used for the `extends` chain and for TypeScript's own
 * resolution of `baseUrl`, rather than a hand-written JSON reader that would disagree with the
 * compiler about comments and inherited fields. Failure is not fatal: a repository without a
 * readable tsconfig simply has no aliases, exactly as before.
 */
export function tsconfigPathsFor(cwd: string): TsconfigPaths | null {
  const configPath = path.join(cwd, "tsconfig.json");
  let stats: fs.Stats;
  try {
    stats = fs.statSync(configPath);
  } catch (err) {
    if ((err as NodeJS.ErrnoException).code === "ENOENT") return null;
    return null;
  }
  const key = `${stats.mtimeMs}:${stats.size}`;
  const cached = TSCONFIG_CACHE.get(configPath);
  if (cached !== undefined && cached.key === key) return cached.value;

  let value: TsconfigPaths | null = null;
  try {
    const read = ts.readConfigFile(configPath, ts.sys.readFile);
    if (read.error === undefined) {
      const parsed = ts.parseJsonConfigFileContent(read.config, ts.sys, cwd, undefined, configPath);
      const options = parsed.options;
      const baseUrl =
        typeof options.baseUrl === "string" ? repositoryRelative(cwd, options.baseUrl) : null;
      const rules: TsconfigPathRule[] = [];
      if (options.paths !== undefined) {
        for (const [pattern, targets] of Object.entries(options.paths)) {
          if (!Array.isArray(targets)) continue;
          rules.push({
            pattern,
            targets: targets.map((target) => String(target).replace(/\\/g, "/")),
          });
        }
      }
      // A baseUrl outside the repository is not a path this graph can see into; recording it
      // would fabricate passes into `../shared` that the snapshot does not contain.
      if (baseUrl !== null || rules.length > 0) value = { baseUrl, paths: rules };
    }
  } catch (err) {
    // A malformed tsconfig is a project problem, not a reason to fail a snapshot. The other
    // language profiles behave the same way: a manifest they cannot read means no edges.
    value = null;
  }
  TSCONFIG_CACHE.set(configPath, { key, value });
  return value;
}

/** `target` relative to `cwd` as a POSIX path, or null when it escapes the repository. */
function repositoryRelative(cwd: string, target: string): string | null {
  const relative = path.relative(cwd, target).replace(/\\/g, "/");
  return relative.length === 0 || (!relative.startsWith("..") && !path.isAbsolute(relative))
    ? relative
    : null;
}

/** One-pass lookup tables for relative-import resolution.
 *
 * `resolveSpecifier` used to fall back to scanning every known file for every
 * unresolved import — 100k files × 100k imports — and built a RegExp from the
 * candidate path, so a directory named `[unmatched` aborted the run and `[id]`
 * matched unrelated files. Both are gone: every candidate is a map lookup, and
 * no path is ever used as a pattern.
 *
 * Exported so a consumer can answer "what imports this file" from the snapshot's own
 * index using the same rules the generator used. `manifest.indexes.imports.byFile`
 * records the *raw* specifiers a file imports (`"./user.js"`), and a second
 * implementation of the resolution would eventually disagree with this one — leaving
 * two accounts of one graph.
 */
export interface ImportResolver {
  byPath: Map<string, string>;
  byPathFolded: Map<string, string>;
  byStem: Map<string, string>;
  byStemFolded: Map<string, string>;
  /** Type aliases the graph could resolve, when a tsconfig was supplied. */
  tsconfig: TsconfigPaths | null;
}

/** Anything that knows its own repository-relative path; `FileEntry` is the common case. */
export interface ImportCandidate {
  relativePath: string;
}

/** Extra inputs to the resolver. */
export interface ImportResolverOptions {
  /**
   * Paths that changed but were not included — deleted modules.
   *
   * `resolveSpecifier` used to resolve against included files only, so when `a.ts` was deleted,
   * `import "./a"` in `b.ts` resolved to `null` and `b.ts` was not added as a dependent — the
   * one file the change was most likely to break. A tombstone makes the edge resolvable without
   * pretending the file is in the snapshot.
   */
  extraPaths?: Iterable<string>;
  /** `baseUrl`/`paths` from the repository's tsconfig, when the caller read one. */
  tsconfig?: TsconfigPaths | null;
}

function rememberFirst(map: Map<string, string>, key: string, value: string): void {
  if (!map.has(key)) map.set(key, value);
}

export function buildImportResolver(
  files: readonly ImportCandidate[],
  options: ImportResolverOptions = {}
): ImportResolver {
  const byPath = new Map<string, string>();
  const byPathFolded = new Map<string, string>();
  const byStem = new Map<string, string>();
  const byStemFolded = new Map<string, string>();

  const register = (relativePath: string): void => {
    rememberFirst(byPath, relativePath, relativePath);
    if (CASE_INSENSITIVE_FILESYSTEM) {
      rememberFirst(byPathFolded, relativePath.toLowerCase(), relativePath);
    }

    const extension = path.posix.extname(relativePath);
    if (!SOURCE_EXTENSIONS.has(extension)) return;
    const stem = relativePath.slice(0, -extension.length);
    rememberFirst(byStem, stem, relativePath);
    if (CASE_INSENSITIVE_FILESYSTEM) {
      rememberFirst(byStemFolded, stem.toLowerCase(), relativePath);
    }
    // `import "./dir"` resolves to `dir/index.ts`.
    if (path.posix.basename(stem) === "index") {
      const directory = path.posix.dirname(stem);
      rememberFirst(byStem, directory, relativePath);
      if (CASE_INSENSITIVE_FILESYSTEM) {
        rememberFirst(byStemFolded, directory.toLowerCase(), relativePath);
      }
    }
  };

  // Included files first: a tombstone must never shadow a file the snapshot contains.
  for (const file of files) register(file.relativePath);
  if (options.extraPaths !== undefined) {
    for (const extra of options.extraPaths) {
      if (!byPath.has(extra)) register(extra);
    }
  }

  return { byPath, byPathFolded, byStem, byStemFolded, tsconfig: options.tsconfig ?? null };
}

/** Best-effort resolution of a relative import to an included file. */
export function resolveSpecifier(
  fromFile: string,
  specifier: string,
  resolver: ImportResolver
): string | null {
  const extension = path.posix.extname(fromFile).toLowerCase();

  const exact = (key: string): string | null =>
    resolver.byPath.get(key) ??
    (CASE_INSENSITIVE_FILESYSTEM ? resolver.byPathFolded.get(key.toLowerCase()) : undefined) ??
    null;
  const firstOf = (candidates: readonly string[]): string | null => {
    for (const candidate of candidates) {
      const hit = exact(candidate);
      if (hit) return hit;
    }
    return null;
  };
  /** Exact, extension, directory-index and `.js`-to-`.ts` candidates for one path. */
  const lookupPath = (joined: string): string | null => {
    const direct = exact(joined);
    if (direct) return direct;
    for (const suffix of IMPORT_CANDIDATE_SUFFIXES) {
      const hit = exact(`${joined}${suffix}`);
      if (hit) return hit;
    }
    const stem = joined.replace(/\.(?:js|mjs|cjs|jsx)$/, "");
    const byStem = (key: string): string | null =>
      resolver.byStem.get(key) ??
      (CASE_INSENSITIVE_FILESYSTEM ? resolver.byStemFolded.get(key.toLowerCase()) : undefined) ??
      null;
    return byStem(joined) ?? byStem(stem);
  };

  if (PYTHON_EXTENSIONS.has(extension) && specifier.startsWith(".")) {
    const dots = /^\.+/.exec(specifier)?.[0].length ?? 0;
    const rest = specifier.slice(dots).replace(/\./g, "/");
    let base = path.posix.dirname(fromFile);
    // One dot is this package; every further dot is one directory up.
    for (let up = 1; up < dots; up += 1) base = path.posix.dirname(base);
    const joined = rest ? path.posix.normalize(path.posix.join(base, rest)) : base;
    return firstOf([joined, ...PYTHON_SUFFIXES.map((suffix) => `${joined}${suffix}`)]);
  }

  if (RUBY_EXTENSIONS.has(extension) && specifier.startsWith("./")) {
    // `require_relative` only: the profile keeps a bare `require` bare, because a gem name is not
    // a path and resolving one would invent an edge to any same-named file.
    const joined = path.posix.normalize(
      path.posix.join(path.posix.dirname(fromFile), specifier)
    );
    return firstOf([`${joined}.rb`, joined]);
  }

  if (C_EXTENSIONS.has(extension) && specifier.startsWith("./")) {
    // `#include "local.h"` only: `<stdio.h>` is recorded without the prefix and stays unresolved.
    const joined = path.posix.normalize(
      path.posix.join(path.posix.dirname(fromFile), specifier)
    );
    return exact(joined);
  }

  if (extension === ".dart" && !specifier.includes(":")) {
    // Dart has no `./` convention: a specifier with no scheme is a path beside this file.
    const joined = path.posix.normalize(
      path.posix.join(path.posix.dirname(fromFile), specifier)
    );
    return firstOf([joined, `${joined}.dart`]);
  }

  if (!RELATIVE_SPECIFIER.test(specifier)) {
    return resolveTsconfigSpecifier(specifier, resolver, lookupPath);
  }
  const joined = path.posix.normalize(
    path.posix.join(path.posix.dirname(fromFile), specifier)
  );
  return lookupPath(joined);
}

/**
 * Resolves a non-relative specifier through `compilerOptions.baseUrl` and `paths`.
 *
 * The substitution follows TypeScript's rule: the first `*` in the pattern captures, and every
 * `*` in a target is replaced with that capture. Candidates then go through the same
 * extension/index/`.js`-to-`.ts` lookup as a relative import, so an alias to a directory or to a
 * `.js` specifier behaves like the real module resolver.
 */
function resolveTsconfigSpecifier(
  specifier: string,
  resolver: ImportResolver,
  lookupPath: (joined: string) => string | null
): string | null {
  const config = resolver.tsconfig;
  if (!config) return null;

  for (const rule of config.paths) {
    const star = rule.pattern.indexOf("*");
    let captured: string | null;
    if (star === -1) {
      captured = specifier === rule.pattern ? "" : null;
    } else {
      const prefix = rule.pattern.slice(0, star);
      const suffix = rule.pattern.slice(star + 1);
      if (
        specifier.length < prefix.length + suffix.length ||
        !specifier.startsWith(prefix) ||
        !specifier.endsWith(suffix)
      ) {
        captured = null;
      } else {
        captured = specifier.slice(prefix.length, specifier.length - suffix.length);
      }
    }
    if (captured === null) continue;
    for (const target of rule.targets) {
      const substituted = target.split("*").join(captured);
      const base = config.baseUrl === null ? substituted : path.posix.join(config.baseUrl, substituted);
      const hit = lookupPath(path.posix.normalize(base));
      if (hit) return hit;
    }
  }

  if (config.baseUrl !== null) {
    return lookupPath(path.posix.normalize(path.posix.join(config.baseUrl, specifier)));
  }
  return null;
}

/**
 * True when `imports` — the specifiers one file imports — reach anything in `changedPaths`.
 *
 * One hop, and only one hop. The test is against the **changed set**, never against a set that
 * is being extended while it is tested: doing that walked the graph transitively, so a changed
 * `a.ts` pulled in `b.ts` (which imports it) and then `c.ts` (which imports `b.ts`), and whether
 * the two-hop file was included depended on whether its name happened to sort after `b.ts`. The
 * same repository produced different snapshots depending on file names.
 */
export function importsChangedFile(
  importerPath: string,
  imports: readonly string[],
  changedPaths: ReadonlySet<string>,
  resolver: ImportResolver
): boolean {
  for (const specifier of imports) {
    const resolved = resolveSpecifier(importerPath, specifier, resolver);
    if (resolved !== null && changedPaths.has(resolved)) return true;
  }
  return false;
}
</file>

<file path="tests/explain-ignored-descendant.test.js">
/**
 * Explain/validate follow-ups from the fresh-environment verification.
 *
 * Two answers were weaker than the artifacts they described:
 *
 *   1. A file inside a `.gitignore`d directory has no skip record of its own —
 *      the walk never descends — so `explain` fell back to `not-discovered`
 *      ("not tracked or is otherwise not a candidate") while its parent
 *      directory carried the honest `gitignore` record one level up.
 *   2. `validate` printed "N file(s) exist on disk but could not be read" with
 *      no paths, the only drift summary without them, so a terminal user had to
 *      switch to `--format json` to find out which file was meant.
 *
 * The documented `not-discovered` answer is deliberately preserved for files
 * under `node_modules`: `docs/cli.md` pins that exact detail string.
 *
 * Fixtures are created without git, so discovery is the plain walk.
 */
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { explainPath, generateSnapshot, resolveConfig } from "../dist/index.js";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

const DOCUMENTED_NOT_DISCOVERED = "exists but is not tracked or is otherwise not a candidate";

function makeRepo(t, { nodeModules = false } = {}) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "explain-ignored-"));
  const write = (rel, content) => {
    const full = path.join(dir, rel);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content);
  };
  write("package.json", '{"name":"explain-ignored","private":true}\n');
  write(".gitignore", "ignored/\n");
  write("ignored/secret.txt", "should never be read\n");
  write("src/a.ts", "export const a = 1;\n");
  if (nodeModules) write("node_modules/dep/index.js", "module.exports = 1;\n");
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const configFor = (cwd) => resolveConfig({ cwd, outDir: "snapshot", tmpDir: "snapshot.tmp" });

function runCli(args, cwd) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    encoding: "utf8",
    cwd,
    stdio: ["ignore", "pipe", "pipe"],
  });
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

// ------------------------------------------------- (a) ignored descendant

test("DH-13: a file inside an ignored directory explains as gitignore and names the ancestor", (t) => {
  const dir = makeRepo(t);
  const result = explainPath(configFor(dir), "ignored/secret.txt");

  assert.equal(result.included, false);
  assert.equal(
    result.reason,
    "gitignore",
    `expected the ancestor's gitignore record, got ${result.reason}`
  );
  assert.ok(
    result.detail?.includes("ignored by .gitignore"),
    `expected the ancestor's detail, got: ${result.detail}`
  );
  assert.ok(
    result.detail?.includes("ignored"),
    `expected the ancestor path in the detail, got: ${result.detail}`
  );
  assert.ok(
    result.detail?.includes("inherited"),
    `expected the answer to say it was inherited, got: ${result.detail}`
  );
});

test("DH-14: the ancestor explanation is traceable to the directory that carries the record", (t) => {
  const dir = makeRepo(t);
  const file = explainPath(configFor(dir), "ignored/secret.txt");
  const directory = explainPath(configFor(dir), "ignored");

  assert.equal(directory.reason, "gitignore", "the directory keeps its own record");
  assert.ok(
    file.detail?.includes(directory.detail ?? "\u0000"),
    "the file's detail must build on the directory's own detail string"
  );
});

// --------------------------------- (b) built-in ignore is inherited too

test("DH-15: a file under node_modules names its ancestor and reason default-ignore", (t) => {
  const dir = makeRepo(t, { nodeModules: true });
  const result = explainPath(configFor(dir), "node_modules/dep/index.js");

  assert.equal(result.included, false);
  assert.equal(
    result.reason,
    "default-ignore",
    "the built-in ignore is inherited exactly like a gitignore, so all reasons behave alike"
  );
  assert.ok(
    result.detail?.includes('built-in ignore: directory "node_modules"'),
    `expected the directory's own detail, got: ${result.detail}`
  );
  assert.ok(
    result.detail?.includes("inherited from the skipped directory `node_modules`"),
    `expected the ancestor to be named, got: ${result.detail}`
  );
  assert.notEqual(result.detail, DOCUMENTED_NOT_DISCOVERED);
});

// --------------------------------------------- (c) unreadable names a path

test(
  "DH-16: validate names the unreadable file in text output and keeps it in JSON",
  { skip: process.platform !== "win32" ? "needs icacls to deny a read (Windows only)" : false },
  (t) => {
    const dir = makeRepo(t);
    fs.writeFileSync(path.join(dir, "src", "locked.ts"), "export const locked = 2;\n");
    assert.equal(runCli(["generate"], dir).code, 0, "baseline generate must succeed");

    const locked = path.join(dir, "src", "locked.ts");
    const user = execFileSync("whoami", { encoding: "utf8" }).trim();
    let denied = false;
    try {
      execFileSync("icacls", [locked, "/deny", `${user}:(R)`], { stdio: "ignore" });
      denied = true;

      const text = runCli(["validate"], dir);
      assert.equal(text.code, 1, "an unreadable file must still fail validation");
      assert.ok(
        text.stderr.includes("could not be read"),
        `expected the unreadable summary, got: ${text.stderr}`
      );
      assert.ok(
        text.stderr.includes("unreadable: src/locked.ts"),
        `the text output must name the path, got: ${text.stderr}`
      );

      const json = runCli(["validate", "--format", "json"], dir);
      assert.equal(json.code, 1);
      const payload = JSON.parse(json.stdout);
      assert.deepEqual(
        payload.drift.unreadable,
        ["src/locked.ts"],
        "the JSON payload must keep carrying drift.unreadable"
      );
    } finally {
      if (denied) execFileSync("icacls", [locked, "/remove:d", user], { stdio: "ignore" });
    }

    assert.equal(runCli(["validate"], dir).code, 0, "validation recovers once the read is allowed");
  }
);

// ------------------------------------------------ (d) deleted still names

test("DH-17: a genuinely deleted file still prints `deleted: <path>`", (t) => {
  const dir = makeRepo(t);
  assert.equal(runCli(["generate"], dir).code, 0, "baseline generate must succeed");

  fs.rmSync(path.join(dir, "src", "a.ts"));
  const result = runCli(["validate"], dir);

  assert.equal(result.code, 1);
  assert.ok(
    result.stderr.includes("deleted: src/a.ts"),
    `expected the deleted line, got: ${result.stderr}`
  );
  assert.ok(
    !result.stderr.includes("unreadable:"),
    "a deleted file must not be reported as unreadable"
  );
});

// --------------------------------------------------------------- regression

test("DH-18: a file that is not skipped at all still explains as included", (t) => {
  const dir = makeRepo(t);
  const result = explainPath(configFor(dir), "src/a.ts");

  assert.equal(result.included, true);
  assert.equal(result.reason, undefined);
  assert.equal(result.language, "typescript");
});

// ------------------------------------- (e) genuinely unexplained keeps its string

test("DH-19: a path nothing accounts for still reports not-discovered", (t) => {
  const dir = makeRepo(t);
  const config = configFor(dir);
  generateSnapshot(config);

  // The tool prunes its own output directory without recording it, so this file
  // exists, has no skip record, and has no skipped ancestor either -- the one
  // remaining case that is genuinely unexplained.
  const result = explainPath(config, "snapshot/manifest.json");

  assert.equal(result.exists, true);
  assert.equal(result.included, false);
  assert.equal(result.reason, "not-discovered");
  assert.equal(
    result.detail,
    DOCUMENTED_NOT_DISCOVERED,
    "the not-discovered detail string is documented, so it must not drift"
  );
});

// ---------------------------------------- (f) docs quote what the binary prints

test("DH-20: the docs quote the exact reason/detail strings the binary prints", (t) => {
  const dir = makeRepo(t, { nodeModules: true });
  const config = configFor(dir);
  generateSnapshot(config);

  const defaultIgnore = explainPath(config, "node_modules/dep/index.js");
  const gitignored = explainPath(config, "ignored/secret.txt");
  const unexplained = explainPath(config, "snapshot/manifest.json");

  const cliDoc = fs.readFileSync(path.join(HERE, "..", "docs", "cli.md"), "utf8");
  const troubleshootingDoc = fs.readFileSync(
    path.join(HERE, "..", "docs", "troubleshooting.md"),
    "utf8"
  );

  assert.equal(defaultIgnore.reason, "default-ignore");
  assert.equal(gitignored.reason, "gitignore");
  assert.equal(unexplained.reason, "not-discovered");

  // Both inherited forms are documented in the CLI key table.
  for (const [name, detail] of [
    ["default-ignore", defaultIgnore.detail],
    ["gitignore", gitignored.detail]
  ]) {
    assert.ok(
      cliDoc.includes(detail),
      `docs/cli.md must quote the live ${name} detail verbatim, expected: ${detail}`
    );
  }

  // The troubleshooting reason table documents all three verbatim.
  for (const [name, detail] of [
    ["default-ignore", defaultIgnore.detail],
    ["gitignore", gitignored.detail],
    ["not-discovered", unexplained.detail]
  ]) {
    assert.ok(
      troubleshootingDoc.includes(detail),
      `docs/troubleshooting.md must quote the live ${name} detail verbatim, expected: ${detail}`
    );
  }
});

// ------------------------------------ (g) contract appliesTo has no prose

test("DH-21: no option's appliesTo is prose, and every token is a real command", () => {
  const result = runCli(["describe", "--format", "json"], HERE);
  assert.equal(result.code, 0, "describe --format json must succeed");

  const contract = JSON.parse(result.stdout);
  // Derived from the contract, not hard-coded: a third copy of the command list is one more place
  // a new command can be forgotten, and what this asserts is that `appliesTo` names commands the
  // contract actually documents.
  const COMMANDS = contract.commands.map((command) => command.name);

  assert.ok(
    Array.isArray(contract.options) && contract.options.length >= 20,
    `expected the full option table, got ${contract.options?.length}`
  );

  for (const option of contract.options) {
    const appliesTo = String(option.appliesTo);

    // The regression this pins: `--format` used to read "all commands", which a
    // machine consumer parses as one command named "all commands" -- i.e. a flag
    // that applies to nothing. Literal prose must never come back.
    assert.ok(
      !/\ball\b/i.test(appliesTo),
      `${option.flag} appliesTo must be a command list, not prose: "${appliesTo}"`
    );

    const tokens = appliesTo.split("/");
    assert.ok(tokens.length > 0, `${option.flag} has an empty appliesTo`);
    for (const token of tokens) {
      assert.ok(token.length > 0, `${option.flag} appliesTo has an empty token: "${appliesTo}"`);
      assert.ok(
        COMMANDS.includes(token),
        `${option.flag} appliesTo names "${token}", which is not one of the known commands`
      );
    }
  }

  // The specific entry the Lead's sweep caught, asserted by value.
  const format = contract.options.find((option) => option.flag === "--format");
  assert.ok(format, "the contract must list --format");
  assert.equal(
    format.appliesTo,
    "generate/validate/health/report/explain/init/setup/diff/describe/skill",
    "--format applies to every command that renders a payload; mcp is excluded because its stdout carries JSON-RPC"
  );
});

// ------------------------------------------------- (h) explain agrees with generate
// E1: the inclusion answer asked only whether the content was text, so a .png holding a
// Git-LFS pointer or a placeholder was explained as included while generate skipped it by
// extension. And classification ran before the binary check, so a genuinely binary file came
// back with included:false carrying layer/kind/language — keys docs/cli.md says a skipped path
// does not have.

test("E1: explain agrees with generate when a binary extension holds text", (t) => {
  const dir = makeRepo(t);
  fs.mkdirSync(path.join(dir, "assets"), { recursive: true });
  fs.writeFileSync(path.join(dir, "assets", "logo.png"), "not a png at all\n");

  const manifest = generateSnapshot(configFor(dir));
  assert.equal(
    manifest.skipped.find((entry) => entry.path === "assets/logo.png")?.reason,
    "binary",
    "generate decides by extension"
  );

  const result = explainPath(configFor(dir), "assets/logo.png");

  assert.equal(result.included, false, "generate skips it, so explain must not call it included");
  assert.equal(result.reason, "binary");
  assert.match(String(result.detail), /binary extension/, "the answer names the decision");
  assert.equal(result.layer, undefined, "a skipped path is not classified");
  assert.equal(result.kind, undefined, "a skipped path is not classified");
  assert.equal(result.language, undefined, "a skipped path is not classified");
  assert.equal(result.layerMatch, undefined, "a skipped path is not classified");
});

test("E1: a binary path's JSON answer is exactly the documented skip shape", (t) => {
  const dir = makeRepo(t);
  fs.mkdirSync(path.join(dir, "assets"), { recursive: true });
  fs.writeFileSync(
    path.join(dir, "assets", "real.png"),
    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x00, 0x01])
  );
  generateSnapshot(configFor(dir));

  const result = explainPath(configFor(dir), "assets/real.png");

  assert.equal(result.included, false, "a NUL-bearing png is skipped");
  assert.equal(result.reason, "binary");
  // docs/cli.md: when included is false the object stops after path, exists, included, reason
  // and detail.
  assert.deepEqual(Object.keys(result).sort(), [
    "detail",
    "exists",
    "included",
    "path",
    "reason",
  ]);
});

test("E1: a content-binary file with an ordinary extension is an unclassified skip", (t) => {
  const dir = makeRepo(t);
  // Valid UTF-8, no NUL, more than 1% control bytes: generate skips it as binary by content.
  fs.writeFileSync(path.join(dir, "src", "blob.dat"), Buffer.alloc(4096, 0x07));
  generateSnapshot(configFor(dir));

  const result = explainPath(configFor(dir), "src/blob.dat");

  assert.equal(result.included, false);
  assert.equal(result.reason, "binary");
  assert.match(String(result.detail), /control byte/, "the answer says why the bytes are not text");
  assert.equal(result.layer, undefined, "a skipped path is not classified");
  assert.equal(result.kind, undefined, "a skipped path is not classified");
  assert.equal(result.language, undefined, "a skipped path is not classified");
});

test("E1: explain still classifies a file it includes", (t) => {
  const dir = makeRepo(t);
  const result = explainPath(configFor(dir), "src/a.ts");

  assert.equal(result.included, true);
  assert.equal(typeof result.layer, "string", "an included file keeps its classification");
  assert.equal(typeof result.kind, "string");
  assert.equal(result.language, "typescript");
});
