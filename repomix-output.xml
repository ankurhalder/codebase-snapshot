<file path="tsup.config.ts">
import { defineConfig } from "tsup";

/**
 * No source maps in the published bundle.
 *
 * `package.json#files` does not ship `*.map`, and `scripts/pack-check.mjs` enforces that — but the
 * build still emitted `//# sourceMappingURL=index.js.map` at the end of every `dist/*.js`, `*.cjs`
 * and `*.d.ts`. Every consumer's debugger therefore resolved the comment, found nothing, and
 * reported a missing source map for a file it had just loaded. A comment pointing at a file that
 * is deliberately not shipped is a wrong answer at the exact moment someone is debugging.
 */
export default defineConfig([
  {
    entry: {
      index: "src/index.ts",
      cli: "src/cli.ts",
      // The MCP server is its own entry, not part of the root export: it imports the generator,
      // so re-exporting it from `index` would create an import cycle, and nobody who only wants
      // `generateSnapshot` should ship a protocol implementation.
      mcp: "src/mcp/index.ts",
    },
    format: ["esm", "cjs"],
    dts: true,
    sourcemap: false,
    clean: true,
    treeshake: true,
    target: "node18",
    external: ["typescript"],
  },
  {
    // Thin executable shim: keeps `src/cli.ts` free of side effects so the
    // `./cli` subpath can be imported (ESM *and* CJS) without running the CLI.
    // The `#!/usr/bin/env node` shebang lives in `src/bin.ts`; adding a banner
    // here would emit it twice and produce an unparsable second line.
    entry: { bin: "src/bin.ts" },
    format: ["esm"],
    sourcemap: false,
    target: "node18",
    external: ["typescript"],
  },
]);
</file>

<file path=".github/workflows/pages.yml">
name: Docs site

# The site is rendered from README.md and docs/*.md by scripts/build-site.mjs, so
# it can only change when one of those does. Building on every push to main would
# burn a deploy for every source change that cannot affect it.
on:
  push:
    branches: [main]
    paths:
      - "README.md"
      - "docs/**"
      - "llms.txt"
      - "scripts/build-site.mjs"
      - "package.json"
      - "package-lock.json"
      - ".github/workflows/pages.yml"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

# Let a running deploy finish; queue at most one behind it. Cancelling a deploy
# mid-flight can leave the site on a half-published artifact.
concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      # Third-party actions are pinned to full commit SHAs with the release version in a trailing
      # comment, exactly as in `pr.yml` and `publish.yml`. This workflow holds `pages: write` and
      # `id-token: write`, so a moved tag is the one thing it must not trust.
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm

      - run: npm ci

      - name: Render the site
        run: npm run site

      # A misspelt internal link is invisible until someone clicks it, and by
      # then the page is already published. Fail the deploy instead.
      - name: Every internal link resolves
        run: node scripts/check-site-links.mjs

      - name: Upload the Pages artifact
        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3.0.1
        with:
          path: site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        name: Deploy to GitHub Pages
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5
</file>

<file path=".github/workflows/pr.yml">
name: Pull request gate

# The same gate a release runs, on every pull request and every push to main.
#
# Before this workflow existed, the Node 18/20/22 matrix below ran only at release time. A
# compatibility break therefore first surfaced during a publish; 0.9.14 needed four attempts to get
# out for exactly that reason, and each attempt spent a version number. Catching the break on the
# branch is cheaper than catching it on a tag, and it turns the "works on Node 18" claim in the
# package metadata into a tested statement rather than a promise.
#
# `npm run verify` is the whole gate — lint, typecheck, the full test suite, the docs/site checks and
# the tarball check — so a green local verify is the same code path a green pull request takes. The
# release workflow (`publish.yml`) still re-runs it on the tag, because a tag can be created from a
# commit that never went through a pull request.
on:
  pull_request:
  push:
    branches: [main]

# A new push to the same branch makes the previous run's answer obsolete. Cancelling it keeps the
# owner's shared Actions allowance for the run that reflects the code reviewers will actually see.
concurrency:
  group: pr-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    strategy:
      # One failing version must not cancel the others: the point is to learn which versions work.
      fail-fast: false
      matrix:
        node: [18, 20, 22]
    steps:
      # Third-party actions are pinned to full commit SHAs (with the release version in a trailing
      # comment), exactly as in `publish.yml`: a moved tag must not be able to change what runs
      # here just because this workflow is the one developers trigger by pushing a branch.
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js ${{ matrix.node }}
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ matrix.node }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      # The same gate a developer runs locally: lint, typecheck, the full test suite, the
      # docs/site checks and a check of the exact tarball that would be uploaded.
      - name: Verify on Node ${{ matrix.node }}
        run: npm run verify
</file>

<file path=".github/workflows/publish-train.yml">
name: Publish train

# Publishes a list of already-tagged versions in one job, sequentially.
#
# The release-event workflow stays for milestones. This exists because a concurrency group of
# "npm-publish" cancels a *pending* run when a newer release arrives, so bulk sub-bumps cannot all
# go through release events. One job, one npm publish per tag, no waits between runs.

on:
  workflow_dispatch:
    inputs:
      versions:
        description: Comma-separated versions, e.g. 0.12.15,0.12.16
        required: true
      dry_run:
        description: Build and verify without publishing
        type: boolean
        default: false

permissions:
  contents: read
  id-token: write

concurrency:
  group: npm-publish-train
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          registry-url: https://registry.npmjs.org

      - name: Publish each tagged version
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
          VERSIONS: ${{ inputs.versions }}
          DRY_RUN: ${{ inputs.dry_run }}
        run: |
          set -euo pipefail
          IFS=',' read -ra LIST <<< "$VERSIONS"
          for V in "${LIST[@]}"; do
            V="$(echo "$V" | tr -d "[:space:]")"
            [ -z "$V" ] && continue
            TAG="v$V"
            echo "::group::publishing $V"
            git checkout --force "$TAG"
            npm ci --no-audit --no-fund
            npm run build
            if npm view "codebase-snapshot@$V" version >/dev/null 2>&1; then
              echo "codebase-snapshot@$V is already on the registry; skipping"
            elif [ "$DRY_RUN" = "true" ]; then
              echo "dry run: would publish $V"
            else
              npm publish --access public --provenance
            fi
            echo "::endgroup::"
          done
</file>

<file path=".github/workflows/publish.yml">
name: Publish to NPM

# The release half of the gate.
#
# `.github/workflows/pr.yml` runs this same verify on every pull request and every push to main, so
# a release normally re-proves what the branch already passed. It runs again on the tag because a tag
# can point at a commit that never went through a pull request, and the publish job must never upload
# a commit that was never verified.
#
# The owner pays for GitHub Actions minutes out of a shared allowance across several projects, so
# this workflow stays release-only (`pr.yml` carries the per-push cost). `npm run verify` is the
# whole gate — lint, typecheck, the full suite, the tarball check — so a green local verify is the
# same code path the release takes.
#
# Since 4.3.0 that gate runs on **every supported Node version**, not just the developer's: the
# package says `engines: >=18` and until that release no run had ever executed on 18 or 20. Three
# jobs of about two minutes per release is the price of that claim being true; the publish job
# cannot start until all three pass.
on:
  release:
    types: [published]
  workflow_dispatch:

# Serialize releases: two publishes must never overlap, and an in-flight
# publish must never be cancelled, hence cancel-in-progress: false.
concurrency:
  group: npm-publish
  cancel-in-progress: false

jobs:
  verify:
    runs-on: ubuntu-latest
    # workflow_dispatch can be started from any branch, so gate it to main.
    # `release` events publish the tagged commit (refs/tags/<tag>), so they are
    # allowed through explicitly and keep working.
    if: github.event_name == 'release' || github.ref == 'refs/heads/main'
    permissions:
      contents: read
    strategy:
      # One failing version must not cancel the others: the point is to learn which versions work.
      fail-fast: false
      matrix:
        node: [18, 20, 22]
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js ${{ matrix.node }}
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ matrix.node }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      # The same gate a developer runs locally: lint, typecheck, the full test
      # suite, and a check of the exact tarball that would be uploaded. It fails
      # the publish rather than shipping a package this repository never tested.
      - name: Verify on Node ${{ matrix.node }}
        run: npm run verify

  publish:
    needs: verify
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      # Third-party actions are pinned to full commit SHAs (with the release
      # version in a trailing comment) so a retagged or hijacked release cannot
      # silently change what runs during a publish.
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js and npm registry
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          registry-url: 'https://registry.npmjs.org'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      # A release tag is the maintainer's statement of what is being shipped. A tag that disagrees
      # with the manifest would either publish a version nobody named (`v1.0.0` tag, `0.9.14`
      # manifest) or, when that manifest version is already on the registry, take the idempotent
      # "already published" exit below and release nothing at all. Both are worse than failing
      # loudly, so a mismatch stops the job before any publish step runs.
      - name: The release tag agrees with the manifest version
        if: github.event_name == 'release'
        env:
          # Through the environment, never through an expression inside a run body: the tag is
          # untrusted input as far as this shell is concerned, and an expression expansion happens
          # before bash parses the script (see the note in deprecate.yml).
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          VERSION="$(npm pkg get version | tr -d '"')"
          # Tags are cut as vX.Y.Z; accept that convention and the bare version.
          TAG_VERSION="${RELEASE_TAG#v}"
          if [ "$TAG_VERSION" != "$VERSION" ]; then
            echo "::error::release tag '$RELEASE_TAG' does not match package.json version '$VERSION'; refusing to publish"
            exit 1
          fi
          echo "release tag $RELEASE_TAG matches package.json version $VERSION"

      # The verify matrix above already ran the full gate on 18, 20 and 22 for this exact commit
      # — that is what `needs: verify` guarantees — so uploading is all that is left.

      # Guarded so a partial failure later in the job can be recovered by simply
      # re-running: without this, npm refuses with "cannot publish over" and the
      # only way forward is a version bump.
      - name: Publish to npm with provenance
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
        run: |
          set -euo pipefail
          VERSION="$(npm pkg get version | tr -d '"')"
          if npm view "codebase-snapshot@$VERSION" version >/dev/null 2>&1; then
            echo "codebase-snapshot@$VERSION is already on the registry; skipping"
            exit 0
          fi
          npm publish --access public --provenance

      # `npm create codebase-snapshot` is advertised in the changelog and README
      # and lives in packages/create, but nothing ever published it — so the
      # command resolved to a 404 while docs/install.md told people to run it.
      #
      # Publish from *inside* the directory. `npm publish packages/create` is
      # parsed as the GitHub shorthand owner/repo, and npm then tries
      # `git ls-remote ssh://git@github.com/packages/create.git` and fails with
      # exit 128 and a publickey error.
      - name: Publish create-codebase-snapshot (skip if this version exists)
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
        run: |
          set -euo pipefail
          VERSION="$(node -e 'console.log(JSON.parse(require("node:fs").readFileSync("packages/create/package.json","utf8")).version)')"
          if npm view "create-codebase-snapshot@$VERSION" version >/dev/null 2>&1; then
            echo "create-codebase-snapshot@$VERSION is already on the registry; nothing to do"
            exit 0
          fi
          cd packages/create
          npm publish --access public --provenance

      # 0.9.0 moved the package from `@ankurhalder/codebase-snapshot` to the
      # unscoped `codebase-snapshot`. Deprecating rather than unpublishing keeps
      # every existing `npx @ankurhalder/codebase-snapshot` instruction resolving,
      # while the registry tells anyone who installs the old name where it went.
      # The old name stays at its last published version; it is not republished.
      #
      # Checked first rather than re-applied blindly: deprecating an
      # already-deprecated package answers 422, and a red herring in a green run
      # trains people to ignore the log.
      - name: Deprecate the previous scoped name
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
        run: |
          set -euo pipefail
          CURRENT="$(npm view "@ankurhalder/codebase-snapshot@4.4.1" deprecated 2>/dev/null || true)"
          if [ -n "$CURRENT" ]; then
            echo "already deprecated: $CURRENT"
            exit 0
          fi
          npm deprecate "@ankurhalder/codebase-snapshot@*" \
            "Renamed to codebase-snapshot, which is the supported package. Run: npx codebase-snapshot@latest setup"
</file>

<file path=".github/workflows/seo-rank.yml">
name: SEO rank

# Records where this package actually ranks, once a week.
#
# The point is the trend, not the number. npm's search index reflects the
# published manifest within about 45 minutes, so a metadata change shows up here
# on the next run; GitHub's index is rebuilt on push. Run this after a release to
# see what the change bought, and let the weekly run catch a slow slide that no
# one would otherwise notice.
on:
  schedule:
    - cron: "17 6 * * 1"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  measure:
    runs-on: ubuntu-latest
    steps:
      # Pinned to full commit SHAs, with the release version in a comment: this workflow holds
      # `contents: write` and commits a log, so a moved tag could change what runs with that token.
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22

      - name: Measure
        env:
          # Without a token the search API allows ten requests a minute, which
          # this query set can exceed.
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: npm run seo-rank -- --record

      # The log is the artifact. Commit it so the next run is comparable, and so
      # the history is reviewable in git rather than in a dashboard nobody opens.
      - name: Record the run
        run: |
          if git diff --quiet -- seo-log.jsonl; then
            echo "no new measurement"
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add seo-log.jsonl
          git commit -m "chore: record weekly search positions"
          git push
</file>

