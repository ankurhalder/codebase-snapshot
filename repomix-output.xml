<file path="src/generator/monolith.ts">
import { fenceForContent } from "../partitioner/chunker.js";
import { escapeControls, inlineCode } from "../terminal.js";
import type { FileEntry, Manifest } from "../types.js";

export function generateMonolithJson(
  manifest: Manifest,
  filesWithContent: FileEntry[]
): string {
  // A file cannot contain its own sha256 — there is no fixed point — so this copy of the manifest
  // keeps `artifacts.fullJson` null instead of writing a digest that describes different bytes,
  // and says where the real one lives. Everything else in it matches `manifest.json`.
  const embedded: Manifest = {
    ...manifest,
    selfReference:
      "This manifest is embedded in full-codebase.json, which cannot record its own digest. " +
      "manifest.json holds the byteSize and sha256 of this file.",
  };
  return JSON.stringify({ manifest: embedded, files: filesWithContent }, null, 2);
}

/** Attributes and text are escaped; bodies ride in CDATA with the one illegal sequence split. */
function xmlAttribute(value: string): string {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function cdata(value: string): string {
  return "<![CDATA[" + value.replace(/\]\]>/g, "]]]]><![CDATA[>") + "]]>";
}

/**
 * The repository as one XML document, for the tools that read that shape.
 *
 * One <file> element per included file, with the metadata the manifest carries as attributes and
 * the body in CDATA. `]]>` cannot appear inside CDATA, so it is split across two sections — the
 * standard trick, and the reason a file containing that sequence still produces valid XML.
 */
export function generateMonolithXml(manifest: Manifest, filesWithContent: FileEntry[]): string {
  const files = filesWithContent.map((file) => {
    const content = (file.content ?? "").replace(/\r\n|\r/g, "\n");
    return [
      "  <file path=\"" + xmlAttribute(file.relativePath) + "\" language=\"" + xmlAttribute(file.language) +
        "\" layer=\"" + xmlAttribute(file.layer) + "\" kind=\"" + xmlAttribute(file.kind) +
        "\" lines=\"" + file.originalLines + "\" bytes=\"" + file.sizeBytes +
        "\" inclusion=\"" + file.inclusionMode + "\">",
      "    " + cdata(content),
      "  </file>",
    ].join("\n");
  });
  return [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<codebase_snapshot generator="' + xmlAttribute(manifest.generator.name) + '" version="' +
      xmlAttribute(manifest.generator.version) + '" fingerprint="' + xmlAttribute(manifest.fingerprint) +
      '" files="' + filesWithContent.length + '">',
    ...files,
    "</codebase_snapshot>",
    "",
  ].join("\n");
}

export function generateMonolithMarkdown(
  manifest: Manifest,
  filesWithContent: FileEntry[]
): string {
  const sections = filesWithContent.map((file) => {
    const content = (file.content ?? "").replace(/\r\n|\r/g, "\n");
    // Adaptive fence: a fixed 3-backtick fence let any file containing a fenced
    // block escape its code block and inject document markup.
    const fence = fenceForContent(content);

    return [
      `## File: ${escapeControls(file.relativePath)}`,
      "",
      `- **Layer:** ${inlineCode(file.layer)}`,
      `- **Kind:** ${inlineCode(file.kind)}`,
      `- **Lines:** \`${file.originalLines}\``,
      `- **Size:** \`${file.sizeBytes} B\``,
      `- **Inclusion:** \`${file.inclusionMode}\``,
      "",
      `${fence}${file.language}`,
      content.endsWith("\n") ? content.slice(0, -1) : content,
      fence,
      "",
      "---",
      "",
    ].join("\n");
  });

  return [
    `# Complete Codebase Monolith`,
    "",
    `**Generated:** ${manifest.generatedAt}  `,
    `**Total Files:** ${manifest.counts.totalFiles}  `,
    `**Total Lines:** ${manifest.counts.totalLines}  `,
    "",
    "---",
    "",
    ...sections,
  ].join("\n");
}
</file>

<file path="src/generator/overview.ts">
import * as fs from "node:fs";
import * as path from "node:path";
import { stripJsonComments } from "../ast/structured.js";

/**
 * What a repository says about itself, in its own words.
 *
 * The brief can prove what is inside a snapshot from the manifest, but not what the software is
 * for. Three files usually say it: `package.json` description, the opening paragraph of
 * `README.md`, and the most recent release headings of `CHANGELOG.md`. All three are the
 * owner's prose, so they are read here and masked by the caller like any other reproduced text.
 */
export interface ProjectOverview {
  /** `description` from package.json, when it has one. */
  description?: string;
  /** The first real paragraph of README.md, capped. */
  summary?: string;
  /** Release headings from CHANGELOG.md, newest first. */
  releases: string[];
}

const SUMMARY_LIMIT = 400;
const MAX_RELEASES = 2;

export function readProjectOverview(cwd: string): ProjectOverview {
  return {
    ...readDescription(cwd),
    ...readSummary(cwd),
    releases: readReleases(cwd),
  };
}

function readText(file: string): string | null {
  try {
    return fs.readFileSync(file, "utf8");
  } catch {
    return null;
  }
}

function readDescription(cwd: string): { description?: string } {
  const raw = readText(path.join(cwd, "package.json"));
  if (raw === null) return {};
  try {
    const parsed = JSON.parse(stripJsonComments(raw)) as { description?: unknown };
    return typeof parsed.description === "string" && parsed.description.trim().length > 0
      ? { description: parsed.description.trim() }
      : {};
  } catch {
    return {};
  }
}

function readSummary(cwd: string): { summary?: string } {
  const raw = readText(path.join(cwd, "README.md"));
  if (raw === null) return {};
  // Markup is removed before the paragraph is found, not after. A centred header puts the first
  // prose inside `<p>` with `<br>` and `<code>` in it: skipping HTML lines would lose the summary
  // entirely, and leaving them in printed tags into the brief.
  const text = raw
    // Heading elements are removed whole: after stripping tags `<h1>Demo</h1>` becomes the line
    // "Demo", which reads as the first prose paragraph and then ends the paragraph at the next
    // blank line - the summary of every centred README became its own title.
    .replace(/<h[1-6][^>]*>[\s\S]*?<\/h[1-6]>/gi, "\n")
    // Block boundaries become line breaks, so `<p>` prose starts its own paragraph.
    .replace(/<\/(p|div|section|header|footer|li)>/gi, "\n")
    .replace(/<br\s*\/?>/gi, " ")
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
  const paragraph: string[] = [];
  for (const line of text.split(/\r?\n/)) {
    const trimmed = line.trim();
    // Skip the title, badges and rules: the summary is the first prose paragraph.
    if (paragraph.length === 0) {
      if (trimmed.length === 0) continue;
      if (/^#/.test(trimmed) || /^!\[/.test(trimmed) || /^[-*|]/.test(trimmed)) continue;
      if (/^\[[^\]]+\]:/.test(trimmed)) continue;
    } else if (trimmed.length === 0 || /^#/.test(trimmed)) {
      break;
    }
    paragraph.push(trimmed);
  }
  const summary = paragraph.join(" ").replace(/\s+/g, " ").trim();
  if (summary.length === 0) return {};
  return { summary: truncate(summary, SUMMARY_LIMIT) };
}

/** Cuts at a word boundary, so a summary does not end mid-word. */
function truncate(text: string, limit: number): string {
  if (text.length <= limit) return text;
  const window = text.slice(0, limit);
  const space = window.lastIndexOf(" ");
  return (space > limit / 2 ? window.slice(0, space) : window).trim() + "…";
}

function readReleases(cwd: string): string[] {
  const raw = readText(path.join(cwd, "CHANGELOG.md"));
  if (raw === null) return [];
  // A changelog has other `##` headings ("A note on version numbers"); calling them releases
  // makes the brief claim a release history that does not exist.
  const headings = raw
    .split(/\r?\n/)
    .map((line) => /^##\s+(.+?)\s*$/.exec(line)?.[1]?.trim())
    .filter((heading): heading is string => heading !== undefined && /^v?\d+\.\d+/.test(heading));
  return headings.slice(0, MAX_RELEASES);
}
</file>

<file path="src/mcp/http.ts">
import * as http from "node:http";
import * as crypto from "node:crypto";
import { createServer } from "./run.js";
import { buildTools } from "./tools.js";
import type { McpServer } from "./server.js";
import type { JsonRpcResponse } from "./protocol.js";

/**
 * MCP over HTTP, for clients that are not a child process.
 *
 * The stdio transport is the default and stays the default: a client that can spawn a process
 * gets the simplest, most reliable path. This exists for the clients that cannot — browser-based
 * agents, hosted editors, anything living inside a page. It implements the Streamable HTTP shape:
 * one POST endpoint that carries a JSON-RPC message and answers with a JSON-RPC response.
 *
 * Three properties are deliberate:
 *
 *  - **Loopback unless told otherwise.** The server binds 127.0.0.1 by default. Making a
 *    repository readable from the network is a decision the user makes with --host, not a default.
 *  - **A token, or an explicit opt-out.** A page in a browser is a request with an Origin, and
 *    localhost ports are guessable. The token is generated on first use, printed once, and
 *    compared in constant time. --no-auth exists for the case where the client cannot send a
 *    header, and says what it gave up.
 *  - **No unbounded reads.** Request bodies are capped, rate is capped, and every response is one
 *    bounded JSON document. A browser tab that loops cannot pin the CPU.
 */

export interface HttpTransportOptions {
  /** Repository the tools operate on. */
  cwd: string;
  host?: string;
  port?: number;
  /** Bearer token. `undefined` generates one, `null` disables auth. */
  token?: string | null;
  /** Extra origins, beyond loopback. */
  allowedOrigins?: readonly string[];
  maxBodyBytes?: number;
  log?: (line: string) => void;
}

export interface HttpTransport {
  url: string;
  port: number;
  host: string;
  token: string | null;
  close(): Promise<void>;
}

const DEFAULT_PORT = 4789;
const DEFAULT_MAX_BODY = 2 * 1024 * 1024;
const RATE_LIMIT = 60;
const RATE_WINDOW_MS = 10_000;

/** The token a server generates when the caller did not pick one. */
export function generateToken(): string {
  return crypto.randomBytes(24).toString("base64url");
}

function isLoopbackOrigin(origin: string): boolean {
  try {
    const url = new URL(origin);
    if (url.protocol !== "http:" && url.protocol !== "https:") return false;
    const host = url.hostname;
    return host === "localhost" || host === "127.0.0.1" || host === "[::1]" || host === "::1";
  } catch {
    return false;
  }
}

function timingSafeEqual(left: string, right: string): boolean {
  const a = Buffer.from(left, "utf8");
  const b = Buffer.from(right, "utf8");
  if (a.length !== b.length) return false;
  return crypto.timingSafeEqual(a, b);
}

export async function startHttpTransport(options: HttpTransportOptions): Promise<HttpTransport> {
  const host = options.host ?? "127.0.0.1";
  const port = options.port ?? DEFAULT_PORT;
  const log = options.log ?? ((line: string) => process.stderr.write(line + "\n"));
  const token = options.token === undefined ? generateToken() : options.token;
  const maxBody = options.maxBodyBytes ?? DEFAULT_MAX_BODY;
  const extraOrigins = options.allowedOrigins ?? [];
  if (token === null && host !== "127.0.0.1" && host !== "localhost" && host !== "::1") {
    throw new Error(
      "Refusing to serve " + host + " without a token: a repository reachable from the network " +
        "must require Authorization. Drop --no-auth, or bind the loopback address."
    );
  }

  const server: McpServer = createServer({ cwd: options.cwd, log });
  const toolCount = buildTools().length;
  /**
   * Legacy SSE sessions: `GET /sse` hands out an endpoint URL, `POST /messages` answers on the
   * open stream. It exists for clients that predate Streamable HTTP and cannot send headers —
   * which is also why the token may arrive as a query parameter here. That is a leak into logs,
   * so it is confined to this path and the docs say so.
   */
  const sseSessions = new Map<string, { write: (payload: string) => void; end: () => void }>();
  const tokenAccepted = (request: http.IncomingMessage, url: URL): boolean => {
    if (token === null) return true;
    const header = request.headers.authorization ?? "";
    const match = /^Bearer\s+(.+)$/i.exec(header);
    if (match !== null && timingSafeEqual(match[1].trim(), token)) return true;
    const fromQuery = url.searchParams.get("token");
    return fromQuery !== null && timingSafeEqual(fromQuery, token);
  };
  const sessions = new Map<string, { count: number; resetAt: number }>();

  const allowedOrigin = (origin: string | undefined): string | null => {
    if (origin === undefined) return null;
    if (isLoopbackOrigin(origin)) return origin;
    return extraOrigins.includes(origin) ? origin : null;
  };

  const httpServer = http.createServer((request, response) => {
    const send = (status: number, body: unknown, extra: Record<string, string> = {}): void => {
      const text = typeof body === "string" ? body : JSON.stringify(body);
      response.writeHead(status, {
        "content-type": typeof body === "string" ? "text/plain; charset=utf-8" : "application/json",
        "content-length": Buffer.byteLength(text, "utf8"),
        "x-content-type-options": "nosniff",
        ...extra,
      });
      response.end(text);
    };

    const origin = typeof request.headers.origin === "string" ? request.headers.origin : undefined;
    const allowed = allowedOrigin(origin);
    if (origin !== undefined && allowed === null) {
      send(403, { error: "origin not allowed" });
      return;
    }
    const cors: Record<string, string> = {};
    if (allowed !== null) {
      cors["access-control-allow-origin"] = allowed;
      cors["vary"] = "origin";
      cors["access-control-allow-headers"] = "authorization, content-type, mcp-protocol-version, mcp-session-id";
      cors["access-control-allow-methods"] = "POST, GET, OPTIONS";
      cors["access-control-max-age"] = "600";
    }

    if (request.method === "OPTIONS") {
      send(204, "", cors);
      return;
    }

    if (request.method === "GET" && request.url === "/healthz") {
      send(200, { ok: true, name: "codebase-snapshot", tools: toolCount }, cors);
      return;
    }

    const url = new URL(request.url ?? "/", "http://localhost");

    if (request.method === "GET" && url.pathname === "/sse") {
      if (!tokenAccepted(request, url)) {
        send(401, { error: "unauthorized" }, { ...cors, "www-authenticate": 'Bearer realm="codebase-snapshot"' });
        return;
      }
      const id = crypto.randomBytes(12).toString("hex");
      response.writeHead(200, {
        ...cors,
        "content-type": "text/event-stream",
        "cache-control": "no-cache, no-transform",
        connection: "keep-alive",
        "x-accel-buffering": "no",
      });
      const write = (payload: string): void => {
        response.write(payload);
      };
      sseSessions.set(id, { write, end: () => response.end() });
      const heartbeat = setInterval(() => write(": ping\n\n"), 15_000);
      const cleanup = (): void => {
        clearInterval(heartbeat);
        sseSessions.delete(id);
      };
      request.on("close", cleanup);
      response.on("close", cleanup);
      write("event: endpoint\ndata: /messages?sessionId=" + id + "\n\n");
      return;
    }

    if (request.method === "POST" && url.pathname === "/messages") {
      if (!tokenAccepted(request, url)) {
        send(401, { error: "unauthorized" }, { ...cors, "www-authenticate": 'Bearer realm="codebase-snapshot"' });
        return;
      }
      const id = url.searchParams.get("sessionId") ?? "";
      const stream = sseSessions.get(id);
      if (stream === undefined) {
        send(404, { error: "unknown sessionId; open GET /sse first" });
        return;
      }
      const chunks: Buffer[] = [];
      let received = 0;
      request.on("data", (chunk: Buffer) => {
        received += chunk.length;
        if (received > maxBody) {
          request.destroy();
          send(413, { error: "request body too large", limit: maxBody });
          return;
        }
        chunks.push(chunk);
      });
      request.on("end", () => {
        void (async () => {
          let message: unknown;
          try {
            message = JSON.parse(Buffer.concat(chunks).toString("utf8"));
          } catch (error) {
            send(400, { jsonrpc: "2.0", id: null, error: { code: -32700, message: String(error) } });
            return;
          }
          const answer = await server.handle(message);
          if (answer !== null) stream.write("event: message\ndata: " + JSON.stringify(answer) + "\n\n");
          send(202, "", cors);
        })();
      });
      return;
    }

    if (request.url === "/") {
      send(
        200,
        "codebase-snapshot MCP server\n\nPOST JSON-RPC 2.0 to /mcp. Health: GET /healthz.\n",
        cors
      );
      return;
    }

    if (request.method !== "POST" || request.url !== "/mcp") {
      send(405, { error: "method not allowed" }, { ...cors, allow: "POST, OPTIONS" });
      return;
    }

    if (token !== null) {
      const header = request.headers.authorization ?? "";
      const match = /^Bearer\s+(.+)$/i.exec(header);
      if (match === null || !timingSafeEqual(match[1].trim(), token)) {
        send(401, { error: "unauthorized" }, { ...cors, "www-authenticate": 'Bearer realm="codebase-snapshot"' });
        return;
      }
    }

    const remote = request.socket.remoteAddress ?? "unknown";
    const now = Date.now();
    const window = sessions.get(remote);
    if (window === undefined || window.resetAt <= now) sessions.set(remote, { count: 1, resetAt: now + RATE_WINDOW_MS });
    else if (window.count >= RATE_LIMIT) {
      send(429, { error: "too many requests" }, { ...cors, "retry-after": "10" });
      return;
    } else window.count += 1;

    let received = 0;
    const chunks: Buffer[] = [];
    request.on("data", (chunk: Buffer) => {
      received += chunk.length;
      if (received > maxBody) {
        request.destroy();
        send(413, { error: "request body too large", limit: maxBody }, cors);
        return;
      }
      chunks.push(chunk);
    });
    request.on("end", () => {
      void (async () => {
        let message: unknown;
        try {
          message = JSON.parse(Buffer.concat(chunks).toString("utf8"));
        } catch (error) {
          send(400, { jsonrpc: "2.0", id: null, error: { code: -32700, message: "Parse error: " + (error as Error).message } }, cors);
          return;
        }
        const answers: JsonRpcResponse[] = [];
        const batch = Array.isArray(message) ? message : [message];
        for (const item of batch) {
          const answer = await server.handle(item);
          if (answer !== null) answers.push(answer);
        }
        if (answers.length === 0) {
          send(202, "", cors);
          return;
        }
        send(200, Array.isArray(message) ? answers : answers[0], cors);
      })().catch((error: unknown) => {
        log("mcp/http: " + (error as Error).message);
        send(500, { jsonrpc: "2.0", id: null, error: { code: -32603, message: "Internal error" } }, cors);
      });
    });
    request.on("error", () => {
      try {
        response.destroy();
      } catch {
        // The socket is already gone; there is nothing to report to.
      }
    });
  });

  await new Promise<void>((resolve, reject) => {
    httpServer.once("error", reject);
    httpServer.listen(port, host, () => {
      httpServer.removeListener("error", reject);
      resolve();
    });
  });

  const address = httpServer.address();
  const actualPort = typeof address === "object" && address !== null ? address.port : port;
  const displayHost = host === "0.0.0.0" || host === "::" ? "127.0.0.1" : host;

  return {
    url: "http://" + displayHost + ":" + actualPort + "/mcp",
    port: actualPort,
    host,
    token,
    close: () =>
      new Promise<void>((resolve) => {
        // An open SSE stream keeps `close()` waiting forever, and a shutdown that never finishes
        // is indistinguishable from a server that ignored the signal.
        for (const [, session] of sseSessions) {
          try {
            session.end();
          } catch {
            // The client may already be gone.
          }
        }
        sseSessions.clear();
        httpServer.close(() => resolve());
        httpServer.closeAllConnections();
      }),
  };
}
