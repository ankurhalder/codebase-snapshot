import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  enforceBudget,
  generateSnapshot,
  generateSnapshotAsync,
  resolveConfig,
} from "../dist/index.js";

/**
 * The after-generate hook and the byte bound, from the 0.9.12 audit.
 *
 * The hook is documented as the way to write your own artifact into the snapshot directory, and
 * the snapshot directory is only replaceable while `.codebase-snapshot` accounts for every file in
 * it. A hook that wrote a file and was not recorded therefore did not fail — it succeeded, and then
 * broke the *next* run, which refused the directory as foreign.
 */

function makeRepo(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "hook-budget-"));
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.mkdirSync(path.join(root, "src"), { recursive: true });
  fs.writeFileSync(path.join(root, "src", "a.ts"), "export const a = 1;\n");
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const configWithHook = (root, hook) =>
  resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", hooks: { afterGenerate: hook } },
    {},
    root
  );

const markerEntries = (root) =>
  JSON.parse(fs.readFileSync(path.join(root, "snapshot", ".codebase-snapshot"), "utf8")).entries;

test("an async hook's file is recorded, so the next run may replace the directory", async (t) => {
  const root = makeRepo(t);
  const config = configWithHook(root, async () => {
    await new Promise((resolve) => setTimeout(resolve, 20));
    fs.writeFileSync(path.join(root, "snapshot", "CUSTOM.md"), "written by the hook\n");
  });

  await generateSnapshotAsync(config);
  assert.ok(
    fs.existsSync(path.join(root, "snapshot", "CUSTOM.md")),
    "the async form must resolve only after the hook has finished"
  );
  assert.ok(
    markerEntries(root).includes("CUSTOM.md"),
    "the ownership marker must list what the hook wrote"
  );

  // The real consequence: a second run must be able to replace its own output.
  const again = await generateSnapshotAsync(config);
  assert.equal(again.validation.status, "passed");
});

test("a synchronous hook that resolves later in the same way is still recorded", async (t) => {
  // `generateSnapshot` cannot await, so the re-ship happens when the promise settles. This is the
  // path a caller of the synchronous API takes.
  const root = makeRepo(t);
  const config = configWithHook(root, async () => {
    await new Promise((resolve) => setTimeout(resolve, 10));
    fs.writeFileSync(path.join(root, "snapshot", "LATE.md"), "late\n");
  });

  generateSnapshot(config);
  await new Promise((resolve) => setTimeout(resolve, 60));
  assert.ok(markerEntries(root).includes("LATE.md"), "the marker caught up once the hook landed");
  assert.doesNotThrow(() => generateSnapshot(config), "and the directory is still replaceable");
});

test("a failing async hook is a warning, not a crash and not an unhandled rejection", async (t) => {
  const root = makeRepo(t);
  const config = configWithHook(root, async () => {
    await new Promise((resolve) => setTimeout(resolve, 5));
    throw new Error("hook blew up");
  });

  const manifest = await generateSnapshotAsync(config);
  assert.equal(manifest.validation.status, "passed", "the snapshot itself is fine");
  assert.ok(
    manifest.warnings.some((warning) => warning.includes("hooks.afterGenerate failed")),
    `the failure is recorded: ${JSON.stringify(manifest.warnings)}`
  );
  const shipped = JSON.parse(fs.readFileSync(path.join(root, "snapshot", "manifest.json"), "utf8"));
  assert.ok(
    shipped.warnings.some((warning) => warning.includes("hook blew up")),
    "and it reached the manifest on disk"
  );
});

test("a clipped part stays inside the budget its token line is rewritten into", () => {
  // The last-resort clip reserved room for the truncation marker but not for the token count that
  // is rewritten afterwards — or inserted, when the clip cut the header away. Where the reserve
  // does not cover both, the "guarantee" is a marker plus 30 bytes of bookkeeping over the ceiling.
  //
  // Swept rather than pinned to one number: `truncateToBytes` keeps a variable amount of a short
  // corpus, so the boundary is not a single budget. A real configuration cannot request budgets
  // this small (`--max-part-bytes` has a floor), which is exactly why the invariant is asserted
  // here on `enforceBudget` itself — the function says the byte bound is a guarantee, and it has to
  // hold at every budget it accepts. A budget too small to hold the notice at all is refused
  // rather than answered with a part that is bigger than its own ceiling.
  const MARKER = "\n... [part truncated: cannot fit budget] ...\n";
  const smallest = Buffer.byteLength(MARKER, "utf8") + 1;
  const header = "# Part 001\n\n- Files: 1\n\n## Contents\n";
  const body = Array.from({ length: 60 }, (_, index) => `- line ${index} ${"y".repeat(20)}`).join(
    "\n"
  );
  const markdown = `${header}${body}`;
  const partAt = (budget) => ({
    filename: "part-001.md",
    markdown,
    metadata: {
      index: 1,
      filename: "part-001.md",
      byteSize: Buffer.byteLength(markdown, "utf8"),
      estimatedTokens: 0,
      budgetBytes: budget,
      sha256: "placeholder",
      lines: 1,
      fileCount: 1,
      layersCovered: [],
      includedFiles: [],
    },
  });

  const over = [];
  for (let budget = smallest; budget <= 300; budget += 1) {
    const [clipped] = enforceBudget([partAt(budget)], budget);
    if (clipped.metadata.byteSize > budget) over.push(`${budget}: ${clipped.metadata.byteSize}`);
  }
  assert.deepEqual(over, [], "no budget may produce a part larger than itself");

  assert.throws(
    () => enforceBudget([partAt(smallest)], Buffer.byteLength(MARKER, "utf8") - 1),
    /cannot hold the truncation notice/,
    "a budget that cannot hold the notice is refused, not silently exceeded"
  );
});

test("every part of a real snapshot fits the budget it was built for", (t) => {
  const root = makeRepo(t);
  for (let index = 0; index < 40; index += 1) {
    fs.writeFileSync(
      path.join(root, "src", `file-${index}.ts`),
      `export const value${index} = "${"y".repeat(200)}";\n`.repeat(40)
    );
  }
  const manifest = generateSnapshot(
    resolveConfig(
      { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", maxPartBytes: 16384 },
      {},
      root
    )
  );
  const oversized = manifest.parts.filter((part) => part.byteSize > part.budgetBytes);
  assert.deepEqual(
    oversized.map((part) => `${part.filename}: ${part.byteSize} > ${part.budgetBytes}`),
    [],
    "the byte bound is a guarantee, not an aspiration"
  );
});
</file>

<file path="tests/init-force-and-scripts.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { loadConfigFileDetailed, runInit } from "../dist/index.js";

/**
 * Regression tests for three init defects:
 *   D-1 `--force` wrote a second config file that silently shadowed the existing one;
 *   D-6 a non-object `scripts` value was replaced without telling anyone;
 *   D-5 an unwritable target surfaced a raw `EPERM …` instead of a refusal.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "init-fix-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function writeProject(dir, packageJson = { name: "fixture", version: "1.0.0" }) {
  fs.writeFileSync(path.join(dir, "package.json"), `${JSON.stringify(packageJson, null, 2)}\n`);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n");
}

/** Every config filename the loader knows about that exists in `dir`. */
function configFiles(dir) {
  return [
    "snapshot.config.ts",
    "snapshot.config.js",
    "snapshot.config.mjs",
    "snapshot.config.cjs",
    "snapshot.config.json",
    ".snapshotrc.json",
    ".snapshotrc",
  ].filter((name) => fs.existsSync(path.join(dir, name)));
}

// ------------------------------------------------------------------------- D-1

test("D-1: --force over a JSON config refuses instead of shadowing it", async (t) => {
  const dir = tempDir(t);
  writeProject(dir);
  const jsonConfig = path.join(dir, "snapshot.config.json");
  fs.writeFileSync(jsonConfig, '{"outDir": "custom-out"}\n');

  await assert.rejects(runInit({ cwd: dir, yes: true, force: true }), /snapshot\.config\.json/);

  // Nothing was written beside it, and the user's file is untouched.
  assert.deepEqual(configFiles(dir), ["snapshot.config.json"]);
  assert.equal(fs.readFileSync(jsonConfig, "utf8"), '{"outDir": "custom-out"}\n');

  // The loader therefore sees exactly the one config the user wrote.
  const loaded = await loadConfigFileDetailed(dir);
  assert.equal(path.basename(loaded.file ?? ""), "snapshot.config.json");
  assert.deepEqual(loaded.errors, []);
});

test("D-1: --force rewrites the module config that is already present", async (t) => {
  const dir = tempDir(t);
  // ESM project: `chooseConfigFileName` prefers `snapshot.config.ts`, so keeping
  // the present `.mjs` is the observable part of the fix.
  writeProject(dir, { name: "fixture", version: "1.0.0", type: "module" });
  const mjs = path.join(dir, "snapshot.config.mjs");
  fs.writeFileSync(mjs, "export default { outDir: 'stale' };\n");

  const result = await runInit({ cwd: dir, yes: true, force: true });

  assert.equal(path.basename(result.configPath), "snapshot.config.mjs");
  assert.deepEqual(configFiles(dir), ["snapshot.config.mjs"], "exactly one config file");
  const written = fs.readFileSync(mjs, "utf8");
  assert.notEqual(written, "export default { outDir: 'stale' };\n", "the present file was rewritten");
  assert.match(written, /export default/);

  const loaded = await loadConfigFileDetailed(dir);
  assert.equal(path.basename(loaded.file ?? ""), "snapshot.config.mjs");
});

test("D-1: a clean project still writes exactly one config and loads it", async (t) => {
  const dir = tempDir(t);
  writeProject(dir);

  const result = await runInit({ cwd: dir, yes: true });

  assert.equal(result.written, true);
  assert.deepEqual(configFiles(dir), [path.basename(result.configPath)]);
  const loaded = await loadConfigFileDetailed(dir);
  assert.equal(loaded.file, result.configPath);
});

test("D-1: a pre-existing pair of configs is reported, not silently resolved", async (t) => {
  const dir = tempDir(t);
  writeProject(dir);
  fs.writeFileSync(path.join(dir, "snapshot.config.json"), '{"outDir": "json-out"}\n');
  fs.writeFileSync(path.join(dir, "snapshot.config.mjs"), "export default { outDir: 'mjs-out' };\n");

  // The `.json` is refused (a module config cannot be written there), and the
  // note names both files so the user knows which one wins today.
  await assert.rejects(runInit({ cwd: dir, yes: true, force: false }), /snapshot\.config\.ts|snapshot\.config\.json|snapshot\.config\.mjs/);

  const dry = await runInit({ cwd: dir, yes: true, force: true, dryRun: true });
  assert.ok(
    dry.notes.some((note) => /Multiple configuration files found/.test(note)),
    `notes must name the shadowing files: ${JSON.stringify(dry.notes)}`
  );
  assert.ok(dry.notes.some((note) => /snapshot\.config\.json/.test(note) && /snapshot\.config\.mjs/.test(note)));
});

// ------------------------------------------------------------------------- D-6

test("D-6: a string scripts value is reported, not silently replaced", async (t) => {
  const dir = tempDir(t);
  writeProject(dir, { name: "fixture", version: "1.0.0", scripts: "not-an-object" });

  const result = await runInit({ cwd: dir, yes: true });

  assert.ok(
    result.notes.some((note) => /"scripts" was a string, not an object/.test(note)),
    `the replacement must be reported: ${JSON.stringify(result.notes)}`
  );
  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(typeof pkg.scripts, "object");
  assert.equal(typeof pkg.scripts.snapshot, "string");
});

test("D-6: an array scripts value is reported the same way", async (t) => {
  const dir = tempDir(t);
  writeProject(dir, { name: "fixture", version: "1.0.0", scripts: [] });

  const result = await runInit({ cwd: dir, yes: true });

  assert.ok(
    result.notes.some((note) => /"scripts" was an array, not an object/.test(note)),
    JSON.stringify(result.notes)
  );
  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(typeof pkg.scripts.snapshot, "string");
});

test("D-6: an absent scripts field is added without a replacement note", async (t) => {
  const dir = tempDir(t);
  writeProject(dir);

  const result = await runInit({ cwd: dir, yes: true });

  assert.equal(
    result.notes.some((note) => /"scripts" was/.test(note)),
    false,
    "a missing field is not a replacement"
  );
  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(typeof pkg.scripts.snapshot, "string");
});

// ------------------------------------------------------------------------- D-5

test("D-5: an unwritable config path produces the tool's message, not a raw errno", async (t) => {
  const dir = tempDir(t);
  writeProject(dir);
  // A directory squatting on the config filename makes the write fail portably.
  const target = path.join(dir, "snapshot.config.mjs");
  fs.mkdirSync(target);

  await assert.rejects(
    runInit({ cwd: dir, yes: true, force: true }),
    (err) => {
      assert.match(err.message, /^Cannot write .*snapshot\.config\.mjs: /);
      assert.equal(/^(EPERM|EACCES|EISDIR|EROFS)/.test(err.message), false, err.message);
      return true;
    }
  );
});

test("D-5: a read-only directory reports permission denied", async (t) => {
  const dir = tempDir(t);
  writeProject(dir);
  try {
    fs.chmodSync(dir, 0o500);
  } catch {
    return; // platform refuses to change the mode; nothing to assert
  }

  try {
    let message = null;
    try {
      await runInit({ cwd: dir, yes: true });
    } catch (err) {
      message = err.message;
    }
    if (message === null) {
      // Windows does not enforce a read-only directory attribute for its owner.
      t.diagnostic("this platform lets the owner write into a 0o500 directory; case not exercised");
      return;
    }
    assert.match(message, /^Cannot write .*: (permission denied \((EACCES|EPERM)\)|.*)/);
    assert.equal(/^(EPERM|EACCES): /.test(message), false, "the raw errno prefix must not lead");
  } finally {
    fs.chmodSync(dir, 0o700);
  }
});

// ---------------------------------------------------------------- bug 1.5 (0.9.10)

test("init never makes the package depend on itself", async (t) => {
  const dir = tempDir(t);
  writeProject(dir, { name: "codebase-snapshot", version: "0.9.10" });

  const result = await runInit({ cwd: dir, yes: true });

  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(
    pkg.devDependencies,
    undefined,
    "a package cannot depend on itself: after a version bump npm install fails with ETARGET"
  );
  assert.equal(result.dependency.added, false);
  // `npx codebase-snapshot` would resolve the *published* release, so this repository
  // would be snapshotted by an older binary than the one being developed.
  assert.equal(pkg.scripts.snapshot, "node ./dist/bin.js generate");
  assert.equal(pkg.scripts["snapshot:validate"], "node ./dist/bin.js validate");
});

test("init reports a self-dependency it finds instead of silently keeping it", async (t) => {
  const dir = tempDir(t);
  writeProject(dir, {
    name: "codebase-snapshot",
    version: "0.9.10",
    devDependencies: { "codebase-snapshot": "^0.9.9" },
  });

  const result = await runInit({ cwd: dir, yes: true });

  assert.ok(
    result.notes.some((note) => /cannot depend on itself/.test(note)),
    `the contradiction must be reported: ${JSON.stringify(result.notes)}`
  );
  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(pkg.devDependencies["codebase-snapshot"], "^0.9.9", "the entry is left alone");
});
</file>

<file path="tests/init-interactive.test.js">
/**
 * The guided first run, driven without a real terminal.
 *
 * `runInit` takes its streams from `PromptIO`, and the prompt layer only needs two things
 * from them: `isTTY` and `keypress` events. A `PassThrough` with `isTTY` set therefore drives
 * the whole wizard, which is how the most important interaction of 0.9.2 — pressing enter on
 * the recommended setup — gets a test instead of a manual checklist.
 *
 * One key is released per prompt, on the prompt's own repaint (the `◆` header). Releasing keys
 * on any write would fire during the previous prompt's erase, land in a reader that is about
 * to close, and hang the run.
 */
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as path from "node:path";
import test from "node:test";

import { createWizardProject, driveWizard, findConfigName } from "./helpers/wizard-harness.js";

test("the recommended setup is one keystroke, and it says what it detected", async (t) => {
  const dir = createWizardProject(t, {
    files: {
      "package.json": '{"name":"app","version":"1.0.0"}\n',
      "next.config.ts": "export default {};\n",
      "src/a.ts": "export const a = 1;\n",
    },
  });

  const run = await driveWizard(dir, ["return"]);

  assert.match(run.screen, /Detected\s+nextjs/);
  assert.match(run.screen, /Because\s+next\.config\.ts/);
  assert.equal(run.result.written, true);
  assert.equal(run.result.preset, "nextjs");
  assert.equal(run.result.reason, "next.config.ts");
  assert.equal(run.result.fallback, false);
  assert.ok(findConfigName(dir), "a config was written");

  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(pkg.scripts.snapshot, "npx codebase-snapshot generate");
  assert.match(String(pkg.devDependencies["codebase-snapshot"]), /^\^\d+\.\d+\.\d+$/);
});

test("a project it cannot recognise is asked about, not guessed at", async (t) => {
  const dir = createWizardProject(t, { files: { "notes.md": "# notes\n" } });

  // The default on the preset list is `generic`, so this is "I cannot tell, use the fallback".
  const run = await driveWizard(dir, ["return", "return"]);

  assert.match(run.screen, /Could not tell what kind of project this is/);
  assert.match(run.screen, /No package\.json, go\.mod/);
  assert.equal(run.result.written, true);
  assert.equal(run.result.preset, "generic");
});

test("walking through every setting accepts a default at each step", async (t) => {
  const dir = createWizardProject(t, {
    files: {
      "package.json": '{"name":"app","version":"1.0.0"}\n',
      "src/a.ts": "export const a = 1;\n",
    },
  });

  // pace ↓⏎ · scope ⏎ · size ⏎ · artifacts ⏎ · credentials ⏎ · review ⏎
  const run = await driveWizard(dir, ["down", "return", "return", "return", "return", "return", "return"]);

  assert.match(run.screen, /What should go into the snapshot/);
  assert.match(run.screen, /How large should each part be/);
  assert.match(run.screen, /Which artifacts should be generated/);
  assert.match(run.screen, /Include credential files/);
  assert.match(run.screen, /Review/);
  assert.equal(run.result.written, true);
  assert.equal(run.result.preset, "node-lib");
  assert.equal(run.result.reason, "package.json");
});

test("the part-size question starts on the preset's recommended budget", async (t) => {
  const dir = createWizardProject(t, {
    files: {
      "package.json": '{"name":"app","version":"1.0.0"}\n',
      "next.config.ts": "export default {};\n",
      "src/a.ts": "export const a = 1;\n",
    },
  });

  // Walk through and accept everything: Next.js recommends 300 KB, so that is what gets written.
  const run = await driveWizard(dir, ["down", "return", "return", "return", "return", "return", "return"]);

  assert.equal(run.result.written, true);
  assert.equal(run.result.preset, "nextjs");
  const config = fs.readFileSync(path.join(dir, findConfigName(dir)), "utf8");
  assert.match(config, /300\s*\*\s*1024|307200|"300k"/, "the detected budget survived the wizard");
});
