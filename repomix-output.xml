  outputSchema: {
    type: "object",
    properties: {
      question: { type: "string" },
      budgetTokens: { type: "integer" },
      usedTokens: { type: "integer" },
      files: { type: "array", items: { type: "object" } },
      skipped: { type: "array", items: { type: "object" } },
      notes: { type: "array", items: { type: "string" } },
    },
  },
  annotations: READ_ONLY,
