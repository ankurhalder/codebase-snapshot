<file path="tests/ownership-evidence.test.js">
import assert from "node:assert/strict";
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot } from "../dist/index.js";

/**
 * 4.0.9 regression cover for ownership evidence.
 *
 * `.gitkeep` and `.gitignore` were subtracted from the foreign-entry set, so a snapshot directory
 * that this generator owned and that held a user's `.gitignore` was replaced — atomically, exit 0,
 * no warning — and the file was deleted. A directory that held nothing but those two was replaced
 * without any ownership evidence at all. Both are somebody's data; both now refuse.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-ownership-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

const generate = (dir, overrides = {}) => generateSnapshot({ cwd: dir, ...overrides });

const snapshotDir = (dir) => path.join(dir, "snapshot");

function sha256(buffer) {
  return crypto.createHash("sha256").update(buffer).digest("hex");
}

test("FS-02: a user's .gitignore inside an owned outDir is refused, not deleted", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generate(dir);

  const added = write(dir, "snapshot/.gitignore", "*\n");

  assert.throws(
    () => generate(dir),
    /Refusing to replace outDir/,
    "the run must refuse rather than replace the directory"
  );
  assert.ok(fs.existsSync(added), "the user's file survives");
  assert.equal(fs.readFileSync(added, "utf8"), "*\n");
  // The snapshot itself is untouched too: a refused run writes nothing.
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "manifest.json")));
});

test("FS-10: a directory holding only .gitkeep is refused, not replaced", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  fs.mkdirSync(path.join(dir, "snapshot"), { recursive: true });
  const keep = write(dir, "snapshot/.gitkeep", "");

  assert.throws(() => generate(dir), /Refusing to replace outDir/);
  assert.ok(fs.existsSync(keep), ".gitkeep survives");
});

test("FS-10: a directory holding only a .gitignore is refused, not replaced", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  fs.mkdirSync(path.join(dir, "snapshot"), { recursive: true });
  const ignore = write(dir, "snapshot/.gitignore", "*\n!.gitignore\n");

  assert.throws(() => generate(dir), /Refusing to replace outDir/);
  assert.equal(fs.readFileSync(ignore, "utf8"), "*\n!.gitignore\n");
});

test("FS-10: the refusal names the entry that stopped it", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  fs.mkdirSync(path.join(dir, "snapshot"), { recursive: true });
  write(dir, "snapshot/.gitkeep", "");

  assert.throws(() => generate(dir), /\.gitkeep/);
});

test(".DS_Store is still tolerated: Finder noise is not user data", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  fs.mkdirSync(path.join(dir, "snapshot"), { recursive: true });
  write(dir, "snapshot/.DS_Store", "noise");

  const manifest = generate(dir);

  assert.ok(manifest.files.some((file) => file.relativePath === "app.ts"));
  assert.ok(!fs.existsSync(path.join(dir, "snapshot", ".DS_Store")), "the noise file is gone");
});

test("a nested .DS_Store does not make the tool refuse its own output directory", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generate(dir);

  // What `open snapshot/` in Finder writes: the noise file lands in whatever directory the user
  // opened, so it appears at any depth. The ownership check compared the *full relative path*
  // against a set of basenames, so `reports/.DS_Store` read as a foreign entry and the next run
  // refused a directory this generator had written itself.
  write(dir, "snapshot/reports/.DS_Store", "noise");
  write(dir, "snapshot/parts/.DS_Store", "noise");

  const second = generate(dir);

  assert.ok(second.files.some((file) => file.relativePath === "app.ts"));
  assert.ok(!fs.existsSync(path.join(dir, "snapshot", "reports", ".DS_Store")));
  assert.ok(!fs.existsSync(path.join(dir, "snapshot", "parts", ".DS_Store")));
});

test("a foreign file at any depth is still refused, and named", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generate(dir);

  // The basename rule tolerates Finder noise, not a user's file that happens to sit one level down.
  write(dir, "snapshot/reports/notes.md", "mine");
  assert.throws(() => generate(dir), /Refusing to replace outDir/);
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "reports", "notes.md")));
});

test("a complete snapshot this build wrote is still replaced without complaint", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");

  const first = generate(dir);
  write(dir, "app.ts", "export const a = 2;\n");
  const second = generate(dir);

  assert.notEqual(first.fingerprint, second.fingerprint, "the second run really regenerated");
  assert.equal(second.counts?.files ?? second.files.length, 1);
});

test("an outDir holding only empty directories is replaced, not refused", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  // The state a killed run, an emptied snapshot or a hand-made skeleton leaves behind: `parts/` and
  // `reports/` with nothing in them. Refusing protected no data and blocked every later run.
  fs.mkdirSync(path.join(dir, "snapshot", "parts"), { recursive: true });
  fs.mkdirSync(path.join(dir, "snapshot", "reports", "deeper"), { recursive: true });

  const manifest = generate(dir);

  assert.ok(fs.existsSync(path.join(dir, "snapshot", "manifest.json")), "the run replaced it");
  assert.ok(manifest.counts.totalFiles > 0, "the snapshot was written");
});

test("an outDir holding any file is still refused without a marker", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "snapshot/parts/keep.md", "user notes\n");

  assert.throws(() => generate(dir), /Refusing to replace outDir/);
  assert.equal(fs.readFileSync(path.join(dir, "snapshot", "parts", "keep.md"), "utf8"), "user notes\n");
});

// ------------------------------------------------------------------ B7: evidence
// The marker used to be accepted on shape alone: generator name, schema version, a run id,
// state "complete" and a self-listing `entries` array. A hand-written marker therefore
// authorised deleting whatever was in the directory, which contradicts AGENTS.md ("a
// hand-written marker is not evidence"). Acceptance now also requires the per-file digest
// inventory a real run records, and a LEGACY marker (a snapshot written before that
// inventory existed) must carry a manifest digest that matches the manifest beside it, so
// upgrading never refuses the output directory a user already has.

function forgedMarker(files, overrides = {}) {
  return JSON.stringify(
    {
      generator: "codebase-snapshot",
      version: "0.9.14",
      schemaVersion: "3.0.0",
      createdAt: new Date().toISOString(),
      state: "complete",
      id: crypto.randomUUID(),
      entries: [".codebase-snapshot", ...files.map((file) => file.path)],
      ...overrides,
    },
    null,
    2
  ) + "\n";
}

test("B7: the forged marker with no manifest is refused, and nothing is deleted", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  const notes = "# my notes\n";
  const budget = "item,amount\ncoffee,3\n";
  write(dir, "user-docs/notes.md", notes);
  write(dir, "user-docs/budget.csv", budget);
  write(
    dir,
    "user-docs/.codebase-snapshot",
    forgedMarker([
      { path: "notes.md", bytes: Buffer.byteLength(notes) },
      { path: "budget.csv", bytes: Buffer.byteLength(budget) },
    ])
  );

  assert.throws(
    () => generate(dir, { outDir: "user-docs" }),
    /Refusing to replace outDir/,
    "a marker with no per-file digests is not ownership evidence"
  );
  assert.equal(fs.readFileSync(path.join(dir, "user-docs", "notes.md"), "utf8"), notes);
  assert.equal(fs.readFileSync(path.join(dir, "user-docs", "budget.csv"), "utf8"), budget);
  fs.rmSync(dir, { recursive: true, force: true });
});

test("B7: a legacy marker from a real snapshot is still replaced (upgrade path)", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generate(dir);

  // Simulate a snapshot written before the per-file inventory existed: the same marker,
  // minus the files[] field. Its manifest digest and entry list are still the ones a real
  // run wrote, so an upgraded build must accept it.
  const markerPath = path.join(snapshotDir(dir), ".codebase-snapshot");
  const marker = JSON.parse(fs.readFileSync(markerPath, "utf8"));
  assert.ok(Array.isArray(marker.files), "the new shape really carries the inventory");
  delete marker.files;
  fs.writeFileSync(markerPath, JSON.stringify(marker, null, 2) + "\n");

  // The first generate after an upgrade must not fail on the user's existing output.
  const second = generate(dir);
  assert.ok(second.counts.totalFiles > 0, "the legacy snapshot was replaced, not refused");
  assert.ok(
    fs.existsSync(path.join(snapshotDir(dir), "parts", "part-001.md")),
    "the replaced snapshot is whole"
  );
  const rewritten = JSON.parse(fs.readFileSync(markerPath, "utf8"));
  assert.ok(
    Array.isArray(rewritten.files) && rewritten.files.length > 0,
    "the replacing run writes the hardened shape, so later runs are already strict"
  );
  fs.rmSync(dir, { recursive: true, force: true });
});

test("B7: a hand-written inventory whose digests or byte lengths do not match is refused", (t) => {
  for (const forged of [
    { label: "wrong digest", digest: "0".repeat(64), bytes: null },
    { label: "wrong byte length", digest: null, bytes: 1 },
  ]) {
    const dir = tempDir(t);
    write(dir, "app.ts", "export const a = 1;\n");
    const notes = "# my notes\n";
    write(dir, "user-docs/notes.md", notes);
    write(
      dir,
      "user-docs/.codebase-snapshot",
      forgedMarker([{ path: "notes.md", bytes: Buffer.byteLength(notes) }], {
        files: [
          {
            path: "notes.md",
            bytes: forged.bytes ?? Buffer.byteLength(notes),
            sha256: forged.digest ?? sha256(Buffer.from(notes)),
          },
        ],
      })
    );

    assert.throws(
      () => generate(dir, { outDir: "user-docs" }),
      /Refusing to replace outDir/,
      `a marker with a ${forged.label} must not count as ownership`
    );
    assert.equal(
      fs.readFileSync(path.join(dir, "user-docs", "notes.md"), "utf8"),
      notes,
      "the user file survives"
    );
    fs.rmSync(dir, { recursive: true, force: true });
  }
});

test("B7: a real snapshot's marker records a digest for every file it wrote", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generate(dir);

  const marker = JSON.parse(
    fs.readFileSync(path.join(snapshotDir(dir), ".codebase-snapshot"), "utf8")
  );
  assert.ok(Array.isArray(marker.files) && marker.files.length > 0, "the marker records digests");
  assert.ok(
    marker.files.some((record) => record.path === "manifest.json"),
    "the manifest itself is in the inventory"
  );
  const filesOnDisk = marker.entries
    .filter((entry) => entry !== ".codebase-snapshot")
    .filter((entry) => fs.statSync(path.join(snapshotDir(dir), ...entry.split("/"))).isFile())
    .sort();
  assert.deepEqual(
    marker.files.map((record) => record.path).sort(),
    filesOnDisk,
    "every file the snapshot wrote has a digest, and nothing else does"
  );
  for (const record of marker.files) {
    const full = path.join(snapshotDir(dir), ...record.path.split("/"));
    const bytes = fs.readFileSync(full);
    assert.equal(record.bytes, bytes.length, `${record.path} byte length`);
    assert.equal(record.sha256, sha256(bytes), `${record.path} digest`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
});

test("B7: a new marker whose recorded digest no longer matches the part is refused", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generate(dir);

  const part = path.join(snapshotDir(dir), "parts", "part-001.md");
  fs.writeFileSync(part, "my own notes, not the tool's\n");

  assert.throws(
    () => generate(dir),
    /Refusing to replace outDir/,
    "bytes inside the snapshot changed, so the recorded evidence no longer matches"
  );
  assert.equal(fs.readFileSync(part, "utf8"), "my own notes, not the tool's\n");
  fs.rmSync(dir, { recursive: true, force: true });
});

test("B7: a real snapshot without manifest.json is still replaced", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");

  generate(dir, { artifacts: { manifest: false } });
  assert.equal(
    fs.existsSync(path.join(snapshotDir(dir), "manifest.json")),
    false,
    "the first run really wrote no manifest"
  );

  const second = generate(dir, { artifacts: { manifest: false } });
  assert.ok(second.counts.totalFiles > 0, "the legitimate no-manifest snapshot is replaceable");
  assert.ok(
    fs.existsSync(path.join(snapshotDir(dir), ".codebase-snapshot")),
    "the replacement snapshot has its own marker"
  );
  fs.rmSync(dir, { recursive: true, force: true });
});
</file>

<file path="tests/part-budget-and-numbering.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, partitionFiles, renumberParts, resolveConfig } from "../dist/index.js";

/**
 * Per-layer budgets, and the numbering that has to be decided before a part is rendered.
 *
 * The generator used to partition each budget separately and then re-number the merged set. A part
 * fitted to its budget grew by up to fourteen bytes in that rewrite (`- Previous: none` becomes
 * `- Previous: part-001.md`), and the byte bound was re-applied to the rewritten part afterwards.
 * Numbers and links are now decided once, before anything is rendered, so a part is built at the
 * size it will be published at.
 */

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "part-budget-"));
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

function readParts(root, manifest) {
  return manifest.parts.map((part) => ({
    part,
    text: fs.readFileSync(path.join(root, "snapshot", "parts", part.filename), "utf8"),
  }));
}

/** Every structural promise a part makes about itself, checked. */
function assertPartsAreCoherent(root, manifest) {
  const parts = readParts(root, manifest);

  assert.deepEqual(
    parts
      .filter(({ part }) => part.byteSize > part.budgetBytes)
      .map(({ part }) => `${part.filename}: ${part.byteSize} > ${part.budgetBytes}`),
    [],
    "every part fits the budget it was built for"
  );
  assert.deepEqual(
    parts
      .filter(({ text }) => text.includes("[part truncated"))
      .map(({ part }) => part.filename),
    [],
    "no part was cut to make room for its own header"
  );

  // Numbering is a gapless sequence, and the links form a chain through it.
  assert.deepEqual(
    manifest.parts.map((part) => part.index),
    manifest.parts.map((_, index) => index + 1),
    "indices are 1..n in order"
  );
  assert.deepEqual(
    manifest.parts.map((part) => part.filename),
    manifest.parts.map((_, index) => `part-${String(index + 1).padStart(3, "0")}.md`),
    "filenames follow the indices"
  );
  for (const [index, { text, part }] of parts.entries()) {
    const previous = index === 0 ? "none" : manifest.parts[index - 1].filename;
    const next = index === parts.length - 1 ? "none" : manifest.parts[index + 1].filename;
    assert.ok(text.includes(`- Previous: ${previous}`), `${part.filename}: previous link`);
    assert.ok(text.includes(`- Next: ${next}`), `${part.filename}: next link`);
    assert.ok(
      text.includes(`Part ${String(index + 1).padStart(3, "0")} of ${String(parts.length).padStart(3, "0")}`),
      `${part.filename}: "of n" counts the whole run, not one budget`
    );

    // Every section it advertises is really in it, and every file points back at it.
    for (const included of part.includedFiles) {
      assert.ok(
        text.includes(`### FILE: ${included.relativePath}`),
        `${part.filename} lists ${included.relativePath}`
      );
      const file = manifest.files.find((entry) => entry.relativePath === included.relativePath);
      assert.equal(file?.part, part.filename, `${included.relativePath} points back at its part`);
    }
    // And the section is whole: a clipped part loses its closing fence, which is what the
    // after-the-fact clamp used to produce.
    assert.match(text.trimEnd(), /`{4,}$/, `${part.filename} ends with its closing fence`);
  }

  const fileCount = manifest.parts.reduce((total, part) => total + part.fileCount, 0);
  assert.equal(fileCount, manifest.files.length, "every file is accounted for by exactly one part");
}

test("two budgets still produce one numbered sequence", (t) => {
  const files = {};
  for (let index = 0; index < 6; index += 1) {
    files[`src/module-${index}.ts`] = `export const value${index} = "${"s".repeat(240)}";\n`.repeat(6);
    files[`docs/page-${index}.md`] = `# Page ${index}\n\n${"prose line\n".repeat(12)}`;
  }
  const root = makeRepo(t, files);

  const config = resolveConfig(
    {
      cwd: root,
      outDir: "snapshot",
      tmpDir: "snapshot.tmp",
      discovery: "walk",
      budgets: { default: "16k", byLayer: { src: "8k" } },
      layers: [
        { name: "src", match: "src/**" },
        { name: "docs", match: "docs/**" },
      ],
      artifacts: { readme: false, navigation: false, projectTree: false, audit: false },
    },
    {},
    root
  );
  const manifest = generateSnapshot(config);

  assert.ok(manifest.parts.length > 2, `more than one budget really produced parts: ${manifest.parts.length}`);
  const budgets = new Set(manifest.parts.map((part) => part.budgetBytes));
  assert.deepEqual([...budgets].sort((a, b) => a - b), [8192, 16384], "each part kept its own budget");
  assertPartsAreCoherent(root, manifest);
});

test("a tight budget with many files keeps the same promises", (t) => {
  const files = {};
  for (let index = 0; index < 12; index += 1) {
    files[`src/file-${index}.ts`] = `export const value${index} = 1;\n`.repeat(40);
  }
  const root = makeRepo(t, files);
  const manifest = generateSnapshot(
    resolveConfig(
      { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk", maxPartBytes: 4096 },
      {},
      root
    )
  );
  assert.ok(manifest.parts.length > 1, "the budget really does split the run");
  assertPartsAreCoherent(root, manifest);
});

test("renumberParts still renumbers and re-links a merged set", (t) => {
  // Kept as a public function, and kept working: it is the only supported way to merge parts that
  // somebody else partitioned, and a caller that merges two single-part runs needs exactly this.
  const root = makeRepo(t, {
    "src/a.ts": "export const a = 1;\n",
    "src/b.ts": "export const b = 2;\n",
  });
  const config = resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk" },
    {},
    root
  );
  const first = generateSnapshot(config);
  const parts = first.parts.map((part) => ({
    filename: part.filename,
    markdown: fs.readFileSync(path.join(root, "snapshot", "parts", part.filename), "utf8"),
    metadata: part,
  }));
  assert.equal(parts.length, 1, "one part to start from");

  // The same part twice stands in for two separately partitioned halves.
  const merged = renumberParts([...parts, ...parts], first.fingerprint);
  assert.equal(merged.length, 2);
  assert.equal(merged[0].filename, "part-001.md");
  assert.equal(merged[1].filename, "part-002.md");
  assert.match(merged[0].markdown, /- Next: part-002\.md/);
  assert.match(merged[1].markdown, /- Previous: part-001\.md/);
  assert.match(merged[1].markdown, /Part 002 of 002/);
  for (const part of merged) {
    assert.equal(part.metadata.byteSize, Buffer.byteLength(part.markdown, "utf8"));
    assert.notEqual(part.metadata.sha256, "placeholder");
  }
});

test("partitionFiles alone still numbers from one and honours its budget", () => {
  // The single-bucket entry point is unchanged in behaviour, and it is what a library caller has.
  assert.deepEqual(partitionFiles([], 8192), [], "no files, no parts");
});

test("partitionFiles refuses a budget it cannot honour instead of clamping it", () => {
  // `Math.max(MIN_SECTION + HEADER, budget)` turned every budget below ~2.6 kB into that same
  // 2.6 kB, so a direct caller asking for 20 B got parts up to 130× larger with no error. Every
  // configuration surface already rejects a budget below 4096; the public function now does too.
  const entry = {
    relativePath: "src/a.ts",
    sizeBytes: 12,
    lines: 1,
    hashSha256: "a".repeat(64),
    part: "part-001.md",
    layer: "src",
    kind: "source",
    language: "typescript",
    inclusionMode: "full",
    isLarge: false,
    isPreviewTruncated: false,
    originalLines: 1,
    includedLines: 1,
    includedBytes: 12,
    content: "export const a = 1;\n",
  };
  for (const budget of [20, 46, 100, 1000, 2600]) {
    assert.throws(
      () => partitionFiles([entry], budget),
      /below the \d+ B minimum/,
      `a budget of ${budget} B must be refused`
    );
  }
  assert.throws(() => partitionFiles([entry], Number.POSITIVE_INFINITY), /finite number of bytes/);
  assert.equal(partitionFiles([entry], 8192).length, 1, "a legal budget still partitions");
});
</file>

<file path="tests/preset-detection-truth.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { detectPreset, generateSnapshot } from "../dist/index.js";

/**
 * F1 / F2: preset detection must honour two documented promises in
 * `docs/configuration.md#project-presets`:
 *
 *   - "a Next.js app inside a pnpm workspace is still `nextjs`, not `monorepo`"
 *   - the `docs` preset's "≥ 3 markdown files and no `package.json`"
 *
 * Detection stays bounded: a workspace root looks one level into its packages,
 * and the markdown count walks at most two directories down. These tests build
 * small fixtures on disk and call `detectPreset` directly — no generation.
 */

function makeRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "preset-truth-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(dir, relativePath, content = "") {
  const target = path.join(dir, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

const detect = (dir) => detectPreset(dir);

test("F1: a Next.js app one workspace level down detects as nextjs, not monorepo", (t) => {
  const dir = makeRepo(t);
  write(dir, "package.json", JSON.stringify({ name: "root", private: true, packageManager: "pnpm@9.0.0" }));
  write(dir, "pnpm-workspace.yaml", "packages:\n  - apps/*\n");
  write(dir, "apps/web/package.json", JSON.stringify({ name: "web", dependencies: { next: "14.0.0", react: "18.0.0" } }));
  write(dir, "apps/web/next.config.js", "module.exports = {};\n");
  write(dir, "apps/web/app/page.tsx", "export default function Page() { return null; }\n");

  const detected = detect(dir);
  assert.equal(detected.presetName, "nextjs");
  assert.equal(detected.recommendedBudget, "300k", "every preset recommends the one default");
});

test("F1: a workspace package with a Nuxt dependency detects as nuxt", (t) => {
  const dir = makeRepo(t);
  write(dir, "package.json", JSON.stringify({ name: "root", private: true }));
  write(dir, "pnpm-workspace.yaml", "packages:\n  - apps/*\n");
  write(dir, "apps/site/package.json", JSON.stringify({ name: "site", dependencies: { nuxt: "3.12.0" } }));

  assert.equal(detect(dir).presetName, "nuxt");
});

test("F1 control: a pnpm workspace without a framework app stays monorepo", (t) => {
  const dir = makeRepo(t);
  write(dir, "package.json", JSON.stringify({ name: "root", private: true }));
  write(dir, "pnpm-workspace.yaml", "packages:\n  - apps/*\n");
  write(dir, "apps/web/package.json", JSON.stringify({ name: "web" }));

  const detected = detect(dir);
  assert.equal(detected.presetName, "monorepo");
  assert.equal(detected.recommendedBudget, "300k");
});

test("F1 control: a root next.config.js still detects nextjs", (t) => {
  const dir = makeRepo(t);
  write(dir, "package.json", JSON.stringify({ name: "app", dependencies: { next: "14.0.0" } }));
  write(dir, "next.config.js", "module.exports = {};\n");

  assert.equal(detect(dir).presetName, "nextjs");
});

test("F2: markdown under docs/ counts towards the docs preset", (t) => {
  const dir = makeRepo(t);
  write(dir, "README.md", "# Project\n");
  write(dir, "docs/a.md", "# A\n");
  write(dir, "docs/b.md", "# B\n");
  write(dir, "docs/guide/c.md", "# C\n");

  const detected = detect(dir);
  assert.equal(detected.presetName, "docs");
  assert.equal(detected.recommendedBudget, "300k");
});

test("F2 control: fewer than three markdown files stays generic", (t) => {
  const dir = makeRepo(t);
  write(dir, "README.md", "# Project\n");
  write(dir, "docs/a.md", "# A\n");

  assert.equal(detect(dir).presetName, "generic");
});

test("F2 control: nested markdown with a package.json is not docs", (t) => {
  const dir = makeRepo(t);
  write(dir, "package.json", JSON.stringify({ name: "site", version: "1.0.0" }));
  write(dir, "README.md", "# Project\n");
  write(dir, "docs/a.md", "# A\n");
  write(dir, "docs/b.md", "# B\n");

  assert.equal(detect(dir).presetName, "node-lib");
});

test("F2 control: markdown inside node_modules or dist is not documentation", (t) => {
  const dir = makeRepo(t);
  write(dir, "README.md", "# Project\n");
  write(dir, "node_modules/pkg/README.md", "# dependency\n");
  write(dir, "dist/generated.md", "# build output\n");

  assert.equal(detect(dir).presetName, "generic");
});

// F2 regression: the tool's own output must never be counted as documentation.
// The markdown walk used to skip only the literal directory names `snapshot` and
// `snapshot.tmp`, so a custom `outDir` fed the previous run's README, parts and reports
// back into the docs preset's "three or more markdown files, no package.json" rule. A
// repository that detected as `generic` on run 1 detected as `docs` on run 2, which
// changed layers/kinds and even dropped a source `site/` directory.

test("F2 control: markdown in a tool-owned output directory is not documentation, whatever it is called", (t) => {
  const dir = makeRepo(t);
  write(dir, "main.c", "int main(void) { return 0; }\n");
  write(dir, "README.md", "# Project\n");
  // A previous run's output under a custom name: one real README plus parts and reports.
  for (const rel of [
    "README.md",
    "parts/part-001.md",
    "reports/audit.md",
    "reports/navigation.md",
    "reports/project-tree.md",
  ]) {
    write(dir, "context/" + rel, "# generated\n");
  }
  write(dir, "context/.codebase-snapshot", "{}");

  assert.equal(detect(dir).presetName, "generic");
});

test("F2 control: a tool-owned output directory two levels down is skipped too", (t) => {
  const dir = makeRepo(t);
  write(dir, "main.c", "int main(void) { return 0; }\n");
  write(dir, "README.md", "# Project\n");
  for (const rel of ["a.md", "b.md", "c.md"]) write(dir, "tools/context/" + rel, "# generated\n");
  write(dir, "tools/context/.codebase-snapshot", "{}");

  assert.equal(detect(dir).presetName, "generic");
});

test("F2 control: markdown in a plain directory is still documentation", (t) => {
  const dir = makeRepo(t);
  write(dir, "README.md", "# Project\n");
  for (const rel of ["a.md", "b.md", "c.md"]) write(dir, "generated/" + rel, "# notes\n");

  assert.equal(detect(dir).presetName, "docs", "the skip must require ownership evidence, not a name");
});

test("F2: a custom outDir does not change the preset or the parts on the second run", (t) => {
  const dir = makeRepo(t);
  write(dir, "main.c", "int main(void) { return 0; }\n");
  write(dir, "README.md", "# Project\n");
  write(dir, "site/page.md", "# A source page that is not the snapshot\n");

  const first = generateSnapshot({ cwd: dir, outDir: "context" });
  assert.equal(first.config.preset, "generic", "the first run has no output to mistake for docs");
  assert.ok(
    first.files.some((file) => file.relativePath === "site/page.md"),
    "the source page is in the first snapshot"
  );
  const partsFirst = fs
    .readdirSync(path.join(dir, "context", "parts"))
    .sort()
    .map((name) => fs.readFileSync(path.join(dir, "context", "parts", name)));

  const second = generateSnapshot({ cwd: dir, outDir: "context" });
  assert.equal(second.config.preset, "generic", "the tool's own output must not trigger the docs preset");
  assert.ok(
    second.files.some((file) => file.relativePath === "site/page.md"),
    "the docs preset's site/ exclusion must not fire on the second run"
  );
  assert.equal(second.fingerprint, first.fingerprint, "unchanged input keeps the fingerprint");
  const partsSecond = fs
    .readdirSync(path.join(dir, "context", "parts"))
    .sort()
    .map((name) => fs.readFileSync(path.join(dir, "context", "parts", name)));
  assert.deepEqual(partsSecond, partsFirst, "parts are byte-identical across runs");
});

test("F2: an absolute outDir inside the repository is excluded by the same evidence", (t) => {
  const dir = makeRepo(t);
  write(dir, "main.c", "int main(void) { return 0; }\n");
  write(dir, "README.md", "# Project\n");
  const outDir = path.join(dir, "llm-context");

  const first = generateSnapshot({ cwd: dir, outDir });
  assert.equal(first.config.preset, "generic");
  const second = generateSnapshot({ cwd: dir, outDir });
  assert.equal(second.config.preset, "generic", "an absolute outDir must be skipped like a relative one");
  assert.equal(second.fingerprint, first.fingerprint);
});
</file>

<file path="tests/redaction-json-keys.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import { DEFAULT_SECRET_PATTERNS, scanAndRedactSecrets } from "../dist/index.js";

/**
 * Quoted JSON/YAML keys whose name ends in a credential word.
 *
 * The 0.9.x rule matched a credential name as a *tail* of a bare key (`dbPassword:`) but its
 * quoted-key alternative required the whole quoted string to be the credential word, so only
 * `"password"` matched. The spelling every JSON config uses — `"dbPassword"`, `"discordToken"`,
 * `"awsSecret"`, `"sessionKey"` — reached `parts/*.md` with the value in clear, while the same
 * field spelled without quotes was masked. These fixtures are the 1.0.0 audit's proof.
 */

const scan = (content, filePath = "config.json") =>
  scanAndRedactSecrets(content, DEFAULT_SECRET_PATTERNS, filePath);

const assertMaskedKeepingKey = (line, secret, key, filePath) => {
  const { redacted, findings } = scan(line, filePath);
  assert.ok(findings.length > 0, `${JSON.stringify(line)}: a finding is expected`);
  assert.equal(
    redacted.includes(secret),
    false,
    `${JSON.stringify(line)}: the value must not survive: ${JSON.stringify(redacted)}`
  );
  assert.ok(
    redacted.includes(key),
    `${JSON.stringify(line)}: the key is readable context and must be kept`
  );
};

const assertUntouched = (line, filePath = "config.json") => {
  const { redacted } = scan(line, filePath);
  assert.equal(redacted, line, `${JSON.stringify(line)} must survive verbatim`);
};

test("a quoted camelCase key with a quoted value is masked, and the key survives", () => {
  const cases = [
    ['{"dbPassword": "hunter2"}', "hunter2", '"dbPassword"'],
    ['{"discordToken": "opaqueTokenValue123"}', "opaqueTokenValue123", '"discordToken"'],
    ['{"botToken": "opaqueBotToken456789"}', "opaqueBotToken456789", '"botToken"'],
    ['{"awsSecret": "opaqueAwsSecretValue"}', "opaqueAwsSecretValue", '"awsSecret"'],
    ['{"appSecret": "opaqueAppSecretValue"}', "opaqueAppSecretValue", '"appSecret"'],
    ['{"jwtSecret": "opaqueJwtSecretValue"}', "opaqueJwtSecretValue", '"jwtSecret"'],
    ['{"sessionKey": "opaqueSessionKey12345"}', "opaqueSessionKey12345", '"sessionKey"'],
    ['{"my_api_key": "abcdef12345678"}', "abcdef12345678", '"my_api_key"'],
    ['  "clientSecret": "opaqueClientSecret76",', "opaqueClientSecret76", '"clientSecret"'],
    ['"refreshToken": "opaqueRefreshToken123",', "opaqueRefreshToken123", '"refreshToken"'],
  ];
  for (const [line, secret, key] of cases) assertMaskedKeepingKey(line, secret, key);
});

test("an indented JSON object loses every credential value and keeps its keys", () => {
  const block = [
    "{",
    '  "name": "service",',
    '  "dbPassword": "hunter2",',
    '  "discordToken": "opaqueTokenValue123",',
    '  "awsSecret": "opaqueAwsSecretValue",',
    '  "sessionKey": "opaqueSessionKey12345",',
    '  "jwtSecret": "opaqueJwtSecretValue"',
    "}",
  ].join("\n");
  const { redacted, findings } = scan(block);
  assert.ok(findings.length >= 5, "each credential line is one finding");
  for (const secret of [
    "hunter2",
    "opaqueTokenValue123",
    "opaqueAwsSecretValue",
    "opaqueSessionKey12345",
    "opaqueJwtSecretValue",
  ]) {
    assert.equal(redacted.includes(secret), false, `${secret} must not survive:\n${redacted}`);
  }
  for (const key of ['"dbPassword"', '"discordToken"', '"awsSecret"', '"sessionKey"', '"jwtSecret"']) {
    assert.ok(redacted.includes(key), `${key} must stay readable:\n${redacted}`);
  }
});

test("a quoted key with an unquoted YAML value is masked (the JSON/YAML split does not matter)", () => {
  assertMaskedKeepingKey('"dbPassword": hunter2hunter2', "hunter2hunter2", '"dbPassword"', "config.yaml");
  assertMaskedKeepingKey("dbPassword: hunter2hunter2", "hunter2hunter2", "dbPassword", "config.yaml");
});

test("keys that merely contain or extend a credential word are not credentials", () => {
  assertUntouched('  "maxTokens": 512,');
  assertUntouched('{"tokenType": "bearer"}');
  assertUntouched('{"passwordless": "true"}');
  assertUntouched('{"tokenizer": "cl100k_base"}');
  assertUntouched('{"secretary": "front desk"}');
  assertUntouched('  "description": "the password is stored elsewhere",');
  // Values that are numbers or references are not credentials, even under a credential key.
  assertUntouched('  { "apiKey": 1, "password": 2 },');
});

test("the key-name list and self-naming constant shapes still survive", () => {
  assertUntouched('for (const key of ["awsSecret:", "apiKey:", "dbPassword:", "token:", "normal:"]) {');
  assertUntouched("const names = ['password:', 'secret:'];");
  assertUntouched('  "access_token:",');
  assertUntouched('  progressToken: "progressToken",', "fixture.ts");
});
</file>

<file path="tests/site-anchors.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

import { addHeadingIds, headingSlug, renderMarkdown, renderPages } from "../scripts/build-site.mjs";
import { findAnchorProblems } from "../scripts/check-site-links.mjs";

/**
 * The docs site shipped with every table-of-contents link dead.
 *
 * `marked` renders a heading as a plain `<h2>text</h2>`, and the site builder published that
 * as-is, while the prose was written for GitHub, where every heading gets an anchor. All 49
 * in-page and cross-page `#fragment` links on the 15 pages therefore pointed at nothing, and the
 * link checker passed them because it only asked whether a target file existed. These tests pin
 * both halves of the fix: the ids match the ones GitHub mints, and every anchor in the real
 * documentation resolves against them.
 */

test("heading ids follow GitHub's heading-anchor rules", () => {
  const table = [
    ["## Commands", "commands"],
    ["## Project presets", "project-presets"],
    ["## A file is missing from the snapshot", "a-file-is-missing-from-the-snapshot"],
    ["### `validate` / `check`", "validate--check"],
    ["### `diff <before> <after>`", "diff-before-after"],
    ["### `skipped[]`", "skipped"],
    ["## Exit code 2 — the command itself was wrong", "exit-code-2--the-command-itself-was-wrong"],
    ["### `Refusing to replace outDir …`", "refusing-to-replace-outdir-"],
  ];
  for (const [markdown, id] of table) {
    assert.match(renderMarkdown(`${markdown}\n`), new RegExp(`<h[1-6][^>]* id="${id}">`), markdown);
  }
});

test("headingSlug keeps what GitHub keeps and strips the rest", () => {
  assert.equal(headingSlug("Version 1.2.3"), "version-123");
  assert.equal(headingSlug("snake_case"), "snake_case");
  assert.equal(headingSlug("--mode"), "--mode");
  assert.equal(headingSlug("Café"), "café");
});

test("repeated headings get the -1 and -2 suffixes GitHub uses", () => {
  const ids = [
    ...renderMarkdown("## Example\n\n## Example\n\n## Example\n").matchAll(/<h2 id="([^"]+)"/g),
  ].map((match) => match[1]);
  assert.deepEqual(ids, ["example", "example-1", "example-2"]);
});

test("an explicit id is preserved and generated ids avoid it", () => {
  const html = addHeadingIds('<h2 id="kept">Kept</h2>\n<h2>Kept</h2>\n');
  assert.match(html, /<h2 id="kept">Kept<\/h2>/);
  assert.match(html, /<h2 id="kept-1">Kept<\/h2>/);
});

test("a fragment no element declares is reported with its page and href", () => {
  const pages = new Map([
    ["a.html", '<h2 id="present">Present</h2><a href="#missing">x</a><a href="#present">y</a>'],
    ["b.html", '<p><a href="a.html#missing">z</a></p>'],
  ]);
  const { checked, problems } = findAnchorProblems(pages);
  assert.equal(checked, 3);
  assert.deepEqual(problems, [
    'a.html -> #missing (a.html has no element with id "missing")',
    'b.html -> a.html#missing (a.html has no element with id "missing")',
  ]);
});

test("a duplicate id is reported once", () => {
  const { problems } = findAnchorProblems(
    new Map([["dup.html", '<h2 id="x">One</h2><h2 id="x">Two</h2>']])
  );
  assert.deepEqual(problems, ['dup.html: duplicate id "x"']);
});

test("every anchor in the published documentation resolves", () => {
  const pages = new Map(renderPages().map((rendered) => [`${rendered.slug}.html`, rendered.html]));
  const { checked, problems } = findAnchorProblems(pages);
  assert.deepEqual(problems, []);
  assert.ok(checked > 40, `only ${checked} anchors were checked`);
});

test("every image on a rendered page resolves to a file the site build copies", () => {
  const here = path.dirname(fileURLToPath(import.meta.url));
  const assets = new Set(
    fs.readdirSync(path.join(here, "..", "docs", "assets")).filter((name) => /\.(svg|png|ico)$/.test(name))
  );

  const broken = [];
  for (const page of renderPages()) {
    for (const match of page.html.matchAll(/(?:src|href)="([^"]+)"/g)) {
      const target = match[1];
      if (/^(?:https?:|mailto:|data:|#)/.test(target)) continue;
      if (!/^assets\//.test(target)) continue;
      const name = target.replace(/^assets\//, "");
      if (!assets.has(name)) broken.push(`${page.slug}: ${target}`);
    }
  }
  assert.deepEqual(broken, [], "an image path the build does not copy is a 404 on the live site");
});

test("no page references a repository asset path the site does not serve", () => {
  // The two dead assets on the published site were both `src` attributes pointing at
  // `docs/assets/…`: the builder stripped the raw-URL prefix but never rewrote the directory to
  // `assets/`, and the link gate read only `href`. Both halves are pinned here.
  for (const page of renderPages()) {
    assert.doesNotMatch(
      page.html,
      /(?:src|href)="docs\/assets\//,
      `${page.slug} points at a path the site does not serve`
    );
  }
});
</file>

<file path="tests/temp-hygiene.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as path from "node:path";
import test from "node:test";

import { REPO_ROOT, runSuite } from "../scripts/test-run.mjs";
import { makeTempDir } from "./helpers/temp.js";

/**
 * The suite's own hygiene: a test may not create a scratch directory it never
 * removes, the command that runs the suite must confine the temp environment to a
 * root it deletes, and a leak that does happen must not survive the run.
 *
 * This exists because 616 leftover directories (about 600 MB) had accumulated in
 * the host temp directory. `agent-simulation.test.js` made two fixtures per run
 * and registered no cleanup, so every `npm test` left two more behind.
 */

const TESTS_DIR = path.join(REPO_ROOT, "tests");
const CLEANS_UP = /\b(?:rmSync|removeTree|makeTempDir)\s*\(/;

function javascriptFiles(dir) {
  const out = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) out.push(...javascriptFiles(full));
    else if (entry.name.endsWith(".js")) out.push(full);
  }
  return out;
}

test("no test creates a scratch directory it never removes", () => {
  const offenders = javascriptFiles(TESTS_DIR).filter((file) => {
    const text = fs.readFileSync(file, "utf8");
    return text.includes("mkdtempSync(") && !CLEANS_UP.test(text);
  });
  assert.deepEqual(
    offenders.map((file) => path.relative(REPO_ROOT, file)),
    [],
    "these files create a temp directory without removing it; use makeTempDir(t, prefix) from tests/helpers/temp.js"
  );
});

test("npm test runs the suite through the scratch-root wrapper", () => {
  const pkg = JSON.parse(fs.readFileSync(path.join(REPO_ROOT, "package.json"), "utf8"));
  assert.match(pkg.scripts.test, /scripts\/test-run\.mjs/, "npm test must use the wrapper");
  assert.match(
    pkg.scripts["test:coverage"],
    /scripts\/test-run\.mjs/,
    "coverage runs must use the wrapper too"
  );
});

test("a scratch directory a child test leaves behind dies with the run", async (t) => {
  const project = makeTempDir(t, "cbs-hygiene-");
  // A .mjs name is ESM on every supported Node version. A .js file outside a
  // package is CommonJS on Node 18, so the child would fail on these imports and
  // the test would pass for the wrong reason on a newer runtime.
  const leaky = path.join(project, "leaky.test.mjs");
  fs.writeFileSync(
    leaky,
    [
      'import * as fs from "node:fs";',
      'import * as os from "node:os";',
      'import * as path from "node:path";',
      'import test from "node:test";',
      'test("leaves a scratch directory behind", () => {',
      '  fs.mkdtempSync(path.join(os.tmpdir(), "leaked-"));',
      "});",
      "",
    ].join("\n")
  );
  const result = await runSuite({ files: [leaky], cwd: project, stdio: "ignore" });
  assert.equal(result.code, 0, "the child suite passes");
  assert.ok(result.leftovers >= 1, "the child's directory landed inside the run's scratch root");
  assert.equal(result.removed, true, "the scratch root is removed");
  assert.equal(fs.existsSync(result.scratch), false, "nothing from the run remains");
});

test("the fixture-heavy generation suite leaves no scratch behind", async () => {
  // This file made one fixture per run with no cleanup: a single forgotten `repo()`
  // argument grew the host temp directory by a directory on every run. Run the file
  // in the wrapper and count what it leaves — the same count a leak would accumulate.
  const result = await runSuite({ files: ["tests/generation-truth.test.js"], stdio: "ignore" });
  assert.equal(result.code, 0, "the file passes on its own");
  assert.equal(
    result.leftovers,
    0,
    "every fixture that file created was removed; a leftover would grow on every run"
  );
  assert.equal(result.removed, true, "the scratch root is removed");
});
