<file path="src/ast/profiles/protobuf.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary } from "./shared.js";

/**
 * Protocol Buffers: messages, enums, services and their RPCs.
 *
 * A `.proto` file is an interface definition, so `message` lands in `classes`, `service` in
 * `interfaces` and each `rpc` in `functions` — the same mapping a `.d.ts` gets, which is what
 * lets an agent read a service and its TypeScript client as the same shape.
 *
 * Fields are deliberately not collected: a message with forty fields would bury the
 * structure the summary exists to show, and the body is in the part anyway.
 */
const DECLARATION = /^(?:message|enum|service|extend)\s+([A-Za-z_]\w*)/;
const RPC = /^\s*rpc\s+([A-Za-z_]\w*)/;
const IMPORT = /^\s*import\s+(?:public\s+|weak\s+)?"([^"]+)"/;
const PACKAGE = /^\s*package\s+([\w.]+)\s*;/;

export const protobufProfile: LanguageProfile = {
  id: "protobuf",
  extensions: [".proto"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("//")) return;

      const imported = IMPORT.exec(line);
      if (imported) {
        summary.imports.push(imported[1]);
        return;
      }

      const pkg = PACKAGE.exec(line);
      if (pkg) {
        summary.directives.push(`package ${pkg[1]}`);
        return;
      }

      const rpc = RPC.exec(line);
      if (rpc) {
        const name = (rpc as RegExpExecArray & [string, string])[1];
        summary.functions.push(name);
        return;
      }

      const declaration = DECLARATION.exec(trimmed);
      if (!declaration) return;
      const name = (declaration as RegExpExecArray & [string, string])[1];
      const keyword = /^\w+/.exec(trimmed)?.[0] ?? "";
      if (keyword === "service") summary.interfaces.push(name);
      else if (keyword === "enum") summary.enums.push(name);
      else summary.classes.push(name);
      summary.exports.push(name);
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/rust.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isTopLevel } from "./shared.js";

const USE = /^use\s+([^;]+);/;
const FN = /^(pub(?:\([^)]*\))?\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+([A-Za-z_]\w*)/;
const STRUCT = /^(pub(?:\([^)]*\))?\s+)?struct\s+([A-Za-z_]\w*)/;
const TRAIT = /^(pub(?:\([^)]*\))?\s+)?(?:unsafe\s+)?trait\s+([A-Za-z_]\w*)/;
const ENUM = /^(pub(?:\([^)]*\))?\s+)?enum\s+([A-Za-z_]\w*)/;
const TYPE = /^(pub(?:\([^)]*\))?\s+)?type\s+([A-Za-z_]\w*)/;
const MOD = /^(pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_]\w*)/;
const IMPL = /^impl(?:<[^>]*>)?\s+(?:[\w:<>]+\s+for\s+)?([A-Za-z_]\w*)/;

/**
 * Rust: `use` paths, functions, structs, traits, enums, type aliases, modules
 * and `impl` targets. `pub` is the visibility marker.
 */
export const rustProfile: LanguageProfile = {
  id: "rust",
  extensions: [".rs"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("//")) return;

      const used = USE.exec(trimmed);
      if (used) {
        summary.imports.push(used[1].trim());
        return;
      }

      if (!isTopLevel(line)) return;

      const isPublic = /^pub\b/.test(trimmed);

      const fn = FN.exec(line);
      if (fn) {
        summary.functions.push(fn[2]);
        if (isPublic) summary.exports.push(fn[2]);
        return;
      }

      const struct = STRUCT.exec(line);
      if (struct) {
        summary.classes.push(struct[2]);
        if (isPublic) summary.exports.push(struct[2]);
        return;
      }

      const trait = TRAIT.exec(line);
      if (trait) {
        summary.interfaces.push(trait[2]);
        if (isPublic) summary.exports.push(trait[2]);
        return;
      }

      const enumeration = ENUM.exec(line);
      if (enumeration) {
        summary.enums.push(enumeration[2]);
        if (isPublic) summary.exports.push(enumeration[2]);
        return;
      }

      const alias = TYPE.exec(line);
      if (alias) {
        summary.types.push(alias[2]);
        if (isPublic) summary.exports.push(alias[2]);
        return;
      }

      const module = MOD.exec(line);
      if (module) {
        summary.variables.push(module[2]);
        if (isPublic) summary.exports.push(module[2]);
        return;
      }

      const implementation = IMPL.exec(line);
      if (implementation) summary.classes.push(implementation[1]);
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/shared.ts">
import type { SourceSummary } from "../../types.js";

/**
 * How much of a file a heuristic summarizer will scan.
 *
 * The summaries are line-oriented: a multi-megabyte file would spend the whole
 * run in regexes for no benefit, and the part body is byte-budgeted anyway.
 */
export const MAX_SUMMARY_CHARS = 1_000_000;

export interface HeuristicResult {
  summary: SourceSummary;
  /**
   * `ast` only when a real parser produced this (TypeScript, and the script
   * block of a Vue/Svelte/Astro component). Everything else is `heuristic`, and
   * the manifest says so — a line-scan is not a parse.
   */
  quality: "ast" | "heuristic";
}

export interface LanguageProfile {
  readonly id: string;
  readonly extensions: readonly string[];
  summarize(path: string, content: string): HeuristicResult;
}

export function emptySummary(): SourceSummary {
  return {
    directives: [],
    imports: [],
    exports: [],
    reExports: [],
    functions: [],
    classes: [],
    interfaces: [],
    types: [],
    enums: [],
    variables: [],
    reactComponents: [],
    hooks: [],
    routeHandlers: [],
  };
}

function dedupeSorted(values: string[]): string[] {
  return Array.from(new Set(values.filter(Boolean))).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
}

/** Deduplicates and sorts every bucket, so summaries are deterministic. */
export function finalizeSummary(summary: SourceSummary): SourceSummary {
  return {
    directives: dedupeSorted(summary.directives),
    imports: dedupeSorted(summary.imports),
    exports: dedupeSorted(summary.exports),
    reExports: dedupeSorted(summary.reExports),
    functions: dedupeSorted(summary.functions),
    classes: dedupeSorted(summary.classes),
    interfaces: dedupeSorted(summary.interfaces),
    types: dedupeSorted(summary.types),
    enums: dedupeSorted(summary.enums),
    variables: dedupeSorted(summary.variables),
    reactComponents: dedupeSorted(summary.reactComponents),
    hooks: dedupeSorted(summary.hooks),
    routeHandlers: dedupeSorted(summary.routeHandlers),
  };
}

/** Visits each line, bounded by {@link MAX_SUMMARY_CHARS}. */
export function eachLine(content: string, visit: (line: string) => void): void {
  const text = content.length > MAX_SUMMARY_CHARS ? content.slice(0, MAX_SUMMARY_CHARS) : content;
  for (const line of text.split(/\r?\n/)) visit(line);
}

/** True when the line starts in column zero (a top-level declaration). */
export function isTopLevel(line: string): boolean {
  return !/^[\s]/.test(line);
}

/** A leading lowercase or `_` means "not public" in Python, Ruby and PHP. */
export function isPublicName(name: string): boolean {
  return name.length > 0 && !name.startsWith("_") && /^[A-Za-z]/.test(name);
}

/** Go and Rust: a capitalised identifier is exported. */
export function isCapitalizedName(name: string): boolean {
  return /^[A-Z]/.test(name);
}
</file>

<file path="src/ast/profiles/sql.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary } from "./shared.js";

/**
 * SQL: the objects a migration or schema file creates.
 *
 * A `.sql` file is not a program with functions in it, it is a set of definitions — so
 * tables and views are recorded as classes (the nouns of the schema), routines as functions,
 * and every created object as an export, because creating it is the file's whole effect.
 *
 * The match is case-insensitive: `create table`, `CREATE TABLE` and `Create Table` all occur
 * in the wild, and a schema dump is Windows-friendly about it.
 */
const CREATE =
  /^\s*CREATE\s+(?:OR\s+REPLACE\s+)?(?:TEMP(?:ORARY)?\s+)?(TABLE|VIEW|MATERIALIZED\s+VIEW|FUNCTION|PROCEDURE|INDEX|TYPE|SCHEMA|TRIGGER|SEQUENCE)\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_"][\w."]*)/i;
const ALTER = /^\s*ALTER\s+(TABLE|VIEW)\s+(?:IF\s+EXISTS\s+)?([A-Za-z_"][\w."]*)/i;

/** Strips the parts of a qualified, quoted identifier: `public."Users"` → `Users`. */
function bareName(identifier: string): string {
  const last = identifier.split(".").pop() ?? identifier;
  return last.replace(/["`[\]]/g, "");
}

export const sqlProfile: LanguageProfile = {
  id: "sql",
  extensions: [".sql"],
  summarize(_path, content) {
    const summary = emptySummary();
    const seen = new Set<string>();

    /** Records a definition once, however many statements name it. */
    const declare = (kind: string, identifier: string): void => {
      const name = bareName(identifier);
      if (!name || seen.has(`${kind}:${name}`)) return;
      seen.add(`${kind}:${name}`);
      const normalized = kind.toUpperCase().replace(/\s+/g, " ");
      if (normalized === "TABLE" || normalized.endsWith("VIEW")) summary.classes.push(name);
      else if (normalized === "TYPE" || normalized === "SCHEMA" || normalized === "SEQUENCE") {
        summary.types.push(name);
      } else summary.functions.push(name);
      summary.exports.push(name);
    };

    eachLine(content, (line) => {
      const trimmed = line.trim();
      // `--` is the line comment; a block comment is rare enough in a definitions file that
      // treating its contents as statements would do more harm than ignoring it.
      if (!trimmed || trimmed.startsWith("--")) return;

      const created = CREATE.exec(trimmed);
      if (created) {
        declare(String(created[1]), String(created[2]));
        return;
      }
      // A second migration that alters an existing table is where the definition now lives,
      // so an ALTER names the same object the CREATE would have.
      const altered = ALTER.exec(trimmed);
      if (altered) declare(String(altered[1]), String(altered[2]));
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/terraform.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary } from "./shared.js";

/**
 * Terraform and HCL.
 *
 * The unit of a Terraform file is a block, so each block is one entry: `resource` and `data`
 * blocks are the infrastructure (classes), `variable` and `locals` are the inputs,
 * `output` is what the module publishes, and `module` is a dependency — recorded as an
 * import, because that is what it is.
 *
 * Blocks are named `type.name` because both halves are load-bearing: two `aws_instance`
 * resources in one file are different things, and a summary that listed only the type would
 * describe neither of them.
 */
const BLOCK = /^\s*(resource|data|module|provider|variable|output|locals|terraform)\b\s*("([^"]+)")?\s*("([^"]+)")?/;
const TERRAFORM_VERSION = /^\s*required_version\s*=\s*"([^"]+)"/;

export const terraformProfile: LanguageProfile = {
  id: "terraform",
  extensions: [".tf", ".tfvars"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("#") || trimmed.startsWith("//")) return;

      const version = TERRAFORM_VERSION.exec(line);
      if (version) {
        summary.directives.push(`required_version ${version[1]}`);
        return;
      }

      // A `.tfvars` file is `name = value` assignments, not blocks.
      if (/^[A-Za-z_][\w-]*\s*=/.test(trimmed)) {
        summary.variables.push(/^([A-Za-z_][\w-]*)/.exec(trimmed)?.[1] ?? trimmed);
        return;
      }

      const block = BLOCK.exec(line);
      if (!block) return;
      const keyword = block[1] as string;
      const first = block[3];
      const second = block[5];

      switch (keyword) {
        case "resource":
        case "data": {
          if (!first || !second) return;
          const name = `${first}.${second}`;
          summary.classes.push(name);
          summary.exports.push(name);
          return;
        }
        case "module": {
          if (!first) return;
          summary.imports.push(first);
          return;
        }
        case "variable": {
          if (!first) return;
          summary.variables.push(first);
          return;
        }
        case "output": {
          if (!first) return;
          summary.exports.push(first);
          return;
        }
        case "provider": {
          if (!first) return;
          summary.imports.push(`provider:${first}`);
          return;
        }
        default: {
          // `locals`, `terraform`: a block with no name of its own.
          summary.directives.push(keyword);
        }
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/structured.ts">
import type { JsonSummary, MarkdownSummary } from "../types.js";

/**
 * Strips `//` and block comments the way JSONC does, plus trailing commas, without touching
 * anything inside a string literal.
 *
 * `JSON.parse` alone made every `.jsonc` file — and every `tsconfig.json` an editor had
 * reformatted — report `invalid-json`, losing its key shape entirely. Two things this file's
 * matcher did that `src/config.ts`'s did not, and both are JSONC, not extensions of it:
 *
 * - **Trailing commas.** `{ "a": 1, }` is valid JSONC and invalid JSON.
 * - **`\r`-only line endings.** A `//` comment ended only at `\n`, so on a CR-delimited file it
 *   swallowed everything to the end of the document.
 *
 * A block comment keeps the line breaks it spans. Dropping them renumbered every line after it,
 * and the only thing a reader has to place a summary key is the line number.
 */
export function stripJsonComments(content: string): string {
  const text = content.replace(/^\uFEFF/, "");
  const withoutComments = stripComments(text);
  return stripTrailingCommas(withoutComments);
}

/** Removes `//` and block comments; block comments leave their line terminators behind. */
function stripComments(text: string): string {
  let out = "";
  let inString = false;
  let escaped = false;

  for (let index = 0; index < text.length; index += 1) {
    const char = text[index];

    if (inString) {
      out += char;
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') inString = false;
      continue;
    }

    if (char === '"') {
      inString = true;
      out += char;
      continue;
    }

    if (char === "/" && text[index + 1] === "/") {
      while (index < text.length && text[index] !== "\n" && text[index] !== "\r") index += 1;
      index -= 1; // let the loop emit the terminator
      continue;
    }

    if (char === "/" && text[index + 1] === "*") {
      index += 2;
      while (index < text.length && !(text[index] === "*" && text[index + 1] === "/")) {
        if (text[index] === "\n" || text[index] === "\r") out += text[index];
        index += 1;
      }
      index += 1; // skip the closing "/"
      continue;
    }

    out += char;
  }

  return out;
}

/** Removes the `,` before `}`/`]` that JSONC allows and `JSON.parse` rejects. */
function stripTrailingCommas(text: string): string {
  let out = "";
  let inString = false;
  let escaped = false;

  for (let index = 0; index < text.length; index += 1) {
    const char = text[index];

    if (inString) {
      out += char;
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') inString = false;
      continue;
    }

    if (char === '"') {
      inString = true;
      out += char;
      continue;
    }

    if (char === ",") {
      let next = index + 1;
      while (next < text.length && /\s/.test(text[next] as string)) next += 1;
      if (text[next] === "}" || text[next] === "]") continue;
    }

    out += char;
  }

  return out;
}

export function summarizeJson(content: string): JsonSummary {
  try {
    const parsed = JSON.parse(stripJsonComments(content));
    if (Array.isArray(parsed)) {
      const sample = parsed[0];
      const sampleKeys =
        sample && typeof sample === "object" && !Array.isArray(sample)
          ? Object.keys(sample).slice(0, 10).sort()
          : [];
      return {
        shape: "array",
        itemCount: parsed.length,
        keys: [],
        sampleKeys,
      };
    }
    if (parsed && typeof parsed === "object") {
      const keys = Object.keys(parsed).sort();
      return {
        shape: "object",
        itemCount: keys.length,
        keys: keys.slice(0, 30),
        sampleKeys: [],
      };
    }
    return {
      shape: typeof parsed,
      itemCount: null,
      keys: [],
      sampleKeys: [],
    };
  } catch {
    return {
      shape: "invalid-json",
      itemCount: null,
      keys: [],
      sampleKeys: [],
    };
  }
}

/**
 * How many opening lines are a YAML front-matter block, or `0` when they are not one.
 *
 * Front matter is only front matter if it *closes*, and if what it holds can be YAML. The old test
 * asked only the first question — it scanned to the end of the file for any `---` line — so a
 * document that opens with a **horizontal rule** and uses another one as a section divider had
 * everything between them read as front matter, and every heading in that span disappeared from the
 * summary. The index then claimed a document with no sections.
 *
 * The block is accepted when every line is a YAML mapping entry, a list item, a comment, a blank
 * line or an indented continuation. A Markdown heading, a code fence or plain prose settles it: this
 * is not YAML, so the opening `---` is a rule.
 *
 * `...` closes a YAML document just as `---` does; both are legal terminators.
 */
function frontMatterEnd(lines: readonly string[]): number {
  if (lines.length < 3 || (lines[0] as string).trim() !== "---") return 0;

  for (let index = 1; index < lines.length; index += 1) {
    const line = lines[index] as string;
    const candidate = line.trim();

    if (candidate === "---" || candidate === "...") {
      // A block with no content at all is indistinguishable from two rules, and treating it as
      // front matter would change nothing observable — say "not front matter" either way.
      return index > 1 ? index : 0;
    }
    if (candidate === "") continue;
    // A YAML comment. `# Heading` is not: CommonMark requires a space after the hashes, and YAML
    // comments have no such requirement, so the space is what separates them.
    if (/^#(\s|$)/.test(candidate)) continue;
    if (/^(`{3,}|~{3,})/.test(candidate)) return 0;
    if (/^#{1,6}\s+\S/.test(candidate)) return 0;

    const isYamlMapping = /^[A-Za-z0-9_.-]+\s*:(\s|$)/.test(candidate);
    const isListItem = /^-(?:(\s|$))/.test(candidate);
    const isIndented = /^[ \t]/.test(line);
    if (!isYamlMapping && !isListItem && !isIndented) return 0;
  }
  return 0;
}

export function summarizeMarkdown(content: string): MarkdownSummary {
  const headings: string[] = [];
  const frontmatterKeys: string[] = [];
  // Split on every terminator, so a CRLF or CR-only document is read line by line rather than as
  // one long line whose `---` never equals itself.
  const lines = content.replace(/^\uFEFF/, "").split(/\r\n|\n|\r/);

  let inFrontmatter = false;
  /**
   * The fence character of the code block we are inside, or `null`.
   *
   * A `#` at the start of a line inside a fenced block is a comment in shell, Python,
   * YAML and Dockerfile examples — not a heading. Without tracking the fence, every one
   * of those became a document heading in the summary: this repository's own
   * `docs/agent.md` reported "# 1. Read the contract…" and `docs/cli.md` reported
   * "# The common path", both of which are shell comments in examples. A model reading
   * the index was told the document had sections it does not have.
   */
  let fence: { marker: string; length: number } | null = null;

  const frontMatterEndLine = frontMatterEnd(lines);

  for (let index = 0; index < lines.length; index++) {
    const line = lines[index] as string;

    if (index === 0 && frontMatterEndLine > 0) {
      inFrontmatter = true;
      continue;
    }

    if (inFrontmatter) {
      const trimmedFrontmatter = line.trim();
      if (trimmedFrontmatter === "---" || trimmedFrontmatter === "...") {
        inFrontmatter = false;
        continue;
      }
      const match = /^([A-Za-z0-9_.-]+)\s*:/.exec(line);
      if (match) frontmatterKeys.push(match[1] as string);
      continue;
    }

    const trimmed = line.trim();
    // CommonMark: a fence opens with three or more backticks or tildes, and closes with a run of
    // the *same* character that is **at least as long** and carries **no info string**.
    // Storing only the character paired them wrongly twice over: a three-backtick line inside a
    // four-backtick block ended the block, and a closing line with an info string (```` ```bash ````)
    // was accepted as a close instead of being read as content.
    const fenceMatch = /^(`{3,}|~{3,})(.*)$/.exec(trimmed);
    if (fenceMatch) {
      const run = fenceMatch[1] as string;
      const rest = (fenceMatch[2] as string).trim();
      if (fence === null) {
        fence = { marker: run[0] as string, length: run.length };
      } else if (run[0] === fence.marker && run.length >= fence.length && rest === "") {
        fence = null;
      }
      continue;
    }
    if (fence !== null) continue;

    const headingMatch = /^(#{1,6})\s+(.+)$/.exec(trimmed);
    if (headingMatch) {
      headings.push(`${headingMatch[1]} ${headingMatch[2].trim()}`);
    }
  }

  return {
    headings: headings.slice(0, 40),
    frontmatterKeys: Array.from(new Set(frontmatterKeys)).sort(),
  };
}
