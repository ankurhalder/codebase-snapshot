import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { generateSnapshot, resolveConfig, runInit, supportsTypeScriptImports, validateSnapshot } from "../dist/index.js";

/**
 * 0.9.14 — the two places a *record* disagreed with reality.
 *
 * 4.1 — seven settings were recorded in the manifest and folded into the configuration digest, but
 * never joined the field-by-field comparison `validate` prints. A changed `--skeleton` produced
 * only the opaque "the settings differ from the ones this snapshot was generated with" line, so the
 * user was told that something had drifted and never which.
 *
 * 1.8 — `findConfigFile` reads `package.json` through `stripJsonComments`, which drops a UTF-8 BOM;
 * every *other* reader used bare `JSON.parse`, which throws on one. A Windows editor writes that
 * BOM, and the result was a project that reported no config, no `"type": "module"`, and no scripts
 * — while `generate` read the same file happily.
 */

const here = path.dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = path.resolve(here, "..");
const CLI = path.join(REPO_ROOT, "dist", "bin.js");

function makeRepo(t, files) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "records-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const configFor = (dir, extra = {}) =>
  resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", ...extra }, {}, dir);

// ---------------------------------------------------------------------------
// 4.1 — configuration drift names the setting
// ---------------------------------------------------------------------------

test("validate names every setting that drifted, including the newer ones", (t) => {
  const dir = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/a.ts": "export function a(): number { return 1; }\n",
  });

  generateSnapshot(
    configFor(dir, {
      skeleton: true,
      sarif: true,
      maxPartTokens: 2000,
      withDependents: false,
    })
  );

  const report = validateSnapshot(
    configFor(dir, {
      skeleton: false,
      sarif: false,
      maxPartTokens: 4000,
    })
  );

  const text = report.drift.configMismatches.join("\n");
  for (const field of ["skeleton", "sarif", "maxPartTokens"]) {
    assert.match(text, new RegExp(`^${field}: manifest `, "m"), `${field} is named`);
  }
});

// ---------------------------------------------------------------------------
// 1.8 — a UTF-8 BOM in package.json
// ---------------------------------------------------------------------------

const BOM = "\uFEFF";

test("init reads a package.json that starts with a byte-order mark", async (t) => {
  const dir = makeRepo(t, {
    "package.json": `${BOM}${JSON.stringify(
      { name: "fixture", version: "1.0.0", type: "module" },
      null,
      2
    )}\n`,
    "src/a.ts": "export const a = 1;\n",
  });

  const result = await runInit({ cwd: dir, yes: true });

  // The config filename depends on the runtime, not on the BOM: a `.ts` config needs Node's type
  // stripping and a `"type": "module"` package, and the release matrix includes versions without
  // stripping. What must not depend on the runtime is that the `"type"` field was *read* at all.
  if (supportsTypeScriptImports()) {
    assert.equal(
      result.configPath.endsWith("snapshot.config.ts"),
      true,
      `a "type": "module" project gets the .ts config, not ${result.configPath}`
    );
  } else {
    assert.equal(
      result.configPath.endsWith("snapshot.config.mjs"),
      true,
      `a runtime without type stripping gets .mjs, not ${result.configPath}`
    );
  }
  assert.ok(result.scripts.includes("snapshot"), "the npm script is added");
  assert.equal(
    result.notes.some((note) => /could not parse package\.json/i.test(note)),
    false,
    "and nothing claims the file was unparseable"
  );

  const written = fs.readFileSync(path.join(dir, "package.json"), "utf8");
  assert.ok(written.startsWith(BOM), "the byte-order mark the file had is still there");
  const parsed = JSON.parse(written.replace(/^\uFEFF/, ""));
  assert.equal(parsed.scripts.snapshot, "npx codebase-snapshot generate");
  assert.ok(parsed.devDependencies["codebase-snapshot"], "and the devDependency is declared");
});

test("init notices an existing snapshot block behind a byte-order mark", async (t) => {
  const dir = makeRepo(t, {
    "package.json": `${BOM}${JSON.stringify(
      { name: "fixture", version: "1.0.0", snapshot: { outDir: "context" } },
      null,
      2
    )}\n`,
    "src/a.ts": "export const a = 1;\n",
  });

  // A config block in `package.json` takes precedence over a config file, so writing one would
  // silently change the effective settings of a repository that is already configured. `init`
  // refuses instead — which is only possible if it could read the block, and it could not read one
  // behind a byte-order mark.
  await assert.rejects(
    () => runInit({ cwd: dir, yes: true }),
    /already defines a "snapshot" config/,
    "the existing block is seen"
  );
  assert.equal(fs.existsSync(path.join(dir, "snapshot.config.mjs")), false, "and nothing is written");
});

test("the create shim finds the snapshot script behind a byte-order mark", (t) => {
  const dir = makeRepo(t, {
    "package.json": `${BOM}${JSON.stringify(
      {
        name: "fixture",
        version: "1.0.0",
        type: "module",
        scripts: { snapshot: "codebase-snapshot generate" },
      },
      null,
      2
    )}\n`,
    "src/a.ts": "export const a = 1;\n",
  });

  // The published layout, so the shim's bare import resolves.
  const nodeModules = path.join(dir, "node_modules");
  fs.mkdirSync(nodeModules, { recursive: true });
  try {
    fs.symlinkSync(REPO_ROOT, path.join(nodeModules, "codebase-snapshot"), process.platform === "win32" ? "junction" : "dir");
  } catch {
    t.skip("this host cannot create directory links");
    return;
  }
  const shim = path.join(dir, "create-shim.mjs");
  fs.copyFileSync(path.join(REPO_ROOT, "packages", "create", "index.mjs"), shim);

  const result = spawnSync(process.execPath, [shim, "--yes"], { cwd: dir, encoding: "utf8" });
  const output = `${result.stdout}${result.stderr}`;
  assert.match(
    output,
    /npm (?:install && )?npm run snapshot|npm install && npm run snapshot/,
    `the next step should be the project's own script\n${output}`
  );
  assert.doesNotMatch(output, /npx codebase-snapshot generate/, "not the published package");
});

test("the setup hint names the project's own script behind a byte-order mark", (t) => {
  const dir = makeRepo(t, {
    "package.json": `${BOM}${JSON.stringify(
      { name: "fixture", version: "1.0.0", scripts: { snapshot: "codebase-snapshot generate" } },
      null,
      2
    )}\n`,
    "src/a.ts": "export const a = 1;\n",
  });

  const result = spawnSync(process.execPath, [CLI, "setup", "--no-install"], {
    cwd: dir,
    encoding: "utf8",
    timeout: 120_000,
  });
  const output = `${result.stdout}${result.stderr}`;
  assert.match(output, /Next:\s+npm (?:install && )?npm run snapshot/, output);
});

test("the run banner names the project dependency behind a byte-order mark", (t) => {
  const pkg = {
    name: "fixture",
    version: "1.0.0",
    devDependencies: { "codebase-snapshot": "^0.10.1" },
  };
  const dir = makeRepo(t, {
    "package.json": `${BOM}${JSON.stringify(pkg, null, 2)}\n`,
    "src/a.ts": "export const a = 1;\n",
  });

  const result = spawnSync(process.execPath, [CLI, "generate", "--cwd", dir], { encoding: "utf8" });
  assert.equal(result.status, 0, result.stderr);

  // The banner exists to say whether the snapshot came from the project's own pin or from
  // whatever was first on PATH. A bare `JSON.parse` threw on the BOM, the catch swallowed it, and
  // a project that pins this package was told it had a "global or direct install".
  assert.match(result.stderr, /\(project dependency \^0\.10\.1\)/);
  assert.doesNotMatch(result.stderr, /global or direct install/);
});

test("the banner still says what it cannot know when there is no dependency", (t) => {
  const dir = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/a.ts": "export const a = 1;\n",
  });

  const result = spawnSync(process.execPath, [CLI, "generate", "--cwd", dir], { encoding: "utf8" });
  assert.equal(result.status, 0, result.stderr);
  assert.match(result.stderr, /\(global or direct install\)/);
});
</file>

<file path="tests/summary-preview.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot } from "../dist/index.js";

/**
 * A file emitted as a head/tail preview carries only a slice of its lines, so a
 * whole-file structural summary describes lines the snapshot does not contain —
 * and building one dominated the run: masking every identifier (through
 * `findSecretInPath`) for a summary the partitioner then discards. Previews are
 * no longer summarised, and the manifest says so in one grouped warning.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "summary-preview-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content, "utf8");
  return target;
}

/** A source file comfortably above the preview threshold. */
function bigSource(prefix, lines) {
  return Array.from({ length: lines }, (_, index) => `export const ${prefix}${index} = ${index};`).join("\n") + "\n";
}

const SMALL = 'export const small = 1;\nexport function helper() { return small; }\n';

function entryFor(manifest, relativePath) {
  const entry = manifest.files.find((file) => file.relativePath === relativePath);
  assert.ok(entry, `${relativePath} must be in the manifest`);
  return entry;
}

test("a previewed source file gets no structural summary, and the manifest says so", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  write(dir, "src/small.ts", SMALL);
  write(dir, "src/big.ts", bigSource("bulk", 4000));

  const manifest = generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 4096 });

  const big = entryFor(manifest, "src/big.ts");
  assert.equal(big.inclusionMode, "preview");
  assert.equal(big.summary, undefined, "a preview must not carry a whole-file summary");
  assert.equal(big.summaryQuality, undefined);

  // A whole file still gets its summary.
  const small = entryFor(manifest, "src/small.ts");
  assert.equal(small.inclusionMode, "full");
  assert.ok(small.summary, "a whole file keeps its summary");
  assert.equal(small.summaryQuality, "ast");

  const grouped = manifest.warnings.filter((warning) => /head\/tail previews and were not parsed/.test(warning));
  assert.equal(grouped.length, 1, `expected one grouped warning: ${JSON.stringify(manifest.warnings)}`);
  assert.match(grouped[0], /src\/big\.ts/);
  assert.match(grouped[0], /^1 file is emitted/);
});

test("the preview warning names at most five paths and counts the rest", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  for (let index = 0; index < 7; index += 1) {
    write(dir, `src/big${index}.ts`, bigSource(`bulk${index}_`, 900));
  }

  const manifest = generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 1024 });

  const grouped = manifest.warnings.filter((warning) => /head\/tail previews and were not parsed/.test(warning));
  assert.equal(grouped.length, 1);
  assert.match(grouped[0], /^7 files are emitted/);
  assert.match(grouped[0], /and 2 more/);
  for (let index = 0; index < 7; index += 1) {
    assert.equal(
      entryFor(manifest, `src/big${index}.ts`).summary,
      undefined,
      "every preview must be unsummarised"
    );
  }
});

test("a whole file just under the threshold keeps its summary", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  write(dir, "src/medium.ts", bigSource("m", 40));

  // Both knobs raised together: the threshold may not sit above the part budget, and this test
  // wants a run where nothing is previewed at all.
  const manifest = generateSnapshot({
    cwd: dir,
    outDir: "snapshot",
    maxPartBytes: 10_000_000,
    largeFileBytes: 10_000_000,
  });

  const medium = entryFor(manifest, "src/medium.ts");
  assert.equal(medium.inclusionMode, "full");
  assert.ok(medium.summary, "no preview means no reason to drop the summary");
  assert.equal(
    manifest.warnings.some((warning) => /head\/tail previews and were not parsed/.test(warning)),
    false
  );
});

test("a previewed file whose language has no profile is not reported", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  write(dir, "logs/huge.log", "line\n".repeat(50_000));

  const manifest = generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 1024 });

  const log = entryFor(manifest, "logs/huge.log");
  assert.equal(log.summary, undefined, "a .log never had a summary");
  assert.equal(
    manifest.warnings.some((warning) => /head\/tail previews and were not parsed/.test(warning)),
    false,
    "warning about a summary that could never exist would be noise"
  );
});

test("a previewed JSON file is not summarised either", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  const rows = Array.from({ length: 4000 }, (_, index) => `  {"id": ${index}, "name": "row${index}"}`).join(",\n");
  write(dir, "data/rows.json", `[\n${rows}\n]\n`);

  const manifest = generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 4096 });

  const json = entryFor(manifest, "data/rows.json");
  assert.equal(json.inclusionMode, "preview");
  assert.equal(json.summary, undefined);
  assert.ok(
    manifest.warnings.some((warning) => /head\/tail previews and were not parsed/.test(warning)),
    "the omission must be visible"
  );
});

test("a summary dropped for size says so, and a missing one does not", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  write(dir, "src/big.ts", bigSource("bulk", 4000));
  write(dir, "logs/huge.log", "line\n".repeat(20_000));

  const manifest = generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 4096 });

  // `summary` absent means different things for these two files: one had a structural summary
  // that a size rule removed, the other never had one. The fields that tell them apart were set,
  // documented twice, and asserted nowhere.
  const big = entryFor(manifest, "src/big.ts");
  assert.equal(big.summaryOmitted, true, "a previewed source file records the omission");
  assert.equal(big.summaryOmittedReason, "preview", "and names the size rule that removed it");

  const log = entryFor(manifest, "logs/huge.log");
  assert.equal(log.summaryOmitted, undefined, "a language with no profile never had a summary");
  assert.equal(log.summaryOmittedReason, undefined);

  // The documented invariant, checked on every entry rather than on the two above.
  for (const file of manifest.files) {
    assert.equal(
      file.summaryOmittedReason === undefined,
      file.summaryOmitted !== true,
      `${file.relativePath}: summaryOmittedReason is present exactly when summaryOmitted is true`
    );
  }
});

test("the contract text and the manifest agree about summaryOmitted", (t) => {
  const dir = tempDir(t);
  write(dir, "package.json", '{"name":"fixture"}\n');
  write(dir, "src/big.ts", bigSource("bulk", 4000));
  const manifest = generateSnapshot({ cwd: dir, outDir: "snapshot", largeFileBytes: 4096 });

  assert.equal(
    manifest.files.some((file) => file.summaryOmitted === true),
    true,
    "a run with a previewed source file must exercise the field"
  );
});
</file>

