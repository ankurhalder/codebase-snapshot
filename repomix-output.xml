<file path="tests/core-pipeline-fixes.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

import { generateSnapshot } from "../dist/index.js";

/**
 * Core-pipeline fixes from audit track 1 (src/index.ts).
 *
 *   6   an async hook's stdout must never be appended to the `--format json` payload
 *   20  one text file too large for a V8 string must be a `read-error` skip, not a fatal abort
 *   21  the "2 MB" summary guard must measure bytes, not UTF-16 code units
 *   42  a credential-shaped hook error must be masked in the manifest and on stdout
 *   7b  maxPartBytes < largeFileBytes must be warned about at generate time
 *   22  the monolith's embedded manifest must agree with the shipped one
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-core-pipeline-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

function writePackage(base) {
  write(base, "package.json", JSON.stringify({ name: "core-pipeline", version: "1.0.0" }));
}

function runCli(cliArgs, cwd = process.cwd()) {
  const result = spawnSync(process.execPath, [BIN, ...cliArgs], {
    cwd,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

const sha256 = (buffer) => crypto.createHash("sha256").update(buffer).digest("hex");

// ------------------------------------------------------------------ item 6
test("an async hook's stdout cannot corrupt the --format json payload", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);
  write(cwd, "src/a.ts", "export const a = 1;\n");
  write(
    cwd,
    "snapshot.config.mjs",
    [
      "export default {",
      "  hooks: {",
      "    afterGenerate: async () => {",
      "      await new Promise((resolve) => setTimeout(resolve, 25));",
      '      console.log("ASYNC HOOK STDOUT LINE");',
      "    },",
      "  },",
      "};",
      "",
    ].join("\n")
  );

  const run = runCli(["generate", "--cwd", cwd, "--out-dir", "snap", "--format", "json"]);
  assert.equal(run.code, 0, run.stderr);

  // Before the fix the payload was followed by the hook line and this threw.
  const manifest = JSON.parse(run.stdout);
  assert.ok(
    manifest.files.some((file) => file.relativePath === "src/a.ts"),
    "the payload must describe the generated snapshot"
  );
  assert.equal(run.stdout.includes("ASYNC HOOK STDOUT LINE"), false, "hook output leaked into stdout");
  assert.match(run.stderr, /ASYNC HOOK STDOUT LINE/, "hook output should be redirected to stderr");
});

// ------------------------------------------------------------------ item 20
test("a text file too large for a V8 string is skipped as read-error, not fatal", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);
  write(cwd, "src/small.ts", "export const small = 1;\n");

  // 600 MiB of spaces: valid UTF-8, no NUL, and longer than the ~512 MiB string
  // limit V8 enforces when the buffer is materialised as a JS string.
  const hugePath = path.join(cwd, "src", "huge.txt");
  const chunk = Buffer.alloc(1024 * 1024, 0x20);
  const fd = fs.openSync(hugePath, "w");
  try {
    for (let index = 0; index < 600; index += 1) fs.writeSync(fd, chunk, 0, chunk.length);
  } finally {
    fs.closeSync(fd);
  }
  const hugeBytes = fs.statSync(hugePath).size;
  assert.equal(hugeBytes, 600 * 1024 * 1024);

  const run = runCli(["generate", "--cwd", cwd, "--out-dir", "snap", "--format", "json"]);
  assert.equal(run.code, 0, run.stderr);

  const manifest = JSON.parse(run.stdout);
  assert.equal(
    manifest.files.some((file) => file.relativePath === "src/huge.txt"),
    false,
    "the unreadable file must not be listed as included"
  );
  const skip = manifest.skipped.find((entry) => entry.path === "src/huge.txt");
  assert.ok(skip, "the file must appear in skipped[]");
  assert.equal(skip.reason, "read-error");
  assert.match(skip.detail, /^Size: 629145600 B; could not be decoded: /);
  assert.equal(run.stderr.includes("Cannot create a string longer than"), false);
});

// ------------------------------------------------------------------ item 21
test("a 3 MB CJK file is not parsed for a summary", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);
  // 1,000,000 characters x 3 bytes = 3,000,000 bytes on one line: large, but
  // below 2 M UTF-16 code units, which is what the guard used to measure.
  write(cwd, "src/cjk.ts", "日".repeat(1_000_000));

  const manifest = generateSnapshot({ cwd });
  const entry = manifest.files.find((file) => file.relativePath === "src/cjk.ts");
  assert.ok(entry, "the file must be included");
  assert.equal(entry.sizeBytes, 3_000_000);
  assert.equal(entry.summary, undefined, "a file over the 2 MB ceiling must not be parsed");
  assert.ok(
    manifest.warnings.some(
      (warning) => /exceed 2 MB and were not parsed/.test(warning) && warning.includes("src/cjk.ts")
    ),
    `expected the oversize warning, got: ${JSON.stringify(manifest.warnings)}`
  );
});

// ------------------------------------------------------------------ item 42
test("a credential-shaped hook error is masked in the manifest and on stdout", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);
  write(cwd, "src/a.ts", "export const a = 1;\n");
  write(
    cwd,
    "snapshot.config.mjs",
    [
      "export default {",
      "  hooks: {",
      "    afterGenerate: () => {",
      '      throw new Error("upstream rejected AKIAIOSFODNN7EXAMPLE");',
      "    },",
      "  },",
      "};",
      "",
    ].join("\n")
  );

  const run = runCli(["generate", "--cwd", cwd, "--out-dir", "snap", "--format", "json"]);
  assert.equal(run.code, 0, run.stderr);
  const manifest = JSON.parse(run.stdout);
  const warnings = manifest.warnings.join("\n");
  assert.match(warnings, /hooks\.afterGenerate failed:/);
  assert.equal(warnings.includes("AKIAIOSFODNN7EXAMPLE"), false, "the token leaked on stdout");
  assert.match(warnings, /\[REDACTED/);

  const onDisk = JSON.parse(fs.readFileSync(path.join(cwd, "snap", "manifest.json"), "utf8"));
  const diskWarnings = onDisk.warnings.join("\n");
  assert.equal(diskWarnings.includes("AKIAIOSFODNN7EXAMPLE"), false, "the token leaked into manifest.json");
  assert.match(diskWarnings, /\[REDACTED/);
});

// ------------------------------------------------------------------ item 7b
test("a large-file threshold above the part budget is refused, not cut around", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);
  write(cwd, "src/a.ts", "export const a = 1;\n");

  // A file between the two numbers cannot fit a part, so the old code cut it to fit while the
  // manifest recorded `inclusionMode: preview` beside `isLarge: false` — a reader could not tell
  // policy from loss. The two settings answer one question; disagreement is a config error.
  assert.throws(
    () => generateSnapshot({ cwd, outDir: "loud", maxPartBytes: 4096, largeFileBytes: 8192 }),
    /is larger than maxPartBytes/
  );

  // Equality is the default and is legitimate: a file at exactly the threshold still fits one
  // part, so nothing is previewed early and nothing is warned about.
  const quiet = generateSnapshot({ cwd, outDir: "quiet", maxPartBytes: 8192, largeFileBytes: 8192 });
  assert.deepEqual(
    quiet.warnings.filter((warning) => /largeFileBytes/.test(warning)),
    [],
    "an equal threshold previews nothing early"
  );
});

// ------------------------------------------------------------------ item 22
test("the monolith's embedded manifest agrees with the shipped one", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);
  write(cwd, "src/a.ts", "export const a = 1;\n");
  write(cwd, "src/b.ts", "export const b = 2;\n");

  const manifest = generateSnapshot({ cwd, includeMonolith: true });
  const outDir = path.join(cwd, "snapshot");
  const shipped = JSON.parse(fs.readFileSync(path.join(outDir, "manifest.json"), "utf8"));
  const jsonBytes = fs.readFileSync(path.join(outDir, "full-codebase.json"));
  const embedded = JSON.parse(jsonBytes.toString("utf8"));

  assert.ok(manifest.artifacts.fullJson, "the run must record the JSON digest");
  assert.equal(shipped.artifacts.fullJson.sha256, sha256(jsonBytes));
  assert.deepEqual(embedded.manifest.warnings, shipped.warnings);
  assert.deepEqual(
    embedded.manifest.artifacts.fullMarkdown,
    shipped.artifacts.fullMarkdown,
    "the other monolith's digest is embeddable and must be final"
  );
  // A file cannot contain its own sha256: the embedded copy is the one field that
  // stays null, and the shipped manifest carries the real digest.
  assert.equal(embedded.manifest.artifacts.fullJson, null);
});

// ------------------------------------------------------------------ tree depth cap
test("a depth-capped project tree is also recorded in manifest.warnings", (t) => {
  const cwd = tempDir(t);
  writePackage(cwd);

  // One level past the tree's 512-level cap. Long paths are not available on every
  // checkout (Windows without LongPathsEnabled), so this half is skippable.
  let dir = cwd;
  try {
    for (let level = 0; level < 513; level += 1) {
      dir = path.join(dir, "d");
      fs.mkdirSync(dir);
    }
  } catch (err) {
    t.skip(`this platform cannot create a 513-level path (${err.code ?? err.message})`);
    return;
  }
  fs.writeFileSync(path.join(dir, "leaf.ts"), "export const deep = 1;\n");

  const manifest = generateSnapshot({ cwd });
  const warning = manifest.warnings.find((entry) =>
    /reports\/project-tree\.md was truncated at the 512-level depth cap/.test(entry)
  );
  assert.ok(
    warning,
    `expected the depth-cap warning, else the tree is silently incomplete: ${JSON.stringify(manifest.warnings)}`
  );
  const tree = fs.readFileSync(path.join(cwd, "snapshot", "reports", "project-tree.md"), "utf8");
  assert.match(tree, /\[tree truncated at 512 levels\]/);
});
</file>

<file path="tests/delta.test.js">
/**
 * Delta packs: what changed since a base snapshot, plus the files that import it.
 *
 * The honesty property is the important one: an unchanged file is not dropped silently. It is
 * absent from files[] and present in skipped[] with reason "unchanged" and in delta.unchanged, so a
 * reader can account for every scanned path.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

const BIN = path.join(path.dirname(new URL(import.meta.url).pathname.replace(/^\//, "")), "..", "dist", "bin.js");

function makeRepo(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "delta-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  fs.mkdirSync(path.join(root, "src"), { recursive: true });
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"d","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(root, "src", "user.ts"), "export function getUser() { return 1; }\n");
  fs.writeFileSync(path.join(root, "src", "auth.ts"), 'import { getUser } from "./user.js";\nexport const auth = getUser;\n');
  fs.writeFileSync(path.join(root, "src", "unrelated.ts"), "export const unrelated = 1;\n");
  return root;
}

const run = (args, cwd) => {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, out: (result.stdout ?? "") + (result.stderr ?? "") };
};

test("a delta contains the changed file and its importer, and accounts for the rest", (t) => {
  const root = makeRepo(t);
  assert.equal(run(["generate"], root).code, 0);
  const base = path.join(root, "snapshot");
  const before = JSON.parse(fs.readFileSync(path.join(base, "manifest.json"), "utf8"));
  assert.equal(before.files.length, 4);

  fs.appendFileSync(path.join(root, "src", "user.ts"), "export const version = 2;\n");
  const result = run(["generate", "--out-dir", "delta", "--delta", base], root);
  assert.equal(result.code, 0, result.out);

  const manifest = JSON.parse(fs.readFileSync(path.join(root, "delta", "manifest.json"), "utf8"));
  assert.ok(manifest.delta, "the manifest records the delta");
  assert.deepEqual(manifest.delta.changed, ["src/user.ts"]);
  assert.deepEqual(manifest.delta.added, []);
  assert.deepEqual(manifest.delta.removed, []);
  assert.deepEqual(manifest.delta.unchanged.sort(), ["package.json", "src/unrelated.ts"]);

  const inParts = manifest.files.map((file) => file.relativePath).sort();
  assert.deepEqual(inParts, ["src/auth.ts", "src/user.ts"], "the importer is included: " + inParts.join(","));

  const unchanged = manifest.skipped.filter((record) => record.reason === "unchanged").map((record) => record.path);
  assert.ok(unchanged.includes("src/unrelated.ts"));
  assert.ok(unchanged.includes("package.json"));

  const body = fs.readFileSync(path.join(root, "delta", "parts", "part-001.md"), "utf8");
  assert.match(body, /version = 2/);
  assert.doesNotMatch(body, /unrelated/);
});

test("a new file shows as added and a deleted one as removed", (t) => {
  const root = makeRepo(t);
  assert.equal(run(["generate"], root).code, 0);
  fs.writeFileSync(path.join(root, "src", "fresh.ts"), "export const fresh = true;\n");
  fs.rmSync(path.join(root, "src", "unrelated.ts"));

  assert.equal(run(["generate", "--out-dir", "delta", "--delta", root + "/snapshot"], root).code, 0);
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "delta", "manifest.json"), "utf8"));
  assert.deepEqual(manifest.delta.added, ["src/fresh.ts"]);
  assert.deepEqual(manifest.delta.removed, ["src/unrelated.ts"]);
});

test("an unreadable base is an error, not a full scan", (t) => {
  const root = makeRepo(t);
  const result = run(["generate", "--delta", path.join(root, "missing")], root);
  assert.notEqual(result.code, 0);
  assert.match(result.out, /No manifest at/);
});
</file>

<file path="tests/import-graph-languages.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  buildImportResolver,
  explainPath,
  generateSnapshot,
  importsOfText,
  resolveConfig,
  resolveSpecifier,
  summarizeWithProfile,
} from "../dist/index.js";

/**
 * 0.9.14 — the import graph, from three sides.
 *
 * 1.2 — `--with-dependents` dropped an importer whose summary was skipped for being a preview,
 * while `validate` and `explain` read that same file unconditionally. Generating with the flag
 * and then validating with it reported the included file as missing: two commands, two answers,
 * and the generator's answer was the one that lost a dependent.
 *
 * 5.1 — only JavaScript and TypeScript specifiers were resolved. `importsOfText` has extracted
 * Python, Ruby, C/C++ and Dart imports for several releases, so the graph had edges the resolver
 * could not follow: `from .models import Order` was recorded and then resolved to nothing.
 *
 * 4.2 — a `.vue` or `.astro` script block was always parsed as `.ts`, so a `lang="tsx"` block and
 * Astro frontmatter helpers that use JSX were parsed as if `<Foo>` were a type assertion.
 */

function git(dir, args) {
  execFileSync("git", ["-c", "user.email=a@b", "-c", "user.name=a", ...args], {
    cwd: dir,
    stdio: "ignore",
  });
}

function makeRepo(t, files) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "imports-"));
  const write = (relative, content) => {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  for (const [relative, content] of Object.entries(files)) write(relative, content);
  git(dir, ["init", "-q"]);
  git(dir, ["add", "-A"]);
  git(dir, ["commit", "-qm", "first"]);
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return { dir, write };
}

const configFor = (dir, extra) =>
  resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", ...extra }, {}, dir);

// ---------------------------------------------------------------------------
// 1.2 — a previewed importer is still an importer
// ---------------------------------------------------------------------------

test("--with-dependents keeps an importer too large for a summary", (t) => {
  // `largeFileBytes` defaults to 200 KB, and a previewed file is not parsed for a structural
  // summary — which is where the generator read imports from. The file's bytes are still in the
  // repo (head and tail in the part), so `validate` and `explain` happily read its imports and
  // called it a dependent the generator had dropped.
  const filler = Array.from({ length: 4000 }, (_v, i) => `export const pad${i} = ${i};`).join("\n");
  const { dir, write } = makeRepo(t, {
    "src/changed.ts": "export const changed = 1;\n",
    "src/big-consumer.ts": `import { changed } from "./changed.js";\n${filler}\nexport const total = changed;\n`,
    "src/untouched.ts": "export const untouched = 1;\n",
  });

  const scope = { changedSince: "HEAD", withDependents: true };

  write("src/changed.ts", "export const changed = 2;\n");
  const manifest = generateSnapshot(configFor(dir, { ...scope, largeFileBytes: 2048 }));
  const paths = manifest.files.map((file) => file.relativePath);

  assert.ok(paths.includes("src/changed.ts"), "the changed file is in the snapshot");
  assert.ok(
    paths.includes("src/big-consumer.ts"),
    "its importer is in the snapshot even though the importer is a preview"
  );
  assert.ok(!paths.includes("src/untouched.ts"), "and the unrelated file is not");

  // The other two commands must agree with the generator, which is the whole point.
  const explained = explainPath(configFor(dir, { ...scope, largeFileBytes: 2048 }), "src/big-consumer.ts");
  assert.equal(explained.included, true, "explain agrees the importer is included");
});

test("imports are capped at the same size generate refuses to summarize", () => {
  // One rule, three commands: `importsOfText` refuses a body over the summary ceiling, so a file
  // generate will not parse is a file validate and explain will not parse either.
  const oversized = `import { x } from "./x.js";\n${"// padding\n".repeat(200000)}`;
  assert.ok(Buffer.byteLength(oversized, "utf8") > 2 * 1024 * 1024);
  assert.deepEqual(importsOfText("big.ts", oversized), []);
  assert.deepEqual(importsOfText("small.ts", 'import { x } from "./x.js";\n'), ["./x.js"]);
});

// ---------------------------------------------------------------------------
// 5.1 — relative imports in languages that are not JavaScript
// ---------------------------------------------------------------------------

const resolver = buildImportResolver([
  { relativePath: "pkg/__init__.py" },
  { relativePath: "pkg/models.py" },
  { relativePath: "pkg/views.py" },
  { relativePath: "lib/user.rb" },
  { relativePath: "src/board.h" },
  { relativePath: "include/render.h" },
  { relativePath: "lib/widget.dart" },
  { relativePath: "src/app.ts" },
]);

test("Python relative imports resolve to the module file", () => {
  assert.equal(resolveSpecifier("pkg/views.py", ".models", resolver), "pkg/models.py");
  assert.equal(resolveSpecifier("pkg/views.py", ".", resolver), "pkg/__init__.py");
});

test("Ruby require_relative resolves, and a bare require does not", () => {
  assert.equal(resolveSpecifier("lib/app.rb", "./user", resolver), "lib/user.rb");
  assert.equal(
    resolveSpecifier("lib/app.rb", "json", resolver),
    null,
    "a gem name is not a path in this repository"
  );
});

test("C and C++ local includes resolve", () => {
  // A quoted include searches the including file's own directory first, which is the only search
  // path a snapshot can reproduce; `-I include` is a compiler flag the repository does not record.
  assert.equal(resolveSpecifier("src/draw.c", "./board.h", resolver), "src/board.h");
  assert.equal(resolveSpecifier("src/draw.c", "stdio.h", resolver), null, "a system header is not");
});

test("a C include of a header that lives elsewhere does not guess", () => {
  // `include/render.h` exists, and `src/draw.c` cannot reach it without an -I path. Inventing the
  // edge would make `--with-dependents` include a file on a guess, and `validate` then disagree.
  assert.equal(resolveSpecifier("src/draw.c", "./render.h", resolver), null);
});

test("Dart relative imports resolve without a leading ./", () => {
  assert.equal(resolveSpecifier("lib/main.dart", "widget.dart", resolver), "lib/widget.dart");
  assert.equal(
    resolveSpecifier("lib/main.dart", "package:flutter/widgets.dart", resolver),
    null,
    "a package import is not a path"
  );
});

test("a Python package import is recorded per module, not as one edge to the package", () => {
  // `from . import models` names the module in the *import list*, so recording the dotted prefix
  // alone (`.`) pointed the edge at a package directory and lost the module. Both spellings now
  // produce the same edge, and the summary de-duplicates them.
  const summary = summarizeWithProfile(
    "pkg/views.py",
    "from . import models\nfrom .models import Order\n"
  );
  assert.ok(summary, "the Python profile answered");
  assert.deepEqual(summary.summary.imports, [".models"]);
});

test("--with-dependents follows a Python relative import", (t) => {
  const { dir, write } = makeRepo(t, {
    "pkg/__init__.py": "",
    "pkg/models.py": "class Order:\n    pass\n",
    "pkg/views.py": "from .models import Order\n\n\ndef show():\n    return Order()\n",
    "pkg/other.py": "VALUE = 1\n",
  });

  write("pkg/models.py", "class Order:\n    total = 1\n");
  const manifest = generateSnapshot(
    configFor(dir, { changedSince: "HEAD", withDependents: true })
  );
  const paths = manifest.files.map((file) => file.relativePath);

  assert.ok(paths.includes("pkg/models.py"), "the changed module is included");
  assert.ok(paths.includes("pkg/views.py"), "and the module that imports it");
  assert.ok(!paths.includes("pkg/other.py"), "but not an unrelated module");
});

// ---------------------------------------------------------------------------
// 4.2 — single-file components are parsed with the right script kind
// ---------------------------------------------------------------------------

test("a Vue script block declared as tsx is parsed as tsx", () => {
  // The same line parses as six errors in a `.ts` kind and none in `.tsx`: an opening tag is a
  // type assertion to the TypeScript grammar, and the attribute list after it is not a type.
  const component = [
    "<template><div /></template>",
    '<script lang="tsx">',
    "export const Widget = () => <Button onClick={() => go()} disabled={true}>ok</Button>;",
    "</script>",
  ].join("\n");
  const outcome = summarizeWithProfile("src/Widget.vue", component);
  assert.ok(outcome, "the SFC profile answered");
  assert.equal(outcome.summary.parseErrors ?? 0, 0, "JSX in a tsx block is not a parse error");
  assert.ok(outcome.summary.exports.includes("Widget"), "and the export is found");
});

test("Astro frontmatter is parsed as tsx", () => {
  const component = [
    "---",
    "const el = <Button onClick={() => go()} disabled={true}>ok</Button>;",
    "export const ok = 1;",
    "---",
    "",
    "<div />",
  ].join("\n");
  const outcome = summarizeWithProfile("src/Page.astro", component);
  assert.ok(outcome, "the SFC profile answered");
  assert.equal(outcome.summary.parseErrors ?? 0, 0, "JSX in Astro frontmatter is not a parse error");
  assert.ok(outcome.summary.exports.includes("ok"));
});
