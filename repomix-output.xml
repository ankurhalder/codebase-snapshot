<file path="scripts/pack-check.mjs">
/**
 * Verifies the tarball that `npm publish` would upload.
 *
 * This lives here rather than inline in a workflow so it runs on every machine
 * that can run `npm run verify` — the same check the publish job performs, with
 * no GitHub Actions minutes spent on it. A tarball missing an entry point, the
 * readme, the licence, or containing sourcemaps is a packaging bug that should
 * fail before a version number is spent on it.
 */
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");

/** Entry points and files that must exist in a published tarball. */
const REQUIRED = [
  "dist/index.js",
  "dist/index.cjs",
  "dist/index.d.ts",
  "dist/index.d.cts",
  "dist/cli.js",
  "dist/cli.cjs",
  "dist/cli.d.ts",
  "dist/cli.d.cts",
  // The MCP entry point is a separate export and a separate bin target. A tarball
  // missing it installs without complaint and then breaks every MCP client, which
  // is precisely the failure this script exists to catch before a version is spent.
  "dist/mcp.js",
  "dist/mcp.cjs",
  "dist/mcp.d.ts",
  "dist/mcp.d.cts",
  "dist/bin.js",
  "README.md",
  "LICENSE",
];

/**
 * Runs `npm` with these arguments, shelling out on Windows.
 *
 * On Windows `npm` is a `.cmd` shim that only runs through a shell, and Node deprecates that
 * combination when it is given an argument array (DEP0190): the arguments are concatenated, not
 * escaped. Handing the shell one pre-formed string avoids the deprecated form, and every caller
 * here passes fixed literals. Elsewhere the command is spawned directly, with no shell at all.
 */
function runNpm(args) {
  const options = { cwd: ROOT, encoding: "utf8" };
  return process.platform === "win32"
    ? spawnSync(`npm ${args.join(" ")}`, { ...options, shell: true })
    : spawnSync("npm", args, options);
}

function listTarballFiles() {
  const asJson = runNpm(["pack", "--dry-run", "--json"]);
  const raw = (asJson.stdout ?? "").trim();
  if (asJson.status === 0 && raw.startsWith("[")) {
    try {
      return JSON.parse(raw).flatMap((entry) => (entry.files ?? []).map((file) => file.path));
    } catch {
      // Fall through to the plain-text parser.
    }
  }

  const plain = runNpm(["pack", "--dry-run"]);
  const text = `${plain.stdout ?? ""}\n${plain.stderr ?? ""}`;
  if (plain.status !== 0) {
    console.error(`npm pack --dry-run exited with code ${plain.status}`);
    console.error(text);
    return null;
  }

  const lines = text.split("\n");
  const start = lines.findIndex((line) => line.includes("Tarball Contents"));
  if (start === -1) return null;

  const files = [];
  for (const line of lines.slice(start + 1)) {
    if (line.includes("Tarball Details") || line.includes("===")) break;
    const cleaned = line.replace(/^npm notice\s+/, "").trim();
    if (!cleaned) continue;
    files.push(cleaned.split(/\s+/).pop());
  }
  return files.filter(Boolean);
}

const files = listTarballFiles();
if (!files) {
  console.error("FAIL: could not read the tarball file list from npm pack --dry-run");
  process.exit(1);
}

const problems = [];
for (const required of REQUIRED) {
  if (!files.includes(required)) problems.push(`missing required file: ${required}`);
}
const sourcemaps = files.filter((file) => file.endsWith(".map"));
if (sourcemaps.length > 0) {
  problems.push(`tarball must not contain .map files: ${sourcemaps.join(", ")}`);
}

const packageJson = JSON.parse(fs.readFileSync(path.join(ROOT, "package.json"), "utf8"));
const createJson = JSON.parse(
  fs.readFileSync(path.join(ROOT, "packages", "create", "package.json"), "utf8")
);
if (createJson.version !== packageJson.version) {
  problems.push(
    `packages/create is at ${createJson.version} but the package is at ${packageJson.version}`
  );
}
const createDependency = createJson.dependencies?.["codebase-snapshot"];
if (createDependency !== `^${packageJson.version}`) {
  problems.push(
    `packages/create depends on ${createDependency ?? "nothing"}; expected ^${packageJson.version}`
  );
}

/**
 * The scaffolder declares MIT, and its tarball must carry the licence it declares.
 *
 * npm only includes a licence in a tarball when the file exists, and a `files` entry that names a
 * missing file is silently ignored — so the scaffolder shipped `"license": "MIT"` with no licence
 * text at all (the main package always had one). Both the entry and the file are checked, and the
 * text is compared with the root licence so the two copies cannot drift apart.
 */
const rootLicensePath = path.join(ROOT, "LICENSE");
const createLicensePath = path.join(ROOT, "packages", "create", "LICENSE");
if (!(createJson.files ?? []).includes("LICENSE")) {
  problems.push('packages/create#files must list "LICENSE" so the scaffolder ships its licence');
}
if (!fs.existsSync(createLicensePath)) {
  problems.push("packages/create/LICENSE is missing; create-codebase-snapshot declares MIT");
} else if (fs.readFileSync(createLicensePath, "utf8") !== fs.readFileSync(rootLicensePath, "utf8")) {
  problems.push("packages/create/LICENSE must match the root LICENSE text");
}

/**
 * The lockfile is committed, and its root entry repeats the package's own version and bin map.
 *
 * Neither is part of the published tarball, which is exactly why they rot unnoticed: a lockfile
 * that keeps advertising the previous version — or a binary this release removed — is stale
 * metadata nobody bumps, and `npm ci` keeps using it happily. `npm install --package-lock-only`
 * is the one-line fix.
 */
const lockPath = path.join(ROOT, "package-lock.json");
if (fs.existsSync(lockPath)) {
  const lock = JSON.parse(fs.readFileSync(lockPath, "utf8"));
  const lockRoot = lock.packages?.[""] ?? {};
  const fix = "run `npm install --package-lock-only`";

  if (lock.version !== packageJson.version) {
    problems.push(
      `package-lock.json is at ${lock.version} but the package is at ${packageJson.version} — ${fix}`
    );
  }
  if (lockRoot.version !== packageJson.version) {
    problems.push(
      `package-lock.json packages[""] is at ${lockRoot.version} but the package is at ` +
        `${packageJson.version} — ${fix}`
    );
  }
  const lockBins = Object.keys(lockRoot.bin ?? {}).sort().join(", ");
  const packageBins = Object.keys(packageJson.bin ?? {}).sort().join(", ");
  if (lockBins !== packageBins) {
    problems.push(
      `package-lock.json lists bins [${lockBins}] but package.json declares [${packageBins}] — ${fix}`
    );
  }
}

if (problems.length > 0) {
  for (const problem of problems) console.error(`FAIL: ${problem}`);
  process.exit(1);
}

console.log(
  `OK: tarball has ${files.length} files, every required entry, no sourcemaps, and the lockfile ` +
    `agrees with package.json ${packageJson.version}`
);
</file>

<file path="scripts/sync-docs.mjs">
/**
 * Keeps the version numbers inside the documentation in step with `package.json`.
 *
 * Docs that state a version rot the moment the version changes, and the failure is
 * silent: nothing goes red, the published README just starts lying. Hand-updating
 * them at each release is a step someone eventually skips.
 *
 * So the value lives in exactly one place and is injected into marked spans:
 *
 *     | <!--@majorMinor-->0.9<!--/@majorMinor-->.x | supported |
 *     npx codebase-snapshot@<!--@version-->0.9.0<!--/@version-->
 *
 * The markers are HTML comments, so GitHub renders the value and hides the syntax.
 * `--check` rewrites nothing and exits 1 when any span is stale, which is what CI
 * runs; without it the script fixes the files in place.
 *
 * Two shapes cannot hold a marker — a comment inside a fence renders as text — so
 * they are matched by shape instead: `Added devDependency: codebase-snapshot ^x.y.z`
 * and any `codebase-snapshot@x.y.z` install pin.
 *
 * Only the *current* version is synchronised. Changelog history stays a literal:
 * rewriting past entries would be falsifying a record, not maintaining it.
 */
import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const write = (...parts) => process.stdout.write(`${parts.join("")}\n`);

const pkg = JSON.parse(fs.readFileSync(path.join(ROOT, "package.json"), "utf8"));
const parts = pkg.version.split(".");
const VALUES = {
  version: pkg.version,
  majorMinor: `${parts[0]}.${parts[1]}`,
  major: parts[0],
};

/** Every documentation file that may carry a synchronised value. */
function targets() {
  // CHANGELOG.md is deliberately absent: it records what happened at each version, and
  // rewriting a past entry would falsify that record instead of maintaining it.
  const list = ["README.md", "SECURITY.md", "AGENTS.md", "llms.txt", "CONTRIBUTING.md"];
  const docs = path.join(ROOT, "docs");
  if (fs.existsSync(docs)) {
    for (const name of fs.readdirSync(docs)) {
      if (name.endsWith(".md")) list.push(path.join("docs", name));
    }
  }
  return list.filter((relative) => fs.existsSync(path.join(ROOT, relative)));
}

const check = process.argv.includes("--check");
const stale = [];

for (const relative of targets()) {
  const absolute = path.join(ROOT, relative);
  const before = fs.readFileSync(absolute, "utf8");
  let after = before;

  for (const [key, value] of Object.entries(VALUES)) {
    const pattern = new RegExp(`(<!--@${key}-->)[\\s\\S]*?(<!--/@${key}-->)`, "g");
    after = after.replace(pattern, (_match, open, close) => `${open}${value}${close}`);
  }

  // Code-block examples cannot carry HTML-comment markers: inside a fence the
  // comment is literal text, so the syntax leaks into the rendered page. They are
  // matched by shape instead, which keeps the source readable.
  after = after.replace(
    /(Added devDependency: codebase-snapshot \^)\d+\.\d+\.\d+/g,
    `$1${VALUES.version}`
  );
  // An install pin has the same problem in a different costume: an MCP client config is JSON
  // inside a fence, and `"args": ["-y", "codebase-snapshot@0.9.6", …]` cannot carry a marker
  // either. A pinned example naming the previous release is worse than a stale sentence —
  // copying it installs the wrong version — so it is rewritten by shape too. `@latest` does not
  // match, which is what the guides that do not want a pin use.
  after = after.replace(/(codebase-snapshot@)\d+\.\d+\.\d+/g, `$1${VALUES.version}`);
  // The run banner prints the version it is running and where it came from:
  // `Generator: 1.2.3 (project dependency ^1.2.3)`. It is inside a fence too, so it is matched
  // by shape. Without this, the sample output in `docs/cli.md` silently described the previous
  // release from the day after every publish.
  after = after.replace(
    /(Generator: )\d+\.\d+\.\d+( \(project dependency \^)\d+\.\d+\.\d+/g,
    `$1${VALUES.version}$2${VALUES.version}`
  );
  if (after !== before) {
    stale.push(relative);
    if (!check) fs.writeFileSync(absolute, after, "utf8");
  }
}

/**
 * The version also lives in two manifests that no document references.
 *
 * `src/version.ts` is what the CLI reports and what every manifest records as
 * `generator.version`; `packages/create/package.json` pins the scaffolder to the release it
 * installs. Bumping `package.json` alone left both behind, and the failure is quiet: the
 * package publishes, and `create-codebase-snapshot` then installs the *previous* release
 * while the CLI reports a version it is not. Three files, one source of truth.
 *
 * `--check` covers these too, so a release cannot drift by forgetting a step.
 */
function syncManifests() {
  const version = VALUES.version;

  const versionTs = path.join(ROOT, "src", "version.ts");
  const versionTsBefore = fs.readFileSync(versionTs, "utf8");
  const versionTsAfter = versionTsBefore.replace(
    /(export const GENERATOR_VERSION = ")\d+\.\d+\.\d+(")/,
    `$1${version}$2`
  );
  if (versionTsAfter === versionTsBefore && !versionTsBefore.includes(`"${version}"`)) {
    // A silent no-op here would publish a package that reports the wrong version, which is
    // exactly the class of lie this project forbids. Fail instead.
    throw new Error(
      "sync-docs: src/version.ts no longer declares `export const GENERATOR_VERSION = \"x.y.z\"`"
    );
  }
  if (versionTsAfter !== versionTsBefore) {
    stale.push("src/version.ts");
    if (!check) fs.writeFileSync(versionTs, versionTsAfter, "utf8");
  }

  const createPath = path.join(ROOT, "packages", "create", "package.json");
  if (!fs.existsSync(createPath)) return;
  const createBefore = fs.readFileSync(createPath, "utf8");
  const createJson = JSON.parse(createBefore);
  createJson.version = version;
  createJson.dependencies = { ...(createJson.dependencies ?? {}), [pkg.name]: `^${version}` };
  const createAfter = `${JSON.stringify(createJson, null, 2)}\n`;
  if (createAfter !== createBefore) {
    stale.push("packages/create/package.json");
    if (!check) fs.writeFileSync(createPath, createAfter, "utf8");
  }
}

syncManifests();

if (check) {
  if (stale.length > 0) {
    write(`sync-docs: ${stale.length} file(s) out of step with package.json ${pkg.version}:`);
    for (const file of stale) write(`  - ${file}`);
    write("sync-docs: run `npm run sync-docs` and commit the result");
    process.exit(1);
  }
  write(`sync-docs: every marked version agrees with package.json ${pkg.version}`);
} else {
  write(
    stale.length === 0
      ? `sync-docs: already current with package.json ${pkg.version}`
      : `sync-docs: updated ${stale.join(", ")} to ${pkg.version}`
  );
}
</file>

<file path="scripts/test-run.mjs">
#!/usr/bin/env node
/**
 * Runs the test suite inside a scratch directory this script owns and deletes.
 *
 * `node --test` writes every fixture the suite creates under the host temp directory.
 * A test that forgets its cleanup leaves one directory behind per run, and a Windows
 * delete that loses a race with an indexer fails quietly — five days of runs had
 * accumulated 616 leftover directories and about 600 MB. This wrapper points TEMP,
 * TMP and TMPDIR at one root, so a leak can only leak inside that root, and removes
 * the root when the run ends, whether the tests passed or failed.
 *
 * Usage:
 *   node scripts/test-run.mjs
 *   node scripts/test-run.mjs --experimental-test-coverage
 */
import { spawn } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const HERE = path.dirname(fileURLToPath(import.meta.url));
export const REPO_ROOT = path.join(HERE, "..");

/** The suite files, in a stable order, as paths relative to the repository root. */
export function suiteFiles(root = REPO_ROOT) {
  return fs
    .readdirSync(path.join(root, "tests"))
    .filter((name) => name.endsWith(".test.js"))
    .sort()
    .map((name) => path.join("tests", name));
}

/** Removes a directory tree, retrying the transient EPERM/EBUSY a child or an indexer can cause. */
export function removeTree(target) {
  try {
    fs.rmSync(target, { recursive: true, force: true, maxRetries: 5, retryDelay: 50 });
    return true;
  } catch (error) {
    if (error.code === "ENOENT") return true;
    console.error(`test-run: could not remove ${target}: ${error.message}`);
    return false;
  }
}

/** A directory under the host temp root that this script exclusively owns. */
export function makeScratchRoot() {
  return fs.mkdtempSync(path.join(os.tmpdir(), "cbs-test-run-"));
}

let activeScratch = null;

/**
 * Runs `node --test` with the temp environment redirected into a scratch root,
 * then removes the root. Resolves with the exit code and what the run left behind.
 */
export function runSuite({
  files = suiteFiles(),
  nodeArgs = [],
  cwd = REPO_ROOT,
  env = process.env,
  stdio = "inherit",
} = {}) {
  const scratch = makeScratchRoot();
  activeScratch = scratch;
  const childEnv = { ...env, TEMP: scratch, TMP: scratch, TMPDIR: scratch };
  // A test file that runs the suite (tests/temp-hygiene.test.js) inherits
  // NODE_TEST_CONTEXT, which makes the inner node --test believe it is already a
  // running child and skip the file it was handed. An inner run must execute what
  // it was asked to, so the marker is not passed down.
  delete childEnv.NODE_TEST_CONTEXT;
  return new Promise((resolve) => {
    const settle = (code) => {
      activeScratch = null;
      let leaked = [];
      try {
        leaked = fs.readdirSync(scratch);
      } catch (error) {
        if (error.code !== "ENOENT") throw error;
      }
      const removed = removeTree(scratch);
      if (leaked.length > 0) {
        const plural = leaked.length === 1 ? "entry" : "entries";
        const shown = leaked.slice(0, 5).join(", ");
        const more = leaked.length > 5 ? ", ..." : "";
        console.error(`test-run: removed ${leaked.length} leaked temp ${plural}: ${shown}${more}`);
      }
      resolve({ code, scratch, leftovers: leaked.length, removed });
    };
    const child = spawn(process.execPath, ["--test", ...nodeArgs, ...files], {
      cwd,
      env: childEnv,
      stdio,
    });
    child.on("error", (error) => {
      console.error(`test-run: could not start node --test: ${error.message}`);
      settle(1);
    });
    child.on("close", (code, signal) => settle(signal ? 1 : code ?? 1));
  });
}

// A Ctrl-C must not leave the scratch root behind either.
process.on("exit", () => {
  if (activeScratch) removeTree(activeScratch);
});

const cliPath = process.argv[1] ? pathToFileURL(path.resolve(process.argv[1])).href : "";
if (cliPath === import.meta.url) {
  const result = await runSuite({ nodeArgs: process.argv.slice(2) });
  process.exitCode = result.code;
}
</file>

<file path="src/ast/profiles/cfamily.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isTopLevel } from "./shared.js";

const INCLUDE = /^#\s*include\s*([<"])([^>"]+)[>"]/;
const DEFINE = /^#\s*define\s+([A-Za-z_]\w*)/;
const USING = /^using\s+(?:namespace\s+)?([\w:]+)\s*;/;
const TYPE_DECL = /^(?:typedef\s+)?(?:struct|union|class|enum)\s+([A-Za-z_]\w*)/;
const TYPEDEF = /^typedef\b[^;{}]*?\b([A-Za-z_]\w*)\s*;/;
const FUNCTION = /^[A-Za-z_][\w \t*&:<>,]*?\b([A-Za-z_]\w*)\s*\([^;]*\)\s*\{?\s*$/;
const NOT_A_FUNCTION = /^(?:if|for|while|switch|return|else|do|case|sizeof|catch|throw)\b/;

/**
 * C and C++: `#include`, `using`, type definitions, and function definitions.
 *
 * A function definition is recognised as a top-level line whose parameter list
 * closes at end of line and is followed by `{` — control-flow keywords are
 * excluded explicitly, because `if (x) {` looks identical otherwise.
 */
export const cfamilyProfile: LanguageProfile = {
  id: "cfamily",
  extensions: [".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hxx", ".m", ".mm"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("//") || trimmed.startsWith("/*") || trimmed.startsWith("*")) {
        return;
      }

      const included = INCLUDE.exec(trimmed);
      if (included) {
        // `#include "board.h"` is a header in this repository; `#include <stdio.h>` is a system
        // one. The two are recorded differently so the resolver can tell them apart — the quoted
        // form gets a `./` prefix, which is also how the local form is searched first.
        summary.imports.push(included[1] === '"' ? `./${included[2]}` : included[2]);
        return;
      }

      const used = USING.exec(trimmed);
      if (used) {
        summary.imports.push(used[1]);
        return;
      }

      const macro = DEFINE.exec(trimmed);
      if (macro) {
        summary.variables.push(macro[1]);
        return;
      }

      if (!isTopLevel(line)) return;

      const declared = TYPE_DECL.exec(line);
      if (declared) {
        const kind = /^typedef\s+enum/.test(line) || /^enum\b/.test(trimmed) ? "enum" : "type";
        if (kind === "enum") summary.enums.push(declared[1]);
        else summary.classes.push(declared[1]);
        summary.exports.push(declared[1]);
        return;
      }

      const aliased = TYPEDEF.exec(line);
      if (aliased) {
        summary.types.push(aliased[1]);
        summary.exports.push(aliased[1]);
        return;
      }

      if (NOT_A_FUNCTION.test(trimmed)) return;

      const fn = FUNCTION.exec(line);
      if (fn) {
        summary.functions.push(fn[1]);
        summary.exports.push(fn[1]);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/python.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isPublicName, isTopLevel } from "./shared.js";

const IMPORT = /^import\s+(.+)$/;
const FROM_IMPORT = /^from\s+([\w.]+)\s+import\s+(.+)$/;
const CLASS = /^class\s+([A-Za-z_]\w*)/;
const DEF = /^(?:async\s+)?def\s+([A-Za-z_]\w*)/;
const CONSTANT = /^([A-Z_][A-Z0-9_]*)\s*(?::[^=]+)?=/;
const ALL_DUNDER = /^__all__\s*=\s*\[([^\]]*)\]/;
/** `@app.get(...)`, `@router.post(...)`, `@bp.route(...)` — web handler decorators. */
const ROUTE_DECORATOR = /^\s*@[\w.]*\b(?:get|post|put|patch|delete|head|options|route)\s*\(/i;

/**
 * Python: imports, top-level classes and functions, module constants and
 * `__all__`.
 *
 * Only top-level declarations are recorded — a method inside a class is not a
 * module export, and pretending otherwise would fill `exports` with noise.
 */
export const pythonProfile: LanguageProfile = {
  id: "python",
  extensions: [".py", ".pyi"],
  summarize(_path, content) {
    const summary = emptySummary();
    let routePending = false;

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("#")) return;

      if (ROUTE_DECORATOR.test(line)) {
        routePending = true;
        return;
      }

      const from = FROM_IMPORT.exec(trimmed);
      if (from) {
        const module = from[1];
        // `from . import models` is the same edge as `from .models import …` — the module is the
        // name, and the leading dots are the package. Recording it as the bare `.` lost the edge:
        // the resolver had a package directory and no module in it. Only the name list form (which
        // the module path cannot spell) is expanded, and each name is its own edge because a
        // package's `__init__` and each submodule are separate files.
        if (/^\.+$/.test(module)) {
          for (const name of from[2].split(",")) {
            const imported = name.replace(/[()]/g, "").trim().split(/\s+as\s+/)[0].trim();
            if (/^[A-Za-z_]\w*$/.test(imported)) summary.imports.push(`${module}${imported}`);
          }
        } else {
          summary.imports.push(module);
        }
        routePending = false;
        return;
      }

      const imported = IMPORT.exec(trimmed);
      if (imported) {
        for (const part of imported[1].split(",")) {
          const name = part.trim().split(/\s+as\s+/)[0].trim();
          if (name) summary.imports.push(name);
        }
        routePending = false;
        return;
      }

      if (isTopLevel(line)) {
        const klass = CLASS.exec(line);
        if (klass) {
          summary.classes.push(klass[1]);
          if (isPublicName(klass[1])) summary.exports.push(klass[1]);
          routePending = false;
          return;
        }

        const definition = DEF.exec(line);
        if (definition) {
          const name = definition[1];
          summary.functions.push(name);
          if (routePending) {
            summary.routeHandlers.push(name);
            routePending = false;
          }
          if (isPublicName(name)) summary.exports.push(name);
          return;
        }

        const all = ALL_DUNDER.exec(trimmed);
        if (all) {
          for (const entry of all[1].split(",")) {
            const name = entry.trim().replace(/['"]/g, "").trim();
            if (name) summary.exports.push(name);
          }
          return;
        }

        const constant = CONSTANT.exec(line);
        if (constant) summary.variables.push(constant[1]);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/ruby.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isTopLevel } from "./shared.js";

const REQUIRE_RELATIVE = /^require_relative\s+["']([^"']+)["']/;
const REQUIRE = /^require\s+["']([^"']+)["']/;
const CLASS_OR_MODULE = /^(?:class|module)\s+([A-Z][\w:]*)/;
const METHOD = /^def\s+(?:self\.)?([A-Za-z_]\w*[?!=]?)/;

/** Ruby: `require`, `require_relative`, classes and modules, method definitions. */
export const rubyProfile: LanguageProfile = {
  id: "ruby",
  extensions: [".rb", ".rake", ".gemspec"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("#")) return;

      // The two forms are recorded differently on purpose: `require_relative "user"` is a path
      // beside this file, and `require "json"` is a gem. Recording both as the bare string they
      // were written with left the resolver unable to tell which was which, so it resolved
      // neither — and resolving a gem name as a path would invent an edge to any `json.rb` in the
      // repository.
      const relative = REQUIRE_RELATIVE.exec(trimmed);
      if (relative) {
        summary.imports.push(`./${relative[1]}`);
        return;
      }

      const required = REQUIRE.exec(trimmed);
      if (required) {
        summary.imports.push(required[1]);
        return;
      }

      if (!isTopLevel(line)) return;

      const declaration = CLASS_OR_MODULE.exec(line);
      if (declaration) {
        summary.classes.push(declaration[1]);
        summary.exports.push(declaration[1]);
        return;
      }

      const method = METHOD.exec(line);
      if (method) {
        summary.functions.push(method[1]);
        summary.exports.push(method[1]);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/profiles/sfc.ts">
import { summarizeTypeScriptSource } from "../ts-parser.js";
import type { LanguageProfile } from "./shared.js";
import { emptySummary, finalizeSummary } from "./shared.js";

const SCRIPT_BLOCK = /<script([^>]*)>([\s\S]*?)<\/script>/gi;

/** `lang="tsx"` / `lang='jsx'`: the block holds JSX, whatever the component's extension says. */
const JSX_LANG = /\blang\s*=\s*["']?[tj]sx\b/i;

/**
 * The `---` fence at the top of an Astro component.
 *
 * In Astro this fence *is* the component's script: it is where imports, props and
 * all the TypeScript live. Most real `.astro` files have no `<script>` tag at all,
 * so parsing only `<script>` blocks made the common case fall back to `heuristic`.
 */
const ASTRO_FRONTMATTER = /^\uFEFF?---[ \t]*\r?\n([\s\S]*?)\r?\n---[ \t]*(?=\r?\n|$)/;

function componentName(path: string): string {
  const base = path.split("/").pop() ?? path;
  return base.replace(/\.[^.]+$/, "");
}

/**
 * Vue, Svelte and Astro single-file components.
 *
 * The template is markup, but the `<script>` block is ordinary TypeScript — so
 * it is handed to the real compiler rather than pattern-matched. That makes the
 * summary `ast` quality whenever a script block exists, which is the common case.
 */
export const sfcProfile: LanguageProfile = {
  id: "sfc",
  extensions: [".vue", ".svelte", ".astro"],
  summarize(path, content) {
    let script = "";
    // Which script kind the block is parsed as. A `.ts` kind reads `<div>hi</div>` as a type
    // assertion and then reports four to six parse errors for a file that is perfectly valid —
    // and never records the component, because it finds no JSX. Astro frontmatter is JSX-capable
    // by construction, and a Vue or Svelte block says so with `lang="tsx"` / `lang="jsx"`.
    let usesJsx = path.toLowerCase().endsWith(".astro");

    // Astro keeps its script in a leading `---` fence rather than a <script> tag.
    if (path.toLowerCase().endsWith(".astro")) {
      const frontmatter = ASTRO_FRONTMATTER.exec(content);
      if (frontmatter) script += `${frontmatter[1]}\n`;
    }

    for (const match of content.matchAll(SCRIPT_BLOCK)) {
      if (JSX_LANG.test(match[1] ?? "")) usesJsx = true;
      script += `${match[2]}\n`;
    }

    const name = componentName(path);

    if (!script.trim()) {
      // A template-only component still deserves an entry in the index.
      const summary = emptySummary();
      if (name) {
        summary.exports.push(name);
        summary.reactComponents.push(name);
      }
      return { summary: finalizeSummary(summary), quality: "heuristic" };
    }

    const summary = summarizeTypeScriptSource(`${name}.${usesJsx ? "tsx" : "ts"}`, script);
    // `summarizeTypeScriptSource` already sorted and de-duplicated its lists, and the
    // component name is pushed afterwards — so a component whose script also exported
    // its own name (the normal `<script setup>` shape) was listed twice, and the index
    // that consumers search was not in the order it claims. `finalizeSummary` restores
    // both invariants after the push.
    summary.reactComponents.push(name);
    summary.exports.push(name);
    return { summary: finalizeSummary(summary), quality: "ast" };
  },
};
</file>

<file path="src/ast/profiles/swift.ts">
import type { LanguageProfile } from "./shared.js";
import { eachLine, emptySummary, finalizeSummary, isPublicName, isTopLevel } from "./shared.js";

/**
 * Declaration modifiers, including attributes with arguments (`@available(iOS 15, *)`).
 *
 * `class` is deliberately *not* in this list even though `class func` exists: consuming it as
 * a modifier made `public final class Cache` parse as "modifiers, then a declaration starting
 * at `Cache`", so every type declaration in the language was missed.
 */
const MODIFIERS =
  "(?:@\\w+(?:\\([^)]*\\))?\\s+|(?:public|open|internal|fileprivate|private|final|static|mutating|nonmutating|override|required|convenience|lazy|weak|unowned)\\s+)*";

const TYPE = new RegExp(`^${MODIFIERS}(class|struct|enum|protocol|actor|extension)\\s+([A-Za-z_]\\w*)`);
const FUNC = new RegExp(`^${MODIFIERS}func\\s+([A-Za-z_]\\w*)`);
const PROPERTY = new RegExp(`^${MODIFIERS}(?:let|var)\\s+([A-Za-z_]\\w*)`);
const IMPORT = /^import\s+([A-Za-z_][\w.]*)/;

/**
 * Swift: types, functions, properties and imports.
 *
 * The declaration keywords are usually preceded by modifiers (`public final class`,
 * `fileprivate struct`, `@objc protocol`), so the pattern consumes any run of attribute and
 * modifier words before the keyword. `protocol` is Swift's interface, and `actor` is a
 * concurrency-constrained class — both are classes to a reader who wants an outline.
 *
 * Visibility is explicit in Swift: only `public` and `open` leave the module, so only those
 * are recorded as exports. A `internal` (the default) declaration is not an export and
 * saying it is would make the index lie about the API.
 */
export const swiftProfile: LanguageProfile = {
  id: "swift",
  extensions: [".swift"],
  summarize(_path, content) {
    const summary = emptySummary();

    eachLine(content, (line) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("//")) return;

      const imported = IMPORT.exec(trimmed);
      if (imported) {
        summary.imports.push(imported[1]);
        return;
      }

      if (!isTopLevel(line)) return;
      // `public`/`open` is what makes a declaration part of the module's API.
      const exported = /\b(?:public|open)\b/.test(trimmed);

      const type = TYPE.exec(trimmed);
      if (type) {
        const [, keyword, name] = type as RegExpExecArray & [string, string, string];
        if (keyword === "protocol") summary.interfaces.push(name);
        else if (keyword === "enum") summary.enums.push(name);
        else if (keyword === "extension") summary.types.push(name);
        else summary.classes.push(name);
        if (exported) summary.exports.push(name);
        return;
      }

      const func = FUNC.exec(trimmed);
      if (func) {
        const name = (func as RegExpExecArray & [string, string])[1];
        summary.functions.push(name);
        if (exported) summary.exports.push(name);
        return;
      }

      const property = PROPERTY.exec(trimmed);
      if (property) {
        const name = (property as RegExpExecArray & [string, string])[1];
        summary.variables.push(name);
        if (exported && isPublicName(name)) summary.exports.push(name);
      }
    });

    return { summary: finalizeSummary(summary), quality: "heuristic" };
  },
};
</file>

<file path="src/ast/imports.ts">
/**
 * The import specifiers one file declares, read exactly the way `generate` reads them.
 *
 * `--with-dependents` is decided from the generated summaries, so anything that has to answer the
 * same question later — `explain`, `validate` — must parse the file the same way. A second,
 * simpler "find the import lines" implementation is how two accounts of one import graph begin:
 * it would disagree on `require`, on `${…}` in a dynamic import, on a file the parser rejected,
 * and the disagreement would surface as a snapshot that is "drifted" or an explanation that is
 * wrong, neither of which points at the real cause.
 *
 * The size ceiling is part of that agreement. `generateSnapshot` refuses to build a structural
 * summary for a body over {@link SUMMARY_MAX_SOURCE_BYTES} — the TypeScript parser's AST costs far
 * more memory than the file — and this module used to have no ceiling at all, so `validate` and
 * `explain` read and parsed files the generator had skipped. Whichever way the rule goes, all
 * three commands have to answer it the same way; they answer it by sharing this constant.
 */
import * as fs from "node:fs";

import { summarizeTypeScriptSource } from "./ts-parser.js";
import { summarizeWithProfile } from "./profiles/index.js";
import { decodeText } from "../scanner/binary.js";

/**
 * The largest body that gets a structural summary.
 *
 * Exported because it is a documented boundary, not an implementation detail: a file above it has
 * no summary, and therefore no imports, in every command.
 */
export const SUMMARY_MAX_SOURCE_BYTES = 2 * 1024 * 1024;

/** Extensions the generator hands to the TypeScript summarizer. */
const TS_SOURCE_EXTENSIONS = [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"];

const isTsSource = (relativePath: string): boolean => {
  const lower = relativePath.toLowerCase();
  return TS_SOURCE_EXTENSIONS.some((extension) => lower.endsWith(extension));
};

/** Import specifiers from text already decoded, or `[]` when the language has no importer. */
export function importsOfText(relativePath: string, text: string): string[] {
  if (Buffer.byteLength(text, "utf8") > SUMMARY_MAX_SOURCE_BYTES) return [];
  if (isTsSource(relativePath)) return summarizeTypeScriptSource(relativePath, text).imports;
  return summarizeWithProfile(relativePath, text)?.summary.imports ?? [];
}

/**
 * Import specifiers of one file on disk.
 *
 * A file this cannot read, a binary file, an oversized file and a file the parser rejects all
 * contribute `[]`, which is what the generator saw for them too — so the answer stays consistent
 * with the snapshot rather than becoming a third opinion about it.
 */
export function importsOfFile(relativePath: string, absolutePath: string): string[] {
  let buffer: Buffer;
  try {
    // Stat first: reading a 50 MB file to discover it is over the ceiling is the cost this
    // ceiling exists to avoid.
    const stats = fs.statSync(absolutePath);
    if (!stats.isFile() || stats.size > SUMMARY_MAX_SOURCE_BYTES) return [];
    buffer = fs.readFileSync(absolutePath);
  } catch {
    return [];
  }
  const decoded = decodeText(buffer);
  if (decoded.binary) return [];
  return importsOfText(relativePath, decoded.text);
}
</file>

<file path="src/generator/comments.ts">
import ts from "typescript";

/**
 * Comment stripping for JavaScript and TypeScript.
 *
 * The TypeScript parser decides what is a comment, not a regular expression: a comment marker inside
 * a string, a template literal, a regex literal or a JSX attribute is not a comment, and a naive
 * stripper corrupts the code it claims only to trim. Comment text is removed but its newlines are
 * kept, so every line number in the manifest still points at the same line.
 *
 * The ranges come from the parser trivia API (`getLeadingCommentRanges` / `getTrailingCommentRanges`)
 * over every node, which is how the TypeScript formatter finds comments: a scanner alone cannot
 * tell a division from the start of a regex literal, and that ambiguity is what made a trailing
 * comment survive after a regex on the same line.
 */

const STRIPPABLE = /\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$/i;

export function isCommentStrippable(relativePath: string): boolean {
  return STRIPPABLE.test(relativePath);
}

export interface StripResult {
  text: string;
  /** Comment characters removed, before newline preservation. */
  removed: number;
}

function scriptKind(relativePath: string): ts.ScriptKind {
  if (/\.tsx$/i.test(relativePath)) return ts.ScriptKind.TSX;
  if (/\.jsx$/i.test(relativePath)) return ts.ScriptKind.JSX;
  if (/\.(js|mjs|cjs)$/i.test(relativePath)) return ts.ScriptKind.JS;
  return ts.ScriptKind.TS;
}

export function stripComments(text: string, relativePath: string): StripResult {
  let source: ts.SourceFile;
  try {
    source = ts.createSourceFile(relativePath, text, ts.ScriptTarget.Latest, true, scriptKind(relativePath));
  } catch {
    return { text, removed: 0 };
  }

  const ranges: Array<[number, number]> = [];
  const collect = (ranges_: readonly ts.CommentRange[] | undefined): void => {
    if (ranges_ === undefined) return;
    for (const range of ranges_) ranges.push([range.pos, range.end]);
  };
  const visit = (node: ts.Node): void => {
    collect(ts.getLeadingCommentRanges(text, node.getFullStart()));
    collect(ts.getTrailingCommentRanges(text, node.getEnd()));
    ts.forEachChild(node, visit);
  };
  visit(source);
  // Comments after the last token are trailing trivia of the end-of-file token.
  collect(ts.getLeadingCommentRanges(text, source.endOfFileToken.getFullStart()));

  if (ranges.length === 0) return { text, removed: 0 };
  ranges.sort((left, right) => left[0] - right[0]);
  const merged: Array<[number, number]> = [];
  for (const range of ranges) {
    const last = merged[merged.length - 1];
    if (last !== undefined && range[0] <= last[1]) last[1] = Math.max(last[1], range[1]);
    else merged.push([range[0], range[1]]);
  }

  const pieces: string[] = [];
  let copied = 0;
  let removed = 0;
  for (const [start, end] of merged) {
    pieces.push(text.slice(copied, start));
    // Keep the newlines so line numbers do not move.
    pieces.push(text.slice(start, end).replace(/[^\n]/g, ""));
    removed += end - start;
    copied = end;
  }
  pieces.push(text.slice(copied));
  return { text: pieces.join(""), removed };
}
</file>

<file path="src/generator/diff.ts">
import { spawnSync } from "node:child_process";

// The uncommitted diff, as an artifact.
//
// A snapshot describes the tree on disk; a reviewer also needs to know what changed since the last
// commit. This is the one artifact not derived from the files the snapshot carries, so it names the
// git command that produced it, and it is bounded: a larger diff is truncated with a note.

export interface DiffReport {
  text: string;
  bytes: number;
  truncated: boolean;
  paths: string[];
}

function runGit(cwd: string, args: string[]): { ok: boolean; out: string } {
  const result = spawnSync("git", args, { cwd, encoding: "utf8", windowsHide: true, maxBuffer: 64 * 1024 * 1024 });
  if (result.status !== 0) return { ok: false, out: (result.stderr ?? "").trim() };
  return { ok: true, out: result.stdout ?? "" };
}

export function isGitRepository(cwd: string): boolean {
  return runGit(cwd, ["rev-parse", "--is-inside-work-tree"]).out.trim() === "true";
}

export function generateDiffReport(cwd: string, options: { maxBytes?: number } = {}): DiffReport | null {
  if (!isGitRepository(cwd)) return null;
  const maxBytes = options.maxBytes ?? 200 * 1024;
  const sections: string[] = [];
  let bytes = 0;
  let truncated = false;

  const commands: Array<[string, string[]]> = [
    ["Unstaged", ["diff", "--no-color"]],
    ["Staged", ["diff", "--cached", "--no-color"]],
  ];
  for (const [title, args] of commands) {
    const result = runGit(cwd, args);
    if (!result.ok || result.out.trim() === "") continue;
    const body = result.out;
    bytes += Buffer.byteLength(body, "utf8");
    const used = Buffer.byteLength(sections.join(""), "utf8");
    const remaining = Math.max(0, maxBytes - used);
    const chunk = Buffer.byteLength(body, "utf8") > remaining ? body.slice(0, remaining) : body;
    if (chunk.length < body.length) truncated = true;
    sections.push("## " + title + " changes\n\nRun: git " + args.join(" ") + "\n\n```diff\n" + chunk + "\n```");
  }

  if (sections.length === 0) return null;
  const paths = new Set<string>();
  for (const match of sections.join("\n").matchAll(/^\+\+\+ b\/(.+)$/gm)) paths.add(match[1]);
  const text = [
    "# Uncommitted changes",
    "",
    "Generated from the repository at the moment the snapshot was written. Untracked files are not",
    "in a diff until they are added; this artifact says what git reports, not what git ignores.",
    "",
    ...sections,
    ...(truncated ? ["", "> Truncated at " + maxBytes + " bytes. Run git diff for the rest."] : []),
    "",
  ].join("\n");
  return { text, bytes, truncated, paths: [...paths].sort() };
}
</file>

<file path="src/generator/log.ts">
import { spawnSync } from "node:child_process";

// Recent commits, as an artifact: the history the snapshot was built from, bounded and one line
// per commit, with the command that produced it.

export interface LogReport {
  text: string;
  count: number;
}

export function generateLogReport(cwd: string, options: { count?: number; maxBytes?: number } = {}): LogReport | null {
  const count = Math.max(1, Math.min(500, options.count ?? 20));
  const maxBytes = options.maxBytes ?? 64 * 1024;
  const result = spawnSync(
    "git",
    ["log", "-n", String(count), "--date=short", "--pretty=format:%h%x09%ad%x09%s", "--no-color"],
    { cwd, encoding: "utf8", windowsHide: true, maxBuffer: 16 * 1024 * 1024 }
  );
  if (result.status !== 0) return null;
  const body = (result.stdout ?? "").trim();
  if (body === "") return null;
  const lines = body.split("\n");
  const text = [
    "# Recent commits",
    "",
    "The last " + count + " commits, newest first, one line each.",
    "",
    "```text",
    lines.join("\n").slice(0, maxBytes),
    "```",
    "",
  ].join("\n");
  return { text, count: lines.length };
}
</file>

<file path="src/generator/sarif.ts">
/**
 * SARIF 2.1.0, so a redacted secret becomes a finding a CI gate can see.
 *
 * `reports/audit.md` tells a human what was masked. Nothing could *gate* on it: a CI job that
 * wanted to fail a build over a leaked key had to scrape markdown, and an uploaded finding had
 * to be re-derived by whatever security scanner the repository already ran. SARIF is the format
 * GitHub Code Scanning reads, so the same facts go straight into a code-scanning alert.
 *
 * The findings are the redaction events this run produced — one per line, with the rule names
 * that matched. The line content is deliberately **not** included: this artifact is meant to be
 * uploaded to a third party, and quoting the matched span would be a second copy of the secret
 * in a place with a different retention policy. A code-scanning alert with a path and a line
 * number is enough to act on.
 */
import * as crypto from "node:crypto";
import { DEFAULT_SECRET_PATTERNS } from "../security/patterns.js";
import type { Manifest, SecretFinding, SecretRule } from "../types.js";

/** SARIF's document version and schema. */
const SARIF_VERSION = "2.1.0";
const SARIF_SCHEMA = "https://json.schemastore.org/sarif-2.1.0.json";

/**
 * Rule identifiers, stable across runs and across configurations.
 *
 * A rule id that moves orphans every open code-scanning alert that referenced it, and the
 * previous scheme moved them: ids were handed out by position in the *alphabetically sorted* set
 * of rule names this run happened to use, so a single custom rule sorting before the built-ins
 * (`acme-key` does) shifted every built-in id by one and re-pointed every existing alert at a
 * different rule.
 *
 * Built-in rules therefore take a fixed id from the order they are **declared** in
 * `patterns.ts`, which does not depend on which rules are active or on how the caller spelled
 * their config. Anything else — a `customPatterns` rule — gets an id hashed from its own name:
 * stable, independent of sort order, and unable to collide with the three-digit built-in ids
 * because the two shapes are disjoint.
 *
 * This renumbers the built-in rules once, relative to 0.9.10. That is the last time they move.
 */
const BUILTIN_RULE_IDS: ReadonlyMap<string, string> = new Map(
  [
    ...DEFAULT_SECRET_PATTERNS.map((rule) => rule.rule),
    // Produced by the whole-block pass in `redact.ts`, not by a pattern in the catalogue.
    "private-key-block",
  ].map((name, index) => [name, `CS${String(index + 1).padStart(3, "0")}`] as const)
);

/** Id for a rule that is not built in: eight hex digits of its own name. */
function ruleIdFor(name: string): string {
  const builtin = BUILTIN_RULE_IDS.get(name);
  if (builtin !== undefined) return builtin;
  const digest = crypto.createHash("sha256").update(name).digest("hex").slice(0, 8);
  return `CS${digest.toUpperCase()}`;
}

/**
 * Renders the findings as a SARIF log.
 *
 * Every result carries the file and line, a `level` of `note` — a redaction is the tool doing
 * its job, not a build failure — and the rule that matched. `partialFingerprints` gives Code
 * Scanning a stable identity for an alert across commits, built from the path, the rules and
 * the line, so re-running `generate` does not close and reopen every alert.
 */
export function generateSarifReport(
  manifest: Manifest,
  findings: readonly SecretFinding[],
  rules: readonly SecretRule[],
  toolVersion: string
): string {
  // The rule catalogue comes from the rules the run actually used, in a stable order, so the
  // same configuration always produces the same document.
  const ruleNames = Array.from(
    new Set([...rules.map((rule) => rule.rule), ...findings.flatMap((finding) => finding.rules)])
  ).sort();

  const ruleIndex = new Map<string, number>();
  const sarifRules = ruleNames.map((name, index) => {
    ruleIndex.set(name, index);
    const id = ruleIdFor(name);
    return {
      id,
      name,
      shortDescription: { text: `Credential-shaped value masked by the "${name}" rule` },
      defaultConfiguration: { level: "note" },
      help: {
        text:
          "A value in this line matched a secret pattern and was replaced with a redaction " +
          "marker in the snapshot. If this is a real credential, rotate it; if it is a fixture, " +
          "the placeholder can be made unmistakable.",
      },
    };
  });

  const results = findings
    .filter((finding) => typeof finding.path === "string" && finding.path.length > 0)
    .map((finding) => {
      const primary = finding.rules[0] ?? "unknown";
      const line = Math.max(1, finding.line);
      const findingPath = String(finding.path).replace(/\\/g, "/");
      return {
        ruleId: ruleIdFor(primary),
        ruleIndex: ruleIndex.get(primary) ?? 0,
        level: "note" as const,
        message: {
          text: `Credential-shaped value masked (rule${finding.rules.length === 1 ? "" : "s"}: ${finding.rules.join(", ")})`,
        },
        locations: [
          {
            physicalLocation: {
              artifactLocation: { uri: findingPath, uriBaseId: "%SRCROOT%" },
              region: { startLine: line },
            },
          },
        ],
        partialFingerprints: {
          // Stable across commits for the same finding, which is what keeps an alert open
          // instead of closing and reopening it on every run.
          codebaseSnapshotFinding: `${findingPath}#L${line}#${finding.rules.join("+")}`,
        },
      };
    })
    // Code-unit order, never `localeCompare`: the same commit has to produce the same SARIF
    // bytes on every machine, and `localeCompare` orders `a-b.ts` against `A.B.ts` differently
    // under `en` and `sv`. Three neighbours already compare code units for this reason —
    // `tree.ts`, `terminal.ts` and `tokenize.ts` — and rule-id stability in this file was
    // solved the same way.
    .sort((a, b) => {
      const left = a.locations[0].physicalLocation.artifactLocation.uri;
      const right = b.locations[0].physicalLocation.artifactLocation.uri;
      return (
        (left < right ? -1 : left > right ? 1 : 0) ||
        a.locations[0].physicalLocation.region.startLine -
          b.locations[0].physicalLocation.region.startLine
      );
    });

  const log = {
    $schema: SARIF_SCHEMA,
    version: SARIF_VERSION,
    runs: [
      {
        tool: {
          driver: {
            name: "codebase-snapshot",
            version: toolVersion,
            informationUri: "https://github.com/ankurhalder/codebase-snapshot",
            rules: sarifRules,
          },
        },
        automationDetails: {
          // The snapshot's own fingerprint: two uploads of the same snapshot are the same run,
          // so Code Scanning can tell an unchanged upload from a new one.
          id: `codebase-snapshot/${manifest.fingerprint}`,
        },
        originalUriBaseIds: { "%SRCROOT%": { uri: "file:///" } },
        results,
      },
    ],
  };

  return `${JSON.stringify(log, null, 2)}\n`;
}
</file>

<file path="src/generator/tokens.ts">
import type { Manifest } from "../types.js";

// Per-file token counts, grouped by directory. The manifest carries a total; a reader deciding
// what to drop needs the breakdown, sorted by cost, with directory rollups.

export interface TokenTreeReport {
  text: string;
  heaviest: Array<{ path: string; tokens: number }>;
}

function tokensOf(bytes: number): number {
  return Math.max(1, Math.ceil(bytes * 0.25));
}

export function generateTokenTree(manifest: Manifest): TokenTreeReport | null {
  if (manifest.files.length === 0) return null;
  const rows = manifest.files
    .map((file) => ({ path: file.relativePath, layer: file.layer, part: file.part, tokens: tokensOf(file.includedBytes) }))
    .sort((left, right) => right.tokens - left.tokens || left.path.localeCompare(right.path));

  const byDirectory = new Map<string, number>();
  for (const row of rows) {
    const directory = row.path.includes("/") ? row.path.slice(0, row.path.lastIndexOf("/")) : ".";
    byDirectory.set(directory, (byDirectory.get(directory) ?? 0) + row.tokens);
  }
  const directories = [...byDirectory.entries()].sort((left, right) => right[1] - left[1]);
  const total = rows.reduce((sum, row) => sum + row.tokens, 0);

  const rowsTable = rows.map((row) => "| " + row.path + " | " + row.layer + " | " + row.part + " | " + row.tokens + " |");
  const directoryTable = directories.map(
    (entry) => "| " + entry[0] + " | " + entry[1] + " | " + ((entry[1] / total) * 100).toFixed(1) + "% |"
  );

  const text = [
    "# Token tree",
    "",
    "Estimated tokens per file (one token per four bytes of emitted body), sorted by cost. The total",
    "is the same estimate the manifest carries: an estimate, not a count.",
    "",
    "## Directories",
    "",
    "| Directory | Tokens | Share |",
    "| :-- | --: | --: |",
    ...directoryTable,
    "",
    "## Files",
    "",
    "| File | Layer | Part | Tokens |",
    "| :-- | :-- | :-- | --: |",
    ...rowsTable,
    "",
    "**Total: " + total + " tokens across " + rows.length + " files.**",
    "",
  ].join("\n");

  return { text, heaviest: rows.slice(0, 20).map((row) => ({ path: row.path, tokens: row.tokens })) };
}
</file>

<file path="src/generator/tree.ts">
import { fenceForText } from "../partitioner/chunker.js";
import { escapeControls } from "../terminal.js";

/**
 * Builds an ASCII directory tree.
 *
 * Ordering is a plain code-unit comparison, not `localeCompare`: the tree used
 * to sort differently depending on the machine's locale/ICU data. Directories
 * are suffixed with `/` so a file and a directory with the same name are no
 * longer indistinguishable, and the output is capped so a huge repository cannot
 * produce an unbounded report.
 *
 * The walk is iterative: the recursive version blew the stack on a repository
 * with ~6000 nested directories ("Maximum call stack size exceeded", exit 1, no
 * snapshot at all). Depth is also capped — a hostile checkout cannot force an
 * unbounded number of indentation levels through this report.
 */
const MAX_TREE_LINES = 20_000;
const MAX_TREE_DEPTH = 512;

interface TreeNode {
  children: Map<string, TreeNode>;
}

interface WalkFrame {
  node: TreeNode;
  prefix: string;
  depth: number;
  keys: string[];
  index: number;
}

function childKeys(node: TreeNode): string[] {
  return Array.from(node.children.keys()).sort((a, b) => {
    const aIsDir = node.children.get(a)!.children.size > 0;
    const bIsDir = node.children.get(b)!.children.size > 0;
    if (aIsDir !== bIsDir) return aIsDir ? -1 : 1;
    return a < b ? -1 : a > b ? 1 : 0;
  });
}

export function generateProjectTree(filePaths: string[]): string {
  const root: TreeNode = { children: new Map() };

  for (const filePath of filePaths) {
    const parts = filePath.split("/").filter((part) => part.length > 0);
    let current = root;
    for (const part of parts) {
      let child = current.children.get(part);
      if (!child) {
        child = { children: new Map() };
        current.children.set(part, child);
      }
      current = child;
    }
  }

  const lines: string[] = ["."];
  let truncatedAt = -1;
  let depthTruncated = false;

  const stack: WalkFrame[] = [{ node: root, prefix: "", depth: 0, keys: childKeys(root), index: 0 }];
  while (stack.length > 0) {
    const frame = stack[stack.length - 1];
    if (frame.index >= frame.keys.length) {
      stack.pop();
      continue;
    }
    const key = frame.keys[frame.index];
    frame.index += 1;
    const isLast = frame.index === frame.keys.length;
    const child = frame.node.children.get(key)!;
    const isDirectory = child.children.size > 0;
    // Sorting stays on the raw name; only the rendered label is escaped, so a
    // bidi override in a name cannot reorder the tree visually or the list.
    const label = escapeControls(key);
    lines.push(`${frame.prefix}${isLast ? "└── " : "├── "}${label}${isDirectory ? "/" : ""}`);
    if (lines.length >= MAX_TREE_LINES) {
      truncatedAt = lines.length;
      break;
    }
    if (!isDirectory) continue;
    if (frame.depth + 1 > MAX_TREE_DEPTH) {
      depthTruncated = true;
      continue;
    }
    stack.push({
      node: child,
      prefix: frame.prefix + (isLast ? "    " : "│   "),
      depth: frame.depth + 1,
      keys: childKeys(child),
      index: 0,
    });
  }

  if (truncatedAt !== -1) {
    lines.push(`... [tree truncated at ${MAX_TREE_LINES} lines] ...`);
  } else if (depthTruncated) {
    lines.push(`... [tree truncated at ${MAX_TREE_DEPTH} levels] ...`);
  }

  // Chosen from the rendered tree: a filename may contain a backtick run, and a
  // fixed three-backtick fence would let it close the block.
  const fence = fenceForText(lines.join("\n"), 3);
  return ["# Project Tree", "", `${fence}text`, ...lines, fence, ""].join("\n");
}

/**
 * A manifest warning for each cap the rendered tree reports.
 *
 * The tree carries its own marker, but a reader of the manifest learns nothing from an artifact
 * they did not open — so the truncation is also a warning. Only the depth form was matched: a tree
 * cut at the 20 000-line cap said so in the artifact and nothing in the manifest, and the two views
 * of one fact disagreed.
 *
 * Exported so the mapping is testable without building a 20 000-file repository.
 */
export function treeTruncationWarnings(treeText: string): string[] {
  const warnings: string[] = [];
  const depth = /\[tree truncated at (\d+) levels\]/.exec(treeText);
  if (depth) {
    warnings.push(
      `reports/project-tree.md was truncated at the ${depth[1]}-level depth cap: ` +
        "deeper directories are not listed there."
    );
  }
  const lines = /\[tree truncated at (\d+) lines\]/.exec(treeText);
  if (lines) {
    warnings.push(
      `reports/project-tree.md was truncated at the ${lines[1]}-line cap: ` +
        "the rest of the tree is not listed there."
    );
  }
  return warnings;
}
