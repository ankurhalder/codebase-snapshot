<file path="tests/cli-argument-errors.test.js">
/**
 * Usage errors that have to name the thing the developer actually typed.
 *
 * `snapshot -version` used to answer `Unknown option '-e'` — `parseArgs` had split the token into
 * the short-flag cluster `-v -e -r -s -i -o -n` and complained about the third character. That
 * names a character nobody typed and hides the real mistake, which is one dash where two belong.
 * Reported from a real terminal session, by someone trying to find out which version they had.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const BIN = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "dist", "bin.js");

function run(args) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    cwd: os.tmpdir(),
    encoding: "utf8",
    timeout: 20_000,
  });
  assert.equal(result.error, undefined);
  return { status: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

test("a long option written with one dash names the whole token", () => {
  const result = run(["-version"]);
  assert.equal(result.status, 2);
  assert.match(result.stderr, /Unknown option '-version'/, "the token that was typed, in full");
  assert.match(result.stderr, /--version/, "and the spelling that would have worked");
  assert.doesNotMatch(result.stderr, /'-e'/, "not a single character out of the middle of it");
});

test("every misdashed option suggests its own long form", () => {
  for (const [typed, suggestion] of [
    ["-help", "--help"],
    ["-format", "--format"],
    ["-cwd", "--cwd"],
    ["-dry-run", "--dry-run"],
  ]) {
    const result = run([typed]);
    assert.equal(result.status, 2, `${typed}: exit`);
    assert.match(result.stderr, new RegExp(`Unknown option '${typed}'`), `${typed}: names it`);
    assert.match(result.stderr, new RegExp(suggestion), `${typed}: suggests ${suggestion}`);
  }
});

test("a misdashed option that is not an option points at -- instead", () => {
  const result = run(["-frobnicate"]);
  assert.equal(result.status, 2);
  assert.match(result.stderr, /Unknown option '-frobnicate'/);
  assert.doesNotMatch(result.stderr, /did you mean/, "there is no --frobnicate to suggest");
  assert.match(result.stderr, /after '--'/, "the way to pass something that starts with a dash");
});

test("a cluster of real short flags still works", () => {
  const result = run(["-vh"]);
  assert.equal(result.status, 0, "-vh is -v -h, both of which exist");
  // Help wins over the version line, so this is the usage text, which names the version in its
  // first line. What matters is that the cluster was not rejected as a misdashed option.
  assert.match(result.stdout, /codebase-snapshot v\d+\.\d+\.\d+/);
  assert.match(result.stdout, /Usage:/);
});

test("the misdashed message keeps the --format json contract", () => {
  const result = run(["--format", "json", "-version"]);
  assert.equal(result.status, 2);
  const document = JSON.parse(result.stdout);
  assert.equal(document.error.exitCode, 2);
  assert.match(document.error.message, /did you mean '--version'/);
});

test("a value that looks like a misdashed option is not swallowed", () => {
  // `--include` takes a value, so `--include -version` is still an option to the parser; the point
  // is that the error explains it rather than silently accepting the token as a glob.
  const result = run(["generate", "--include", "-version"]);
  assert.equal(result.status, 2);
  assert.match(result.stderr, /-version/);
});

/** A fixture for the commands that take positional arguments. */
function makeRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cli-mode-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "src", "index.ts"), "export const a = 1;\n");
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function runIn(cwd, args) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    cwd,
    encoding: "utf8",
    timeout: 20_000,
  });
  assert.equal(result.error, undefined);
  return { status: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

test("--mode can run a command that takes positional arguments", (t) => {
  // The positionals used to be resolved as a command word before `--mode` was consulted, so
  // `--mode explain src/index.ts` answered `Unknown command "src/index.ts"` and the documented
  // `--mode` form of the two positional commands could not run at all.
  const dir = makeRepo(t);

  const explained = runIn(dir, ["--mode", "explain", "src/index.ts", "--format", "json"]);
  assert.equal(explained.status, 0, explained.stderr);
  const explanation = JSON.parse(explained.stdout);
  assert.equal(explanation.path, "src/index.ts", "the path is the argument, not the command name");

  assert.equal(runIn(dir, ["generate"]).status, 0);
  const diffed = runIn(dir, [
    "--mode",
    "diff",
    "snapshot/manifest.json",
    "snapshot/manifest.json",
    "--format",
    "json",
  ]);
  assert.equal(diffed.status, 0, diffed.stderr);
  const diff = JSON.parse(diffed.stdout);
  assert.ok(diff.before && diff.after, "two manifests were compared");
});

test("--mode keeps rejecting a contradiction and an unknown command", (t) => {
  const dir = makeRepo(t);

  const contradiction = runIn(dir, ["generate", "--mode", "validate"]);
  assert.equal(contradiction.status, 2);
  assert.match(contradiction.stderr, /contradicts the command/);

  const missing = runIn(dir, ["--mode", "explain"]);
  assert.equal(missing.status, 2);
  assert.match(missing.stderr, /explain expects exactly one path/);

  const unknown = runIn(dir, ["--mode", "not-a-command"]);
  assert.equal(unknown.status, 2);
  assert.match(unknown.stderr, /Unknown --mode "not-a-command"/);
});
</file>

<file path="tests/cli-contract-fixes.test.js">
import assert from "node:assert/strict";
import { spawn, spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const BIN = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "dist", "bin.js");

function run(args, cwd) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    cwd,
    encoding: "utf8",
    timeout: 20_000,
  });
  assert.equal(result.error, undefined);
  return { status: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cs-contract-fixes-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

test("usage errors honour --format json with one parseable document", () => {
  const cases = [
    ["--format", "json", "--bogus"],
    ["validate", "--format", "json", "extra"],
    ["generate", "--format", "json", "--max-part-bytes", "nope"],
    ["generate", "--format=json", "--cwd", path.join(os.tmpdir(), "cs-missing-dir")],
  ];
  for (const args of cases) {
    const result = run(args, os.tmpdir());
    assert.equal(result.status, 2, `${args.join(" ")}: exit`);
    assert.ok(result.stdout.length > 0, `${args.join(" ")}: stdout must not be empty`);
    const document = JSON.parse(result.stdout);
    assert.equal(document.error.exitCode, 2, `${args.join(" ")}: exitCode`);
    assert.equal(typeof document.error.message, "string");
    assert.ok(result.stderr.includes("❌"), `${args.join(" ")}: human line on stderr`);
  }
});

test("report rejects a manifest without totals in text and JSON modes", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "snapshot"), { recursive: true });
  fs.writeFileSync(
    path.join(dir, "snapshot", "manifest.json"),
    JSON.stringify(
      {
        schemaVersion: "3.0.0",
        generatedAt: "2026-01-01T00:00:00.000Z",
        fingerprint: "a".repeat(64),
        counts: { totalFiles: 0, totalLines: 0, totalSizeBytes: 0, partsCount: 0 },
        layers: {},
        files: [],
      },
      null,
      2
    )
  );

  const text = run(["report", "--cwd", dir]);
  assert.equal(text.status, 1);
  assert.match(text.stderr, /is not a snapshot manifest/);
  assert.doesNotMatch(text.stderr, /Codebase Snapshot Report/);

  const json = run(["report", "--cwd", dir, "--format", "json"]);
  assert.equal(json.status, 1);
  const document = JSON.parse(json.stdout);
  assert.equal(document.error.exitCode, 1);
  assert.match(document.error.message, /is not a snapshot manifest/);
  assert.doesNotMatch(json.stderr, /Codebase Snapshot Report/);
});

test("describe exposes check and --mode", () => {
  const result = run(["describe", "--format", "json"], os.tmpdir());
  assert.equal(result.status, 0);
  const contract = JSON.parse(result.stdout);

  const validate = contract.commands.find((command) => command.name === "validate");
  assert.ok(validate, "validate command must exist");
  assert.ok(validate.aliases.includes("check"), "validate.aliases must include check");
  assert.match(validate.summary, /check.*alias|alias.*check/i);
  // Canonical names come from the contract itself; an alias (`check`) is not one, and a hard-coded
  // second list here is one more place a new command can be forgotten.
  const canonical = new Set(contract.commands.map((command) => command.name));
  for (const option of contract.options) {
    const tokens = option.appliesTo.split("/");
    assert.ok(tokens.every((token) => canonical.has(token)), `${option.flag}: prose or aliased token`);
  }

  const mode = contract.options.find((option) => option.flag === "--mode");
  assert.ok(mode, "--mode must be in describe.options");
  assert.equal(mode.type, "string");
  assert.match(mode.summary, /contradict/i);
});

test("the help sentence matches boolean --option=value behaviour", () => {
  const help = run(["--help"], os.tmpdir());
  assert.equal(help.status, 0);
  assert.match(help.stdout, /value-taking options.*--option=value/);
  assert.doesNotMatch(help.stdout, /All options also accept/);

  const booleanEquals = run(["generate", "--help=true"], os.tmpdir());
  assert.equal(booleanEquals.status, 2);
  assert.match(booleanEquals.stderr, /does not take an argument/);
});

/**
 * `report` reads `manifest.json` and prints what is there; a generation setting cannot change
 * its answer. It used to accept seven of them and ignore them (identical output, exit 0) while
 * correctly rejecting `--discovery` — the silent fallback the scope table exists to prevent.
 * The parser and `describe`'s `appliesTo` read the same table, so both are asserted here.
 */
const REPORT_GENERATION_FLAGS = [
  ["--skip-artifacts", "parts"],
  ["--only-artifacts", "manifest"],
  ["--include-monolith"],
  ["--max-part-bytes", "4096"],
  ["--large-file-bytes", "1"],
  ["--include-sensitive-files"],
];

test("report rejects generation flags instead of accepting silent no-ops", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');

  for (const flag of REPORT_GENERATION_FLAGS) {
    const result = run(["report", "--cwd", dir, ...flag], os.tmpdir());
    assert.equal(result.status, 2, `${flag.join(" ")}: report cannot apply it`);
    assert.match(result.stderr, /does not apply to `report`/, `${flag[0]}: names the command`);
    assert.match(result.stderr, /accepted by:/, `${flag[0]}: names a command that does accept it`);
  }

  const contract = JSON.parse(run(["describe", "--format", "json"], os.tmpdir()).stdout);
  for (const [flag] of REPORT_GENERATION_FLAGS) {
    const option = contract.options.find((entry) => entry.flag === flag);
    assert.ok(option, `${flag} is still described`);
    assert.equal(
      option.appliesTo.split("/").includes("report"),
      false,
      `describe must not advertise ${flag} on report`
    );
  }
  // The settings a manifest reader genuinely needs stay in report's scope.
  for (const flag of ["--cwd", "--out-dir", "--format", "--no-config"]) {
    const option = contract.options.find((entry) => entry.flag === flag);
    assert.ok(option.appliesTo.split("/").includes("report"), `${flag} must still apply to report`);
  }
});

test("a consumer that closes stdout early is an early exit, not an EPIPE crash", { timeout: 60_000 }, async (t) => {
  // A manifest big enough to overflow the OS pipe buffer, so the truncated write really fails:
  // small payloads fit in the buffer and hid this crash from every existing test.
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "snapshot.config.json"), '{"discovery":"walk"}\n');
  for (let index = 0; index < 600; index += 1) {
    const name = `f${String(index).padStart(3, "0")}.ts`;
    fs.writeFileSync(path.join(dir, name), `export const value${index} = "${"x".repeat(120)}";\n`);
  }

  const child = spawn(process.execPath, [BIN, "generate", "--format", "json", "--cwd", dir], {
    cwd: dir,
    stdio: ["ignore", "pipe", "pipe"],
  });
  let stderr = "";
  let closedEarly = false;
  child.stdout.on("data", () => {
    if (closedEarly) return;
    closedEarly = true;
    // The reader's decision: stop consuming the payload half way through.
    child.stdout.destroy();
  });
  child.stdout.on("error", () => {});
  child.stderr.on("data", (chunk) => {
    stderr += String(chunk);
  });

  const exit = await new Promise((resolve) => {
    child.once("close", (code, signal) => resolve({ code, signal }));
  });

  assert.equal(closedEarly, true, "the payload was large enough to be cut off");
  assert.equal(exit.code, 0, `a closed reader is not a command failure:\\n${stderr}`);
  assert.doesNotMatch(stderr, /Unhandled 'error' event|EPIPE/);
});
</file>

<file path="tests/config-precedence-and-digest.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import {
  configDigest,
  generateSnapshot,
  loadConfigFileDetailed,
  normalizeResolvedConfig,
  resolveConfig,
} from "../dist/index.js";

/**
 * Configuration: what `--only-artifacts` means, where a config is found, and a digest that must not
 * depend on the order somebody typed two keys in.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "config-precedence-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const base = { outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk" };

test("--only-artifacts turns on what it names, even when the config turned it off", (t) => {
  // The CLI derived `skipArtifacts` as the complement of the requested list and never forwarded
  // the list itself, so an artifact named on the command line kept whatever the config said. With
  // `artifacts: { audit: false }` in `snapshot.config.ts`, `generate --only-artifacts audit` set the
  // other six off and left audit off as well — every artifact disabled, nothing written, exit 0.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts": "export const app = 1;\n",
    "snapshot.config.ts": "export default {};\n",
  });

  const resolved = resolveConfig(
    { ...base, artifacts: { audit: false } },
    { onlyArtifacts: ["audit"] },
    root
  );
  assert.equal(resolved.artifacts.audit, true, "the named artifact is on");
  for (const name of ["readme", "manifest", "parts", "navigation", "projectTree", "monolith"]) {
    assert.equal(resolved.artifacts[name], false, `${name} must be off`);
  }
});

test("--only-artifacts writes only what it names (end to end)", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts": "export const app = 1;\n",
    "snapshot.config.json": JSON.stringify({
      outDir: "snapshot",
      tmpDir: "snapshot.tmp",
      discovery: "walk",
      artifacts: { audit: false },
    }),
  });

  const result = spawnSync(
    process.execPath,
    [BIN, "generate", "--only-artifacts", "audit", "--cwd", root],
    { encoding: "utf8" }
  );
  assert.equal(result.status, 0, `generate succeeded: ${result.stderr}`);

  const written = fs.readdirSync(path.join(root, "snapshot")).sort();
  assert.ok(written.includes("reports"), `the audit was written: ${written.join(", ")}`);
  assert.equal(written.includes("parts"), false, "and nothing else was");
  assert.ok(
    fs.existsSync(path.join(root, "snapshot", "reports", "audit.md")),
    "reports/audit.md exists"
  );
});

test("a config is found through a BOM, and a non-object snapshot key is not one", (t) => {
  // `findConfigFile` parsed `package.json` with bare `JSON.parse` while `loadConfigFileDetailed`
  // used the JSONC-tolerant parser, so a BOM made the first answer "no config" and the second
  // read it anyway — a first run that refused, or generated, depending on which one was asked.
  // And `"snapshot"` was checked with `!== undefined`, so an array or a string — another tool's
  // key — was reported as this tool's configuration.
  const withBom = makeRepo(t, {
    "package.json": `\uFEFF${JSON.stringify({ name: "fixture", snapshot: { outDir: "out" } })}`,
    "src/app.ts": "export const app = 1;\n",
  });
  const bomRun = spawnSync(process.execPath, [BIN, "--cwd", withBom], { encoding: "utf8" });
  assert.equal(bomRun.status, 0, `a configured project runs: ${bomRun.stderr}`);
  assert.ok(
    fs.existsSync(path.join(withBom, "out", "manifest.json")),
    "the snapshot went to the configured outDir"
  );

  for (const value of ["[]", '"other-tool"', "42"]) {
    const root = makeRepo(t, {
      "package.json": `{"name":"fixture","snapshot":${value}}`,
      "src/app.ts": "export const app = 1;\n",
    });
    const run = spawnSync(process.execPath, [BIN, "--cwd", root], { encoding: "utf8" });
    assert.equal(
      run.status,
      2,
      `"snapshot": ${value} is not this tool's configuration, so the bare run must refuse: ${run.stderr}`
    );
    assert.equal(
      fs.existsSync(path.join(root, "snapshot")),
      false,
      `nothing is generated on a refusal ("snapshot": ${value})`
    );
  }
});

test("loadConfigFileDetailed remembers the directory it loaded from", async (t) => {
  // `loadConfigFile` attached `CONFIG_DIR_SYMBOL` and `loadConfigFileDetailed` — the one the MCP
  // server uses — did not. So `resolveConfig(loaded.config)` scanned `process.cwd()` instead of the
  // directory the config came from, which is the one thing the symbol exists to prevent.
  const root = makeRepo(t, {
    "snapshot.config.mjs": 'export default { outDir: "out" };\n',
    "src/app.ts": "export const app = 1;\n",
  });

  const loaded = await loadConfigFileDetailed(root);
  assert.equal(loaded.errors.length, 0, loaded.errors.join("; "));
  const resolved = resolveConfig(loaded.config);
  assert.equal(
    resolved.cwd,
    path.resolve(root),
    "the config's own directory wins over the process's working directory"
  );
});

test("includeMonolith and artifacts.monolith cannot disagree", (t) => {
  // `normalizeResolvedConfig` re-derived `artifacts` from `config.artifacts` with `includeMonolith`
  // as the *default*, so a spread override left the two saying different things: `{...resolved,
  // includeMonolith: true}` produced a config with `includeMonolith: true` and
  // `artifacts.monolith: false`, and `generate` had nothing to say about which one was true.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts": "export const app = 1;\n",
  });
  const config = resolveConfig({ ...base, cwd: root }, {}, root);
  assert.equal(config.artifacts.monolith, false, "the monolith is off by default");

  const viaFlag = normalizeResolvedConfig({ ...config, includeMonolith: true });
  assert.equal(viaFlag.includeMonolith, true);
  assert.equal(viaFlag.artifacts.monolith, true, "the flag wins over the recorded value");

  const viaArtifact = normalizeResolvedConfig({
    ...config,
    artifacts: { ...config.artifacts, monolith: true },
  });
  assert.equal(viaArtifact.artifacts.monolith, true);
  assert.equal(viaArtifact.includeMonolith, true, "and the reverse direction agrees too");

  // What the disagreement actually costs: the monolith is not written.
  const manifest = generateSnapshot({ ...config, includeMonolith: true });
  assert.ok(manifest.artifacts.fullMarkdown, "a config that asked for the monolith gets it");
});

test("the config digest does not depend on the order of budgets.byLayer keys", (t) => {
  // `JSON.stringify` preserves insertion order, so `{ docs, api }` and `{ api, docs }` hashed
  // differently — the same settings, a different digest, and `validate` reporting drift for a
  // snapshot nobody changed.
  const root = makeRepo(t, { "package.json": '{"name":"fixture","version":"1.0.0"}\n' });

  const one = resolveConfig(
    { ...base, cwd: root, budgets: { default: "100k", byLayer: { docs: "40k", api: "60k" } } },
    {},
    root
  );
  const other = resolveConfig(
    { ...base, cwd: root, budgets: { default: "100k", byLayer: { api: "60k", docs: "40k" } } },
    {},
    root
  );
  assert.deepEqual(one.budgets.byLayer, other.budgets.byLayer);
  assert.equal(configDigest(one), configDigest(other), "identical settings, identical digest");

  // And a real difference still moves it.
  const changed = resolveConfig(
    { ...base, cwd: root, budgets: { default: "100k", byLayer: { docs: "41k", api: "60k" } } },
    {},
    root
  );
  assert.notEqual(configDigest(one), configDigest(changed));
});

test("one JSONC reader: CRLF, a // inside a string and a trailing comma all parse", async (t) => {
  // `config.ts` carried a private copy of the JSONC reader alongside the exported one in
  // `ast/structured.ts`. Two copies of a parser are two sets of fixed edge cases, and a fix to
  // one does not reach the other. This fixture exercises the shared reader through the config
  // loader with every edge both copies had to handle.
  const dir = makeRepo(t, {
    "snapshot.config.json":
      '{\r\n' +
      '  // a line comment\r\n' +
      '  "outDir": "ctx",\r\n' +
      '  "excludePatterns": ["a//b", "c/*.ts",],\r\n' +
      '  "includeMonolith": false,\r\n' +
      '}\r\n',
  });

  const loaded = await loadConfigFileDetailed(dir);
  assert.deepEqual(loaded.errors, []);
  assert.deepEqual(loaded.warnings, []);
  assert.equal(loaded.config.outDir, "ctx");
  assert.deepEqual(loaded.config.excludePatterns, ["a//b", "c/*.ts"], "the // inside a string survives");
});

test("a byte-order mark in a JSON config is not a parse error", async (t) => {
  const dir = makeRepo(t, {
    "snapshot.config.json": '\uFEFF{ "outDir": "ctx" }\n',
  });
  const loaded = await loadConfigFileDetailed(dir);
  assert.deepEqual(loaded.errors, []);
  assert.equal(loaded.config.outDir, "ctx");
});
</file>

<file path="tests/contract-completeness.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import { CLI_OPTIONS, buildAgentContract } from "../dist/cli.js";
import { CONFIG_KEYS } from "../dist/index.js";

/**
 * The contract must not lie (rule 5), and "not lie" has to include "not omit".
 *
 * `describe` is generated from code, but the generator was written by hand: 0.9.10 added seven
 * flags and six config keys and documented none of them, and no test could see it because every
 * existing check walked *from* the contract *to* the config. These walk the other way — from the
 * parser and from `CONFIG_KEYS` — so a new setting cannot ship undocumented again.
 */

/** Flags the contract has never listed: they are handled before option parsing. */
const NOT_CONTRACT_OPTIONS = new Set(["help", "version"]);

/**
 * Keys that are config-file aliases rather than documented settings, with the reason each is
 * exempt.
 *
 * This was a bare set, and a set cannot tell an alias from a key somebody forgot: `secretRules`
 * sat here while `config-digest-and-keys.test.js` asserted it *is* a documented spelling — so the
 * contract omitted a key a config file may carry, and the one test that looked at it agreed with
 * the omission. Each entry now has to justify itself, and the test below proves every name here is
 * a key the loader really accepts.
 */
const ALIAS_SETTINGS = new Map([
  ["exclude", "the flag spelling of excludePatterns; documented under that key"],
  ["cwd", "carried by config files, but `describe` documents it as an invocation path, not a setting"],
]);

const contract = buildAgentContract();
const contractedFlags = new Set(contract.options.map((option) => option.flag.replace(/^--/, "")));

test("every option the parser accepts is in the contract", () => {
  const undocumented = Object.keys(CLI_OPTIONS)
    .filter((name) => !NOT_CONTRACT_OPTIONS.has(name))
    .filter((name) => !contractedFlags.has(name));

  assert.deepEqual(
    undocumented,
    [],
    `\`describe\` omits options the CLI accepts: ${undocumented.map((name) => `--${name}`).join(", ")}`
  );
});

test("every option in the contract is one the parser accepts", () => {
  const known = new Set(Object.keys(CLI_OPTIONS));
  const invented = [...contractedFlags].filter((name) => !known.has(name));

  assert.deepEqual(
    invented,
    [],
    `\`describe\` documents flags that do not parse: ${invented.map((name) => `--${name}`).join(", ")}`
  );
});

test("every config key the loader accepts is in the contract", () => {
  const documented = new Set(contract.config.settings.map((setting) => setting.key));
  const undocumented = [...CONFIG_KEYS]
    .filter((key) => !ALIAS_SETTINGS.has(key))
    .filter((key) => !documented.has(key));

  assert.deepEqual(undocumented, [], `\`describe\` omits config keys: ${undocumented.join(", ")}`);
});

test("every carve-out is a key the loader genuinely accepts", () => {
  const invented = [...ALIAS_SETTINGS.keys()].filter((key) => !CONFIG_KEYS.has(key));
  assert.deepEqual(
    invented,
    [],
    `these names are exempted from the contract but are not config keys: ${invented.join(", ")}`
  );
});

test("every setting in the contract is a config key the loader accepts", () => {
  const invented = contract.config.settings
    .map((setting) => setting.key)
    .filter((key) => !CONFIG_KEYS.has(key));

  assert.deepEqual(invented, [], `\`describe\` documents settings the loader rejects: ${invented.join(", ")}`);
});

test("the options this release added are described", () => {
  for (const flag of [
    "--max-part-tokens",
    "--install-hook",
    "--changed-since",
    "--staged",
    "--with-dependents",
    "--skeleton",
    "--sarif",
  ]) {
    const entry = contract.options.find((option) => option.flag === flag);
    assert.ok(entry, `\`describe\` is missing ${flag}`);
    assert.ok(typeof entry.summary === "string" && entry.summary.length > 20, `${flag}: summary`);
  }
});

test("the config keys this release added are described", () => {
  for (const key of ["maxPartTokens", "changedSince", "staged", "withDependents", "skeleton", "sarif"]) {
    const entry = contract.config.settings.find((setting) => setting.key === key);
    assert.ok(entry, `\`describe\` is missing the ${key} setting`);
    assert.equal(typeof entry.default !== "undefined", true, `${key}: states a default`);
  }
});
