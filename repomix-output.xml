/**
 * snapshot serve: the page, the API it calls, and the MCP endpoint, on one port.
 *
 * The page itself is served unauthenticated (it is HTML); everything that reads or writes a
 * repository requires the token. That split is what the first test pins.
 */
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { spawnSync } from "node:child_process";
import { pathToFileURL } from "node:url";
import { startWebServer } from "../dist/index.js";

function fixture(t) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "serve-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  fs.mkdirSync(path.join(root, "repo", "src"), { recursive: true });
  fs.writeFileSync(path.join(root, "repo", "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(root, "repo", "src", "a.ts"), "export const a = 1;\n");
  return root;
}

async function serve(t, root) {
  const server = await startWebServer({ cwd: root, port: 0, log: () => {} });
  t.after(() => server.close());
  return server;
}

const auth = (server, extra = {}) => ({ authorization: "Bearer " + server.token, ...extra });

test("the page is served without a token; the API is not", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);

  const page = await fetch(server.url);
  assert.equal(page.status, 200);
  const html = await page.text();
  assert.match(html, /codebase-snapshot/);
  assert.equal(html.includes(server.token), false, "the page never carries the token");

  const denied = await fetch(server.url + "api/snapshot", { headers: {} });
  assert.equal(denied.status, 401);
});

test("generate, preview and download from the API", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);
  const repo = path.join(root, "repo");

  const generated = await fetch(server.url + "api/generate", {
    method: "POST",
    headers: auth(server, { "content-type": "application/json" }),
    body: JSON.stringify({ source: repo }),
  });
  assert.equal(generated.status, 200, await generated.clone().text());
  const summary = await generated.json();
  assert.ok(summary.files >= 2);
  assert.ok(summary.parts >= 1);
  assert.match(summary.fingerprint, /^[0-9a-f]{64}$/);

  const snapshot = await fetch(server.url + "api/snapshot?path=" + encodeURIComponent(path.join(repo, "snapshot")), {
    headers: auth(server),
  });
  assert.equal(snapshot.status, 200);
  const info = await snapshot.json();
  assert.match(info.prompt, /## The job/);
  assert.ok(info.files.length >= 2);

  const zip = await fetch(server.url + "api/snapshot.zip?path=" + encodeURIComponent(path.join(repo, "snapshot")), {
    headers: auth(server),
  });
  assert.equal(zip.status, 200);
  const bytes = Buffer.from(await zip.arrayBuffer());
  assert.equal(bytes.readUInt32LE(0), 0x04034b50, "a zip local header");
  assert.match(String(zip.headers.get("content-type")), /application\/zip/);
});


test("the MCP endpoint answers with the same token", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);
  const initialize = await fetch(server.url + "mcp", {
    method: "POST",
    headers: auth(server, { "content-type": "application/json" }),
    body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: "2025-06-18", capabilities: {} } }),
  });
  assert.equal(initialize.status, 200);
  const body = await initialize.json();
  assert.equal(body.result.serverInfo.name, "codebase-snapshot");
});

test("an unknown path is a 404, not a stack trace", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);
  const response = await fetch(server.url + "api/snapshot?path=" + encodeURIComponent(path.join(root, "nope")), {
    headers: auth(server),
  });
  assert.equal(response.status, 404);
  const body = await response.json();
  assert.match(body.error, /manifest/);
});

test("a remote source is cloned and generated with provenance", async (t) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "serve-remote-"));
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  const source = path.join(root, "source");
  fs.mkdirSync(path.join(source, "src"), { recursive: true });
  fs.writeFileSync(path.join(source, "package.json"), '{"name":"r","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(source, "src", "a.ts"), "export const a = 1;\n");
  const git = (args) => spawnSync("git", args, { cwd: source, encoding: "utf8" });
  if (git(["init", "-q"]).status !== 0) {
    t.skip("git is not available");
    return;
  }
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "add", "-A"]);
  git(["-c", "user.email=t@e.c", "-c", "user.name=T", "commit", "-q", "-m", "one"]);

  const server = await startWebServer({ cwd: root, port: 0, log: () => {}, allowPrivate: true });
  t.after(() => server.close());
  const response = await fetch(server.url + "api/generate", {
    method: "POST",
    headers: { authorization: "Bearer " + server.token, "content-type": "application/json" },
    body: JSON.stringify({ source: pathToFileURL(source).href }),
  });
  assert.equal(response.status, 200, await response.clone().text());
  const summary = await response.json();
  assert.match(summary.path, /snapshot$/);
  assert.ok(fs.existsSync(path.join(summary.path, "manifest.json")));
  const manifest = JSON.parse(fs.readFileSync(path.join(summary.path, "manifest.json"), "utf8"));
  assert.equal(manifest.source.host, "file");
});

test("a private remote is refused unless the server allows it", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);
  const response = await fetch(server.url + "api/generate", {
    method: "POST",
    headers: auth(server, { "content-type": "application/json" }),
    body: JSON.stringify({ source: "https://127.0.0.1/o/r" }),
  });
  assert.equal(response.status, 400);
  const body = await response.json();
  assert.match(body.error, /private address/);
});

test("the page can slice and budget, not only generate everything", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);
  const repo = path.join(root, "repo");
  const headers = { authorization: "Bearer " + server.token, "content-type": "application/json" };

  const sliced = await fetch(server.url + "api/generate", {
    method: "POST",
    headers,
    body: JSON.stringify({ source: repo, mode: "slice", question: "how is a user authenticated" }),
  });
  assert.equal(sliced.status, 200, await sliced.clone().text());
  const sliceSummary = await sliced.json();
  assert.equal(sliceSummary.mode, "slice");
  assert.equal(typeof sliceSummary.dropped, "number");

  const budgeted = await fetch(server.url + "api/generate", {
    method: "POST",
    headers,
    body: JSON.stringify({ source: repo, mode: "budget", budgetTokens: 800 }),
  });
  assert.equal(budgeted.status, 200, await budgeted.clone().text());
  const budgetSummary = await budgeted.json();
  assert.equal(budgetSummary.mode, "budget");

  const bad = await fetch(server.url + "api/generate", {
    method: "POST",
    headers,
    body: JSON.stringify({ source: repo, mode: "slice", question: "" }),
  });
  assert.equal(bad.status, 400);
  const badBudget = await fetch(server.url + "api/generate", {
    method: "POST",
    headers,
    body: JSON.stringify({ source: repo, mode: "budget", budgetTokens: 10 }),
  });
  assert.equal(badBudget.status, 400);
});

test("the page reports the health of what it generated", async (t) => {
  const root = fixture(t);
  const server = await serve(t, root);
  const repo = path.join(root, "repo");
  const generated = await fetch(server.url + "api/generate", {
    method: "POST",
    headers: { authorization: "Bearer " + server.token, "content-type": "application/json" },
    body: JSON.stringify({ source: repo }),
  });
  assert.equal(generated.status, 200);
  const summary = await generated.json();
  assert.ok(summary.health, "a health summary is returned");
  assert.equal(typeof summary.health.score, "number");
  assert.ok(Array.isArray(summary.health.failed));

  const audited = await fetch(server.url + "api/health?path=" + encodeURIComponent(summary.path), {
    headers: { authorization: "Bearer " + server.token },
  });
  assert.equal(audited.status, 200);
  const report = await audited.json();
  assert.equal(report.score, summary.health.score);
  assert.ok(Array.isArray(report.checks));
});
</file>

<file path="docs/vs-gitingest.md">
# codebase-snapshot vs gitingest

`gitingest` is the fastest path from *a GitHub URL* to *text in your clipboard*: paste a link on a
web page and get a digest back, with no install at all. This page says where that is better than
this tool, and where it is not.

> Written by the author of `codebase-snapshot`. gitingest is a separate project; the summary below
> reflects how it is commonly used at the time of writing rather than a benchmark of it.

## The short version

**gitingest** is a web service plus a Python package that turns a repository into a single digest
you can paste into a prompt. Its great strength is that it needs nothing installed and no thought.

**codebase-snapshot** runs locally, writes partitioned output under a hard byte budget, and can tell
you later whether the snapshot still matches the code.

If you want to paste a repo into a chat right now: **use gitingest.**

## Side by side

| | codebase-snapshot | gitingest |
| :--- | :--- | :--- |
| Getting started | `npx codebase-snapshot setup` (Node.js ≥ 18) | Open a website and paste a URL |
| Install required | Yes | **No**, for the hosted version |
| Works offline | **Yes** — local filesystem only | The hosted flow needs the network |
| Output shape | Parts under a hard byte budget, plus a JSON manifest | One digest |
| Hard size ceiling | **Yes** — `maxPartBytes` | Not to this project's knowledge |
| Staleness check | `validate` exits non-zero on drift | Not a feature |
| Reproducible output | Byte-identical parts across runs, with a fingerprint | Not a published guarantee |
| Excluded-file accounting | Every skipped path recorded with a reason | Ignore rules applied |
| Secret redaction | 32 default rules, value-span masking, audit table | Relies on ignore rules |
| Runtime | Node.js | Python |
| Repo URL input | No — needs a checkout | **Yes** |

## Where gitingest is the better choice

- **You have not installed anything and do not want to.** Nothing here competes with a URL box.
- **You want one digest, not parts.** If the destination is a chat window, one blob is the right
  shape.
- **You are in Python.** `pip install gitingest` fits an existing pipeline without adding a Node
  runtime.
- **You are exploring.** Pointing at a repository you have never seen is what it is for.

## Where this is the better choice

- **The repository must not leave your machine.** No source code, path or identifier is sent
  anywhere; the tool reads the local tree. An interactive run makes one GET to the npm registry to
  check for a newer version — CI, non-TTY and `--format json` runs skip it, and
  `--no-update-check` or `CODEBASE_SNAPSHOT_NO_UPDATE_CHECK=1` disables it entirely (see
  [the update notice](cli.md#update-notice)). If the code is private enough that a hosted digest is
  not allowed, that settles it.
- **You need a size guarantee.** A part never exceeds the budget: a file that cannot fit one is a
  head/tail preview with an explicit marker, listed in `incomplete[]` with its missing line ranges.
  A digest that grows with the repository eventually stops fitting, and discovering that at
  ingestion time is too late.
- **You need to prove the context is current.** `validate` re-hashes the tree and compares a digest
  of the generation settings, so a stale snapshot fails instead of quietly misleading a model.
- **You need the exclusions explained.** Every skipped path carries a reason — `binary`, `gitignore`,
  `sensitive-file`, `nested-repository`, `read-error` and so on — and `explain <path>` answers for
  any single file.
- **You need automation.** Exit codes, a machine-readable contract and a manifest make this
  gate-able; a copy-paste digest is not.

## Both at once

They compose naturally: use gitingest to look at an unfamiliar repository quickly, and this tool
once the repository is one you maintain and want context generated reproducibly.

## Honest summary

For a one-off look at someone else's repository, gitingest is better and always will be — it wins
on friction, and friction is what most people are short of. This tool is for codebases you own and
pipelines you maintain, where a ceiling, a drift check and an audit trail are the point.
</file>

<file path="src/mcp/server.ts">
/**
 * The protocol dispatcher: one function that turns a parsed message into zero or one response.
 *
 * Everything here is transport-agnostic. The stdio binding in `stdio.ts` supplies lines, `cli.ts`
 * supplies streams, and tests supply plain objects — the same dispatch serves all three, which is
 * the property the MCP specification describes when it says protocol semantics are identical on
 * every transport.
 *
 * Two rules are worth stating because they are easy to get subtly wrong:
 *
 *  - **A notification never gets a response**, not even an error. JSON-RPC forbids it, and a
 *    client that receives one for `notifications/initialized` treats the connection as broken.
 *  - **`handle` never throws.** A handler failure becomes a tool-level error the model can read
 *    and act on; a dispatcher failure becomes `-32603`. An uncaught exception here would kill the
 *    child process the client is talking to, and the client would report a mysterious EOF.
 */
import {
  ERROR_CODES,
  METHOD,
  SUPPORTED_PROTOCOL_VERSIONS,
  errorResponse,
  isJsonObject,
  successResponse,
} from "./protocol.js";
import type { JsonObject, JsonRpcId, JsonRpcResponse } from "./protocol.js";
import { classifyRequest, createSession, negotiateLegacyVersion } from "./era.js";
import type { SessionState } from "./era.js";
import { ResourceNotFoundError, ResourceTooLargeError } from "./resources.js";
import { applyDefaults, coerceNumericStrings, validateArguments } from "./schema.js";
import type {
  McpPrompt,
  McpResourceContents,
  McpServerInfo,
  McpTool,
  PromptMessage,
  ResourceProvider,
  ToolContext,
  ToolOutcome,
} from "./types.js";

export interface McpServerOptions {
  info: McpServerInfo;
  instructions: string;
  tools: McpTool[];
  resources: ResourceProvider;
  prompts: McpPrompt[];
  context: ToolContext;
  /** Writes a JSON-RPC notification. Present on transports that can carry one mid-call. */
  notify?: (message: JsonObject) => void;
}

export interface McpServer {
  /** Handles one already-parsed message. Returns null when no response is due. */
  handle(message: unknown): Promise<JsonRpcResponse | null>;
  /** Exposed for tests and for `mcp --list`, which prints the negotiation table. */
  readonly session: SessionState;
}

/** Server capabilities, identical in both eras apart from where they are reported. */
function capabilities(): JsonObject {
  return {
    tools: { listChanged: false },
    resources: { subscribe: false, listChanged: false },
    prompts: { listChanged: false },
  };
}

/** Reads the request id, or null when the message carries none we can answer. */
function requestIdOf(message: JsonObject): JsonRpcId | null {
  const raw = message.id;
  return typeof raw === "string" || typeof raw === "number" ? raw : null;
}

export function createMcpServer(options: McpServerOptions): McpServer {
  const session = createSession();
  const toolsByName = new Map(options.tools.map((tool) => [tool.name, tool]));
  const promptsByName = new Map(options.prompts.map((prompt) => [prompt.name, prompt]));

  const identity = (): JsonObject => ({
    name: options.info.name,
    title: options.info.title,
    version: options.info.version,
    websiteUrl: options.info.websiteUrl,
  });

  const ok = (id: JsonRpcId | null, result: JsonObject, modern: boolean): JsonRpcResponse =>
    successResponse(id, result, modern, options.info);

  /** Cancellations registered by the running call, keyed by the request id a client quotes. */
  const cancellations = new Map<JsonRpcId, () => void>();

  function handleNotification(method: string, params: JsonObject | undefined): void {
    // `notifications/initialized` and `notifications/cancelled` are the only ones we expect. The
    // first confirms a handshake; the second is a request to stop, and it now reaches a tool that
    // asked to be told (a generate terminates its worker instead of running to completion).
    if (method === METHOD.initialized && session.era === "legacy") session.ready = true;
    if (method === "notifications/cancelled") {
      const requestId = params?.requestId;
      if (typeof requestId === "string" || typeof requestId === "number") {
        const cancel = cancellations.get(requestId);
        if (cancel !== undefined) {
          cancellations.delete(requestId);
          cancel();
        }
      }
    }
  }

  function initialize(id: JsonRpcId, params: JsonObject | undefined): JsonRpcResponse {
    const negotiation = negotiateLegacyVersion(params?.protocolVersion);
    session.era = "legacy";
    session.protocolVersion = negotiation.version;
    session.ready = true;
    options.context.log(
      negotiation.matched
        ? `mcp: client initialized with protocol ${negotiation.version}`
        : `mcp: client asked for an unsupported version and was offered ${negotiation.version}`
    );
    // Legacy responses carry no `resultType`: the field belongs to the modern revision, and an
    // older client has no schema entry for it.
    return {
      jsonrpc: "2.0",
      id,
      result: {
        protocolVersion: negotiation.version,
        capabilities: capabilities(),
        serverInfo: identity(),
        instructions: options.instructions,
      },
    };
  }

  function discover(id: JsonRpcId): JsonRpcResponse {
    session.era = "modern";
    session.ready = true;
    // Always the modern shape, even when a legacy client is the one probing: `server/discover`
    // exists only in the revision that defines `resultType`, so omitting it would make the answer
    // unusable to the only client that could ask for it.
    return ok(
      id,
      {
        supportedVersions: [...SUPPORTED_PROTOCOL_VERSIONS],
        capabilities: capabilities(),
        instructions: options.instructions,
        // The capability set depends on which repository the server was started for, so the answer
        // may be cached only by the client that asked, and not at all after this response.
        cacheScope: "private",
        ttlMs: 0,
      },
      true
    );
  }

  function listTools(id: JsonRpcId, modern: boolean): JsonRpcResponse {
    const tools = options.tools.map((tool) => ({
      name: tool.name,
      title: tool.title,
      description: tool.description,
      inputSchema: tool.inputSchema,
      ...(tool.outputSchema ? { outputSchema: tool.outputSchema } : {}),
      annotations: tool.annotations,
      _meta: { "codebase-snapshot/cost": tool.cost },
    }));
    return ok(id, { tools }, modern);
  }

  async function callTool(
    id: JsonRpcId,
    modern: boolean,
    params: JsonObject | undefined
  ): Promise<JsonRpcResponse> {
    const name = params?.name;
    if (typeof name !== "string") {
      return errorResponse(id, ERROR_CODES.invalidParams, 'tools/call requires a "name" string.');
    }
    const tool = toolsByName.get(name);
    if (!tool) {
      const known = [...toolsByName.keys()].sort().join(", ");
      return errorResponse(id, ERROR_CODES.invalidParams, `Unknown tool "${name}". Available: ${known}.`);
    }

    const rawArguments = params?.arguments ?? {};
    if (!isJsonObject(rawArguments)) {
      return errorResponse(id, ERROR_CODES.invalidParams, '"arguments" must be a JSON object.');
    }

    // Some clients serialise every argument as a string; a digit string for a numeric field is
    // the same value, so it is normalised before validation rather than rejected after it.
    const supplied = coerceNumericStrings(tool.inputSchema, rawArguments);
    const problems = validateArguments(tool.inputSchema, supplied);
    if (problems.length > 0) {
      // Argument mistakes are reported as a tool error rather than a protocol error: the model can
      // read the message and retry, where `-32602` reaches the user as an opaque failure.
      return ok(
        id,
        {
          content: [{ type: "text", text: `Invalid arguments for ${tool.name}:\n- ${problems.join("\n- ")}` }],
          isError: true,
        },
        modern
      );
    }

    const args = applyDefaults(tool.inputSchema, supplied);
    // Progress is opt-in per call: the client names a token, and every notification quotes it back.
    const meta = params?._meta;
    const progressToken =
      isJsonObject(meta) && (typeof meta.progressToken === "string" || typeof meta.progressToken === "number")
        ? meta.progressToken
        : undefined;
    const callContext: ToolContext = {
      ...options.context,
      // Always offered, so a long tool can be stopped whether or not the client asked for progress.
      onCancel: (cancel) => {
        cancellations.set(id, cancel);
      },
      ...(progressToken === undefined || options.notify === undefined
        ? {}
        : {
            notify: (event: { message: string; progress?: number; total?: number }) => {
              const progress: JsonObject = {
                progressToken,
                progress: event.progress ?? 0,
                ...(event.total === undefined ? {} : { total: event.total }),
                message: event.message,
              };
              options.notify?.({ jsonrpc: "2.0", method: "notifications/progress", params: progress });
            },
          }),
    };
    let outcome: ToolOutcome;
    try {
      outcome = await tool.handler(args, callContext);
    } catch (error) {
      const detail = error instanceof Error ? error.message : String(error);
      options.context.log(`mcp: tool ${tool.name} failed: ${detail}`);
      return ok(
        id,
        { content: [{ type: "text", text: `${tool.name} failed: ${detail}` }], isError: true },
        modern
      );
    } finally {
      // A cancelled call leaves nothing behind for a later cancellation to reach.
      cancellations.delete(id);
    }

    return ok(
      id,
      {
        content: [{ type: "text", text: outcome.text }],
        ...(outcome.structured ? { structuredContent: outcome.structured } : {}),
        ...(outcome.isError ? { isError: true } : {}),
      },
      modern
    );
  }

  async function listResources(id: JsonRpcId, modern: boolean): Promise<JsonRpcResponse> {
    const resources = await options.resources.list(options.context);
    return ok(id, { resources }, modern);
  }

  async function readResource(
    id: JsonRpcId,
    modern: boolean,
    params: JsonObject | undefined
  ): Promise<JsonRpcResponse> {
    const uri = params?.uri;
    if (typeof uri !== "string") {
      return errorResponse(id, ERROR_CODES.invalidParams, 'resources/read requires a "uri" string.');
    }
    let contents: McpResourceContents | null;
    try {
      contents = await options.resources.read(uri, options.context);
    } catch (error) {
      // A resource that exists but cannot be returned whole is an error the client can act on.
      // Truncating it instead would hand a model half a JSON document or half a part, which is
      // worse than a refusal because nothing downstream can tell the difference.
      if (error instanceof ResourceNotFoundError) {
        return errorResponse(id, ERROR_CODES.resourceNotFound, error.message, { uri: error.uri });
      }
      if (error instanceof ResourceTooLargeError) {
        options.context.log(
          `mcp: refused ${error.uri} (${error.bytes} bytes, limit ${error.limit}); ` +
            "returning it would truncate it"
        );
        return errorResponse(id, ERROR_CODES.resourceTooLarge, error.message, {
          uri: error.uri,
          bytes: error.bytes,
          limit: error.limit,
        });
      }
      throw error;
    }
    if (!contents) {
      return errorResponse(id, ERROR_CODES.invalidParams, `Unknown resource "${uri}".`);
    }
    return ok(id, { contents: [contents] }, modern);
  }

  function listPrompts(id: JsonRpcId, modern: boolean): JsonRpcResponse {
    const prompts = options.prompts.map((prompt) => ({
      name: prompt.name,
      ...(prompt.title ? { title: prompt.title } : {}),
      description: prompt.description,
      arguments: prompt.arguments,
    }));
    return ok(id, { prompts }, modern);
  }

  function getPrompt(
    id: JsonRpcId,
    modern: boolean,
    params: JsonObject | undefined
  ): JsonRpcResponse {
    const name = params?.name;
    if (typeof name !== "string") {
      return errorResponse(id, ERROR_CODES.invalidParams, 'prompts/get requires a "name" string.');
    }
    const prompt = promptsByName.get(name);
    if (!prompt) {
      const known = [...promptsByName.keys()].sort().join(", ");
      return errorResponse(id, ERROR_CODES.invalidParams, `Unknown prompt "${name}". Available: ${known}.`);
    }
    const rawArguments = params?.arguments ?? {};
    if (!isJsonObject(rawArguments)) {
      return errorResponse(id, ERROR_CODES.invalidParams, '"arguments" must be a JSON object.');
    }
    const built = prompt.build(rawArguments);
    const messages: PromptMessage[] = built.messages.map((message) => ({
      role: message.role,
      content: { type: "text", text: message.content.text },
    }));
    return ok(id, { description: built.description, messages }, modern);
  }

  async function route(
    name: string,
    id: JsonRpcId,
    modern: boolean,
    params: JsonObject | undefined
  ): Promise<JsonRpcResponse> {
    // Methods that identify the era, or that the modern revision deleted, are answered before the
    // initialization gate: a client must be able to discover what it is talking to.
    switch (name) {
      case METHOD.initialize:
        return modern
          ? errorResponse(
              id,
              ERROR_CODES.methodNotFound,
              '"initialize" does not exist in this protocol revision; call "server/discover".'
            )
          : initialize(id, params);
      case METHOD.discover:
        return discover(id);
      case METHOD.ping:
        return modern
          ? errorResponse(
              id,
              ERROR_CODES.methodNotFound,
              '"ping" was removed in this protocol revision; call "server/discover".'
            )
          : ok(id, {}, modern);
      default:
        break;
    }

    if (!session.ready) {
      return errorResponse(
        id,
        ERROR_CODES.invalidRequest,
        'This connection has not been initialized. Send "initialize" first.'
      );
    }

    switch (name) {
      case METHOD.toolsList:
        return listTools(id, modern);
      case METHOD.toolsCall:
        return callTool(id, modern, params);
      case METHOD.resourcesList:
        return listResources(id, modern);
      case METHOD.resourcesRead:
        return readResource(id, modern, params);
      case METHOD.resourceTemplatesList:
        return ok(id, { resourceTemplates: options.resources.templates() }, modern);
      case METHOD.promptsList:
        return listPrompts(id, modern);
      case METHOD.promptsGet:
        return getPrompt(id, modern, params);
      default:
        return errorResponse(id, ERROR_CODES.methodNotFound, `Unknown method "${name}".`);
    }
  }

  async function dispatch(message: unknown): Promise<JsonRpcResponse | null> {
    if (!isJsonObject(message)) {
      // A parsed value that is not an object is a valid JSON value, so it is not a *parse* error:
      // -32700 belongs to the transport, which rejects text that is not JSON before this runs. An
      // array is a batch, and none of the revisions this server speaks define batching (it was
      // removed before the oldest supported revision, 2025-06-18); anything else is not a request.
      return errorResponse(
        null,
        ERROR_CODES.invalidRequest,
        Array.isArray(message)
          ? "Batch requests are not supported: send one JSON-RPC message per line."
          : "Message is not a JSON object."
      );
    }
    const isRequest = Object.prototype.hasOwnProperty.call(message, "id");
    const method = message.method;
    const params = message.params;

    if (message.jsonrpc !== "2.0" && isRequest) {
      return errorResponse(requestIdOf(message), ERROR_CODES.invalidRequest, 'Message must carry "jsonrpc": "2.0".');
    }
    if (typeof method !== "string" || method.length === 0) {
      return isRequest
        ? errorResponse(requestIdOf(message), ERROR_CODES.invalidRequest, 'Message must carry a "method" string.')
        : null;
    }
    if (params !== undefined && !isJsonObject(params)) {
      return isRequest
        ? errorResponse(requestIdOf(message), ERROR_CODES.invalidRequest, '"params" must be a JSON object when present.')
        : null;
    }
    const named = params as JsonObject | undefined;

    const decision = classifyRequest(method, named, session);
    const modern = decision.kind === "era" ? decision.era === "modern" : session.era === "modern";

    if (!isRequest) {
      // Era commitment happens even for a notification: `notifications/initialized` is the moment a
      // legacy client finishes its handshake, and refusing to learn that would leave it gated.
      if (decision.kind === "era" && session.era === null) {
        session.era = decision.era;
        session.protocolVersion = decision.version;
      }
      handleNotification(method, named);
      return null;
    }

    const id = requestIdOf(message);
    if (id === null) {
      return errorResponse(null, ERROR_CODES.invalidRequest, 'A request "id" must be a string or a number.');
    }
    if (decision.kind === "error") {
      return errorResponse(id, decision.code, decision.message, decision.data);
    }
    if (session.era === null) {
      session.era = decision.era;
      session.protocolVersion = decision.version;
    }

    return route(method, id, modern, named);
  }

  return {
    session,
    async handle(message: unknown): Promise<JsonRpcResponse | null> {
      try {
        return await dispatch(message);
      } catch (error) {
        const detail = error instanceof Error ? error.message : String(error);
        options.context.log(`mcp: internal error: ${detail}`);
        const id = isJsonObject(message) ? requestIdOf(message) : null;
        return errorResponse(id, ERROR_CODES.internalError, "Internal server error.");
      }
    },
  };
}
