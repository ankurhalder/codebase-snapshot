<file path="tests/first-run.test.js">
/**
 * The first run: what a bare `snapshot` does in a project that has no configuration.
 *
 * Three outcomes, and the tests below pin all three: a terminal asks; `--autopilot` decides and
 * does the whole setup; with no terminal and no `--autopilot` the run refuses with exit 2 and
 * names the alternatives. The refusal is the important one — a first run that silently used
 * settings nobody chose produces a snapshot nobody can trust.
 *
 * The interactive path itself needs a real TTY and is exercised by hand; what is testable here is
 * the decision (`planFirstRun`), the two filesystem probes that feed it, and the unattended paths
 * end to end.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";
import { hasPriorSnapshot, isEffectivelyEmpty, planFirstRun } from "../dist/index.js";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeProject(t, files = { "src/a.ts": "export const a = 1;\n" }) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "first-run-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

/** The command as typed by someone who installed the package: no command word at all. */
function runBare(dir, args = []) {
  const result = spawnSync(process.execPath, [BIN, "--cwd", dir, ...args], { encoding: "utf8" });
  if (result.error) throw result.error;
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

function runCommand(dir, args) {
  const result = spawnSync(process.execPath, [BIN, ...args, "--cwd", dir], { encoding: "utf8" });
  if (result.error) throw result.error;
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

const configName = (dir) =>
  fs.readdirSync(dir).find((name) => /^snapshot\.config\.(ts|mjs|cjs|js|json)$/.test(name));

const facts = (overrides = {}) => ({
  hasConfig: false,
  hasPriorSnapshot: false,
  interactive: false,
  autopilot: false,
  emptyTarget: false,
  ...overrides,
});

// ------------------------------------------------------------------ the decision

test("a bare run with nothing configured and no terminal refuses instead of guessing", () => {
  assert.deepEqual(planFirstRun(facts()), {
    action: "refuse",
    exitCode: 2,
    reason: "undecided",
  });
});

test("a configured project generates", () => {
  assert.deepEqual(planFirstRun(facts({ hasConfig: true })), { action: "generate" });
});

test("a project generated before generates — no second wizard", () => {
  assert.deepEqual(planFirstRun(facts({ hasPriorSnapshot: true })), { action: "generate" });
});

test("a terminal asks", () => {
  assert.deepEqual(planFirstRun(facts({ interactive: true })), {
    action: "setup",
    interactive: true,
  });
});

test("--autopilot sets up and never asks, even at a terminal", () => {
  assert.deepEqual(planFirstRun(facts({ autopilot: true, interactive: true })), {
    action: "setup",
    interactive: false,
  });
});

test("--autopilot on an existing project still sets up what is missing", () => {
  assert.deepEqual(planFirstRun(facts({ autopilot: true, hasConfig: true })), {
    action: "setup",
    interactive: false,
  });
});

test("an empty directory is refused on every path, --autopilot included", () => {
  const expected = { action: "refuse", exitCode: 1, reason: "empty" };
  assert.deepEqual(planFirstRun(facts({ emptyTarget: true })), expected);
  assert.deepEqual(planFirstRun(facts({ emptyTarget: true, autopilot: true })), expected);
  assert.deepEqual(planFirstRun(facts({ emptyTarget: true, interactive: true })), expected);
});

// -------------------------------------------------------------- the filesystem probes

test("a directory holding only version-control metadata counts as empty", (t) => {
  const dir = makeProject(t, {});
  fs.rmSync(path.join(dir, "package.json"));
  fs.mkdirSync(path.join(dir, ".git"), { recursive: true });

  assert.equal(isEffectivelyEmpty(dir), true);
  fs.writeFileSync(path.join(dir, "README.md"), "# hi\n");
  assert.equal(isEffectivelyEmpty(dir), false);
});

test("a prior snapshot counts only when this tool wrote it", (t) => {
  const dir = makeProject(t, {});
  assert.equal(hasPriorSnapshot(dir, "snapshot"), false, "nothing there");

  fs.mkdirSync(path.join(dir, "snapshot"));
  const marker = path.join(dir, "snapshot", ".codebase-snapshot");
  fs.writeFileSync(marker, JSON.stringify({ generator: "some-other-tool" }));
  assert.equal(hasPriorSnapshot(dir, "snapshot"), false, "a foreign marker is not evidence");

  fs.writeFileSync(marker, JSON.stringify({ generator: "codebase-snapshot" }));
  assert.equal(hasPriorSnapshot(dir, "snapshot"), true);

  // The pre-4.5 name is the same generator: a project generated then must not be asked again.
  fs.writeFileSync(marker, JSON.stringify({ generator: "@ankurhalder/codebase-snapshot" }));
  assert.equal(hasPriorSnapshot(dir, "snapshot"), true);
});

// ------------------------------------------------------------------- the bare command

test("a bare run without a terminal writes nothing and names the way out", (t) => {
  const dir = makeProject(t);

  const run = runBare(dir);

  assert.equal(run.code, 2, run.stderr);
  assert.match(run.stderr, /--autopilot/);
  assert.equal(configName(dir), undefined, "no config was written");
  assert.equal(fs.existsSync(path.join(dir, "snapshot")), false, "nothing was generated");
});

test("the refusal is a JSON document under --format json", (t) => {
  const dir = makeProject(t);

  const run = runBare(dir, ["--format", "json"]);

  assert.equal(run.code, 2, run.stderr);
  const parsed = JSON.parse(run.stdout);
  assert.equal(parsed.error.exitCode, 2);
  assert.match(parsed.error.message, /autopilot/);
});

test("--autopilot sets the project up and generates without asking", (t) => {
  const dir = makeProject(t);

  const run = runBare(dir, ["--autopilot", "--no-install"]);

  assert.equal(run.code, 0, run.stderr);
  assert.ok(configName(dir), "a config was written");
  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(pkg.scripts.snapshot, "npx codebase-snapshot generate");
  assert.match(String(pkg.devDependencies["codebase-snapshot"]), /^\^\d+\.\d+\.\d+$/);
  assert.ok(pkg.devDependencies["codebase-snapshot"], "the dependency is declared");
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "manifest.json")), "the snapshot exists");
  assert.match(run.stderr, /Snapshot generated/);
});

test("--autopilot reports the preset it chose", (t) => {
  const dir = makeProject(t);

  const run = runBare(dir, ["--autopilot", "--no-install"]);

  assert.equal(run.code, 0, run.stderr);
  assert.match(run.stderr, /preset: \w+/);
  assert.match(run.stderr, /because /);
});

test("a second bare run just generates", (t) => {
  const dir = makeProject(t);
  assert.equal(runBare(dir, ["--autopilot", "--no-install"]).code, 0);

  const run = runBare(dir);

  assert.equal(run.code, 0, run.stderr);
  assert.doesNotMatch(run.stderr, /How should I set this up/);
  assert.match(run.stderr, /Using config/);
});

test("--autopilot in an empty directory refuses and writes nothing", (t) => {
  const dir = makeProject(t, {});
  fs.rmSync(path.join(dir, "package.json"));
  fs.mkdirSync(path.join(dir, ".git"));

  const run = runBare(dir, ["--autopilot"]);

  assert.equal(run.code, 1, run.stderr);
  assert.match(run.stderr, /Nothing to snapshot/);
  assert.equal(configName(dir), undefined);
});

test("naming the command keeps the old behaviour: generate on the built-in defaults", (t) => {
  const dir = makeProject(t);

  const run = runCommand(dir, ["generate"]);

  assert.equal(run.code, 0, run.stderr);
  assert.equal(configName(dir), undefined, "no config was written");
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "manifest.json")));
});

// ------------------------------------------------------------------------ conflicts

test("--autopilot contradicts --no-config", (t) => {
  const dir = makeProject(t);

  const run = runBare(dir, ["--autopilot", "--no-config"]);

  assert.equal(run.code, 2, run.stderr);
  assert.match(run.stderr, /--no-config ignores config files/);
  assert.equal(configName(dir), undefined);
});

test("--no-install only applies to a setup", (t) => {
  const dir = makeProject(t);

  const run = runCommand(dir, ["generate", "--no-install"]);

  assert.equal(run.code, 2, run.stderr);
  assert.match(run.stderr, /--autopilot/);
});
</file>

<file path="tests/generator-and-wizard-consistency.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

/**
 * 4.1.0 regression cover for four LOW findings from a wave over the generators and the wizard.
 *
 * D1 — the monolith emitted control and bidi characters raw while parts, tree, navigation and audit
 *      escaped them.
 * D2 — the snapshot README linked to reports that `--skip-artifacts` never wrote.
 * D3 — a config layer or kind name containing `|` or a backtick broke the table or the inline-code
 *      span it was listed in.
 * D4 — the wizard treated `package.json#snapshot` as an existing config when it was an array.
 *
 * These drive the CLI, because a repository config file is a CLI feature: the library's
 * `generateSnapshot` takes a config object and never reads `snapshot.config.*`.
 */

function tempDir(t, prefix = "snap-generators-") {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function makeRepo(t) {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n', "utf8");
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n", "utf8");
  return dir;
}

const cli = (args, cwd) => {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, out: `${result.stdout ?? ""}${result.stderr ?? ""}` };
};

const read = (dir, ...parts) => fs.readFileSync(path.join(dir, "snapshot", ...parts), "utf8");

test("D1: the monolith escapes control and bidi characters like every other artifact", (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(
    path.join(dir, "snapshot.config.mjs"),
    'export default {\n  layersMode: "replace",\n  layers: [{ name: "core\\u202Ex", match: "**/*.ts" }],\n};\n',
    "utf8"
  );

  const { code, out } = cli(["generate", "--include-monolith"], dir);
  assert.equal(code, 0, out);

  const monolith = read(dir, "full-codebase.md");
  assert.doesNotMatch(monolith, /\u202E/, "no raw bidi override in the monolith");
  assert.match(monolith, /core\\u202Ex/, "the layer name is re-spelled instead");
});

test("D2: the snapshot README links only to artifacts that were written", (t) => {
  const dir = makeRepo(t);

  const { code, out } = cli(
    ["generate", "--skip-artifacts", "navigation,projectTree,audit"],
    dir
  );
  assert.equal(code, 0, out);

  const readme = read(dir, "README.md");
  assert.doesNotMatch(readme, /reports\/navigation\.md/, "no dangling navigation link");
  assert.doesNotMatch(readme, /reports\/project-tree\.md/, "no dangling tree link");
  assert.doesNotMatch(readme, /reports\/audit\.md/, "no dangling audit link");
  assert.match(readme, /manifest\.json/, "what was written is still linked");
});

test("D2: with only the README written, it says so instead of linking nowhere", (t) => {
  const dir = makeRepo(t);

  const { code, out } = cli(["generate", "--only-artifacts", "readme"], dir);
  assert.equal(code, 0, out);

  const readme = read(dir, "README.md");
  assert.match(readme, /every other artifact was disabled/);
  assert.doesNotMatch(readme, /\]\(parts\//, "no part links either");
});

test("D3: a layer name with a pipe or a backtick cannot break a table", (t) => {
  const dir = makeRepo(t);
  fs.writeFileSync(
    path.join(dir, "snapshot.config.mjs"),
    'export default {\n  layersMode: "replace",\n  layers: [{ name: "co`re|pipe", match: "**/*.ts" }],\n  kinds: [{ kind: "ki`nd|x", match: "**/*.ts" }],\n};\n',
    "utf8"
  );

  const { code, out } = cli(["generate"], dir);
  assert.equal(code, 0, out);

  for (const artifact of ["reports/navigation.md", "reports/audit.md", "README.md"]) {
    const body = read(dir, ...artifact.split("/"));
    // The escaped spelling is the only one that may appear: `|` becomes `\|` inside the cell.
    const escapedName = "co`re\\|pipe";
    const row = body.split("\n").find((line) => line.includes(escapedName));
    assert.ok(row, `${artifact} lists the hostile layer name escaped: ${body.slice(0, 600)}`);
    assert.doesNotMatch(
      body,
      /co`re[^\\]+\|pipe/,
      `${artifact}: an unescaped pipe must not survive`
    );
  }
});

test("D4: an array-valued package.json#snapshot does not count as an existing config", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(
    path.join(dir, "package.json"),
    `${JSON.stringify({ name: "fixture", version: "1.0.0", snapshot: [{ maxPartBytes: 4096 }] }, null, 2)}\n`,
    "utf8"
  );

  const { code, out } = cli(["init", "--yes"], dir);

  assert.equal(code, 0, `init must proceed: ${out}`);
  const configName = fs
    .readdirSync(dir)
    .find((name) => /^snapshot\.config\.(ts|mjs|cjs|js|json)$/.test(name));
  assert.ok(configName, "a config was written");
});
</file>

<file path="tests/git-globs-and-ast.test.js">
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import {
  generateSnapshot,
  getGitInfo,
  matchRule,
  resolveConfig,
  summarizeTypeScriptSource,
} from "../dist/index.js";

/**
 * Git enumeration, gitignore matching, layer rules and route summaries, from the 0.9.12 audit.
 *
 * What these have in common is that each one answered a question about the repository with a
 * *different* rule than the one the rest of the tool uses: git was read one way here and another
 * way there, `.gitignore` was honoured in `git` mode and quietly ignored in `walk` mode, and a
 * layer rule fell back to a substring search when it contained a brace.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const gitAvailable = spawnSync("git", ["--version"], { encoding: "utf8" }).status === 0;

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "git-globs-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const walkConfig = (root) =>
  resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk" },
    {},
    root
  );

test("gitignore character classes apply in walk mode", (t) => {
  // `matchGitignorePattern` escaped `[` and `]` as literals, so a rule written with a class —
  // which is how `*.[oa]`, `[Tt]humbs.db` and `log[0-9].txt` are spelled — matched nothing at all
  // in `--discovery walk` while the identical rule worked in `git` mode.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    ".gitignore": "*.[oa]\n[Tt]humbs.db\nlog[0-9].txt\n",
    "object.o": "ignored\n",
    "Thumbs.db": "ignored\n",
    "log5.txt": "ignored\n",
    "logx.txt": "kept\n",
    "kept.ts": "export const kept = 1;\n",
  });
  const manifest = generateSnapshot(walkConfig(root));
  const paths = manifest.files.map((file) => file.relativePath).sort();

  assert.equal(paths.includes("object.o"), false, "*.[oa] must ignore object.o");
  assert.equal(paths.includes("Thumbs.db"), false, "[Tt]humbs.db must ignore Thumbs.db");
  assert.equal(paths.includes("log5.txt"), false, "log[0-9].txt must ignore log5.txt");
  assert.equal(paths.includes("logx.txt"), true, "and must not ignore a non-matching name");
  assert.equal(paths.includes("kept.ts"), true, "an unlisted file is still scanned");
});

test("a layer or kind rule understands braces, classes and path segments", () => {
  // Braces and classes were translated to a glob only when the pattern contained `*` or `?`;
  // anything else fell through to `filePath.includes(pattern)`, which is a substring search.
  assert.equal(matchRule("src/api/index.ts", "src/{api,web}/index.ts"), true, "brace alternative");
  assert.equal(matchRule("src/web/index.ts", "src/{api,web}/index.ts"), true, "second alternative");
  assert.equal(matchRule("src/db/index.ts", "src/{api,web}/index.ts"), false, "not an alternative");
  assert.equal(matchRule("src/api/x.ts", "src/[ai]*/x.ts"), true, "character class");
  assert.equal(matchRule("src/db/x.ts", "src/[ai]*/x.ts"), false, "class excludes");

  // A plain pattern means a whole path segment, which is what `matchesExclude` already did.
  assert.equal(matchRule("src/contest/a.ts", "test"), false, "`test` must not match `contest`");
  assert.equal(matchRule("src/test/a.ts", "test"), true, "a real segment matches");
  assert.equal(matchRule("test/a.ts", "test"), true, "including the first segment");
  assert.equal(matchRule("src/app/deep/a.ts", "src/app/**"), true, "and the literal prefix form");
  assert.equal(matchRule("src/apple/a.ts", "src/app/**"), false, "with path boundaries");
});

test("layer rules that use a brace actually classify files", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/api/index.ts": "export const api = 1;\n",
    "src/web/index.ts": "export const web = 1;\n",
    "src/db/index.ts": "export const db = 1;\n",
  });
  const manifest = generateSnapshot(
    resolveConfig(
      {
        cwd: root,
        outDir: "snapshot",
        tmpDir: "snapshot.tmp",
        discovery: "walk",
        layers: [{ name: "http", match: "src/{api,web}/index.ts" }],
      },
      {},
      root
    )
  );
  const layerOf = (file) => manifest.files.find((entry) => entry.relativePath === file).layer;
  assert.equal(layerOf("src/api/index.ts"), "http");
  assert.equal(layerOf("src/web/index.ts"), "http");
  assert.notEqual(layerOf("src/db/index.ts"), "http", "a file outside the brace group is not in it");
});

test("getGitInfo reports the tree it is looking at", { skip: !gitAvailable }, (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "a.ts": "export const a = 1;\n",
  });
  execFileSync("git", ["init", "-q"], { cwd: root });
  execFileSync("git", ["config", "user.email", "t@example.com"], { cwd: root });
  execFileSync("git", ["config", "user.name", "t"], { cwd: root });
  execFileSync("git", ["add", "-A"], { cwd: root });
  execFileSync("git", ["commit", "-qm", "one"], { cwd: root });

  const clean = getGitInfo(root);
  assert.equal(clean.isDirty, false, "a committed tree is clean");
  assert.match(clean.commit, /^[0-9a-f]{40}$/, "and the commit is recorded");

  fs.writeFileSync(path.join(root, "a.ts"), "export const a = 2;\n");
  assert.equal(getGitInfo(root).isDirty, true, "an edited tree is dirty");

  // A directory that is not a repository still answers, because that is a normal state.
  const outside = makeRepo(t, { "package.json": "{}\n" });
  assert.equal(getGitInfo(outside).isDirty, false);
});

test("no git listing runs through a shell, and none of them trusts a 1 MB buffer", () => {
  // The defect was an *omission* — `getGitInfo` did not pass `maxBuffer`, so the 1 MB default
  // applied to output that grows with the number of changed files. Reproducing it needs a
  // repository with tens of thousands of dirty entries, which is not a unit test; the invariant is
  // cheap to hold instead, and it is the thing that was wrong.
  const source = fs.readFileSync(path.join(HERE, "..", "src", "scanner", "files.ts"), "utf8");
  assert.equal(
    /childProcess\.execSync\(/.test(source),
    false,
    "a git invocation must not go through a shell"
  );
  const invocations = source.match(/childProcess\.execFileSync\(/g) ?? [];
  const budgets = source.match(/maxBuffer: GIT_OUTPUT_LIMIT/g) ?? [];
  assert.ok(invocations.length >= 3, `every git call is found: ${invocations.length}`);
  assert.equal(
    budgets.length,
    invocations.length,
    "every git call passes the shared output ceiling"
  );
});

test("re-aliased route handlers are recorded as route methods", () => {
  // `export { handler as GET }` and `export { GET } from "./handlers"` are the App Router's way of
  // declaring a route, and the summary listed the export while leaving `routeHandlers` empty — so
  // those routes had no methods at all in `manifest.indexes.routes`.
  const aliased = summarizeTypeScriptSource(
    "route.ts",
    "async function handler() {}\nexport { handler as GET, handler as POST };\n"
  );
  assert.deepEqual(aliased.routeHandlers, ["GET", "POST"]);
  assert.ok(aliased.exports.includes("GET"), "the export is still recorded");

  const reexported = summarizeTypeScriptSource("route.ts", 'export { GET, PUT } from "./handlers";');
  assert.deepEqual(reexported.routeHandlers, ["GET", "PUT"]);

  // A plain named export that happens to be route-shaped is a route; anything else is not.
  assert.deepEqual(
    summarizeTypeScriptSource("lib.ts", "const cache = 1;\nexport { cache as loader };").routeHandlers,
    []
  );
});

test("an anonymous default component is recorded as a component", () => {
  // The named forms were all covered; `export default () => <div />` was the one React component
  // shape missing from `reactComponents`, so a Next.js page directory summarised as having none.
  const arrow = summarizeTypeScriptSource("page.tsx", "export default () => <div />;\n");
  assert.deepEqual(arrow.reactComponents, ["default"]);

  const notJsx = summarizeTypeScriptSource("config.ts", "export default { a: 1 };\n");
  assert.deepEqual(notJsx.reactComponents, [], "a plain object is not a component");
});
</file>

<file path="tests/gitignore-anchoring.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { collectFiles } from "../dist/index.js";

/**
 * gitignore(5) semantics in `walk` mode.
 *
 * `readGitignoreRules` keeps the leading `/` of a root-anchored rule, and the matcher that
 * received it — `matchesExclude` — compares against a path with no leading slash. So `/build`
 * could not equal `build`, could not prefix `build/x`, and could not sit between two slashes:
 * a `/secret-notes.txt` rule silently kept its file in the snapshot.
 *
 * The same delegation made the opposite mistake one segment down: gitignore(5) anchors a pattern
 * with a non-trailing `/` to the directory holding the `.gitignore`, so `doc/frotz` ignores the
 * top-level `doc/frotz` only — and `matchesExclude` matched `a/doc/frotz` too.
 *
 * The names here are deliberately not in `DEFAULT_IGNORED_DIRS`, which would exclude them for an
 * unrelated reason and make the test pass without exercising the rule at all.
 */

function makeTree(t, gitignore) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "gitignore-anchor-"));
  const write = (relative, content = "x\n") => {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write(".gitignore", gitignore);
  for (const relative of [
    "generated-code/app.js",
    "secret-notes.txt",
    "deep/generated-code/nested.js",
    "doc/frotz/inside.md",
    "a/doc/frotz/deeper.md",
    "src/keep.ts",
  ]) {
    write(relative);
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const scanned = (dir) =>
  collectFiles(dir, { discovery: "walk" }).files.map((entry) => entry.replace(/\\/g, "/"));

test("a root-anchored directory rule matches at the root and nowhere else", (t) => {
  const dir = makeTree(t, "/generated-code\n");
  const files = scanned(dir);

  assert.ok(!files.includes("generated-code/app.js"), "/generated-code is the root one");
  assert.ok(
    files.includes("deep/generated-code/nested.js"),
    "a directory of the same name below the root is not anchored to it"
  );
});

test("a root-anchored file rule matches", (t) => {
  const dir = makeTree(t, "/secret-notes.txt\n");
  assert.ok(!scanned(dir).includes("secret-notes.txt"));
});

test("a pattern with an inner slash is anchored to the .gitignore's directory", (t) => {
  const dir = makeTree(t, "doc/frotz\n");
  const files = scanned(dir);

  assert.ok(!files.includes("doc/frotz/inside.md"), "the anchored path is ignored");
  assert.ok(
    files.includes("a/doc/frotz/deeper.md"),
    "the same two segments deeper in the tree are a different path"
  );
});

test("a pattern with no slash still matches at any depth", (t) => {
  const dir = makeTree(t, "generated-code\n");
  const files = scanned(dir);

  assert.ok(!files.includes("generated-code/app.js"));
  assert.ok(!files.includes("deep/generated-code/nested.js"), "unanchored means every depth");
});

test("root-anchored glob rules work too", (t) => {
  const dir = makeTree(t, "/secret-*.txt\n");
  assert.ok(!scanned(dir).includes("secret-notes.txt"));
});

test("a negation still re-includes an anchored exclusion", (t) => {
  const dir = makeTree(t, "/generated-code/*\n!/generated-code/keep.js\n");
  const target = path.join(dir, "generated-code", "keep.js");
  fs.writeFileSync(target, "x\n", "utf8");

  const files = scanned(dir);
  assert.ok(files.includes("generated-code/keep.js"), "the negation wins");
  assert.ok(!files.includes("generated-code/app.js"), "the rest of the directory is still out");
});
</file>

<file path="tests/hook-and-worker.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { installPreCommitHook, workerEntry } from "../dist/index.js";

/**
 * 0.9.11 — two places where a path was assembled by hand instead of by the platform.
 */

function makeRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "hook-outdir-"));
  execFileSync("git", ["init", "-q"], { cwd: dir, stdio: "ignore" });
  fs.writeFileSync(path.join(dir, "a.ts"), "export const a = 1;\n", "utf8");
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const hookBody = (dir) =>
  fs.readFileSync(path.join(dir, ".git", "hooks", "pre-commit"), "utf8");

test("the hook checks the configured output directory, not `snapshot`", (t) => {
  const dir = makeRepo(t);
  const result = installPreCommitHook(dir, ".context");

  assert.equal(result.written, true);
  const body = hookBody(dir);
  assert.match(body, /SNAPSHOT_DIR="\.context"/, "the directory the config names");
  assert.doesNotMatch(body, /\[ ! -d snapshot \]/, "the hardcoded guard is gone");
  assert.match(
    body,
    /\[ ! -f "\$SNAPSHOT_DIR\/manifest\.json" \]/,
    "the guard tests the manifest, not the directory"
  );
});

test("the hook default is still `snapshot` for a project that never set outDir", (t) => {
  const dir = makeRepo(t);
  installPreCommitHook(dir);
  assert.match(hookBody(dir), /SNAPSHOT_DIR="snapshot"/);
});

test("a directory with a space or a quote is escaped for the shell", (t) => {
  const dir = makeRepo(t);
  installPreCommitHook(dir, '.my "snap" $dir');
  const body = hookBody(dir);

  assert.match(
    body,
    /SNAPSHOT_DIR="\.my \\"snap\\" \\\$dir"/,
    "a double quote or a dollar sign would otherwise end the word or expand"
  );
});

test("re-installing keeps the marker, so the hook stays recognisably ours", (t) => {
  const dir = makeRepo(t);
  installPreCommitHook(dir, ".context");
  const again = installPreCommitHook(dir, ".context");

  assert.equal(again.written, true, "a hook carrying the marker is refreshed");
  assert.equal((hookBody(dir).match(/codebase-snapshot: pre-commit snapshot check/g) ?? []).length, 1);
});

test("the worker entry URL survives spaces, % and # in the install path", () => {
  // The interpolation form `file://${path}` reads `#` as a fragment, `%` as an escape and leaves
  // a space unescaped, so the worker imported the wrong file — or nothing.
  const directory = path.join(os.tmpdir(), "install dir", "100%", "#tag");
  const { url } = workerEntry(directory, false);

  assert.doesNotMatch(url, /#tag/, "a `#` must be escaped, not read as a fragment");
  assert.match(url, /%20/, "the space is escaped");
  assert.match(url, /%25/, "the percent sign is escaped");
  assert.equal(
    fileURLToPath(url),
    path.join(directory, "index.js"),
    "and the URL round-trips to the real path"
  );
});

test("the worker entry picks the build format's filename", () => {
  const directory = path.join(os.tmpdir(), "worker-entry");
  assert.match(workerEntry(directory, true).path, /index\.cjs$/);
  assert.match(workerEntry(directory, false).path, /index\.js$/);
});
</file>

<file path="tests/hook-install.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { HOOK_MARKER, installPreCommitHook } from "../dist/index.js";

/**
 * The pre-commit hook installer, from the 0.9.9 audit.
 *
 * `docs/stale-context-is-your-bug.md` argues that a snapshot is only trustworthy when
 * something gates on it, and `validate` is that gate — but wiring it into `.git/hooks` was
 * thirty seconds of manual work, which is exactly the kind of step a project skips.
 *
 * The rules that matter here are rule 2 of this repository: never destroy user data. An
 * existing hook this tool did not write is left alone, whatever the flags say.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "hook-install-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const hookPathOf = (dir) => path.join(dir, ".git", "hooks", "pre-commit");

test("it installs an executable hook into a normal checkout", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, ".git"), { recursive: true });

  const result = installPreCommitHook(dir);

  assert.equal(result.written, true, JSON.stringify(result.notes));
  assert.equal(result.path, hookPathOf(dir));
  const body = fs.readFileSync(hookPathOf(dir), "utf8");
  assert.ok(body.startsWith("#!/bin/sh"), "a hook needs a shebang git can run");
  assert.ok(body.includes(HOOK_MARKER), "and a marker this tool can recognise");
  assert.match(body, /validate/, "it gates on the thing that answers the question");
  assert.match(body, /npx --no-install/, "a hook must never install anything");
  if (process.platform !== "win32") {
    const mode = fs.statSync(hookPathOf(dir)).mode;
    assert.ok((mode & 0o111) !== 0, "git refuses to run a hook that is not executable");
  }
});

test("a second run refreshes its own hook instead of refusing", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, ".git"), { recursive: true });
  installPreCommitHook(dir);

  const again = installPreCommitHook(dir);

  assert.equal(again.written, true, JSON.stringify(again.notes));
  assert.ok(again.notes.some((note) => /Updated/.test(note)), again.notes.join(" | "));
});

test("someone else's hook is never touched", (t) => {
  const dir = tempDir(t);
  const hookPath = hookPathOf(dir);
  fs.mkdirSync(path.dirname(hookPath), { recursive: true });
  const foreign = "#!/bin/sh\n# hand-written by a person\nlint-staged\n";
  fs.writeFileSync(hookPath, foreign, "utf8");

  const result = installPreCommitHook(dir);

  assert.equal(result.written, false, "rule 2: a file this tool did not write is not ours");
  assert.equal(fs.readFileSync(hookPath, "utf8"), foreign, "byte for byte unchanged");
  assert.ok(
    result.notes.some((note) => /left untouched/.test(note)),
    "and the refusal is reported"
  );
  assert.ok(
    result.notes.some((note) => /Add `npx codebase-snapshot validate`/.test(note)),
    "with the exact change to make instead"
  );
});

test("a worktree's .git file is followed to the real git directory", (t) => {
  const dir = tempDir(t);
  // A worktree or submodule has `.git` as a file containing a gitdir: line. Writing to
  // `<cwd>/.git/hooks` there fails with ENOTDIR, which reads as "the feature is broken".
  const realGit = path.join(dir, "real-git-dir");
  fs.mkdirSync(realGit, { recursive: true });
  fs.writeFileSync(path.join(dir, ".git"), `gitdir: ${realGit}\n`, "utf8");

  const result = installPreCommitHook(dir);

  assert.equal(result.written, true, JSON.stringify(result.notes));
  assert.equal(result.path, path.join(realGit, "hooks", "pre-commit"));
  assert.ok(fs.existsSync(path.join(realGit, "hooks", "pre-commit")));
});

test("outside a git working tree it says so and writes nothing", (t) => {
  const dir = tempDir(t);

  const result = installPreCommitHook(dir);

  assert.equal(result.written, false);
  assert.equal(result.path, null);
  assert.ok(result.notes.some((note) => /Not a git working tree/.test(note)));
  assert.deepEqual(fs.readdirSync(dir), [], "nothing was created");
});
</file>

<file path="tests/hooks-after-generate.test.js">
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

/**
 * 4.0.9 regression cover for `hooks.afterGenerate`, from the outside.
 *
 * Three things went wrong with user code running inside the generator:
 *   H2 a *rejected* async hook was an unhandled rejection, so the process died with exit 1 after
 *      printing "Snapshot generated … Integrity: passed" and its JSON payload, and nothing reached
 *      the manifest;
 *   H1 a hook's own files were not in the ownership inventory, so the next run refused the
 *      directory it had just written;
 *   H3 a hook's `console.log` landed on stdout and corrupted `--format json`.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-hooks-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content, "utf8");
  return target;
}

/** Runs the CLI and never throws on a non-zero exit, so the exit code can be asserted. */
function runCli(args, cwd) {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd, encoding: "utf8" });
  return { code: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

const CONFIG = (hookBody) => `export default {
  hooks: {
    afterGenerate: ${hookBody},
  },
};
`;

test("H2: a rejected async hook does not crash the process or corrupt the payload", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(
    dir,
    "snapshot.config.mjs",
    CONFIG(`async () => {
    throw new Error("hook exploded");
  }`)
  );

  const { code, stdout, stderr } = runCli(["generate", "--format", "json"], dir);

  assert.equal(code, 0, `the run succeeded before the hook failed; stderr: ${stderr.slice(-400)}`);
  const payload = JSON.parse(stdout);
  assert.ok(payload, "stdout is still a single parseable JSON document");

  // The failure is recorded where a warning belongs, and it reached the shipped manifest.
  const shipped = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8")
  );
  const recorded = shipped.warnings.find((warning) => /hooks\.afterGenerate failed/.test(warning));
  assert.ok(recorded, `the hook failure is in manifest.warnings: ${JSON.stringify(shipped.warnings)}`);
  assert.match(recorded, /hook exploded/);
});

test("H3: a hook's console.log stays off stdout in JSON mode", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(
    dir,
    "snapshot.config.mjs",
    CONFIG(`() => {
    console.log("HOOK-NOISE-ON-STDOUT");
    process.stdout.write("HOOK-RAW-WRITE\\n");
  }`)
  );

  const { code, stdout, stderr } = runCli(["generate", "--format", "json"], dir);

  assert.equal(code, 0);
  assert.doesNotMatch(stdout, /HOOK-NOISE-ON-STDOUT|HOOK-RAW-WRITE/, "stdout carries only the payload");
  assert.match(stderr, /HOOK-NOISE-ON-STDOUT|HOOK-RAW-WRITE/, "the hook's output went to stderr");
  assert.ok(JSON.parse(stdout), "stdout still parses");
});

test("H1: files a hook writes are part of the inventory, so the next run is allowed", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(
    dir,
    "snapshot.config.mjs",
    `import * as fs from "node:fs";
import * as path from "node:path";

export default {
  hooks: {
    afterGenerate: () => {
      fs.writeFileSync(
        path.join(process.cwd(), "snapshot", "hook-report.txt"),
        "from the hook",
        "utf8"
      );
    },
  },
};
`
  );

  const first = runCli(["generate"], dir);
  assert.equal(first.code, 0, first.stderr.slice(-400));
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "hook-report.txt")), "the hook wrote its file");

  // Second run with the hook removed: the directory must still be recognised as tool-written.
  write(dir, "snapshot.config.mjs", "export default {};\n");
  const second = runCli(["generate"], dir);

  assert.equal(second.code, 0, `a refused replacement would fail here: ${second.stderr.slice(-400)}`);
  assert.doesNotMatch(second.stderr, /Refusing to replace outDir/);
});

test("a synchronous hook throw is still downgraded to a warning, not a crash", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "snapshot.config.mjs", CONFIG(`() => { throw new Error("sync boom"); }`));

  const { code, stderr } = runCli(["generate"], dir);

  assert.equal(code, 0, stderr.slice(-400));
  const shipped = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8")
  );
  assert.ok(shipped.warnings.some((warning) => /sync boom/.test(warning)));
});

test("a hook that resolves normally leaves no warning behind", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(dir, "snapshot.config.mjs", CONFIG(`async () => { await Promise.resolve(); }`));

  const { code, stderr } = runCli(["generate"], dir);
  assert.equal(code, 0, stderr.slice(-400));

  const shipped = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8")
  );
  assert.deepEqual(
    shipped.warnings.filter((warning) => /hooks\.afterGenerate/.test(warning)),
    [],
    "a successful hook is not a warning"
  );
});

// A guard so an accidental `execFileSync` import does not rot: the helper above is spawnSync
// because exit codes matter, and this asserts the binary really exists where the tests expect.
test("the built CLI exists", () => {
  assert.ok(fs.existsSync(BIN), `missing ${BIN}; run npm run build`);
  assert.ok(execFileSync(process.execPath, [BIN, "--version"], { encoding: "utf8" }).trim().length > 0);
});
</file>

