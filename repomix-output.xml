<file path="tests/helpers/wizard-harness.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { PassThrough } from "node:stream";

import { runInit } from "../../dist/index.js";

const ANSI = /\u001b\[[0-9;]*[A-Za-z]/g;

/** The project the back/frame suites drive; callers may replace it entirely. */
export const DEFAULT_WIZARD_FILES = Object.freeze({
  "package.json": '{"name":"app","version":"1.0.0"}\n',
  "next.config.ts": "export default {};\n",
  "src/a.ts": "export const a = 1;\n",
});

/** Creates a temporary project, cleaned up with the test. */
export function createWizardProject(t, { files = DEFAULT_WIZARD_FILES, prefix = "wizard-" } = {}) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

/** Finds the config file the wizard wrote, whatever extension it chose. */
export function findConfigName(dir) {
  return fs
    .readdirSync(dir)
    .find((name) => /^snapshot\.config\.(ts|mjs|cjs|js|json)$/.test(name));
}

/**
 * Drives the interactive wizard through a fake TTY.
 *
 * A key is released on each repainted prompt (`◆`), never on arbitrary writes: releasing during
 * the previous prompt's erase can land in a reader that is about to close and stall the run.
 *
 * Variants are options, not forks: `columns` controls wrapping, `captureError` returns a thrown
 * race error instead of re-throwing it, `assertAllKeys` controls the consumed-key check, and
 * `raw`/`screen` are both returned so callers can inspect terminal bytes or readable text.
 */
export async function driveWizard(
  dir,
  keys,
  { columns = 120, captureError = false, assertAllKeys = true, timeoutMs = 5000 } = {}
) {
  const pending = [...keys];
  const chunks = [];

  const output = new PassThrough();
  output.isTTY = true;
  output.columns = columns;

  const input = new PassThrough();
  input.isTTY = true;
  input.isRaw = false;
  input.setRawMode = () => {};

  output.on("data", (chunk) => {
    const text = chunk.toString();
    chunks.push(text);
    if (!text.includes("◆") || pending.length === 0) return;
    const key = pending.shift();
    const press = typeof key === "string" ? { name: key } : key;
    queueMicrotask(() => input.emit("keypress", "", press));
  });

  const timeout = new Promise((_, reject) =>
    setTimeout(
      () => reject(new Error(`the wizard stalled with ${pending.length} key(s) left`)),
      timeoutMs
    )
  );
  const run = runInit({ cwd: dir, io: { input, output } });
  run.catch(() => {});

  let result;
  let error = null;
  try {
    result = await Promise.race([run, timeout]);
  } catch (caught) {
    if (!captureError) throw caught;
    error = caught;
  }

  if (assertAllKeys) assert.deepEqual(pending, [], "every programmed key was consumed");
  const raw = chunks.join("");
  return { result, error, raw, screen: raw.replace(ANSI, "") };
}
</file>

<file path="tests/agent-contract-truth.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

/**
 * The agent contract is an agent's only source of truth before it has context,
 * so its steps must be runnable *today* — not on the day this release happened
 * to be the newest one on the registry — and its field inventory must not
 * promise optional fields unconditionally.
 *
 * Each test below fails against the 4.0.9 contract strings:
 *   - step 1 pinned `v<exact patch>` against a floating `@latest` tag;
 *   - step 3 claimed `snapshot.config.ts` for every project;
 *   - `output.notes` promised a structural summary for every `files[]` entry.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function run(args, options = {}) {
  return spawnSync(process.execPath, [BIN, ...args], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    ...options,
  });
}

/** The machine contract exactly as an agent receives it. */
function describeJson() {
  const result = run(["describe", "--format", "json"]);
  assert.equal(result.status, 0, `describe failed: ${result.stderr}`);
  return JSON.parse(result.stdout);
}

/** Fixture with a CommonJS package.json (no `"type": "module"`). */
function makeCommonJsFixture() {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cs-contract-cjs-"));
  fs.writeFileSync(
    path.join(dir, "package.json"),
    JSON.stringify({ name: "contract-cjs-fixture", version: "1.0.0" })
  );
  fs.writeFileSync(path.join(dir, "app.py"), "value = 1\n");
  return dir;
}

test("B-1: workflow step 1 cannot contradict the version it runs", () => {
  const contract = describeJson();
  const major = String(contract.version).split(".")[0];
  const escapedVersion = contract.version.replace(/\./g, "\\.");
  const step = contract.workflow[0];

  // The probe still runs the floating tag...
  assert.match(step.run, /@latest\s+--version/, `step 1 must probe @latest: ${step.run}`);

  // ...but the *requirement* is the contract's major, so a lagging registry tag
  // (or a newer one) cannot make step 1 impossible.
  assert.match(
    step.expect,
    new RegExp(`prints v${major} or newer on stdout and exits 0`),
    `step 1 must require the contract major v${major}: ${step.expect}`
  );

  // The old contract form — "prints v<exact patch> on stdout and exits 0" — must
  // be gone: that is the string that contradicts a floating @latest.
  assert.doesNotMatch(
    step.expect,
    new RegExp(`prints v${escapedVersion} on stdout`),
    `step 1 must not require the exact running patch: ${step.expect}`
  );

  // The build version may appear only as clearly-labelled context, never as the
  // expectation an agent compares @latest against.
  if (step.expect.includes(`v${contract.version}`)) {
    assert.match(
      step.expect,
      new RegExp(`this build is v${escapedVersion}`),
      `the exact version must be labelled as build context: ${step.expect}`
    );
  }

  // No workflow entry may require an exact patch of a floating tag.
  for (const entry of contract.workflow.slice(1)) {
    assert.doesNotMatch(
      entry.expect,
      /\bv\d+\.\d+\.\d+\b/,
      `workflow step ${entry.step} (${entry.id}) pins an exact patch: ${entry.expect}`
    );
  }
  for (const entry of contract.workflow) {
    assert.doesNotMatch(
      entry.run,
      /@\d+\.\d+\.\d+/,
      `workflow step ${entry.step} (${entry.id}) pins an exact version in its command: ${entry.run}`
    );
  }
});

test("B-2: the configure step matches init's real config filename", () => {
  const contract = describeJson();
  const step = contract.workflow.find((entry) => entry.id === "configure");
  assert.ok(step, "the contract must keep a configure step");

  // Real behaviour: a CommonJS project gets snapshot.config.mjs on every
  // supported Node version (a .ts config needs Node >= 22.6 *and* an ES module).
  const dir = makeCommonJsFixture();
  try {
    const result = run(["init", "--yes", "--cwd", dir]);
    assert.equal(result.status, 0, `init failed: ${result.stderr}`);
    assert.ok(
      fs.existsSync(path.join(dir, "snapshot.config.mjs")),
      "init must write snapshot.config.mjs for a CommonJS project"
    );
    assert.equal(
      fs.existsSync(path.join(dir, "snapshot.config.ts")),
      false,
      "init must not write snapshot.config.ts for a CommonJS project"
    );
  } finally {
    fs.rmSync(dir, { recursive: true, force: true });
  }

  const text = `${step.expect} ${step.notes ?? ""}`;
  assert.match(text, /snapshot\.config\.mjs/, `the configure step must mention .mjs: ${text}`);
  assert.match(
    text,
    /ES module|"type"\s*:\s*"module"|type: module/i,
    `the configure step must name the ES-module condition: ${text}`
  );
  assert.match(
    text,
    /22\.6|strip types|type stripping/i,
    `the configure step must name the Node requirement for a .ts config: ${text}`
  );
  assert.doesNotMatch(
    step.expect,
    /^writes snapshot\.config\.ts\b/,
    `the configure step must not claim .ts unconditionally: ${step.expect}`
  );
});

test("B-3: output.notes says the per-file summary is conditional", () => {
  const contract = describeJson();
  const notes = contract.output.notes.join("\n");

  assert.match(
    notes,
    /summaryOmitted/,
    `output.notes must explain summaryOmitted: ${notes}`
  );
  assert.match(
    notes,
    /summary[\s\S]{0,200}(absent|omit|only when|conditional|optional)/i,
    `output.notes must say the summary can be missing: ${notes}`
  );
  assert.doesNotMatch(
    notes,
    /carries[^.\n]*and a structural summary\./,
    "output.notes must not promise a summary for every files[] entry"
  );
});

test("the shipped skill repeats the same honest rules", () => {
  const contract = describeJson();
  const major = String(contract.version).split(".")[0];
  const result = run(["skill"]);
  assert.equal(result.status, 0, `skill failed: ${result.stderr}`);
  const skill = result.stdout;

  assert.match(
    skill,
    new RegExp(`v${major}\`?\\s+or\\s+newer`),
    `the skill must verify the major version, not the patch: ${skill.slice(0, 600)}`
  );
  assert.doesNotMatch(
    skill,
    new RegExp(`v${contract.version.replace(/\./g, "\\.")}\\b`),
    "the skill must not pin the exact patch against @latest"
  );
  assert.match(skill, /snapshot\.config\.mjs/, "the skill must mention the .mjs config fallback");
  assert.match(skill, /22\.6|strip types|type stripping/i, "the skill must name the Node requirement");
  assert.match(skill, /summaryOmitted/, "the skill must explain summaryOmitted");
});
</file>

<file path="tests/ast-frontmatter-json-imports.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  generateSnapshot,
  isSkeletonizable,
  resolveConfig,
  skeletonizeTypeScript,
  stripJsonComments,
  summarizeJson,
  summarizeMarkdown,
  summarizeTypeScriptSource,
} from "../dist/index.js";

/**
 * The AST layer: what a Markdown document's front matter is, what JSONC tolerates, which module
 * edges a file declares, and which files signature compression applies to.
 *
 * Every one of these answers "what is in this file?" for the manifest index that agents query
 * before reading anything. An index that silently omits half a document's headings, a file's
 * imports, or a whole language is worse than no index: it reads as complete.
 */

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "ast-shapes-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

test("a leading horizontal rule is not YAML front matter", () => {
  // The check scanned to the end of the file for any `---` line and called the result front matter,
  // so a document that opens with a horizontal rule and uses another one as a section divider had
  // every heading between them removed from its summary — the index claimed a document with no
  // sections.
  const ruleDoc = ["---", "# Title", "", "Intro paragraph.", "---", "## Section", "text"].join("\n");
  const summary = summarizeMarkdown(ruleDoc);
  assert.deepEqual(summary.headings, ["# Title", "## Section"]);
  assert.deepEqual(summary.frontmatterKeys, [], "a rule is not front matter");

  // A fenced block between the two rules settles it too.
  const fenced = ["---", "```js", "const a = 1;", "```", "---", "# Heading"].join("\n");
  assert.deepEqual(summarizeMarkdown(fenced).headings, ["# Heading"]);
  assert.deepEqual(summarizeMarkdown(fenced).frontmatterKeys, []);

  // A `---` and a later `---` with prose between them is two rules, not front matter.
  const prose = ["---", "Some prose.", "---", "## Later"].join("\n");
  assert.deepEqual(summarizeMarkdown(prose).frontmatterKeys, []);
  assert.deepEqual(summarizeMarkdown(prose).headings, ["## Later"]);
});

test("real front matter is still front matter", () => {
  const yaml = ["---", "title: Foo", "tags: [a, b]", "---", "# Heading"].join("\n");
  const summary = summarizeMarkdown(yaml);
  assert.deepEqual(summary.frontmatterKeys, ["tags", "title"]);
  assert.deepEqual(summary.headings, ["# Heading"]);

  // A `...` document terminator closes a YAML block just as `---` does.
  const dotted = ["---", "title: Foo", "...", "# Heading"].join("\n");
  assert.deepEqual(summarizeMarkdown(dotted).frontmatterKeys, ["title"]);
  assert.deepEqual(summarizeMarkdown(dotted).headings, ["# Heading"]);

  // Indented continuations and a blank line inside the block are still YAML.
  const multi = [
    "---",
    "description: >",
    "  a folded value",
    "",
    "title: Foo",
    "---",
    "# Heading",
  ].join("\n");
  const multiSummary = summarizeMarkdown(multi);
  assert.deepEqual(multiSummary.frontmatterKeys, ["description", "title"]);
  assert.deepEqual(multiSummary.headings, ["# Heading"]);
});

test("JSONC: trailing commas, CR-only lines, and block comments that keep their lines", () => {
  // `src/ast/structured.ts` had its own `stripJsonComments` that only ended a `//` comment on `\n`
  // and never removed a trailing comma — so a `.jsonc` or `tsconfig.json` written the way editors
  // write them summarised as `invalid-json` with no keys at all.
  const trailing = summarizeJson('{\n  "compilerOptions": {},\n  "files": [],\n}\n');
  assert.equal(trailing.shape, "object");
  assert.deepEqual(trailing.keys, ["compilerOptions", "files"]);

  // A `\r`-only line comment ends at the carriage return, not at the end of the file.
  const crOnly = summarizeJson('{\r// a comment\r"a": 1,\r}');
  assert.equal(crOnly.shape, "object", "a CR-delimited line comment ends at the carriage return");
  assert.deepEqual(crOnly.keys, ["a"]);

  // A block comment keeps the terminators it spans: dropping them renumbered every line after it,
  // and the summary's line references are read against the real file.
  const withBlock = '{\n/* one\n   two */\n"a": 1\n}\n';
  assert.equal(
    stripJsonComments(withBlock).split("\n").length,
    withBlock.split("\n").length,
    "the comment's line breaks survive"
  );

  // A `//` inside a string is still not a comment.
  assert.equal(summarizeJson('{"url": "https://example.com/a"}').shape, "object");
});

test("require, import() and import-equals are module edges too", () => {
  // `summarizeTypeScriptSource` only looked at `ts.isImportDeclaration` and
  // `ts.isExportDeclaration`, so a CommonJS project, and any code using `await import()`, recorded
  // no import edges at all — which is what `manifest.indexes.imports`, `snapshot_dependents` and
  // `--with-dependents` are built from.
  const source = [
    'const legacy = require("./cjs-target");',
    'async function load() { return import("./dynamic-target"); }',
    'import fs = require("node:fs");',
    'import { named } from "./static-target";',
    'export { thing } from "./named-re-export";',
    'export * from "./star-re-export";',
  ].join("\n");

  const summary = summarizeTypeScriptSource("mixed.ts", source);
  for (const specifier of [
    "./cjs-target",
    "./dynamic-target",
    "node:fs",
    "./static-target",
    "./named-re-export",
    "./star-re-export",
  ]) {
    assert.ok(summary.imports.includes(specifier), `${specifier} is recorded: ${summary.imports}`);
  }
  assert.ok(summary.reExports.includes("./named-re-export"), "a named re-export is a re-export");
  assert.ok(summary.reExports.includes("./star-re-export"));

  // A non-literal specifier is an expression, and guessing at it would be worse than saying
  // nothing: no edge is recorded rather than a wrong one.
  const computed = summarizeTypeScriptSource(
    "c.ts",
    'const name = "./x";\nconst a = require(name);\nconst b = import(`./tpl/${name}.js`);\n'
  );
  assert.deepEqual(computed.imports, []);
});

test("signature compression covers JavaScript and JSX, not just TypeScript", (t) => {
  // `skeletonizeTypeScript` parses `.js`/`.jsx`/`.mjs`/`.cjs` natively when it is told which
  // ScriptKind to use, and `--skeleton` was limiting itself to the four TypeScript spellings — so
  // the files most repositories are made of were the ones it could not compress. It also parsed
  // `.d.ts` files, which have no bodies to collapse.
  for (const extension of [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"]) {
    assert.equal(isSkeletonizable(`src/app${extension}`), true, `${extension} is compressible`);
  }
  for (const extension of [".d.ts", ".d.mts", ".d.cts"]) {
    assert.equal(isSkeletonizable(`src/types${extension}`), false, `${extension} has no bodies`);
  }

  // The script kind has to follow the extension or JSX is a syntax error.
  const jsx = "export function App() {\n  return <div>{name}</div>;\n}\n";
  const collapsed = skeletonizeTypeScript(jsx, "App.jsx");
  assert.equal(collapsed.collapsed, 1);
  assert.equal(collapsed.text.includes("{ /* ... */ }"), true);
  assert.equal(collapsed.text.includes("<div>"), false, "the body is gone, the signature is not");

  // End to end: a `.js` file really is compressed by `generate --skeleton` now.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.js": 'export function compute() {\n  return 6 * 7;\n}\n',
    "src/app.ts": 'export function computeTs() {\n  return 6 * 7;\n}\n',
  });
  const config = resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk", skeleton: true },
    {},
    root
  );
  const manifest = generateSnapshot(config);
  for (const file of ["src/app.js", "src/app.ts"]) {
    const entry = manifest.files.find((candidate) => candidate.relativePath === file);
    assert.equal(entry?.inclusionMode, "signatures", `${file} was compressed`);
  }
  const partText = fs.readFileSync(path.join(root, "snapshot", "parts", manifest.parts[0].filename), "utf8");
  assert.equal(partText.includes("6 * 7"), false, "and no body reached the part");
});
</file>

<file path="tests/audit-readme-hygiene.test.js">
/**
 * Audit + README display hygiene for *config* text (L1 / L2 of the wave-3 re-audit).
 *
 * File names were already re-spelled in every artifact, but a layer name supplied
 * by a committed `snapshot.config.json` reached two tables raw: the audit's layer
 * distribution and the README's "Layers Covered" column. A layer name is config
 * text from the repository under analysis, so it is the same untrusted input.
 *
 * The contract these tests pin down:
 *   - `reports/audit.md` and the snapshot `README.md` re-spell control and bidi
 *     characters as `\uXXXX`;
 *   - the raw code point does not appear in either;
 *   - `manifest.json` keeps the raw name, because it is the machine index and has
 *     to describe the configuration as it is on disk.
 *
 * Fixtures are created without git on purpose: this suite never runs git.
 */
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, loadConfigFile, resolveConfig } from "../dist/index.js";

const RLO = "\u202E"; // right-to-left override
const ESC = "\u001B"; // C0 escape, the start of every ANSI sequence

const RLO_LAYER = `core${RLO}gnp.exe`;
const ESC_LAYER = `retro${ESC}[31mred`;
const ESCAPED_RLO_LAYER = String.raw`core\u202Egnp.exe`;
const ESCAPED_ESC_LAYER = String.raw`retro\u001B[31mred`;

async function withRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "audit-readme-hygiene-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  const write = (relativePath, content) => {
    const full = path.join(dir, relativePath);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content);
  };

  // A committed config: the layer names are the untrusted input under test.
  write(
    "snapshot.config.json",
    JSON.stringify(
      {
        layersMode: "replace",
        layers: [
          { name: RLO_LAYER, match: "src/**" },
          { name: ESC_LAYER, match: "docs/**" },
        ],
      },
      null,
      2
    )
  );
  write("src/a.ts", "export const a = 1;\n");
  write("docs/notes.md", "# notes\n");

  const loaded = await loadConfigFile(dir);
  const manifest = generateSnapshot(
    resolveConfig({ ...loaded, cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" })
  );
  const read = (relativePath) => fs.readFileSync(path.join(dir, "snapshot", relativePath), "utf8");
  return {
    manifest,
    audit: read(path.join("reports", "audit.md")),
    readme: read("README.md"),
    manifestJson: read("manifest.json"),
  };
}

test("L1: audit.md re-spells a config layer name instead of printing it raw", async (t) => {
  const { audit } = await withRepo(t);

  assert.ok(audit.includes(ESCAPED_RLO_LAYER), "the layer table must show the escaped spelling");
  assert.ok(audit.includes(ESCAPED_ESC_LAYER), "an ESC in a layer name must be escaped too");
  assert.equal(audit.includes(RLO), false, "U+202E must not reach audit.md raw");
  assert.equal(audit.includes(ESC), false, "ESC must not reach audit.md raw");
});

test("L2: the snapshot README re-spells the Layers Covered column", async (t) => {
  const { readme } = await withRepo(t);

  assert.ok(readme.includes(ESCAPED_RLO_LAYER), "the part table must show the escaped spelling");
  assert.ok(readme.includes(ESCAPED_ESC_LAYER), "an ESC in a layer name must be escaped too");
  assert.equal(readme.includes(RLO), false, "U+202E must not reach README.md raw");
  assert.equal(readme.includes(ESC), false, "ESC must not reach README.md raw");
});

test("L3: manifest.json keeps the raw layer name", async (t) => {
  const { manifest, manifestJson } = await withRepo(t);

  assert.ok(manifest.layers[RLO_LAYER] >= 1, "the machine index must key the layer by its raw name");
  assert.ok(manifest.layers[ESC_LAYER] >= 1, "the ESC layer must be keyed by its raw name too");
  assert.ok(manifestJson.includes(RLO_LAYER), "the raw U+202E must survive into manifest.json");
  assert.equal(manifestJson.includes(ESCAPED_RLO_LAYER), false, "manifest.json must not be escaped");
});
</file>

<file path="tests/binary-detection.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, resolveConfig } from "../dist/index.js";

/**
 * What counts as text, decided once on the bytes that were read.
 *
 * `generate` used to ask twice: `isBinaryFile` opened the file, chunk-read it looking for
 * a NUL, and then the file was read again in full and scanned again by `decodeText`.
 * The pre-scan now only runs above the 8 MB cap, where loading the file to answer the
 * question is the thing to avoid. This suite pins the decisions that refactor must not
 * change — including the two cases only `decodeText` can see: a NUL past a head sample,
 * and a valid-UTF-8 payload that is control bytes rather than text.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "binary-detect-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function build(dir) {
  const write = (relative, content) => {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  };

  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write("src/plain.ts", "export const plain = 1;\n");
  // A NUL well past any head sample.
  write("data/embedded.bin", Buffer.concat([Buffer.alloc(100_000, 0x41), Buffer.from([0]), Buffer.from("tail")]));
  // Valid UTF-8, no NUL, but not text.
  write("data/controls.bin", Buffer.alloc(4096, 0x07));
  // UTF-16 with a BOM is text and must be transcoded, not skipped.
  write("src/wide.ts", Buffer.concat([Buffer.from([0xff, 0xfe]), Buffer.from("export const w = 1;\n", "utf16le")]));
  // A binary extension is refused without reading at all.
  write("assets/logo.png", Buffer.from("not really a png"));

  return resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" });
}

test("generate classifies text and binary content the same way after the refactor", (t) => {
  const dir = tempDir(t);
  const config = build(dir);

  const manifest = generateSnapshot(config);
  const included = manifest.files.map((file) => file.relativePath).sort();
  const skippedBinary = manifest.skipped
    .filter((entry) => entry.reason === "binary")
    .map((entry) => entry.path)
    .sort();

  assert.ok(included.includes("src/plain.ts"), "plain source is included");
  assert.ok(included.includes("src/wide.ts"), "a UTF-16 file is transcoded, not skipped");
  assert.deepEqual(skippedBinary, ["assets/logo.png", "data/controls.bin", "data/embedded.bin"]);
  // The reason is more specific than a size, which is what the single decode buys.
  const controls = manifest.skipped.find((entry) => entry.path === "data/controls.bin");
  assert.match(String(controls?.detail), /control byte|not text/);
  const embedded = manifest.skipped.find((entry) => entry.path === "data/embedded.bin");
  assert.match(String(embedded?.detail), /NUL byte at offset 100000/);
});
</file>

<file path="tests/cli-flag-forwarding.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { shouldCheck } from "../dist/index.js";

/**
 * Flags the CLI accepted and then dropped, from the 0.9.9 audit.
 *
 * `setup` writes a config and then generates *through the generate command*, and it built
 * that inner command line by hand. Five options the caller had just chosen were not copied
 * into it, so the run reported one configuration and generated with another — the exact
 * silent fallback rule 1 forbids, with the user's own flag as the evidence.
 *
 * `--only-artifacts monolith` had a second version of the same problem: it turned the six
 * default artifacts off and relied on `includeMonolith` to turn the seventh on, and neither
 * `init` nor `setup` passed `includeMonolith` on, so the config it wrote enabled *nothing*.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cli-forward-"));
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "big.ts"), `${"export const x = 1;\n".repeat(200)}`);
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function run(dir, command, args = []) {
  // `--no-install` belongs to `setup` only; passing it to `init` is a usage error by
  // design, and the parser is right to reject a flag that changes nothing for a command.
  const flags = command === "setup" ? ["--no-install"] : [];
  const result = spawnSync(
    process.execPath,
    [BIN, command, "--cwd", dir, ...flags, ...args],
    { encoding: "utf8" }
  );
  if (result.error) throw result.error;
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

const configName = (dir) =>
  fs.readdirSync(dir).find((name) => /^snapshot\.config\.(ts|mjs|cjs|js|json)$/.test(name));

test("setup --only-artifacts monolith enables the monolith instead of disabling everything", (t) => {
  const dir = makeRepo(t);

  const result = run(dir, "setup", ["--only-artifacts", "monolith"]);

  assert.equal(result.code, 0, result.stderr);
  const text = fs.readFileSync(path.join(dir, configName(dir)), "utf8");
  assert.match(text, /includeMonolith:\s*true/, "the named artifact must be enabled");
  assert.match(text, /monolith:\s*true/, "and the artifact switch agrees");
  assert.match(text, /readme:\s*false/, "everything else is off");
  assert.match(text, /parts:\s*false/);
});

test("init --yes --only-artifacts monolith writes a config that generates something", (t) => {
  const dir = makeRepo(t);

  const result = run(dir, "init", ["--yes", "--only-artifacts", "monolith"]);

  assert.equal(result.code, 0, result.stderr);
  const text = fs.readFileSync(path.join(dir, configName(dir)), "utf8");
  assert.match(text, /includeMonolith:\s*true/);
});

test("setup forwards the size flags it accepted", (t) => {
  const dir = makeRepo(t);

  const result = run(dir, "setup", [
    "--large-file-bytes",
    "10",
    "--max-monolith-bytes",
    "1mb",
    "--include-monolith",
    "--format",
    "json",
  ]);

  assert.equal(result.code, 0, result.stderr);
  const document = JSON.parse(result.stdout);
  const config = document.manifest.config;
  assert.equal(config.largeFileBytes, 10, "--large-file-bytes reached the generator");
  assert.equal(config.includeMonolith, true, "--include-monolith reached the generator");
  assert.equal(config.maxMonolithBytes, 1024 * 1024, "--max-monolith-bytes reached the generator");
});

test("setup forwards the discovery mode it accepted", (t) => {
  const dir = makeRepo(t);
  // Not a git repository, so `--discovery git` must be refused rather than quietly
  // falling back to the walk — which is exactly what happens when the flag is dropped.
  const result = run(dir, "setup", ["--discovery", "git"]);

  assert.notEqual(result.code, 0, "git mode in a non-repository is a refusal");
  assert.match(result.stderr, /Discovery mode is `git`/);
});

test("the walk mode still works through setup", (t) => {
  const dir = makeRepo(t);
  const result = run(dir, "setup", ["--discovery", "walk"]);
  assert.equal(result.code, 0, result.stderr);
});

test("a file named *.json in the arguments does not disable the update check", () => {
  const env = { ...process.env };
  delete env.CI;
  delete env.CODEBASE_SNAPSHOT_NO_UPDATE_CHECK;

  // The check is skipped when the *output format* is JSON, not when a word containing
  // "json" appears anywhere in the command line.
  assert.equal(shouldCheck(["explain", "package.json"], env), true);
  assert.equal(shouldCheck(["diff", "a/manifest.json", "b/manifest.json"], env), true);
  assert.equal(shouldCheck(["explain", "package.json", "--format", "json"], env), false);
  assert.equal(shouldCheck(["generate", "--format=json"], env), false);
});
</file>

<file path="tests/config-budget.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { generateSnapshot, normalizeResolvedConfig, resolveConfig } from "../dist/index.js";

/**
 * Two budget bugs from the 0.9.10 audit.
 *
 * 1. `{ ...resolved, maxPartBytes: 64 * 1024 }` is a resolved config by every structural test,
 *    so `normalizeResolvedConfig` kept the **old** `budgets` object and the new number was
 *    dropped. The partitioner reads `budgets.default`, so a caller who lowered the budget got
 *    300 KB parts and a manifest that recorded 64 KB.
 * 2. `--max-part-tokens 200` is 800 bytes, below the 4096-byte floor. It was accepted and raised
 *    to 1024 tokens without a word — the setting never applied, and the number printed back was
 *    a different one. Rule 1 says an impossible budget is an error.
 */

const BIN = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "dist", "bin.js");

function tempRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "budget-"));
  fs.writeFileSync(path.join(dir, "a.ts"), "export const a = 1;\n", "utf8");
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function run(args, cwd) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    cwd,
    encoding: "utf8",
    timeout: 60_000,
  });
  assert.equal(result.error, undefined);
  return { status: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

test("a spread config's new maxPartBytes reaches budgets.default", () => {
  const resolved = resolveConfig({ cwd: process.cwd(), maxPartBytes: 300 * 1024 });
  assert.equal(resolved.budgets.default, 300 * 1024);

  const spread = { ...resolved, maxPartBytes: 64 * 1024 };
  const normalized = normalizeResolvedConfig(spread);

  assert.equal(normalized.maxPartBytes, 64 * 1024);
  assert.equal(normalized.budgets.default, 64 * 1024, "the partitioner reads budgets.default");
});

test("a spread config's budget caps the per-layer budgets as well", () => {
  const resolved = resolveConfig({
    cwd: process.cwd(),
    maxPartBytes: 300 * 1024,
    budgets: { default: "300k", byLayer: { docs: "200k", api: "400k" } },
  });
  const normalized = normalizeResolvedConfig({ ...resolved, maxPartBytes: 64 * 1024 });

  assert.equal(normalized.budgets.default, 64 * 1024);
  assert.equal(normalized.budgets.byLayer.docs, 64 * 1024, "capped, not left above the budget");
  assert.equal(normalized.budgets.byLayer.api, 64 * 1024);
});

test("a smaller budget on a spread config is what the partitioner enforces", (t) => {
  const dir = tempRepo(t);
  // ~150 KB of text, so a 64 KB budget must split it and a 300 KB one would not.
  fs.writeFileSync(
    path.join(dir, "big.ts"),
    "export const big = [\n" +
      Array.from({ length: 3000 }, (_, index) => `  "line ${index} of padding text here",`).join("\n") +
      "\n];\n",
    "utf8"
  );

  const resolved = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    maxPartBytes: 300 * 1024,
  });
  const manifest = generateSnapshot({ ...resolved, maxPartBytes: 64 * 1024 });

  assert.ok(
    manifest.counts.partsCount >= 2,
    `a 64 KB budget cannot fit 150 KB in one part (got ${manifest.counts.partsCount})`
  );
  for (const part of manifest.parts) {
    assert.ok(
      part.byteSize <= 64 * 1024,
      `${part.filename} is ${part.byteSize} bytes, over the spread budget`
    );
  }
});

test("a config that only sets budgets.default still records that budget", (t) => {
  const dir = tempRepo(t);
  const manifest = generateSnapshot({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    budgets: { default: "100k" },
  });

  // The partitioner read `budgets.default`; the manifest recorded `maxPartBytes`, which used to
  // stay at the 300 KB default. One snapshot describing two different budgets is a lie either way.
  assert.equal(manifest.config.maxPartBytes, 100 * 1024);
});

test("--max-part-tokens below the floor is a usage error, not a silent clamp", (t) => {
  const dir = tempRepo(t);
  const result = run(["generate", "--max-part-tokens", "200", "--cwd", dir], dir);

  assert.equal(result.status, 2, "a usage error, not a run");
  assert.match(result.stderr, /max-part-tokens/);
  assert.match(result.stderr, /at least 1024/, "the floor it needs, in the unit it was written in");
});

test("--max-part-tokens rejects a byte count with advice about tokens", (t) => {
  const dir = tempRepo(t);
  const result = run(["generate", "--max-part-tokens", "many", "--cwd", dir], dir);

  assert.equal(result.status, 2);
  assert.match(result.stderr, /token count/, "the unit that was asked for");
  assert.doesNotMatch(result.stderr, /expects a byte count/);
});

test("--max-part-tokens at the floor is accepted", (t) => {
  const dir = tempRepo(t);
  const result = run(
    ["generate", "--max-part-tokens", "1024", "--cwd", dir, "--skip-artifacts", "monolith"],
    dir
  );

  assert.equal(result.status, 0, result.stderr);
});
</file>

<file path="tests/config-digest-and-keys.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  configDigest,
  loadConfigFileDetailed,
  resolveConfig,
} from "../dist/index.js";

/**
 * `configDigest` is what `validate` uses to answer "is this snapshot still configured
 * the way it was generated". It hashed layer *names* and kind *names*, so a matcher
 * change — the thing that actually decides which files land in which layer — produced
 * an identical digest and `validate` said "valid and up to date" for a snapshot whose
 * files had all moved. These tests pin the settings that change what a snapshot
 * contains, together with the two config-validation gaps found in the same audit.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "config-truth-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

const resolve = (dir, overrides = {}) =>
  resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", ...overrides });

test("a layer matcher change moves the digest", (t) => {
  const dir = tempDir(t);
  const before = resolve(dir, { layers: [{ name: "api", match: "src/api/**" }] });
  const after = resolve(dir, { layers: [{ name: "api", match: "src/v2/**" }] });
  assert.equal(before.layers[0].name, after.layers[0].name, "only the matcher differs");
  assert.notEqual(configDigest(before), configDigest(after));
});

test("a kind matcher change moves the digest", (t) => {
  const dir = tempDir(t);
  const before = resolve(dir, { kinds: [{ kind: "test", match: "**/*.test.ts" }] });
  const after = resolve(dir, { kinds: [{ kind: "test", match: "**/*.spec.ts" }] });
  assert.notEqual(configDigest(before), configDigest(after));
});

test("a discovery change moves the digest", (t) => {
  const dir = tempDir(t);
  const git = resolve(dir, { discovery: "git" });
  const walk = resolve(dir, { discovery: "walk" });
  assert.notEqual(git.discovery, walk.discovery, "the fixtures must really differ");
  assert.notEqual(configDigest(git), configDigest(walk));
});

test("a secret rule's flags and value group move the digest", (t) => {
  const dir = tempDir(t);
  const plain = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    secretRules: [{ rule: "tenant-key", pattern: /tenant_[a-z]{8}/ }],
  });
  const insensitive = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    secretRules: [{ rule: "tenant-key", pattern: /tenant_[a-z]{8}/i }],
  });
  const masked = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    secretRules: [{ rule: "tenant-key", pattern: /(tenant_[a-z]{8})/, valueGroup: 1 }],
  });

  // Same rule, same source text; a different set of lines is masked in each case.
  assert.notEqual(configDigest(plain), configDigest(insensitive), "the `i` flag matters");
  assert.notEqual(configDigest(plain), configDigest(masked), "the value group matters");
});

test("an unchanged configuration keeps its digest", (t) => {
  const dir = tempDir(t);
  const once = resolve(dir, { layers: [{ name: "api", match: "src/api/**" }] });
  const again = resolve(dir, { layers: [{ name: "api", match: "src/api/**" }] });
  assert.equal(configDigest(once), configDigest(again));
});

test("an unknown key under package.json#snapshot is reported, not ignored", async (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(
    path.join(dir, "package.json"),
    `${JSON.stringify({ name: "fixture", version: "1.0.0", snapshot: { maxPartByte: 4096 } }, null, 2)}\n`
  );

  const loaded = await loadConfigFileDetailed(dir);

  assert.equal(loaded.config, null, "a typo must not become a defaulted run");
  assert.ok(
    loaded.errors.some((error) => /unknown setting\(s\): `maxPartByte`/.test(error)),
    `the misspelling must be named: ${JSON.stringify(loaded.errors)}`
  );
  assert.ok(
    loaded.warnings.some((warning) => /unknown setting/.test(warning)),
    "and it must be warned about as well"
  );
});

test("a config file may spell custom rules as secretRules", async (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(
    path.join(dir, "snapshot.config.json"),
    `${JSON.stringify({ secretRules: [{ rule: "tenant-key", pattern: "tenant_[a-z]{8}" }] }, null, 2)}\n`
  );

  const loaded = await loadConfigFileDetailed(dir);

  assert.deepEqual(loaded.errors, [], "secretRules is a documented spelling, not a typo");
  assert.ok(loaded.config, "the file must load");
  const resolved = resolveConfig({ ...loaded.config, cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" });
  assert.ok(
    resolved.secretRules.some((rule) => rule.rule === "tenant-key"),
    "and its rule must reach the resolver"
  );
});
</file>

<file path="tests/create-scaffolder.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

/**
 * Tests for `packages/create` — the `npm create codebase-snapshot` shim.
 *
 * The shim imports the main package by name, which only resolves in a published
 * install. Each test therefore rebuilds that layout in a temp directory: a
 * `node_modules/codebase-snapshot` link to this checkout (whose
 * `dist/` the pretest step builds) plus a byte-identical copy of the shim's own
 * `index.mjs`/`package.json`, so the code under test is the shipped file.
 */

const here = path.dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = path.resolve(here, "..");
const SHIM_SOURCE = path.join(REPO_ROOT, "packages", "create");
const DEPENDENCY = "codebase-snapshot";

function temporaryDirectory(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cs-create-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

/** Recreates the published layout so the shim's bare import resolves. */
function createHarness(t) {
  if (!fs.existsSync(path.join(REPO_ROOT, "dist", "index.js"))) {
    t.skip("dist/ is not built; the pretest step builds it");
    return null;
  }

  const dir = temporaryDirectory(t);
  const nodeModules = path.join(dir, "node_modules");
  fs.mkdirSync(nodeModules, { recursive: true });
  try {
    fs.symlinkSync(
      REPO_ROOT,
      path.join(nodeModules, DEPENDENCY),
      process.platform === "win32" ? "junction" : "dir"
    );
  } catch {
    t.skip("this host cannot create directory links");
    return null;
  }

  const shim = path.join(dir, "create");
  fs.mkdirSync(shim, { recursive: true });
  for (const name of ["index.mjs", "package.json"]) {
    fs.copyFileSync(path.join(SHIM_SOURCE, name), path.join(shim, name));
  }
  return { dir, shim: path.join(shim, "index.mjs") };
}

function writeProject(dir, extra = {}) {
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n");
  fs.writeFileSync(
    path.join(dir, "package.json"),
    `${JSON.stringify({ name: "fixture", version: "1.0.0", ...extra }, null, 2)}\n`
  );
}

function runShim(shim, cwd, args = ["--yes"], env = {}) {
  const result = spawnSync(process.execPath, [shim, ...args], {
    cwd,
    encoding: "utf8",
    env: { ...process.env, ...env },
  });
  return { code: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

function declaredRange() {
  const manifest = JSON.parse(fs.readFileSync(path.join(SHIM_SOURCE, "package.json"), "utf8"));
  return manifest.dependencies[DEPENDENCY];
}

test("C-3: a directory without package.json prints a runnable next step", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  const target = path.join(harness.dir, "no-package-json");
  fs.mkdirSync(path.join(target, "src"), { recursive: true });
  fs.writeFileSync(path.join(target, "src", "a.ts"), "export const a = 1;\n");

  const run = runShim(harness.shim, target);

  assert.equal(run.code, 0, run.stderr);
  // The regression: the old text promised `npm run snapshot` although no scripts
  // could be added, so the documented next step failed with ENOENT.
  assert.match(run.stderr, /Next:\s+npx codebase-snapshot generate/);
  assert.equal(
    run.stderr.includes("npm run snapshot"),
    false,
    "must not promise an npm script that was never added"
  );
  assert.equal(fs.existsSync(path.join(target, "package.json")), false);
  assert.ok(fs.existsSync(path.join(target, "snapshot.config.mjs")));
});

test("C-2: the dependency is recorded at the shim's own version", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  const target = path.join(harness.dir, "esm");
  writeProject(target, { type: "module" });

  const run = runShim(harness.shim, target);

  assert.equal(run.code, 0, run.stderr);
  const pkg = JSON.parse(fs.readFileSync(path.join(target, "package.json"), "utf8"));
  assert.equal(pkg.devDependencies?.[DEPENDENCY], declaredRange());
  assert.match(run.stderr, /Added devDependency: codebase-snapshot/);
  // Without a local install, `npx` would download @latest: say so instead of
  // pretending the script is ready.
  assert.match(run.stderr, /Next:\s+npm install && npm run snapshot/);
  // The wizard's scripts still go through npx, which prefers the local copy.
  assert.match(pkg.scripts.snapshot, /npx codebase-snapshot generate/);
});

test("C-2: an existing dependency declaration is left untouched", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  const target = path.join(harness.dir, "already-declared");
  writeProject(target, { devDependencies: { [DEPENDENCY]: "4.0.0" } });

  const run = runShim(harness.shim, target);

  assert.equal(run.code, 0, run.stderr);
  const pkg = JSON.parse(fs.readFileSync(path.join(target, "package.json"), "utf8"));
  assert.equal(pkg.devDependencies[DEPENDENCY], "4.0.0", "never overwrite a user's pin");
  assert.equal(run.stderr.includes("Added devDependency"), false);
});

test("C-2: the rewrite keeps the file's indentation", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  // Both scripts already exist, so the only change this run makes to package.json is the
  // devDependency — the case where formatting can be checked. The write moved from the shim
  // to the wizard when `init` started declaring the dependency; the rule moved with it.
  const target = path.join(harness.dir, "four-space");
  fs.mkdirSync(path.join(target, "src"), { recursive: true });
  fs.writeFileSync(path.join(target, "src", "a.ts"), "export const a = 1;\n");
  fs.writeFileSync(
    path.join(target, "package.json"),
    `${JSON.stringify(
      {
        name: "four",
        version: "1.0.0",
        scripts: {
          snapshot: "npx codebase-snapshot generate",
          "snapshot:validate": "npx codebase-snapshot validate",
        },
      },
      null,
      4
    )}\n`
  );

  const run = runShim(harness.shim, target);

  assert.equal(run.code, 0, run.stderr);
  const raw = fs.readFileSync(path.join(target, "package.json"), "utf8");
  assert.match(raw, /^ {4}"name": "four",/m, "4-space indentation must survive the rewrite");
  assert.ok(raw.endsWith("\n"));
  assert.equal(JSON.parse(raw).devDependencies[DEPENDENCY], declaredRange());
  // A pre-existing script is runnable, so the hint must offer it.
  assert.match(run.stderr, /Next:\s+npm (?:install && npm )?run snapshot/);
});

test("C-2: scaffolding works with the network unavailable", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  const target = path.join(harness.dir, "offline");
  writeProject(target);

  const run = runShim(harness.shim, target, ["--yes"], {
    NPM_CONFIG_OFFLINE: "true",
    npm_config_offline: "true",
    // A registry that cannot answer: any fetch attempt would hang or fail.
    npm_config_registry: "http://127.0.0.1:9/",
  });

  assert.equal(run.code, 0, run.stderr);
  assert.equal(
    fs.existsSync(path.join(target, "node_modules")),
    false,
    "scaffolding must not install anything"
  );
  const pkg = JSON.parse(fs.readFileSync(path.join(target, "package.json"), "utf8"));
  assert.equal(pkg.devDependencies[DEPENDENCY], declaredRange());
});

test("C-2: with the package already installed the hint is the plain script", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  const target = path.join(harness.dir, "installed");
  writeProject(target);
  const binName = process.platform === "win32" ? "codebase-snapshot.cmd" : "codebase-snapshot";
  fs.mkdirSync(path.join(target, "node_modules", ".bin"), { recursive: true });
  fs.writeFileSync(path.join(target, "node_modules", ".bin", binName), "");

  const run = runShim(harness.shim, target);

  assert.equal(run.code, 0, run.stderr);
  assert.match(run.stderr, /Next:\s+npm run snapshot/);
});

test("C-4: the README names the config file that is actually written", (t) => {
  const harness = createHarness(t);
  if (!harness) return;

  const target = path.join(harness.dir, "config-name");
  writeProject(target, { type: "module" });

  const run = runShim(harness.shim, target);

  assert.equal(run.code, 0, run.stderr);

  const wroteTs = fs.existsSync(path.join(target, "snapshot.config.ts"));
  const wroteMjs = fs.existsSync(path.join(target, "snapshot.config.mjs"));
  assert.equal(wroteTs !== wroteMjs, true, "exactly one config file must be written");

  const written = wroteTs ? "snapshot.config.ts" : "snapshot.config.mjs";
  const readme = fs.readFileSync(path.join(SHIM_SOURCE, "README.md"), "utf8");

  assert.ok(readme.includes(written), `the README must name ${written}`);
  assert.ok(run.stderr.includes(written), "the printed config path must match it");
  // It documents both variants rather than claiming one fixed name.
  assert.match(readme, /snapshot\.config\.ts/);
  assert.match(readme, /snapshot\.config\.mjs/);
});
