<file path="tests/security-config-fixes.test.js">
/**
 * Fixes for the two redaction leaks, the Brotli misclassification and the two silent
 * config fallbacks found by the 4.2.0 audit.
 *
 * Each test reproduces the reported defect as it was, so the suite fails on the old code:
 *
 *   - a quoted credential containing an escaped quote was masked only up to the backslash,
 *     leaving the rest of the value in clear and the line syntactically broken;
 *   - an unquoted value stopped at the first `%`, so a percent-encoded token kept its tail;
 *   - `.br` was missing from the binary list, so a Brotli blob was emitted as mojibake text;
 *   - `export default null` generated with built-in defaults and exit 0;
 *   - an unknown key such as `maxPartByte` was dropped without a word.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";
import { brotliCompressSync } from "node:zlib";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeDir(t, files) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "sec-config-"));
  for (const [relative, content] of Object.entries(files)) {
    const full = path.join(dir, relative);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content);
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function run(dir, args = ["generate"]) {
  const result = spawnSync(process.execPath, [BIN, ...args], { cwd: dir, encoding: "utf8" });
  if (result.error) throw result.error;
  return {
    code: result.status ?? 1,
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
    output: `${result.stdout ?? ""}${result.stderr ?? ""}`,
  };
}

const allParts = (dir) => {
  const partsDir = path.join(dir, "snapshot", "parts");
  if (!fs.existsSync(partsDir)) return "";
  return fs
    .readdirSync(partsDir)
    .map((name) => fs.readFileSync(path.join(partsDir, name), "utf8"))
    .join("\n");
};

test("a credential with an escaped quote is masked to the value, not to the backslash", (t) => {
  const dir = makeDir(t, {
    "package.json": '{"name":"f","version":"1.0.0"}',
    "src/a.ts": 'export const a1 = JSON.parse(\'{"password": "p\\"ssw0rdINVENTED"}\');\n',
  });

  assert.equal(run(dir).code, 0);
  const parts = allParts(dir);

  assert.ok(parts.includes("[REDACTED"), "the value is masked");
  assert.equal(parts.includes("ssw0rdINVENTED"), false, "no part of the value may survive");
  // The mask must replace the WHOLE value, leaving a well-formed statement behind: the old
  // behaviour emitted `"[REDACTED…]"ssw0rdINVENTED"` and broke the line's syntax.
  assert.match(parts, /"password": "\[REDACTED[^"]*"\}/, "one quoted value, one mask");
});

test("a percent-encoded unquoted value is masked whole", (t) => {
  const dir = makeDir(t, {
    "package.json": '{"name":"f","version":"1.0.0"}',
    "src/b.ts":
      'const a2 = "https://api.example.test/cb?access_token=abc123XYZ%2Edef456INVENTED&scope=read";\n',
  });

  assert.equal(run(dir).code, 0);
  const parts = allParts(dir);

  assert.ok(parts.includes("[REDACTED"), "the token is masked");
  assert.equal(parts.includes("abc123XYZ%2Edef456INVENTED"), false, "the tail must not survive");
});

test("a Brotli file is skipped as binary, not emitted as mojibake", (t) => {
  // A real Brotli stream: `sherlock.br` in ripgrep is 186 bytes of exactly this shape.
  const compressed = brotliCompressSync(Buffer.from("hello world ".repeat(200)));
  const dir = makeDir(t, { "package.json": '{"name":"f","version":"1.0.0"}' });
  fs.mkdirSync(path.join(dir, "tests", "data"), { recursive: true });
  fs.writeFileSync(path.join(dir, "tests", "data", "sherlock.br"), compressed);

  assert.equal(run(dir).code, 0);
  const manifest = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8")
  );
  const skipped = manifest.skipped.find((entry) => entry.path === "tests/data/sherlock.br");

  assert.ok(skipped, "the .br file is recorded as skipped");
  assert.equal(skipped.reason, "binary");
  assert.equal(
    allParts(dir).includes("\uFFFD"),
    false,
    "no replacement characters may reach the parts"
  );
});

test("a Latin-1 text file is still included when only some bytes are invalid", (t) => {
  const dir = makeDir(t, { "package.json": '{"name":"f","version":"1.0.0"}' });
  // Mostly ASCII with a handful of Latin-1 bytes: the binary heuristic must not drop this.
  const latin1 = Buffer.concat([
    Buffer.from("export const name = '"),
    Buffer.from([0xe9, 0xe8, 0xea]),
    Buffer.from("caf\u00e9';\n"),
  ]);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "src", "latin1.ts"), latin1);

  assert.equal(run(dir).code, 0);
  const manifest = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8")
  );
  const entry = manifest.files.find((file) => file.relativePath === "src/latin1.ts");

  assert.ok(entry, "a mostly-ASCII Latin-1 file is still included");
  assert.equal(entry.encoding, "utf-8-lossy");
});

test("a config that exports null is a hard error, not built-in defaults", (t) => {
  const dir = makeDir(t, {
    "package.json": '{"name":"f","version":"1.0.0"}',
    "src/a.ts": "export const a = 1;\n",
    "snapshot.config.mjs": "export default null;\n",
  });

  const result = run(dir);

  assert.equal(result.code, 1, `expected a refusal, got: ${result.output}`);
  assert.match(result.output, /does not export a configuration object/);
  assert.equal(
    fs.existsSync(path.join(dir, "snapshot", "manifest.json")),
    false,
    "nothing may be written from a config that exported nothing"
  );
});

test("an unknown config key is rejected by name", (t) => {
  const dir = makeDir(t, {
    "package.json": '{"name":"f","version":"1.0.0"}',
    "src/a.ts": "export const a = 1;\n",
    "snapshot.config.json": '{"outDir":"snap","maxPartByte":4096}\n',
  });

  const result = run(dir);

  assert.equal(result.code, 1, `expected a refusal, got: ${result.output}`);
  assert.match(result.output, /maxPartByte/, "the offending key is named");
  assert.equal(fs.existsSync(path.join(dir, "snap")), false, "nothing was generated");
});
</file>

<file path="tests/security-jwt.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import {
  DEFAULT_SECRET_PATTERNS,
  explainPath,
  generateSnapshot,
  resolveConfig,
  scanAndRedactSecrets,
} from "../dist/index.js";

// Assembled at runtime so the repository never holds a literal live-token shape:
// push protection cannot tell a detection fixture from a leak, and the scanner
// sees the same bytes either way.
const JWT = {
  full: [
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
    "eyJzdWIiOiIxMjM0NTY3ODkwIn0",
    "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
  ].join("."),
  shortSignature: [
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
    "eyJzdWIiOiIxMjM0NTY3ODkwIn0",
    "abc123",
  ].join("."),
  twoSegments: ["eyJhbGciOiJIUzI1NiJ9", "eyJzdWIiOiIxMjM0NTY3ODkwIn0"].join("."),
  padded: "eyJhbGciOiJIUzI1NiJ9=.eyJzdWIiOiIxMjM0NTY3ODkwIn0=.abc123=",
  // The form a URL encoder produces when it escapes `.` — it used to walk
  // straight past the rule.
  percentSeparators: [
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
    "eyJzdWIiOiIxMjM0NTY3ODkwIn0",
    "abc123",
  ].join("%2E"),
};

const scan = (content) => scanAndRedactSecrets(content, DEFAULT_SECRET_PATTERNS, "fixture.ts");

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-jwt-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

test("every JWT shape is masked and the code around it survives", () => {
  // The variable name is deliberately not a credential name, so only the JWT rule
  // can be the reason these lines are masked.
  for (const jwt of Object.values(JWT)) {
    const line = `const v = "${jwt}";`;
    const { redacted } = scan(line);
    assert.equal(redacted.includes(jwt), false, `unmasked JWT: ${jwt.slice(0, 24)}`);
    assert.match(redacted, /^const v = "\[REDACTED: /, "the assignment must survive");
    assert.match(redacted, /";$/, "the closing quote and semicolon must survive");
  }
});

test("the JWT is attributed to the jwt-token rule", () => {
  const { findings } = scan(JWT.shortSignature);
  assert.ok(
    findings.some((finding) => finding.rules.includes("jwt-token")),
    `expected a jwt-token finding, got ${JSON.stringify(findings)}`
  );
});

test("a JWT inside a URL or an Authorization header is masked, the context survives", () => {
  const url = `const url = "https://api.example.com/v1?access_token=${JWT.shortSignature}&expires=3600";`;
  const redactedUrl = scan(url).redacted;
  assert.equal(redactedUrl.includes(JWT.shortSignature), false);
  assert.ok(redactedUrl.includes("https://api.example.com/v1?access_token="));
  assert.ok(redactedUrl.includes("&expires=3600"));

  const header = `const h = "Authorization: Bearer ${JWT.shortSignature}";`;
  const redactedHeader = scan(header).redacted;
  assert.equal(redactedHeader.includes(JWT.shortSignature), false);
  assert.ok(redactedHeader.includes('const h = "Authorization: Bearer '));
});

test("percent-encoded separators do not shake the rule off", () => {
  // A URL encoder that escapes `.` turns `a.b.c` into `a%2Eb%2Ec`; the token is
  // the same credential and must still be masked, with the query string intact.
  const encoded = JWT.percentSeparators;
  assert.equal(encoded.includes("."), false, "the fixture must really be percent-encoded");
  const url = `const url = "https://api.example.com/v1?access_token=${encoded}&expires=3600";`;
  const { redacted, findings } = scan(url);
  assert.equal(redacted.includes(encoded), false, "the percent-encoded JWT must not survive");
  assert.ok(redacted.includes("https://api.example.com/v1?access_token="));
  assert.ok(redacted.includes("&expires=3600"));
  assert.ok(findings.some((finding) => finding.rules.includes("jwt-token")));
});

test("source that merely looks like a JWT is left alone", () => {
  const untouched = [
    'const header = "eyJhbGciOiJIUzI1NiJ9";',
    'const short = "eyJhbGciOi";',
    'const prose = "The eyJhbGciOiJIUzI1NiJ9 header appears alone in this sentence.";',
    'const image = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJ=";',
    'const commit = "da39a3ee5e6b4b0d3255bfef95601890afd80709";',
    'const half = "eyJhbGciOiJIUzI1NiJ9.eyJzdWIi";',
  ];
  for (const line of untouched) {
    assert.equal(scan(line).redacted, line, `over-redacted: ${line}`);
  }
});

test("a JWT never reaches the part, the manifest or the audit", (t) => {
  const dir = tempDir(t);
  write(dir, "src/creds.ts", `export const g = "${JWT.shortSignature}";\n`);
  write(dir, "README.md", "# fixture\n");
  const manifest = generateSnapshot({ cwd: dir });
  const artifacts = {
    part: fs.readFileSync(path.join(dir, "snapshot", "parts", manifest.parts[0].filename), "utf8"),
    manifest: fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"),
    audit: fs.readFileSync(path.join(dir, "snapshot", "reports", "audit.md"), "utf8"),
  };
  for (const [label, text] of Object.entries(artifacts)) {
    assert.equal(text.includes(JWT.shortSignature), false, `${label} contains the JWT`);
    for (let i = 0; i + 8 <= JWT.shortSignature.length; i += 8) {
      const fragment = JWT.shortSignature.slice(i, i + 8);
      assert.equal(text.includes(fragment), false, `${label} contains the fragment ${fragment}`);
    }
  }
  assert.ok(artifacts.part.includes("[REDACTED"), "the part must carry the redaction marker");
});

test("explain reports the JWT finding without printing the token", (t) => {
  const dir = tempDir(t);
  write(dir, "src/creds.ts", `export const g = "${JWT.shortSignature}";\n`);
  const explained = explainPath(resolveConfig({ cwd: dir }), "src/creds.ts");
  assert.ok(explained.secretCount > 0, "explain must see a secret");
  assert.ok(
    explained.secrets.some((secret) => secret.rules.includes("jwt-token")),
    `expected a jwt-token finding, got ${JSON.stringify(explained.secrets)}`
  );
  assert.equal(JSON.stringify(explained).includes(JWT.shortSignature), false);
});

test("the JWT rule is not stateful", () => {
  const rule = DEFAULT_SECRET_PATTERNS.find((entry) => entry.rule === "jwt-token");
  assert.ok(rule, "the jwt-token rule must exist");
  assert.equal(/[gy]/.test(rule.pattern.flags), false, "the jwt-token rule must not be stateful");

  const line = `a = "${JWT.shortSignature}"; b = "${JWT.shortSignature}";`;
  const first = scan(line).redacted;
  assert.equal(scan(line).redacted, first, "a second scan must produce the same bytes");
  assert.equal(first.split("[REDACTED").length - 1, 2, "both occurrences on a line are masked");
});

test("the JWT rule is not quadratic on an eyJ-dense line", () => {
  const line = "eyJ".repeat(20_000);
  const started = performance.now();
  scan(line);
  const elapsed = performance.now() - started;
  assert.ok(elapsed < 2000, `JWT scan took ${elapsed.toFixed(0)}ms on a 60KB eyJ-dense line`);
});
</file>

<file path="tests/site-link-rewriting.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import { createLinkRewriter } from "../scripts/build-site.mjs";

/**
 * README.md deliberately writes absolute GitHub URLs so the same text works on
 * npmjs.com. The site builder only rewrote *relative* `docs/*.md` links, so a
 * visitor on the docs site who clicked a guide link on the homepage was handed
 * back to GitHub — the site existed but its own navigation pointed away from it.
 *
 * The rewrite is deliberately narrow: a link to a file the site does not publish
 * must keep working, and another repository's URLs are none of our business.
 */

const rewrite = createLinkRewriter({
  repositoryUrl: "https://github.com/ankurhalder/codebase-snapshot.git",
  publishedSlugs: ["index", "cli", "mcp", "agent"],
});

const href = (url, anchor = "") => `<a href="${url}${anchor}">guide</a>`;

test("an absolute in-repo docs link becomes the local page", () => {
  assert.equal(
    rewrite(href("https://github.com/ankurhalder/codebase-snapshot/blob/main/docs/cli.md")),
    href("cli.html")
  );
});

test("a fragment on an absolute link is preserved", () => {
  assert.equal(
    rewrite(href("https://github.com/ankurhalder/codebase-snapshot/blob/main/docs/mcp.md", "#tools")),
    href("mcp.html", "#tools")
  );
});

test("the README becomes the site index", () => {
  for (const prefix of ["blob", "tree"]) {
    assert.equal(
      rewrite(href(`https://github.com/ankurhalder/codebase-snapshot/${prefix}/main/README.md`)),
      href("index.html"),
      prefix
    );
  }
});

test("raw.githubusercontent links are rewritten too", () => {
  assert.equal(
    rewrite(href("https://raw.githubusercontent.com/ankurhalder/codebase-snapshot/main/docs/agent.md")),
    href("agent.html")
  );
});

test("a published file referenced by src is rewritten as well", () => {
  assert.equal(
    rewrite('<img src="https://github.com/ankurhalder/codebase-snapshot/blob/main/README.md">'),
    '<img src="index.html">'
  );
});

test("a file the site does not publish keeps its working link", () => {
  const url = "https://github.com/ankurhalder/codebase-snapshot/blob/main/CHANGELOG.md";
  assert.equal(rewrite(href(url)), href(url));
});

test("another repository is left alone", () => {
  const url = "https://github.com/someone-else/codebase-snapshot/blob/main/docs/cli.md";
  assert.equal(rewrite(href(url)), href(url));
});

test("a docs file with no page is left alone", () => {
  const url = "https://github.com/ankurhalder/codebase-snapshot/blob/main/docs/not-a-page.md";
  assert.equal(rewrite(href(url)), href(url));
});

test("a bare URL in prose is not rewritten", () => {
  const text = "see https://github.com/ankurhalder/codebase-snapshot/blob/main/docs/cli.md for details";
  assert.equal(rewrite(text), text);
});

test("the owner and repository come from package.json, not from a constant", () => {
  const other = createLinkRewriter({
    repositoryUrl: "https://github.com/fork-owner/forked-snapshot",
    publishedSlugs: ["index"],
  });
  assert.equal(
    other(href("https://github.com/fork-owner/forked-snapshot/blob/main/README.md")),
    href("index.html"),
    "a fork rewrites its own links"
  );
  assert.equal(
    other(href("https://github.com/ankurhalder/codebase-snapshot/blob/main/README.md")),
    href("https://github.com/ankurhalder/codebase-snapshot/blob/main/README.md"),
    "and not the upstream's"
  );
});
</file>

<file path="tests/skeleton.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, resolveConfig, skeletonizeTypeScript } from "../dist/index.js";

/**
 * Signature compression, from the 0.9.9 audit.
 *
 * `docs/vs-repomix.md` concedes that a tree-sitter compression mode beats byte budgeting for a
 * repository too large to fit at all: it keeps the shape of the code and drops the
 * implementations. This is that mode, built on the compiler that is already the one runtime
 * dependency.
 *
 * The rewrite must be *span-based*. Re-printing a file with `ts.createPrinter()` would
 * normalise quotes, semicolons, blank lines and comment positions, so a skeleton of a file
 * would differ from it everywhere rather than only where bodies were removed — which makes the
 * mode useless for reading and destroys the "diff it against the source" workflow.
 */

test("bodies are replaced in place and everything around them is untouched", () => {
  const source = [
    'import { readFile } from "node:fs";',
    "",
    "/** Says hello. */",
    "export function greet(name: string): string {",
    "  const trimmed = name.trim();",
    "  return `hello ${trimmed}`;",
    "}",
    "",
    "export const LIMIT = 10;",
    "",
    "export interface Options {",
    "  verbose: boolean;",
    "}",
    "",
    "export class Store {",
    "  private items: string[] = [];",
    "",
    "  add(item: string): void {",
    "    this.items.push(item);",
    "  }",
    "}",
  ].join("\n");

  const { text, collapsed } = skeletonizeTypeScript(source, "sample.ts");

  assert.equal(collapsed, 2, "the function and the method are the two bodies");
  assert.ok(text.includes("/** Says hello. */"), "the doc comment stays");
  assert.ok(text.includes("export function greet(name: string): string { /* ... */ }"));
  assert.ok(text.includes("add(item: string): void { /* ... */ }"));
  assert.ok(text.includes("export interface Options {"), "type declarations are not bodies");
  assert.ok(!text.includes("const trimmed = name.trim();"), "the implementation is gone");
  assert.ok(!text.includes("this.items.push(item);"));
  assert.ok(text.length < source.length, "the point is that it is smaller");
  // Formatting outside the collapsed bodies is byte-identical.
  assert.ok(text.includes('import { readFile } from "node:fs";'));
  assert.ok(text.includes("  private items: string[] = [];"));
});

test("a file with no bodies is returned unchanged", () => {
  const source = "export type A = string;\nexport const B = 1;\n";
  const { text, collapsed } = skeletonizeTypeScript(source, "types.ts");
  assert.equal(collapsed, 0);
  assert.equal(text, source, "nothing to do means no edit at all");
});

test("nested arrows inside a function collapse with their parent, not twice", () => {
  const source = [
    "export function outer(): number[] {",
    "  const inner = (n: number) => {",
    "    return n * 2;",
    "  };",
    "  return [1, 2, 3].map(inner);",
    "}",
  ].join("\n");

  const { text, collapsed } = skeletonizeTypeScript(source, "nested.ts");

  assert.equal(collapsed, 1, "one outermost body, replaced once");
  assert.equal(text, "export function outer(): number[] { /* ... */ }");
});

test("a .tsx file keeps its JSX outside the collapsed bodies", () => {
  const source = [
    "export function Page() {",
    "  return <main>hello</main>;",
    "}",
  ].join("\n");
  const { text, collapsed } = skeletonizeTypeScript(source, "Page.tsx");
  assert.equal(collapsed, 1);
  assert.equal(text, "export function Page() { /* ... */ }");
});

test("generate --skeleton emits signatures and says so per file", (t) => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "skeleton-"));
  const write = (relative, content) => {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content, "utf8");
  };
  write("package.json", '{"name":"fixture","version":"1.0.0"}\n');
  write(
    "src/math.ts",
    [
      "export function add(a: number, b: number): number {",
      "  const total = a + b;",
      "  return total;",
      "}",
      "export const VERSION = 1;",
    ].join("\n")
  );
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  const config = resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", skeleton: true });
  const manifest = generateSnapshot(config);

  const entry = manifest.files.find((file) => file.relativePath === "src/math.ts");
  assert.equal(entry.inclusionMode, "signatures", "the mode is recorded per file");
  assert.ok(entry.includedBytes < entry.sizeBytes, "and the file really is smaller");

  const part = fs.readFileSync(
    path.join(dir, "snapshot", "parts", manifest.parts[0].filename),
    "utf8"
  );
  assert.ok(part.includes("export function add(a: number, b: number): number { /* ... */ }"));
  assert.ok(!part.includes("const total = a + b;"), "the body is not in the snapshot");
  // The summary still describes the real file.
  assert.deepEqual(entry.summary.exports, ["VERSION", "add"]);
  assert.equal(manifest.config.skeleton, true);
});

test("without the flag the same file is emitted whole", (t) => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "skeleton-off-"));
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(
    path.join(dir, "src", "math.ts"),
    "export function add(a: number, b: number): number {\n  return a + b;\n}\n"
  );
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  const manifest = generateSnapshot(
    resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" })
  );
  const entry = manifest.files.find((file) => file.relativePath === "src/math.ts");
  assert.equal(entry.inclusionMode, "full");
  assert.equal(manifest.config.skeleton, undefined);
});
</file>

<file path="tests/skill-install-confinement.test.js">
/**
 * `skill --install`: confinement, ownership, and what it refuses to touch.
 *
 * This is the one command that writes into a repository it did not create, so it is the
 * one command where a path has to be proved to be inside the repository before anything is
 * written. The audit that produced these tests found two escape routes:
 *
 *   - `.claude` (or `.claude/skills/<name>`) as a junction/symlink to a directory outside
 *     the repository: the whole `SKILL.md` was created outside;
 *   - a hard link at a target file: writing it rewrote the file outside the repository.
 *
 * The installer refuses both before the first write.
 *
 * 4.1.1 removed the third target. It used to merge a marked section into `AGENTS.md`, which
 * is the *project's* agent contract, not a skill registry — so these tests now assert that
 * `AGENTS.md` is never created, never edited, and never ignored, and that a section left
 * behind by 4.1.0 is reported rather than rewritten.
 *
 * The tests drive the real CLI (`node dist/bin.js`), so they see the same resolution and the
 * same error text a user sees.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const BIN = path.join(REPO, "dist", "bin.js");
const LEGACY_MARKER = "<!-- codebase-snapshot:skill:start -->";
const CLAUDE_SKILL = path.join(".claude", "skills", "codebase-snapshot", "SKILL.md");
const CURSOR_RULE = path.join(".cursor", "rules", "codebase-snapshot.mdc");

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "skill-install-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

/** Runs the real CLI; the install report goes to stderr, so both streams are kept. */
function runInstall(cwd, target = "all") {
  const run = spawnSync("node", [BIN, "skill", "--install", "--cwd", cwd, "--target", target], {
    encoding: "utf8",
  });
  if (run.error) throw run.error;
  return { status: run.status ?? 1, output: `${run.stdout ?? ""}${run.stderr ?? ""}` };
}

const read = (file) => fs.readFileSync(file, "utf8");

function makeRepo(t, name) {
  const root = tempDir(t);
  const repo = path.join(root, name);
  fs.mkdirSync(repo, { recursive: true });
  return { root, repo, outside: path.join(root, "outside") };
}

/** Creates a directory link, or skips the test where the host forbids it. */
function linkDirectory(t, target, linkPath) {
  try {
    fs.symlinkSync(target, linkPath, "junction");
    return true;
  } catch {
    t.skip("this host cannot create directory links");
    return false;
  }
}

test("a junction on .claude cannot be used to write outside the repository", (t) => {
  const { repo, outside } = makeRepo(t, "repo");
  fs.mkdirSync(outside);
  if (!linkDirectory(t, outside, path.join(repo, ".claude"))) return;

  const result = runInstall(repo, "claude");

  assert.equal(result.status, 1, `expected a refusal, got: ${result.output}`);
  assert.match(result.output, /Refusing to install the agent skill/);
  assert.match(result.output, /\.claude/);
  assert.deepEqual(fs.readdirSync(outside), [], "nothing may be created outside the repository");
});

test("a junction at the skill directory itself is refused", (t) => {
  const { repo, outside } = makeRepo(t, "repo");
  fs.mkdirSync(outside);
  fs.mkdirSync(path.join(repo, ".claude", "skills"), { recursive: true });
  if (!linkDirectory(t, outside, path.join(repo, ".claude", "skills", "codebase-snapshot"))) return;

  const result = runInstall(repo, "claude");

  assert.equal(result.status, 1);
  assert.match(result.output, /resolves outside the repository/);
  assert.deepEqual(fs.readdirSync(outside), []);
});

test("a hard-linked target file is refused and the outside file is untouched", (t) => {
  const { repo, outside } = makeRepo(t, "repo");
  fs.mkdirSync(outside);
  const outsideFile = path.join(outside, "SKILL.md");
  fs.writeFileSync(outsideFile, "# outside file\n\nNothing to do with the repository.\n");
  fs.mkdirSync(path.join(repo, ".claude", "skills", "codebase-snapshot"), { recursive: true });
  try {
    fs.linkSync(outsideFile, path.join(repo, CLAUDE_SKILL));
  } catch {
    t.skip("this host cannot create hard links");
    return;
  }
  const before = fs.readFileSync(outsideFile);

  const result = runInstall(repo, "claude");

  assert.equal(result.status, 1, `expected a refusal, got: ${result.output}`);
  assert.match(result.output, /hard links/);
  assert.deepEqual(fs.readFileSync(outsideFile), before, "the outside file must not change");
});

test("a refusal happens before any write, even with --target all", (t) => {
  const { repo, outside } = makeRepo(t, "repo");
  fs.mkdirSync(outside);
  if (!linkDirectory(t, outside, path.join(repo, ".cursor"))) return;

  const result = runInstall(repo, "all");

  assert.equal(result.status, 1);
  assert.equal(
    fs.existsSync(path.join(repo, CLAUDE_SKILL)),
    false,
    "the other target must not be written when one is refused"
  );
  assert.deepEqual(fs.readdirSync(outside), []);
});

test("a symlink at a target file itself is refused", (t) => {
  const { repo, outside } = makeRepo(t, "repo");
  fs.mkdirSync(outside);
  const outsideFile = path.join(outside, "rule.mdc");
  fs.writeFileSync(outsideFile, "# outside\n");
  fs.mkdirSync(path.join(repo, ".cursor", "rules"), { recursive: true });
  try {
    fs.symlinkSync(outsideFile, path.join(repo, CURSOR_RULE), "file");
  } catch {
    t.skip("creating a file symlink needs elevation on this host; the junction test covers the same path");
    return;
  }

  const result = runInstall(repo, "cursor");

  assert.equal(result.status, 1);
  assert.match(result.output, /symbolic link|junction/);
  assert.equal(read(outsideFile), "# outside\n");
});

test("--target all writes both registries and nothing else", (t) => {
  const { repo } = makeRepo(t, "repo");

  const result = runInstall(repo, "all");

  assert.equal(result.status, 0, result.output);
  assert.equal(fs.existsSync(path.join(repo, CLAUDE_SKILL)), true);
  assert.equal(fs.existsSync(path.join(repo, CURSOR_RULE)), true);
  assert.deepEqual(
    fs.readdirSync(repo).sort(),
    [".claude", ".cursor", ".gitignore"],
    "a fresh install must create the two registries and the ignore file, nothing else"
  );
});

test("a second install changes nothing", (t) => {
  const { repo } = makeRepo(t, "repo");
  assert.equal(runInstall(repo, "claude").status, 0);
  const first = read(path.join(repo, CLAUDE_SKILL));
  const ignore = read(path.join(repo, ".gitignore"));

  const second = runInstall(repo, "claude");

  assert.equal(second.status, 0, second.output);
  assert.equal(read(path.join(repo, CLAUDE_SKILL)), first);
  assert.equal(read(path.join(repo, ".gitignore")), ignore, "no duplicate ignore entries");
  assert.match(second.output, /unchanged/);
});

test("what it creates is added to .gitignore, and existing entries survive", (t) => {
  const { repo } = makeRepo(t, "repo");
  fs.writeFileSync(path.join(repo, ".gitignore"), "node_modules/\n");

  assert.equal(runInstall(repo, "all").status, 0);

  const ignore = read(path.join(repo, ".gitignore"));
  assert.match(ignore, /node_modules\//, "the existing entry survives");
  assert.ok(ignore.includes(".claude/skills/codebase-snapshot/SKILL.md"), "skill file is ignored");
  assert.ok(ignore.includes(".cursor/rules/codebase-snapshot.mdc"), "rule file is ignored");
  assert.doesNotMatch(ignore, /AGENTS\.md/, "AGENTS.md is never ignored");
});

test("AGENTS.md is never created and never edited", (t) => {
  const { repo } = makeRepo(t, "repo");
  const house = "# House rules\n\nUse tabs.\n";
  fs.writeFileSync(path.join(repo, "AGENTS.md"), house);

  const result = runInstall(repo, "all");

  assert.equal(result.status, 0, result.output);
  assert.equal(read(path.join(repo, "AGENTS.md")), house, "the project's agent file is untouched");
  assert.doesNotMatch(read(path.join(repo, ".gitignore")), /AGENTS\.md/);
});

test("a section left by 4.1.0 is reported, never rewritten", (t) => {
  const { repo } = makeRepo(t, "repo");
  const legacy = ["# AGENTS.md", "", LEGACY_MARKER, "", "old body", "", "<!-- codebase-snapshot:skill:end -->", ""].join("\n");
  fs.writeFileSync(path.join(repo, "AGENTS.md"), legacy);

  const result = runInstall(repo, "claude");

  assert.equal(result.status, 0, result.output);
  assert.match(result.output, /AGENTS\.md still contains the section/);
  assert.equal(read(path.join(repo, "AGENTS.md")), legacy, "the block must not be touched");
});

test("--target isolation holds, and the removed `agents` target is a usage error", (t) => {
  const root = tempDir(t);
  const expectations = {
    claude: [CLAUDE_SKILL, CURSOR_RULE],
    cursor: [CURSOR_RULE, CLAUDE_SKILL],
  };
  for (const [target, [own, absent]] of Object.entries(expectations)) {
    const repo = path.join(root, target);
    fs.mkdirSync(repo, { recursive: true });
    const result = runInstall(repo, target);
    assert.equal(result.status, 0, `${target}: ${result.output}`);
    assert.equal(fs.existsSync(path.join(repo, own)), true, `${target} must write ${own}`);
    assert.equal(fs.existsSync(path.join(repo, absent)), false, `${target} must not write ${absent}`);
  }

  const repo = path.join(root, "removed");
  fs.mkdirSync(repo, { recursive: true });
  const removed = runInstall(repo, "agents");
  assert.equal(removed.status, 2, "`agents` was removed, so it must be rejected as a usage error");
  assert.match(removed.output, /target|claude|cursor/i);
});
</file>

<file path="tests/snapshot-incomplete.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, validateSnapshot } from "../dist/index.js";

/**
 * 4.0.9 regression cover for two "the state is wrong" diagnoses.
 *
 * S8 — when a run died, the output directory held this tool's marker and no manifest, and
 * `validate`/`report` answered "run generate first" for ever. That answer can never resolve:
 * generation had already run. The marker records the state, the run id and the start time, so the
 * message names them and says what to do.
 *
 * discovery drift — how files were discovered decides which files a snapshot contains, so a
 * changed mode is configuration drift like any other, and manifests written before the key existed
 * are not "different".
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "snap-incomplete-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content, "utf8");
  return target;
}

const readManifest = (dir) =>
  JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));

const writeManifest = (dir, manifest) =>
  fs.writeFileSync(
    path.join(dir, "snapshot", "manifest.json"),
    `${JSON.stringify(manifest, null, 2)}\n`,
    "utf8"
  );

test("S8: a marker left in state staging is reported as an unfinished run", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");

  // Exactly what a run killed mid-write leaves behind: the marker, no manifest.
  write(
    dir,
    "snapshot/.codebase-snapshot",
    JSON.stringify({
      generator: "codebase-snapshot",
      version: "4.0.9",
      schemaVersion: "3.0.0",
      createdAt: "2026-01-01T00:00:00.000Z",
      state: "staging",
      id: "run-abc123",
      entries: [],
    })
  );

  const result = validateSnapshot({ cwd: dir });

  assert.equal(result.valid, false);
  assert.equal(result.manifestPresent, false);
  const message = result.errors.join("\n");
  assert.match(message, /did not finish/);
  assert.match(message, /staging/);
  assert.match(message, /run-abc123/, "the run id is named");
  assert.match(message, /2026-01-01T00:00:00.000Z/, "the start time is named");
  assert.doesNotMatch(message, /Run generate first/, "the dead-end wording is gone");
});

test("S8: a marker with no manifest is reported as incomplete, not missing", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generateSnapshot({ cwd: dir });

  // Simulate a manifest lost after the fact.
  fs.rmSync(path.join(dir, "snapshot", "manifest.json"));

  const result = validateSnapshot({ cwd: dir });
  const message = result.errors.join("\n");

  assert.equal(result.valid, false);
  assert.match(message, /incomplete/);
  assert.match(message, /Run generate again/);
});

test("S8: with no output directory at all the original message is kept", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");

  const result = validateSnapshot({ cwd: dir });
  const message = result.errors.join("\n");

  assert.match(message, /Snapshot manifest not found at/);
  assert.match(message, /Run generate first/);
});

test("S8: the documented recovery — remove the directory, regenerate, validate", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  write(
    dir,
    "snapshot/.codebase-snapshot",
    JSON.stringify({ state: "staging", id: "run-dead", createdAt: "2026-01-01T00:00:00.000Z" })
  );

  const broken = validateSnapshot({ cwd: dir });
  assert.equal(broken.valid, false);
  assert.match(broken.errors.join("\n"), /did not finish/);

  // The tool does not silently adopt a marker it cannot verify, so the documented recovery is to
  // remove the directory — the state is unrecoverable in place, and pretending otherwise would
  // mean deleting files on the strength of a marker alone.
  fs.rmSync(path.join(dir, "snapshot"), { recursive: true, force: true });
  generateSnapshot({ cwd: dir });

  assert.equal(validateSnapshot({ cwd: dir }).valid, true, "a clean regeneration repairs the state");
});

test("discovery drift: a changed mode is reported, an equal one is not", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generateSnapshot({ cwd: dir, discovery: "walk" });

  const same = validateSnapshot({ cwd: dir, discovery: "walk" });
  assert.deepEqual(same.drift.configMismatches, [], "no drift when the mode is unchanged");

  const changed = validateSnapshot({ cwd: dir, discovery: "auto" });
  const mismatch = changed.drift.configMismatches.find((entry) => entry.startsWith("discovery:"));
  assert.ok(mismatch, `discovery drift is reported: ${JSON.stringify(changed.drift.configMismatches)}`);
  assert.match(mismatch, /manifest walk vs current auto/);
});

test("discovery drift: a manifest with no recorded mode is not drift", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generateSnapshot({ cwd: dir });

  const manifest = readManifest(dir);
  delete manifest.config.discovery;
  writeManifest(dir, manifest);

  const result = validateSnapshot({ cwd: dir });

  assert.deepEqual(
    result.drift.configMismatches.filter((entry) => entry.startsWith("discovery:")),
    [],
    "an older manifest is not accused of drift it cannot record"
  );
});

test("the manifest records the effective discovery mode", (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  generateSnapshot({ cwd: dir, discovery: "walk" });

  assert.equal(readManifest(dir).config.discovery, "walk");
});
</file>

<file path="tests/structured-summary.test.js">
import assert from "node:assert/strict";
import test from "node:test";

import { summarizeMarkdown, summarizeWithProfile } from "../dist/index.js";

/**
 * Structural summaries, from the 0.9.9 audit.
 *
 * Both defects made `manifest.files[].summary` describe something other than the file.
 * The summary is what an agent reads instead of the file, so a wrong one is worse than
 * a missing one: it is confident, terse and searchable.
 */

test("a comment inside a fenced code block is not a document heading", () => {
  const markdown = [
    "# Real heading",
    "",
    "```bash",
    "# a shell comment, not a heading",
    "npm install",
    "```",
    "",
    "## Another real heading",
    "",
    "~~~python",
    "# a python comment",
    "~~~",
    "",
    "### Third heading",
  ].join("\n");

  assert.deepEqual(summarizeMarkdown(markdown).headings, [
    "# Real heading",
    "## Another real heading",
    "### Third heading",
  ]);
});

test("an unterminated fence does not swallow the rest of the document", () => {
  // A fence that was never closed is a real shape in a truncated file. Everything after
  // it is inside the block, so no later `#` is a heading — which is what a renderer does.
  const markdown = ["# Title", "```", "# inside the block", "still inside"].join("\n");
  assert.deepEqual(summarizeMarkdown(markdown).headings, ["# Title"]);
});

test("frontmatter keys are still read and fences inside frontmatter do not confuse it", () => {
  const markdown = ["---", "title: Test", "tags: [a]", "---", "# Body"].join("\n");
  const summary = summarizeMarkdown(markdown);
  assert.deepEqual(summary.frontmatterKeys, ["tags", "title"]);
  assert.deepEqual(summary.headings, ["# Body"]);
});

test("a single-file component is listed once, not once per sighting", () => {
  // `<script setup>` exports the component's own name, and the profile then adds the
  // component name again — the second push bypassed the sort-and-dedupe pass.
  const source = [
    "<template><button>hi</button></template>",
    '<script setup lang="ts">',
    "export const Button = 1;",
    "export function helper(): number { return 1; }",
    "</script>",
  ].join("\n");

  const { summary, quality } = summarizeWithProfile("components/Button.vue", source);

  assert.equal(quality, "ast");
  assert.equal(
    summary.exports.filter((name) => name === "Button").length,
    1,
    `exports must be a set: ${JSON.stringify(summary.exports)}`
  );
  assert.deepEqual(summary.reactComponents, ["Button"], "the component is listed once");
  assert.deepEqual(
    summary.exports,
    [...summary.exports].sort(),
    "and the list stays sorted after the component is added"
  );
});
</file>

<file path="tests/terminal-output.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const BIN = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "dist", "bin.js");
const ESC = "\u001b";
const CSI = `${ESC}[2J${ESC}[31m`;
const OSC = `${ESC}]0;PWNED TITLE\u0007`;
const C1 = "\u009b31m";
const RLO = "\u202e";
const RLO_BYTES = Buffer.from(RLO, "utf8");

function write(file, content) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, content);
}

function makeRepo(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cs-terminal-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  write(path.join(dir, "package.json"), '{"name":"terminal","version":"1.0.0"}\n');
  write(path.join(dir, "src", "a.ts"), "export const a = 1;\n");
  write(path.join(dir, "src", "café.ts"), "export const café = 1;\n");
  const generated = run(["generate", "--no-config", "--cwd", dir]);
  assert.equal(generated.status, 0, generated.stderr.toString("utf8"));
  return dir;
}

function run(args, cwd) {
  const result = spawnSync(process.execPath, [BIN, ...args], {
    cwd,
    encoding: null,
    timeout: 20_000,
  });
  assert.equal(result.error, undefined);
  return {
    status: result.status,
    stdout: result.stdout ?? Buffer.alloc(0),
    stderr: result.stderr ?? Buffer.alloc(0),
  };
}

function combined(result) {
  return Buffer.concat([result.stdout, result.stderr]);
}

function assertNoRawControls(buffer, label) {
  assert.equal(buffer.includes(0x1b), false, `${label}: raw ESC byte`);
  assert.equal(buffer.includes(0x9b), false, `${label}: raw C1 byte`);
  assert.equal(buffer.includes(0x07), false, `${label}: raw BEL byte`);
  assert.equal(buffer.includes(Buffer.from(RLO, "utf8")), false, `${label}: raw RLO bytes`);
}

function assertShows(buffer, fragment, label) {
  assert.ok(
    buffer.toString("utf8").includes(fragment),
    `${label}: expected visible escape ${JSON.stringify(fragment)}`
  );
}

function manifestFile(dir) {
  return path.join(dir, "snapshot", "manifest.json");
}

function readManifest(dir) {
  return JSON.parse(fs.readFileSync(manifestFile(dir), "utf8"));
}

function updateManifest(dir, mutate) {
  const manifest = readManifest(dir);
  mutate(manifest);
  write(manifestFile(dir), `${JSON.stringify(manifest, null, 2)}\n`);
}

test("validate text escapes manifest part names and file paths", (t) => {
  const dir = makeRepo(t);
  updateManifest(dir, (manifest) => {
    manifest.parts[0].filename = `${OSC}.md`;
    const file = manifest.files.find((entry) => entry.relativePath === "src/a.ts");
    assert.ok(file);
    file.relativePath = `src/${CSI}PWNED-FILE${ESC}[0m.ts`;
  });

  const result = run(["validate", "--cwd", dir]);
  assert.equal(result.status, 1);
  assertNoRawControls(combined(result), "validate");
  assertShows(combined(result), "\\u001B]0;PWNED TITLE\\u0007", "validate OSC part");
  assertShows(combined(result), "\\u001B[2J", "validate CSI file");
});

test("report text escapes layer names", (t) => {
  const dir = makeRepo(t);
  updateManifest(dir, (manifest) => {
    manifest.layers = { [`${C1}${RLO}PWNED-LAYER`]: 1, src: 1 };
  });

  const result = run(["report", "--cwd", dir]);
  assert.equal(result.status, 0);
  assertNoRawControls(combined(result), "report");
  assertShows(combined(result), "\\u009B31m", "report C1 layer");
  assertShows(combined(result), "\\u202E", "report bidi layer");
});

test("explain text escapes a manifest part name", (t) => {
  const dir = makeRepo(t);
  updateManifest(dir, (manifest) => {
    const file = manifest.files.find((entry) => entry.relativePath === "src/a.ts");
    assert.ok(file);
    file.part = `${CSI}PWNED-EXPLAIN.md`;
  });

  const result = run(["explain", "--cwd", dir, "src/a.ts"]);
  assert.equal(result.status, 0);
  assertNoRawControls(combined(result), "explain");
  assertShows(combined(result), "\\u001B[2J", "explain CSI part");
});

test("diff text escapes manifest file paths", (t) => {
  const dir = makeRepo(t);
  const before = path.join(dir, "before");
  fs.cpSync(path.join(dir, "snapshot"), before, { recursive: true });
  updateManifest(dir, (manifest) => {
    const file = manifest.files.find((entry) => entry.relativePath === "src/a.ts");
    assert.ok(file);
    file.relativePath = `src/${CSI}PWNED-DIFF${ESC}[0m.ts`;
  });

  const result = run(["diff", path.join(before, "manifest.json"), manifestFile(dir)]);
  assert.equal(result.status, 0);
  assertNoRawControls(combined(result), "diff");
  assertShows(combined(result), "\\u001B[2J", "diff CSI path");
});

test("--format json keeps control characters only as JSON escapes", (t) => {
  const dir = makeRepo(t);
  updateManifest(dir, (manifest) => {
    manifest.parts[0].filename = `${CSI}PWNED-JSON${ESC}[0m.md`;
  });

  const result = run(["validate", "--format", "json", "--cwd", dir]);
  assert.equal(result.status, 1);
  assertNoRawControls(result.stdout, "validate json stdout");
  assertNoRawControls(result.stderr, "validate json stderr");
  const text = result.stdout.toString("utf8");
  assert.match(text, /\\u001[bB]\[2J/);
  const parsed = JSON.parse(text);
  const parts = parsed.drift.partIssues.map((issue) => issue.part);
  assert.ok(parts.some((part) => part.includes(ESC)), "parsed JSON keeps the control code point");
});

test("ordinary Unicode output is unchanged", (t) => {
  const dir = makeRepo(t);
  const result = run(["explain", "--cwd", dir, "src/café.ts"]);
  assert.equal(result.status, 0);
  assertNoRawControls(combined(result), "explain café");
  assert.ok(combined(result).toString("utf8").includes("src/café.ts"));
  assert.ok(combined(result).toString("utf8").includes("café"), "café is not escaped");
});
</file>

<file path="tests/token-estimate.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { bytesForTokens, estimateTokens, generateSnapshot, resolveConfig } from "../dist/index.js";

/**
 * Token estimates, from the 0.9.9 audit.
 *
 * Every budget in the tool is in bytes and every reason to read a snapshot is in tokens. The
 * estimate has to be deterministic (it is recorded in a manifest and compared between runs),
 * it has to be in the right order of magnitude, and the `--max-part-tokens` ceiling has to be
 * a real ceiling rather than a second, ignored number.
 */

function tempDir(t) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "token-estimate-"));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

test("the estimate is deterministic and proportional", () => {
  const source = [
    "export function add(a: number, b: number): number {",
    "  return a + b;",
    "}",
    "",
    "const label = \"a string with spaces and punctuation!\";",
  ].join("\n");

  assert.equal(estimateTokens(""), 0);
  assert.equal(estimateTokens(source), estimateTokens(source), "same input, same number");
  assert.ok(estimateTokens(source) > 10, "a five-line program is more than ten tokens");

  // Twice the text is roughly twice the tokens — not exactly, because a repeated line
  // re-counts its own structure, but the estimate must not be off by an order of magnitude.
  const doubled = `${source}\n${source}`;
  const ratio = estimateTokens(doubled) / estimateTokens(source);
  assert.ok(ratio > 1.8 && ratio < 2.2, `doubling the text doubled the estimate (got ${ratio})`);
});

test("the estimate stays close to the bytes-per-token rule the docs publish", () => {
  // `docs/codebase-token-budget.md` tells readers to divide bytes by about 3.5. The estimate
  // is allowed to differ by the calibration stated in `tokenize.ts`; it must not be a
  // different answer to the same question.
  const source = `${"export const value = compute(input, other);\n".repeat(400)}`;
  const bytes = Buffer.byteLength(source, "utf8");
  const fromBytes = bytes / 3.5;
  const approximate = estimateTokens(source);
  const drift = Math.abs(approximate - fromBytes) / fromBytes;
  assert.ok(drift < 0.35, `estimate ${approximate} vs bytes/3.5 ${fromBytes.toFixed(0)}`);
});

test("a part records its tokens, and the header states them", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(
    path.join(dir, "src", "a.ts"),
    `${"export function fn(): number { return 1; }\n".repeat(200)}`
  );

  const config = resolveConfig({ cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp" });
  const manifest = generateSnapshot(config);

  assert.ok(manifest.parts.length > 0);
  for (const part of manifest.parts) {
    assert.ok(part.estimatedTokens > 0, `${part.filename} carries an estimate`);
    const text = fs.readFileSync(path.join(dir, "snapshot", "parts", part.filename), "utf8");
    const header = /- Estimated Tokens: ~([\d,]+)/.exec(text);
    assert.ok(header, `${part.filename} states its estimate in the header`);
    assert.equal(
      Number(String(header[1]).replace(/,/g, "")),
      part.estimatedTokens,
      "the header and the manifest agree"
    );
  }

  const total = manifest.totals.estimatedTokens;
  assert.equal(
    total,
    manifest.parts.reduce((sum, part) => sum + part.estimatedTokens, 0),
    "the total is the sum of the parts"
  );
});

test("--max-part-tokens becomes a byte ceiling, and both are recorded", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "a.ts"), `${"export const a = 1;\n".repeat(50)}`);

  const tokens = 4000;
  const config = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    maxPartTokens: tokens,
  });

  assert.equal(config.maxPartTokens, tokens);
  assert.equal(config.maxPartBytes, bytesForTokens(tokens), "the byte budget is the conversion");

  const manifest = generateSnapshot(config);
  assert.equal(manifest.config.maxPartTokens, tokens, "the manifest states the user's unit");
  assert.equal(manifest.config.maxPartBytes, bytesForTokens(tokens));
  // And the ceiling is real: no part is over it.
  for (const part of manifest.parts) {
    assert.ok(part.byteSize <= config.maxPartBytes, `${part.filename} is ${part.byteSize} B`);
  }
});

test("a token budget never raises the byte budget", (t) => {
  const dir = tempDir(t);
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  // 100,000 tokens is 400 KB, which is above the 120 KB byte budget named here.
  const config = resolveConfig({
    cwd: dir,
    outDir: "snapshot",
    tmpDir: "snapshot.tmp",
    maxPartBytes: "120k",
    maxPartTokens: 100_000,
  });
  assert.equal(config.maxPartBytes, 120 * 1024, "the smaller ceiling wins");
});
</file>

<file path="tests/validator-confinement.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { generateSnapshot, renderExplainText, validateSnapshot } from "../dist/index.js";

/**
 * 4.0.9 regression cover for two trust boundaries in the validator.
 *
 * T-04 — `parts[].filename` came from the manifest and was joined onto `snapshot/parts` with no
 * confinement, so a manifest naming `../../../some/file` made `validate` read that file and report
 * its byte size back — a read primitive with a byte-size oracle attached.
 *
 * T-05/T-06 — the text form of `explain` interpolated repository-derived names raw, so a bidi
 * override or C1 control in a path, layer or part name could reorder the line or drive the
 * terminal. Values are re-spelled as `\uXXXX` now.
 */

function tempDir(t, prefix = "snap-validator-") {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function write(base, relativePath, content) {
  const target = path.join(base, relativePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, content);
  return target;
}

const makeRepo = (t) => {
  const dir = tempDir(t);
  write(dir, "app.ts", "export const a = 1;\n");
  return dir;
};

const readManifest = (dir) =>
  JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));

const writeManifest = (dir, manifest) =>
  fs.writeFileSync(
    path.join(dir, "snapshot", "manifest.json"),
    `${JSON.stringify(manifest, null, 2)}\n`,
    "utf8"
  );

test("T-04: a part filename that climbs out of snapshot/parts is refused, not read", (t) => {
  const dir = makeRepo(t);
  generateSnapshot({ cwd: dir });

  // A file outside the snapshot with a distinctive, knowable size.
  const outside = path.join(dir, "outside-secret.txt");
  fs.writeFileSync(outside, "x".repeat(44), "utf8");
  const relativeEscape = path
    .relative(path.join(dir, "snapshot", "parts"), outside)
    .replace(/\\/g, "/");

  const manifest = readManifest(dir);
  manifest.parts.push({ filename: relativeEscape, fileCount: 0, byteSize: 44, sha256: "0".repeat(64) });
  writeManifest(dir, manifest);

  const result = validateSnapshot({ cwd: dir });

  // The refusal moved earlier. `confineToDirectory` caught the escape at the read site, which
  // meant `validate` reported it while the MCP `snapshot_read` tool and the `snapshot://parts/{n}`
  // resource — which answer from the same manifest — did not. A part name is bare by construction,
  // so a manifest carrying anything else is not a snapshot manifest, and that answer now comes from
  // `describeManifestShapeProblem`, before any caller can act on the name.
  const errors = result.errors.join("\n");
  assert.match(errors, /is not a snapshot manifest/, "the manifest itself is refused");
  assert.match(errors, /bare filename/, "and the reason is stated");
  assert.equal(result.valid, false);

  const issues = result.drift.partIssues.map((issue) => `${issue.part}: ${issue.issue}`).join("\n");
  assert.doesNotMatch(
    issues,
    /byteSize is .* on disk/,
    "the outside file was never read, so its size cannot leak"
  );
});

test("T-04: an absolute part filename is refused too", (t) => {
  const dir = makeRepo(t);
  generateSnapshot({ cwd: dir });

  const manifest = readManifest(dir);
  manifest.parts.push({
    filename: path.join(dir, "outside-abs.txt"),
    fileCount: 0,
    byteSize: 1,
    sha256: "0".repeat(64),
  });
  writeManifest(dir, manifest);

  const result = validateSnapshot({ cwd: dir });
  assert.equal(result.valid, false);
  assert.match(result.errors.join("\n"), /bare filename/);
});

test("T-04: a legitimate snapshot still validates as current", (t) => {
  const dir = makeRepo(t);
  generateSnapshot({ cwd: dir });

  const result = validateSnapshot({ cwd: dir });

  assert.equal(result.valid, true, "the confinement must not reject real part names");
  assert.deepEqual(result.drift.partIssues, []);
});

test("T-05/T-06: explain's text form re-spells control and bidi characters", () => {
  const rendered = renderExplainText({
    path: `docs/invoice\u202Efdp.txt`,
    exists: true,
    included: true,
    layer: "src\u009bstill",
    kind: "code",
    language: "typescript",
    part: "part\u202E001.md",
    lines: 3,
    bytes: 12,
    secretCount: 0,
  });

  assert.doesNotMatch(rendered, /[\u202E\u009B]/, "no raw bidi or C1 control reaches the terminal");
  assert.match(rendered, /invoice\\u202Efdp\.txt/);
  assert.match(rendered, /src\\u009Bstill/);
  assert.match(rendered, /part\\u202E001\.md/);
});

test("T-05/T-06: ordinary names are untouched by the escaping", () => {
  const rendered = renderExplainText({
    path: "src/café/naïve.ts",
    exists: true,
    included: true,
    layer: "Core",
    kind: "code",
    language: "typescript",
    lines: 1,
    bytes: 5,
    secretCount: 0,
  });

  assert.match(rendered, /src\/café\/naïve\.ts/);
});

test("D-2: a manifest file path outside the repository is refused, not used as an oracle", (t) => {
  const dir = makeRepo(t);
  generateSnapshot({ cwd: dir });

  // A file that *does* exist outside the snapshot's idea of the repository.
  const outside = path.join(dir, "outside.txt");
  fs.writeFileSync(outside, "exists", "utf8");

  const manifest = readManifest(dir);
  manifest.files[0].relativePath = "../outside.txt";
  writeManifest(dir, manifest);

  const result = validateSnapshot({ cwd: dir });
  const issues = result.drift.partIssues.map((issue) => `${issue.part}: ${issue.issue}`).join("\n");

  assert.match(issues, /resolves outside the repository and was not inspected/);
  assert.equal(
    result.drift.missingOnDisk.includes("../outside.txt"),
    false,
    "a traversal path is never reported as deleted, which would answer whether it exists"
  );
});

test("D-2: the same refusal applies when the target does not exist", (t) => {
  const dir = makeRepo(t);
  generateSnapshot({ cwd: dir });

  const manifest = readManifest(dir);
  manifest.files[0].relativePath = "../definitely-missing.txt";
  writeManifest(dir, manifest);

  const result = validateSnapshot({ cwd: dir });
  const issues = result.drift.partIssues.map((issue) => issue.issue).join("\n");

  assert.match(issues, /resolves outside the repository/);
  assert.deepEqual(result.drift.missingOnDisk, [], "existence is not probed at all");
});

test("D-2: an ordinary snapshot still validates clean", (t) => {
  const dir = makeRepo(t);
  generateSnapshot({ cwd: dir });
  assert.equal(validateSnapshot({ cwd: dir }).valid, true);
});
</file>

<file path="tests/walker-depth.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";

import { collectFiles } from "../dist/index.js";

/**
 * 4.0.9 regression cover for the walker's shape.
 *
 * The walker was recursive, one stack frame per directory, so a path 2 400 levels deep overflowed
 * the JavaScript stack and killed every command on a tree that was otherwise perfectly readable.
 * It is an explicit frame stack now. Visit order has to stay what the recursion produced, because
 * `manifest.files[]` is in walk order and a different order changes the fingerprint and every part
 * boundary with it — so the order tests below are the point of this file.
 *
 * The deep fixture is opt-in: creating 2 500 nested directories costs minutes on Windows
 * (the path string itself is hundreds of kilobytes), while a real repository is never that deep.
 *   SNAPSHOT_DEPTH_TEST=1 node --test tests/walker-depth.test.js
 */

function tempDir(t, prefix = "snap-depth-") {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

test(
  "S5: a path 2 500 directories deep is scanned instead of overflowing the stack",
  {
    skip:
      process.env.SNAPSHOT_DEPTH_TEST === "1"
        ? false
        : "set SNAPSHOT_DEPTH_TEST=1 to run the 2 500-level walk test",
  },
  (t) => {
    const dir = tempDir(t);
    let deep = dir;
    try {
      for (let index = 0; index < 2_500; index += 1) {
        deep = path.join(deep, `d${index}`);
        fs.mkdirSync(deep);
      }
      fs.writeFileSync(path.join(deep, "leaf.ts"), "export const deep = 1;\n", "utf8");
    } catch {
      t.skip("this filesystem cannot create a 2 500-level path");
      return;
    }

    const collected = collectFiles(dir, {});

    assert.equal(collected.files.length, 1, "the deep file is found and the walk did not crash");
    assert.match(collected.files[0], /leaf\.ts$/);
  }
);

test("a subtree is finished before the next sibling directory begins", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "a", "aa"), { recursive: true });
  fs.mkdirSync(path.join(dir, "b"), { recursive: true });
  fs.writeFileSync(path.join(dir, "root.ts"), "", "utf8");
  fs.writeFileSync(path.join(dir, "a", "one.ts"), "", "utf8");
  fs.writeFileSync(path.join(dir, "a", "aa", "two.ts"), "", "utf8");
  fs.writeFileSync(path.join(dir, "b", "three.ts"), "", "utf8");

  const order = collectFiles(dir, {}).files;

  assert.equal(order.length, 4);
  const lastOfA = Math.max(
    order.indexOf("a/one.ts"),
    order.indexOf("a/aa/two.ts")
  );
  const firstOfB = order.indexOf("b/three.ts");
  assert.ok(lastOfA < firstOfB, "everything under a/ precedes everything under b/");
  // Entries inside one directory are visited in filesystem order, so whether `a/one.ts` or the
  // `aa/` subtree comes first is not fixed — only that `aa`'s own file follows its parent entry.
  assert.ok(order.indexOf("a/aa/two.ts") > order.indexOf("a/one.ts") - 2);
});

test("the root file and every nested file appear exactly once", (t) => {
  const dir = tempDir(t);
  fs.mkdirSync(path.join(dir, "src", "deep", "deeper"), { recursive: true });
  for (const name of [
    "root.ts",
    "src/a.ts",
    "src/deep/b.ts",
    "src/deep/deeper/c.ts",
  ]) {
    fs.writeFileSync(path.join(dir, name), "", "utf8");
  }

  const files = collectFiles(dir, {}).files;

  assert.equal(new Set(files).size, files.length, "no duplicates");
  assert.equal(files.length, 4);
});

test("two scans of the same tree produce the same order", (t) => {
  const dir = tempDir(t);
  for (const name of ["x", "y", "y/z"]) {
    fs.mkdirSync(path.join(dir, name), { recursive: true });
    fs.writeFileSync(path.join(dir, name, "f.ts"), "export const v = 1;\n", "utf8");
  }

  const first = collectFiles(dir, {}).files;
  const second = collectFiles(dir, {}).files;

  assert.deepEqual(second, first, "the walk is deterministic");
});

test("a walk 120 directories deep still works, and quickly", (t) => {
  const dir = tempDir(t);
  let deep = dir;
  for (let index = 0; index < 120; index += 1) {
    deep = path.join(deep, `d${index}`);
    fs.mkdirSync(deep);
  }
  fs.writeFileSync(path.join(deep, "leaf.ts"), "", "utf8");

  const collected = collectFiles(dir, {});
  assert.equal(collected.files.length, 1);
});
