<file path="tests/repo-hygiene.test.js">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import * as fs from "node:fs";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { buildTools } from "../dist/mcp.js";

/**
 * Repository hygiene, from the 0.9.10 audit.
 *
 * Three separate ways the repository described itself wrongly: a control byte had eaten a letter
 * out of a sentence (`\v` in "Validate", `\r` in "reports/", `\a` in "audit.md" — the escapes were
 * interpreted when the text was written), four documents claimed the MCP server serves seven
 * tools when it serves eight, and one npm script could not run.
 */

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

const read = (relative) => fs.readFileSync(path.join(ROOT, relative), "utf8");

/** Control characters that have no business being in a text file. */
const CONTROL = /[\u0000-\u0008\u000B\u000C\u000E-\u001F]/;

const TEXT_EXTENSIONS = new Set([
  ".ts",
  ".tsx",
  ".js",
  ".mjs",
  ".cjs",
  ".json",
  ".md",
  ".yml",
  ".yaml",
  ".txt",
  ".sh",
]);

function trackedTextFiles() {
  const output = execFileSync("git", ["ls-files", "-z"], { cwd: ROOT, encoding: "utf8" });
  return output
    .split("\0")
    .filter(Boolean)
    .filter((relative) => TEXT_EXTENSIONS.has(path.extname(relative).toLowerCase()));
}

test("no tracked text file contains a control byte", () => {
  const offenders = [];
  for (const relative of trackedTextFiles()) {
    const text = fs.readFileSync(path.join(ROOT, relative), "utf8");
    const lines = text.split("\n");
    for (let index = 0; index < lines.length; index += 1) {
      const line = lines[index];
      if (CONTROL.test(line)) {
        offenders.push(`${relative}:${index + 1}`);
      }
    }
  }

  assert.deepEqual(
    offenders,
    [],
    "an interpreted escape (\\v, \\r, \\a, \\e) writes a control byte and silently deletes a letter"
  );
});

test("the words those escapes ate are back", () => {
  assert.match(read("src/explain.ts"), /out of explain\./);
  assert.match(read("src/index.ts"), /Written beside audit\.md/);
  assert.match(read("src/types.ts"), /`reports\/audit\.sarif`/);
  assert.match(read("src/mcp/workspace.ts"), /`resolveConfig` was called with/);
  assert.match(read("docs/stale-context-is-your-bug.md"), /^Validate only helps if it runs\./m);
});

test("every document that states the MCP tool count states the real one", () => {
  const count = buildTools().length;
  const words = [
    "zero",
    "one",
    "two",
    "three",
    "four",
    "five",
    "six",
    "seven",
    "eight",
    "nine",
    "ten",
  ];
  const expected = words[count] ?? String(count);

  const documents = ["AGENTS.md", "README.md", "docs/agent.md", "scripts/build-site.mjs"];
  const wrong = [];
  for (const document of documents) {
    const text = read(document);
    for (const match of text.matchAll(/\b(zero|one|two|three|four|five|six|seven|eight|nine|ten)\b[\s-]+tools\b/gi)) {
      if (match[1].toLowerCase() !== expected) {
        wrong.push(`${document}: says ${match[1]}, the server serves ${count}`);
      }
    }
  }

  assert.deepEqual(wrong, []);
});

test("publish:create names a path npm cannot mistake for a repository", () => {
  const script = JSON.parse(read("package.json")).scripts["publish:create"];

  // `npm publish packages/create` is read by npm as the GitHub shorthand
  // `ssh://git@github.com/packages/create.git` and fails with exit 128.
  assert.match(script, /npm publish \.\/packages\/create\b/, `received: ${script}`);
  assert.doesNotMatch(script, /npm publish packages\/create\b/);
});

test("the site link checker cannot accept a sibling directory", () => {
  const source = read("scripts/check-site-links.mjs");

  assert.match(
    source,
    /resolved\.startsWith\(SITE \+ path\.sep\)/,
    "`startsWith(SITE)` is true for `../site-other`, which is not inside the site"
  );
});

test("the verify gate checks that every site link resolves, not only the anchors", () => {
  const verify = JSON.parse(read("package.json")).scripts.verify;

  // `npm run site` builds the pages; `audit-site` only verifies fragments. A docs link to a page
  // that does not exist therefore passed `npm run verify` and failed the deploy.
  assert.match(verify, /npm run site/);
  assert.match(
    verify,
    /node scripts\/check-site-links\.mjs/,
    "a link to a page the site does not contain must fail the local gate too"
  );
  assert.ok(
    verify.indexOf("npm run site") < verify.indexOf("node scripts/check-site-links.mjs"),
    "the link check needs the built site"
  );
});

test("the release notes and the version agree", () => {
  const version = JSON.parse(read("package.json")).version;
  const changelog = read("CHANGELOG.md");

  assert.match(
    changelog,
    new RegExp(`^## ${version.replace(/\./g, "\\.")}\\b`, "m"),
    `CHANGELOG.md has no section for ${version}`
  );
});
</file>

<file path="tests/sarif-integration.test.js">
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import {
  DEFAULT_SECRET_PATTERNS,
  configDigest,
  generateSarifReport,
  generateSnapshot,
  resolveConfig,
  validateSnapshot,
} from "../dist/index.js";

const BIN = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "dist", "bin.js");

/**
 * `--sarif` from the 0.9.10 audit: five gaps around one artifact.
 *
 * The log itself worked; what surrounded it did not. The monolith embedded a manifest written
 * before `artifacts.sarif` existed, `validate` never looked at the file at all, the config digest
 * could not tell two runs apart, the summary claimed nothing had been written, and the rule ids
 * moved when an unrelated rule was added.
 */

function makeRepo(t, extra = {}) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "sarif-int-"));
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "a.ts"), "export const a = 1;\n");
  // A real finding, so the log has results and the rule catalogue has an entry.
  fs.writeFileSync(
    path.join(dir, ".env"),
    "API_KEY=sk_live_abcdef1234567890\n",
    "utf8"
  );
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));

  return { dir, options: { cwd: dir, outDir: "snapshot", tmpDir: "snapshot.tmp", sarif: true, ...extra } };
}

const ruleIdOf = (log, name) =>
  log.runs[0].tool.driver.rules.find((rule) => rule.name === name)?.id;

test("the manifest inside full-codebase.json also declares the SARIF file", (t) => {
  const { dir, options } = makeRepo(t, { includeMonolith: true });

  const manifest = generateSnapshot(options);
  assert.ok(manifest.artifacts.sarif, "the shipped manifest records it");

  const monolith = JSON.parse(
    fs.readFileSync(path.join(dir, "snapshot", "full-codebase.json"), "utf8")
  );
  assert.deepEqual(
    monolith.manifest.artifacts.sarif,
    manifest.artifacts.sarif,
    "two copies of one manifest must not disagree about what the run produced"
  );
});

test("validate notices a SARIF file that no longer matches its digest", (t) => {
  const { dir, options } = makeRepo(t);
  generateSnapshot(options);

  assert.equal(validateSnapshot(options).valid, true, "the snapshot is sound to begin with");

  fs.writeFileSync(path.join(dir, "snapshot", "reports", "audit.sarif"), "{}\n", "utf8");
  const result = validateSnapshot(options);

  assert.equal(result.valid, false, "a third-party security report must be verified");
  assert.ok(
    result.drift.partIssues.some((issue) => issue.part === "reports/audit.sarif"),
    JSON.stringify(result.drift.partIssues)
  );
});

test("validate notices a missing SARIF file", (t) => {
  const { dir, options } = makeRepo(t);
  generateSnapshot(options);
  fs.rmSync(path.join(dir, "snapshot", "reports", "audit.sarif"));

  const result = validateSnapshot(options);
  assert.equal(result.valid, false);
  assert.ok(
    result.drift.partIssues.some(
      (issue) => issue.part === "reports/audit.sarif" && /missing/.test(issue.issue)
    )
  );
});

test("--sarif is part of the configuration digest", () => {
  const base = { cwd: process.cwd(), outDir: "snapshot", tmpDir: "snapshot.tmp" };
  const without = resolveConfig(base);
  const with_ = resolveConfig({ ...base, sarif: true });

  assert.notEqual(
    configDigest(without),
    configDigest(with_),
    "the two runs write different directories, so they are different snapshots"
  );
});

test("a run that writes only the SARIF does not claim to have written nothing", (t) => {
  const { dir } = makeRepo(t);
  // The CLI summary had its own copy of the claim, and it was the one a reader actually sees.
  const result = spawnSync(
    process.execPath,
    [
      BIN,
      "generate",
      "--sarif",
      "--skip-artifacts",
      "readme,manifest,parts,navigation,projectTree,audit",
      "--cwd",
      dir,
    ],
    { cwd: dir, encoding: "utf8", timeout: 60_000 }
  );

  assert.equal(result.status, 0, result.stderr);
  const output = `${result.stdout}${result.stderr}`;
  assert.doesNotMatch(
    output,
    /all disabled/i,
    `the summary must not contradict the directory:\n${output}`
  );
  assert.ok(
    fs.existsSync(path.join(dir, "snapshot", "reports", "audit.sarif")),
    "and the file it was denying really is there"
  );
  assert.match(output, /audit\.sarif/, "the summary names what it wrote");
});

test("the same rule keeps its id when a custom rule is added", () => {
  const finding = { rules: ["credential-assignment"], line: 3, path: "src/a.ts" };
  const stub = { fingerprint: "fingerprint" };

  const before = JSON.parse(
    generateSarifReport(stub, [finding], DEFAULT_SECRET_PATTERNS, "0.0.0")
  );
  // Sorts before every built-in name, which is what shifted the whole numbering scheme.
  const custom = { rule: "acme-key", pattern: /ACME-[A-Z0-9]{8}/ };
  const after = JSON.parse(
    generateSarifReport(stub, [finding], [...DEFAULT_SECRET_PATTERNS, custom], "0.0.0")
  );

  assert.equal(
    ruleIdOf(after, "credential-assignment"),
    ruleIdOf(before, "credential-assignment"),
    "an added rule must not re-point existing alerts at another rule"
  );
  assert.ok(
    ruleIdOf(after, "acme-key"),
    "and the custom rule gets an id of its own"
  );
});

test("a custom rule's id is derived from its name, not its position", () => {
  const stub = { fingerprint: "fingerprint" };
  const finding = { rules: ["acme-key"], line: 1, path: "a.ts" };
  const custom = { rule: "acme-key", pattern: /ACME-[A-Z0-9]{8}/ };

  const alone = JSON.parse(generateSarifReport(stub, [finding], [custom], "0.0.0"));
  const crowded = JSON.parse(
    generateSarifReport(stub, [finding], [...DEFAULT_SECRET_PATTERNS, custom], "0.0.0")
  );

  assert.equal(ruleIdOf(alone, "acme-key"), ruleIdOf(crowded, "acme-key"));
});

test("built-in rule ids are three digits and custom ids are eight hex digits", () => {
  const log = JSON.parse(
    generateSarifReport(
      { fingerprint: "f" },
      [{ rules: ["credential-assignment"], line: 1, path: "a.ts" }],
      [...DEFAULT_SECRET_PATTERNS, { rule: "acme-key", pattern: /ACME-[A-Z0-9]{8}/ }],
      "0.0.0"
    )
  );
  const ids = log.runs[0].tool.driver.rules.map((rule) => rule.id);

  for (const id of ids) {
    assert.match(id, /^CS(?:[0-9]{3}|[0-9A-F]{8})$/, `${id} is not a stable-shaped id`);
  }
  assert.equal(new Set(ids).size, ids.length, "ids are unique");
});

test("results are ordered by code unit, not by the host locale", () => {
  // `en` collation puts `ab` before `aB` (lowercase wins a case-insensitive tie); a code-unit
  // comparison puts `aB` first because `B` is 66 and `b` is 98. `localeCompare` therefore made
  // the same commit produce different SARIF bytes on different machines — the same failure this
  // file already fixed for rule ids, and that `tree.ts` fixed for tree order.
  const findings = [
    { rules: ["credential-assignment"], line: 1, path: "src/ab.ts" },
    { rules: ["credential-assignment"], line: 1, path: "src/aB.ts" },
  ];
  const log = JSON.parse(
    generateSarifReport({ fingerprint: "f" }, findings, DEFAULT_SECRET_PATTERNS, "0.0.0")
  );
  const order = log.runs[0].results.map(
    (result) => result.locations[0].physicalLocation.artifactLocation.uri
  );

  assert.deepEqual(order, ["src/aB.ts", "src/ab.ts"]);
  assert.deepEqual(
    order,
    [...order].sort((left, right) => (left < right ? -1 : left > right ? 1 : 0)),
    "the order is exactly a code-unit sort"
  );
});

test("the order does not depend on the default locale", () => {
  const findings = [
    { rules: ["credential-assignment"], line: 1, path: "src/ab.ts" },
    { rules: ["credential-assignment"], line: 1, path: "src/aB.ts" },
  ];
  const uris = () =>
    JSON.parse(generateSarifReport({ fingerprint: "f" }, findings, DEFAULT_SECRET_PATTERNS, "0.0.0"))
      .runs[0].results.map((result) => result.locations[0].physicalLocation.artifactLocation.uri);

  const previous = process.env.LANG;
  try {
    process.env.LANG = "sv_SE.UTF-8";
    const swedish = uris();
    process.env.LANG = "en_US.UTF-8";
    assert.deepEqual(swedish, uris());
  } finally {
    if (previous === undefined) delete process.env.LANG;
    else process.env.LANG = previous;
  }
});
</file>

<file path="tests/scanner-parity-and-caches.test.js">
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { isGeneratedWatchPath } from "../dist/cli.js";
import {
  collectFiles,
  findSecretInPath,
  globToRegExp,
  matchesExclude,
  resolveConfig,
} from "../dist/index.js";

/**
 * Discovery parity, tool-owned leftovers, and the two caches the scanner was missing.
 *
 * The failure mode behind most of this file is the same one: `git` mode and `walk` mode answer the
 * same question with different rules, so one repository produces two different snapshots depending
 * on which enumeration ran. A snapshot tool whose output depends on an unrelated flag is not
 * reproducible, which is the one property the whole design is built on.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));
const gitAvailable = spawnSync("git", ["--version"], { encoding: "utf8" }).status === 0;

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "scanner-parity-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

/** True when this machine lets the test process create symlinks (Windows needs a privilege). */
function canSymlink(root) {
  const probe = path.join(root, ".symlink-probe");
  try {
    fs.symlinkSync(path.join(root, "package.json"), probe, "file");
    fs.unlinkSync(probe);
    return true;
  } catch {
    return false;
  }
}

/**
 * Creates a link whose target does not exist, without needing a privilege on Windows.
 *
 * A junction needs no privilege there and may point at a path that does not exist; `realpathSync`
 * fails on it exactly as it does on a broken POSIX symlink, which is the case being classified.
 */
function makeBrokenLink(target, linkPath) {
  fs.symlinkSync(target, linkPath, process.platform === "win32" ? "junction" : "dir");
}

const gitConfig = (root) =>
  resolveConfig({ cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "git" }, {}, root);
const walkConfig = (root) =>
  resolveConfig({ cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk" }, {}, root);

/** The `files`/`skipped` pair for one discovery mode, in a comparable form. */
function collect(root, discovery) {
  const result = collectFiles(root, { discovery, toolOwnedPaths: ["snapshot", "snapshot.tmp"] });
  const reasons = new Map(result.skipped.map((record) => [record.path, record.reason]));
  return { files: [...result.files].sort(), reasons };
}

test(
  "git and walk agree about file symlinks and broken symlinks",
  { skip: !gitAvailable },
  (t) => {
    // `dropLinkedDirectories` tested `depth <= parts.length`, so a *file* symlink was reported as a
    // `symlink` skip in `git` mode while `walkDirectory` followed it and emitted the file. And
    // because `targetReal` was initialised to the link's own path, a broken link that pointed
    // outside the root was inside the root by that comparison, so it was filed as `symlink`
    // instead of `read-error`/`outside-root`.
    const root = makeRepo(t, {
      "package.json": '{"name":"fixture","version":"1.0.0"}\n',
      "src/real.ts": "export const real = 1;\n",
    });
    if (!canSymlink(root)) {
      t.skip("this machine cannot create symlinks");
      return;
    }
    fs.symlinkSync(path.join(root, "src", "real.ts"), path.join(root, "src", "link.ts"), "file");
    fs.symlinkSync(
      path.join(root, "..", "gone", "nothing.ts"),
      path.join(root, "src", "broken.ts"),
      "file"
    );

    execFileSync("git", ["init", "-q"], { cwd: root });
    execFileSync("git", ["config", "core.symlinks", "true"], { cwd: root });
    execFileSync("git", ["add", "-A"], { cwd: root });

    const viaGit = collect(root, "git");
    const viaWalk = collect(root, "walk");

    assert.deepEqual(
      viaGit.files,
      viaWalk.files,
      "the same repository must enumerate the same files either way"
    );
    assert.equal(
      viaGit.reasons.get("src/link.ts") ?? null,
      viaWalk.reasons.get("src/link.ts") ?? null,
      "an in-root file symlink is either a file or a skip in both modes, never one of each"
    );
    assert.equal(
      viaGit.reasons.get("src/broken.ts") ?? null,
      viaWalk.reasons.get("src/broken.ts") ?? null,
      "a broken symlink is reported with one reason, not two"
    );
    // A link that resolves outside the root is the security-relevant answer, and both modes
    // must give it rather than one of them inventing `symlink`.
    assert.equal(viaWalk.reasons.get("src/broken.ts"), "outside-root");
  }
);

test("walk mode tells a broken link inside the root from one that points outside it", (t) => {
  // The walker answered `read-error` for every unresolvable link, while `dropLinkedDirectories`
  // asked where the raw target pointed — so the same repository reported the same entry two ways
  // depending on `--discovery`. Both now answer through one function, and this pins both sides of
  // it on a platform-independent fixture: a junction to a missing directory needs no privilege on
  // Windows, and is a broken symlink everywhere else.
  const root = makeRepo(t, { "package.json": '{"name":"fixture","version":"1.0.0"}\n' });
  try {
    makeBrokenLink(path.join(root, "gone", "nothing.ts"), path.join(root, "broken-inside"));
    makeBrokenLink(path.join(root, "..", "gone", "nothing.ts"), path.join(root, "broken-outside"));
  } catch (err) {
    t.skip(`this host cannot create links: ${err.message}`);
    return;
  }

  const { skipped } = collectFiles(root, {
    discovery: "walk",
    toolOwnedPaths: ["snapshot", "snapshot.tmp"],
  });
  const reasons = new Map(skipped.map((record) => [record.path, record.reason]));

  assert.equal(reasons.get("broken-inside"), "read-error", "a target inside the root is just broken");
  assert.equal(
    reasons.get("broken-outside"),
    "outside-root",
    "a target outside the root is the security-relevant answer"
  );
});

test("leftovers of a custom outDir are never scanned back in", (t) => {
  // `defaultIgnoreReason` and the walker both hardcoded `snapshot.backup-`, and
  // `isGeneratedWatchPath` knew only `.backup-`. With `outDir: ".context"` a crashed swap left
  // `.context.backup-<pid>-<ts>` — which is a copy of the previous snapshot, not the user's source
  // — to be picked up by the next run. In `--watch` the `EXDEV` `.partial-` copy also fed the
  // watcher, which saw its own output as an edit and regenerated forever.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "src/app.ts": "export const app = 1;\n",
    ".context.backup-4242-1700000000000/parts/part-001.md": "# old snapshot\n",
    ".context.partial-4242-1700000000001/parts/part-001.md": "# half-swapped\n",
    "snapshot.backup-1-2/parts/part-001.md": "# default name\n",
  });

  const config = resolveConfig(
    { cwd: root, outDir: ".context", tmpDir: ".context.tmp", discovery: "walk" },
    {},
    root
  );
  const result = collectFiles(root, {
    discovery: "walk",
    toolOwnedPaths: [".context", ".context.tmp"],
  });

  const leftovers = result.files.filter((file) => file.includes(".backup-") || file.includes(".partial-"));
  assert.deepEqual(leftovers, [], `no leftover directory may be scanned: ${leftovers.join(", ")}`);
  assert.ok(result.files.includes("src/app.ts"), "real source is unaffected");
  assert.ok(
    result.skipped.some((record) => record.path.startsWith(".context.backup-")),
    "a leftover is recorded as skipped rather than vanishing without a trace"
  );
  assert.equal(config.outDir, ".context");

  // The watcher has to ignore exactly the directories the swapper creates, or `--watch` feeds on
  // its own writes.
  const paths = { cwd: root, outDir: ".context", tmpDir: ".context.tmp" };
  assert.equal(isGeneratedWatchPath(".context.backup-9-9/parts/part-001.md", paths), true);
  assert.equal(isGeneratedWatchPath(".context.partial-9-9/parts/part-001.md", paths), true);
  assert.equal(isGeneratedWatchPath("src/app.ts", paths), false);
});

test("secrets.disableDefaultPatterns applies to paths, not just to content", (t) => {
  // `pathScanRules` returned `[...DEFAULT_SECRET_PATTERNS, ...extraRules]`, but `config.secretRules`
  // *already* starts with those patterns — so every path and every AST-summary string ran all 30
  // built-in rules twice, and the "defaults are off" switch had no effect on them at all.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "aws_AKIAIOSFODNN7EXAMPLE.ts": "export const x = 1;\n",
  });

  const withDefaults = resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk" },
    {},
    root
  );
  const skippedWithDefaults = collectFiles(root, {
    discovery: "walk",
    secretRules: withDefaults.secretRules,
  });
  assert.equal(
    skippedWithDefaults.files.includes("aws_AKIAIOSFODNN7EXAMPLE.ts"),
    false,
    "a credential-shaped filename is skipped by default"
  );

  const withoutDefaults = resolveConfig(
    {
      cwd: root,
      outDir: "snapshot",
      tmpDir: "snapshot.tmp",
      discovery: "walk",
      secrets: { disableDefaultPatterns: true },
    },
    {},
    root
  );
  assert.equal(withoutDefaults.secretRules.length, 0, "the switch really leaves no rules");
  const skippedWithout = collectFiles(root, {
    discovery: "walk",
    secretRules: withoutDefaults.secretRules,
  });
  assert.equal(
    skippedWithout.files.includes("aws_AKIAIOSFODNN7EXAMPLE.ts"),
    true,
    "with the defaults off, the default rules must not fire on a path either"
  );
});

test("a malformed character range in configuration is a named error", () => {
  // `new RegExp("[z-a]")` throws, and `matchesExclude` compiled with no guard — so one out-of-order
  // range in an exclude pattern, a layer rule or a preset killed the scan with a raw SyntaxError
  // that named neither the pattern nor the file. A glob that cannot work is a configuration
  // mistake, so it is reported as one (rule 1) instead of quietly matching nothing.
  assert.throws(() => matchesExclude("a.ts", "[z-a].ts"), /"\[z-a\]\.ts" is not a valid glob/);
  assert.throws(() => globToRegExp("[z-a]"), /not a valid glob/);
  // A well-formed class still behaves.
  assert.equal(matchesExclude("a.ts", "[a-c].ts"), true);
});

test("a malformed class in .gitignore does not stop the walk", (t) => {
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    ".gitignore": "[z-a].txt\n",
    "kept.ts": "export const kept = 1;\n",
  });
  const result = collectFiles(root, { discovery: "walk" });
  assert.ok(result.files.includes("kept.ts"), "the walk still returns the files it can read");
});

test("glob patterns compile once, not once per file", () => {
  // `globToRegExp` built a fresh RegExp on every call, and `matchesExclude` calls it for every
  // (file, pattern) pair — over a million compilations on a 20 000-file repository with 40
  // patterns. Compiling is pure, so the result is cached and the same object comes back.
  assert.equal(globToRegExp("**/*.ts"), globToRegExp("**/*.ts"), "the same glob is one RegExp");
  assert.notEqual(globToRegExp("**/*.ts"), globToRegExp("**/*.tsx"), "different globs differ");
});

test("the path scan rules are not rebuilt on every call", () => {
  // The observable half of the duplication is covered above (`disableDefaultPatterns`); the cost
  // half has no behavioural signal at all — the work is the same work, done twice — so the
  // invariant is asserted against the source. `pathScanRules` must not mention the built-in list.
  const source = fs.readFileSync(path.join(HERE, "..", "src", "scanner", "files.ts"), "utf8");
  const body = source.slice(
    source.indexOf("function pathScanRules"),
    source.indexOf("export function findSecretInPath")
  );
  assert.ok(body.length > 0, "the helper is still there");
  assert.equal(
    body.includes("DEFAULT_SECRET_PATTERNS"),
    false,
    "pathScanRules must not prepend the built-in rules to a list that already contains them"
  );

  // And the rules actually used are exactly the caller's, so a custom rule still applies.
  const custom = [{ rule: "custom", pattern: /hunter2/ }];
  const hit = findSecretInPath("hunter2.txt", custom);
  assert.deepEqual(hit?.rules, ["custom"]);
  assert.ok(hit?.masked.startsWith("[REDACTED"), `masked to a marker: ${hit?.masked}`);
  assert.ok(hit?.masked.endsWith(".txt"), "and the surrounding name survives");
});
</file>

<file path="tests/security-traversal-and-redaction.test.js">
import assert from "node:assert/strict";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

import { explainPath, generateSnapshot, resolveConfig, validateSnapshot } from "../dist/index.js";
import { buildResourceProvider, buildTools } from "../dist/mcp.js";
import { DEFAULT_SECRET_PATTERNS, scanAndRedactSecrets } from "../dist/index.js";

/**
 * The security findings from the architecture audit.
 *
 * Two classes: the MCP server honouring a path out of `manifest.json` as though a repository author
 * were a trusted caller, and redaction declining to mask a credential because the *shape* of the
 * value looked like code.
 */

const HERE = path.dirname(fileURLToPath(import.meta.url));

function makeRepo(t, files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "security-"));
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
  return root;
}

const configFor = (root, extra = {}) =>
  resolveConfig(
    { cwd: root, outDir: "snapshot", tmpDir: "snapshot.tmp", discovery: "walk", ...extra },
    {},
    root
  );

const tools = new Map(buildTools().map((tool) => [tool.name, tool]));
const contextFor = (root) => ({ cwd: root, roots: [root], log: () => {} });

test("a part filename in the manifest cannot reach outside snapshot/parts", async (t) => {
  // `validateSnapshot` grew `confineToDirectory` for exactly this, but `manifest.json` is an input
  // on disk and the *server* still resolved `parts[].filename` with a bare `path.resolve`. A
  // repository under review could commit a manifest naming `../../../.env` and an MCP client —
  // which auto-approves resource reads because they are read-only — was handed that file's
  // contents. `describeManifestShapeProblem` accepted any string.
  const root = makeRepo(t, {
    "package.json": '{"name":"fixture","version":"1.0.0"}\n',
    "index.ts": "export const app = 1;\n",
  });
  const outsidePath = path.join(root, "..", `${path.basename(root)}-outside.env`);
  fs.writeFileSync(outsidePath, "DATABASE_PASSWORD=not-for-the-model\n");
  t.after(() => fs.rmSync(outsidePath, { force: true }));

  const config = configFor(root);
  generateSnapshot(config);

  const manifestPath = path.join(root, "snapshot", "manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  manifest.parts[0].filename = `../../${path.basename(outsidePath)}`;
  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));

  const provider = buildResourceProvider();
  const resource = await provider.read("snapshot://parts/1", contextFor(root));
  assert.equal(resource, null, "the resource read must not return a file outside parts/");

  const read = await tools.get("snapshot_read").handler(
    { path: "index.ts" },
    contextFor(root)
  );
  assert.equal(read.isError, true, "snapshot_read refuses a manifest it cannot trust");
  assert.doesNotMatch(read.text, /not-for-the-model/, "and never echoes the target's contents");

  const result = validateSnapshot(config);
  assert.equal(result.valid, false);
  assert.ok(
    result.errors.some((error) => /not a snapshot manifest/.test(error)),
    `a traversal filename is a shape problem: ${result.errors.join("; ")}`
  );

  // The message names the rule, so the reader knows what to fix.
  assert.ok(
    result.errors.some((error) => /bare filename/.test(error)),
    `the reason is stated: ${result.errors.join("; ")}`
  );
});

test("snapshot_explain will not probe a path outside the root", async (t) => {
  // `normalizeTarget` returned any relative path starting with `..` unchanged, and `explainPath`
  // then joined it to `cwd` and called `existsSync`. `toRelativePath` had the same hole: it
  // resolved *after* the "is it absolute?" test. So a prompt-injected agent could ask
  // `snapshot_explain` whether any path on the host exists — one read-only, auto-approved call per
  // probe.
  const parent = fs.mkdtempSync(path.join(os.tmpdir(), "explain-root-"));
  const root = path.join(parent, "repo");
  fs.mkdirSync(root, { recursive: true });
  fs.writeFileSync(path.join(root, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(root, "..foo.ts"), "export const dotted = 1;\n");
  fs.writeFileSync(path.join(parent, "target.env"), "SECRET=1\n");
  t.after(() => fs.rmSync(parent, { recursive: true, force: true }));

  const config = configFor(root);

  const escaped = explainPath(config, "../target.env");
  assert.equal(escaped.exists, false, "an out-of-root path is not even stat-ed");
  assert.equal(escaped.reason, "outside-root");
  assert.equal(escaped.included, false);

  // `../../../etc/passwd` must be refused the same way, whatever is on the host.
  assert.equal(explainPath(config, "../../../etc/passwd").reason, "outside-root");

  // A file whose name merely *starts* with two dots is an ordinary in-repo file. The old test was
  // `relative.startsWith("..")`, which classified it as a parent traversal.
  const dotted = explainPath(config, "..foo.ts");
  assert.notEqual(dotted.reason, "outside-root", "a name starting with `..` is not a traversal");
  assert.equal(dotted.exists, true);

  // The same refusal through the tool, which is where an agent actually asks.
  const explained = await tools.get("snapshot_explain").handler(
    { path: "../target.env" },
    contextFor(root)
  );
  assert.equal(explained.isError, true, "the tool answers with an error, not a existence oracle");
  assert.match(explained.text, /outside/);
});

test("a template interpolation with a fallback secret is still a secret", () => {
  // `isTemplateInterpolation` tested only `${` … `}`, so any quoted value that started with `$`
  // and ended with `}` was exempt — including the Docker Compose and shell idiom for a default,
  // which is *a hardcoded credential*.
  const compose = 'POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:-MyProdPassword123!}"\n';
  const maskedCompose = scanAndRedactSecrets(compose, DEFAULT_SECRET_PATTERNS);
  assert.equal(
    maskedCompose.redacted.includes("MyProdPassword123!"),
    false,
    `the fallback must not survive: ${maskedCompose.redacted}`
  );
  assert.equal(maskedCompose.findings.length > 0, true);

  // A backtick-delimited value the credential rules *do* match, carrying a shell-style default.
  const js = "const password = `${PASSWORD:-hunter2_prod_fallback}`;\n";
  assert.equal(
    scanAndRedactSecrets(js, DEFAULT_SECRET_PATTERNS).redacted.includes("hunter2_prod_fallback"),
    false,
    "a shell-style fallback inside a template literal is a secret too"
  );

  const flanked = 'token: "${prefix}-real_secret-${suffix}"\n';
  assert.equal(
    scanAndRedactSecrets(flanked, DEFAULT_SECRET_PATTERNS).redacted.includes("real_secret"),
    false,
    "two interpolations flanking a literal do not make it an interpolation"
  );

  // The reason the guard exists: a value that is *only* an interpolation is an expression, and
  // masking it rewrote an assertion message in this repository's own tests.
  const pure = 'const message = `an empty token: "${appliesTo}"`;\n';
  assert.equal(
    scanAndRedactSecrets(pure, DEFAULT_SECRET_PATTERNS).redacted,
    pure,
    "a bare identifier interpolation is not a credential"
  );
  const dotted = 'const message = `token: "${process.env.TOKEN}"`;\n';
  assert.equal(
    scanAndRedactSecrets(dotted, DEFAULT_SECRET_PATTERNS).redacted,
    dotted,
    "a dotted reference interpolation is not a credential either"
  );
});

test("`export name=value` in a shell script is an assignment, not a declaration", () => {
  // `DECLARATION_KEYWORDS` listed bare `export`, so `export api_key=…` was read as a *binding*
  // whose initializer is an expression — and left in clear text. `export` is never followed by a
  // bare assignment in JavaScript or TypeScript (`export foo = 1` does not parse), so the keyword
  // only ever suppressed redaction for shell and `.envrc` files.
  const shell = "#!/bin/sh\nexport api_key=hunter2_live_secret\n";
  const masked = scanAndRedactSecrets(shell, DEFAULT_SECRET_PATTERNS);
  assert.equal(
    masked.redacted.includes("hunter2_live_secret"),
    false,
    `a lowercase export assignment is a credential: ${masked.redacted}`
  );

  const token = "export auth_token=my_secret_token\n";
  assert.equal(
    scanAndRedactSecrets(token, DEFAULT_SECRET_PATTERNS).redacted.includes("my_secret_token"),
    false
  );

  // And the declarations the guard exists for still survive: `export` is *not* what makes the
  // difference there — `const`, `let`, `var`, `readonly` and the modifiers are.
  const declaration = "export const SINGLE_TOKEN = /[^\\sA-Za-z0-9_]/g;\n";
  assert.equal(
    scanAndRedactSecrets(declaration, DEFAULT_SECRET_PATTERNS).redacted,
    declaration,
    "a declared regex literal is not a credential"
  );
});

test("an indented, unterminated private key does not leak its body", () => {
  // The unterminated-PEM rule required base64 at column 0 and knew nothing about RFC 1421 header
  // lines. A key inside a YAML block scalar — `privateKey: |` — or inside an indented template
  // literal therefore never matched it, so Pass 2 masked the `-----BEGIN…-----` line only and left
  // every body line of the key in the snapshot.
  const yaml = [
    "service:",
    "  privateKey: |",
    "    -----BEGIN RSA PRIVATE KEY-----",
    "    MIIEowIBAAKCAQEAq7Zr8kLmnOpQrStUvWxYz0123456789abcdefghij",
    "    KLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/AB",
    "  other: value",
    "",
  ].join("\n");
  const masked = scanAndRedactSecrets(yaml, DEFAULT_SECRET_PATTERNS);
  assert.equal(
    masked.redacted.includes("MIIEowIBAAKCAQEAq7Zr8kLmnOpQrStUvWxYz0123456789abcdefghij"),
    false,
    `the key body must be gone: ${masked.redacted}`
  );
  assert.equal(masked.redacted.includes("KLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"), false);
  assert.equal(masked.findings.length > 0, true, "and the finding is recorded");
  // Text after the key is untouched, so the rule stopped where the key did.
  assert.match(masked.redacted, /other: value/);

  // RFC 1421 header lines between the marker and the body are part of the same key.
  const encrypted = [
    "-----BEGIN RSA PRIVATE KEY-----",
    "Proc-Type: 4,ENCRYPTED",
    "DEK-Info: AES-128-CBC,0123456789ABCDEF0123456789ABCDEF",
    "",
    "MIIEowIBAAKCAQEAq7Zr8kLmnOpQrStUvWxYz0123456789abcdefghij",
    "",
  ].join("\n");
  const maskedEncrypted = scanAndRedactSecrets(encrypted, DEFAULT_SECRET_PATTERNS);
  assert.equal(maskedEncrypted.redacted.includes("MIIEowIBAAKCAQEAq7Zr8kLmnOpQrStUvWxYz"), false);
});

test("a CR-only file keeps its line count through a private key", () => {
  // Pass 1 counted `\n` only, so in a CR-delimited file (old-Mac endings, which `decodeText` will
  // hand over unchanged) the whole matched block was replaced by a marker carrying *no* line
  // breaks — every reported line number after it was wrong.
  const crOnly = [
    "-----BEGIN RSA PRIVATE KEY-----",
    "MIIEowIBAAKCAQEAq7Zr8kLmnOpQrStUvWxYz0123456789abcdefghij",
    "-----END RSA PRIVATE KEY-----",
    "const apiKey = 1;",
  ].join("\r");
  const masked = scanAndRedactSecrets(crOnly, DEFAULT_SECRET_PATTERNS);
  assert.equal(masked.redacted.includes("MIIEowIBAAKCAQEAq7Zr8kLmn"), false, "the key is masked");
  assert.equal(
    masked.redacted.split(/\r\n|\n|\r/).length,
    crOnly.split(/\r\n|\n|\r/).length,
    "the block still occupies the same number of lines"
  );
});

test("no workflow interpolates a dispatch input into a shell script", () => {
  // `${{ inputs.spec }}` was written straight into `run:` in a job carrying `NODE_AUTH_TOKEN`, so
  // a dispatch input containing `"; curl … $NODE_AUTH_TOKEN` ran as shell. Inputs reach the script
  // through `env:` and are quoted, or they do not reach it at all.
  const workflowDir = path.join(HERE, "..", ".github", "workflows");
  const offenders = [];
  for (const file of fs.readdirSync(workflowDir)) {
    if (!file.endsWith(".yml") && !file.endsWith(".yaml")) continue;
    const lines = fs.readFileSync(path.join(workflowDir, file), "utf8").split(/\r?\n/);
    lines.forEach((line, index) => {
      if (!line.includes("${{ inputs.")) return;
      const trimmed = line.trim();
      // The only acceptable place is an `env:` entry, which the shell never re-parses. Any
      // UPPER_CASE key qualifies; the point is that the value never reaches the script body.
      if (/^[A-Z][A-Z0-9_]*:/.test(trimmed)) return;
      offenders.push(`${file}:${index + 1}: ${trimmed}`);
    });
  }
  assert.deepEqual(offenders, [], `dispatch inputs must not be interpolated into run: ${offenders.join("\n")}`);

  // And the values really do arrive through the environment, quoted.
  const deprecate = fs.readFileSync(path.join(workflowDir, "deprecate.yml"), "utf8");
  assert.match(deprecate, /env:\s*\n\s*SPEC: \$\{\{ inputs\.spec \}\}/);
  assert.match(deprecate, /npm deprecate "\$SPEC" "\$MESSAGE"/);
});
</file>

<file path="tests/setup-command.test.js">
/**
 * `setup` — the whole first-run flow in one command.
 *
 * It writes the config only when the repository has none, adds the npm scripts, the devDependency
 * and the `.gitignore` entries, installs dependencies with the project's package manager, and then
 * generates through the normal `generate` command. The install is skipped here with `--no-install`
 * so the suite never needs the network.
 */
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const BIN = path.join(HERE, "..", "dist", "bin.js");

function makeRepo(t, files = {}) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "setup-cmd-"));
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  fs.writeFileSync(path.join(dir, "package.json"), '{"name":"fixture","version":"1.0.0"}\n');
  fs.writeFileSync(path.join(dir, "src", "a.ts"), "export const a = 1;\n");
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(dir, relative);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, content);
  }
  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
  return dir;
}

function run(dir, args = []) {
  const result = spawnSync(process.execPath, [BIN, "setup", "--cwd", dir, "--no-install", ...args], {
    encoding: "utf8",
  });
  if (result.error) throw result.error;
  return { code: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
}

const configPath = (dir) =>
  fs.readdirSync(dir).find((name) => /^snapshot\.config\.(ts|mjs|cjs|js|json)$/.test(name));

test("setup writes the config, scripts, dependency and ignore entries, then generates", (t) => {
  const dir = makeRepo(t);

  const result = run(dir);

  assert.equal(result.code, 0, result.stderr);
  const name = configPath(dir);
  assert.ok(name, "a config was written");
  assert.match(result.stderr, /Created snapshot\.config/);

  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(pkg.scripts.snapshot, "npx codebase-snapshot generate");
  assert.match(String(pkg.devDependencies["codebase-snapshot"]), /^\^/);

  const ignore = fs.readFileSync(path.join(dir, ".gitignore"), "utf8");
  assert.match(ignore, /snapshot\//);
  assert.match(ignore, /snapshot\.tmp\//);

  const manifest = JSON.parse(fs.readFileSync(path.join(dir, "snapshot", "manifest.json"), "utf8"));
  assert.ok(manifest.counts.totalFiles > 0, "the snapshot was generated in the same run");
  assert.match(result.stderr, /Snapshot generated/);
});

test("a second setup keeps the existing config and generates again", (t) => {
  const dir = makeRepo(t);
  assert.equal(run(dir).code, 0);
  const name = configPath(dir);
  const before = fs.readFileSync(path.join(dir, name), "utf8");

  const second = run(dir);

  assert.equal(second.code, 0, second.stderr);
  assert.equal(
    fs.readFileSync(path.join(dir, name), "utf8"),
    before,
    "the repository's own config is never rewritten silently"
  );
  assert.match(second.stderr, /Keeping snapshot\.config/);
  assert.ok(fs.existsSync(path.join(dir, "snapshot", "manifest.json")), "it still generated");
});

test("setup --dry-run writes nothing", (t) => {
  const dir = makeRepo(t);

  const result = run(dir, ["--dry-run"]);

  assert.equal(result.code, 0, result.stderr);
  assert.equal(configPath(dir), undefined, "no config was written");
  assert.equal(fs.existsSync(path.join(dir, "snapshot")), false, "nothing was generated");
  const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
  assert.equal(pkg.scripts, undefined, "package.json was not touched");
  assert.match(result.stderr, /Dry run/);
});

test("setup --format json emits one document with the setup report and the manifest", (t) => {
  const dir = makeRepo(t);

  const result = run(dir, ["--format", "json"]);

  assert.equal(result.code, 0, result.stderr);
  const payload = JSON.parse(result.stdout);
  assert.equal(payload.setup.configReused, false);
  assert.equal(payload.setup.preset.length > 0, true);
  assert.equal(payload.setup.install, null, "--no-install was passed");
  assert.ok(payload.manifest, "the generation document is merged in");
  assert.ok(payload.manifest.fingerprint);
  // One document: the only closing brace at column 0 is the end of the top-level object.
  assert.equal(
    result.stdout.split("\n").filter((line) => line === "}").length,
    1,
    "exactly one JSON document on stdout"
  );
});

test("setup refuses to replace a directory it does not own, after writing the config", (t) => {
  const dir = makeRepo(t, { "snapshot/parts/keep.md": "notes\n" });

  const result = run(dir);

  assert.equal(result.code, 1, "the ownership guard still applies");
  assert.match(result.stderr, /Refusing to replace outDir/);
  assert.equal(
    fs.readFileSync(path.join(dir, "snapshot", "parts", "keep.md"), "utf8"),
    "notes\n",
    "the user's file is untouched"
  );
});

test("setup installs with a clean environment, even when npm exec poisoned it", (t) => {
  // The bug this pins: run through `npx`/`npm exec`, the child `npm install` inherits the parent
  // npm's resolved config in `npm_config_*`, and with an npm that supports an `allowScripts`
  // switch it aborted with `EALLOWSCRIPTS: --allow-scripts is not allowed in project-scoped
  // installs`. A test-only shim stands in for npm and records what it was given.
  const dir = makeRepo(t, { "package-lock.json": "{}\n" });
  const shimDir = path.join(dir, "shim");
  fs.mkdirSync(shimDir, { recursive: true });
  const record = path.join(dir, "install-record.txt");
  const isWindows = process.platform === "win32";
  const shim = path.join(shimDir, isWindows ? "npm.cmd" : "npm");
  fs.writeFileSync(
    shim,
    isWindows
      ? [
          "@echo off",
          'if defined npm_config_allow_scripts echo LEAKED>>"%SETUP_SHIM_RECORD%"',
          'echo RAN>>"%SETUP_SHIM_RECORD%"',
          "exit /b 0",
          "",
        ].join("\r\n")
      : [
          "#!/bin/sh",
          'if [ -n "$npm_config_allow_scripts" ]; then echo LEAKED >> "$SETUP_SHIM_RECORD"; fi',
          'echo RAN >> "$SETUP_SHIM_RECORD"',
          "exit 0",
          "",
        ].join("\n")
  );
  if (!isWindows) fs.chmodSync(shim, 0o755);

  const result = spawnSync(
    process.execPath,
    [BIN, "setup", "--cwd", dir],
    {
      encoding: "utf8",
      env: {
        ...process.env,
        PATH: `${shimDir}${path.delimiter}${process.env.PATH ?? ""}`,
        Path: `${shimDir}${path.delimiter}${process.env.Path ?? process.env.PATH ?? ""}`,
        npm_config_allow_scripts: "1",
        SETUP_SHIM_RECORD: record,
      },
    }
  );
  if (result.error) throw result.error;

  const recorded = fs.existsSync(record) ? fs.readFileSync(record, "utf8") : "";
  assert.match(recorded, /RAN/, `the package manager was not invoked: ${result.stderr}`);
  assert.equal(
    recorded.includes("LEAKED"),
    false,
    "npm's own config must not reach the nested install"
  );
  assert.match(result.stderr ?? "", /Installed dependencies/);
});

test("setup --only-artifacts honours a reused config that disables the named artifact", (t) => {
  // `setup` forwarded only the derived `--skip-artifacts` complement into the generation it runs,
  // so a config saying `artifacts: { audit: false }` plus `--only-artifacts audit` left every
  // artifact off: exit 0 and a snapshot directory holding nothing but the ownership marker. The
  // same flags on `generate` write reports/audit.md, and the docs promise both commands agree.
  const dir = makeRepo(t, {
    "snapshot.config.json": JSON.stringify({
      outDir: "ctx",
      tmpDir: "ctx.tmp",
      discovery: "walk",
      artifacts: { audit: false },
    }),
  });

  const result = run(dir, ["--only-artifacts", "audit"]);

  assert.equal(result.code, 0, result.stderr);
  assert.ok(
    fs.existsSync(path.join(dir, "ctx", "reports", "audit.md")),
    "the named artifact is written even though the config turned it off"
  );
  assert.equal(fs.existsSync(path.join(dir, "ctx", "parts")), false, "and only the named one");
});

test("setup on a kept .json config reports that file, not the name it would have written", (t) => {
  const dir = makeRepo(t, {
    "snapshot.config.json": JSON.stringify({ outDir: "ctx", tmpDir: "ctx.tmp", discovery: "walk" }),
  });
  const before = fs.readFileSync(path.join(dir, "snapshot.config.json"), "utf8");

  const result = run(dir);

  assert.equal(result.code, 0, result.stderr);
  assert.match(result.stderr, /Keeping snapshot\.config\.json/);
  assert.doesNotMatch(result.stderr, /snapshot\.config\.mjs/);
  assert.equal(
    fs.readFileSync(path.join(dir, "snapshot.config.json"), "utf8"),
    before,
    "the repository's config is kept byte for byte"
  );
  assert.equal(fs.existsSync(path.join(dir, "snapshot.config.mjs")), false);

  const json = run(dir, ["--format", "json"]);
  assert.equal(json.code, 0, json.stderr);
  const payload = JSON.parse(json.stdout);
  assert.equal(path.basename(payload.setup.configPath), "snapshot.config.json");
  assert.equal(payload.setup.configReused, true);
  assert.equal(payload.setup.preset, null, "no preset was written by this run");
});

test("setup --preset on a kept config does not claim a preset it did not apply", (t) => {
  const dir = makeRepo(t, {
    "snapshot.config.json": JSON.stringify({
      outDir: "ctx",
      tmpDir: "ctx.tmp",
      discovery: "walk",
      preset: "generic",
    }),
  });

  const text = run(dir, ["--preset", "node-express"]);
  assert.equal(text.code, 0, text.stderr);
  assert.doesNotMatch(text.stderr, /preset: node-express/, "the kept config did not get that preset");
  assert.match(text.stderr, /--preset node-express was not applied/);

  const json = run(dir, ["--preset", "node-express", "--format", "json"]);
  assert.equal(json.code, 0, json.stderr);
  const payload = JSON.parse(json.stdout);
  assert.equal(payload.setup.preset, null);
  assert.equal(payload.manifest.config.preset, "generic", "the generation used the kept config's preset");
  assert.ok(
    payload.setup.notes.some((note) => /not applied/.test(note)),
    "the report says the flag was dropped"
  );
});

test("setup --install-hook bakes the output directory the config names", (t) => {
  const dir = makeRepo(t, {
    "snapshot.config.json": JSON.stringify({ outDir: "ctx", tmpDir: "ctx.tmp", discovery: "walk" }),
  });
  fs.mkdirSync(path.join(dir, ".git", "hooks"), { recursive: true });

  const result = run(dir, ["--install-hook"]);

  assert.equal(result.code, 0, result.stderr);
  const hook = fs.readFileSync(path.join(dir, ".git", "hooks", "pre-commit"), "utf8");
  assert.match(hook, /SNAPSHOT_DIR="ctx"/, "the hook guards the directory the generation wrote");
  assert.ok(fs.existsSync(path.join(dir, "ctx", "manifest.json")), "and that directory exists");
});

test("setup --dry-run --install-hook writes no hook", (t) => {
  const dir = makeRepo(t, {});
  fs.mkdirSync(path.join(dir, ".git", "hooks"), { recursive: true });

  const result = run(dir, ["--dry-run", "--install-hook"]);

  assert.equal(result.code, 0, result.stderr);
  assert.equal(
    fs.existsSync(path.join(dir, ".git", "hooks", "pre-commit")),
    false,
    "a dry run writes nothing, and that includes the hook"
  );
});
