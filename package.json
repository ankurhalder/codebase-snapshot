{
  "name": "codebase-snapshot",
  "version": "4.5.0",
  "description": "Turn a codebase into token-efficient, size-budgeted Markdown parts for an LLM: an AST partitioner, snapshot generator, secret auditor and drift validator for ChatGPT, Claude and Cursor.",
  "keywords": [
    "codebase",
    "snapshot",
    "llm",
    "ai",
    "context",
    "context-window",
    "context-engineering",
    "codebase-snapshot",
    "codebase-to-prompt",
    "repo-to-llm",
    "markdown",
    "prompt-engineering",
    "ai-agents",
    "claude",
    "cursor",
    "partitioner",
    "ast",
    "code-analysis",
    "token-efficiency",
    "codebase-packer"
  ],
  "author": "Ankur Halder <ankur.halder12345@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankurhalder/codebase-snapshot.git"
  },
  "homepage": "https://github.com/ankurhalder/codebase-snapshot#readme",
  "bugs": {
    "url": "https://github.com/ankurhalder/codebase-snapshot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "codebase-snapshot": "./dist/bin.js",
    "snap": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "prepublishOnly": "npm run build",
    "publish:create": "npm publish packages/create --access public",
    "prepack": "npm run build",
    "pack-check": "node scripts/pack-check.mjs",
    "site": "node scripts/build-site.mjs",
    "seo-rank": "node scripts/seo-rank.mjs",
    "verify": "npm run check && npm run pack-check"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "marked": "^18.1.3",
    "tsup": "^8.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
