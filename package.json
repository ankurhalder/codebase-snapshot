{
  "name": "@ankurhalder/codebase-snapshot",
  "version": "2.0.0",
  "description": "Production-grade LLM codebase snapshot generator, auditor, and AST partitioner",
  "keywords": [
    "codebase",
    "snapshot",
    "llm",
    "ai",
    "context",
    "ast",
    "audit",
    "codebase-snapshot",
    "code-analysis"
  ],
  "author": "Ankur Halder <ankur.halder12345@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankurhalder/codebase-snapshot.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "codebase-snapshot": "./dist/bin.js",
    "snap": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
