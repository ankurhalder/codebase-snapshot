{
  "name": "codebase-snapshot",
  "version": "0.9.18",
  "description": "Create a codebase snapshot an LLM can read: budgeted Markdown parts for Claude, ChatGPT and Cursor, a manifest of every included and skipped file, secret redaction, and validate, which fails when the snapshot drifts. Local CLI and MCP server.",
  "keywords": [
    "codebase-snapshot",
    "codebase",
    "snapshot",
    "llm",
    "llm-context",
    "repo-to-llm",
    "codebase-to-markdown",
    "codebase-to-prompt",
    "context-window",
    "context-engineering",
    "token-budget",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "chatgpt",
    "secret-redaction",
    "drift-detection"
  ],
  "author": "Ankur Halder <ankur.halder12345@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankurhalder/codebase-snapshot.git"
  },
  "homepage": "https://github.com/ankurhalder/codebase-snapshot#readme",
  "bugs": {
    "url": "https://github.com/ankurhalder/codebase-snapshot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "codebase-snapshot": "./dist/bin.js",
    "snapshot": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "pretest": "npm run build",
    "test": "node scripts/test-run.mjs",
    "test:coverage": "node scripts/test-run.mjs --experimental-test-coverage",
    "publish:create": "npm publish ./packages/create --access public",
    "prepack": "npm run sync-docs && npm run build",
    "pack-check": "node scripts/pack-check.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "site": "npm run sync-docs && node scripts/build-site.mjs",
    "audit-site": "node scripts/audit-site.mjs",
    "readme-lint": "node scripts/readme-lint.mjs",
    "seo-rank": "node scripts/seo-rank.mjs",
    "verify": "npm run check && npm run check:workflows && npm run sync-docs -- --check && npm run site && node scripts/check-site-links.mjs && npm run audit-site && npm run readme-lint && npm run pack-check",
    "snapshot": "node ./dist/bin.js generate",
    "snapshot:validate": "node ./dist/bin.js validate"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "marked": "^18.1.3",
    "tsup": "^8.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
